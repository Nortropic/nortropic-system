{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/nortropic-autocommit.sh\" \"sessionsslut\"",
            "timeout": 120,
            "statusMessage": "Bevarar arbetet (regel 12a)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/nortropic-autocommit.sh\" \"sessionen avslutad\"",
            "timeout": 120,
            "statusMessage": "Bevarar arbetet (regel 12a)"
          }
        ]
      }
    ]
  }
}
