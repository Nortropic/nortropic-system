# nortropic-system: whitelist tracking — ONLY the platform files.
# Settings, credentials, plugins, projects, memory are NEVER tracked.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/.agents/
!/.agents/skills/
!/docs/
/docs/*.db
!/scripts/
!/tests/
!/specs/
!/verify/
!/controller/
!/config/
!/SEPARATION-20260910/

# Pythons bytekodcache: provsviterna lämnar en katalog per paket efter sig; det är
# byggartefakter och får aldrig bli spårade filer — en ospårad .pyc som råkar committas
# gör ett prov omöjligt att verifiera mot sin källa.
__pycache__/
*.py[cod]
