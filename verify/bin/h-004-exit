write_config() {
  cat > "$1" <<JSON
{
  "spec": "$2",
  "attest_dir": "$3",
  "state_dir": "$4",
  "lease_dir": "$5",
  "lease_resurs": "$6",
  "workspace_rot": "$7",
  "base_sha": "$BAS",
  "worker_cmd": ["$PY3", "$8"],
  "timeout_s": 10,
  "verifier_id": "check-invariants",
  "run_id": "$9",
  "brytare_rot": "$7-br",
  "budget": 1,
  "troskel": 2,
  "lease_ttl_s": ${10},
  "lease_heartbeat_s": ${11}
}
JSON
}


# K12 — en riktig loopkörning längre än TTL måste förnya sin lease.
D12="$WORK/s3-loop-hb-lease"
S12="$WORK/s3-loop-hb-state"
A12="$WORK/s3-loop-hb-att"
W12="$WORK/s3-loop-hb-ws"

mkdir -p "$W12"
"$ST" init "$S12" >/dev/null 2>&1

export S3_HB_MARK="$WORK/s3-heartbeat-started"
export S3_HB_DONE="$WORK/s3-heartbeat-done"
export S3_HB_CONTINUE="$WORK/s3-heartbeat-continue"

write_config \
  "$WORK/s3-heartbeat-config.json" \
  "$WORK/s3-heartbeat-backlog.json" \
  "$A12" "$S12" "$D12" "s3-heartbeat" "$W12" \
  "$WORK/s3-heartbeat-worker.py" \
  "s3-heartbeat-run" \
  1.2 0.25

H004_DEADLINE_CHILD_PID_FILE="$WORK/s3-heartbeat-loop.pid" \
"$PY3" "$WORK/h004-deadline.py" 30 "$LOOP" run "$WORK/s3-heartbeat-config.json" \
  >"$WORK/s3-heartbeat.out" \
  2>"$WORK/s3-heartbeat.err" &
loop12=$!

started12=0
wait_mark_or_exit "$S3_HB_MARK" "$loop12" && started12=1

lease12="$D12/s3-heartbeat.lease"
owner12_during=""
controller12="$(tr -d '[:space:]' < "$WORK/s3-heartbeat-loop.pid" 2>/dev/null || true)"
heartbeat_progress12=1
heartbeat_changes12=0

if [ "$started12" -eq 1 ] && [ -f "$lease12" ]; then
  owner12_during="$("$CLI" "$D12" owner s3-heartbeat 2>/dev/null || true)"
  monitor12_rc=0
  heartbeat_changes12=$("$PY3" - "$lease12" "$S3_HB_DONE" <<'PYMONITOR'
import hashlib
import pathlib
import sys
import time

lease = pathlib.Path(sys.argv[1])
done = pathlib.Path(sys.argv[2])
try:
    previous = hashlib.sha256(lease.read_bytes()).digest()
except OSError:
    print(0)
    raise SystemExit(1)

changes = 0
last_change = time.monotonic()
absolute_deadline = last_change + 12
while not done.is_file() or done.stat().st_size == 0:
    time.sleep(0.05)
    now = time.monotonic()
    if now >= absolute_deadline:
        print(changes)
        raise SystemExit(1)
    try:
        current = hashlib.sha256(lease.read_bytes()).digest()
    except OSError:
        print(changes)
        raise SystemExit(1)
    if current != previous:
        previous = current
        changes += 1
        last_change = now
    elif now - last_change >= 1.0:
        # TTL är 1.2 s. En hel sekund utan serialized advance medan
        # workern lever lämnar inte den kontrakterade kontinuitetsmarginalen.
        print(changes)
        raise SystemExit(1)

print(changes)
raise SystemExit(0 if changes >= 5 else 1)
PYMONITOR
  ) || monitor12_rc=$?
  if [ "$monitor12_rc" -eq 0 ] && [ -s "$S3_HB_DONE" ]; then
    heartbeat_progress12=0
  fi
fi

# Håll takeover-provet vid worker-barriären även när progress-oraklet redan
# har falsifierat kandidaten; då mäts också en utebliven heartbeat efter TTL.
if [ "$started12" -eq 1 ] && [ ! -s "$S3_HB_DONE" ]; then
  wait_mark_or_exit "$S3_HB_DONE" "$loop12" >/dev/null 2>&1 || true
fi

steal12=""
steal12_rc=99

if kill -0 "$loop12" 2>/dev/null; then
  steal12="$("$CLI" "$D12" acquire s3-heartbeat --ttl 30 2>/dev/null)"
  steal12_rc=$?
fi
touch "$S3_HB_CONTINUE"

wait "$loop12"
loop12_rc=$?
deadline_probe_or_od "$loop12_rc" "K12 deadline"

att12=1
"$ATT" "$A12" read s3-heartbeat-task --require-valid >/dev/null 2>&1 \
  && att12=0

owner12="$("$CLI" "$D12" owner s3-heartbeat 2>/dev/null || true)"

if [ "$started12" -eq 1 ] \
   && [ -n "$controller12" ] && text_has_pid "$owner12_during" "$controller12" \
   && [ "$heartbeat_progress12" -eq 0 ] \
   && [ "$steal12_rc" -ne 0 ] \
   && [ "$loop12_rc" -eq 0 ] \
   && [ "$att12" -eq 0 ] \
   && [ -z "$owner12" ]; then
  ok "K12 loop-heartbeat: serialized heartbeat fortsätter genom hela workersessionen och sen takeover vägras"
else
  no "K12 loop-heartbeat" \
    "start/owner-during/loop-pid/heartbeat-progress/late-steal/loop/att/owner-after=$started12/[$owner12_during]/${controller12:-saknas}/$heartbeat_progress12($heartbeat_changes12)/$steal12_rc/$loop12_rc/$att12/[$owner12]"
fi

if [ "$steal12_rc" -eq 0 ] && token_ok "$steal12"; then
  "$CLI" "$D12" release s3-heartbeat "$steal12" >/dev/null 2>&1 || true
fi

unset S3_HB_MARK S3_HB_DONE S3_HB_CONTINUE


# K13 — simulera lease-loss UTAN egen JSON:
# ta bort gamla generationens fil och låt publika acquire skapa efterträdaren.
# Gamla runnet får aldrig attestera eller radera den nya generationen.
D13="$WORK/s3-loop-loss-lease"
S13="$WORK/s3-loop-loss-state"
A13="$WORK/s3-loop-loss-att"
W13="$WORK/s3-loop-loss-ws"

mkdir -p "$W13"
"$ST" init "$S13" >/dev/null 2>&1

export S3_LOSS_MARK="$WORK/s3-loss-started"

write_config \
  "$WORK/s3-loss-config.json" \
  "$WORK/s3-loss-backlog.json" \
  "$A13" "$S13" "$D13" "s3-loss" "$W13" \
  "$WORK/s3-loss-worker.py" \
  "s3-loss-run" \
  4 0.2

"$PY3" "$WORK/h004-deadline.py" 30 "$LOOP" run "$WORK/s3-loss-config.json" \
  >"$WORK/s3-loss.out" \
  2>"$WORK/s3-loss.err" &
loop13=$!

started13=0
wait_mark_or_exit "$S3_LOSS_MARK" "$loop13" && started13=1

successor13=""
successor13_rc=99

if [ "$started13" -eq 1 ] && [ -f "$D13/s3-loss.lease" ]; then
  rm -f "$D13/s3-loss.lease"

  successor13="$(
    "$CLI" "$D13" acquire s3-loss \
      --ttl 60 \
      --holder-pid "$$" \
      2>/dev/null
  )"
  successor13_rc=$?
fi

wait "$loop13"
loop13_rc=$?
deadline_probe_or_od "$loop13_rc" "K13 deadline"

att13=1
"$ATT" "$A13" read s3-loss-task --require-valid >/dev/null 2>&1 \
  && att13=0

owner13="$("$CLI" "$D13" owner s3-loss 2>/dev/null || true)"

if [ "$started13" -eq 1 ] \
   && [ "$successor13_rc" -eq 0 ] \
   && token_ok "$successor13" \
   && [ "$loop13_rc" -eq 1 ] \
   && [ "$att13" -ne 0 ] \
   && [ -n "$owner13" ]; then
  ok "K13 lease-loss: gammalt run faller stängt och lämnar efterträdarens lease"
else
  no "K13 lease-loss" \
    "start/successor/loop/att/owner=$started13/$successor13_rc/$loop13_rc/$att13/[$owner13]"
fi

if [ "$successor13_rc" -eq 0 ] && token_ok "$successor13"; then
  "$CLI" "$D13" release s3-loss "$successor13" >/dev/null 2>&1 || true
else
  "$CLI" "$D13" release s3-loss >/dev/null 2>&1 || true
fi

unset S3_LOSS_MARK


# K14 — heartbeat måste vara positiv och strikt mindre än TTL.
D14="$WORK/s3-bad-lease"
S14="$WORK/s3-bad-state"
A14="$WORK/s3-bad-att"
W14="$WORK/s3-bad-ws"

mkdir -p "$W14"
"$ST" init "$S14" >/dev/null 2>&1

export S3_BAD_MARK="$WORK/s3-bad-started"

write_config \
  "$WORK/s3-bad-config.json" \
  "$WORK/s3-heartbeat-backlog.json" \
  "$A14" "$S14" "$D14" "s3-bad" "$W14" \
  "$WORK/s3-bad-worker.py" \
  "s3-bad-run" \
  1 1

"$PY3" "$WORK/h004-deadline.py" 15 "$LOOP" run "$WORK/s3-bad-config.json" \
  >"$WORK/s3-bad.out" \
  2>"$WORK/s3-bad.err"
bad14_rc=$?
deadline_probe_or_od "$bad14_rc" "K14 deadline"

events14="$(wc -l < "$S14/events.jsonl" | tr -d ' ')"

if [ "$bad14_rc" -eq 1 ] \
   && [ ! -s "$S3_BAD_MARK" ] \
   && [ ! -e "$D14/s3-bad.lease" ] \
   && [ "$events14" = "0" ]; then
  ok "K14 config: heartbeat >= TTL vägras före lease, event och session"
else
  no "K14 config" \
    "exit/start/lease/events=$bad14_rc/$([ -s "$S3_BAD_MARK" ] && echo ja || echo nej)/$([ -e "$D14/s3-bad.lease" ] && echo ja || echo nej)/$events14"
fi

unset S3_BAD_MARK

# K15 — den frysta mekanismneutrala observationsseamen. Samma numeriska PID P
# hålls konstant. Oracle A (1 byte) skyddar efter TTL; när exakt samma P byter
# till oracle B (256 bytes) måste en NY lease_id kunna installeras och därefter
# skyddas. Oracle argv och felutfall döms enbart genom publika lease-effekter;
# canonical storage, filnamn och serialisering inspekteras aldrig.
cat > "$WORK/h004-incarnation-seam.py" <<'PYINCSEAM'
import json
import os
import pathlib
import signal
import subprocess
import sys
import time

cli = os.path.abspath(sys.argv[1])
root = pathlib.Path(sys.argv[2])
deadline = pathlib.Path(sys.argv[3]).resolve()
python = sys.executable
oracle_dir = root / "oracle"
lease_dir = root / "leases"
oracle_dir.mkdir(parents=True, exist_ok=True)
lease_dir.mkdir(parents=True, exist_ok=True)
control = oracle_dir / "control"
log = oracle_dir / "invocations.jsonl"
shell_sentinel = oracle_dir / "shell-sentinel"
oracle_held_ready = oracle_dir / "incarnation-held-ready-sentinel"
oracle_held_release = oracle_dir / "incarnation-held-release-sentinel"
oracle_held_cli_pid = oracle_dir / "incarnation-held-cli-pid"
pid = "424242"

oracle_source = f'''#!{python}
import json
import os
import pathlib
import sys
import time

control = pathlib.Path(os.environ["H004_ORACLE_CONTROL"])
log = pathlib.Path(os.environ["H004_ORACLE_LOG"])
mode = control.read_text(encoding="utf-8").strip()
with log.open("a", encoding="utf-8") as stream:
    stream.write(json.dumps({{"mode": mode, "argv": sys.argv[1:], "pid": os.getpid()}}, sort_keys=True) + "\\n")
if mode == "live-A":
    os.write(1, b"A\\n")
    raise SystemExit(0)
if mode == "live-B":
    os.write(1, b"B" * 256 + b"\\n")
    raise SystemExit(0)
if mode == "dead":
    raise SystemExit(1)
if mode == "empty":
    raise SystemExit(0)
if mode == "multi":
    os.write(1, b"A B\\n")
    raise SystemExit(0)
if mode == "multiline":
    os.write(1, b"A\\nB\\n")
    raise SystemExit(0)
if mode == "control":
    os.write(1, b"A\\x01\\n")
    raise SystemExit(0)
if mode == "del":
    os.write(1, b"A\\x7f\\n")
    raise SystemExit(0)
if mode == "badutf8":
    os.write(1, b"\\xff\\n")
    raise SystemExit(0)
if mode == "long":
    os.write(1, b"C" * 257 + b"\\n")
    raise SystemExit(0)
if mode == "error":
    os.write(1, b"looks-live\\n")
    raise SystemExit(7)
if mode == "timeout":
    time.sleep(30)
    os.write(1, b"late\\n")
    raise SystemExit(0)
if mode == "held-malformed":
    ready = pathlib.Path(os.environ["H004_ORACLE_HELD_READY"])
    release = pathlib.Path(os.environ["H004_ORACLE_HELD_RELEASE"])
    ready.write_bytes(b"ready\\n")
    for _ in range(200):
        if release.is_file():
            os.write(1, b"A B\\n")
            raise SystemExit(0)
        time.sleep(0.05)
    raise SystemExit(9)
raise SystemExit(9)
'''

# Metatecken + blanksteg i ett absolut executable path fäller vanliga shell-
# invocationer. Basnamnet finns också så en oquotad shell-mutant kan fortsätta
# men lämnar shell-sentinel via command substitution.
oracle = oracle_dir / "oracle with space$(touch${IFS}shell-sentinel)"
base_oracle = oracle_dir / "oracle with space"
relative_oracle = oracle_dir / "oracle-relative"
for path in (oracle, base_oracle, relative_oracle):
    path.write_text(oracle_source, encoding="utf-8")
    path.chmod(0o700)
nonexec_oracle = oracle_dir / "oracle-nonexec"
nonexec_oracle.write_text(oracle_source, encoding="utf-8")
nonexec_oracle.chmod(0o600)
missing_oracle = oracle_dir / "oracle-missing"

env = os.environ | {
    "H004_ORACLE_CONTROL": str(control),
    "H004_ORACLE_LOG": str(log),
    "H004_ORACLE_HELD_READY": str(oracle_held_ready),
    "H004_ORACLE_HELD_RELEASE": str(oracle_held_release),
}

def set_mode(mode):
    control.write_text(mode + "\n", encoding="utf-8")

def run(*args, seconds=10):
    answer = subprocess.run(
        [python, str(deadline), str(seconds), cli, *map(str, args)],
        cwd=oracle_dir,
        env=env,
        capture_output=True,
        text=True,
        timeout=seconds + 8,
    )
    if answer.returncode in (124, 125, 126):
        raise RuntimeError(
            f"CLI/oracle exceeded deadline or leaked process rc={answer.returncode}: {args!r}"
        )
    return answer

def acquire(task, oracle_path=oracle, ttl="0.35", holder_pid=pid, with_oracle=True):
    args = [
        lease_dir,
        "acquire",
        task,
        "--ttl",
        ttl,
        "--holder-pid",
        holder_pid,
    ]
    if with_oracle:
        args.extend(("--incarnation-oracle", oracle_path))
    return run(*args, seconds=12)

def token(answer):
    value = answer.stdout.strip()
    if not (
        answer.returncode == 0
        and 8 <= len(value) <= 256
        and all(ord(character) >= 33 and not character.isspace() for character in value)
    ):
        raise RuntimeError(f"usable lease_id missing rc={answer.returncode} stdout={answer.stdout!r}")
    return value

def release(task, lease_id):
    answer = run(lease_dir, "release", task, lease_id)
    if answer.returncode != 0:
        raise RuntimeError(f"cleanup release failed for {task}: {answer.stderr!r}")

def owner_names(task, expected_pid=pid):
    answer = run(lease_dir, "owner", task)
    return answer.returncode == 0 and expected_pid in answer.stdout

def preserved_token(task, lease_id, expected_pid=pid):
    return owner_names(task, expected_pid) and run(
        lease_dir, "renew", task, lease_id
    ).returncode == 0

set_mode("live-A")
first = acquire("same-pid")
token_a = token(first)
time.sleep(0.55)

same_a = acquire("same-pid")
if same_a.returncode == 0 or not preserved_token("same-pid", token_a):
    raise SystemExit("same live incarnation A was not protected beyond TTL with usable token")
time.sleep(0.55)

set_mode("live-B")
second = acquire("same-pid")
token_b = token(second)
if token_b == token_a:
    raise SystemExit("same PID/new incarnation B reused old lease_id")
# The stale A token may fail or report harmlessness, but B must remain current.
run(lease_dir, "release", "same-pid", token_a)
if not preserved_token("same-pid", token_b):
    raise SystemExit("same PID/new incarnation did not install a usable successor")
time.sleep(0.55)
same_b = acquire("same-pid")
if same_b.returncode == 0 or not preserved_token("same-pid", token_b):
    raise SystemExit("new live incarnation B was not protected beyond TTL with usable token")
release("same-pid", token_b)

def seed_case(name):
    set_mode("live-A")
    answer = acquire(name, ttl="0.22")
    lease_id = token(answer)
    time.sleep(0.35)
    return lease_id

def require_preserved_then_cleanup(name, lease_id):
    if not preserved_token(name, lease_id):
        raise SystemExit(f"{name}: failed observation damaged current public token")
    release(name, lease_id)

# A nonreturning oracle must be converted to a normal nonzero product result
# before the gate's disposable 12-second operational deadline. An outer
# deadline exit is candidate noncompliance, never evidence that production
# implemented timeout handling.
for mode in ("empty", "multi", "multiline", "control", "del", "badutf8", "long", "error", "timeout"):
    name = f"malformed-{mode}"
    old_token = seed_case(name)
    set_mode(mode)
    answer = acquire(name)
    if answer.returncode == 0:
        raise SystemExit(f"{mode}: indeterminate oracle output/exit authorized reclaim")
    require_preserved_then_cleanup(name, old_token)

# Deterministic before-observation ordering: an expired A exists while the
# oracle has been invoked but has emitted no result. Kill the production acquire
# at that point; A must remain the publicly usable current token. This catches
# mutate-before-oracle/rollback without reading canonical storage or requiring
# another lease command to make progress while an implementation holds a lock.
held_token = seed_case("held-malformed")
for marker in (oracle_held_ready, oracle_held_release, oracle_held_cli_pid):
    marker.unlink(missing_ok=True)
set_mode("held-malformed")
held_env = env | {"H004_DEADLINE_CHILD_PID_FILE": str(oracle_held_cli_pid)}
held_process = subprocess.Popen(
    [
        python, str(deadline), "12", cli, str(lease_dir), "acquire",
        "held-malformed", "--ttl", "30", "--holder-pid", pid,
        "--incarnation-oracle", str(oracle),
    ],
    cwd=oracle_dir,
    env=held_env,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
    start_new_session=True,
)
try:
    entered_deadline = time.monotonic() + 5
    while time.monotonic() < entered_deadline:
        if oracle_held_ready.is_file() and oracle_held_cli_pid.is_file():
            break
        if held_process.poll() is not None:
            raise RuntimeError(
                f"held oracle acquire exited before observation rc={held_process.returncode}"
            )
        time.sleep(0.02)
    else:
        raise RuntimeError("held oracle was never invoked")
    if held_process.poll() is not None:
        raise RuntimeError(f"held oracle acquire exited after READY rc={held_process.returncode}")
    cli_pid = int(oracle_held_cli_pid.read_text(encoding="utf-8").strip())
    os.killpg(cli_pid, signal.SIGKILL)
    held_stdout, held_stderr = held_process.communicate(timeout=15)
    if held_process.returncode == 0:
        raise RuntimeError("killed pre-observation acquire reported success")
finally:
    if held_process.poll() is None:
        try:
            # Let the 12-second deadline helper perform its own cross-session
            # process-tree cleanup before the outer harness considers killing
            # it; killing the helper early could orphan its separate-session CLI.
            held_process.communicate(timeout=15)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(held_process.pid, 9)
            except ProcessLookupError:
                pass
            held_process.communicate(timeout=5)
require_preserved_then_cleanup("held-malformed", held_token)

# Exit 1 is the determinate no-live observation, but the same holder-bound
# request still cannot install a successor for P when P has no incarnation to
# bind. It therefore refuses while the old public token remains usable, distinct
# from silently treating PID alone as a live identity.
old_dead = seed_case("oracle-dead")
set_mode("dead")
dead_answer = acquire("oracle-dead", ttl="30")
if dead_answer.returncode == 0:
    raise SystemExit("oracle exit 1 installed a holder-bound lease without a live incarnation")
require_preserved_then_cleanup("oracle-dead", old_dead)

for label, oracle_path in (
    ("relative", "./oracle-relative"),
    ("missing", missing_oracle),
    ("nonexec", nonexec_oracle),
):
    name = f"unavailable-{label}"
    old_token = seed_case(name)
    set_mode("live-B")
    answer = acquire(name, oracle_path=oracle_path)
    if answer.returncode == 0:
        raise SystemExit(f"{label}: unavailable/non-absolute oracle authorized reclaim")
    require_preserved_then_cleanup(name, old_token)

# An indeterminate observation on a free holder-bound acquire must not create
# public authority for a holder whose incarnation cannot be bound.
for mode in ("empty", "dead"):
    name = f"free-{mode}"
    set_mode(mode)
    answer = acquire(name)
    if answer.returncode == 0 or run(lease_dir, "owner", name).returncode == 0:
        raise SystemExit(f"free {mode}: unbound holder created public lease authority")
    set_mode("live-A")
    cleanup_token = token(acquire(name, ttl="30"))
    release(name, cleanup_token)

try:
    rows = [json.loads(line) for line in log.read_text(encoding="utf-8").splitlines() if line.strip()]
except Exception as exc:
    raise SystemExit(f"oracle argv log malformed: {exc}") from exc
if not rows:
    raise SystemExit("oracle was never directly observed")
hosts = set()
for row in rows:
    argv = row.get("argv")
    if not isinstance(argv, list) or len(argv) != 2:
        raise SystemExit(f"oracle argv was not [host, decimal_pid]: {argv!r}")
    host, observed_pid = argv
    if (
        not isinstance(host, str)
        or not host
        or any(character.isspace() or ord(character) < 33 for character in host)
        or observed_pid != pid
        or not observed_pid.isdecimal()
    ):
        raise SystemExit(f"oracle argv host/pid malformed: {argv!r}")
    hosts.add(host)
if len(hosts) != 1:
    raise SystemExit(f"oracle host identity was not stable: {hosts!r}")
if shell_sentinel.exists():
    raise SystemExit("oracle executable was routed through shell expansion")
seen_modes = {row.get("mode") for row in rows}
for required in (
    "live-A", "live-B", "empty", "multi", "multiline", "control", "del",
    "badutf8", "long", "error", "timeout", "held-malformed", "dead",
):
    if required not in seen_modes:
        raise SystemExit(f"oracle mode was not actually invoked: {required}")

# Decisive production-path control. Seed two expired generations for the same
# actually-live PID with distinct prepared identities A/B. Once every oracle
# executable is unavailable, a plain no-oracle production observation can equal
# at most one seed identity, so at least one must reclaim. A random identity on
# every observation reclaims again after TTL and is caught by the protection leg.
holder = subprocess.Popen(
    [python, "-c", "import time; time.sleep(30)"],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)
prepared = []
disabled_dir = oracle_dir / "disabled"
try:
    real_pid = str(holder.pid)
    for task, mode in (("production-path-A", "live-A"), ("production-path-B", "live-B")):
        set_mode(mode)
        answer = acquire(task, ttl="0.35", holder_pid=real_pid)
        prepared.append((task, token(answer)))
    if prepared[0][1] == prepared[1][1]:
        raise RuntimeError("prepared generations reused lease_id")
    time.sleep(0.55)

    log_before_no_oracle = log.read_bytes()
    disabled_dir.mkdir()
    for executable in (oracle, base_oracle, relative_oracle):
        if executable.exists():
            executable.rename(disabled_dir / executable.name)
    if any(executable.exists() for executable in (oracle, base_oracle, relative_oracle)):
        raise RuntimeError("oracle executable remained available")

    reclaimed = 0
    for task, old_token in prepared:
        answer = acquire(
            task,
            ttl="0.35",
            holder_pid=real_pid,
            with_oracle=False,
        )
        if answer.returncode == 0:
            new_token = token(answer)
            if new_token == old_token:
                raise RuntimeError(f"{task}: no-oracle reclaim reused old lease_id")
            reclaimed += 1

            # A stale token may report failure or harmlessness, but it can never
            # damage the new production-bound generation.
            run(lease_dir, "release", task, old_token)
            if run(lease_dir, "renew", task, new_token).returncode != 0:
                raise RuntimeError(f"{task}: stale old token damaged no-oracle successor")
            owner = run(lease_dir, "owner", task)
            if owner.returncode != 0 or real_pid not in owner.stdout:
                raise RuntimeError(f"{task}: owner did not name actual holder PID")

            time.sleep(0.55)
            same_lifetime = acquire(
                task,
                ttl="30",
                holder_pid=real_pid,
                with_oracle=False,
            )
            if same_lifetime.returncode == 0:
                raise RuntimeError(f"{task}: same production incarnation was not protected after TTL")
            if run(lease_dir, "renew", task, new_token).returncode != 0:
                raise RuntimeError(f"{task}: protected production token stopped renewing")
            release(task, new_token)
        else:
            # At most one prepared identity may equal the actual production
            # identity. Its original generation must remain publicly usable.
            owner = run(lease_dir, "owner", task)
            if owner.returncode != 0 or real_pid not in owner.stdout:
                raise RuntimeError(f"{task}: refused reclaim without preserving holder")
            if run(lease_dir, "renew", task, old_token).returncode != 0:
                raise RuntimeError(f"{task}: refused reclaim damaged prepared token")
            release(task, old_token)

    if reclaimed < 1:
        raise RuntimeError("plain no-oracle production path treated both distinct seeds as same live PID")
    if holder.poll() is not None:
        raise RuntimeError("actual holder exited during no-oracle control")
finally:
    if holder.poll() is None:
        holder.terminate()
    try:
        holder.wait(timeout=5)
    except subprocess.TimeoutExpired:
        holder.kill()
        holder.wait(timeout=5)

if log.read_bytes() != log_before_no_oracle or shell_sentinel.exists():
    raise RuntimeError("plain no-oracle production path invoked/cached disposable oracle machinery")

print(
    f"same-pid A->B protected; no-oracle-reclaimed={reclaimed}; "
    f"oracle-cases={len(rows)} host={next(iter(hosts))}"
)
PYINCSEAM

incarnation15=$(python3 "$WORK/h004-incarnation-seam.py" "$CLI" "$WORK/incarnation-seam" "$WORK/h004-deadline.py" 2>&1); incarnation15_rc=$?
deadline_probe_or_od "$incarnation15_rc" "K15 deadline"
if [ "$incarnation15_rc" -eq 0 ]; then
  ok "K15 process-incarnation: prepared A/B → production no-oracle reclaim + same-lifetime protection"
else
  no "K15 process-incarnation" "${incarnation15:-incarnation-seam harness exit $incarnation15_rc}"
fi

# K16/K17 — publika samtidiga histories plus fortsatt stale-flood efter att en
# successor faktiskt installerats. Successorns publika token-authority överlever;
# canonical storage och bytes inspekteras inte.
cat > "$WORK/h004-overlap.py" <<'PYOVER'
import concurrent.futures
import os
import pathlib
import subprocess
import sys
import threading
import time

cli = os.path.abspath(sys.argv[1])
root = pathlib.Path(sys.argv[2])
root.mkdir(parents=True, exist_ok=True)

def run(*args):
    try:
        return subprocess.run(
            [cli, *map(str, args)], capture_output=True, text=True, timeout=10
        )
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f"CLI timeout: {args!r}") from exc

def acquire(task, ttl="0.18"):
    answer = run(root, "acquire", task, "--ttl", ttl)
    return answer, answer.stdout.strip()

def simultaneous(calls):
    barrier = threading.Barrier(len(calls))
    def one(call):
        barrier.wait()
        return run(*call)
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(calls)) as pool:
        futures = [pool.submit(one, call) for call in calls]
        return [f.result(timeout=10) for f in futures]

def exercise(stale_op):
    direct_successors = 0
    for round_no in range(16):
        task = f"overlap-{stale_op}-{round_no}"
        first, token_a = acquire(task)
        if first.returncode != 0 or not token_a:
            raise RuntimeError(f"{stale_op}/{round_no}: generation A saknas")
        time.sleep(0.28)
        stale, take = simultaneous([
            (root, stale_op, task, token_a),
            (root, "acquire", task, "--ttl", "30"),
        ])
        token_b = take.stdout.strip() if take.returncode == 0 else ""
        if token_b:
            direct_successors += 1
        else:
            # Renew får legitimt serialiseras först. Efter dess TTL installeras
            # B publikt; separata rundor kräver också direkt concurrent B-vinst.
            time.sleep(0.28)
            take, token_b = acquire(task, "30")
        if take.returncode != 0 or not token_b or token_b == token_a:
            raise RuntimeError(f"{stale_op}/{round_no}: successor installerades inte")
        # Publik tokenbunden renew bevisar B:s current identity.
        if run(root, "renew", task, token_b).returncode != 0:
            raise RuntimeError(f"{stale_op}/{round_no}: successor-token är inte current")
        calls = [(root, stale_op, task, token_a) for _ in range(24)]
        with concurrent.futures.ThreadPoolExecutor(max_workers=12) as pool:
            answers = list(pool.map(lambda c: run(*c), calls))
        if run(root, "renew", task, token_b).returncode != 0:
            raise RuntimeError(f"{stale_op}/{round_no}: stale flood skadade successor-token")
        owner = run(root, "owner", task)
        if owner.returncode != 0 or not owner.stdout.strip():
            raise RuntimeError(f"{stale_op}/{round_no}: successor owner saknas")
        if run(root, "release", task, token_b).returncode != 0:
            raise RuntimeError(f"{stale_op}/{round_no}: successor-token kunde inte release:a")
        next_answer, token_c = acquire(task, "30")
        if next_answer.returncode != 0 or not token_c or token_c in (token_a, token_b):
            raise RuntimeError(f"{stale_op}/{round_no}: release lämnade inte en färsk generation")
        if run(root, "release", task, token_c).returncode != 0:
            raise RuntimeError(f"{stale_op}/{round_no}: generation C kunde inte städas")
    print(f"{stale_op}: rounds=16 direct-successors={direct_successors}")

exercise(sys.argv[3])
PYOVER

