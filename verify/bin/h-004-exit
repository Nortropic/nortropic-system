# K14b — hela scalarfamiljen döms via loopens publika run-effekt. Ogiltiga
# bool/string/zero/negative/NaN/Inf och heartbeat>=TTL får inte ens nå acquire.
cat > "$WORK/h004-config-matrix.py" <<'PYCONFIG'
import json
import math
import os
import pathlib
import subprocess
import sys

repo = pathlib.Path(sys.argv[1])
work = pathlib.Path(sys.argv[2])
spec = pathlib.Path(sys.argv[3])
base_sha = sys.argv[4]
deadline = pathlib.Path(sys.argv[5])
loop = repo / "controller/loop/cli"
work.mkdir(parents=True, exist_ok=True)
canary = work / "session-canary.py"
canary.write_text(
    "import os,pathlib\n"
    "pathlib.Path(os.environ['H004_WORKER_COUNT']).write_text('started\\n', encoding='utf-8')\n",
    encoding="utf-8",
)
invalid = []
for field in ("lease_ttl_s", "lease_heartbeat_s"):
    for value in (None, True, "1", [], {}, 0, -1, math.nan, math.inf):
        invalid.append({field: value})
invalid += [
    {"lease_ttl_s": 1, "lease_heartbeat_s": 1},
    {"lease_ttl_s": 1, "lease_heartbeat_s": 2},
]

for index, extra in enumerate(invalid):
    prefix = work / f"case-{index}"
    config = {
        "spec": str(spec),
        "attest_dir": str(prefix) + "-att",
        "state_dir": str(prefix) + "-state",
        "lease_dir": str(prefix) + "-lease",
        "lease_resurs": f"bad-config-{index}",
        "workspace_rot": str(prefix) + "-ws",
        "base_sha": base_sha,
        "worker_cmd": [sys.executable, str(canary)],
        "timeout_s": 2,
        "verifier_id": "check-invariants",
        "run_id": f"bad-config-{index}",
        "brytare_rot": str(prefix) + "-breaker",
        "budget": 1,
        "troskel": 2,
        "lease_ttl_s": 2,
        "lease_heartbeat_s": 0.2,
        **extra,
    }
    path = prefix.with_suffix(".json")
    path.write_text(json.dumps(config, allow_nan=True), encoding="utf-8")
    trace = prefix.with_suffix(".trace")
    trace.write_text("", encoding="utf-8")
    env = os.environ | {
        "H004_TRACE": str(trace),
        "H004_MODE": "normal",
        "H004_HARNESS_PID": str(os.getpid()),
        "H004_WORKER_COUNT": str(prefix) + ".workers",
        "H004_B_MARK": str(prefix) + ".bmark",
        "H004_B_CONTINUE": str(prefix) + ".continue",
    }
    try:
        answer = subprocess.run(
            [sys.executable, str(deadline), "30", str(loop), "run", str(path)],
            cwd=repo, env=env, capture_output=True, timeout=40,
        )
    except subprocess.TimeoutExpired:
        print("descendant-aware deadline helper hung", file=sys.stderr)
        raise SystemExit(3)
    if answer.returncode == 126:
        print("descendant-aware deadline process probe failed", file=sys.stderr)
        raise SystemExit(3)
    try:
        rows = [json.loads(line) for line in trace.read_text().splitlines() if line.strip()]
        if any(not isinstance(row, dict) for row in rows):
            raise ValueError("non-object trace row")
    except Exception as exc:
        print(f"malformed config trace: {exc}", file=sys.stderr)
        raise SystemExit(3)
    mutating_commands = {
        ("lease", "acquire"), ("lease", "renew"), ("lease", "release"),
        ("attest", "begin-authority"), ("attest", "write"),
        ("attest", "finalize-authority"), ("attest", "invalidate"),
        ("taskval", "claim"), ("state", "append"),
        ("workspace", "create"), ("launch", "run"),
    }
    side_effect = any(
        row.get("phase") == "start"
        and (row.get("component"), row.get("command")) in mutating_commands
        for row in rows
    )
    events = pathlib.Path(str(prefix) + "-state") / "events.jsonl"
    event_effect = events.is_file() and events.stat().st_size > 0
    authority_artifact = any(
        candidate.is_file() or candidate.is_symlink()
        for root in (
            pathlib.Path(str(prefix) + "-lease"),
            pathlib.Path(str(prefix) + "-att"),
        )
        if root.exists()
        for candidate in root.rglob("*")
    )
    escaped_effect = pathlib.Path(str(prefix) + "-ws").exists() or pathlib.Path(
        str(prefix) + ".workers"
    ).exists()
    if answer.returncode != 1 or side_effect or event_effect or authority_artifact or escaped_effect:
        raise SystemExit(f"case {index} accepterades/berörde authority: {extra!r}, rc={answer.returncode}")

print(f"{len(invalid)} invalid timing configs refused pre-authority")
PYCONFIG

config14b=$(python3 "$WORK/h004-config-matrix.py" "$TRACE_REPO" "$WORK/k14b" "$WORK/h004-empty.json" "$TRACE_BAS" "$WORK/h004-deadline.py" 2>&1); config14b_rc=$?
if [ "$config14b_rc" -eq 0 ]; then
  ok "K14b configfamilj: null/bool/string/collection/icke-positiv/icke-finite och heartbeat>=TTL vägras före authority/session"
elif [ "$config14b_rc" -eq 3 ]; then
  echo "SKIP  K14b configfamilj — trace/processgrupp kunde inte bedömas, ODÖMBART"
  exit 2
else
  no "K14b configfamilj" "${config14b:-config-matrix exit $config14b_rc}"
fi

