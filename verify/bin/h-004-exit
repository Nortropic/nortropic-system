# K22 — crash efter verklig clean release men fore wrapper-return/finalize.
# Vid barriaren ar leasen faktiskt borta; publication far fortfarande inte vara
# globalt giltig. Kill av loopprocessen ersatts aldrig av post-hoc invalidate.
D22="$WORK/s3-after-release-lease"; S22="$WORK/s3-after-release-state"
A22="$WORK/s3-after-release-att"; W22="$WORK/s3-after-release-ws"
TRACE22="$WORK/s3-after-release.trace"; READY22="$WORK/s3-after-release.ready"; GO22="$WORK/s3-after-release.go"
mkdir -p "$W22"; "$ST" init "$S22" >/dev/null 2>&1
write_config "$WORK/s3-after-release-config.json" "$SPECNEG" "$A22" "$S22" "$D22" \
  "s3-after-release-resource" "$W22" "$WORKER21" "s3-after-release-run" 600 300
H004_TRACE="$TRACE22" H004_REAL_LEASE="$REPO_ROOT/controller/lease/cli" \
H004_REAL_ATTEST="$REPO_ROOT/controller/attest/cli" H004_WORK_MARK="$WORK/s3-after-release-worker" \
H004_RELEASE_BLOCK_READY="$READY22" H004_RELEASE_BLOCK_GO="$GO22" \
  "$SHADOW/controller/loop/cli" run "$WORK/s3-after-release-config.json" \
  >"$WORK/s3-after-release.out" 2>"$WORK/s3-after-release.err" & loop22=$!
ready22=0; wait_mark_or_exit "$READY22" "$loop22"; mark22_rc=$?
if [ "$mark22_rc" -eq 2 ]; then
  kill -9 "$loop22" 2>/dev/null || true; wait "$loop22" 2>/dev/null || true
  echo "SKIP  K22 harness — release barrier timed out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
fi
[ "$mark22_rc" -eq 0 ] && ready22=1
owner22=$("$CLI" "$D22" owner s3-after-release-resource 2>/dev/null || true)
valid22=0; "$ATT" "$A22" read auth-negative --require-valid >/dev/null 2>&1 || valid22=$?
prefix22_out=$("$PY3" "$PREFIX_CHECK" "$TRACE22" s3-after-release-resource \
  auth-negative released_barrier 2>&1); prefix22_rc=$?
token22="$prefix22_out"
scoped22=1
if token_ok "$token22"; then
  "$ATT" "$A22" read auth-negative --require-authority "$token22" >/dev/null 2>&1
  scoped22=$?
fi
pre_finalize22=$(grep -c 'ATTEST.* finalize-authority ' "$TRACE22" 2>/dev/null || true)
if kill -0 "$loop22" 2>/dev/null; then kill -9 "$loop22" 2>/dev/null || true; fi
wait "$loop22" 2>/dev/null; killed22_rc=$?
: > "$GO22"
sleep 0.2
post_finalize22=$(grep -c 'ATTEST.* finalize-authority ' "$TRACE22" 2>/dev/null || true)
postvalid22=0; "$ATT" "$A22" read auth-negative --require-valid >/dev/null 2>&1 || postvalid22=$?
if [ "$ready22" -eq 1 ] && [ -z "$owner22" ] && [ "$prefix22_rc" -eq 0 ] \
   && token_ok "$token22" && [ "$scoped22" -eq 0 ] \
   && [ "$valid22" -ne 0 ] && [ "$pre_finalize22" = "0" ] \
   && [ "$killed22_rc" -ne 0 ] && [ "$post_finalize22" = "0" ] && [ "$postvalid22" -ne 0 ]; then
  ok "K22 crash efter clean release fore FINALIZE lamnar noll giltiga publications"
else
  no "K22 release/finalize crash window" "ready/owner/prefix/scoped/prevalid/pre-finalize/kill/post-finalize/postvalid=$ready22/[$owner22]/$prefix22_rc/$scoped22/$valid22/$pre_finalize22/$killed22_rc/$post_finalize22/$postvalid22 evidence=[$prefix22_out]"
fi

# K23 — ett faktiskt returnerat FINALIZE-fel efter clean release ar run-fel,
# aldrig clean success. Wrappern feller bara anropet; h-003:s egen gate ager
# atomic failure/kill-semantiken inne i finaliseringen.
D23="$WORK/s3-finalize-fail-lease"; S23="$WORK/s3-finalize-fail-state"
A23="$WORK/s3-finalize-fail-att"; W23="$WORK/s3-finalize-fail-ws"
TRACE23="$WORK/s3-finalize-fail.trace"
mkdir -p "$W23"; "$ST" init "$S23" >/dev/null 2>&1
write_config "$WORK/s3-finalize-fail-config.json" "$SPECNEG" "$A23" "$S23" "$D23" \
  "s3-finalize-fail-resource" "$W23" "$WORKER21" "s3-finalize-fail-run" 600 300
H004_TRACE="$TRACE23" H004_REAL_LEASE="$REPO_ROOT/controller/lease/cli" \
H004_REAL_ATTEST="$REPO_ROOT/controller/attest/cli" H004_WORK_MARK="$WORK/s3-finalize-fail-worker" \
H004_FINALIZE_FAIL=1 "$PY3" "$RUN_BOUNDED" 120 \
  "$SHADOW/controller/loop/cli" run "$WORK/s3-finalize-fail-config.json" \
  >"$WORK/s3-finalize-fail.out" 2>"$WORK/s3-finalize-fail.err"
loop23_rc=$?
if [ "$loop23_rc" -eq 90 ]; then
  echo "SKIP  K23 harness — bounded loop timed out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
fi
valid23=0; "$ATT" "$A23" read auth-negative --require-valid >/dev/null 2>&1 || valid23=$?
owner23=$("$CLI" "$D23" owner s3-finalize-fail-resource 2>/dev/null || true)
prefix23_out=$("$PY3" "$PREFIX_CHECK" "$TRACE23" s3-finalize-fail-resource \
  auth-negative finalize_fail 2>&1); prefix23_rc=$?
token23="$prefix23_out"; scoped23=1
if token_ok "$token23"; then
  "$ATT" "$A23" read auth-negative --require-authority "$token23" >/dev/null 2>&1
  scoped23=$?
fi
if [ "$loop23_rc" -eq 1 ] && [ "$valid23" -ne 0 ] && [ -z "$owner23" ] \
   && [ "$prefix23_rc" -eq 0 ] && token_ok "$token23" && [ "$scoped23" -eq 0 ]; then
  ok "K23 finalize failure efter clean release ger non-clean run och noll valid"
else
  no "K23 finalize-failure" "loop/valid/owner/prefix/scoped=$loop23_rc/$valid23/[$owner23]/$prefix23_rc/$scoped23 evidence=[$prefix23_out]"
fi

# K24 — nyare authority installeras i det riktiga release→finalize-fonstret.
# Den gamla generationens finalize ska falla, hela gamla batchen forbli
# globalt ogiltig och successor-authority fortsatt vara anvandbar.
D24="$WORK/s3-newer-authority-lease"; S24="$WORK/s3-newer-authority-state"
A24="$WORK/s3-newer-authority-att"; W24="$WORK/s3-newer-authority-ws"
TRACE24="$WORK/s3-newer-authority.trace"; READY24="$WORK/s3-newer-authority.ready"; GO24="$WORK/s3-newer-authority.go"
mkdir -p "$W24"; "$ST" init "$S24" >/dev/null 2>&1
write_config "$WORK/s3-newer-authority-config.json" "$SPECNEG" "$A24" "$S24" "$D24" \
  "s3-newer-authority-resource" "$W24" "$WORKER21" "s3-newer-authority-run" 600 300
H004_TRACE="$TRACE24" H004_REAL_LEASE="$REPO_ROOT/controller/lease/cli" \
H004_REAL_ATTEST="$REPO_ROOT/controller/attest/cli" H004_WORK_MARK="$WORK/s3-newer-authority-worker" \
H004_FINALIZE_BLOCK_READY="$READY24" H004_FINALIZE_BLOCK_GO="$GO24" \
  "$SHADOW/controller/loop/cli" run "$WORK/s3-newer-authority-config.json" \
  >"$WORK/s3-newer-authority.out" 2>"$WORK/s3-newer-authority.err" & loop24=$!
ready24=0; wait_mark_or_exit "$READY24" "$loop24"; mark24_rc=$?
if [ "$mark24_rc" -eq 2 ]; then
  kill -9 "$loop24" 2>/dev/null || true; wait "$loop24" 2>/dev/null || true
  echo "SKIP  K24 harness — finalize barrier timed out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
fi
[ "$mark24_rc" -eq 0 ] && ready24=1
owner24=$("$CLI" "$D24" owner s3-newer-authority-resource 2>/dev/null || true)
prefix24pre_out=$("$PY3" "$PREFIX_CHECK" "$TRACE24" s3-newer-authority-resource \
  auth-negative released_prefix 2>&1); prefix24pre_rc=$?
oldtoken24="$prefix24pre_out"; oldscoped_pre24=1
if token_ok "$oldtoken24"; then
  "$ATT" "$A24" read auth-negative --require-authority "$oldtoken24" >/dev/null 2>&1
  oldscoped_pre24=$?
fi
succ24="successor-authority-after-release"
begin24=1; write24=1; scoped24=1
if [ "$ready24" -eq 1 ] && [ "$prefix24pre_rc" -eq 0 ] \
   && token_ok "$oldtoken24" && [ "$oldscoped_pre24" -eq 0 ]; then
  "$ATT" "$A24" begin-authority "$succ24" >/dev/null 2>&1; begin24=$?
  "$ATT" "$A24" write-authority "$succ24" successor-proof "$AS1" >/dev/null 2>&1; write24=$?
  "$ATT" "$A24" read successor-proof --require-authority "$succ24" >/dev/null 2>&1; scoped24=$?
else
  kill -9 "$loop24" 2>/dev/null || true
fi
: > "$GO24"
timeout24="$WORK/s3-newer-authority.timeout"
( sleep 30; if kill -0 "$loop24" 2>/dev/null; then : > "$timeout24"; kill -9 "$loop24" 2>/dev/null || true; fi ) & watchdog24=$!
wait "$loop24" 2>/dev/null; loop24_rc=$?
kill "$watchdog24" 2>/dev/null || true; wait "$watchdog24" 2>/dev/null || true
if [ -e "$timeout24" ]; then
  echo "SKIP  K24 harness — post-GO loop timed out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
fi
oldvalid24=0; "$ATT" "$A24" read auth-negative --require-valid >/dev/null 2>&1 || oldvalid24=$?
oldscoped_after24=0; "$ATT" "$A24" read auth-negative --require-authority "$oldtoken24" >/dev/null 2>&1 || oldscoped_after24=$?
succglobal24=0; "$ATT" "$A24" read successor-proof --require-valid >/dev/null 2>&1 || succglobal24=$?
scoped_after24=0; "$ATT" "$A24" read successor-proof --require-authority "$succ24" >/dev/null 2>&1 || scoped_after24=$?
prefix24post_out=$("$PY3" "$PREFIX_CHECK" "$TRACE24" s3-newer-authority-resource \
  auth-negative stale_finalize 2>&1); prefix24post_rc=$?
events24=$(wc -l < "$S24/events.jsonl" | tr -d ' ')
if [ "$ready24" -eq 1 ] && [ -z "$owner24" ] \
   && [ "$prefix24pre_rc" -eq 0 ] && [ "$prefix24post_rc" -eq 0 ] \
   && [ "$prefix24post_out" = "$oldtoken24" ] && token_ok "$oldtoken24" \
   && [ "$oldscoped_pre24" -eq 0 ] && [ "$oldscoped_after24" -ne 0 ] \
   && [ -s "$WORK/s3-newer-authority-worker.auth-negative" ] && [ "$events24" = "1" ] \
   && [ "$begin24" -eq 0 ] \
   && [ "$write24" -eq 0 ] && [ "$scoped24" -eq 0 ] && [ "$scoped_after24" -eq 0 ] && [ "$loop24_rc" -eq 1 ] \
   && [ "$oldvalid24" -ne 0 ] && [ "$succglobal24" -ne 0 ]; then
  ok "K24 newer authority mellan release/finalize fencar hela gamla batchen"
else
  no "K24 release/finalize authority race" "ready/owner/prefix-pre,post/token/scoped-old-pre,post/successor-begin,write,scope-pre,post/loop/oldvalid/succglobal/events=$ready24/[$owner24]/$prefix24pre_rc,$prefix24post_rc/[$oldtoken24]/$oldscoped_pre24,$oldscoped_after24/$begin24,$write24,$scoped24,$scoped_after24/$loop24_rc/$oldvalid24/$succglobal24/$events24 evidence=[$prefix24pre_out][$prefix24post_out]"
fi

summera
