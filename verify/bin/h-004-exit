import os,signal,subprocess,sys
timeout=float(sys.argv[1]); argv=sys.argv[2:]
p=subprocess.Popen(argv,start_new_session=True)
pid_file=os.environ.get("H004_RUN_PID_FILE")
if pid_file:
    with open(pid_file,"w",encoding="ascii") as f: f.write(str(p.pid)+"\n")
try: raise SystemExit(p.wait(timeout=timeout))
except subprocess.TimeoutExpired:
    try: os.killpg(p.pid,signal.SIGKILL)
    except ProcessLookupError: pass
    p.wait(); print("HARNESS:COMMAND_TIMEOUT:"+" ".join(argv[:2]),file=sys.stderr)
    raise SystemExit(90)
PY

