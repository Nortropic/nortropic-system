if [ "$release_overlap_rc" -eq 0 ]; then
  ok "K16 stale release overlap histories: successor token-authority överlever"
else
  no "K16 stale release overlap" "${release_overlap:-overlap-harness exit $release_overlap_rc}"
fi
renew_overlap=$(python3 "$WORK/h004-overlap.py" "$CLI" "$WORK/overlap-renew" renew 2>&1); renew_overlap_rc=$?
if [ "$renew_overlap_rc" -eq 0 ]; then
  ok "K17 stale renew overlap histories: successor token-authority överlever"
else
  no "K17 stale renew overlap" "${renew_overlap:-overlap-harness exit $renew_overlap_rc}"
fi
cat > "$WORK/h004-mutation-barrier.py" <<'PYMUTBARRIER'
import fcntl
import os
import pathlib
import select
import signal
import subprocess
import sys
import time

cli = os.path.abspath(sys.argv[1])
root = pathlib.Path(sys.argv[2])
root.mkdir(parents=True, exist_ok=True)

def run(*args, timeout=8):
    try:
        return subprocess.run(
            [cli, *map(str, args)], capture_output=True, text=True, timeout=timeout
        )
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f"public CLI blocked: {args!r}") from exc

def valid_token(answer):
    value = answer.stdout.strip()
    if not (
        answer.returncode == 0
        and 8 <= len(value) <= 256
        and all(ord(character) >= 33 and not character.isspace() for character in value)
    ):
        raise RuntimeError(f"usable lease_id missing rc={answer.returncode} stdout={answer.stdout!r}")
    return value

def acquire(task, ttl):
    answer = run(root, "acquire", task, "--ttl", str(ttl))
    return answer, valid_token(answer)

class Held:
    def __init__(self, operation, task, lease_id, eof=False):
        self.ready_r, ready_w_raw = os.pipe()
        continue_r_raw, self.continue_w = os.pipe()
        # High, runtime-allocated descriptors prove that the scheduling seam
        # accepts ordinary inherited FDs without binding any fixed FD numbers.
        ready_w = fcntl.fcntl(ready_w_raw, fcntl.F_DUPFD, 220)
        continue_r = fcntl.fcntl(continue_r_raw, fcntl.F_DUPFD, 220)
        os.close(ready_w_raw)
        os.close(continue_r_raw)
        self.ready_fd = ready_w
        self.continue_fd = continue_r
        os.set_blocking(self.ready_r, False)
        if eof:
            os.close(self.continue_w)
            self.continue_w = None
        self.process = subprocess.Popen(
            [
                cli,
                str(root),
                operation,
                task,
                lease_id,
                "--test-mutation-barrier-fds",
                str(ready_w),
                str(continue_r),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            pass_fds=(ready_w, continue_r),
            start_new_session=True,
        )
        os.close(ready_w)
        os.close(continue_r)

    def ready_bytes(self, timeout=3):
        readable, _, _ = select.select([self.ready_r], [], [], timeout)
        if not readable:
            return None
        time.sleep(0.03)
        try:
            return os.read(self.ready_r, 1024)
        except BlockingIOError:
            return b""

    def require_ready(self):
        data = self.ready_bytes()
        if data != b"R":
            raise RuntimeError(f"barrier emitted {data!r}, expected exactly one READY byte")
        if self.process.poll() is not None:
            raise RuntimeError(f"barrier process exited after READY rc={self.process.returncode}")
        return time.monotonic()

    def continue_one(self):
        if self.continue_w is None:
            raise RuntimeError("continue pipe already EOF")
        os.write(self.continue_w, b"C")
        os.close(self.continue_w)
        self.continue_w = None

    def wait(self, timeout=5):
        try:
            stdout, stderr = self.process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired as exc:
            try:
                os.killpg(self.process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            self.process.communicate(timeout=5)
            raise RuntimeError("barrier process did not terminate") from exc
        return self.process.returncode, stdout, stderr

    def close(self):
        if self.continue_w is not None:
            os.close(self.continue_w)
            self.continue_w = None
        try:
            os.close(self.ready_r)
        except OSError:
            pass
        if self.process.poll() is None:
            try:
                os.killpg(self.process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            self.process.communicate(timeout=5)

def overlap(operation):
    task = f"deterministic-{operation}"
    ttl = 2.50 if operation == "renew" else 1.20
    acquire_started = time.monotonic()
    _first, token_a = acquire(task, ttl)
    acquire_returned = time.monotonic()
    # Age A before held RENEW so mutation-before-READY would move expiry far
    # beyond the original TTL and becomes distinguishable by public acquire B.
    if operation == "renew":
        time.sleep(1.00)
    held = Held(operation, task, token_a)
    try:
        ready_at = held.require_ready()
        if ready_at >= acquire_started + ttl:
            raise RuntimeError(f"{operation}: READY was not observed before A TTL expiry")
        early = run(root, "acquire", task, "--ttl", "30")
        if early.returncode == 0:
            raise RuntimeError(f"{operation}: mutation was publicly visible before READY/TTL")
        # The lease cannot have been installed after acquire returned, so this
        # upper bound guarantees expiry before public successor B is requested.
        time.sleep(max(0, acquire_returned + ttl + 0.20 - time.monotonic()))
        takeover, token_b = acquire(task, 30)
        if token_b == token_a:
            raise RuntimeError(f"{operation}: successor reused A token")
        if run(root, "renew", task, token_b).returncode != 0:
            raise RuntimeError(f"{operation}: public successor B was not current before CONTINUE")
        held.continue_one()
        stale_rc, _stdout, _stderr = held.wait()
        # Usable B token after stale CONTINUE proves successor authority survived.
        if run(root, "renew", task, token_b).returncode != 0:
            raise RuntimeError(f"{operation}: successor token could not renew")
        if run(root, "release", task, token_b).returncode != 0:
            raise RuntimeError(f"{operation}: successor token could not release")
        _next, token_c = acquire(task, 30)
        if token_c in (token_a, token_b):
            raise RuntimeError(f"{operation}: fresh generation reused stale token")
        if run(root, "release", task, token_c).returncode != 0:
            raise RuntimeError(f"{operation}: fresh generation cleanup failed")
    finally:
        held.close()
    print(f"{operation}-overlap ok")

def wrong_token_no_ready(operation):
    task = f"wrong-{operation}"
    _answer, current = acquire(task, 30)
    held = Held(operation, task, "wrong-" + current)
    try:
        rc, _stdout, _stderr = held.wait(timeout=3)
        data = held.ready_bytes(timeout=0)
        if rc == 0 or data not in (b"", None):
            raise RuntimeError(f"{operation}: wrong token emitted READY/succeeded rc={rc} data={data!r}")
    finally:
        held.close()
    if run(root, "renew", task, current).returncode != 0:
        raise RuntimeError(f"{operation}: wrong-token control damaged current token")
    if run(root, "release", task, current).returncode != 0:
        raise RuntimeError(f"{operation}: wrong-token control damaged current token")

def invalid_descriptors(operation):
    task = f"bad-fd-{operation}"
    _answer, current = acquire(task, 30)
    # Både syntaktiskt negativa och syntaktiskt giltiga men stängda positiva
    # descriptors ska falla före mutation. Annars kan en implementation
    # validera heltal, mutera, och först därefter upptäcka EBADF.
    probe = os.open(os.devnull, os.O_RDONLY)
    try:
        os.dup2(probe, 240)
        os.dup2(probe, 241)
    finally:
        for descriptor in {probe, 240, 241}:
            try:
                os.close(descriptor)
            except OSError:
                pass
    for ready_fd, continue_fd, label in (
        ("-1", "-2", "negative"),
        ("240", "241", "closed-positive"),
    ):
        answer = run(
            root,
            operation,
            task,
            current,
            "--test-mutation-barrier-fds",
            ready_fd,
            continue_fd,
        )
        if answer.returncode == 0:
            raise RuntimeError(f"{operation}: {label} descriptors returned success")
        if run(root, "renew", task, current).returncode != 0:
            raise RuntimeError(f"{operation}: {label} descriptors damaged current token")
    if run(root, "release", task, current).returncode != 0:
        raise RuntimeError(f"{operation}: invalid-descriptor control damaged token")

def eof_before_mutation(operation):
    task = f"eof-{operation}"
    ttl = 2.50 if operation == "renew" else 1.20
    acquired_at = time.monotonic()
    _answer, current = acquire(task, ttl)
    acquired_returned = time.monotonic()
    if operation == "renew":
        time.sleep(1.00)
    held = Held(operation, task, current)
    try:
        ready_at = held.require_ready()
        if ready_at >= acquired_at + ttl:
            raise RuntimeError(f"{operation}: EOF READY was not before original expiry")
        early = run(root, "acquire", task, "--ttl", "30")
        if early.returncode == 0:
            raise RuntimeError(f"{operation}: mutation was visible before EOF/TTL")
        time.sleep(max(0, acquired_returned + ttl + 0.20 - time.monotonic()))
        _successor_answer, successor = acquire(task, 30)
        if successor == current:
            raise RuntimeError(f"{operation}: EOF successor reused current token")
        os.close(held.continue_w)
        held.continue_w = None
        rc, _stdout, _stderr = held.wait(timeout=3)
        if rc == 0:
            raise RuntimeError(f"{operation}: CONTINUE EOF returned success")
    finally:
        held.close()
    if run(root, "renew", task, successor).returncode != 0:
        raise RuntimeError(f"{operation}: EOF control damaged successor token")
    if run(root, "release", task, successor).returncode != 0:
        raise RuntimeError(f"{operation}: EOF successor cleanup failed")

def positive_release():
    task = "positive-release"
    _answer, current = acquire(task, 30)
    held = Held("release", task, current)
    try:
        held.require_ready()
        held.continue_one()
        rc, _stdout, _stderr = held.wait()
        if rc != 0:
            raise RuntimeError(f"barrier release lost normal effect rc={rc}")
    finally:
        held.close()
    _next, successor = acquire(task, 30)
    if successor == current:
        raise RuntimeError("barrier release reacquire reused token")
    if run(root, "release", task, successor).returncode != 0:
        raise RuntimeError("barrier release successor cleanup failed")

def positive_renew():
    task = "positive-renew"
    ttl = 3.00
    _answer, current = acquire(task, ttl)
    acquired_returned = time.monotonic()
    time.sleep(1.40)
    held = Held("renew", task, current)
    try:
        held.require_ready()
        held.continue_one()
        rc, _stdout, _stderr = held.wait()
        if rc != 0:
            raise RuntimeError(f"barrier renew lost normal public effect rc={rc}")
        renewed_returned = time.monotonic()
    finally:
        held.close()
    # Original TTL has elapsed, renewed TTL has not.
    time.sleep(max(0, acquired_returned + ttl + 0.20 - time.monotonic()))
    early = run(root, "acquire", task, "--ttl", "30")
    if early.returncode == 0:
        raise RuntimeError("barrier renew did not move TTL window")
    time.sleep(max(0, renewed_returned + ttl + 0.20 - time.monotonic()))
    late, successor = acquire(task, 30)
    if successor == current:
        raise RuntimeError("post-renew expiry reused token")
    if run(root, "release", task, successor).returncode != 0:
        raise RuntimeError("positive renew cleanup failed")

for operation in ("release", "renew"):
    overlap(operation)
    wrong_token_no_ready(operation)
    invalid_descriptors(operation)
    eof_before_mutation(operation)
positive_release()
positive_renew()
print("barrier-negative-controls ok")
PYMUTBARRIER

barrier_overlap=$(python3 "$WORK/h004-mutation-barrier.py" "$CLI" "$WORK/mutation-barrier" 2>&1); barrier_overlap_rc=$?
if [ "$barrier_overlap_rc" -eq 0 ] && echo "$barrier_overlap" | grep -q 'release-overlap ok'; then
  ok "K16b release barrier: READY→public B→CONTINUE bevarar B:s token-authority plus ankare"
else
  no "K16b release barrier" "${barrier_overlap:-mutation-barrier harness exit $barrier_overlap_rc}"
fi
if [ "$barrier_overlap_rc" -eq 0 ] && echo "$barrier_overlap" | grep -q 'renew-overlap ok'; then
  ok "K17b renew barrier: READY→public B→CONTINUE bevarar B:s token-authority plus ankare"
else
  no "K17b renew barrier" "${barrier_overlap:-mutation-barrier harness exit $barrier_overlap_rc}"
fi

# K18+ kör den VERKLIGA loopen i en disponibel lokal klon. Tunna wrappers
# loggar publika argv/exit-effekter och kan injicera ett enda systerfel eller
# en owner-kontrollerad barriär. De är aldrig production authority och säger
# ingenting om implementationens interna lås/storage.
TRACE_REPO="$WORK/trace-repo"
trace_repo_ok=0
if git clone -q --no-hardlinks . "$TRACE_REPO" >/dev/null 2>&1 \
   && rsync -a --delete controller/ "$TRACE_REPO/controller/" >/dev/null 2>&1; then
  # Få med den komponentversion som faktiskt döms även vid en pre-commit run.
  trace_repo_ok=1
fi
if [ "$trace_repo_ok" -ne 1 ]; then
  echo "SKIP  K18+ trace-rigg — clone/deletion-aware overlay misslyckades, ODÖMBART"
  echo
  echo "$pass PASS, $fail FAIL, ODÖMBART"
  exit 2
fi

cat > "$WORK/h004-trace-wrapper.py" <<'PYTRACE'
#!/usr/bin/env python3
import json
import os
import pathlib
import signal
import subprocess
import sys
import time

here = pathlib.Path(__file__).resolve()
component = here.parent.name
real = here.with_name("cli.real")
args = sys.argv[1:]
trace_path = os.environ.get("H004_TRACE", "")
mode = os.environ.get("H004_MODE", "normal")

def command():
    if component in ("attest", "lease", "workspace"):
        return args[1] if len(args) > 1 else ""
    return args[0] if args else ""

def trace(phase, **extra):
    if not trace_path:
        return
    record = {
        "wall_ns": time.time_ns(),
        "process_monotonic_ns": time.monotonic_ns(),
        "pid": os.getpid(),
        "component": component,
        "phase": phase,
        "command": command(),
        "args": args,
        **extra,
    }
    payload = (json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n").encode()
    fd = os.open(trace_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(fd, payload)
    finally:
        os.close(fd)

def call(path, call_args):
    return subprocess.run(
        [str(path), *map(str, call_args)], capture_output=True, timeout=90
    )

def answer(rc, out=b"", err=b""):
    return subprocess.CompletedProcess([str(real), *args], rc, out, err)

def save_successor(token, lease_file, authority_task, authority_sha):
    target = os.environ.get("H004_SUCCESSOR_FILE", "")
    if target:
        pathlib.Path(target).write_text(
            json.dumps({
                "token": token,
                "lease_file": str(lease_file),
                "bytes_hex": lease_file.read_bytes().hex(),
                "authority_task": authority_task,
                "authority_sha": authority_sha,
            }, sort_keys=True) + "\n",
            encoding="utf-8",
        )

def install_successor(lease_dir, resource, attest_dir):
    holder = os.environ.get("H004_HARNESS_PID", "")
    acquire_args = [lease_dir, "acquire", resource, "--ttl", "60"]
    if holder:
        acquire_args += ["--holder-pid", holder]
    lease_real = here.parents[1] / "lease" / "cli.real"
    acquired = call(lease_real, acquire_args)
    token = acquired.stdout.decode(errors="replace").strip()
    if acquired.returncode != 0 or not token:
        raise RuntimeError(f"successor acquire föll: {acquired.stderr!r}")
    attest_real = here.parents[1] / "attest" / "cli.real"
    begun = call(attest_real, [attest_dir, "begin-authority", token])
    if begun.returncode != 0:
        raise RuntimeError(f"successor begin föll: {begun.stderr!r}")
    anchor_task = "h004-successor-anchor"
    anchor_sha = "f" * 40
    written = call(
        attest_real,
        [attest_dir, "write", anchor_task, anchor_sha, "--authority", token],
    )
    readable = call(
        attest_real,
        [attest_dir, "read", anchor_task, "--authority", token],
    )
    if written.returncode != 0 or readable.returncode != 0 or anchor_sha.encode() not in readable.stdout:
        raise RuntimeError("successor provisional anchor kunde inte etableras")
    lease_file = pathlib.Path(lease_dir) / f"{resource}.lease"
    save_successor(token, lease_file, anchor_task, anchor_sha)
    deadline_marker = os.environ.get("H004_GUARD_DEADLINE_MARKER", "")
    deadline_open = bool(deadline_marker) and not pathlib.Path(deadline_marker).exists()
    trace(
        "injected_successor",
        successor_token=token,
        before_heartbeat_deadline=deadline_open if deadline_marker else None,
    )
    return token

cmd = command()
start_extra = {}
if component == "lease" and cmd == "renew" and mode == "replace_final_guard":
    deadline_marker = os.environ.get("H004_GUARD_DEADLINE_MARKER", "")
    start_extra["before_heartbeat_deadline"] = bool(deadline_marker) and not pathlib.Path(
        deadline_marker
    ).exists()
if component == "lease" and cmd == "renew" and mode == "default_timing":
    immediate_closed = os.environ.get("H004_DEFAULT_IMMEDIATE_CLOSED", "")
    window_open = os.environ.get("H004_DEFAULT_WINDOW_OPEN", "")
    window_closed = os.environ.get("H004_DEFAULT_WINDOW_CLOSED", "")
    start_extra["default_immediate_window"] = bool(immediate_closed) and not pathlib.Path(
        immediate_closed
    ).exists()
    start_extra["default_heartbeat_window"] = (
        bool(window_open) and pathlib.Path(window_open).exists()
        and bool(window_closed) and not pathlib.Path(window_closed).exists()
    )
trace("start", **start_extra)

try:
    if component == "attest" and cmd == "begin-authority" and mode == "begin_fail":
        trace("injected_begin_fail")
        result = answer(1, err=b"injected begin failure\n")
    elif component == "attest" and cmd == "finalize-authority" and mode == "finalize_fail":
        trace("injected_finalize_fail")
        result = answer(1, err=b"injected finalize failure\n")
    elif component == "attest" and cmd == "finalize-authority" and mode == "crash_finalize":
        run_pid_file = pathlib.Path(os.environ["H004_DEADLINE_CHILD_PID_FILE"])
        run_pid = int(run_pid_file.read_text(encoding="utf-8").strip())
        trace("crash_before_finalize", run_pid=run_pid)
        os.kill(run_pid, signal.SIGKILL)
        result = answer(1, err=b"parent survived injected crash\n")
    elif component == "lease" and cmd == "release" and mode == "release_refuse":
        trace("injected_release_refuse")
        result = answer(1, err=b"injected release refusal\n")
    elif component == "lease" and cmd == "release" and mode == "release_delete_fail":
        delegated = call(real, args)
        trace("injected_release_delete_fail", delegated_rc=delegated.returncode)
        result = answer(1, delegated.stdout, b"injected failure after release\n")
    elif component == "lease" and cmd == "release" and mode in ("release_delay", "default_timing"):
        # Deterministic observer window: en heartbeat som inte stop/joinats
        # före release blir synlig i trace medan releasen pågår.
        time.sleep(0.5)
        result = call(real, args)
    else:
        result = call(real, args)

    if component == "lease" and cmd == "acquire" and mode == "default_timing" and result.returncode == 0:
        pathlib.Path(os.environ["H004_DEFAULT_ACQUIRED"]).write_text(
            "acquired\n", encoding="utf-8"
        )

    if component == "lease" and cmd == "release" and mode == "successor_after_release" and result.returncode == 0:
        trace("delegated_release_success")
        install_successor(args[0], args[2], os.environ["H004_ATTEST_DIR"])

    if component == "attest" and cmd == "write" and mode == "replace_after_write" and result.returncode == 0:
        once = pathlib.Path(os.environ["H004_BARRIER_ONCE"])
        try:
            fd = os.open(once, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            fd = None
        if fd is not None:
            os.close(fd)
            lease_dir = os.environ["H004_LEASE_DIR"]
            resource = os.environ["H004_LEASE_RESOURCE"]
            (pathlib.Path(lease_dir) / f"{resource}.lease").unlink(missing_ok=True)
            install_successor(lease_dir, resource, os.environ["H004_ATTEST_DIR"])

    if (
        component == "taskval"
        and cmd == "claim"
        and mode == "replace_final_guard"
        and result.returncode == 0
        and not result.stdout.strip()
    ):
        once = pathlib.Path(os.environ["H004_BARRIER_ONCE"])
        try:
            fd = os.open(once, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            fd = None
        if fd is not None:
            os.close(fd)
            lease_dir = os.environ["H004_LEASE_DIR"]
            resource = os.environ["H004_LEASE_RESOURCE"]
            (pathlib.Path(lease_dir) / f"{resource}.lease").unlink(missing_ok=True)
            install_successor(lease_dir, resource, os.environ["H004_ATTEST_DIR"])
finally:
    if "result" not in locals():
        result = answer(1, err=b"trace wrapper injection failed\n")

trace(
    "end",
    rc=result.returncode,
    stdout=result.stdout.decode(errors="replace"),
    stderr=result.stderr.decode(errors="replace"),
)
sys.stdout.buffer.write(result.stdout)
sys.stderr.buffer.write(result.stderr)
raise SystemExit(result.returncode)
PYTRACE
