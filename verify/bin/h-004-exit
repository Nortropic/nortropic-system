#!/bin/sh
out="$H004_TRACE.taskval.$$.out"; err="$H004_TRACE.taskval.$$.err"
selector_bait=""; selector_tag=""
if [ -n "${H004_PROVIDER_BAIT-}" ]; then
  selector_bait="$H004_PROVIDER_BAIT"; selector_tag="PROVIDER"
elif [ -n "${H004_CONFIG_BAIT-}" ]; then
  selector_bait="$H004_CONFIG_BAIT"; selector_tag="CONFIG"
fi
if [ -n "$selector_bait" ] && [ ! -e "$H004_TRACE.selector-flipped" ] \
   && [ -s "$H004_TRACE.holder" ] && [ -s "$H004_TRACE.root" ]; then
  for marker in "$H004_WORK_MARK".*; do
    if [ -f "$marker" ]; then
      holder=$(cat "$H004_TRACE.holder")
      root=$(cat "$H004_TRACE.root")
      expected=$("$H004_CAP_MAKER" "$selector_bait" "$root" "$holder" B 2>/dev/null || true)
      actual=$(shasum -a 256 "$selector_bait" 2>/dev/null | awk '{print $1}')
      if [ -n "$expected" ] && [ "$expected" = "$actual" ]; then
        printf '%s_BAIT_FLIPPED\t%s\n' "$selector_tag" "$actual" >> "$H004_TRACE"
        : > "$H004_TRACE.selector-flipped"
      else
        printf '%s_BAIT_FLIP_FAILED\t%s\t%s\n' "$selector_tag" "$expected" "$actual" >> "$H004_TRACE"
      fi
      break
    fi
  done
fi
printf 'TASKVAL_ENTER\t%s\n' "$*" >> "$H004_TRACE"
"$(dirname "$0")/real" "$@" >"$out" 2>"$err"; rc=$?
cat "$out"; cat "$err" >&2
printf 'TASKVAL\t%s\t%s\n' "$rc" "$*" >> "$H004_TRACE"
if [ "${1-}" = "claim" ] && [ "$rc" -eq 0 ] && [ ! -s "$out" ]; then
  printf 'TASKVAL_DRAIN\t0\t%s\n' "$*" >> "$H004_TRACE"
fi
rm -f "$out" "$err"
exit "$rc"
SH

CAP_MAKER="$WORK/make-final-guard-cap.py"
