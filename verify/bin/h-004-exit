cat > "$WORK/h004-trace-valid.py" <<'PYTRACEVALID'
import json
import pathlib
import sys

try:
    rows = [json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines() if line.strip()]
    if any(
        not isinstance(row, dict)
        or not isinstance(row.get("component"), str)
        or not isinstance(row.get("command"), str)
        or not isinstance(row.get("phase"), str)
        or not isinstance(row.get("pid"), int)
        for row in rows
    ):
        raise ValueError("bad trace row")
except Exception as exc:
    print(f"invalid trace: {exc}", file=sys.stderr)
    raise SystemExit(1)
PYTRACEVALID

