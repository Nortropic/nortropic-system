import base64,json,os,sys
from pathlib import Path
p=Path(sys.argv[1]).resolve(); root=Path(sys.argv[2]).resolve(); pid=int(sys.argv[3])
d={"kind":"h004-process-incarnation-v1","lease_root":str(root),"observations":[{"host":os.uname().nodename,"pid":pid,"status":"LIVE","token_b64":base64.b64encode(b"provider-session-bait\x00\xff").decode()}]}
p.write_text(json.dumps(d,sort_keys=True,separators=(",",":"))); p.chmod(0o600)
