if token_ok "$token_fail21"; then
  "$ATT" "$A21F" read auth-negative --require-authority "$token_fail21" >/dev/null 2>&1
  scoped_fail21=$?
fi
owner_fail21=$("$CLI" "$D21F" owner s3-release-fail-resource 2>/dev/null || true)
sha_fail21=$(file_sha "$D21F/s3-release-fail-resource.lease")
if [ "$release_fail21_rc" -eq 1 ] && [ "$valid_fail21" -ne 0 ] \
   && [ "$prefix_fail21_rc" -eq 0 ] && token_ok "$token_fail21" \
   && [ "$scoped_fail21" -eq 0 ] && [ -n "$owner_fail21" ] && [ -n "$sha_fail21" ]; then
  ok "K21 release failure ger ingen FINALIZE och provisional publication forblir globalt ogiltig"
else
  no "K21 release-failure fencing" "loop/valid/prefix/scoped/owner/sha=$release_fail21_rc/$valid_fail21/$prefix_fail21_rc/$scoped_fail21/[$owner_fail21]/[$sha_fail21] evidence=[$prefix_fail21_out]"
fi
if token_ok "$token_fail21"; then
  "$CLI" "$D21F" release s3-release-fail-resource "$token_fail21" >/dev/null 2>&1 || true
