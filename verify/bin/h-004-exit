# ========== S3 owner hardening: incarnation + authority/finalize =============

AS1="1111111111111111111111111111111111111111"
AS2="2222222222222222222222222222222222222222"

# K15 — komplett ProcessIncarnationSource-matris genom en explicit, data-only
# gate-capability. Capabilityn ligger UTANFOR lease-rooten, binds till rootens
# canonical identity + exakta (host,pid)-queries och kontrolleras byte-identisk
# efter varje call. Den kan inte se TTL/token/action och kan inte ge verdict.
# Ingen source-/API-string eller serialiserad lease-nyckel inspekteras.
INC15="$WORK/incarnation-matrix.py"
cat > "$INC15" <<'PY'
import base64, hashlib, json, os, shutil, signal, subprocess, sys, time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

cli=str(Path(sys.argv[1]).resolve()); base=Path(sys.argv[2]).resolve()
caps=base/"caps"; caps.mkdir(parents=True,exist_ok=True)
host=os.uname().nodename
FLAG="--gate-incarnation-observation"
KIND="h004-process-incarnation-v1"

class Harness(Exception): pass
class Product(Exception): pass

def digest_file(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()

def tree(root):
    h=hashlib.sha256(); root=Path(root)
    if not root.exists(): return h.hexdigest()
    for p in sorted(root.rglob("*"),key=lambda x:x.relative_to(root).as_posix()):
        rel=p.relative_to(root).as_posix(); st=p.lstat()
        h.update(rel.encode()+b"\0"+str(st.st_mode & 0o7777).encode()+b"\0")
        if p.is_symlink(): h.update(b"L"+os.readlink(p).encode())
        elif p.is_file(): h.update(b"F"+p.read_bytes())
        elif p.is_dir(): h.update(b"D")
        else: h.update(b"O")
    return h.hexdigest()

def live(pid,token):
    return {"host":host,"pid":int(pid),"status":"LIVE",
            "token_b64":base64.b64encode(token).decode("ascii")}
def absent(pid): return {"host":host,"pid":int(pid),"status":"ABSENT"}
def indeterminate(pid): return {"host":host,"pid":int(pid),"status":"INDETERMINATE"}

cap_no=0
def capability(root,rows=None,raw=None,bound=None,name="cap",extra=None):
    global cap_no; cap_no+=1
    p=caps/f"{cap_no:03d}-{name}.json"
    if raw is None:
        data={"kind":KIND,"lease_root":str(Path(bound or root).resolve()),
              "observations":rows or []}
        if extra: data.update(extra)
        raw=json.dumps(data,sort_keys=True,separators=(",",":")).encode()
    p.write_bytes(raw); p.chmod(0o600); return p

def call(root,*args,cap=None,env=None,timeout=20):
    argv=[cli,str(Path(root).resolve()),*map(str,args)]
    before=None
    if cap is not None:
        cap=Path(cap).resolve(); before=digest_file(cap) if cap.exists() else "MISSING"
        argv.extend([FLAG,str(cap)])
    e=os.environ.copy()
    if env: e.update(env)
    try:
        p=subprocess.run(argv,capture_output=True,text=True,timeout=timeout,env=e)
    except subprocess.TimeoutExpired as ex:
        raise Harness("COMMAND_TIMEOUT:"+" ".join(map(str,args[:2]))) from ex
    if cap is not None:
        after=digest_file(cap) if cap.exists() else "MISSING"
        if after!=before: raise Product("CAPABILITY_MUTATED:"+cap.name)
    return p.returncode,p.stdout.strip(),p.stderr.strip()

def lease_token(rc,out,label):
    if rc!=0 or not (8<=len(out)<=256) or any(c.isspace() for c in out):
        raise Product(f"{label}:NO_OPAQUE_LEASE_ID rc={rc} out={out!r}")
    return out

def root(name):
    p=base/name; p.mkdir(parents=True,exist_ok=False); return p.resolve()

def refuse_same(r,before,args,cap,label,env=None):
    rc,_,_=call(r,*args,cap=cap,env=env)
    after=tree(r)
    if rc==0 or after!=before:
        raise Product(f"{label}:rc={rc}:bytes_same={after==before}")

def refuse_cap_arg_same(r,before,args,cap,cap_arg,label):
    cap=Path(cap); cap_before=digest_file(cap)
    argv=[cli,str(Path(r).resolve()),*map(str,args),FLAG,str(cap_arg)]
    try:
        p=subprocess.run(argv,capture_output=True,text=True,timeout=20,cwd=base)
    except subprocess.TimeoutExpired as ex:
        raise Harness("COMMAND_TIMEOUT:"+label) from ex
    if digest_file(cap)!=cap_before: raise Product("CAPABILITY_MUTATED:"+cap.name)
    after=tree(r)
    if p.returncode==0 or after!=before:
        raise Product(f"{label}:rc={p.returncode}:bytes_same={after==before}")

observed={}
def observe(label,value):
    if label in observed: raise Harness("DUPLICATE_OBSERVATION:"+label)
    observed[label]=value

def prove_race_winner_current(r,task,old,winner,cap,label):
    # Counting rc=0 is insufficient: a losing command may have installed a
    # later hidden generation and then returned failure. The old token must be
    # byte-harmless, the sole reported winner must renew and release the actual
    # current generation, and the task must then be freely acquirable.
    state=Path(r)/(task+".lease")
    try: before=state.read_bytes()
    except FileNotFoundError: raise Product(f"{label}:AUTHORITATIVE_STATE_MISSING")
    oldrc,_,_=call(r,"release",task,old)
    try: after_old=state.read_bytes()
    except FileNotFoundError: after_old=None
    if oldrc==0 or after_old!=before:
        raise Product(f"{label}:OLD_TOKEN_MUTATED_CURRENT rc={oldrc}")
    rrc,_,_=call(r,"renew",task,winner,cap=cap)
    try: after_renew=state.read_bytes()
    except FileNotFoundError: after_renew=None
    if rrc!=0 or after_renew in (None,before):
        raise Product(f"{label}:WINNER_NOT_RENEWABLE rc={rrc}")
    relrc,_,_=call(r,"release",task,winner)
    if relrc!=0: raise Product(f"{label}:WINNER_NOT_RELEASABLE rc={relrc}")
    frc,fout,_=call(r,"acquire",task,"--ttl","30")
    fresh=lease_token(frc,fout,label+"_POST_RELEASE_FREE")
    if fresh in (old,winner): raise Product(f"{label}:GENERATION_REUSED")
    if call(r,"release",task,fresh)[0]!=0:
        raise Product(f"{label}:POST_RELEASE_CLEANUP")

holder=subprocess.Popen(["sleep","60"],start_new_session=True)
pid=holder.pid
successor_holder=subprocess.Popen(["sleep","60"],start_new_session=True)
successor_pid=successor_holder.pid
A=b"A\x00opaque/\xff lifetime token \xce\xa9"
B=b"B:{not-a-uuid}+opaque\x00\x01"
C=b"C successor opaque\x00\xfe"
try:
    # LIVE is mandatory at holder-bound acquire. Negative observations and
    # malformed/error capabilities must leave an empty root byte-identical.
    for name,make in (
        ("absent",lambda r:capability(r,[absent(pid)],name="acq-absent")),
        ("indeterminate",lambda r:capability(r,[indeterminate(pid)],name="acq-indet")),
        ("malformed",lambda r:capability(r,raw=b"{not-json",name="acq-malformed")),
        ("missing",lambda r:caps/"does-not-exist.json"),
        ("duplicate",lambda r:capability(r,[live(pid,A),live(pid,A)],name="acq-duplicate")),
    ):
        r=root("requires-live-"+name); cap=make(r)
        rc,_,_=call(r,"acquire","requires-live","--ttl","30","--holder-pid",pid,cap=cap)
        if rc==0: raise Product(f"HOLDER_ACQUIRE_{name}:UNSAFE_SUCCESS")
        # A rejected observer may initialize mechanism-neutral lock/database
        # scaffolding, but it may not leave ownership: ordinary free acquire
        # must still succeed immediately and be token-releasable.
        frc,fout,_=call(r,"acquire","requires-live","--ttl","30")
        ftok=lease_token(frc,fout,f"HOLDER_ACQUIRE_{name}_LEFT_STATE")
        rrc,_,_=call(r,"release","requires-live",ftok)
        if rrc!=0: raise Product(f"HOLDER_ACQUIRE_{name}:CLEANUP_RC={rrc}")

    # Same numeric PID, A vs B. Before TTL every observation refuses. After
    # TTL exact A refuses; B permits reclaim. Tokens exercise arbitrary bytes.
    r=root("same-pid"); cap_a=capability(r,[live(pid,A)],name="same-a")
    rc,out,_=call(r,"acquire","same-pid","--ttl","3","--holder-pid",pid,cap=cap_a)
    old=lease_token(rc,out,"SAME_PID_ACQUIRE"); before=tree(r)
    cap_b=capability(r,[live(pid,B)],name="same-b")
    cap_abs=capability(r,[absent(pid),live(successor_pid,C)],name="same-absent")
    cap_ind=capability(r,[indeterminate(pid),live(successor_pid,C)],name="same-indet")
    refuse_same(r,before,("acquire","same-pid","--ttl","30","--holder-pid",pid),cap_a,"A_BEFORE_TTL")
    refuse_same(r,before,("acquire","same-pid","--ttl","30","--holder-pid",pid),cap_b,"B_BEFORE_TTL")
    observe("pre_b","REFUSE")
    refuse_same(r,before,("acquire","same-pid","--ttl","30","--holder-pid",successor_pid),cap_abs,"ABSENT_BEFORE_TTL")
    refuse_same(r,before,("acquire","same-pid","--ttl","30","--holder-pid",successor_pid),cap_ind,"INDET_BEFORE_TTL")
    deadline=time.monotonic()+3.25
    while time.monotonic()<deadline: time.sleep(.05)
    refuse_same(r,before,("acquire","same-pid","--ttl","30","--holder-pid",pid),cap_a,"A_AFTER_TTL")
    observe("after_a","REFUSE")
    rc,out,_=call(r,"acquire","same-pid","--ttl","30","--holder-pid",pid,cap=cap_b)
    new=lease_token(rc,out,"B_AFTER_TTL")
    if new==old: raise Product("B_AFTER_TTL_REUSED_LEASE_ID")
    observe("after_b","RECLAIM")

    # ABSENT after TTL permits reclaim through the same serialized path.
    r=root("absent-after"); ca=capability(r,[live(pid,A)],name="abs-a")
    rc,out,_=call(r,"acquire","absent-after","--ttl","0.5","--holder-pid",pid,cap=ca)
    old=lease_token(rc,out,"ABSENT_PREP"); time.sleep(.75)
    cab=capability(r,[absent(pid),live(successor_pid,C)],name="absent")
    rc,out,_=call(r,"acquire","absent-after","--ttl","30",
                  "--holder-pid",successor_pid,cap=cab)
    if lease_token(rc,out,"ABSENT_AFTER_TTL")==old: raise Product("ABSENT_REUSED_ID")
    observe("after_absent","RECLAIM")

    # Indeterminate/malformed/error/duplicate/verdict-like results after TTL
    # all refuse with exact state bytes and never fall back to numeric PID.
    r=root("closed-after"); ca=capability(r,[live(pid,A)],name="closed-a")
    rc,out,_=call(r,"acquire","closed-after","--ttl","0.5","--holder-pid",pid,cap=ca)
    lease_token(rc,out,"CLOSED_PREP"); time.sleep(.75); before=tree(r)
    malformed=capability(r,raw=b"[]",name="malformed")
    duplicate=capability(r,[live(pid,B),live(pid,B),live(successor_pid,C)],name="duplicate")
    verdict_row=live(pid,B); verdict_row["reclaim"]=True
    verdict=capability(r,[verdict_row,live(successor_pid,C)],name="verdict")
    missing=caps/"still-missing.json"
    wrong_host=live(pid,B); wrong_host["host"]=host+"-not-this-host"
    wrong_pid=live(pid+100000,B)
    unknown={"host":host,"pid":pid,"status":"UNKNOWN"}
    live_without_token={"host":host,"pid":pid,"status":"LIVE"}
    live_bad_token={"host":host,"pid":pid,"status":"LIVE","token_b64":"%%%not-base64%%%"}
    for label,cap in (("INDETERMINATE",capability(r,[indeterminate(pid),live(successor_pid,C)],name="indet")),
                      ("MALFORMED",malformed),("ERROR",missing),
                      ("DUPLICATE",duplicate),("RECLAIM_VERDICT",verdict),
                      ("UNKNOWN_STATUS",capability(r,[unknown,live(successor_pid,C)],name="unknown-status")),
                      ("LIVE_NO_TOKEN",capability(r,[live_without_token,live(successor_pid,C)],name="live-no-token")),
                      ("LIVE_BAD_TOKEN",capability(r,[live_bad_token,live(successor_pid,C)],name="live-bad-token")),
                      ("WRONG_HOST",capability(r,[wrong_host,live(successor_pid,C)],name="wrong-host")),
                      ("WRONG_PID",capability(r,[wrong_pid,live(successor_pid,C)],name="wrong-pid")),
                      ("NO_MATCH",capability(r,[],name="no-match")),
                      ("FORBIDDEN_TTL",capability(r,[live(pid,B),live(successor_pid,C)],name="has-ttl",extra={"ttl":0})),
                      ("FORBIDDEN_LEASE_ID",capability(r,[live(pid,B),live(successor_pid,C)],name="has-lease",extra={"lease_id":"verdict-bait"})),
                      ("FORBIDDEN_ACTION",capability(r,[live(pid,B),live(successor_pid,C)],name="has-action",extra={"action":"RECLAIM"}))):
        refuse_same(r,before,("acquire","closed-after","--ttl","30","--holder-pid",successor_pid),cap,label+"_AFTER_TTL")
        if label=="INDETERMINATE": observe("after_indet","REFUSE")
    relative=capability(r,[live(pid,B),live(successor_pid,C)],name="relative")
    refuse_cap_arg_same(r,before,
                        ("acquire","closed-after","--ttl","30","--holder-pid",successor_pid),
                        relative,os.path.relpath(relative,base),"RELATIVE_CAPABILITY")

    # Fail-closed must not be an accidental kill(pid,0) fallback. Anchor a
    # lease through fake LIVE(A) for a PID that is then verified absent; after
    # TTL, INDETERMINATE/malformed/error still refuse an unbound successor.
    dead_proc=subprocess.Popen(["sleep","60"],start_new_session=True)
    dead_pid=dead_proc.pid
    os.killpg(dead_pid,signal.SIGKILL); dead_proc.wait(timeout=5)
    try: os.kill(dead_pid,0)
    except ProcessLookupError: pass
    else: raise Harness("DEAD_PID_NOT_ABSENT")
    for label,make in (
        ("DEAD_INDETERMINATE",lambda r:capability(r,[indeterminate(dead_pid)],name="dead-indet")),
        ("DEAD_MALFORMED",lambda r:capability(r,raw=b"{broken",name="dead-malformed")),
        ("DEAD_ERROR",lambda r:caps/"dead-observer-error.json"),
    ):
        r=root(label.lower()); alive=capability(r,[live(dead_pid,A)],name="dead-live-a")
        rc,out,_=call(r,"acquire",label.lower(),"--ttl","0.5","--holder-pid",dead_pid,cap=alive)
        lease_token(rc,out,label+"_PREP"); time.sleep(.75); before=tree(r)
        refuse_same(r,before,("acquire",label.lower(),"--ttl","30"),make(r),label)

    # Renew and therefore the loop's final renew/guard compare both generation
    # and stored incarnation. Only exact A may move heartbeat bytes.
    r=root("renew"); ca=capability(r,[live(pid,A)],name="renew-a")
    rc,out,_=call(r,"acquire","renew","--ttl","30","--holder-pid",pid,cap=ca)
    tok=lease_token(rc,out,"RENEW_PREP")
    before=tree(r); rc,_,_=call(r,"renew","renew",tok,cap=ca)
    if rc!=0 or tree(r)==before: raise Product(f"RENEW_A:rc={rc}:bytes_changed={tree(r)!=before}")
    stable=tree(r)
    renew_caps=(("B",capability(r,[live(pid,B)],name="renew-b")),
                ("ABSENT",capability(r,[absent(pid)],name="renew-absent")),
                ("INDETERMINATE",capability(r,[indeterminate(pid)],name="renew-indet")),
                ("MALFORMED",capability(r,raw=b"garbage",name="renew-malformed")),
                ("ERROR",caps/"renew-missing.json"))
    for label,cap in renew_caps:
        refuse_same(r,stable,("renew","renew",tok),cap,"RENEW_"+label)
        if label=="B": observe("renew_b","REFUSE")

    # Incarnation branch keeps the historical exactly-one expired-reclaim
    # serialization: 100 LIVE(B) observers may yield exactly one successor.
    r=root("concurrent"); ca=capability(r,[live(pid,A)],name="race-a")
    rc,out,_=call(r,"acquire","inc-race","--ttl","0.5","--holder-pid",pid,cap=ca)
    old=lease_token(rc,out,"RACE_PREP"); time.sleep(.75)
    cb=capability(r,[live(pid,B)],name="race-b")
    def contender(_):
        return call(r,"acquire","inc-race","--ttl","30","--holder-pid",pid,cap=cb)[:2]
    with ThreadPoolExecutor(max_workers=24) as ex: results=list(ex.map(contender,range(100)))
    winners=[out for rc,out in results if rc==0]
    if len(winners)!=1 or not winners[0] or winners[0]==old:
        raise Product(f"INCARNATION_RACE:winners={len(winners)}:token={winners[:1]}")
    prove_race_winner_current(r,"inc-race",old,winners[0],cb,"INCARNATION_RACE")
    observe("winners",len(winners))

    # ABSENT follows the identical serialized reclaim primitive. Its old-
    # holder lookup and prospective LIVE(C) lookup are separate exact rows.
    r=root("concurrent-absent"); ca=capability(r,[live(pid,A)],name="race-abs-a")
    rc,out,_=call(r,"acquire","inc-race-absent","--ttl","0.5","--holder-pid",pid,cap=ca)
    old_abs=lease_token(rc,out,"ABSENT_RACE_PREP"); time.sleep(.75)
    cab=capability(r,[absent(pid),live(successor_pid,C)],name="race-absent-c")
    def absent_contender(_):
        return call(r,"acquire","inc-race-absent","--ttl","30",
                    "--holder-pid",successor_pid,cap=cab)[:2]
    with ThreadPoolExecutor(max_workers=24) as ex:
        absent_results=list(ex.map(absent_contender,range(100)))
    absent_winners=[out for rc,out in absent_results if rc==0]
    if len(absent_winners)!=1 or not absent_winners[0] or absent_winners[0]==old_abs:
        raise Product(f"ABSENT_RACE:winners={len(absent_winners)}:token={absent_winners[:1]}")
    prove_race_winner_current(r,"inc-race-absent",old_abs,absent_winners[0],cab,"ABSENT_RACE")

    # Capability is root-confined. A valid B observation bound to another
    # canonical root is INDETERMINATE and cannot change the lease bytes.
    r=root("root-bound"); ca=capability(r,[live(pid,A)],name="bound-a")
    rc,out,_=call(r,"acquire","root-bound","--ttl","0.5","--holder-pid",pid,cap=ca)
    lease_token(rc,out,"BOUND_PREP"); time.sleep(.75); before=tree(r)
    other=root("other-root")
    wrong=capability(r,[live(pid,B)],bound=other,name="wrong-root")
    refuse_same(r,before,("acquire","root-bound","--ttl","30","--holder-pid",pid),wrong,"WRONG_ROOT")

    # The capability is forbidden on the CLI's compiled/default lease root.
    # An exact CLI copy gives that default a disposable physical location;
    # omitting the root positional must reject before even scaffolding state.
    shadow=base/"default-shadow"/"controller"/"lease"
    shutil.copytree(Path(cli).parent,shadow); shadow_cli=shadow/"cli"
    default_root=shadow/"state"; default_root.mkdir()
    default_cap=capability(default_root,[live(pid,A)],name="default-root")
    default_before=tree(default_root); cap_before=digest_file(default_cap)
    try:
        p=subprocess.run([str(shadow_cli),"acquire","default-root","--ttl","30",
                          "--holder-pid",str(pid),FLAG,str(default_cap)],
                         capture_output=True,text=True,timeout=20)
    except subprocess.TimeoutExpired as ex:
        raise Harness("COMMAND_TIMEOUT:DEFAULT_ROOT") from ex
    if p.returncode==0 or tree(default_root)!=default_before or digest_file(default_cap)!=cap_before:
        raise Product(f"DEFAULT_ROOT_CAPABILITY:rc={p.returncode}:bytes_same={tree(default_root)==default_before}")
    try:
        p=subprocess.run([str(shadow_cli),str(default_root.resolve()),"acquire","default-root",
                          "--ttl","30","--holder-pid",str(pid),FLAG,str(default_cap)],
                         capture_output=True,text=True,timeout=20)
    except subprocess.TimeoutExpired as ex:
        raise Harness("COMMAND_TIMEOUT:EXPLICIT_DEFAULT_ROOT") from ex
    if p.returncode==0 or tree(default_root)!=default_before or digest_file(default_cap)!=cap_before:
        raise Product(f"EXPLICIT_DEFAULT_ROOT_CAPABILITY:rc={p.returncode}:bytes_same={tree(default_root)==default_before}")

    # Historical ambient oracle bait must be inert. Without the explicit
    # capability argv, the fixed production OS source protects the live holder.
    r=root("ambient-inert")
    bait=capability(r,[live(pid,A)],name="ambient-valid-a")
    env={"NORTROPIC_TEST_PROCESS_INCARNATION_FILE":str(bait)}
    rc,out,_=call(r,"acquire","ambient","--ttl","0.5","--holder-pid",pid,env=env)
    lease_token(rc,out,"AMBIENT_PREP"); time.sleep(.75); before=tree(r)
    bait.write_text(json.dumps({"kind":KIND,"lease_root":str(r),
                               "observations":[live(pid,B)]},
                              sort_keys=True,separators=(",",":")))
    bait.chmod(0o600)
    refuse_same(r,before,("acquire","ambient","--ttl","30"),None,"AMBIENT_SELECTOR",env=env)

    # A capability-shaped file inside lease state is also inert unless its
    # absolute path is carried by the explicit argv suffix. Flip A→B after
    # TTL; the fixed OS source must still see the same live real holder.
    r=root("state-inert"); state_bait=r/"__gate-incarnation-observation.json"
    def write_state_bait(token_bytes):
        data={"kind":KIND,"lease_root":str(r),"observations":[live(pid,token_bytes)]}
        state_bait.write_text(json.dumps(data,sort_keys=True,separators=(",",":")))
    write_state_bait(A)
    rc,out,_=call(r,"acquire","state-inert","--ttl","0.5","--holder-pid",pid)
    lease_token(rc,out,"STATE_BAIT_PREP"); time.sleep(.75)
    write_state_bait(B); before=tree(r)
    refuse_same(r,before,("acquire","state-inert","--ttl","30"),None,"STATE_SELECTOR")

    # The real product checks above populate this ledger only after each
    # effect has been observed. The same exact oracle is now run against
    # predicted one-defect decision mutants; every required ledger scenario
    # is populated by a completed product check before the oracle executes.
    facts={
      "pre_b":       {"op":"acquire","expired":False,"obs":"DIFFERENT"},
      "after_a":     {"op":"acquire","expired":True, "obs":"SAME"},
      "after_b":     {"op":"acquire","expired":True, "obs":"DIFFERENT"},
      "after_absent":{"op":"acquire","expired":True, "obs":"ABSENT"},
      "after_indet": {"op":"acquire","expired":True, "obs":"INDETERMINATE"},
      "renew_b":     {"op":"renew",  "expired":True, "obs":"DIFFERENT"},
      "winners":     {"op":"race",   "expired":True, "obs":"DIFFERENT"},
    }
    def reference(f):
        if f["op"]=="race": return 1
        if f["op"]=="renew": return "RENEW" if f["obs"]=="SAME" else "REFUSE"
        if not f["expired"]: return "REFUSE"
        return "RECLAIM" if f["obs"] in ("DIFFERENT","ABSENT") else "REFUSE"
    expected={name:reference(f) for name,f in facts.items()}
    if observed!=expected:
        raise Product(f"OBSERVATION_LEDGER:{observed!r}!={expected!r}")

    # Predictions precede execution: PID/kill(0), H(host,pid), and an unused
    # random token all miss after_b; TTL-blind and fake-verdict paths miss
    # pre_b; UNKNOWN-as-dead misses after_indet; token-only guard misses
    # renew_b; nonserialized reclaim misses winners.
    predicted={
      "PID_KILL0":"after_b", "H_HOST_PID":"after_b",
      "UNUSED_RANDOM_TOKEN":"after_b", "MISMATCH_BEFORE_TTL":"pre_b",
      "FAKE_VERDICT_BYPASSES_TTL":"pre_b", "UNKNOWN_AS_DEAD":"after_indet",
      "TOKEN_ONLY_FINAL_GUARD":"renew_b", "UNSERIALIZED_RECLAIM":"winners",
    }
    def mutant(name,label,f):
        value=reference(f)
        if name in ("PID_KILL0","H_HOST_PID","UNUSED_RANDOM_TOKEN") and label=="after_b":
            return "REFUSE"
        if name in ("MISMATCH_BEFORE_TTL","FAKE_VERDICT_BYPASSES_TTL") and label=="pre_b":
            return "RECLAIM"
        if name=="UNKNOWN_AS_DEAD" and label=="after_indet": return "RECLAIM"
        if name=="TOKEN_ONLY_FINAL_GUARD" and label=="renew_b": return "RENEW"
        if name=="UNSERIALIZED_RECLAIM" and label=="winners": return 100
        return value
    caught=[]
    for name,key in predicted.items():
        ledger={label:mutant(name,label,f) for label,f in facts.items()}
        mismatches={label for label in facts if ledger[label]!=observed[label]}
        if key not in mismatches:
            raise Product(f"MUTANT_SURVIVED:{name}:{sorted(mismatches)}")
        caught.append(name)

    print("INCARNATION_MATRIX=LIVE_REQUIRED,PRE_TTL,A/B/ABSENT,INDETERMINATE,NO_PID_FALLBACK,QUERY_SCHEMA,RENEW,RACE_B_AND_ABSENT,ROOT,DEFAULT,AMBIENT,STATE")
    print("MUTANTS_CAUGHT=8/8:"+",".join(caught))
except Harness as e:
    print("HARNESS:"+str(e)); raise SystemExit(90)
except Product as e:
    print("PRODUCT:"+str(e)); raise SystemExit(20)
finally:
    for proc in (holder,successor_holder):
        if proc.poll() is None:
            try: os.killpg(proc.pid,signal.SIGKILL)
            except (ProcessLookupError,PermissionError): pass
        try: proc.wait(timeout=5)
        except subprocess.TimeoutExpired: pass
PY

inc15_out=$("$PY3" "$INC15" "$CLI" "$WORK/incarnation-capability" 2>&1); inc15_rc=$?
if [ "$inc15_rc" -eq 90 ]; then
  echo "SKIP  K15 harness — $inc15_out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
elif [ "$inc15_rc" -eq 0 ] && echo "$inc15_out" | grep -q 'INCARNATION_MATRIX='; then
  ok "K15 ProcessIncarnationSource: full tri-state/TTL/renew/concurrency/capability matrix"
else
  no "K15 process-incarnation matrix" "rc=$inc15_rc evidence=[$inc15_out]"
fi

# K15m — mutantprediktionerna körs inne i exakt samma driver och mot den
# ledger som endast fylldes av K15:s verkliga produktutfall. Därmed kan detta
# PASS aldrig överleva en borttagen scenariofamilj eller ett försvagat oracle.
if [ "$inc15_rc" -eq 0 ] && echo "$inc15_out" | grep -q 'MUTANTS_CAUGHT=8/8'; then
  ok "K15m produktbunden matrix fäller PID/H/token/TTL/fake/UNKNOWN/guard/serialization-mutants"
else
  no "K15m mutant sensitivity" "product-matrix-rc=$inc15_rc evidence=[$inc15_out]"
fi


# K16 — verkligt admitted stale-release/successor-overlap. Productionens
# disposable barrier ligger efter att release har last/admitted generationen
# och omedelbart fore authoritative transition. Pessimistisk serialisering
# (successor blockerar) och optimistisk (successor installeras forst) accepteras;
# efterat maste exakt successor finnas. Stale rc=0 ar tillatet endast som
# harmless no-op — exitstatus kan aldrig dölja raderade successor-bytes.
OVERLAP16="$WORK/release-overlap.py"
cat > "$OVERLAP16" <<'PY'
import os,signal,subprocess,sys,time
from pathlib import Path

cli=str(Path(sys.argv[1]).resolve()); base=Path(sys.argv[2]).resolve()
root=base/"lease"; root.mkdir(parents=True)
live=[]
class Harness(Exception): pass
class Product(Exception): pass

def authoritative():
    try: return (root/"overlap.lease").read_bytes()
    except FileNotFoundError: return None

def launch(*args,env=None):
    p=subprocess.Popen([cli,*map(str,args)],stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE,text=True,start_new_session=True,env=env)
    live.append(p); return p

def finish(p,timeout=20):
    try: out,err=p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as ex:
        killp(p); raise Harness("COMMAND_TIMEOUT") from ex
    return p.returncode,out.strip(),err.strip()

def run(*args): return finish(launch(*args))

def token(rc,out,label):
    if rc!=0 or not (8<=len(out)<=256) or any(c.isspace() for c in out):
        raise Product(f"{label}:NO_TOKEN rc={rc} out={out!r}")
    return out

def killp(p):
    if p.poll() is None:
        try: os.killpg(p.pid,signal.SIGKILL)
        except (ProcessLookupError,PermissionError): pass
    try: p.wait(timeout=5)
    except subprocess.TimeoutExpired: pass

def wait_ready(path,p,timeout,label):
    deadline=time.monotonic()+timeout
    while time.monotonic()<deadline:
        if path.exists(): return True
        if p.poll() is not None:
            rc,out,err=finish(p)
            raise Product(f"{label}_NOT_REACHED rc={rc} out={out!r} err={err[-120:]!r}")
        time.sleep(.01)
    raise Harness(label+"_TIMEOUT")

def barrier_env(tag,with_wait=False):
    ready=base/(tag+".ready"); go=base/(tag+".go")
    env=os.environ.copy(); env["NORTROPIC_TEST_BARRIER_READY"]=str(ready)
    env["NORTROPIC_TEST_BARRIER_GO"]=str(go)
    wait=base/(tag+".wait-ready")
    if with_wait: env["NORTROPIC_TEST_BARRIER_WAIT_READY"]=str(wait)
    return ready,wait,go,env

def first_successor_marker(ready,wait,p,timeout=20):
    deadline=time.monotonic()+timeout
    while time.monotonic()<deadline:
        r,w=ready.exists(),wait.exists()
        if r and w: raise Product("SUCCESSOR_DUPLICATE_INITIAL_MARKERS")
        if r: return "admitted"
        if w: return "serialized-wait"
        if p.poll() is not None:
            rc,out,err=finish(p)
            raise Product(f"SUCCESSOR_MARKER_NOT_REACHED rc={rc} out={out!r} err={err[-120:]!r}")
        time.sleep(.01)
    raise Harness("SUCCESSOR_MARKER_TIMEOUT")

try:
    rc,out,_=run(root,"acquire","overlap","--ttl","0.5")
    old=token(rc,out,"OLD_ACQUIRE"); time.sleep(.75)
    old_bytes=authoritative()
    if not old_bytes: raise Product("OLD_AUTHORITY_BYTES_MISSING")

    old_ready,_,old_go,old_env=barrier_env("old-release")
    stale=launch(root,"release","overlap",old,env=old_env)
    wait_ready(old_ready,stale,20,"OLD_ADMITTED_READY")
    if authoritative()!=old_bytes:
        raise Product("OLD_BARRIER_AFTER_TRANSITION")

    # The successor reports a semantic fact, never its mechanism. Optimistic
    # implementations can admit it beside the paused stale release. A
    # pessimistic serializer reports that it is genuinely queued without
    # having admitted any generation, then must later reach ADMITTED itself.
    new_ready,new_wait,new_go,new_env=barrier_env("successor",with_wait=True)
    successor=launch(root,"acquire","overlap","--ttl","30",
                     "--holder-pid",os.getpid(),env=new_env)
    mode=first_successor_marker(new_ready,new_wait,successor)
    if authoritative()!=old_bytes:
        raise Product("SUCCESSOR_MARKER_AFTER_TRANSITION")

    if mode=="admitted":
        if successor.poll() is not None: raise Product("SUCCESSOR_TRANSITION_BEFORE_GO")
        new_go.touch(); newrc,newout,_=finish(successor)
        new=token(newrc,newout,"OPTIMISTIC_SUCCESSOR")
        successor_bytes=authoritative()
        if not successor_bytes or successor_bytes==old_bytes:
            raise Product("SUCCESSOR_DID_NOT_INSTALL")
        old_go.touch(); finish(stale)
        if authoritative()!=successor_bytes:
            raise Product("STALE_RELEASE_MUTATED_SUCCESSOR")
        mode="optimistic-admitted"
    else:
        if new_ready.exists() or successor.poll() is not None:
            raise Product("SERIALIZED_WAIT_NOT_BLOCKED")
        old_go.touch(); finish(stale)
        post_stale=authoritative()
        wait_ready(new_ready,successor,20,"SUCCESSOR_ADMITTED_READY")
        if authoritative()!=post_stale:
            raise Product("SUCCESSOR_TRANSITION_BEFORE_ADMITTED_GO")
        if successor.poll() is not None:
            raise Product("SERIALIZED_SUCCESSOR_EXITED_BEFORE_GO")
        new_go.touch(); newrc,newout,_=finish(successor)
        new=token(newrc,newout,"PESSIMISTIC_SUCCESSOR")
        mode="pessimistic-serialized-wait"

    if new==old: raise Product("SUCCESSOR_REUSED_GENERATION")
    final_bytes=authoritative()
    orc,owner,_=run(root,"owner","overlap")
    if orc!=0 or not owner or final_bytes==old_bytes:
        raise Product(f"SUCCESSOR_NOT_AUTHORITATIVE owner_rc={orc} owner={owner!r}")
    rrc,_,_=run(root,"release","overlap",new)
    if rrc!=0: raise Product("SUCCESSOR_CLEANUP_FAILED")
    print("OVERLAP_SERIALIZED="+mode)
except Harness as e:
    print("HARNESS:"+str(e)); raise SystemExit(90)
except Product as e:
    print("PRODUCT:"+str(e)); raise SystemExit(20)
finally:
    for p in live: killp(p)
PY

overlap16_out=$("$PY3" "$OVERLAP16" "$CLI" "$WORK/s3-release-overlap" 2>&1); overlap16_rc=$?
if [ "$overlap16_rc" -eq 90 ]; then
  echo "SKIP  K16 harness — $overlap16_out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
elif [ "$overlap16_rc" -eq 0 ] && echo "$overlap16_out" | grep -q 'OVERLAP_SERIALIZED='; then
  ok "K16 admitted stale release serialiseras harmless mot exakt successor"
else
  no "K16 stale release/successor overlap" "rc=$overlap16_rc evidence=[$overlap16_out]"
fi

# K16m — exakt samma overlap-driver måste fälla en långsam check-token-then-
# unlink-mutant. Fem sekunders pre-admission-delay får inte feltolkas som
# pessimistisk serialisering: mutanten rapporterar ADMITTED, installerar
# successor och låter sedan den pausade stale releasen blint radera den.
MUT16="$WORK/unsafe-stale-release-mutant.py"
cat > "$MUT16" <<'PY'
#!/usr/bin/env python3
import os,sys,time
from pathlib import Path

root=Path(sys.argv[1]); root.mkdir(parents=True,exist_ok=True)
verb=sys.argv[2]; task=sys.argv[3]; state=root/(task+".lease")

def barrier():
    ready=os.environ.get("NORTROPIC_TEST_BARRIER_READY")
    go=os.environ.get("NORTROPIC_TEST_BARRIER_GO")
    if not ready or not go: return
    Path(ready).write_text("admitted\n")
    deadline=time.monotonic()+20
    while not Path(go).exists() and time.monotonic()<deadline: time.sleep(.01)
    if not Path(go).exists(): raise SystemExit(90)

if verb=="acquire":
    if state.exists():
        time.sleep(5)
        barrier()
        token="new-mutant-generation"
    else:
        token="old-mutant-generation"
    state.write_text(token)
    print(token)
elif verb=="release":
    supplied=sys.argv[4] if len(sys.argv)>4 else ""
    before=state.read_text() if state.exists() else ""
    if before!=supplied: raise SystemExit(1)
    barrier()
    state.unlink(missing_ok=True)  # defect: no generation recheck
elif verb=="owner":
    if not state.exists(): raise SystemExit(1)
    print(state.read_text())
else:
    raise SystemExit(2)
PY
chmod +x "$MUT16"
mut16_out=$("$PY3" "$OVERLAP16" "$MUT16" "$WORK/s3-release-overlap-mutant" 2>&1); mut16_rc=$?
if [ "$mut16_rc" -eq 20 ] && echo "$mut16_out" | grep -q 'STALE_RELEASE_MUTATED_SUCCESSOR'; then
  ok "K16m samma oracle fäller långsam check-token-then-unlink-mutant"
elif [ "$mut16_rc" -eq 90 ]; then
  echo "SKIP  K16m harness — $mut16_out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
else
  no "K16m overlap-mutant sensitivity" "rc=$mut16_rc evidence=[$mut16_out]"
fi

# K16b — byte-oraklets selftest: radera successor med dess riktiga token och
# fabricera sedan failure. Detta ar inte den admitted-operation-mutant som K16
# sjalv fanger; det belagger att returned failure aldrig maskerar byteforlust.
D16B="$WORK/s3-release-mutant"
mkdir -p "$D16B"
old16b=$("$CLI" "$D16B" acquire overlap-mutant --ttl 0.5 2>/dev/null); old16b_rc=$?
sleep 0.7
new16b=$("$CLI" "$D16B" acquire overlap-mutant --ttl 30 --holder-pid "$$" 2>/dev/null); new16b_rc=$?
mutant16b_caught=0
if [ "$old16b_rc" -eq 0 ] && token_ok "$old16b" \
   && [ "$new16b_rc" -eq 0 ] && token_ok "$new16b"; then
  sha16b_before=$(file_sha "$D16B/overlap-mutant.lease")
  # Prediktion: mutanten rapporterar failure men successor saknas efterat.
  "$CLI" "$D16B" release overlap-mutant "$new16b" >/dev/null 2>&1
  mutant16b_rc=1
  sha16b_after=$(file_sha "$D16B/overlap-mutant.lease")
  if [ "$mutant16b_rc" -ne 0 ] \
     && { [ -z "$sha16b_after" ] || [ "$sha16b_before" != "$sha16b_after" ]; }; then
    mutant16b_caught=1
  fi
fi
if [ "$mutant16b_caught" -eq 1 ]; then
  ok "K16b byte-orakel: fabricerad failure efter successor-delete upptacks"
else
  no "K16b successor-byte-orakel" "positiva generationstokens saknas eller byte-oraklet reagerade inte"
fi


# K17 — expired reclaim har samma exakt-en-vinnare-semantik som fresh acquire.
D17="$WORK/s3-expired-race"
mkdir -p "$D17" "$WORK/r17"
seed17=$("$CLI" "$D17" acquire expired-race --ttl 0.5 2>/dev/null); seed17_rc=$?
sleep 0.7
pids=""
for i in $(seq 1 100); do
  ( tok=$("$CLI" "$D17" acquire expired-race --ttl 30 2>/dev/null) \
      && printf '%s' "$tok" > "$WORK/r17/$i" ) &
  pids="$pids $!"
done
for p in $pids; do wait "$p" 2>/dev/null || true; done
win17=$(ls "$WORK/r17" | wc -l | tr -d ' ')
winner17=""
if [ "$win17" = "1" ]; then winner17=$(cat "$WORK/r17/$(ls "$WORK/r17")"); fi
current17=0; post17=""
if [ "$seed17_rc" -eq 0 ] && token_ok "$seed17" \
   && [ "$win17" = "1" ] && token_ok "$winner17" && [ "$winner17" != "$seed17" ]; then
  sha17_before=$(file_sha "$D17/expired-race.lease")
  "$CLI" "$D17" release expired-race "$seed17" >/dev/null 2>&1; stale17_rc=$?
  sha17_after=$(file_sha "$D17/expired-race.lease")
  "$CLI" "$D17" renew expired-race "$winner17" >/dev/null 2>&1; renew17_rc=$?
  "$CLI" "$D17" release expired-race "$winner17" >/dev/null 2>&1; release17_rc=$?
  post17=$([ "$release17_rc" -eq 0 ] && "$CLI" "$D17" acquire expired-race --ttl 30 2>/dev/null || true)
  if [ "$stale17_rc" -ne 0 ] && [ -n "$sha17_before" ] \
     && [ "$sha17_before" = "$sha17_after" ] && [ "$renew17_rc" -eq 0 ] \
     && [ "$release17_rc" -eq 0 ] && token_ok "$post17" \
     && [ "$post17" != "$seed17" ] && [ "$post17" != "$winner17" ]; then
    current17=1
  fi
fi
if [ "$current17" -eq 1 ]; then
  ok "K17 100 samtidiga expired-reclaims ger exakt en ny generation"
else
  no "K17 expired reclaim race" "seed=$seed17_rc winners=$win17 winner-current=$current17 token=[$winner17]"
fi
if token_ok "$post17"; then "$CLI" "$D17" release expired-race "$post17" >/dev/null 2>&1 || true; fi


