time.sleep(2)
immediate_closed.write_text("closed\n", encoding="utf-8")
time.sleep(25)
opened.write_text("open\n", encoding="utf-8")
time.sleep(9)
closed.write_text("closed\n", encoding="utf-8")
PYDEFAULTTIMER
H004_DEFAULT_TIMER_PID=$!
default_timer_i=0
while [ ! -s "$P14C.default-timer-ready" ] \
  && kill -0 "$H004_DEFAULT_TIMER_PID" 2>/dev/null \
  && [ "$default_timer_i" -lt 100 ]; do
  sleep 0.02
  default_timer_i=$((default_timer_i + 1))
done
if [ ! -s "$P14C.default-timer-ready" ]; then
  kill "$H004_DEFAULT_TIMER_PID" >/dev/null 2>&1 || true
  wait "$H004_DEFAULT_TIMER_PID" >/dev/null 2>&1 || true
  H004_DEFAULT_TIMER_PID=""
