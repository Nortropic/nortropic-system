#!/usr/bin/env bash
# h-004-exit — skiva 4 (exklusiv lease)
# Kontrakt efter S3 owner-remediation:
#   controller/lease/cli [<dir>] acquire <task> --ttl <sek> [--holder-pid <pid>]
#       stdout = unik opaque lease_id
#   controller/lease/cli [<dir>] renew <task> <lease_id>
#   controller/lease/cli [<dir>] release <task> [<lease_id>]
#   controller/lease/cli [<dir>] owner <task> [--json]
# Bare release är legacy för obundna leases. En --holder-pid-bunden lease får
# aldrig kunna raderas utan rätt lease_id.
# Katalogen är valfri och ligger först; utelämnad ger controller/lease/state/.
# Provet kör alltid mot temp_kat så inget tillstånd ärvs mellan körningar.
. "$(dirname "$0")/_lib.sh"
CLI="controller/lease/cli"
krav_komponent "$CLI"

WORK="$(temp_kat)" || { echo "FAIL  harness — temp-katalog kunde inte skapas"; exit 2; }
trap 'rm -rf "$WORK"' EXIT
D="$WORK/state"

# K1: acquire på fri task MÅSTE lyckas. Utan positiv kontroll är varje
# efterföljande "misslyckades" meningslöst — en CLI som alltid failar
# hade passerat K2, K3 och K6.
if "$CLI" "$D" acquire h-pos --ttl 60 >/dev/null 2>&1; then
  ok "K1 acquire på fri task lyckas"
else
  no "K1 positiv kontroll" "acquire misslyckades på en helt fri task"
fi

# K2: 100 samtidiga acquire → exakt 1 lyckas
tmp="$WORK/race"
mkdir -p "$tmp"
for i in $(seq 1 100); do
  ( "$CLI" "$D" acquire h-race --ttl 60 >/dev/null 2>&1 && touch "$tmp/$i" ) &
done
wait
antal=$(ls "$tmp" | wc -l | tr -d ' ')
if [ "$antal" = "1" ]; then
  ok "K2 100 samtidiga starter → exakt 1 ägare"
else
  no "K2 exklusivitet" "$antal av 100 fick lease"
fi

# K3: owner namnger innehavaren, och något annat efter release
o1=$("$CLI" "$D" owner h-pos 2>/dev/null)
"$CLI" "$D" release h-pos >/dev/null 2>&1
o2=$("$CLI" "$D" owner h-pos 2>/dev/null)
if [ -z "$o1" ]; then
  no "K3 owner" "owner gav tomt svar på en hållen lease"
elif [ "$o1" = "$o2" ]; then
  no "K3 owner" "owner oförändrad efter release — rapporterar inte verkligt ägarskap"
else
  ok "K3 owner namnger innehavaren och ändras vid release"
fi

# K4: release frigör på riktigt
if "$CLI" "$D" acquire h-pos --ttl 60 >/dev/null 2>&1; then
  ok "K4 release frigör leasen"
  "$CLI" "$D" release h-pos >/dev/null 2>&1
else
  no "K4 release" "task gick inte att ta efter release — release är no-op eller läcker"
fi

# K5: TALET i --ttl styr, inte en hårdkodad utgång.
# Två leases i SAMMA körning: kort går ut, lång gör det inte.
# Sessionens bevis mot stub: acquire --ttl 99999 kunde tas över efter 3 s.
"$CLI" "$D" acquire h-kort --ttl 1    >/dev/null 2>&1
"$CLI" "$D" acquire h-lang --ttl 3600 >/dev/null 2>&1
sleep 3
kort=1; lang=1
"$CLI" "$D" acquire h-kort --ttl 60 >/dev/null 2>&1 && kort=0
"$CLI" "$D" acquire h-lang --ttl 60 >/dev/null 2>&1 && lang=0
if [ "$kort" -ne 0 ]; then
  no "K5 TTL styr" "lease med --ttl 1 gick inte att ta över efter 3 s"
elif [ "$lang" -eq 0 ]; then
  no "K5 TTL styr" "lease med --ttl 3600 togs över efter 3 s — talet läses aldrig"
else
  ok "K5 talet i --ttl styr utgången, inte en hårdkodad tid"
fi

# K6: kill -9 på ägaren. Leasen får INTE tas över före TTL trots död process,
# och SKA gå att ta över efter. Det är hela skälet till TTL framför processkontroll.
( "$CLI" "$D" acquire h-dod --ttl 4 >/dev/null 2>&1; sleep 30 ) &
bg=$!
sleep 1
kill -9 $bg 2>/dev/null
wait $bg 2>/dev/null
if "$CLI" "$D" owner h-dod >/dev/null 2>&1 && [ -n "$("$CLI" "$D" owner h-dod 2>/dev/null)" ]; then
  if "$CLI" "$D" acquire h-dod --ttl 60 >/dev/null 2>&1; then
    no "K6 kill -9" "lease togs över före TTL bara för att processen dog"
  else
    sleep 5
    if "$CLI" "$D" acquire h-dod --ttl 60 >/dev/null 2>&1; then
      ok "K6 död ägare: reclaim efter TTL, aldrig före"
      "$CLI" "$D" release h-dod >/dev/null 2>&1
    else
      no "K6 kill -9" "lease efter död ägare gick aldrig att reclaima"
    fi
  fi
else
  no "K6 kill -9" "ingen lease registrerad för h-dod — kontrollen mätte ingenting"
fi
# K7: klockskev. Två klockor, båda som absoluta ankare vid beviljandet;
# reclaim kräver att BÅDA är överens om att tiden gått. Den farliga riktningen
# är att den LÄSANDE processens väggklocka hoppar FRAMÅT — då ser leasen
# utgången ut medan innehavaren tror sig äga den, och två processer äger samma
# task. Prövas genom preparerade ankare, aldrig genom att röra systemklockan.
# time.monotonic() har odefinierad nollpunkt PER PROCESS — ett ankare räknat
# i ett fristående python-anrop är inte jämförbart med CLI:ts bas och blir
# lätt negativt, vilket träffar omstartsundantaget i stället för det avsedda
# fallet. Leasen skapas därför av komponenten själv, och endast fälten som
# ska skevas skrivs om.
prep() {  # $1 = task, $2 = vagg_alder_s, $3 = mono_alder_s ("neg" = före omstart)
  rm -f "$D/$1.lease"
  "$CLI" "$D" acquire "$1" --ttl 30 >/dev/null 2>&1
  python3 -c '
import json,sys,time
task,va,ma,d = sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
f = d+"/"+task+".lease"
o = json.load(open(f))
o["beviljad_vagg"] = time.time()-float(va)
o["beviljad_mono"] = -1.0 if ma=="neg" else o["beviljad_mono"]-float(ma)
o["ttl"] = 30.0
json.dump(o, open(f,"w"))' "$1" "$2" "$3" "$D"
}
tar() { "$CLI" "$D" acquire "$1" --ttl 60 >/dev/null 2>&1; }

fel=""
# båda ankarna måste skrivas vid beviljande — mono=0 vore spärren avstängd
"$CLI" "$D" acquire h-ankare --ttl 60 >/dev/null 2>&1
python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
sys.exit(0 if isinstance(d.get("beviljad_mono"),(int,float)) and d["beviljad_mono"]!=0
              and isinstance(d.get("beviljad_vagg"),(int,float)) and d["beviljad_vagg"]>0 else 1)'   "$D/h-ankare.lease" 2>/dev/null || fel="$fel ankare-saknas"

prep h-s1 60 1   ; tar h-s1 && fel="$fel vagghopp-framat-gav-reclaim"
prep h-s2 60 60  ; tar h-s2 || fel="$fel eniga-klockor-gav-ingen-reclaim"
prep h-s3 1  60  ; tar h-s3 && fel="$fel vaggen-ej-utgangen-gav-reclaim"
prep h-s4 60 neg ; tar h-s4 || fel="$fel omstart-med-utgangen-vagg-blockerade"
prep h-s5 1  neg ; tar h-s5 && fel="$fel omstart-med-fardsk-vagg-gav-reclaim"
printf 'inte json' > "$D/h-s6.lease"
                   tar h-s6 && fel="$fel olasbar-lease-gav-reclaim"

if [ -z "$fel" ]; then
  ok "K7 klockskev: reclaim kräver att båda klockorna är överens"
else
  no "K7 klockskev" "misslyckade fall:$fel"
fi

# ========== S3: heartbeat + generationsbindning ===============================
#
# K0–K7 ovan står kvar. K8–K14 mäter S3 på publika effekter:
# tokens, owner-svar, leasefilens byteförändring, konkurrerande acquire,
# attestation och process-/repoeffekt. Provet kräver INTE interna
# heartbeat-fältnamn och skriver aldrig en egen lease-JSON.

PY3="$(command -v python3)"
LOOP="controller/loop/cli"
ATT="controller/attest/cli"
ST="controller/state/cli"

token_ok() {
  "$PY3" - "$1" <<'PYTOK'
import sys

s = sys.argv[1]
ok = (
    8 <= len(s) <= 256
    and "\n" not in s
    and "\r" not in s
    and all(not c.isspace() and ord(c) >= 33 for c in s)
)
raise SystemExit(0 if ok else 1)
PYTOK
}

text_has_pid() {
  "$PY3" - "$1" "$2" <<'PYPID'
import re
import sys

text, pid = sys.argv[1], sys.argv[2]

hit = re.search(
    rf'(?<![0-9]){re.escape(pid)}(?![0-9])',
    text,
)

raise SystemExit(0 if hit else 1)
PYPID
}

file_sha() {
  shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
}

wait_mark_or_exit() {
  mark="$1"
  pid="$2"
  i=0
  while [ "$i" -lt 60 ]; do
    [ -s "$mark" ] && return 0
    kill -0 "$pid" 2>/dev/null || return 1
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

wait_barrier_ready() {
  barrier_dir="$1"
  barrier_pid="$2"
  barrier_i=0
  while [ "$barrier_i" -lt 120 ]; do
    [ -e "$barrier_dir/ready" ] && return 0
    kill -0 "$barrier_pid" 2>/dev/null || return 1
    sleep 0.05
    barrier_i=$((barrier_i + 1))
  done
  return 1
}

wait_process_exit() {
  process_pid="$1"
  process_i=0
  while [ "$process_i" -lt 200 ]; do
    kill -0 "$process_pid" 2>/dev/null || return 0
    sleep 0.05
    process_i=$((process_i + 1))
  done
  return 1
}

release_barrier() {
  : > "$1/continue"
}

owner_json_valid() {
  "$PY3" - "$1" "$2" "$3" <<'PYOWNER'
import json
import sys

try:
    value = json.loads(sys.argv[1])
except Exception:
    raise SystemExit(1)
holder = value.get("holder") if isinstance(value, dict) else None
ok = (
    isinstance(value, dict)
    and value.get("lease_id") == sys.argv[2]
    and isinstance(holder, dict)
    and isinstance(holder.get("host"), str)
    and bool(holder["host"])
    and type(holder.get("pid")) is int
    and holder["pid"] == int(sys.argv[3])
    and isinstance(holder.get("incarnation"), str)
    and bool(holder["incarnation"])
)
raise SystemExit(0 if ok else 1)
PYOWNER
}

owner_json_field() {
  "$PY3" - "$1" "$2" <<'PYFIELD'
import json
import sys

try:
    value = json.loads(sys.argv[1])
    if sys.argv[2] == "incarnation":
        field = value["holder"]["incarnation"]
    else:
        field = value[sys.argv[2]]
except Exception:
    raise SystemExit(1)
if not isinstance(field, str) or not field:
    raise SystemExit(1)
print(field)
PYFIELD
}

replace_incarnation() {
  "$PY3" - "$1" "$2" <<'PYREPLACE'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
old = sys.argv[2]
new = "".join("y" if c == "x" else "x" for c in old)
if not new or new == old:
    raise SystemExit(1)
value = json.loads(path.read_text(encoding="utf-8"))
count = 0

def walk(item):
    global count
    if isinstance(item, dict):
        return {key: walk(child) for key, child in item.items()}
    if isinstance(item, list):
        return [walk(child) for child in item]
    if item == old:
        count += 1
        return new
    return item

changed = walk(value)
if count != 1:
    raise SystemExit(1)
path.write_text(
    json.dumps(changed, ensure_ascii=False, sort_keys=True) + "\n",
    encoding="utf-8",
)
PYREPLACE
}

att_valid() {
  "$ATT" "$1" read "$2" --require-valid >/dev/null 2>&1
}

att_bound() {
  "$ATT" "$1" read "$2" --require-authority "$3" >/dev/null 2>&1
}

att_current() {
  "$ATT" "$1" authority-current "$2" >/dev/null 2>&1
}


# K8 — lyckade acquires ska bära generationens identitet på stdout.
D8="$WORK/s3-generation"
mkdir -p "$D8"

t8a="$("$CLI" "$D8" acquire s3-generation --ttl 1 2>/dev/null)"
r8a=$?

if [ "$r8a" -eq 0 ] && token_ok "$t8a"; then
  sleep 2

  t8b="$("$CLI" "$D8" acquire s3-generation --ttl 60 2>/dev/null)"
  r8b=$?

  if [ "$r8b" -eq 0 ] \
     && token_ok "$t8b" \
     && [ "$t8a" != "$t8b" ]; then
    ok "K8 lease-generation: varje acquire ger en unik lease_id"
  else
    no "K8 lease-generation" \
      "första/andra rc=$r8a/$r8b tokenA=[$t8a] tokenB=[$t8b]"
  fi

  if [ "$r8b" -eq 0 ] && token_ok "$t8b"; then
    "$CLI" "$D8" release s3-generation "$t8b" >/dev/null 2>&1 || true
  else
    "$CLI" "$D8" release s3-generation >/dev/null 2>&1 || true
  fi
else
  no "K8 lease-generation" \
    "acquire gav rc=$r8a token=[$t8a], väntat unik lease_id"
  "$CLI" "$D8" release s3-generation >/dev/null 2>&1 || true
fi


# K9 — gammal token OCH legacy bare release får inte radera en holder-bunden
# efterträdare. Efterträdaren skapas enbart genom publik CLI.
D9="$WORK/s3-fencing"
mkdir -p "$D9"

t9a="$("$CLI" "$D9" acquire s3-fence --ttl 1 2>/dev/null)"
r9a=$?

if [ "$r9a" -eq 0 ] && token_ok "$t9a"; then
  sleep 2

  t9b="$(
    "$CLI" "$D9" acquire s3-fence \
      --ttl 60 \
      --holder-pid "$$" \
      2>/dev/null
  )"
  r9b=$?

  if [ "$r9b" -eq 0 ] && token_ok "$t9b"; then
    owner_before="$("$CLI" "$D9" owner s3-fence 2>/dev/null || true)"

    stale_rc=0
    "$CLI" "$D9" release s3-fence "$t9a" >/dev/null 2>&1 || stale_rc=$?
    owner_after_stale="$("$CLI" "$D9" owner s3-fence 2>/dev/null || true)"

    bare_rc=0
    "$CLI" "$D9" release s3-fence >/dev/null 2>&1 || bare_rc=$?
    owner_after_bare="$("$CLI" "$D9" owner s3-fence 2>/dev/null || true)"

    good_rc=0
    "$CLI" "$D9" release s3-fence "$t9b" >/dev/null 2>&1 || good_rc=$?
    owner_after_good="$("$CLI" "$D9" owner s3-fence 2>/dev/null || true)"

    if [ -n "$owner_before" ] \
       && [ "$stale_rc" -ne 0 ] \
       && [ "$bare_rc" -ne 0 ] \
       && [ -n "$owner_after_stale" ] \
       && [ -n "$owner_after_bare" ] \
       && [ "$good_rc" -eq 0 ] \
       && [ -z "$owner_after_good" ]; then
      ok "K9 fencing: gammal token och bare release kan inte radera bunden efterträdare"
    else
      no "K9 fencing" \
        "owners=[$owner_before]/[$owner_after_stale]/[$owner_after_bare]/[$owner_after_good] rc=$stale_rc/$bare_rc/$good_rc"
    fi
  else
    no "K9 fencing" \
      "holder-bunden efterträdare saknas rc=$r9b token=[$t9b]"
    "$CLI" "$D9" release s3-fence >/dev/null 2>&1 || true
  fi
else
  no "K9 fencing" \
    "första generationen saknar lease_id rc=$r9a token=[$t9a]"
  "$CLI" "$D9" release s3-fence >/dev/null 2>&1 || true
fi


# K10 — fel token ändrar inga bytes. Rätt renew ska flytta TTL-fönstret.
D10="$WORK/s3-renew"
mkdir -p "$D10"

t10="$("$CLI" "$D10" acquire s3-renew --ttl 1.5 2>/dev/null)"
r10=$?

if [ "$r10" -eq 0 ] && token_ok "$t10"; then
  f10="$D10/s3-renew.lease"
  sha10a="$(file_sha "$f10")"

  wrong_rc=0
  "$CLI" "$D10" renew s3-renew "wrong-$t10" >/dev/null 2>&1 || wrong_rc=$?

  sha10wrong="$(file_sha "$f10")"

  sleep 0.9

  good_rc=0
  "$CLI" "$D10" renew s3-renew "$t10" >/dev/null 2>&1 || good_rc=$?

  sleep 0.9

  early="$("$CLI" "$D10" acquire s3-renew --ttl 30 2>/dev/null)"
  early_rc=$?

  sleep 0.8

  late="$("$CLI" "$D10" acquire s3-renew --ttl 30 2>/dev/null)"
  late_rc=$?

  if [ "$wrong_rc" -ne 0 ] \
     && [ -n "$sha10a" ] \
     && [ "$sha10a" = "$sha10wrong" ] \
     && [ "$good_rc" -eq 0 ] \
     && [ "$early_rc" -ne 0 ] \
     && [ "$late_rc" -eq 0 ] \
     && token_ok "$late" \
     && [ "$late" != "$t10" ]; then
    ok "K10 renew: fel token ändrar inga bytes och rätt renew flyttar TTL-fönstret"
  else
    no "K10 renew" \
      "wrong/good/early/late=$wrong_rc/$good_rc/$early_rc/$late_rc sha_same=$([ "$sha10a" = "$sha10wrong" ] && echo ja || echo nej)"
  fi

  if [ "$late_rc" -eq 0 ] && token_ok "$late"; then
    "$CLI" "$D10" release s3-renew "$late" >/dev/null 2>&1 || true
  else
    "$CLI" "$D10" release s3-renew "$t10" >/dev/null 2>&1 || true
  fi
else
  no "K10 renew" \
    "acquire gav rc=$r10 token=[$t10]"
  "$CLI" "$D10" release s3-renew >/dev/null 2>&1 || true
fi


# K11 — samma-host holder som fortfarande lever skyddar efter passerad TTL.
# När samma holder dött och TTL redan passerat ska reclaim bli möjligt.
D11="$WORK/s3-holder"
mkdir -p "$D11"

sleep 6 &
holder11=$!

t11="$(
  "$CLI" "$D11" acquire s3-holder \
    --ttl 1 \
    --holder-pid "$holder11" \
    2>/dev/null
)"
r11=$?

if [ "$r11" -eq 0 ] && token_ok "$t11"; then
  owner11="$("$CLI" "$D11" owner s3-holder 2>/dev/null || true)"

  sleep 1.4

  during="$("$CLI" "$D11" acquire s3-holder --ttl 30 2>/dev/null)"
  during_rc=$?

  kill "$holder11" 2>/dev/null || true
  wait "$holder11" 2>/dev/null || true

  after="$("$CLI" "$D11" acquire s3-holder --ttl 30 2>/dev/null)"
  after_rc=$?

  if text_has_pid "$owner11" "$holder11" \
     && [ "$during_rc" -ne 0 ] \
     && [ "$after_rc" -eq 0 ] \
     && token_ok "$after" \
     && [ "$after" != "$t11" ]; then
    ok "K11 holder-liveness: owner namnger holdern; levande holder kan inte reclaimas efter TTL; död holder kan"
  else
    no "K11 holder-liveness" \
      "owner=[$owner11] holder=$holder11 under/efter-död=$during_rc/$after_rc token=[$after]"
  fi

  if [ "$after_rc" -eq 0 ] && token_ok "$after"; then
    "$CLI" "$D11" release s3-holder "$after" >/dev/null 2>&1 || true
  else
    "$CLI" "$D11" release s3-holder "$t11" >/dev/null 2>&1 || true
  fi
else
  kill "$holder11" 2>/dev/null || true
  wait "$holder11" 2>/dev/null || true

  no "K11 holder-liveness" \
    "holder-bunden acquire saknas rc=$r11 token=[$t11]"

  "$CLI" "$D11" release s3-holder >/dev/null 2>&1 || true
fi


# K12–K14 är riktiga loopintegrationer.
for dep in \
  "$LOOP" \
  "$ATT" \
  "$ST" \
  controller/taskval/cli \
  controller/workspace/cli \
  controller/envelope/cli \
  controller/brytare/cli \
  controller/utforare/cli \
  controller/launch/cli \
  controller/worker/cli \
  controller/policy/cli \
  controller/verify/cli
do
  if [ ! -x "$dep" ]; then
    echo "SKIP  S3 loopintegration — $dep saknas, testet är odömbart"
    echo
    echo "$pass PASS, $fail FAIL, ODÖMBART"
    exit 2
  fi
done

BAS="$(git rev-parse HEAD)"

