deadline_probe_or_od "$default14c_run" "K14c deadline"
if ! trace_valid "$T14C"; then
  echo "SKIP  K14c trace-rigg — malformed/partial trace, ODÖMBART"
  exit 2
fi
default14c=$(python3 -c 'import json,sys
rows=[json.loads(x) for x in open(sys.argv[1]) if x.strip()]
for seq,row in enumerate(rows): row["_seq"]=seq
acq=[r for r in rows if r.get("component")=="lease" and r.get("command")=="acquire" and r.get("phase")=="end" and r.get("rc")==0]
renew_start=[r for r in rows if r.get("component")=="lease" and r.get("command")=="renew" and r.get("phase")=="start"]
renew_end=[r for r in rows if r.get("component")=="lease" and r.get("command")=="renew" and r.get("phase")=="end" and r.get("rc")==0]
success_pids={r["pid"] for r in renew_end}
renew_start=[r for r in renew_start if r["pid"] in success_pids]
launch_start=[r for r in rows if r.get("component")=="launch" and r.get("command")=="run" and r.get("phase")=="start"]
launch_end=[r for r in rows if r.get("component")=="launch" and r.get("command")=="run" and r.get("phase")=="end" and r.get("rc")==0]
claims=[r for r in rows if r.get("component")=="taskval" and r.get("command")=="claim" and r.get("phase")=="end" and r.get("rc")==0]
release_start=[r for r in rows if r.get("component")=="lease" and r.get("command")=="release" and r.get("phase")=="start"]
if len(acq)!=1 or len(launch_start)!=1 or len(launch_end)!=1 or len(release_start)!=1: raise SystemExit("acquire/session/release saknas")
args=acq[0]["args"]
if "--ttl" not in args or float(args[args.index("--ttl")+1]) != 180.0: raise SystemExit("TTL-default är inte 180")
periodic=[r for r in renew_start if launch_start[0]["_seq"] < r["_seq"] < launch_end[0]["_seq"]]
if not periodic: raise SystemExit("periodiskt heartbeat saknas medan workern lever")
periodic.sort(key=lambda r:r["_seq"])
window=[r for r in periodic if r.get("default_heartbeat_window") is True]
if not window: raise SystemExit("heartbeat-default saknar renew i central monotonic 27–36 s-window")
outside=[r for r in periodic if r.get("default_heartbeat_window") is not True]
if len(outside)>1 or any(r.get("default_immediate_window") is not True for r in outside):
    raise SystemExit("default-heartbeat förnyade utanför en valfri immediate guard och 27–36 s-window")
claims.sort(key=lambda r:r["_seq"])
if not claims or claims[-1].get("stdout","").strip(): raise SystemExit("terminalt empty claim saknas")
guards=[r for r in renew_end if claims[-1]["_seq"] < r["_seq"] < release_start[0]["_seq"]]
if not guards: raise SystemExit("post-drain guard saknas")
ends_by_pid={r["pid"]:r for r in [x for x in rows if x.get("component")=="lease" and x.get("command")=="renew" and x.get("phase")=="end"]}
if any(r["pid"] not in ends_by_pid or ends_by_pid[r["pid"]]["_seq"] >= release_start[0]["_seq"] for r in [x for x in rows if x.get("component")=="lease" and x.get("command")=="renew" and x.get("phase")=="start"]): raise SystemExit("heartbeat var inte joined före release")
print(f"ttl=180 periodic-window={len(window)} guards={len(guards)}")' "$T14C" 2>&1); default14c_rc=$?
default14c_valid=1
"$TRACE_REPO/controller/attest/cli.real" "$P14C-att" read authority-one --require-valid >/dev/null 2>&1 && default14c_valid=0
if [ "$default14c_run" -eq 0 ] && [ "$default14c_rc" -eq 0 ] && [ "$default14c_valid" -eq 0 ]; then
  ok "K14c defaults: omitted config ger TTL/heartbeat 180/30 på observerbar run-effekt"
else
  no "K14c defaults" "run/trace/valid=$default14c_run/${default14c:-exit $default14c_rc}/$default14c_valid"
fi

successor_intact() {
  python3 -c 'import json,pathlib,sys
try:
    meta=json.load(open(sys.argv[1]))
    path=pathlib.Path(meta["lease_file"])
    ok=path.is_file() and path.read_bytes().hex()==meta["bytes_hex"] and bool(meta["token"])
except Exception:
    ok=False
raise SystemExit(0 if ok else 1)' "$1"
}

successor_token() {
  python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1]))["token"])
except Exception: print("")' "$1"
}

successor_authority_intact() {
  python3 -c 'import json,subprocess,sys
try:
    meta=json.load(open(sys.argv[1]))
    answer=subprocess.run(
        [sys.argv[2],sys.argv[3],"read",meta["authority_task"],"--authority",meta["token"]],
        capture_output=True,text=True,timeout=10,
    )
    post=json.loads(answer.stdout) if answer.returncode==0 else None
    ok=(isinstance(post,dict) and post.get("task")==meta["authority_task"]
        and post.get("candidate_sha")==meta["authority_sha"])
except Exception:
    ok=False
raise SystemExit(0 if ok else 1)' "$1" "$TRACE_REPO/controller/attest/cli.real" "$2"
}

k23_guard_observed() {
  python3 -c 'import json,pathlib,sys
rows=[json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines() if line.strip()]
for seq,row in enumerate(rows): row["_seq"]=seq
acq=[r for r in rows if r.get("component")=="lease" and r.get("command")=="acquire" and r.get("phase")=="end" and r.get("rc")==0]
injected=[r for r in rows if r.get("phase")=="injected_successor"]
if len(acq)!=1 or len(injected)!=1: raise SystemExit(1)
token=acq[0].get("stdout","").strip()
lease_args=acq[0].get("args",[])
if len(lease_args)<3: raise SystemExit(1)
lease_dir,resource=lease_args[0],lease_args[2]
claims=[r for r in rows if r.get("component")=="taskval" and r.get("command")=="claim" and r.get("phase")=="end"]
if len(claims)!=2 or any(r.get("rc")!=0 for r in claims): raise SystemExit(1)
claims.sort(key=lambda r:r["_seq"])
if [r.get("stdout","").strip() for r in claims] != ["authority-one",""]: raise SystemExit(1)
if any(r.get("args",[])[-2:] != ["--authority",token] for r in claims): raise SystemExit(1)
empty=claims[-1]
if not injected[0]["_seq"] < empty["_seq"]: raise SystemExit(1)
if injected[0].get("before_heartbeat_deadline") is not True: raise SystemExit(2)
starts=[r for r in rows if r.get("component")=="lease" and r.get("command")=="renew" and r.get("phase")=="start" and r.get("args",[])==[lease_dir,"renew",resource,token] and r["_seq"]>empty["_seq"] and r.get("before_heartbeat_deadline") is True]
ends={r["pid"]:r for r in rows if r.get("component")=="lease" and r.get("command")=="renew" and r.get("phase")=="end"}
guards=[(s,ends.get(s["pid"])) for s in starts]
guards=[(s,e) for s,e in guards if e is not None and e.get("rc")!=0 and e["_seq"]>s["_seq"]]
if not guards: raise SystemExit(1)
release=[r for r in rows if r.get("component")=="lease" and r.get("command")=="release" and r.get("phase")=="start"]
if release and min(r["_seq"] for r in release) < min(e["_seq"] for _,e in guards): raise SystemExit(1)
' "$1"
}

k24_crash_ordered() {
  python3 -c 'import json,pathlib,sys
rows=[json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines() if line.strip()]
for seq,row in enumerate(rows): row["_seq"]=seq
acq=[r for r in rows if r.get("component")=="lease" and r.get("command")=="acquire" and r.get("phase")=="end" and r.get("rc")==0]
if len(acq)!=1: raise SystemExit(1)
token=acq[0].get("stdout","").strip()
release=[r for r in rows if r.get("component")=="lease" and r.get("command")=="release" and r.get("phase")=="end" and r.get("rc")==0 and r.get("args",[])[-1:]==[token]]
finalize=[r for r in rows if r.get("component")=="attest" and r.get("command")=="finalize-authority" and r.get("phase")=="start" and r.get("args",[])[-1:]==[token]]
crash=[r for r in rows if r.get("component")=="attest" and r.get("command")=="finalize-authority" and r.get("phase")=="crash_before_finalize"]
if len(release)!=1 or len(finalize)!=1 or len(crash)!=1: raise SystemExit(1)
if not release[0]["_seq"] < finalize[0]["_seq"] < crash[0]["_seq"]: raise SystemExit(1)
if not isinstance(crash[0].get("run_pid"),int): raise SystemExit(1)
' "$1"
}

# K13b — lease loss installeras omedelbart efter det lyckade task-resultatets
# publication-anrop. Trace-domaren kräver exact authority-bunden PROVISIONAL
# write och förbjuder legacy-valid write, INVALIDATE-rollback, release och
# finalize; successor lease + authority måste överleva exakt.
run_variant "$WORK/k13-trace-loss" replace_after_write "$WORK/h004-one.json" h004-midrun-loss
k13b_phase=1
one_phase_ok "$V_TRACE" replace_after_write && k13b_phase=0
k13b_valid=0
"$TRACE_REPO/controller/attest/cli.real" "$V_PREFIX-att" read authority-one --require-valid >/dev/null 2>&1 || k13b_valid=$?
k13b_successor=1
successor_intact "$V_SUCCESSOR" && k13b_successor=0
k13b_preanchor=1
successor_authority_intact "$V_SUCCESSOR" "$V_PREFIX-att" && k13b_preanchor=0
k13b_owner=1
"$TRACE_REPO/controller/lease/cli.real" "$V_PREFIX-lease" owner h004-midrun-loss >/dev/null 2>&1 && k13b_owner=0
if [ "$V_RC" -eq 1 ] && [ "${V_WORKERS:-0}" = "1" ] \
   && [ "$V_FINALIZE_START" = "0" ] && [ "$k13b_valid" -ne 0 ] \
   && [ "$k13b_successor" -eq 0 ] && [ "$k13b_preanchor" -eq 0 ] \
   && [ "$k13b_owner" -eq 0 ] && [ "$k13b_phase" -eq 0 ]; then
  ok "K13b mid-run lease-loss: provisional-only path utan valid→invalidate och successor överlever"
else
  no "K13b mid-run lease-loss" "run/workers/finalize/valid/successor/preanchor/owner/phase=$V_RC/${V_WORKERS:-x}/$V_FINALIZE_START/$k13b_valid/$k13b_successor/$k13b_preanchor/$k13b_owner/$k13b_phase"
fi
k13b_token=$(successor_token "$V_SUCCESSOR")
if [ -n "$k13b_token" ]; then
  "$TRACE_REPO/controller/lease/cli.real" "$V_PREFIX-lease" release h004-midrun-loss "$k13b_token" >/dev/null 2>&1 || true
  "$TRACE_REPO/controller/attest/cli.real" "$V_PREFIX-att" finalize-authority "$k13b_token" >/dev/null 2>&1 || true
fi

# K23 — deterministic final-guard barrier: när sista taskval-claim svarar tomt
# ersätter harnessen lease + begins successor innan loopen får fortsätta.
run_variant "$WORK/k23-final-guard" replace_final_guard "$WORK/h004-one.json" h004-final-guard
k23_phase=1
one_phase_ok "$V_TRACE" replace_final_guard && k23_phase=0
k23_valid=0
"$TRACE_REPO/controller/attest/cli.real" "$V_PREFIX-att" read authority-one --require-valid >/dev/null 2>&1 || k23_valid=$?
k23_successor=1
successor_intact "$V_SUCCESSOR" && k23_successor=0
k23_owner=1
"$TRACE_REPO/controller/lease/cli.real" "$V_PREFIX-lease" owner h004-final-guard >/dev/null 2>&1 && k23_owner=0
k23_guard=1
k23_guard_observed "$V_TRACE"; k23_guard_rc=$?
if [ "$k23_guard_rc" -eq 2 ]; then
  echo "SKIP  K23 guard-timer — terminal claim nådde central deadline, ODÖMBART"
  exit 2
elif [ "$k23_guard_rc" -eq 0 ]; then
  k23_guard=0
fi
k23_token=$(successor_token "$V_SUCCESSOR")
k23_preanchor=1
successor_authority_intact "$V_SUCCESSOR" "$V_PREFIX-att" && k23_preanchor=0
k23_authority=1
if [ -n "$k23_token" ] \
   && "$TRACE_REPO/controller/attest/cli.real" "$V_PREFIX-att" write successor-k23 "$(sha_for 4230)" --authority "$k23_token" >/dev/null 2>&1 \
   && "$TRACE_REPO/controller/attest/cli.real" "$V_PREFIX-att" read successor-k23 --authority "$k23_token" >/dev/null 2>&1; then
  k23_authority=0
fi
if [ "$V_RC" -eq 1 ] && [ "${V_WORKERS:-0}" = "1" ] \
   && [ "$V_FINALIZE_START" = "0" ] && [ "$k23_valid" -ne 0 ] \
   && [ "$k23_successor" -eq 0 ] && [ "$k23_owner" -eq 0 ] \
   && [ "$k23_guard" -eq 0 ] && [ "$k23_preanchor" -eq 0 ] \
   && [ "$k23_authority" -eq 0 ] && [ "$k23_phase" -eq 0 ]; then
  ok "K23 final lease-loss guard: ingen finalize och successor lease/authority överlever"
else
  no "K23 final lease-loss guard" "run/workers/finalize/valid/successor/owner/guard/preanchor/authority/phase=$V_RC/${V_WORKERS:-x}/$V_FINALIZE_START/$k23_valid/$k23_successor/$k23_owner/$k23_guard/$k23_preanchor/$k23_authority/$k23_phase"
fi
if [ -n "$k23_token" ]; then
  "$TRACE_REPO/controller/lease/cli.real" "$V_PREFIX-lease" release h004-final-guard "$k23_token" >/dev/null 2>&1 || true
  "$TRACE_REPO/controller/attest/cli.real" "$V_PREFIX-att" finalize-authority "$k23_token" >/dev/null 2>&1 || true
fi

# K24 — release har svarat success, men wrappern dödar runprocessen precis när
# finalize anropas och före mutation. Batchen måste förbli provisional/invalid.
run_variant "$WORK/k24-crash" crash_finalize "$WORK/h004-one.json" h004-crash
k24_phase=1
one_phase_ok "$V_TRACE" crash_finalize && k24_phase=0
k24_valid=0
"$TRACE_REPO/controller/attest/cli.real" "$V_PREFIX-att" read authority-one --require-valid >/dev/null 2>&1 || k24_valid=$?
k24_bound=1
[ -n "$V_TOKEN" ] && "$TRACE_REPO/controller/attest/cli.real" "$V_PREFIX-att" read authority-one --authority "$V_TOKEN" >/dev/null 2>&1 && k24_bound=0
k24_owner=0
"$TRACE_REPO/controller/lease/cli.real" "$V_PREFIX-lease" owner h004-crash >/dev/null 2>&1 || k24_owner=$?
k24_order=1
k24_crash_ordered "$V_TRACE" && k24_order=0
if [ "$V_RC" -eq 247 ] && [ "${V_WORKERS:-0}" = "1" ] \
   && [ "$V_CRASH_MARK" = "1" ] && [ "$k24_order" -eq 0 ] \
   && [ "$V_FINALIZE_START" = "1" ] && [ "$k24_valid" -ne 0 ] \
   && [ "$k24_bound" -eq 0 ] && [ "$k24_owner" -ne 0 ] \
   && [ "$k24_phase" -eq 0 ]; then
  ok "K24 pre-publication crash: clean release följd av död före finalize-mutation lämnar noll valid batch"
else
  no "K24 pre-publication crash" "run/crash-marker/order/workers/finalize/valid/bound/owner/phase=$V_RC/$V_CRASH_MARK/$k24_order/${V_WORKERS:-x}/$V_FINALIZE_START/$k24_valid/$k24_bound/$k24_owner/$k24_phase"
fi

# K25 — successor acquire+BEGIN installeras EFTER lyckad old release men FÖRE
# att release-wrappern återvänder. Old finalize ska då falla; äldre finalized
# och legacy anchors ska däremot stå kvar (BEGIN är aldrig global wipe).
P25="$WORK/k25-successor"
mkdir -p "$P25-att"
"$TRACE_REPO/controller/attest/cli.real" "$P25-att" write legacy-k25 "$(sha_for 4250)" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$P25-att" begin-authority prior-k25 >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$P25-att" write finalized-k25 "$(sha_for 4251)" --authority prior-k25 >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$P25-att" finalize-authority prior-k25 >/dev/null 2>&1
run_variant "$P25" successor_after_release "$WORK/h004-one.json" h004-successor-window
k25_phase=1
one_phase_ok "$V_TRACE" successor_after_release && k25_phase=0
k25_batch=0; k25_legacy=1; k25_final=1
"$TRACE_REPO/controller/attest/cli.real" "$P25-att" read authority-one --require-valid >/dev/null 2>&1 || k25_batch=$?
post_exact_cli "$TRACE_REPO/controller/attest/cli.real" "$P25-att" legacy-k25 "$(sha_for 4250)" && k25_legacy=0
post_exact_cli "$TRACE_REPO/controller/attest/cli.real" "$P25-att" finalized-k25 "$(sha_for 4251)" && k25_final=0
k25_successor=1
successor_intact "$V_SUCCESSOR" && k25_successor=0
k25_token=$(successor_token "$V_SUCCESSOR")
k25_preanchor=1
successor_authority_intact "$V_SUCCESSOR" "$P25-att" && k25_preanchor=0
k25_authority=1
if [ -n "$k25_token" ] \
   && "$TRACE_REPO/controller/attest/cli.real" "$P25-att" write successor-k25 "$(sha_for 4252)" --authority "$k25_token" >/dev/null 2>&1 \
   && "$TRACE_REPO/controller/attest/cli.real" "$P25-att" read successor-k25 --authority "$k25_token" >/dev/null 2>&1; then
  k25_authority=0
fi
if [ "$V_RC" -eq 1 ] && [ "${V_WORKERS:-0}" = "1" ] \
   && [ "$V_FINALIZE_START" = "1" ] && [ "$k25_batch" -ne 0 ] \
   && [ "$k25_legacy" -eq 0 ] && [ "$k25_final" -eq 0 ] \
   && [ "$k25_successor" -eq 0 ] && [ "$k25_preanchor" -eq 0 ] \
   && [ "$k25_authority" -eq 0 ] && [ "$k25_phase" -eq 0 ]; then
  ok "K25 successor window: new authority fencar old batch utan global wipe"
else
  no "K25 successor window" "run/workers/finalize/batch/anchors/successor/preanchor/authority/phase=$V_RC/${V_WORKERS:-x}/$V_FINALIZE_START/$k25_batch/$k25_legacy,$k25_final/$k25_successor/$k25_preanchor/$k25_authority/$k25_phase"
fi
if [ -n "$k25_token" ]; then
  "$TRACE_REPO/controller/lease/cli.real" "$P25-lease" release h004-successor-window "$k25_token" >/dev/null 2>&1 || true
  "$TRACE_REPO/controller/attest/cli.real" "$P25-att" finalize-authority "$k25_token" >/dev/null 2>&1 || true
fi

cat > "$WORK/h004-empty-trace.py" <<'PYEMPTY'
import json
import pathlib
import sys

rows = [json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines() if line.strip()]
for seq,row in enumerate(rows): row["_seq"]=seq
def choose(component, command, phase, rc=None):
    found=[r for r in rows if r.get("component")==component and r.get("command")==command and r.get("phase")==phase]
    return [r for r in found if rc is None or r.get("rc")==rc]
acq=choose("lease","acquire","end",0)
if len(acq)!=1 or not acq[0].get("stdout","").strip(): raise SystemExit("acquire")
token=acq[0]["stdout"].strip()
begin=choose("attest","begin-authority","end",0)
begin_start=choose("attest","begin-authority","start")
claim_start=choose("taskval","claim","start")
claim=choose("taskval","claim","end",0)
release=choose("lease","release","end",0)
release_starts=choose("lease","release","start")
release_ends=choose("lease","release","end")
finalize_start=choose("attest","finalize-authority","start")
finalize=choose("attest","finalize-authority","end",0)
if (len(begin_start)!=1 or len(begin)!=1 or begin[0]["args"][-1]!=token
        or not acq[0]["_seq"] < begin_start[0]["_seq"] < begin[0]["_seq"]): raise SystemExit("begin")
if len(claim_start)!=1 or len(claim)!=1 or claim[0]["args"][-2:] != ["--authority",token] or claim[0].get("stdout","").strip(): raise SystemExit("claim")
acq_args=acq[0].get("args",[])
if len(acq_args)<3: raise SystemExit("acquire-args")
expected_release=[acq_args[0],"release",acq_args[2],token]
if (len(release_starts)!=1 or len(release_ends)!=1 or len(release)!=1
        or release_starts[0].get("args",[])!=expected_release
        or release[0].get("args",[])!=expected_release): raise SystemExit("release")
if len(finalize_start)!=1 or len(finalize)!=1 or finalize[0]["args"][-1]!=token: raise SystemExit("finalize")
if not (begin[0]["_seq"] < claim_start[0]["_seq"] < claim[0]["_seq"] < release[0]["_seq"] < finalize_start[0]["_seq"] < finalize[0]["_seq"]): raise SystemExit("order")
release_start=release_starts[0]["_seq"]
renews=choose("lease","renew","end",0)
if not any(claim[0]["_seq"] < r["_seq"] < release_start for r in renews): raise SystemExit("guard")
renew_starts=choose("lease","renew","start")
renew_ends=choose("lease","renew","end")
ends_by_pid={r["pid"]:r for r in renew_ends}
if any(r["pid"] not in ends_by_pid or ends_by_pid[r["pid"]]["_seq"] >= release_start for r in renew_starts): raise SystemExit("heartbeat-not-joined")
if choose("workspace","create","start") or choose("launch","run","start"): raise SystemExit("empty-run-session-effect")
if choose("attest","write","start") or choose("attest","invalidate","start"): raise SystemExit("empty-run-unexpected-attest-mutation")
print(token)
PYEMPTY

# K26 — en tom run-generation går igenom samma enda finalize och rör inga
# tidigare giltiga resultat, event eller workers.
P26="$WORK/k26-empty"
mkdir -p "$P26-att"
"$TRACE_REPO/controller/attest/cli.real" "$P26-att" write legacy-k26 "$(sha_for 4260)" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$P26-att" begin-authority prior-k26 >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$P26-att" write finalized-k26 "$(sha_for 4261)" --authority prior-k26 >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$P26-att" finalize-authority prior-k26 >/dev/null 2>&1
run_variant "$P26" release_delay "$WORK/h004-empty.json" h004-empty
empty26=$(python3 "$WORK/h004-empty-trace.py" "$V_TRACE" 2>&1); empty26_rc=$?
k26_anchor=1; k26_final_anchor=1
post_exact_cli "$TRACE_REPO/controller/attest/cli.real" "$P26-att" legacy-k26 "$(sha_for 4260)" && k26_anchor=0
post_exact_cli "$TRACE_REPO/controller/attest/cli.real" "$P26-att" finalized-k26 "$(sha_for 4261)" && k26_final_anchor=0
if [ "$V_RC" -eq 0 ] && [ "$empty26_rc" -eq 0 ] \
   && [ "${V_EVENTS:-x}" = "0" ] && [ "${V_WORKERS:-0}" = "0" ] \
   && [ "$k26_anchor" -eq 0 ] && [ "$k26_final_anchor" -eq 0 ]; then
  ok "K26 empty run: begin → guard/join → release → en tom finalize, äldre validitet bevaras"
else
  no "K26 empty run" "run/trace/events/workers/anchors=$V_RC/${empty26:-exit $empty26_rc}/${V_EVENTS:-x}/${V_WORKERS:-x}/$k26_anchor,$k26_final_anchor"
fi

