cat > "$WORK/h004-trace-check.py" <<'PYTRACECHECK'
import json
import pathlib
import sys

events = [json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines() if line.strip()]
expected_holder_pid = pathlib.Path(sys.argv[2]).read_text(encoding="utf-8").strip()
if not expected_holder_pid.isdecimal():
    raise SystemExit("actual run PID saknas")
for sequence, event in enumerate(events):
    event["_seq"] = sequence

def selected(component, command, phase=None, rc=None):
    rows = [e for e in events if e["component"] == component and e["command"] == command]
    if phase is not None:
        rows = [e for e in rows if e["phase"] == phase]
    if rc is not None:
        rows = [e for e in rows if e.get("rc") == rc]
    return rows

acquires = selected("lease", "acquire", "end", 0)
if len(acquires) != 1 or not acquires[0].get("stdout", "").strip():
    raise SystemExit("acquire-token saknas/är inte unik")
token = acquires[0]["stdout"].strip()
acquire_starts = selected("lease", "acquire", "start")
if not acquire_starts:
    raise SystemExit("acquire-start saknas")
for event in acquire_starts:
    args = event.get("args", [])
    if (
        args.count("--holder-pid") != 1
        or args[args.index("--holder-pid") + 1] != expected_holder_pid
        or "--incarnation-oracle" in args
    ):
        raise SystemExit("något loop-acquire saknar actual run PID eller skickar test-oracle")
acquire_args = acquires[0].get("args", [])
if (
    acquire_args.count("--holder-pid") != 1
    or acquire_args[acquire_args.index("--holder-pid") + 1] != expected_holder_pid
    or "--incarnation-oracle" in acquire_args
):
    raise SystemExit("loop acquire är inte bundet till actual run PID eller skickar test-oracle")

begins = selected("attest", "begin-authority", "end", 0)
begin_starts = selected("attest", "begin-authority", "start")
if (len(begin_starts) != 1 or len(begins) != 1
        or begins[0]["args"][-1] != token
        or not acquires[0]["_seq"] < begin_starts[0]["_seq"] < begins[0]["_seq"]):
    raise SystemExit("begin-authority använder inte exakt acquired lease_id")
begin_done = begins[0]["_seq"]
claim_starts = selected("taskval", "claim", "start")
state_appends = selected("state", "append", "start")
workspace_starts = selected("workspace", "create", "start")
session_starts = selected("launch", "run", "start")
for name, rows in (
    ("taskval claim", claim_starts),
    ("claim-event", state_appends),
    ("workspace create", workspace_starts),
    ("session launch", session_starts),
):
    if not rows or begin_done >= min(e["_seq"] for e in rows):
        raise SystemExit(f"BEGIN skedde inte före första {name}")

writes = selected("attest", "write", "end", 0)
if len(writes) != 2 or sorted(
    e.get("args", [None, None, None])[2] if len(e.get("args", [])) > 2 else None
    for e in writes
) != ["authority-a", "authority-b"]:
    raise SystemExit("successful write-set ska vara exakt {authority-a, authority-b}")
for event in writes:
    args = event["args"]
    if "--authority" not in args or args[args.index("--authority") + 1] != token:
        raise SystemExit("task-write saknar exakt run-authority")

claims = selected("taskval", "claim", "end", 0)
claims.sort(key=lambda event: event["_seq"])
if len(claims) != 3 or [e.get("stdout", "").strip() for e in claims] != [
    "authority-a", "authority-b", ""
]:
    raise SystemExit("drain ska vara exakt claim A, claim B, terminalt tomt claim")
for event in claims:
    args = event["args"]
    if len(args) < 6 or args[-2:] != ["--authority", token]:
        raise SystemExit("taskval claim saknar exakt run-authority")

releases = selected("lease", "release", "end", 0)
finalizes = selected("attest", "finalize-authority", "end", 0)
if len(releases) != 1 or releases[0]["args"][-1] != token:
    raise SystemExit("clean token-bound release saknas")
if len(finalizes) != 1 or finalizes[0]["args"][-1] != token:
    raise SystemExit("exakt en finalize med lease_id saknas")
finalize_starts = selected("attest", "finalize-authority", "start")
if len(finalize_starts) != 1 or releases[0]["_seq"] >= finalize_starts[0]["_seq"]:
    raise SystemExit("finalize startade före clean release returnerade success")

empty_claim = max(claims, key=lambda e: e["_seq"])
release_starts = selected("lease", "release", "start")
renew_ends = selected("lease", "renew", "end", 0)
if len(release_starts) != 1:
    raise SystemExit("release-start saknas")
if not any(empty_claim["_seq"] < e["_seq"] < release_starts[0]["_seq"] for e in renew_ends):
    raise SystemExit("sista lease-guard saknas mellan drain och release")
renew_starts = selected("lease", "renew", "start")
all_renew_ends = selected("lease", "renew", "end")
ends_by_pid = {e["pid"]: e for e in all_renew_ends}
for start in renew_starts:
    end = ends_by_pid.get(start["pid"])
    if end is None or end["_seq"] >= release_starts[0]["_seq"]:
        raise SystemExit("heartbeat var inte fullständigt stop/joinat före release")
for event in renew_starts + release_starts:
    if "--test-mutation-barrier-fds" in event.get("args", []):
        raise SystemExit("normal loop skickade disposable mutation-barrier")

print(token)
PYTRACECHECK

# K18/K19/K21 — solskensrun med två beroende tasks. B hålls i workern så A:s
# publication kan observeras som same-authority PROVISIONAL före release.
P18="$WORK/k18-positive"
T18="$P18.trace"
authority_config "$P18.json" "$WORK/h004-two.json" "$P18" "h004-positive"
mkdir -p "$P18-ws"
if [ "$trace_repo_ok" -eq 1 ]; then
  "$TRACE_REPO/controller/state/cli.real" init "$P18-state" >/dev/null 2>&1
fi
: > "$T18"
rm -f "$WORK/k18-b-started" "$WORK/k18-b-continue" "$WORK/k18-worker-count"

if [ "$trace_repo_ok" -eq 1 ]; then
  (
    cd "$TRACE_REPO" || exit 1
    H004_TRACE="$T18" \
    H004_MODE=release_delay \
    H004_HARNESS_PID="$$" \
    H004_WORKER_COUNT="$WORK/k18-worker-count" \
    H004_B_MARK="$WORK/k18-b-started" \
    H004_B_CONTINUE="$WORK/k18-b-continue" \
    H004_DEADLINE_CHILD_PID_FILE="$P18.loop-pid" \
    "$PY3" "$WORK/h004-deadline.py" 60 ./controller/loop/cli run "$P18.json"
  ) >"$P18.out" 2>"$P18.err" &
  loop18=$!
  started18=0
  i18=0
  while [ "$i18" -lt 200 ]; do
    if [ -s "$WORK/k18-b-started" ]; then started18=1; break; fi
    kill -0 "$loop18" 2>/dev/null || break
    sleep 0.1
    i18=$((i18 + 1))
  done
else
  loop18=""
  started18=0
fi

token18=""
if [ "$started18" -eq 1 ]; then
  token18=$(python3 -c 'import json,sys
rows=[json.loads(x) for x in open(sys.argv[1]) if x.strip()]
hits=[r for r in rows if r.get("component")=="lease" and r.get("command")=="acquire" and r.get("phase")=="end" and r.get("rc")==0]
print(hits[-1].get("stdout","").strip() if hits else "")' "$T18" 2>/dev/null)
fi

bound18=1; global18=0
if [ -n "$token18" ]; then
  H004_TRACE="$T18" H004_MODE=normal \
    "$TRACE_REPO/controller/attest/cli" "$P18-att" read authority-a --authority "$token18" \
    >/dev/null 2>&1 && bound18=0
  H004_TRACE="$T18" H004_MODE=normal \
    "$TRACE_REPO/controller/attest/cli" "$P18-att" read authority-a --require-valid \
    >/dev/null 2>&1 || global18=$?
fi

touch "$WORK/k18-b-continue"
if [ -n "$loop18" ]; then
  wait "$loop18"; loop18_rc=$?
else
  loop18_rc=99
fi
deadline_probe_or_od "$loop18_rc" "K18 deadline"
if ! trace_valid "$T18"; then
  echo "SKIP  K18 trace-rigg — malformed/partial trace, ODÖMBART"
  exit 2
fi

trace18=""
trace18_rc=1
if [ "$trace_repo_ok" -eq 1 ]; then
  trace18=$(python3 "$WORK/h004-trace-check.py" "$T18" "$P18.loop-pid" 2>&1); trace18_rc=$?
fi
valid18a=1; valid18b=1
"$TRACE_REPO/controller/attest/cli.real" "$P18-att" read authority-a --require-valid >/dev/null 2>&1 && valid18a=0
"$TRACE_REPO/controller/attest/cli.real" "$P18-att" read authority-b --require-valid >/dev/null 2>&1 && valid18b=0

if [ "$started18" -eq 1 ] && [ "$trace18_rc" -eq 0 ]; then
  ok "K18 lease→authority: exact lease_id BEGIN sker före claim/event/session"
else
  no "K18 lease→authority" "started=$started18 trace=${trace18:-trace-check exit $trace18_rc}"
fi
if [ "$bound18" -eq 0 ] && [ "$global18" -ne 0 ] \
   && grep -qx 'authority-a' "$WORK/k18-worker-count" 2>/dev/null \
   && grep -qx 'authority-b' "$WORK/k18-worker-count" 2>/dev/null \
   && [ "$(wc -l < "$WORK/k18-worker-count" | tr -d ' ')" = "2" ]; then
  ok "K19 in-run dependency: A är provisional-globalt spärrad men gör B behörig under samma id"
else
  no "K19 in-run dependency" "bound/global=$bound18/$global18 workers=$(tr '\n' ',' < "$WORK/k18-worker-count" 2>/dev/null || true)"
fi
if [ "$loop18_rc" -eq 0 ] && [ "$trace18_rc" -eq 0 ] \
   && [ "$valid18a" -eq 0 ] && [ "$valid18b" -eq 0 ]; then
  ok "K21 clean finalize: final guard → joined heartbeat → release → exakt en atomic finalize"
else
  no "K21 clean finalize" "loop/trace/valid-a/valid-b=$loop18_rc/$trace18_rc/$valid18a/$valid18b"
fi

# K20 — taskval-authority är UNION(global valid, same-current provisional).
# Legacy utan flagga står byte-/effektbakåtkompatibelt; wrong/stale explicit id
# får aldrig ge claim eller event (exit 0 tomt eller fail-closed 1 tolereras).
rc_zero_or_one() {
  [ "$1" -eq 0 ] || [ "$1" -eq 1 ]
}

cat > "$WORK/h004-selector.json" <<'JSON'
{
  "spec_version": "h004-selector",
  "tasks": [
    {
      "id": "selector-target", "slice": 0, "title": "selector", "summary": "selector",
      "allowed_write": [], "exit_test": "verify/bin/ingen", "exit_criterion": "-",
      "docs_impact": [], "depends_on": ["legacy-dep", "finalized-dep", "provisional-dep"]
    }
  ]
}
JSON

D20="$WORK/k20-att"
S20="$WORK/k20-state"
A20="selector-A20"
"$TRACE_REPO/controller/state/cli.real" init "$S20" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20" write legacy-dep "$(sha_for 4200)" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20" begin-authority selector-prior-P20 >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20" write finalized-dep "$(sha_for 4202)" --authority selector-prior-P20 >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20" finalize-authority selector-prior-P20 >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20" begin-authority "$A20" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20" write provisional-dep "$(sha_for 4201)" --authority "$A20" >/dev/null 2>&1

right20=$("$TRACE_REPO/controller/taskval/cli.real" select "$WORK/h004-selector.json" "$D20" "$S20" --authority "$A20" 2>/dev/null); right20_rc=$?
legacy20=$("$TRACE_REPO/controller/taskval/cli.real" select "$WORK/h004-selector.json" "$D20" "$S20" 2>/dev/null); legacy20_rc=$?
wrong20=$("$TRACE_REPO/controller/taskval/cli.real" select "$WORK/h004-selector.json" "$D20" "$S20" --authority "selector-wrong" 2>/dev/null); wrong20_rc=$?
"$TRACE_REPO/controller/attest/cli.real" "$D20" finalize-authority "$A20" >/dev/null 2>&1
legacy_after20=$("$TRACE_REPO/controller/taskval/cli.real" select "$WORK/h004-selector.json" "$D20" "$S20" 2>/dev/null); legacy_after20_rc=$?

D20S="$WORK/k20-stale-att"
S20S="$WORK/k20-stale-state"
A20S="selector-stale-A"; B20S="selector-current-B"
"$TRACE_REPO/controller/state/cli.real" init "$S20S" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20S" write legacy-dep "$(sha_for 4210)" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20S" begin-authority selector-prior-P20S >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20S" write finalized-dep "$(sha_for 4212)" --authority selector-prior-P20S >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20S" finalize-authority selector-prior-P20S >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20S" begin-authority "$A20S" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20S" write provisional-dep "$(sha_for 4211)" --authority "$A20S" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$D20S" begin-authority "$B20S" >/dev/null 2>&1
stale20=$("$TRACE_REPO/controller/taskval/cli.real" claim "$WORK/h004-selector.json" "$D20S" "$S20S" --authority "$A20S" 2>/dev/null); stale20_rc=$?
events20=$(wc -l < "$S20S/events.jsonl" 2>/dev/null | tr -d ' ')

# Separat anti-fallback-ankare: samtliga dependencies är globalt giltiga.
# Legacy/no-flag SKA då välja/claima, medan wrong/stale explicit authority
# måste vägra eller ge tomt — en implementation som ignorerar flaggan fälls.
cat > "$WORK/h004-selector-fallback.json" <<'JSON'
{
  "spec_version": "h004-selector-fallback",
  "tasks": [
    {
      "id": "fallback-target", "slice": 0, "title": "fallback", "summary": "fallback",
      "allowed_write": [], "exit_test": "verify/bin/ingen", "exit_criterion": "-",
      "docs_impact": [], "depends_on": ["fallback-dep"]
    }
  ]
}
JSON
DF20="$WORK/k20-fallback-att"
"$TRACE_REPO/controller/attest/cli.real" "$DF20" write fallback-dep "$(sha_for 4220)" >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$DF20" begin-authority fallback-old-A >/dev/null 2>&1
"$TRACE_REPO/controller/attest/cli.real" "$DF20" begin-authority fallback-current-B >/dev/null 2>&1

SF20L="$WORK/k20-fallback-legacy-state"
"$TRACE_REPO/controller/state/cli.real" init "$SF20L" >/dev/null 2>&1
legacy_claim20=$("$TRACE_REPO/controller/taskval/cli.real" claim "$WORK/h004-selector-fallback.json" "$DF20" "$SF20L" 2>/dev/null); legacy_claim20_rc=$?
legacy_events20=$(wc -l < "$SF20L/events.jsonl" 2>/dev/null | tr -d ' ')

SF20W="$WORK/k20-fallback-wrong-state"
"$TRACE_REPO/controller/state/cli.real" init "$SF20W" >/dev/null 2>&1
wrong_fallback20=$("$TRACE_REPO/controller/taskval/cli.real" select "$WORK/h004-selector-fallback.json" "$DF20" "$SF20W" --authority fallback-wrong 2>/dev/null); wrong_fallback20_rc=$?

SF20WC="$WORK/k20-fallback-wrong-claim-state"
"$TRACE_REPO/controller/state/cli.real" init "$SF20WC" >/dev/null 2>&1
wrong_claim_fallback20=$("$TRACE_REPO/controller/taskval/cli.real" claim "$WORK/h004-selector-fallback.json" "$DF20" "$SF20WC" --authority fallback-wrong 2>/dev/null); wrong_claim_fallback20_rc=$?
wrong_claim_events20=$(wc -l < "$SF20WC/events.jsonl" 2>/dev/null | tr -d ' ')

SF20S="$WORK/k20-fallback-stale-state"
"$TRACE_REPO/controller/state/cli.real" init "$SF20S" >/dev/null 2>&1
stale_fallback20=$("$TRACE_REPO/controller/taskval/cli.real" claim "$WORK/h004-selector-fallback.json" "$DF20" "$SF20S" --authority fallback-old-A 2>/dev/null); stale_fallback20_rc=$?
stale_fallback_events20=$(wc -l < "$SF20S/events.jsonl" 2>/dev/null | tr -d ' ')
current_fallback20=$("$TRACE_REPO/controller/taskval/cli.real" select "$WORK/h004-selector-fallback.json" "$DF20" "$SF20W" --authority fallback-current-B 2>/dev/null); current_fallback20_rc=$?

if [ "$right20_rc" -eq 0 ] && [ "$right20" = "selector-target" ] \
   && [ "$legacy20_rc" -eq 0 ] && [ -z "$legacy20" ] \
   && rc_zero_or_one "$wrong20_rc" && [ -z "$wrong20" ] \
   && [ "$legacy_after20_rc" -eq 0 ] && [ "$legacy_after20" = "selector-target" ] \
   && rc_zero_or_one "$stale20_rc" && [ -z "$stale20" ] && [ "$events20" = "0" ] \
   && [ "$legacy_claim20_rc" -eq 0 ] && [ "$legacy_claim20" = "fallback-target" ] \
   && [ "$legacy_events20" = "1" ] \
   && rc_zero_or_one "$wrong_fallback20_rc" && [ -z "$wrong_fallback20" ] \
   && rc_zero_or_one "$wrong_claim_fallback20_rc" && [ -z "$wrong_claim_fallback20" ] \
   && [ "$wrong_claim_events20" = "0" ] \
   && rc_zero_or_one "$stale_fallback20_rc" && [ -z "$stale_fallback20" ] \
   && [ "$stale_fallback_events20" = "0" ] \
   && [ "$current_fallback20_rc" -eq 0 ] && [ "$current_fallback20" = "fallback-target" ]; then
  ok "K20 taskval authority: legacy+prior-final+same-run union och explicit wrong/stale anti-fallback"
else
  no "K20 taskval authority" "union=$right20_rc/[$right20] legacy=$legacy20_rc/[$legacy20] wrong=$wrong20_rc/[$wrong20] legacy-after=$legacy_after20_rc/[$legacy_after20] stale=$stale20_rc/[$stale20]/$events20 fallback legacy=$legacy_claim20_rc/[$legacy_claim20]/$legacy_events20 wrong-select=$wrong_fallback20_rc/[$wrong_fallback20] wrong-claim=$wrong_claim_fallback20_rc/[$wrong_claim_fallback20]/$wrong_claim_events20 stale=$stale_fallback20_rc/[$stale_fallback20]/$stale_fallback_events20 current=$current_fallback20_rc/[$current_fallback20]"
fi

h010_out=$("$PY3" "$WORK/h004-deadline.py" 60 bash verify/bin/h-010-exit 2>&1); h010_rc=$?
deadline_probe_or_od "$h010_rc" "K20b deadline"
if [ "$h010_rc" -eq 0 ] && echo "$h010_out" | grep -q '15 PASS, 0 FAIL'; then
  ok "K20b legacy taskval: hela frysta h-010-gaten förblir grön"
else
  no "K20b legacy taskval" "exit=$h010_rc ${h010_out:-ingen output}"
fi

trace_count() {
  python3 -c 'import json,sys
try: rows=[json.loads(x) for x in open(sys.argv[1]) if x.strip()]
except Exception: print(0); raise SystemExit
print(sum(r.get("component")==sys.argv[2] and r.get("command")==sys.argv[3] and r.get("phase")==sys.argv[4] for r in rows))' "$1" "$2" "$3" "$4"
}

trace_token() {
  python3 -c 'import json,sys
try: rows=[json.loads(x) for x in open(sys.argv[1]) if x.strip()]
except Exception: print(""); raise SystemExit
hits=[r for r in rows if r.get("component")=="lease" and r.get("command")=="acquire" and r.get("phase")=="end" and r.get("rc")==0]
print(hits[0].get("stdout","").strip() if hits else "")' "$1"
}

run_variant() {
  V_PREFIX="$1"; V_MODE="$2"; V_SPEC="$3"; V_RESOURCE="$4"
  V_TRACE="$V_PREFIX.trace"
  V_COUNT="$V_PREFIX.workers"
  V_SUCCESSOR="$V_PREFIX.successor"
  authority_config "$V_PREFIX.json" "$V_SPEC" "$V_PREFIX" "$V_RESOURCE"
  V_DEADLINE=60
  if [ "$V_MODE" = "replace_final_guard" ]; then
    # Denna variant ska observera den explicita post-drain-guarden, inte en
    # schemalagd heartbeat. Samtidigt ryms en legitim sleep-baserad stop/join.
    if ! "$PY3" - "$V_PREFIX.json" <<'PYLONGGUARD'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
config = json.loads(path.read_text(encoding="utf-8"))
config["lease_ttl_s"] = 60
config["lease_heartbeat_s"] = 30
path.write_text(json.dumps(config, sort_keys=True) + "\n", encoding="utf-8")
check = json.loads(path.read_text(encoding="utf-8"))
raise SystemExit(0 if (check.get("lease_ttl_s"), check.get("lease_heartbeat_s")) == (60, 30) else 1)
PYLONGGUARD
    then
      echo "SKIP  K23 config-rigg — timing rewrite kunde inte verifieras, ODÖMBART"
      exit 2
    fi
    V_DEADLINE=90
  fi
  mkdir -p "$V_PREFIX-ws"
  "$TRACE_REPO/controller/state/cli.real" init "$V_PREFIX-state" >/dev/null 2>&1
  : > "$V_TRACE"
  V_GUARD_MARKER=""
  V_GUARD_READY=""
  rm -f "$V_COUNT" "$V_SUCCESSOR" "$V_PREFIX.once" "$V_PREFIX.bmark" \
    "$V_PREFIX.guard-deadline" "$V_PREFIX.guard-ready"
  touch "$V_PREFIX.continue"
  if [ "$V_MODE" = "replace_final_guard" ]; then
    V_GUARD_MARKER="$V_PREFIX.guard-deadline"
    V_GUARD_READY="$V_PREFIX.guard-ready"
    "$PY3" - "$V_GUARD_MARKER" "$V_GUARD_READY" <<'PYGUARDTIMER' &
import pathlib
import sys
import time

deadline = pathlib.Path(sys.argv[1])
ready = pathlib.Path(sys.argv[2])
ready.write_text("ready\n", encoding="utf-8")
time.sleep(20)
deadline.write_text("elapsed\n", encoding="utf-8")
PYGUARDTIMER
    H004_GUARD_TIMER_PID=$!
    guard_ready_i=0
    while [ ! -s "$V_GUARD_READY" ] && kill -0 "$H004_GUARD_TIMER_PID" 2>/dev/null \
      && [ "$guard_ready_i" -lt 100 ]; do
      sleep 0.02
      guard_ready_i=$((guard_ready_i + 1))
    done
    if [ ! -s "$V_GUARD_READY" ]; then
      kill "$H004_GUARD_TIMER_PID" >/dev/null 2>&1 || true
      wait "$H004_GUARD_TIMER_PID" >/dev/null 2>&1 || true
      H004_GUARD_TIMER_PID=""
      echo "SKIP  K23 guard-timer — central monotonic timer startade inte, ODÖMBART"
      exit 2
    fi
  fi
  (
    cd "$TRACE_REPO" || exit 1
    H004_TRACE="$V_TRACE" \
    H004_MODE="$V_MODE" \
    H004_HARNESS_PID="$$" \
    H004_WORKER_COUNT="$V_COUNT" \
    H004_B_MARK="$V_PREFIX.bmark" \
    H004_B_CONTINUE="$V_PREFIX.continue" \
    H004_SUCCESSOR_FILE="$V_SUCCESSOR" \
    H004_BARRIER_ONCE="$V_PREFIX.once" \
    H004_LEASE_DIR="$V_PREFIX-lease" \
    H004_LEASE_RESOURCE="$V_RESOURCE" \
    H004_ATTEST_DIR="$V_PREFIX-att" \
    H004_GUARD_DEADLINE_MARKER="$V_GUARD_MARKER" \
    H004_DEADLINE_CHILD_PID_FILE="$V_PREFIX.loop-pid" \
    "$PY3" "$WORK/h004-deadline.py" "$V_DEADLINE" ./controller/loop/cli run "$V_PREFIX.json"
  ) >"$V_PREFIX.out" 2>"$V_PREFIX.err"
  V_RC=$?
  if [ -n "${H004_GUARD_TIMER_PID:-}" ]; then
    kill "$H004_GUARD_TIMER_PID" >/dev/null 2>&1 || true
    wait "$H004_GUARD_TIMER_PID" >/dev/null 2>&1 || true
    H004_GUARD_TIMER_PID=""
  fi
  deadline_probe_or_od "$V_RC" "K18+ deadline"
  if ! trace_valid "$V_TRACE"; then
    echo "SKIP  K18+ trace-rigg — malformed/partial trace, ODÖMBART"
    exit 2
  fi
  if [ -f "$V_PREFIX-state/events.jsonl" ]; then
    V_EVENTS=$(wc -l < "$V_PREFIX-state/events.jsonl" | tr -d ' ')
  else
    V_EVENTS=0
  fi
  if [ -f "$V_COUNT" ]; then
    V_WORKERS=$(wc -l < "$V_COUNT" | tr -d ' ')
  else
    V_WORKERS=0
  fi
  V_BEGIN_START=$(trace_count "$V_TRACE" attest begin-authority start)
  V_AUTH_WRITE_START=$(trace_count "$V_TRACE" attest write start)
  V_CLAIM_START=$(trace_count "$V_TRACE" taskval claim start)
  V_WORKSPACE_START=$(trace_count "$V_TRACE" workspace create start)
  V_SESSION_START=$(trace_count "$V_TRACE" launch run start)
  V_CRASH_MARK=$(trace_count "$V_TRACE" attest finalize-authority crash_before_finalize)
  V_FINALIZE_START=$(trace_count "$V_TRACE" attest finalize-authority start)
  V_FINALIZE_END=$(trace_count "$V_TRACE" attest finalize-authority end)
  V_INJECT_BEGIN_FAIL=$(trace_count "$V_TRACE" attest begin-authority injected_begin_fail)
  V_INJECT_RELEASE_REFUSE=$(trace_count "$V_TRACE" lease release injected_release_refuse)
  V_INJECT_RELEASE_DELETE=$(trace_count "$V_TRACE" lease release injected_release_delete_fail)
  V_INJECT_FINALIZE_FAIL=$(trace_count "$V_TRACE" attest finalize-authority injected_finalize_fail)
  V_DELEGATED_RELEASE=$(trace_count "$V_TRACE" lease release delegated_release_success)
  V_TOKEN=$(trace_token "$V_TRACE")
}

cat > "$WORK/h004-one-phase-check.py" <<'PYPHASECHECK'
import json
import pathlib
import sys

rows = [
    json.loads(line)
    for line in pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
    if line.strip()
]
for sequence, row in enumerate(rows):
    row["_seq"] = sequence
mode = sys.argv[2]

def chosen(component=None, command=None, phase=None, rc=None):
    answer = rows
    if component is not None:
        answer = [r for r in answer if r.get("component") == component]
    if command is not None:
        answer = [r for r in answer if r.get("command") == command]
    if phase is not None:
        answer = [r for r in answer if r.get("phase") == phase]
    if rc is not None:
        answer = [r for r in answer if r.get("rc") == rc]
    return answer

acquires = chosen("lease", "acquire", "end", 0)
if len(acquires) != 1:
    raise SystemExit("one successful acquire required")
token = acquires[0].get("stdout", "").strip()
if not token:
    raise SystemExit("empty acquire token")

begin_starts = chosen("attest", "begin-authority", "start")
begins = chosen("attest", "begin-authority", "end")
if (
    len(begin_starts) != 1 or len(begins) != 1 or begins[0].get("rc") != 0
    or begins[0].get("args", [])[-1:] != [token]
):
    raise SystemExit("exact old-token begin missing")

write_starts = chosen("attest", "write", "start")
writes = chosen("attest", "write", "end")
if len(write_starts) != 1 or len(writes) != 1 or writes[0].get("rc") != 0:
    raise SystemExit("successful write-set is not exactly one publication")
write = writes[0]
if (
    len(write.get("args", [])) <= 2
    or write["args"][2] != "authority-one"
    or write["args"][-2:] != ["--authority", token]
    or not acquires[0]["_seq"] < begin_starts[0]["_seq"] < begins[0]["_seq"] < write["_seq"]
):
    raise SystemExit("exact authority-one publication missing")
if chosen("attest", "invalidate", "start"):
    raise SystemExit("unexpected invalidation in one-task run")

def token_rows(component, command, phase, rc=None):
    return [
        r for r in chosen(component, command, phase, rc)
        if r.get("args", [])[-1:] == [token]
    ]

release_starts = token_rows("lease", "release", "start")
release_ends = token_rows("lease", "release", "end")
all_release_starts = chosen("lease", "release", "start")
all_release_ends = chosen("lease", "release", "end")
finalize_starts = token_rows("attest", "finalize-authority", "start")
finalize_ends = token_rows("attest", "finalize-authority", "end")
all_finalize_starts = chosen("attest", "finalize-authority", "start")
all_finalize_ends = chosen("attest", "finalize-authority", "end")

if mode in ("release_refuse", "release_delete_fail"):
    marker_name = "injected_" + mode
    markers = chosen("lease", "release", marker_name)
    if (len(release_starts) != 1 or len(release_ends) != 1
            or len(all_release_starts) != 1 or len(all_release_ends) != 1
            or len(markers) != 1):
        raise SystemExit("exact injected release history missing")
    if release_ends[0].get("rc") != 1 or all_finalize_starts or all_finalize_ends:
        raise SystemExit("release fault did not fail closed")
    if not write["_seq"] < release_starts[0]["_seq"] < markers[0]["_seq"] < release_ends[0]["_seq"]:
        raise SystemExit("release fault ordering")
    if mode == "release_delete_fail" and markers[0].get("delegated_rc") != 0:
        raise SystemExit("forward release did not succeed before injected failure")
elif mode == "finalize_fail":
    markers = chosen("attest", "finalize-authority", "injected_finalize_fail")
    if (len(release_starts) != 1 or len(release_ends) != 1
            or len(all_release_starts) != 1 or len(all_release_ends) != 1
            or release_ends[0].get("rc") != 0):
        raise SystemExit("clean release missing")
    if (len(finalize_starts) != 1 or len(finalize_ends) != 1
            or len(all_finalize_starts) != 1 or len(all_finalize_ends) != 1
            or len(markers) != 1):
        raise SystemExit("exact injected finalize history missing")
    if finalize_ends[0].get("rc") != 1:
        raise SystemExit("injected finalize did not report failure")
    if not write["_seq"] < release_ends[0]["_seq"] < finalize_starts[0]["_seq"] < markers[0]["_seq"] < finalize_ends[0]["_seq"]:
        raise SystemExit("finalize fault ordering")
elif mode in ("replace_after_write", "replace_final_guard"):
    injected = chosen(phase="injected_successor")
    empty_claims = [
        r for r in chosen("taskval", "claim", "end", 0)
        if not r.get("stdout", "").strip()
    ]
    if all_release_starts or all_release_ends or all_finalize_starts or all_finalize_ends:
        raise SystemExit("lease-loss path attempted finalize")
    write_point = write_starts[0] if mode == "replace_after_write" else write
    if len(injected) != 1 or not write_point["_seq"] < injected[0]["_seq"]:
        raise SystemExit("successor did not follow old provisional publication")
    if mode == "replace_final_guard" and (
        len(empty_claims) != 1 or not injected[0]["_seq"] < empty_claims[0]["_seq"]
    ):
        raise SystemExit("final-guard successor was not observed before empty claim returned")
elif mode == "crash_finalize":
    crash = chosen("attest", "finalize-authority", "crash_before_finalize")
    if (len(release_starts) != 1 or len(release_ends) != 1
            or len(all_release_starts) != 1 or len(all_release_ends) != 1
            or release_ends[0].get("rc") != 0
            or len(finalize_starts) != 1 or len(all_finalize_starts) != 1
            or len(crash) != 1):
        raise SystemExit("crash history missing")
    if not write["_seq"] < release_ends[0]["_seq"] < finalize_starts[0]["_seq"] < crash[0]["_seq"]:
        raise SystemExit("crash ordering")
elif mode == "successor_after_release":
    delegated = chosen("lease", "release", "delegated_release_success")
    injected = chosen(phase="injected_successor")
    if (len(release_starts) != 1 or len(release_ends) != 1
            or len(all_release_starts) != 1 or len(all_release_ends) != 1
            or release_ends[0].get("rc") != 0):
        raise SystemExit("clean old release history missing")
    if len(delegated) != 1 or len(injected) != 1:
        raise SystemExit("successor injection history missing")
    if (len(finalize_starts) != 1 or len(finalize_ends) != 1
            or len(all_finalize_starts) != 1 or len(all_finalize_ends) != 1
            or finalize_ends[0].get("rc") != 1):
        raise SystemExit("stale old finalize did not fail")
    if not (
        write["_seq"] < release_starts[0]["_seq"]
        < delegated[0]["_seq"] < injected[0]["_seq"]
        < release_ends[0]["_seq"] < finalize_starts[0]["_seq"]
        < finalize_ends[0]["_seq"]
    ):
        raise SystemExit("successor/finalize ordering")
else:
    raise SystemExit("unknown mode")
PYPHASECHECK

one_phase_ok() {
  "$PY3" "$WORK/h004-one-phase-check.py" "$1" "$2" >/dev/null 2>&1
}

# K18b: BEGIN-failure och korrupt authority-store stannar före claim/event,
# session, publication och finalize. Acquire/release får ske för ren cleanup.
run_variant "$WORK/k18-begin-fail" begin_fail "$WORK/h004-one.json" h004-begin-fail
begin_fail_ok=0
if [ "$V_RC" -eq 1 ] && [ "${V_EVENTS:-x}" = "0" ] \
   && [ "${V_WORKERS:-0}" = "0" ] && [ "$V_BEGIN_START" = "1" ] \
   && [ "$V_INJECT_BEGIN_FAIL" = "1" ] \
   && [ "$V_AUTH_WRITE_START" = "0" ] && [ "$V_CLAIM_START" = "0" ] \
   && [ "$V_WORKSPACE_START" = "0" ] && [ "$V_SESSION_START" = "0" ] \
   && [ "$V_FINALIZE_START" = "0" ]; then
  begin_fail_ok=1
fi

COR18="$WORK/k18-corrupt"
mkdir -p "$COR18-att"
"$TRACE_REPO/controller/attest/cli.real" "$COR18-att" write corrupt-seed "$(sha_for 4180)" >/dev/null 2>&1
corrupted18=$(python3 -c 'import pathlib,sys
root=pathlib.Path(sys.argv[1]); count=0
for path in root.rglob("*"):
    if path.is_file() and not path.is_symlink():
        path.write_bytes(b"nortropic-partial-authority-state")
        count += 1
print(count)
raise SystemExit(0 if count else 1)' "$COR18-att" 2>/dev/null); corrupted18_rc=$?
if [ "$corrupted18_rc" -ne 0 ]; then
  echo "SKIP  K18b corrupt-state fixture — ingen katalogbunden state kunde prepareras, ODÖMBART"
  exit 2
fi
run_variant "$COR18" normal "$WORK/h004-one.json" h004-corrupt
corrupt_begin_ok=0
if [ "$V_RC" -eq 1 ] && [ "${V_EVENTS:-x}" = "0" ] \
   && [ "${V_WORKERS:-0}" = "0" ] && [ "$V_BEGIN_START" = "1" ] \
   && [ "$V_AUTH_WRITE_START" = "0" ] && [ "$V_CLAIM_START" = "0" ] \
   && [ "$V_WORKSPACE_START" = "0" ] && [ "$V_SESSION_START" = "0" ] \
   && [ "$V_FINALIZE_START" = "0" ]; then
  corrupt_begin_ok=1
fi

if [ "$begin_fail_ok" -eq 1 ] && [ "$corrupt_begin_ok" -eq 1 ] && [ "$corrupted18" -gt 0 ]; then
  ok "K18b BEGIN failure/corruption vägras före event, worker, publication och finalize"
else
  no "K18b BEGIN failure" "injected-ok=$begin_fail_ok corrupt-ok=$corrupt_begin_ok"
fi

# K22: två release-failure-former och en finalize-failure. Reported release
# failure får ALDRIG följas av finalize — även om systern hann delete:a bytes.
