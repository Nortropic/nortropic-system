  "$SHADOW/controller/loop/cli" run "$WORK/s3-release-fail-config.json" \
  >"$WORK/s3-release-fail.out" 2>"$WORK/s3-release-fail.err"
release_fail21_rc=$?
if [ "$release_fail21_rc" -eq 90 ]; then
  echo "SKIP  K21 harness — bounded loop timed out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
fi
valid_fail21=0; "$ATT" "$A21F" read auth-negative --require-valid >/dev/null 2>&1 || valid_fail21=$?
prefix_fail21_out=$("$PY3" "$PREFIX_CHECK" "$TRACE21F" s3-release-fail-resource \
  auth-negative release_fail 2>&1); prefix_fail21_rc=$?
