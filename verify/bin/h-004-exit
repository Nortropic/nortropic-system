    "max_added_lines": 600
  },
  "tasks": [
    {
      "id": "s3-heartbeat-task",
      "slice": 0,
      "title": "heartbeat",
      "summary": "S3 heartbeat fixture",
      "allowed_write": ["tests/lease-heartbeat-fixture/**"],
      "exit_test": "verify/bin/ingen",
      "exit_criterion": "-",
      "docs_impact": [],
      "depends_on": []
    }
  ]
}
JSON

cat > "$WORK/s3-loss-backlog.json" <<'JSON'
{
  "spec_version": "s3-fixtur",
  "defaults": {
    "max_changed_files": 8,
    "max_added_lines": 600
  },
  "tasks": [
    {
      "id": "s3-loss-task",
      "slice": 0,
      "title": "lease loss",
      "summary": "S3 lease-loss fixture",
      "allowed_write": ["tests/lease-heartbeat-fixture/**"],
      "exit_test": "verify/bin/ingen",
      "exit_criterion": "-",
      "docs_impact": [],
      "depends_on": []
    }
  ]
}
JSON

cat > "$WORK/s3-heartbeat-worker.py" <<'PYWORK'
import json
import os
import sys
import time

json.load(sys.stdin)
open(os.environ["S3_HB_MARK"], "w", encoding="utf-8").write("started\n")
time.sleep(3.5)

os.makedirs("tests/lease-heartbeat-fixture", exist_ok=True)
open(
    "tests/lease-heartbeat-fixture/heartbeat.txt",
    "w",
    encoding="utf-8",
).write("heartbeat\n")

print("heartbeat fixture klar")
PYWORK

cat > "$WORK/s3-loss-worker.py" <<'PYWORK'
import json
import os
import sys
import time

json.load(sys.stdin)
open(os.environ["S3_LOSS_MARK"], "w", encoding="utf-8").write("started\n")
time.sleep(3.0)

os.makedirs("tests/lease-heartbeat-fixture", exist_ok=True)
open(
    "tests/lease-heartbeat-fixture/loss.txt",
    "w",
    encoding="utf-8",
).write("old-generation\n")

print("loss fixture klar")
PYWORK

cat > "$WORK/s3-bad-worker.py" <<'PYWORK'
import json
import os
import sys

json.load(sys.stdin)
open(os.environ["S3_BAD_MARK"], "w", encoding="utf-8").write("started\n")

os.makedirs("tests/lease-heartbeat-fixture", exist_ok=True)
open(
    "tests/lease-heartbeat-fixture/bad.txt",
    "w",
    encoding="utf-8",
).write("should-not-run\n")

print("bad config fixture kördes")
PYWORK

write_config() {
  cat > "$1" <<JSON
{
  "spec": "$2",
  "attest_dir": "$3",
  "state_dir": "$4",
  "lease_dir": "$5",
  "lease_resurs": "$6",
  "workspace_rot": "$7",
  "base_sha": "$BAS",
  "worker_cmd": ["$PY3", "$8"],
  "timeout_s": 10,
  "verifier_id": "check-invariants",
  "run_id": "$9",
  "brytare_rot": "$7-br",
  "budget": 1,
  "troskel": 2,
  "lease_ttl_s": ${10},
  "lease_heartbeat_s": ${11}
}
JSON
}


# K12 — en riktig loopkörning längre än TTL måste förnya sin lease.
D12="$WORK/s3-loop-hb-lease"
S12="$WORK/s3-loop-hb-state"
A12="$WORK/s3-loop-hb-att"
W12="$WORK/s3-loop-hb-ws"

mkdir -p "$W12"
"$ST" init "$S12" >/dev/null 2>&1

export S3_HB_MARK="$WORK/s3-heartbeat-started"

write_config \
  "$WORK/s3-heartbeat-config.json" \
  "$WORK/s3-heartbeat-backlog.json" \
  "$A12" "$S12" "$D12" "s3-heartbeat" "$W12" \
  "$WORK/s3-heartbeat-worker.py" \
  "s3-heartbeat-run" \
  1.2 0.25

"$LOOP" run "$WORK/s3-heartbeat-config.json" \
  >"$WORK/s3-heartbeat.out" \
  2>"$WORK/s3-heartbeat.err" &
loop12=$!

started12=0
wait_mark_or_exit "$S3_HB_MARK" "$loop12" && started12=1

lease12="$D12/s3-heartbeat.lease"
sha12a=""
sha12b=""
owner12_during=""

if [ "$started12" -eq 1 ] && [ -f "$lease12" ]; then
  sha12a="$(file_sha "$lease12")"
  owner12_during="$("$CLI" "$D12" owner s3-heartbeat 2>/dev/null || true)"
  sleep 0.7
  sha12b="$(file_sha "$lease12")"
  sleep 0.7
fi

steal12=""
steal12_rc=99

if kill -0 "$loop12" 2>/dev/null; then
  steal12="$("$CLI" "$D12" acquire s3-heartbeat --ttl 30 2>/dev/null)"
  steal12_rc=$?
fi

wait "$loop12"
loop12_rc=$?

att12=1
"$ATT" "$A12" read s3-heartbeat-task --require-valid >/dev/null 2>&1 \
  && att12=0

owner12="$("$CLI" "$D12" owner s3-heartbeat 2>/dev/null || true)"

if [ "$started12" -eq 1 ] \
   && text_has_pid "$owner12_during" "$loop12" \
   && [ -n "$sha12a" ] \
   && [ -n "$sha12b" ] \
   && [ "$sha12a" != "$sha12b" ] \
   && [ "$steal12_rc" -ne 0 ] \
   && [ "$loop12_rc" -eq 0 ] \
   && [ "$att12" -eq 0 ] \
   && [ -z "$owner12" ]; then
  ok "K12 loop-heartbeat: owner är controller-PID, leasebytes förnyas och run längre än TTL kan inte tas över"
else
  no "K12 loop-heartbeat" \
    "start/owner-during/loop-pid/sha-change/steal/loop/att/owner-after=$started12/[$owner12_during]/$loop12/$([ -n "$sha12a" ] && [ "$sha12a" != "$sha12b" ] && echo ja || echo nej)/$steal12_rc/$loop12_rc/$att12/[$owner12]"
fi

if [ "$steal12_rc" -eq 0 ] && token_ok "$steal12"; then
  "$CLI" "$D12" release s3-heartbeat "$steal12" >/dev/null 2>&1 || true
fi

unset S3_HB_MARK


# K13 — simulera lease-loss UTAN egen JSON:
# ta bort gamla generationens fil och låt publika acquire skapa efterträdaren.
# Gamla runnet får aldrig attestera eller radera den nya generationen.
D13="$WORK/s3-loop-loss-lease"
S13="$WORK/s3-loop-loss-state"
A13="$WORK/s3-loop-loss-att"
W13="$WORK/s3-loop-loss-ws"

mkdir -p "$W13"
"$ST" init "$S13" >/dev/null 2>&1

export S3_LOSS_MARK="$WORK/s3-loss-started"

write_config \
  "$WORK/s3-loss-config.json" \
  "$WORK/s3-loss-backlog.json" \
  "$A13" "$S13" "$D13" "s3-loss" "$W13" \
  "$WORK/s3-loss-worker.py" \
  "s3-loss-run" \
  4 0.2

"$LOOP" run "$WORK/s3-loss-config.json" \
  >"$WORK/s3-loss.out" \
  2>"$WORK/s3-loss.err" &
loop13=$!

started13=0
wait_mark_or_exit "$S3_LOSS_MARK" "$loop13" && started13=1

successor13=""
successor13_rc=99

if [ "$started13" -eq 1 ] && [ -f "$D13/s3-loss.lease" ]; then
  rm -f "$D13/s3-loss.lease"

  successor13="$(
    "$CLI" "$D13" acquire s3-loss \
      --ttl 60 \
      --holder-pid "$$" \
      2>/dev/null
  )"
  successor13_rc=$?
fi

wait "$loop13"
loop13_rc=$?

att13=1
"$ATT" "$A13" read s3-loss-task --require-valid >/dev/null 2>&1 \
  && att13=0

owner13="$("$CLI" "$D13" owner s3-loss 2>/dev/null || true)"

if [ "$started13" -eq 1 ] \
   && [ "$successor13_rc" -eq 0 ] \
   && token_ok "$successor13" \
   && [ "$loop13_rc" -eq 1 ] \
   && [ "$att13" -ne 0 ] \
   && [ -n "$owner13" ]; then
  ok "K13 lease-loss: gammalt run faller stängt och lämnar efterträdarens lease"
else
  no "K13 lease-loss" \
    "start/successor/loop/att/owner=$started13/$successor13_rc/$loop13_rc/$att13/[$owner13]"
fi

if [ "$successor13_rc" -eq 0 ] && token_ok "$successor13"; then
  "$CLI" "$D13" release s3-loss "$successor13" >/dev/null 2>&1 || true
else
  "$CLI" "$D13" release s3-loss >/dev/null 2>&1 || true
fi

unset S3_LOSS_MARK


# K14 — heartbeat måste vara positiv och strikt mindre än TTL.
D14="$WORK/s3-bad-lease"
S14="$WORK/s3-bad-state"
A14="$WORK/s3-bad-att"
W14="$WORK/s3-bad-ws"

mkdir -p "$W14"
"$ST" init "$S14" >/dev/null 2>&1

export S3_BAD_MARK="$WORK/s3-bad-started"

write_config \
  "$WORK/s3-bad-config.json" \
  "$WORK/s3-heartbeat-backlog.json" \
  "$A14" "$S14" "$D14" "s3-bad" "$W14" \
  "$WORK/s3-bad-worker.py" \
  "s3-bad-run" \
  1 1

"$LOOP" run "$WORK/s3-bad-config.json" \
  >"$WORK/s3-bad.out" \
  2>"$WORK/s3-bad.err"
bad14_rc=$?

events14="$(wc -l < "$S14/events.jsonl" | tr -d ' ')"

if [ "$bad14_rc" -eq 1 ] \
   && [ ! -s "$S3_BAD_MARK" ] \
   && [ ! -e "$D14/s3-bad.lease" ] \
   && [ "$events14" = "0" ]; then
  ok "K14 config: heartbeat >= TTL vägras före lease, event och session"
else
  no "K14 config" \
    "exit/start/lease/events=$bad14_rc/$([ -s "$S3_BAD_MARK" ] && echo ja || echo nej)/$([ -e "$D14/s3-bad.lease" ] && echo ja || echo nej)/$events14"
fi

unset S3_BAD_MARK


# ========== S3 authority/incarnation/overlap controls ==========================

# K15 — positiv process-incarnation anchor. owner --json must expose the exact
# holder lifetime identity used by liveness; the original living incarnation
# remains protected after TTL.
D15="$WORK/s3-incarnation-positive"
mkdir -p "$D15"
sleep 6 &
holder15=$!
t15="$({ "$CLI" "$D15" acquire s3-incarnation-positive --ttl 1 --holder-pid "$holder15"; } 2>/dev/null)"
r15=$?
j15="$({ "$CLI" "$D15" owner s3-incarnation-positive --json; } 2>/dev/null)"
j15rc=$?
sleep 1.3
during15="$({ "$CLI" "$D15" acquire s3-incarnation-positive --ttl 30; } 2>/dev/null)"
during15rc=$?
if [ "$r15" -eq 0 ] \
   && token_ok "$t15" \
   && [ "$j15rc" -eq 0 ] \
   && owner_json_valid "$j15" "$t15" "$holder15" \
   && [ "$during15rc" -ne 0 ]; then
  ok "K15 process-incarnation: owner binder host+pid+opaque livstid och levande original skyddas efter TTL"
else
  no "K15 process-incarnation anchor" "acquire/json/reclaim=$r15/$j15rc/$during15rc token=[$t15] owner=[$j15]"
fi
kill "$holder15" 2>/dev/null || true
wait "$holder15" 2>/dev/null || true
if [ "$r15" -eq 0 ] && token_ok "$t15"; then
  "$CLI" "$D15" release s3-incarnation-positive "$t15" >/dev/null 2>&1 || true
else
  "$CLI" "$D15" release s3-incarnation-positive >/dev/null 2>&1 || true
fi


# K16 — prepared PID-reuse state, uttryckligen tillåten av owner-beslutet:
# verklig public acquire ankras först; endast det opaque incarnation-värdet i
# serialiserad state byts. Samma numeriska PID lever fortfarande, men original
# processlivstid matchar inte längre och får inte blockera reclaim efter TTL.
D16="$WORK/s3-incarnation-reuse"
mkdir -p "$D16"
sleep 7 &
holder16=$!
t16="$({ "$CLI" "$D16" acquire s3-incarnation-reuse --ttl 1 --holder-pid "$holder16"; } 2>/dev/null)"
r16=$?
j16="$({ "$CLI" "$D16" owner s3-incarnation-reuse --json; } 2>/dev/null)"
j16rc=$?
inc16=""
[ "$j16rc" -eq 0 ] && inc16="$(owner_json_field "$j16" incarnation 2>/dev/null || true)"
prep16=1
if [ -n "$inc16" ] && [ -f "$D16/s3-incarnation-reuse.lease" ]; then
  replace_incarnation "$D16/s3-incarnation-reuse.lease" "$inc16" >/dev/null 2>&1
  prep16=$?
fi
sleep 1.3
reuse16="$({ "$CLI" "$D16" acquire s3-incarnation-reuse --ttl 30; } 2>/dev/null)"
reuse16rc=$?
if [ "$r16" -eq 0 ] \
   && token_ok "$t16" \
   && [ "$j16rc" -eq 0 ] \
   && owner_json_valid "$j16" "$t16" "$holder16" \
   && [ "$prep16" -eq 0 ] \
   && [ "$reuse16rc" -eq 0 ] \
   && token_ok "$reuse16" \
   && [ "$reuse16" != "$t16" ]; then
  ok "K16 PID reuse: samma live PID med annan incarnation reclaimas efter TTL"
else
  no "K16 PID-only/random-incarnation" "acquire/json/prep/reclaim=$r16/$j16rc/$prep16/$reuse16rc old/new=[$t16]/[$reuse16]"
fi
kill "$holder16" 2>/dev/null || true
wait "$holder16" 2>/dev/null || true
if [ "$reuse16rc" -eq 0 ] && token_ok "$reuse16"; then
  "$CLI" "$D16" release s3-incarnation-reuse "$reuse16" >/dev/null 2>&1 || true
elif [ "$r16" -eq 0 ] && token_ok "$t16"; then
  "$CLI" "$D16" release s3-incarnation-reuse "$t16" >/dev/null 2>&1 || true
else
  "$CLI" "$D16" release s3-incarnation-reuse >/dev/null 2>&1 || true
fi


# K17 — stale release överlappar successor-installation. Barriären ligger efter
# stale operationens authoritative observation. Om implementationen håller ett
# serialiseringslås får successor blockera och installeras efteråt. Om successor
# hinner installeras först måste stale release faila utan en enda byteändring.
D17="$WORK/s3-release-overlap"
B17="$WORK/s3-release-overlap-barrier"
mkdir -p "$D17" "$B17"
t17a="$({ "$CLI" "$D17" acquire s3-release-overlap --ttl 1; } 2>/dev/null)"
r17a=$?
sleep 1.3
env \
  NORTROPIC_TEST_MUTATION_BARRIER_COMPONENT=lease \
  NORTROPIC_TEST_MUTATION_BARRIER_OPERATION=release \
  NORTROPIC_TEST_MUTATION_BARRIER_PHASE=after-observe \
  NORTROPIC_TEST_MUTATION_BARRIER_DIR="$B17" \
  "$CLI" "$D17" release s3-release-overlap "$t17a" \
  >"$WORK/s3-release-overlap-old.out" \
  2>"$WORK/s3-release-overlap-old.err" &
p17old=$!
if [ "$r17a" -eq 0 ] && token_ok "$t17a" && wait_barrier_ready "$B17" "$p17old"; then
  "$CLI" "$D17" acquire s3-release-overlap --ttl 60 \
    >"$WORK/s3-release-overlap-new.out" \
    2>"$WORK/s3-release-overlap-new.err" &
  p17new=$!
  sleep 0.35
  t17b_pre="$(tr -d '\r\n' < "$WORK/s3-release-overlap-new.out")"
  installed17=0
  sha17pre=""
  if token_ok "$t17b_pre" 2>/dev/null; then
    installed17=1
    sha17pre="$(file_sha "$D17/s3-release-overlap.lease")"
  fi
  release_barrier "$B17"
  wait "$p17old"; r17old=$?
  wait "$p17new"; r17new=$?
  t17b="$(tr -d '\r\n' < "$WORK/s3-release-overlap-new.out")"
  if [ "$r17new" -ne 0 ] || ! token_ok "$t17b" 2>/dev/null; then
    t17b="$({ "$CLI" "$D17" acquire s3-release-overlap --ttl 60; } 2>/dev/null)"
    r17new=$?
  fi
  sha17after="$(file_sha "$D17/s3-release-overlap.lease")"
  j17="$({ "$CLI" "$D17" owner s3-release-overlap --json; } 2>/dev/null)"
  identity17="$(owner_json_field "$j17" lease_id 2>/dev/null || true)"
  overlap17_ok=1
  if [ "$installed17" -eq 1 ]; then
    [ "$r17old" -ne 0 ] \
      && [ -n "$sha17pre" ] \
      && [ "$sha17pre" = "$sha17after" ] \
      || overlap17_ok=0
  fi
  if [ "$r17new" -eq 0 ] \
     && token_ok "$t17b" \
     && [ "$identity17" = "$t17b" ] \
     && [ "$overlap17_ok" -eq 1 ]; then
    ok "K17 stale-operation overlap: successor bytes och lease_id överlever release"
  else
    no "K17 stale release/successor" "old/new/installed=$r17old/$r17new/$installed17 identity=[$identity17] token=[$t17b] sha=[$sha17pre]/[$sha17after]"
  fi
  if [ "$r17new" -eq 0 ] && token_ok "$t17b"; then
    "$CLI" "$D17" release s3-release-overlap "$t17b" >/dev/null 2>&1 || true
  fi
else
  release_barrier "$B17"
  kill "$p17old" 2>/dev/null || true
  wait "$p17old" 2>/dev/null || true
  no "K17 release-overlap barrier" "acquire saknade token eller release nådde inte gate-owned ready-seam"
  "$CLI" "$D17" release s3-release-overlap >/dev/null 2>&1 || true
fi


# K18 — run-level lease_id är exakt h-003 authority. Task B beror på A. A:s
# worker hålls först så BEGIN kan observeras före publishable work; B hålls sedan
# så A måste vara authority-bundet PROVISIONAL men globalt ogiltig. FINALIZE
# hålls vid sin publication-point: leasen ska då redan vara cleanly released och
# båda taskerna fortfarande globalt ogiltiga. Fortsättning gör båda VALID.
cat > "$WORK/s3-multi-backlog.json" <<'JSON'
{
  "spec_version": "s3-fixtur",
  "defaults": {
    "max_changed_files": 8,
    "max_added_lines": 600
  },
  "tasks": [
    {
      "id": "s3-multi-a",
      "slice": 0,
      "title": "multi A",
      "summary": "S3 provisional dependency A",
      "allowed_write": ["tests/lease-authority-fixture/**"],
      "exit_test": "verify/bin/ingen",
      "exit_criterion": "-",
      "docs_impact": [],
      "depends_on": []
    },
    {
      "id": "s3-multi-b",
      "slice": 0,
      "title": "multi B",
      "summary": "S3 provisional dependency B",
      "allowed_write": ["tests/lease-authority-fixture/**"],
      "exit_test": "verify/bin/ingen",
      "exit_criterion": "-",
      "docs_impact": [],
      "depends_on": ["s3-multi-a"]
    }
  ]
}
JSON

cat > "$WORK/s3-multi-worker.py" <<'PYWORK'
import json
import os
import pathlib
import sys
import time

envelope = json.load(sys.stdin)
task = envelope["task_id"]
if task == "s3-multi-a":
    mark = pathlib.Path(os.environ["S3_MULTI_A_MARK"])
    go = pathlib.Path(os.environ["S3_MULTI_A_GO"])
    name = "a.txt"
elif task == "s3-multi-b":
    mark = pathlib.Path(os.environ["S3_MULTI_B_MARK"])
    go = pathlib.Path(os.environ["S3_MULTI_B_GO"])
    name = "b.txt"
else:
    raise SystemExit("unexpected task: " + task)
mark.write_text("started\n", encoding="utf-8")
for _ in range(200):
    if go.exists():
        break
    time.sleep(0.05)
else:
    raise SystemExit("gate did not release worker")
pathlib.Path("tests/lease-authority-fixture").mkdir(parents=True, exist_ok=True)
pathlib.Path("tests/lease-authority-fixture", name).write_text(task + "\n", encoding="utf-8")
print(task + " klar")
PYWORK

D18="$WORK/s3-multi-lease"
S18="$WORK/s3-multi-state"
A18="$WORK/s3-multi-attest"
W18="$WORK/s3-multi-workspaces"
B18="$WORK/s3-multi-finalize-barrier"
mkdir -p "$W18" "$B18"
"$ST" init "$S18" >/dev/null 2>&1
export S3_MULTI_A_MARK="$WORK/s3-multi-a-started"
export S3_MULTI_A_GO="$WORK/s3-multi-a-go"
export S3_MULTI_B_MARK="$WORK/s3-multi-b-started"
export S3_MULTI_B_GO="$WORK/s3-multi-b-go"
write_config \
  "$WORK/s3-multi-config.json" \
  "$WORK/s3-multi-backlog.json" \
  "$A18" "$S18" "$D18" "s3-multi" "$W18" \
  "$WORK/s3-multi-worker.py" \
  "s3-multi-run" \
  6 0.5
env \
  NORTROPIC_TEST_MUTATION_BARRIER_COMPONENT=attest \
  NORTROPIC_TEST_MUTATION_BARRIER_OPERATION=finalize-authority \
  NORTROPIC_TEST_MUTATION_BARRIER_PHASE=before-observe \
  NORTROPIC_TEST_MUTATION_BARRIER_DIR="$B18" \
  S3_MULTI_A_MARK="$S3_MULTI_A_MARK" \
  S3_MULTI_A_GO="$S3_MULTI_A_GO" \
  S3_MULTI_B_MARK="$S3_MULTI_B_MARK" \
  S3_MULTI_B_GO="$S3_MULTI_B_GO" \
  "$LOOP" run "$WORK/s3-multi-config.json" \
  >"$WORK/s3-multi.out" \
  2>"$WORK/s3-multi.err" &
p18=$!
started18a=0
wait_mark_or_exit "$S3_MULTI_A_MARK" "$p18" && started18a=1
j18a="$({ "$CLI" "$D18" owner s3-multi --json; } 2>/dev/null)"
lease18="$(owner_json_field "$j18a" lease_id 2>/dev/null || true)"
begin18=1
if [ -n "$lease18" ]; then
  att_current "$A18" "$lease18" && begin18=0
fi
: > "$S3_MULTI_A_GO"
started18b=0
wait_mark_or_exit "$S3_MULTI_B_MARK" "$p18" && started18b=1
provisional18=1
global18a=1
if [ -n "$lease18" ]; then
  att_bound "$A18" s3-multi-a "$lease18" && provisional18=0
fi
att_valid "$A18" s3-multi-a && global18a=0
: > "$S3_MULTI_B_GO"
ready18=0
wait_barrier_ready "$B18" "$p18" && ready18=1
owner18_at_finalize="$({ "$CLI" "$D18" owner s3-multi --json; } 2>/dev/null)"
owner18rc=$?
bound18a=1; bound18b=1; valid18a_before=1; valid18b_before=1
if [ -n "$lease18" ]; then
  att_bound "$A18" s3-multi-a "$lease18" && bound18a=0
  att_bound "$A18" s3-multi-b "$lease18" && bound18b=0
fi
att_valid "$A18" s3-multi-a && valid18a_before=0
att_valid "$A18" s3-multi-b && valid18b_before=0
release_barrier "$B18"
wait "$p18"; run18rc=$?
valid18a_after=1; valid18b_after=1
att_valid "$A18" s3-multi-a && valid18a_after=0
att_valid "$A18" s3-multi-b && valid18b_after=0
owner18_after="$({ "$CLI" "$D18" owner s3-multi --json; } 2>/dev/null)"
owner18after_rc=$?
if [ "$started18a" -eq 1 ] \
   && [ "$begin18" -eq 0 ] \
   && [ "$started18b" -eq 1 ] \
   && [ "$provisional18" -eq 0 ] \
   && [ "$global18a" -ne 0 ] \
   && [ "$ready18" -eq 1 ] \
   && [ "$owner18rc" -ne 0 ] \
   && [ "$bound18a" -eq 0 ] \
   && [ "$bound18b" -eq 0 ] \
   && [ "$valid18a_before" -ne 0 ] \
   && [ "$valid18b_before" -ne 0 ] \
   && [ "$run18rc" -eq 0 ] \
   && [ "$valid18a_after" -eq 0 ] \
   && [ "$valid18b_after" -eq 0 ] \
   && [ "$owner18after_rc" -ne 0 ]; then
  ok "K18 run-authority: BEGIN före work, same-lease provisional dependency, release före atomic finalize"
else
  no "K18 run-level authority/finalize" "startA/begin/startB/prov/globalA/ready/ownerAt/bounds/validBefore/run/validAfter/ownerAfter=$started18a/$begin18/$started18b/$provisional18/$global18a/$ready18/$owner18rc/$bound18a,$bound18b/$valid18a_before,$valid18b_before/$run18rc/$valid18a_after,$valid18b_after/$owner18after_rc lease=[$lease18]"
fi
unset S3_MULTI_A_MARK S3_MULTI_A_GO S3_MULTI_B_MARK S3_MULTI_B_GO


# K19 — successor BEGIN i det avsiktliga release→finalize-fönstret fencar den
# gamla hela batchen. Successor lease bytes/identity ska också överleva gammal
# cleanup/finalize.
cat > "$WORK/s3-window-backlog.json" <<'JSON'
