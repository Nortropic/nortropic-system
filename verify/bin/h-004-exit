   && [ "$V_INJECT_RELEASE_REFUSE" = "1" ] \
   && [ "$V_FINALIZE_START" = "0" ] && [ "$rr_valid" -ne 0 ] \
   && [ "$rr_bound" -eq 0 ] && [ "$rr_phase" -eq 0 ]; then
  rr_ok=1
