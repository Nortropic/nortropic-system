import json,os,sys
e=json.load(sys.stdin); task=e["task_id"]
os.makedirs("tests/lease-authority-fixture",exist_ok=True)
open(f"tests/lease-authority-fixture/{task}.txt","w").write(task+"\n")
open(os.environ["H004_WORK_MARK"]+"."+task,"w").write("started\n")
if os.environ.get("H004_PROVIDER_BAIT"):
