#!/usr/bin/env python3
import base64,hashlib,json,os,sys
from pathlib import Path
p=Path(sys.argv[1]).resolve(); root=Path(sys.argv[2]).resolve(); pid=int(sys.argv[3]); label=sys.argv[4]
token=("gate-"+label+"-incarnation").encode()+b"\x00\xff"
data={"kind":"h004-process-incarnation-v1","lease_root":str(root),
      "observations":[{"host":os.uname().nodename,"pid":pid,"status":"LIVE",
                       "token_b64":base64.b64encode(token).decode()}]}
raw=json.dumps(data,sort_keys=True,separators=(",",":")).encode()
tmp=p.with_name(p.name+f".tmp-{os.getpid()}")
tmp.write_bytes(raw); tmp.chmod(0o600); os.replace(tmp,p)
print(hashlib.sha256(raw).hexdigest())
PY

