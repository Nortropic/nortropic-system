        time.sleep(0.05)
    else:
        raise SystemExit("B fick aldrig continue")

target = pathlib.Path("tests/h004-authority-fixture")
target.mkdir(parents=True, exist_ok=True)
(target / f"{task}.txt").write_text(task + "\n", encoding="utf-8")
print(f"{task} klar")
