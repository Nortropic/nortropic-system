write_config "$C20C" "$SPEC21" "$A20C" "$S20C" "$D20C" \
  s3-config-inert-resource "$W20C" "$WORKER21" s3-config-inert-run 600 300
"$CAP_MAKER" "$CAP20C" "$D20C" "$$" A >/dev/null
"$PY3" - "$C20C" "$CAP20C" <<'PY'
import json,os,sys
p=sys.argv[1]; d=json.load(open(p)); d["gate_incarnation_observation"]=os.path.realpath(sys.argv[2])
json.dump(d,open(p,"w"))
PY
H004_TRACE="$TRACE20C" H004_REAL_LEASE="$REPO_ROOT/controller/lease/cli" \
H004_REAL_ATTEST="$REPO_ROOT/controller/attest/cli" H004_WORK_MARK="$WORK/s3-config-inert-worker" \
H004_CONFIG_BAIT="$CAP20C" H004_CAP_MAKER="$CAP_MAKER" H004_RUN_PID_FILE="$PID20C" \
  "$PY3" "$RUN_BOUNDED" 120 "$SHADOW/controller/loop/cli" run "$C20C" \
  >"$WORK/s3-config-inert.out" 2>"$WORK/s3-config-inert.err"
loop20c_rc=$?
if [ "$loop20c_rc" -eq 90 ]; then
  echo "SKIP  K20c harness — bounded config-selector run timed out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
fi
events20c=$(wc -l < "$S20C/events.jsonl" | tr -d ' ')
attfiles20c=$(find "$A20C" -type f 2>/dev/null | wc -l | tr -d ' ')
leasefiles20c=$(find "$D20C" -type f 2>/dev/null | wc -l | tr -d ' ')
strict20c=0
if [ "$loop20c_rc" -eq 1 ] && [ ! -s "$TRACE20C" ] && [ "$events20c" = "0" ] \
   && [ "$attfiles20c" = "0" ] && [ "$leasefiles20c" = "0" ] \
   && [ ! -e "$WORK/s3-config-inert-worker.auth-step-a" ] \
   && [ ! -e "$WORK/s3-config-inert-worker.auth-step-b" ]; then
  strict20c=1
fi
va20c=1; vb20c=1
"$ATT" "$A20C" read auth-step-a --require-valid >/dev/null 2>&1 && va20c=0
"$ATT" "$A20C" read auth-step-b --require-valid >/dev/null 2>&1 && vb20c=0
inert20c_out=$("$PY3" - "$TRACE20C" "$CAP20C" "$D20C" "$PID20C" <<'PY'
import base64,json,os,sys
try:
    lines=[x.rstrip("\n").split("\t") for x in open(sys.argv[1],encoding="utf-8")]
    loop_pid=int(open(sys.argv[4],encoding="ascii").read().strip())
except Exception as e: print("FIXTURE:"+str(e)); raise SystemExit(1)
def argv(x):
    index=4 if x[0] in ("LEASE","LEASE_GUARD_OBSERVATION") else 3
    try: return json.loads(base64.urlsafe_b64decode(x[index]).decode())
    except Exception: return []
lease=[(i,x,argv(x)) for i,x in enumerate(lines) if x[0]=="LEASE"]
acq=[z for z in lease if z[1][1]=="0" and len(z[2])>2 and z[2][1:3]==["acquire","s3-config-inert-resource"]]
if len(acq)!=1 or not acq[0][1][2]: print("ACQUIRE"); raise SystemExit(1)
token=acq[0][1][2]; a=acq[0][2]
if len(a)!=7 or os.path.realpath(a[0])!=os.path.realpath(sys.argv[3]):
    print("ACQUIRE_GRAMMAR:"+repr(a)); raise SystemExit(1)
opts=a[3:]
if set((opts[0],opts[2]))!={"--ttl","--holder-pid"}:
    print("ACQUIRE_OPTIONS:"+repr(a)); raise SystemExit(1)
pairs={opts[0]:opts[1],opts[2]:opts[3]}
try: acq_ok=float(pairs["--ttl"])==600 and int(pairs["--holder-pid"])==loop_pid
except (TypeError,ValueError): acq_ok=False
def grammar(a):
    if a==acq[0][2]: return acq_ok
    return len(a)==4 and os.path.realpath(a[0])==os.path.realpath(sys.argv[3]) \
        and (a[1:]==["renew","s3-config-inert-resource",token]
             or a[1:]==["release","s3-config-inert-resource",token])
drain=[i for i,x in enumerate(lines) if x[0]=="TASKVAL_DRAIN" and len(x)>1 and x[1]=="0"]
renew=[z for z in lease if len(z[2])>1 and z[2][1]=="renew"]
release=[z for z in lease if len(z[2])>1 and z[2][1]=="release"]
post=[z for z in renew if len(drain)==1 and z[0]>drain[0]]
try: cap=json.load(open(sys.argv[2],encoding="utf-8")); rows=cap["observations"]
except Exception as e: print("CAP:"+str(e)); raise SystemExit(1)
cap_ok=(set(cap)=={"kind","lease_root","observations"}
    and cap["kind"]=="h004-process-incarnation-v1"
    and os.path.realpath(cap["lease_root"])==os.path.realpath(sys.argv[3])
    and isinstance(rows,list) and len(rows)==1
    and set(rows[0])=={"host","pid","status","token_b64"}
    and rows[0]["host"]==os.uname().nodename and rows[0]["pid"]==loop_pid
    and rows[0]["status"]=="LIVE"
    and base64.b64decode(rows[0]["token_b64"],validate=True)==b"gate-B-incarnation\x00\xff")
ok=(acq_ok and len(lease)>=3
    and sum(1 for z in lease if len(z[2])>1 and z[2][1]=="acquire")==1
    and all(grammar(z[2]) for z in lease)
    and all(z[1][1]=="0" for z in renew+release)
    and len(drain)==1 and len(post)==1 and len(release)==1
    and post[0][0]<release[0][0] and cap_ok
    and sum(1 for x in lines if x[0]=="CONFIG_BAIT_FLIPPED")==1
    and not any(x[0] in ("CONFIG_BAIT_INIT_FAILED","CONFIG_BAIT_FLIP_FAILED") for x in lines)
    and all("--gate-incarnation-observation" not in z[2] and sys.argv[2] not in z[2] for z in lease))
if not ok:
    print(f"INERT grammar={acq_ok} lease={len(lease)} drain={drain} renew={len(renew)}/{len(post)} release={len(release)} cap={cap_ok}")
    raise SystemExit(1)
print("CONFIG_SELECTOR_INERT_A_TO_B")
PY
); inert20c_rc=$?
if [ "$strict20c" -eq 1 ] \
   || { [ "$loop20c_rc" -eq 0 ] && [ "$va20c" -eq 0 ] && [ "$vb20c" -eq 0 ] \
        && [ "$events20c" = "2" ] && [ -s "$WORK/s3-config-inert-worker.auth-step-a" ] \
        && [ -s "$WORK/s3-config-inert-worker.auth-step-b" ] && [ "$inert20c_rc" -eq 0 ]; }; then
  ok "K20c loop-config capability vägras före effekt eller förblir behaviorally inert A→B"
else
  no "K20c config-selector confinement" "strict/loop/valid/events/inert=$strict20c/$loop20c_rc/$va20c,$vb20c/$events20c/$inert20c_rc evidence=[$inert20c_out]"
fi

# K20d — override-free positive anchor for the production defaults 180/30.
# The worker stays alive across two scheduled ticks. Monotonic timestamps are
# gate evidence only; both the first non-immediate renew and the next cadence
# must land near 30 s, while the acquire argv carries 180. One broad single-
# tick window would incorrectly accept a defaults-only 40 s heartbeat.
SPEC20D="$WORK/s3-default-heartbeat.json"
cat > "$SPEC20D" <<'JSON'
{"spec_version":"s3-default-heartbeat","defaults":{"max_changed_files":8,"max_added_lines":600},"tasks":[{"id":"default-heartbeat-task","slice":0,"title":"D","summary":"D","allowed_write":["tests/lease-authority-fixture/**"],"exit_test":"verify/bin/ingen","exit_criterion":"-","docs_impact":[],"depends_on":[]}]}
JSON
WORKER20D="$WORK/s3-default-heartbeat-worker.py"
cat > "$WORKER20D" <<'PY'
import json,os,sys,time
e=json.load(sys.stdin); task=e["task_id"]
open(os.environ["H004_WORK_MARK"],"w").write("started\n")
time.sleep(75)
os.makedirs("tests/lease-authority-fixture",exist_ok=True)
open("tests/lease-authority-fixture/default-heartbeat-task.txt","w").write(task+"\n")
print(task+" klar")
PY
D20D="$WORK/s3-default-heartbeat-lease"; S20D="$WORK/s3-default-heartbeat-state"
A20D="$WORK/s3-default-heartbeat-att"; W20D="$WORK/s3-default-heartbeat-ws"
TRACE20D="$WORK/s3-default-heartbeat.trace"; C20D="$WORK/s3-default-heartbeat-config.json"
mkdir -p "$W20D"; "$ST" init "$S20D" >/dev/null 2>&1
write_config "$C20D" "$SPEC20D" "$A20D" "$S20D" "$D20D" \
  s3-default-heartbeat-resource "$W20D" "$WORKER20D" s3-default-heartbeat-run 1 0.2
"$PY3" - "$C20D" <<'PY'
import json,sys
p=sys.argv[1]; d=json.load(open(p)); d.pop("lease_ttl_s"); d.pop("lease_heartbeat_s")
d["timeout_s"]=100
json.dump(d,open(p,"w"))
PY
H004_TRACE="$TRACE20D" H004_REAL_LEASE="$REPO_ROOT/controller/lease/cli" \
H004_REAL_ATTEST="$REPO_ROOT/controller/attest/cli" H004_WORK_MARK="$WORK/s3-default-heartbeat.started" \
H004_RUN_PID_FILE="$WORK/s3-default-heartbeat.loop-pid" \
  "$PY3" "$RUN_BOUNDED" 160 "$SHADOW/controller/loop/cli" run "$C20D" \
  >"$WORK/s3-default-heartbeat.out" 2>"$WORK/s3-default-heartbeat.err"
loop20d_rc=$?
if [ "$loop20d_rc" -eq 90 ]; then
  echo "SKIP  K20d harness — bounded default-heartbeat run timed out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
fi
valid20d=1; "$ATT" "$A20D" read default-heartbeat-task --require-valid >/dev/null 2>&1 && valid20d=0
default20d_out=$("$PY3" - "$TRACE20D" "$D20D" "$WORK/s3-default-heartbeat.loop-pid" <<'PY'
import base64,json,os,sys
lines=[x.rstrip("\n").split("\t") for x in open(sys.argv[1])]
def argv(x):
    index=4 if x[0] in ("LEASE","LEASE_GUARD_OBSERVATION") else 3
    try: return json.loads(base64.urlsafe_b64decode(x[index]).decode())
    except Exception: return []
acq=[(i,x) for i,x in enumerate(lines) if x[0]=="LEASE" and x[1]=="0" and argv(x)[1:3]==["acquire","s3-default-heartbeat-resource"]]
if len(acq)!=1 or not acq[0][1][2]:
    print("DEFAULT_ACQUIRE"); raise SystemExit(1)
a=argv(acq[0][1]); token=acq[0][1][2]
try: loop_pid=int(open(sys.argv[3],encoding="ascii").read().strip())
except Exception: print("DEFAULT_LOOP_PID"); raise SystemExit(1)
if len(a)!=7 or os.path.realpath(a[0])!=os.path.realpath(sys.argv[2]) \
   or a[1:3]!=["acquire","s3-default-heartbeat-resource"]:
    print("DEFAULT_ACQUIRE_GRAMMAR:"+repr(a)); raise SystemExit(1)
opts=a[3:]
if set((opts[0],opts[2]))!={"--ttl","--holder-pid"}:
    print("DEFAULT_OPTIONS:"+repr(a)); raise SystemExit(1)
pairs={opts[0]:opts[1],opts[2]:opts[3]}
try: grammar_ok=float(pairs["--ttl"])==180 and int(pairs["--holder-pid"])==loop_pid
except (TypeError,ValueError): grammar_ok=False
if not grammar_ok:
    print("DEFAULT_TTL_HOLDER:"+repr(a)+f" loop={loop_pid}"); raise SystemExit(1)
try: acquired=float(acq[0][1][5])
except Exception: print("ACQUIRE_TIME"); raise SystemExit(1)
writes=[i for i,x in enumerate(lines) if x[0]=="ATTEST" and x[1]=="0" and argv(x)[1:2]==["write-authority"] and argv(x)[2:4]==[token,"default-heartbeat-task"]]
if len(writes)!=1: print("DEFAULT_WRITE"); raise SystemExit(1)
renew=[]
for i,x in enumerate(lines):
    if i>=writes[0] or x[0]!="LEASE" or x[1]!="0" or argv(x)[1:]!=["renew","s3-default-heartbeat-resource",token]: continue
    try: renew.append(float(x[5])-acquired)
    except Exception: print("RENEW_TIME"); raise SystemExit(1)
scheduled=sorted(d for d in renew if d>3)
if len(scheduled)<2 or not 27 <= scheduled[0] <= 34 \
   or not 27 <= scheduled[1]-scheduled[0] <= 34:
    print(f"DEFAULT_HEARTBEAT deltas={renew}"); raise SystemExit(1)
print(f"DEFAULTS=180/30 first={scheduled[0]:.3f} cadence={scheduled[1]-scheduled[0]:.3f}")
PY
); default20d_rc=$?
if [ "$loop20d_rc" -eq 0 ] && [ "$valid20d" -eq 0 ] \
   && [ -s "$WORK/s3-default-heartbeat.started" ] && [ "$default20d_rc" -eq 0 ]; then
  ok "K20d override-free run använder TTL/heartbeat 180/30"
else
  no "K20d default TTL/heartbeat" "loop/valid/trace=$loop20d_rc/$valid20d/$default20d_rc evidence=[$default20d_out]"
fi

# K20b — efter exakt TASKVAL_DRAIN matar gate-wrappern LIVE(B) genom samma
# explicita capability-suffix och verkliga renew-path som K15. Heartbeat ligger
# 300 s bort, sa faulten kan bara vara runnets uttryckliga sista guard.
D20B="$WORK/s3-guard-loss-lease"; S20B="$WORK/s3-guard-loss-state"
A20B="$WORK/s3-guard-loss-att"; W20B="$WORK/s3-guard-loss-ws"
TRACE20B="$WORK/s3-guard-loss.trace"
mkdir -p "$W20B"; "$ST" init "$S20B" >/dev/null 2>&1
write_config "$WORK/s3-guard-loss-config.json" "$SPEC21" "$A20B" "$S20B" "$D20B" \
  "s3-guard-loss-resource" "$W20B" "$WORKER21" "s3-guard-loss-run" 600 300
H004_TRACE="$TRACE20B" H004_REAL_LEASE="$REPO_ROOT/controller/lease/cli" \
H004_REAL_ATTEST="$REPO_ROOT/controller/attest/cli" H004_WORK_MARK="$WORK/s3-guard-loss-worker" \
H004_FINAL_GUARD_FAIL=1 H004_CAP_MAKER="$CAP_MAKER" \
  "$PY3" "$RUN_BOUNDED" 120 "$SHADOW/controller/loop/cli" run "$WORK/s3-guard-loss-config.json" \
  >"$WORK/s3-guard-loss.out" 2>"$WORK/s3-guard-loss.err"
guard20_rc=$?
if [ "$guard20_rc" -eq 90 ]; then
  echo "SKIP  K20b harness — bounded loop timed out"
  echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
fi
ga20=0; gb20=0
"$ATT" "$A20B" read auth-step-a --require-valid >/dev/null 2>&1 || ga20=$?
"$ATT" "$A20B" read auth-step-b --require-valid >/dev/null 2>&1 || gb20=$?
prefix20_out=$("$PY3" "$PREFIX_CHECK" "$TRACE20B" s3-guard-loss-resource \
  auth-step-a,auth-step-b guard 2>&1); prefix20_rc=$?
token20="$prefix20_out"
guards20=$(grep -c '^LEASE_GUARD_OBSERVATION' "$TRACE20B" 2>/dev/null || true)
drains20=$(grep -c '^TASKVAL_DRAIN' "$TRACE20B" 2>/dev/null || true)
mutcap20=$(grep -c '^CAPABILITY_MUTATED' "$TRACE20B" 2>/dev/null || true)
owner20=$("$CLI" "$D20B" owner s3-guard-loss-resource 2>/dev/null || true)
sha20=$(file_sha "$D20B/s3-guard-loss-resource.lease")
cap20_ok=1
"$PY3" - "$TRACE20B.initial-cap.json" "$TRACE20B.final-guard-cap.json" \
  "$D20B" "$TRACE20B.holder" <<'PY' >/dev/null 2>&1 || cap20_ok=0
import base64,json,os,sys
from pathlib import Path
initial,final,root,hp=map(Path,sys.argv[1:]); tokens=[]
for p in (initial,final):
    d=json.loads(p.read_text()); row=d["observations"][0]
    assert not p.resolve().is_relative_to(root.resolve())
    assert set(d)=={"kind","lease_root","observations"}
    assert d["kind"]=="h004-process-incarnation-v1" and Path(d["lease_root"]).resolve()==root.resolve()
    assert len(d["observations"])==1 and set(row)=={"host","pid","status","token_b64"}
    assert row["host"]==os.uname().nodename and row["pid"]==int(hp.read_text()) and row["status"]=="LIVE"
    tokens.append(base64.b64decode(row["token_b64"],validate=True))
assert tokens[0] and tokens[1] and tokens[0]!=tokens[1]
PY
if [ "$guard20_rc" -eq 1 ] && [ "$ga20" -ne 0 ] && [ "$gb20" -ne 0 ] \
   && [ "$prefix20_rc" -eq 0 ] && token_ok "$token20" \
   && [ "$guards20" = "1" ] && [ "$drains20" = "1" ] \
   && [ "$mutcap20" = "0" ] && [ "$cap20_ok" -eq 1 ] \
   && [ -n "$owner20" ] && [ -n "$sha20" ]; then
  ok "K20b incarnation-loss vid final guard ger ingen release/finalize/valid publication"
else
  no "K20b final incarnation guard" "loop/valid/prefix/guard/drain/cap/mut/owner/sha=$guard20_rc/$ga20,$gb20/$prefix20_rc/$guards20/$drains20/$cap20_ok/$mutcap20/[$owner20]/[$sha20] evidence=[$prefix20_out]"
fi
if token_ok "$token20"; then
  "$CLI" "$D20B" release s3-guard-loss-resource "$token20" >/dev/null 2>&1 || true
fi


# K21 — release failure ar clean-finalizationens harda negativa kontroll.
SPECNEG="$WORK/s3-authority-negative.json"
cat > "$SPECNEG" <<'JSON'
{
  "spec_version":"s3-authority-negative",
  "defaults":{"max_changed_files":8,"max_added_lines":600},
  "tasks":[
    {"id":"auth-negative","slice":0,"title":"N","summary":"N","allowed_write":["tests/lease-authority-fixture/**"],"exit_test":"verify/bin/ingen","exit_criterion":"-","docs_impact":[],"depends_on":[]}
  ]
}
JSON

D21F="$WORK/s3-release-fail-lease"; S21F="$WORK/s3-release-fail-state"
A21F="$WORK/s3-release-fail-att"; W21F="$WORK/s3-release-fail-ws"
TRACE21F="$WORK/s3-release-fail.trace"
mkdir -p "$W21F"; "$ST" init "$S21F" >/dev/null 2>&1
write_config "$WORK/s3-release-fail-config.json" "$SPECNEG" "$A21F" "$S21F" "$D21F" \
