"$ST" init "$S19" >/dev/null 2>&1
export S3_WINDOW_MARK="$WORK/s3-window-started"
export S3_WINDOW_GO="$WORK/s3-window-go"
write_config \
  "$WORK/s3-window-config.json" \
  "$WORK/s3-window-backlog.json" \
  "$A19" "$S19" "$D19" "s3-window" "$W19" \
  "$WORK/s3-window-worker.py" \
  "s3-window-run" \
  6 0.5
env \
  NORTROPIC_TEST_MUTATION_BARRIER_COMPONENT=attest \
  NORTROPIC_TEST_MUTATION_BARRIER_OPERATION=finalize-authority \
  NORTROPIC_TEST_MUTATION_BARRIER_PHASE=before-observe \
  NORTROPIC_TEST_MUTATION_BARRIER_DIR="$B19" \
  S3_WINDOW_MARK="$S3_WINDOW_MARK" \
  S3_WINDOW_GO="$S3_WINDOW_GO" \
  "$LOOP" run "$WORK/s3-window-config.json" \
  >"$WORK/s3-window.out" \
  2>"$WORK/s3-window.err" &
p19=$!
started19=0
wait_mark_or_exit "$S3_WINDOW_MARK" "$p19" && started19=1
j19old="$({ "$CLI" "$D19" owner s3-window --json; } 2>/dev/null)"
old19="$(owner_json_field "$j19old" lease_id 2>/dev/null || true)"
: > "$S3_WINDOW_GO"
ready19=0
wait_barrier_ready "$B19" "$p19" && ready19=1
owner19released=1
"$CLI" "$D19" owner s3-window >/dev/null 2>&1 || owner19released=0
new19="$({ "$CLI" "$D19" acquire s3-window --ttl 60 --holder-pid "$$"; } 2>/dev/null)"
new19rc=$?
begin19=1
if [ "$new19rc" -eq 0 ] && token_ok "$new19"; then
  "$ATT" "$A19" begin-authority "$new19" >/dev/null 2>&1
  begin19=$?
fi
sha19before="$(file_sha "$D19/s3-window.lease")"
release_barrier "$B19"
wait "$p19"; run19rc=$?
sha19after="$(file_sha "$D19/s3-window.lease")"
j19new="$({ "$CLI" "$D19" owner s3-window --json; } 2>/dev/null)"
identity19="$(owner_json_field "$j19new" lease_id 2>/dev/null || true)"
valid19=1
att_valid "$A19" s3-window-task && valid19=0
if [ "$started19" -eq 1 ] \
   && [ -n "$old19" ] \
   && [ "$ready19" -eq 1 ] \
   && [ "$owner19released" -eq 0 ] \
   && [ "$new19rc" -eq 0 ] \
   && token_ok "$new19" \
   && [ "$new19" != "$old19" ] \
   && [ "$begin19" -eq 0 ] \
   && [ "$run19rc" -ne 0 ] \
   && [ "$valid19" -ne 0 ] \
   && [ -n "$sha19before" ] \
   && [ "$sha19before" = "$sha19after" ] \
   && [ "$identity19" = "$new19" ]; then
  ok "K19 release→finalize race: successor BEGIN fencar gammal batch och lease överlever"
else
  no "K19 stale finalize/successor" "start/old/ready/released/new/begin/run/valid/identity=$started19/[$old19]/$ready19/$owner19released/$new19rc/$begin19/$run19rc/$valid19/[$identity19] sha=[$sha19before]/[$sha19after]"
fi
if [ "$new19rc" -eq 0 ] && token_ok "$new19"; then
  "$CLI" "$D19" release s3-window "$new19" >/dev/null 2>&1 || true
fi
unset S3_WINDOW_MARK S3_WINDOW_GO


# K20 — release failure är skilt från lease loss: gör katalogen mekaniskt
# icke-skrivbar först efter att holdern och run-authorityn är etablerade. Om
# hosten inte verkställer POSIX-spärren är utfallet ODÖMBART, aldrig product RED.
P20="$WORK/s3-release-permission-probe"
mkdir -p "$P20"
: > "$P20/file"
chmod 0500 "$P20"
if rm "$P20/file" >/dev/null 2>&1; then
  chmod 0700 "$P20"
  echo "SKIP  K20 mekanism — hosten verkställer inte disposable katalogspärr; release-failure är odömbart"
  echo
  echo "$pass PASS, $fail FAIL, ODÖMBART"
  exit 2
fi
chmod 0700 "$P20"
rm -f "$P20/file"

cat > "$WORK/s3-release-failure-backlog.json" <<'JSON'
{
  "spec_version": "s3-fixtur",
  "defaults": {"max_changed_files": 8, "max_added_lines": 600},
  "tasks": [
    {
      "id": "s3-release-failure-task",
      "slice": 0,
      "title": "release failure",
      "summary": "S3 release failure fixture",
      "allowed_write": ["tests/lease-release-failure-fixture/**"],
      "exit_test": "verify/bin/ingen",
      "exit_criterion": "-",
      "docs_impact": [],
      "depends_on": []
    }
  ]
}
JSON
cat > "$WORK/s3-release-failure-worker.py" <<'PYWORK'
import json
import os
import pathlib
import sys
import time

json.load(sys.stdin)
mark = pathlib.Path(os.environ["S3_RELEASE_FAIL_MARK"])
go = pathlib.Path(os.environ["S3_RELEASE_FAIL_GO"])
mark.write_text("started\n", encoding="utf-8")
for _ in range(200):
    if go.exists():
        break
    time.sleep(0.05)
else:
    raise SystemExit("gate did not release worker")
pathlib.Path("tests/lease-release-failure-fixture").mkdir(parents=True, exist_ok=True)
pathlib.Path("tests/lease-release-failure-fixture/result.txt").write_text("release failure\n", encoding="utf-8")
print("release failure fixture klar")
PYWORK

D20="$WORK/s3-release-failure-lease"
S20="$WORK/s3-release-failure-state"
A20="$WORK/s3-release-failure-attest"
W20="$WORK/s3-release-failure-workspaces"
B20="$WORK/s3-release-failure-finalize-barrier"
mkdir -p "$W20" "$B20"
"$ST" init "$S20" >/dev/null 2>&1
export S3_RELEASE_FAIL_MARK="$WORK/s3-release-failure-started"
export S3_RELEASE_FAIL_GO="$WORK/s3-release-failure-go"
write_config \
  "$WORK/s3-release-failure-config.json" \
  "$WORK/s3-release-failure-backlog.json" \
  "$A20" "$S20" "$D20" "s3-release-failure" "$W20" \
  "$WORK/s3-release-failure-worker.py" \
  "s3-release-failure-run" \
  30 10
env \
  NORTROPIC_TEST_MUTATION_BARRIER_COMPONENT=attest \
  NORTROPIC_TEST_MUTATION_BARRIER_OPERATION=finalize-authority \
  NORTROPIC_TEST_MUTATION_BARRIER_PHASE=before-observe \
  NORTROPIC_TEST_MUTATION_BARRIER_DIR="$B20" \
  S3_RELEASE_FAIL_MARK="$S3_RELEASE_FAIL_MARK" \
  S3_RELEASE_FAIL_GO="$S3_RELEASE_FAIL_GO" \
  "$LOOP" run "$WORK/s3-release-failure-config.json" \
  >"$WORK/s3-release-failure.out" \
  2>"$WORK/s3-release-failure.err" &
p20=$!
started20=0
wait_mark_or_exit "$S3_RELEASE_FAIL_MARK" "$p20" && started20=1
j20="$({ "$CLI" "$D20" owner s3-release-failure --json; } 2>/dev/null)"
lease20="$(owner_json_field "$j20" lease_id 2>/dev/null || true)"
chmod 0500 "$D20" 2>/dev/null || true
: > "$S3_RELEASE_FAIL_GO"
timely20=1
wait_process_exit "$p20" && timely20=0
if [ "$timely20" -ne 0 ]; then
  kill "$p20" 2>/dev/null || true
fi
wait "$p20"; run20rc=$?
chmod 0700 "$D20" 2>/dev/null || true
valid20=1
att_valid "$A20" s3-release-failure-task && valid20=0
finalize20=0
[ -e "$B20/ready" ] && finalize20=1
leasefile20=0
[ -f "$D20/s3-release-failure.lease" ] && leasefile20=1
if [ "$started20" -eq 1 ] \
   && [ -n "$lease20" ] \
   && [ "$timely20" -eq 0 ] \
   && [ "$run20rc" -ne 0 ] \
   && [ "$valid20" -ne 0 ] \
   && [ "$finalize20" -eq 0 ] \
   && [ "$leasefile20" -eq 1 ]; then
  ok "K20 release failure: ingen FINALIZE och ingen global publication"
else
  no "K20 release-failure safety" "start/lease/timely/run/valid/finalize/leasefile=$started20/[$lease20]/$timely20/$run20rc/$valid20/$finalize20/$leasefile20"
fi
if [ -n "$lease20" ]; then
  "$CLI" "$D20" release s3-release-failure "$lease20" >/dev/null 2>&1 || true
fi
unset S3_RELEASE_FAIL_MARK S3_RELEASE_FAIL_GO


# K21 — crash efter clean release men före FINALIZE publication-point. Loopen
# startas i egen processgrupp; när finalize-barriären är ready är leasen redan
# tom. Hela gruppen dödas och generationen måste lämna noll giltiga bytes.
D21="$WORK/s3-crash-window-lease"
S21="$WORK/s3-crash-window-state"
A21="$WORK/s3-crash-window-attest"
W21="$WORK/s3-crash-window-workspaces"
B21="$WORK/s3-crash-window-finalize-barrier"
mkdir -p "$W21" "$B21"
"$ST" init "$S21" >/dev/null 2>&1
export S3_WINDOW_MARK="$WORK/s3-crash-window-started"
export S3_WINDOW_GO="$WORK/s3-crash-window-go"
write_config \
  "$WORK/s3-crash-window-config.json" \
  "$WORK/s3-window-backlog.json" \
  "$A21" "$S21" "$D21" "s3-crash-window" "$W21" \
  "$WORK/s3-window-worker.py" \
  "s3-crash-window-run" \
  6 0.5
env \
  NORTROPIC_TEST_MUTATION_BARRIER_COMPONENT=attest \
  NORTROPIC_TEST_MUTATION_BARRIER_OPERATION=finalize-authority \
  NORTROPIC_TEST_MUTATION_BARRIER_PHASE=before-observe \
  NORTROPIC_TEST_MUTATION_BARRIER_DIR="$B21" \
  S3_WINDOW_MARK="$S3_WINDOW_MARK" \
  S3_WINDOW_GO="$S3_WINDOW_GO" \
  "$PY3" -c 'import os,sys; os.setsid(); os.execv(sys.argv[1], sys.argv[1:])' \
  "$LOOP" run "$WORK/s3-crash-window-config.json" \
  >"$WORK/s3-crash-window.out" \
  2>"$WORK/s3-crash-window.err" &
p21=$!
started21=0
wait_mark_or_exit "$S3_WINDOW_MARK" "$p21" && started21=1
: > "$S3_WINDOW_GO"
ready21=0
wait_barrier_ready "$B21" "$p21" && ready21=1
owner21rc=0
"$CLI" "$D21" owner s3-crash-window >/dev/null 2>&1 || owner21rc=$?
kill -KILL -- "-$p21" 2>/dev/null || kill -KILL "$p21" 2>/dev/null || true
wait "$p21" 2>/dev/null || true
valid21=1
att_valid "$A21" s3-window-task && valid21=0
if [ "$started21" -eq 1 ] \
   && [ "$ready21" -eq 1 ] \
   && [ "$owner21rc" -ne 0 ] \
   && [ "$valid21" -ne 0 ]; then
  ok "K21 crash after release/before finalize lämnar noll giltiga publications"
else
  no "K21 release→finalize crash" "start/ready/owner/valid=$started21/$ready21/$owner21rc/$valid21"
fi
unset S3_WINDOW_MARK S3_WINDOW_GO

summera
