import base64,json,os,sys
trace,root,resource=sys.argv[1:4]

def capture(path):
    try: lines=open(path,encoding="utf-8").read().splitlines()
    except FileNotFoundError: lines=[]
    if len(lines)!=1: raise ValueError(f"CALLS={len(lines)}")
    parts=lines[0].split("\t",2)
    payload=json.loads(base64.urlsafe_b64decode(parts[2]).decode())
    a=payload.get("argv") if isinstance(payload,dict) else None
    if not isinstance(a,list) or len(a)!=7 \
       or os.path.realpath(a[0])!=os.path.realpath(root) \
       or a[1:3] != ["acquire",resource]:
        raise ValueError("ARGV="+repr(a))
    opts=a[3:]
    if set((opts[0],opts[2]))!={"--ttl","--holder-pid"}:
        raise ValueError("OPTS="+repr(opts))
    pairs={opts[0]:opts[1],opts[2]:opts[3]}
    try: ok=float(pairs["--ttl"])==1 and int(pairs["--holder-pid"])>0
    except (TypeError,ValueError): ok=False
    if not ok: raise ValueError("VALUES="+repr(pairs))
    normalized={"root":os.path.realpath(a[0]),"verb":a[1],"resource":a[2],
                "ttl":1.0,"holder":"<LOOP_PID>"}
    return normalized

try:
    got=capture(trace)
except Exception as e:
    print(str(e)); raise SystemExit(1)
print("NORMAL_ACQUIRE")
PY

