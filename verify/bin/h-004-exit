trace21_out=$("$PY3" - "$TRACE21" "$PROVIDER_BAIT" "$D21" <<'PYTRACE'
import base64,json,os,sys
try: lines=[x.rstrip("\n").split("\t") for x in open(sys.argv[1])]
except Exception as e:
    print(f"TRACE_ERROR:{e}"); raise SystemExit(2)
def argv(x):
    index=4 if x[0] in ("LEASE","LEASE_GUARD_OBSERVATION") else 3
    try: return json.loads(base64.urlsafe_b64decode(x[index]).decode())
    except Exception: return []
acq=[(i,x) for i,x in enumerate(lines) if x[0]=="LEASE" and x[1]=="0" and len(argv(x))>=3 and argv(x)[1:3]==["acquire","s3-authority-run-resource"]]
if len(acq)!=1 or not acq[0][1][2]: print("ACQUIRE_COUNT"); raise SystemExit(1)
token=acq[0][1][2]
acq_argv=argv(acq[0][1])
try: holder=int(acq_argv[acq_argv.index("--holder-pid")+1])
except Exception: print("HOLDER_PID"); raise SystemExit(1)
lease_calls=[(i,x,argv(x)) for i,x in enumerate(lines) if x[0]=="LEASE"]
def acquire_grammar(a):
    if len(a)!=7 or os.path.realpath(a[0])!=os.path.realpath(sys.argv[3]) \
       or a[1:3]!=["acquire","s3-authority-run-resource"]: return False
    opts=a[3:]
    if opts[0] in (opts[2],) or set((opts[0],opts[2]))!={"--ttl","--holder-pid"}: return False
    pairs={opts[0]:opts[1],opts[2]:opts[3]}
    try: return float(pairs["--ttl"])==1.2 and int(pairs["--holder-pid"])==holder
    except (TypeError,ValueError): return False
def lease_grammar(a):
    if a==acq_argv: return acquire_grammar(a)
    if len(a)==4 and os.path.realpath(a[0])==os.path.realpath(sys.argv[3]):
        return a[1:]==["renew","s3-authority-run-resource",token] \
            or a[1:]==["release","s3-authority-run-resource",token]
    return False
lease_grammar_ok=(len(lease_calls)>=3
    and sum(1 for _,_,a in lease_calls if len(a)>1 and a[1]=="acquire")==1
    and all(lease_grammar(a) for _,_,a in lease_calls))
try: provider=json.load(open(sys.argv[2],encoding="utf-8"))
except Exception as e: print("PROVIDER_CAP:"+str(e)); raise SystemExit(1)
rows=provider.get("observations") if isinstance(provider,dict) else None
provider_ok=(set(provider)=={"kind","lease_root","observations"}
    and provider.get("kind")=="h004-process-incarnation-v1"
    and os.path.realpath(provider.get("lease_root",""))==os.path.realpath(sys.argv[3])
    and isinstance(rows,list) and len(rows)==1
    and set(rows[0])=={"host","pid","status","token_b64"}
    and rows[0].get("host")==os.uname().nodename and rows[0].get("pid")==holder
    and rows[0].get("status")=="LIVE"
    and base64.b64decode(rows[0].get("token_b64",""),validate=True)==b"gate-B-incarnation\x00\xff"
    and sum(1 for x in lines if x[0]=="PROVIDER_BAIT_FLIPPED")==1
    and not any(x[0] in ("PROVIDER_BAIT_INIT_FAILED","PROVIDER_BAIT_FLIP_FAILED") for x in lines))
all_beg=[(i,x) for i,x in enumerate(lines) if x[0]=="ATTEST" and len(argv(x))>=2 and argv(x)[1]=="begin-authority"]
all_writes=[(i,x) for i,x in enumerate(lines) if x[0]=="ATTEST" and len(argv(x))>=2 and argv(x)[1]=="write-authority"]
all_rels=[(i,x) for i,x in enumerate(lines) if x[0]=="LEASE" and len(argv(x))>=2 and argv(x)[1]=="release" and argv(x)[2:3]==["s3-authority-run-resource"]]
all_fins=[(i,x) for i,x in enumerate(lines) if x[0]=="ATTEST" and len(argv(x))>=2 and argv(x)[1]=="finalize-authority"]
authority_reads=[(i,x) for i,x in enumerate(lines) if x[0]=="ATTEST" and x[1]=="0" and "--require-authority" in argv(x)]
beg=[i for i,x in all_beg if x[1]=="0" and argv(x)[1:]==["begin-authority",token]]
writes=[(i,argv(x)) for i,x in all_writes if x[1]=="0"]
reads=[i for i,x in enumerate(lines) if x[0]=="ATTEST" and x[1]=="0" and len(argv(x))==5 and argv(x)[1]=="read" and argv(x)[3:]==["--require-authority",token]]
rels=[i for i,x in all_rels if x[1]=="0" and argv(x)[1:]==["release","s3-authority-run-resource",token]]
fins=[i for i,x in all_fins if x[1]=="0" and argv(x)[1:]==["finalize-authority",token]]
renews=[(i,x) for i,x in enumerate(lines) if x[0]=="LEASE" and argv(x)[1:3]==["renew","s3-authority-run-resource"]]
drains=[i for i,x in enumerate(lines) if x[0]=="TASKVAL_DRAIN" and len(x)>2 and x[1]=="0"]
claims=[i for i,x in enumerate(lines) if x[0]=="TASKVAL_ENTER" and len(x)>1 and x[1].split()[:1]==["claim"]]
enter=[i for i,x in enumerate(lines) if x[0]=="LEASE_RELEASE_ENTER" and len(x)>1 and x[1].endswith(" release s3-authority-run-resource "+token)]
quiet=[i for i,x in enumerate(lines) if x[0]=="LEASE_RELEASE_QUIET_END" and len(x)>1 and x[1].endswith(" release s3-authority-run-resource "+token)]
tasks=[]
for _,args in writes:
    try:
        j=args.index("write-authority"); tasks.append((args[j+1],args[j+2]))
    except Exception: pass
ok=(provider_ok and lease_grammar_ok
    and len(all_beg)==1 and len(all_writes)==2 and len(all_rels)==1 and len(all_fins)==1
    and len(beg)==1 and len(writes)==2 and sorted(tasks)==[(token,"auth-step-a"),(token,"auth-step-b")]
    and reads and len(authority_reads)==len(reads) and claims and len(rels)==1 and len(fins)==1 and len(drains)==1
    and len(enter)==1 and len(quiet)==1 and acq[0][0] < beg[0] < min(claims) and beg[0] < min(reads)
    and renews and max(i for i,_ in writes) < drains[0] < max(i for i,_ in renews) < enter[0] < quiet[0] < rels[0] < fins[0]
    and all(i < rels[0] and x[1]=="0" and argv(x)[-1:]==[token] for i,x in renews)
    and all("--gate-incarnation-observation" not in argv(x) and sys.argv[2] not in argv(x)
            for x in lines if x[0] in ("LEASE","LEASE_GUARD_OBSERVATION")))
if not ok:
    print(f"ORDER_FAIL token={token} begin={beg} claims={claims} writes={tasks} reads={len(reads)} drain={drains} quiet={enter}/{quiet} release={rels} finalize={fins} renew={len(renews)}")
    raise SystemExit(1)
print("TOKEN="+token)
PYTRACE
); trace21_rc=$?

successor21=""; stable21=0
if [ "$loop21_rc" -eq 0 ] && [ "$trace21_rc" -eq 0 ]; then
  successor21=$("$CLI" "$D21" acquire s3-authority-run-resource --ttl 30 --holder-pid "$$" 2>/dev/null)
  successor21_rc=$?
  if [ "$successor21_rc" -eq 0 ] && token_ok "$successor21"; then
    sha21a=$(file_sha "$D21/s3-authority-run-resource.lease")
    sleep 0.8
    sha21b=$(file_sha "$D21/s3-authority-run-resource.lease")
    [ -n "$sha21a" ] && [ "$sha21a" = "$sha21b" ] && stable21=1
    "$CLI" "$D21" release s3-authority-run-resource "$successor21" >/dev/null 2>&1 || true
  fi
fi

# Re-read trace after the successor stability window. A leaked heartbeat that
# survived stop/join would now appear after release; harmless failure calls are
# still forbidden because the frozen sequence stops the heartbeat first.
post_trace21_out=$("$PY3" - "$TRACE21" <<'PY'
import base64,json,sys
try: lines=[x.rstrip("\n").split("\t") for x in open(sys.argv[1])]
except Exception as e: print(f"TRACE_ERROR:{e}"); raise SystemExit(2)
def argv(x):
    index=4 if x[0] in ("LEASE","LEASE_GUARD_OBSERVATION") else 3
    try: return json.loads(base64.urlsafe_b64decode(x[index]).decode())
    except Exception: return []
writes=[i for i,x in enumerate(lines) if x[0]=="ATTEST" and x[1]=="0" and argv(x)[1:2]==["write-authority"]]
renews=[(i,x) for i,x in enumerate(lines) if x[0]=="LEASE" and argv(x)[1:3]==["renew","s3-authority-run-resource"]]
drain=[i for i,x in enumerate(lines) if x[0]=="TASKVAL_DRAIN" and len(x)>2 and x[1]=="0"]
release=[i for i,x in enumerate(lines) if x[0]=="LEASE" and x[1]=="0" and argv(x)[1:3]==["release","s3-authority-run-resource"]]
enter=[i for i,x in enumerate(lines) if x[0]=="LEASE_RELEASE_ENTER" and len(x)>1 and " release s3-authority-run-resource " in (" "+x[1]+" ")]
quiet=[i for i,x in enumerate(lines) if x[0]=="LEASE_RELEASE_QUIET_END" and len(x)>1 and " release s3-authority-run-resource " in (" "+x[1]+" ")]
if not writes or not renews or len(drain)!=1 or len(enter)!=1 or len(quiet)!=1 or len(release)!=1 or not (max(writes)<drain[0]<max(i for i,_ in renews)<enter[0]<quiet[0]<release[0]) or any(i>enter[0] or x[1]!="0" for i,x in renews):
    print(f"FINAL_GUARD_ORDER writes={writes} drain={drain} renews={renews} quiet={enter}/{quiet} release={release}")
    raise SystemExit(1)
print("FINAL_GUARD_BEFORE_RELEASE_NO_POST_RENEW")
PY
); post_trace21_rc=$?

if [ "$loop21_rc" -eq 0 ] && [ "$va21" -eq 0 ] && [ "$vb21" -eq 0 ] \
   && [ "$events21" = "2" ] && [ -s "$WORK/s3-worker.auth-step-a" ] \
   && [ -s "$WORK/s3-worker.auth-step-b" ] && [ "$trace21_rc" -eq 0 ] \
   && [ "$post_trace21_rc" -eq 0 ] && [ "$stable21" -eq 1 ]; then
  ok "K20 loop: one lease_id, final guard + heartbeat join, release then one finalize"
else
  no "K20 run-level authority protocol" "loop/valid/events/trace/postguard/stable=$loop21_rc/$va21,$vb21/$events21/$trace21_rc/$post_trace21_rc/$stable21 evidence=[$trace21_out][$post_trace21_out]"
fi

# K20c — loop-config may reject an unknown selector before every effect, or
# treat it as inert. The inert branch is behavioral, not a first-call proxy:
# a canonical config capability is LIVE(A) at acquire and flips to LIVE(B)
# after provider work. A fixed OS source still completes cleanly; any config-
# selected liveness path loses the mandatory post-drain final guard.
D20C="$WORK/s3-config-inert-lease"; S20C="$WORK/s3-config-inert-state"
A20C="$WORK/s3-config-inert-att"; W20C="$WORK/s3-config-inert-ws"
TRACE20C="$WORK/s3-config-inert.trace"; C20C="$WORK/s3-config-inert.json"
CAP20C="$WORK/s3-config-inert-capability.json"; PID20C="$WORK/s3-config-inert.loop-pid"
