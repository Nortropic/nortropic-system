# Shared non-vacuity oracle for every negative run below. It derives the one
# successful acquire token, then requires successful BEGIN and exact
# authority-bound provisional writes before accepting the injected terminal
# fault. Calls with wrong token or nonzero rc never count as protocol progress.
PREFIX_CHECK="$WORK/check-run-prefix.py"
cat > "$PREFIX_CHECK" <<'PY'
import base64,json,sys
trace,resource,tasks_csv,mode=sys.argv[1:5]
tasks=tasks_csv.split(",") if tasks_csv else []
try: lines=[x.rstrip("\n").split("\t") for x in open(trace,encoding="utf-8")]
except Exception as e: print("TRACE_ERROR:"+str(e)); raise SystemExit(2)

def command(tag,rc,verb):
    found=[]
    for i,x in enumerate(lines):
        if x[0]!=tag or len(x)<2 or x[1]!=str(rc): continue
        index=4 if tag in ("LEASE","LEASE_GUARD_OBSERVATION") else 3
        if len(x)<=index: continue
        try: argv=json.loads(base64.urlsafe_b64decode(x[index]).decode())
        except Exception: continue
        if not isinstance(argv,list) or len(argv)<2 or argv[1]!=verb: continue
        found.append((i,x,argv[2:]))
    return found

def command_any(tag,verb):
    found=[]
    for i,x in enumerate(lines):
        index=4 if tag in ("LEASE","LEASE_GUARD_OBSERVATION") else 3
        if x[0]!=tag or len(x)<=index: continue
        try: argv=json.loads(base64.urlsafe_b64decode(x[index]).decode())
        except Exception: continue
        if not isinstance(argv,list) or len(argv)<2 or argv[1]!=verb: continue
        found.append((i,x,argv[2:]))
    return found

def lease(tag,rc,verb):
    return [z for z in command(tag,rc,verb) if z[2] and z[2][0]==resource]
def attest(tag,rc,verb): return command(tag,rc,verb)

acq=lease("LEASE",0,"acquire")
if len(acq)!=1 or len(acq[0][1])<3 or not acq[0][1][2]:
    print(f"ACQUIRE:{len(acq)}"); raise SystemExit(1)
token=acq[0][1][2]
all_beg=attest("ATTEST",0,"begin-authority")
all_writes=attest("ATTEST",0,"write-authority")
all_successful_finalize=attest("ATTEST",0,"finalize-authority")
beg=[z for z in all_beg if z[2]==[token]]
writes=[]
for z in all_writes:
    tail=z[2]
    if len(tail) in (3,5) and tail[0]==token and tail[1] in tasks:
        writes.append((z,tail[1]))
if len(beg)!=1 or sorted(t for _,t in writes)!=sorted(tasks) or len(writes)!=len(tasks):
    print(f"PREFIX begin={len(beg)} writes={[t for _,t in writes]} token={token}")
    raise SystemExit(1)
if not (acq[0][0] < beg[0][0] < min(z[0][0] for z in writes)):
    print("PREFIX_ORDER"); raise SystemExit(1)
last_write=max(z[0][0] for z in writes)
drains=[i for i,x in enumerate(lines) if x[0]=="TASKVAL_DRAIN" and len(x)>1 and x[1]=="0"]
if len(drains)!=1 or last_write>=drains[0]:
    print(f"DRAIN_ORDER write={last_write} drain={drains}"); raise SystemExit(1)

regular_release_all=lease("LEASE",0,"release")
regular_release=[z for z in regular_release_all if z[2]==[resource,token]]
successful_renew=[z for z in lease("LEASE",0,"renew") if z[2]==[resource,token]]
release_attempts=[z for tag in ("LEASE","LEASE_FAIL","LEASE_RELEASED")
                  for z in command_any(tag,"release") if z[2] and z[2][0]==resource]
renew_attempts=[z for tag in ("LEASE","LEASE_GUARD_OBSERVATION")
                for z in command_any(tag,"renew") if z[2] and z[2][0]==resource]
finalize_attempts=[z for tag in ("ATTEST","ATTEST_FAIL")
                   for z in command_any(tag,"finalize-authority")]
if all_successful_finalize:
    print("UNSAFE_SUCCESSFUL_FINALIZE"); raise SystemExit(1)

if len(all_beg)!=1 or len(all_writes)!=len(tasks):
    print(f"EXTRA_AUTHORITY begin={len(all_beg)} writes={len(all_writes)}"); raise SystemExit(1)

def exact_attempts(tags):
    return sum(1 for x in lines if x[0] in tags)

regular_renew_attempts=[z for z in command_any("LEASE","renew")
                        if z[2] and z[2][0]==resource]
pre_renew=[z for z in successful_renew if z[0] < drains[0]]
pre_renew_attempts=[z for z in renew_attempts if z[0] < drains[0]]
post_renew_attempts=[z for z in renew_attempts if z[0] > drains[0]]
renew_prefix_ok=(len(regular_renew_attempts)==len(successful_renew)
                 and all(z[2]==[resource,token] for z in regular_renew_attempts)
                 and len(pre_renew_attempts)==len(pre_renew))

if mode=="guard":
    all_fault=lease("LEASE_GUARD_OBSERVATION",1,"renew")
    fault=[z for z in all_fault if z[2]==[resource,token]]
    ok=(len(fault)==1 and len(all_fault)==1 and renew_prefix_ok
        and len(post_renew_attempts)==1 and post_renew_attempts[0]==fault[0]
        and not release_attempts and not finalize_attempts
        and not any(z[0] > drains[0] for z in successful_renew)
        and drains[0] < fault[0][0])
elif mode=="release_fail":
    all_fault=lease("LEASE_FAIL",1,"release")
    fault=[z for z in all_fault if z[2]==[resource,token]]
    post=[z for z in successful_renew if z[0] > drains[0]]
    ok=(len(fault)==1 and len(all_fault)==1 and len(release_attempts)==1
        and renew_prefix_ok and len(post_renew_attempts)==1 and len(post)==1
        and post_renew_attempts[0]==post[0] and not finalize_attempts
        and drains[0] < post[0][0] < fault[0][0])
elif mode=="released_barrier":
    all_fault=lease("LEASE_RELEASED",0,"release")
    fault=[z for z in all_fault if z[2]==[resource,token]]
    post=[z for z in successful_renew if z[0] > drains[0]]
    ok=(len(fault)==1 and len(all_fault)==1 and len(release_attempts)==1
        and renew_prefix_ok and len(post_renew_attempts)==1 and len(post)==1
        and post_renew_attempts[0]==post[0] and not finalize_attempts
        and drains[0] < post[0][0] < fault[0][0])
elif mode=="finalize_fail":
    all_fault=attest("ATTEST_FAIL",1,"finalize-authority")
    fault=[z for z in all_fault if z[2]==[token]]
    post=[z for z in successful_renew if z[0] > drains[0]]
    ok=(len(regular_release)==1 and len(regular_release_all)==1 and len(release_attempts)==1
        and len(fault)==1 and len(all_fault)==1 and len(finalize_attempts)==1
        and renew_prefix_ok and len(post_renew_attempts)==1 and len(post)==1
        and post_renew_attempts[0]==post[0]
        and drains[0] < post[0][0] < regular_release[0][0] < fault[0][0])
elif mode=="released_prefix":
    fault=[]
    post=[z for z in successful_renew if z[0] > drains[0]]
    ok=(len(regular_release)==1 and len(regular_release_all)==1 and len(release_attempts)==1
        and renew_prefix_ok and len(post_renew_attempts)==1 and len(post)==1
        and post_renew_attempts[0]==post[0] and not finalize_attempts
        and drains[0] < post[0][0] < regular_release[0][0])
elif mode=="stale_finalize":
    all_fault=[]
    for z in command_any("ATTEST","finalize-authority"):
        try: nonzero=int(z[1][1])!=0
        except (IndexError,ValueError): nonzero=False
        if nonzero: all_fault.append(z)
    fault=[z for z in all_fault if z[2]==[token]]
    post=[z for z in successful_renew if z[0] > drains[0]]
    ok=(len(regular_release)==1 and len(regular_release_all)==1 and len(release_attempts)==1
        and len(fault)==1 and len(all_fault)==1 and len(finalize_attempts)==1
        and renew_prefix_ok and len(post_renew_attempts)==1 and len(post)==1
        and post_renew_attempts[0]==post[0]
        and drains[0] < post[0][0] < regular_release[0][0] < fault[0][0]
        and exact_attempts({"LEASE_GUARD_OBSERVATION","LEASE_FAIL","LEASE_RELEASED","ATTEST_FAIL"})==0)
else:
    print("UNKNOWN_MODE:"+mode); raise SystemExit(2)
if not ok:
    print(f"TERMINAL mode={mode} release={len(regular_release)} fault={len(fault)}")
    raise SystemExit(1)
print(token)
PY

SPEC21="$WORK/s3-authority-loop.json"
cat > "$SPEC21" <<'JSON'
{
  "spec_version":"s3-authority-fixture",
  "defaults":{"max_changed_files":8,"max_added_lines":600},
  "tasks":[
    {"id":"auth-step-a","slice":0,"title":"A","summary":"A","allowed_write":["tests/lease-authority-fixture/**"],"exit_test":"verify/bin/ingen","exit_criterion":"-","docs_impact":[],"depends_on":[]},
    {"id":"auth-step-b","slice":0,"title":"B","summary":"B","allowed_write":["tests/lease-authority-fixture/**"],"exit_test":"verify/bin/ingen","exit_criterion":"-","docs_impact":[],"depends_on":["auth-step-a"]}
  ]
}
JSON

