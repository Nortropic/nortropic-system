envelope = json.load(sys.stdin)
task = envelope["task_id"]
counter = pathlib.Path(os.environ["H004_WORKER_COUNT"])
with counter.open("a", encoding="utf-8") as stream:
    stream.write(task + "\n")

if task.endswith("-b"):
    pathlib.Path(os.environ["H004_B_MARK"]).write_text("started\n", encoding="utf-8")
    release = pathlib.Path(os.environ["H004_B_CONTINUE"])
    for _ in range(200):
        if release.exists():
