#!/usr/bin/env python3.12
"""LOCAL_ONLY document qualification; never a scheduler/H035/resume verdict.

Runs actual candidate Python callables/CLIs only in retained local fixtures.
No historical gate, task-run, customer flow, provider, build or publication.
"""
