    )

    # GR-05: whole-module discovery must see a process boundary inside a
    # lambda, then classify its forwarded argv symmetrically at call sites.
    lambda_needle = '            title: str, changed: list[str]) -> str:\n'
    lambda_codex_mutant = text.replace(
        lambda_needle,
        lambda_needle
        + '    h031_process = lambda command: subprocess.run(command, cwd=str(wt), check=False)\n'
        + '    h031_executable = "".join(("co", "dex"))\n'
        + '    h031_process([h031_executable, "exec", "lambda policy bypass"])\n',
        1,
    )
    lambda_codex_analysis = analyze_launch_graph(lambda_codex_mutant)
    lambda_codex_rejected = not bool(lambda_codex_analysis["boundary_ok"])
    check(
        "K15", lambda_codex_rejected,
        "lambda_dynamic_codex_process={} inventory={} semantics={}".format(
            "REJECTED" if lambda_codex_rejected else "ADMITTED",
            lambda_codex_analysis["global_process_sites"],
            lambda_codex_analysis["lambda_call_classifications"],
        ),
    )

    lambda_non_codex_mutant = text.replace(
        lambda_needle,
        lambda_needle
        + '    h031_process = lambda command: subprocess.run(command, cwd=str(wt), check=False)\n'
        + '    h031_executable = "".join(("g", "h"))\n'
        + '    h031_process([h031_executable, "--version"])\n',
        1,
    )
    lambda_non_codex_analysis = analyze_launch_graph(lambda_non_codex_mutant)
    lambda_non_codex_admitted = all((
        bool(lambda_non_codex_analysis["boundary_ok"]),
        bool(lambda_non_codex_analysis["paths_ok"]),
        bool(lambda_non_codex_analysis["observer_clean"]),
    ))
    check(
        "K16", lambda_non_codex_admitted,
        "lambda_dynamic_non_codex_process={} semantics={}".format(
            "ADMITTED" if lambda_non_codex_admitted else "REJECTED",
            lambda_non_codex_analysis["lambda_call_classifications"],
        ),
    )

    # A module-level comprehension is neither FunctionDef, class method nor
    # lambda. Its native process site must nevertheless enter the inventory.
    comprehension_mutant = text + '''
H031_PROCESS_PROBE = [
    subprocess.call(["".join(("co", "dex")), "exec", "expression bypass"])
    for _h031_item in (0,)
]
'''
    comprehension_analysis = analyze_launch_graph(comprehension_mutant)
    comprehension_rejected = not bool(comprehension_analysis["boundary_ok"])
    check(
        "K17", comprehension_rejected,
        "additional_ast_shape_codex_process={} inventory={} semantics={}".format(
            "REJECTED" if comprehension_rejected else "ADMITTED",
            comprehension_analysis["global_process_sites"],
            comprehension_analysis["global_semantic_violations"],
        ),
    )

    lambda_unknown_mutant = text.replace(
        lambda_needle,
        lambda_needle
        + '    h031_process = lambda command: subprocess.run(command, cwd=str(wt), check=False)\n'
        + '    h031_executable = os.environ.get("H031_UNKNOWN_EXECUTABLE")\n'
        + '    h031_process([h031_executable, "exec", "unresolved lambda command"])\n',
        1,
    )
    lambda_unknown_analysis = analyze_launch_graph(lambda_unknown_mutant)
    lambda_unknown_rejected = not bool(lambda_unknown_analysis["boundary_ok"])
    check(
        "K18", lambda_unknown_rejected,
        "unresolved_dynamic_executable={} semantics={}".format(
            "REJECTED" if lambda_unknown_rejected else "ADMITTED",
            lambda_unknown_analysis["lambda_call_classifications"],
        ),
    )

    # Function defaults execute outside the function body and were a plausible
    # residual hole in body-driven discovery. The global inventory must own it.
    default_expression_mutant = text + '''
def h031_default_expression_probe(
    result=subprocess.call(["".join(("co", "dex")), "exec", "default bypass"])
):
    return result
'''
    default_expression_analysis = analyze_launch_graph(default_expression_mutant)
    default_expression_rejected = not bool(default_expression_analysis["boundary_ok"])
    check(
        "K19", default_expression_rejected,
        "function_default_expression_codex_process={} inventory={} semantics={}".format(
            "REJECTED" if default_expression_rejected else "ADMITTED",
            default_expression_analysis["global_process_sites"],
            default_expression_analysis["global_semantic_violations"],
        ),
    )

except Exception as exc:
    print(f"ODÖMBART K0 — gate harness exception: {type(exc).__name__}: {exc}")
    traceback.print_exc()
    sys.exit(2)

passed = 0
failed = 0
for key, ok, detail in checks:
    if ok:
        passed += 1
        print(f"PASS  {key} — {detail}")
    else:
        failed += 1
        print(f"FAIL  {key} — {detail}")
print(f"\n{passed} PASS, {failed} FAIL")
sys.exit(0 if failed == 0 else 1)
PY
rc=$?

case "$rc" in
  0|1) exit "$rc" ;;
  *) exit 2 ;;
esac
