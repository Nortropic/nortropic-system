#!/usr/bin/env bash
# h-031-exit — explicit Codex routing through one canonical launch boundary
#
# Frozen process-boundary contract:
#   * run_codex owns the only permitted subprocess.Popen site.
#   * run owns the only permitted subprocess.run site and must reject every
#     executable whose basename is "codex" before subprocess.run is reached.
#   * watch may retain the literal, non-agent os.system("clear") site.
#   * every other native process site and every alias of subprocess/os process
#     capabilities is forbidden. This is an intentional security-relevant
#     source-shape restriction, not a general Python dataflow analysis.
#
# Predicted controls before execution:
#   direct/module-alias/lambda/stored-lambda/key-alias/assignment-alias Codex
#     -> structural boundary FAIL
#   unknown executable through run -> admitted only when run's runtime guard
#     demonstrably rejects a Codex basename before spawn
#   ordinary gh through run -> admitted and reaches subprocess.run
#   harmless role-call consolidation -> admitted

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "ODÖMBART K0 — ingen git-reporot"
  exit 2
}
SOURCE="$ROOT/scripts/nortropic-codex-autopilot.py"
SCHEMA="$ROOT/docs/loop/codex-autopilot-report.schema.json"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/nortropic-h031.XXXXXX")" || {
  echo "ODÖMBART K0 — temp-katalog kunde inte skapas"
  exit 2
}
cleanup() { rm -rf "$WORK"; }
trap cleanup EXIT HUP INT TERM

if [ ! -f "$SOURCE" ] || [ ! -f "$SCHEMA" ]; then
  echo "ODÖMBART K0 — källa eller rapportschema saknas"
  exit 2
fi

python3 - "$SOURCE" "$SCHEMA" "$WORK" <<'PY'
from __future__ import annotations

import ast
import importlib.util
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import traceback

source, schema_source, work = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
EXPECTED = {
    "ARCHITECT": ("gpt-5.6-sol", "max"),
    "TEST_AUTHOR": ("gpt-5.6-sol", "max"),
    "GATE_REVIEWER": ("gpt-5.6-sol", "max"),
    "BUILDER": ("gpt-5.6-sol", "high"),
    "REVIEWER": ("gpt-5.6-sol", "max"),
    "EMPIRICAL": ("gpt-5.6-sol", "max"),
}
ROUTING_SOURCE = "AUTOPILOT_ROLE_POLICY"
PROCESS_ATTRS = {
    "subprocess": {"Popen", "run", "call", "check_call", "check_output", "getoutput", "getstatusoutput"},
    "os": {"system", "popen", "posix_spawn", "posix_spawnp", "execv", "execve", "execvp", "execvpe", "spawnl", "spawnle", "spawnlp", "spawnlpe", "spawnv", "spawnve", "spawnvp", "spawnvpe"},
    "asyncio": {"create_subprocess_exec", "create_subprocess_shell"},
    "pty": {"spawn"},
}
checks: list[tuple[str, bool, str]] = []


def check(key: str, ok: bool, detail: str) -> None:
    checks.append((key, ok, detail))


def sh(*argv: str, cwd: Path | None = None) -> str:
    p = subprocess.run(list(argv), cwd=str(cwd) if cwd else None, text=True,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if p.returncode:
        raise RuntimeError(f"command rc={p.returncode}: {' '.join(argv)}\n{p.stdout}")
    return p.stdout


def owner_map(tree: ast.Module) -> dict[ast.AST, str]:
    owners: dict[ast.AST, str] = {}
    def walk(node: ast.AST, owner: str = "<module>", cls: str = "") -> None:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            owner = f"{cls}.{node.name}" if cls else node.name
        elif isinstance(node, ast.Lambda):
            owner = f"<lambda@{getattr(node, 'lineno', 0)}>"
        next_cls = f"{cls}.{node.name}".strip(".") if isinstance(node, ast.ClassDef) else cls
        owners[node] = owner
        for child in ast.iter_child_nodes(node):
            walk(child, owner, next_cls)
    walk(tree)
    return owners


def process_shape(text: str) -> dict[str, object]:
    tree = ast.parse(text)
    owners = owner_map(tree)
    funcs = {n.name for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}
    sites: list[tuple[str, str, int, str]] = []
    forbidden_aliases: list[tuple[str, int, str]] = []
    calls: dict[str, set[str]] = {name: set() for name in funcs}

    for node in ast.walk(tree):
        if isinstance(node, (ast.Assign, ast.AnnAssign)) and node.value is not None:
            value = node.value
            risky = False
            rendered = ast.unparse(value)
            if isinstance(value, ast.Name) and value.id in PROCESS_ATTRS:
                risky = True
            if (isinstance(value, ast.Attribute) and isinstance(value.value, ast.Name)
                    and value.value.id in PROCESS_ATTRS
                    and value.attr in PROCESS_ATTRS[value.value.id]):
                risky = True
            if risky:
                forbidden_aliases.append((owners[node], node.lineno, rendered))
        if not isinstance(node, ast.Call):
            continue
        owner = owners[node]
        if isinstance(node.func, ast.Name) and owner in calls and node.func.id in funcs:
            calls[owner].add(node.func.id)
        if not (isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name)):
            continue
        module, attr = node.func.value.id, node.func.attr
        if module not in PROCESS_ATTRS or attr not in PROCESS_ATTRS[module]:
            continue
        literal = ""
        if node.args and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str):
            literal = node.args[0].value
        sites.append((owner, f"{module}.{attr}", node.lineno, literal))

    allowed = []
    violations = []
    counts = {"run": 0, "run_codex": 0, "clear": 0}
    for site in sites:
        owner, name, _line, literal = site
        if owner == "run" and name == "subprocess.run":
            counts["run"] += 1; allowed.append(site)
        elif owner == "run_codex" and name == "subprocess.Popen":
            counts["run_codex"] += 1; allowed.append(site)
        elif owner == "watch" and name == "os.system" and literal == "clear":
            counts["clear"] += 1; allowed.append(site)
        else:
            violations.append(site)
    exact = counts == {"run": 1, "run_codex": 1, "clear": 1}

    def reachable(start: str) -> set[str]:
        seen, todo = set(), [start]
        while todo:
            cur = todo.pop()
            if cur in seen: continue
            seen.add(cur); todo.extend(calls.get(cur, ()))
        return seen
    observer_hits = {name: sorted(reachable(name) & {"run_codex"})
                     for name in ("status", "watch", "roadmap_status")}
    observer_hits = {k: v for k, v in observer_hits.items() if v}
    return {"tree": tree, "funcs": funcs, "sites": sites, "aliases": forbidden_aliases,
            "violations": violations, "exact": exact,
            "boundary_ok": exact and not violations and not forbidden_aliases,
            "observer_ok": not observer_hits, "observer_hits": observer_hits}


def resolved_route(argv: list[str]) -> tuple[str, str]:
    model, effort, i = "user-config-other-model", "ultra", 0
    while i < len(argv):
        arg = argv[i]
        if arg in {"-m", "--model"} and i + 1 < len(argv): model, i = argv[i + 1], i + 2; continue
        if arg.startswith("--model="): model = arg.split("=", 1)[1]
        value = None
        if arg in {"-c", "--config"} and i + 1 < len(argv): value, i = argv[i + 1], i + 1
        elif arg.startswith("--config="): value = arg.split("=", 1)[1]
        if value and "=" in value and value.split("=", 1)[0].strip() == "model_reasoning_effort":
            effort = value.split("=", 1)[1].strip().strip("\"'")
        i += 1
    return model, effort


try:
    text = source.read_text(encoding="utf-8")
    shape = process_shape(text)
    required = {"run", "run_codex", "status", "watch", "roadmap_status", "journal_root"}
    check("K0", required <= shape["funcs"], f"required_api={sorted(required & shape['funcs'])}")
    check("K1", bool(shape["boundary_ok"]),
          f"sites={shape['sites']} aliases={shape['aliases']} violations={shape['violations']} exact={shape['exact']}")
    check("K1O", bool(shape["observer_ok"]), f"observer_hits={shape['observer_hits']}")

    repo = work / "repo"; repo.mkdir()
    sh("git", "init", "-q", cwd=repo)
    sh("git", "config", "user.name", "h031-gate", cwd=repo)
    sh("git", "config", "user.email", "h031-gate@nortropic.invalid", cwd=repo)
    schema = repo / "docs/loop/codex-autopilot-report.schema.json"; schema.parent.mkdir(parents=True)
    shutil.copyfile(schema_source, schema)
    (repo / "anchor.txt").write_text("h031\n", encoding="utf-8")
    sh("git", "add", ".", cwd=repo); sh("git", "commit", "-qm", "fixture", cwd=repo)

    fakebin = work / "fakebin"; fakebin.mkdir()
    capture = work / "codex-argv.jsonl"; fake = fakebin / "codex"
    fake.write_text("""#!/usr/bin/env python3
import json, os, pathlib, re, sys
argv=sys.argv[1:]
with pathlib.Path(os.environ['H031_CAPTURE']).open('a') as f: f.write(json.dumps(argv)+'\\n')
out=pathlib.Path(argv[argv.index('-o')+1]); m=re.search(r'H031_GATE_ROLE=([A-Z_]+)', argv[-1]); role=m.group(1) if m else 'OVERIFIERAT'
out.write_text(json.dumps({'role':role,'outcome':'READY','owner_decision_required':False,'blocking_findings':[]}))
print(json.dumps({'type':'thread.started','thread_id':'h031-'+role.lower()}))
""", encoding="utf-8")
    fake.chmod(fake.stat().st_mode | stat.S_IXUSR)
    codex_home = work / "codex-home"; codex_home.mkdir()
    (codex_home / "config.toml").write_text('model="other"\nmodel_reasoning_effort="ultra"\n')
    os.environ.update(PATH=str(fakebin)+os.pathsep+os.environ.get("PATH", ""), CODEX_HOME=str(codex_home), H031_CAPTURE=str(capture))
    spec = importlib.util.spec_from_file_location("h031_subject", source)
    if spec is None or spec.loader is None: raise RuntimeError("cannot import subject")
    module = importlib.util.module_from_spec(spec); sys.modules[spec.name] = module; spec.loader.exec_module(module)

    journal_file = module.journal_root(repo) / "events.jsonl"
    old = {"ts":"2026-01-01T00:00:00+00:00","event":"AGENT_START","role":"BUILDER","model":"legacy","reasoning_effort":"ultra","model_routing_source":"USER_CONFIG"}
    journal_file.write_text(json.dumps(old, sort_keys=True)+"\n")
    errors=[]
    for role in EXPECTED:
        try: module.run_codex(repo, repo, role, f"H031_GATE_ROLE={role}")
        except Exception as exc: errors.append(f"{role}:{type(exc).__name__}:{exc}")
    captures=[json.loads(x) for x in capture.read_text().splitlines()] if capture.exists() else []
    routes=[resolved_route(x) for x in captures]
    check("K2", not errors and routes == list(EXPECTED.values()), f"routes={routes} errors={errors}")
    records=[json.loads(x) for x in journal_file.read_text().splitlines() if x.strip()]
    starts=[r for r in records[1:] if r.get("event")=="AGENT_START"]
    journal_ok=len(starts)==len(EXPECTED) and all(
        r.get("role")==role and (r.get("model"),r.get("reasoning_effort"))==EXPECTED[role]
        and r.get("model_routing_source")==ROUTING_SOURCE for r,role in zip(starts,EXPECTED))
    check("K3", journal_ok, f"AGENT_START={starts}")
    before=(len(captures), len(list((module.journal_root(repo)/"runs").glob("*"))), len(records))
    unknown_error="NO_ERROR"
    try: module.run_codex(repo, repo, "UNKNOWN_ROLE", "H031_GATE_ROLE=UNKNOWN_ROLE")
    except Exception as exc: unknown_error=f"{type(exc).__name__}:{exc}"
    after_caps=[json.loads(x) for x in capture.read_text().splitlines()] if capture.exists() else []
    after_records=[json.loads(x) for x in journal_file.read_text().splitlines() if x.strip()]
    after=(len(after_caps), len(list((module.journal_root(repo)/"runs").glob("*"))), len(after_records))
    check("K4", unknown_error!="NO_ERROR" and before==after, f"error={unknown_error} effects={before}->{after}")
    check("K5", after_records[0]==old and all(r.get("reasoning_effort")!="ultra" for r in after_records[1:]),
          f"old_preserved={after_records[0]==old}")

    # The generic boundary is judged by effect: Codex basename must fail before
    # subprocess.run; ordinary non-Codex and unknown-at-source commands remain usable.
    real_run = module.subprocess.run; spawned=[]
    class ProcessResult:
        returncode = 0
        stdout = "ok"
    def process_stub(argv, **kwargs): spawned.append(list(argv)); return ProcessResult()
    module.subprocess.run = process_stub
    codex_results=[]
    for executable in ("codex", "/usr/local/bin/codex"):
        try: module.run([executable, "exec"]); codex_results.append("ADMITTED")
        except Exception: codex_results.append("REJECTED")
    codex_spawned=list(spawned); spawned.clear()
    gh_error=""
    try: module.run(["gh", "--version"])
    except Exception as exc: gh_error=f"{type(exc).__name__}:{exc}"
    module.subprocess.run = real_run
    check("K6", codex_results==["REJECTED","REJECTED"] and not codex_spawned,
          f"codex={codex_results} spawned={codex_spawned}")
    check("K7", not gh_error and spawned==[["gh","--version"]], f"error={gh_error} spawned={spawned}")

    insertion='def status(repo: Path, wt_root: Path) -> None:\n'
    if insertion not in text: raise RuntimeError("mutant insertion anchor missing")
    def verdict(extra: str) -> bool:
        return not bool(process_shape(text.replace(insertion, extra+"\n"+insertion, 1))["boundary_ok"])
    controls = {
        "K8": 'def h031_direct():\n    return subprocess.run(["codex", "exec"])',
        "K9": 'def h031_alias():\n    p = subprocess\n    return p.run(["codex", "exec"])',
        "K10": 'def h031_lambda():\n    f = lambda a: subprocess.run(a)\n    return f(["codex", "exec"])',
        "K11": 'def h031_stored():\n    d = {"x": lambda a: subprocess.run(a)}\n    return d["x"](["codex", "exec"])',
        "K12": 'def h031_key():\n    key = "x"\n    d = {"x": lambda a: subprocess.run(a)}\n    return d[key](["codex", "exec"])',
        "K13": 'def h031_chain():\n    p = subprocess\n    d = {"x": lambda a: p.run(a)}\n    key = "x"\n    return d[key](["co"+"dex", "exec"])',
        "K14": 'def h031_unknown(a):\n    return subprocess.run(a)',
    }
    for key, mutant in controls.items(): check(key, verdict(mutant), "REJECTED_BY_STRUCTURAL_BOUNDARY")

    # Harmless topology refactor: an extra helper around role launch adds no
    # process boundary or process alias and therefore remains admissible.
    harmless = 'def h031_role_helper(*args, **kwargs):\n    return run_codex_resolving_architecture(*args, **kwargs)'
    harmless_shape=process_shape(text.replace(insertion, harmless+"\n"+insertion,1))
    check("K15", bool(harmless_shape["boundary_ok"]), f"violations={harmless_shape['violations']} aliases={harmless_shape['aliases']}")
    check("K16", resolved_route(["-m","gpt-5.6-sol","-c",'model_reasoning_effort="high"'])==EXPECTED["BUILDER"], "parser positive anchor")
    check("K17", resolved_route([])!=EXPECTED["ARCHITECT"], "journal-only/implicit config cannot satisfy argv oracle")
except Exception as exc:
    print(f"ODÖMBART K0 — gate harness exception: {type(exc).__name__}: {exc}")
    traceback.print_exc(); sys.exit(2)

passed=sum(ok for _,ok,_ in checks); failed=len(checks)-passed
for key,ok,detail in checks: print(f"{'PASS ' if ok else 'FAIL '} {key} — {detail}")
print(f"\n{passed} PASS, {failed} FAIL")
sys.exit(0 if failed==0 else 1)
PY
rc=$?
case "$rc" in 0|1) exit "$rc" ;; *) exit 2 ;; esac
