class DuplicateKey(ValueError):
    pass


class ProductFailure(RuntimeError):
    pass


def effect_guard(effects, name):
    def reject(*args, **kwargs):
        effects.append((name, repr(args[:3]), sorted(kwargs)))
        raise ProductFailure(f"guarded pre-role effect: {name}")
    return reject


def install_effect_guards(effects):
    saved = []
    for name in sorted(GUARDED_OS_NAMES):
        function = getattr(os, name, None)
        if callable(function):
            saved.append((os, name, function))
            setattr(os, name, effect_guard(effects, "os." + name))
    saved.append((subprocess, "Popen", subprocess.Popen))
    subprocess.Popen = effect_guard(effects, "subprocess.Popen")
    saved.append((fcntl, "flock", fcntl.flock))
    fcntl.flock = effect_guard(effects, "fcntl.flock")
    for name in ("fcntl", "ioctl"):
        function = getattr(fcntl, name, None)
        if callable(function):
            saved.append((fcntl, name, function))
            setattr(fcntl, name, effect_guard(effects, "fcntl." + name))
    return saved


def restore_effect_guards(saved):
    for target, name, function in reversed(saved):
        setattr(target, name, function)


def measure_umask():
    value = os.umask(0o077)
    os.umask(value)
    return value


def audit_effect_hook(active, effects):
    write_flags = os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND
    def hook(event, args):
        if not active[0]:
            return
        forbidden = event in AUDIT_MUTATION_EVENTS
        if event == "open":
            mode = args[1] if len(args) > 1 else None
            flags = args[2] if len(args) > 2 else 0
            forbidden = ((isinstance(mode, str) and any(char in mode for char in "wax+"))
                         or (isinstance(flags, int) and flags & write_flags))
        if forbidden:
            effects.append((event, repr(args[:3])))
            raise ProductFailure(f"forbidden pre-role effect: {event}")
    return hook


def strict_json(raw: str):
    def pairs(items):
        out = {}
        for key, value in items:
            if key in out:
                raise DuplicateKey(key)
            out[key] = value
        return out
    return json.loads(raw, object_pairs_hook=pairs)


OWNER_CALL_RESULT_KEYS = {
    "schema_version", "nonce", "purpose", "mode", "plan_sha256",
    "plan_dev", "plan_ino", "helper_sha256", "argv", "cwd",
    "returncode", "timed_out", "stdout_b64", "stderr_b64",
    "stdout_sha256", "stderr_sha256", "environment_sha256", "tracked_processes",
    "executable_dev", "executable_ino", "tracker_backend", "family_quiescent",
}

def owner_executable_binding(path: Path):
    observed=path.stat()
    return {"executable_dev":observed.st_dev,"executable_ino":observed.st_ino}


def atomic_owner_json(path: Path, value) -> bytes:
    raw=json.dumps(value,sort_keys=True,separators=(",", ":")).encode("utf-8")
    temporary=path.with_name(path.name+".tmp-"+os.urandom(16).hex())
    fd=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL
               |getattr(os,"O_NOFOLLOW",0),0o600)
    try:
        offset=0
        while offset<len(raw): offset+=os.write(fd,raw[offset:])
        os.fsync(fd)
    finally: os.close(fd)
    try: os.link(temporary,path,follow_symlinks=False)
    finally: os.unlink(temporary)
    parent_fd=os.open(path.parent,os.O_RDONLY|getattr(os,"O_DIRECTORY",0))
    try: os.fsync(parent_fd)
    finally: os.close(parent_fd)
    return raw


def stable_owner_json(path: Path, maximum: int=20*1024*1024):
    fd=os.open(path,os.O_RDONLY|getattr(os,"O_NOFOLLOW",0))
    try:
        before=os.fstat(fd);raw=b""
        if not stat.S_ISREG(before.st_mode) or before.st_nlink!=1:
            raise RuntimeError("owner-call object is not private regular nlink-one")
        while len(raw)<=maximum:
            chunk=os.read(fd,min(65536,maximum+1-len(raw)))
            if not chunk: break
            raw+=chunk
        after=os.fstat(fd)
        identity=lambda item:(item.st_dev,item.st_ino,item.st_mode,item.st_nlink,
                              item.st_size,item.st_mtime_ns,item.st_ctime_ns)
        if len(raw)>maximum or len(raw)!=before.st_size or identity(before)!=identity(after):
            raise RuntimeError("owner-call object unstable or oversized")
        return raw,before,strict_json(raw.decode("utf-8",errors="strict"))
    finally: os.close(fd)


def owner_call_result_valid(value, plan, plan_raw: bytes, plan_stat) -> bool:
    if not isinstance(value,dict) or set(value)!=OWNER_CALL_RESULT_KEYS:
        return False
    try:
        stdout=base64.b64decode(value.get("stdout_b64",""),validate=True)
        stderr=base64.b64decode(value.get("stderr_b64",""),validate=True)
    except Exception:
        return False
    return (value.get("schema_version")==1
        and value.get("nonce")==plan.get("nonce")
        and value.get("purpose")==plan.get("purpose")
        and value.get("mode")==plan.get("mode")
        and value.get("plan_sha256")==hashlib.sha256(plan_raw).hexdigest()
        and value.get("plan_dev")==plan_stat.st_dev
        and value.get("plan_ino")==plan_stat.st_ino
        and value.get("helper_sha256")==owner_live_helper_sha256
        and value.get("executable_dev")==plan.get("executable_dev")
        and value.get("executable_ino")==plan.get("executable_ino")
        and value.get("argv")==plan.get("argv")
        and value.get("cwd")==plan.get("cwd")
        and type(value.get("returncode")) is int
        and type(value.get("timed_out")) is bool
        and value.get("stdout_sha256")==hashlib.sha256(stdout).hexdigest()
        and value.get("stderr_sha256")==hashlib.sha256(stderr).hexdigest()
        and value.get("environment_sha256")==hashlib.sha256(json.dumps(
            plan.get("environment"),sort_keys=True,separators=(",", ":")).encode()).hexdigest()
        and value.get("tracked_processes") is None
        and value.get("tracker_backend")=="product-owned"
        and value.get("family_quiescent") is None
        and value.get("timed_out") is False)


def check(key: str, ok: bool, detail: str) -> None:
    checks.append((key, bool(ok), detail))


def odombart(key: str, detail: str) -> None:
    print(f"ODÖMBART {key} — {detail}")
    raise SystemExit(2)


