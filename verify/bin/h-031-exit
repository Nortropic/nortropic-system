#!/usr/bin/env bash
# h-031-exit — explicit Codex-modellrouting per faktisk autopilotroll
#
# MUTANTPREDIKTION (före produktionsimplementation):
#   M01 journalen påstår rätt modell men argv saknar explicit routing   -> K2
#   M02 alla roller får max                                            -> K2 (BUILDER)
#   M03 okänd roll faller tillbaka till en default                      -> K4
#   M04 äldre persisted ultra återanvänds                               -> K2/K5
#   M05 klassmetod startar Codex utanför gemensam spawnpunkt             -> K1/K8
#   M06 observer når process via helper→metod→self.metod                  -> K6/K9
#   M07 argv är rätt men journalens källa/fält saknas                    -> K3
#   M08 publish bygger Codex-argv dynamiskt och anropar generic run       -> K1/K11
#   M09 publish skickar statiskt olöst ambient argv till generic run      -> K1/K13
#   M10 generic processwrapper smyger in ett andra Codex-spawn            -> K1/K14
#   M11 lambda vidarebefordrar dynamiskt byggd Codex-argv till process   -> K1/K15
#   M12 process-site i modulkomprehension startar dynamisk Codex         -> K1/K17
#   M13 lambda-process får ett olöst exekverbart kommando                 -> K1/K18
#   M14 process-site i ett funktionsdefaultsuttryck startar Codex         -> K1/K19
#   V01 upprepade rollcalls samlas bakom en helper utan effektändring    -> K10 PASS
#   V02 publish använder generic run för bevisat icke-Codex-kommando     -> K12 PASS
#   V03 samma lambda-process får bevisat icke-Codex-kommando              -> K16 PASS
#
# Provet använder en falsk codex-binär. Den fångar den faktiskt exekverade
# argv-listan och skriver en minimal giltig agentrapport. Därmed dömer K2
# launch-effekten, inte källkodens påståenden. En avsiktligt motstridig
# CODEX_HOME-konfiguration (annan modell + ultra) är startvärdet.

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "ODÖMBART K0 — ingen git-reporot"
  exit 2
}
SOURCE="$ROOT/scripts/nortropic-codex-autopilot.py"
SCHEMA="$ROOT/docs/loop/codex-autopilot-report.schema.json"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/nortropic-h031.XXXXXX")" || {
  echo "ODÖMBART K0 — temp-katalog kunde inte skapas"
  exit 2
}
cleanup() {
  rm -rf "$WORK"
}
trap cleanup EXIT HUP INT TERM

if [ ! -f "$SOURCE" ] || [ ! -f "$SCHEMA" ]; then
  echo "ODÖMBART K0 — källa eller rapportschema saknas"
  exit 2
fi

python3 - "$SOURCE" "$SCHEMA" "$WORK" <<'PY'
from __future__ import annotations

import ast
import importlib.util
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import traceback

source = Path(sys.argv[1]).resolve()
schema_source = Path(sys.argv[2]).resolve()
work = Path(sys.argv[3]).resolve()

EXPECTED = {
    "ARCHITECT": ("gpt-5.6-sol", "max"),
    "TEST_AUTHOR": ("gpt-5.6-sol", "max"),
    "GATE_REVIEWER": ("gpt-5.6-sol", "max"),
    "BUILDER": ("gpt-5.6-sol", "high"),
    "REVIEWER": ("gpt-5.6-sol", "max"),
    "EMPIRICAL": ("gpt-5.6-sol", "max"),
}
ROUTING_SOURCE = "AUTOPILOT_ROLE_POLICY"
checks: list[tuple[str, bool, str]] = []


def check(key: str, ok: bool, detail: str) -> None:
    checks.append((key, ok, detail))


def sh(*argv: str, cwd: Path | None = None) -> str:
    p = subprocess.run(
        list(argv), cwd=str(cwd) if cwd else None, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
    )
    if p.returncode != 0:
        raise RuntimeError(f"command rc={p.returncode}: {' '.join(argv)}\n{p.stdout}")
    return p.stdout


def call_name(node: ast.Call) -> str:
    f = node.func
    if isinstance(f, ast.Name):
        return f.id
    if isinstance(f, ast.Attribute) and isinstance(f.value, ast.Name):
        return f"{f.value.id}.{f.attr}"
    return ""


PROCESS_CALLS = {
    "subprocess.Popen", "subprocess.run", "subprocess.call",
    "subprocess.check_call", "subprocess.check_output",
    "subprocess.getoutput", "subprocess.getstatusoutput",
    "os.system", "os.popen", "os.posix_spawn", "os.posix_spawnp",
    "asyncio.create_subprocess_exec", "asyncio.create_subprocess_shell",
    "pty.spawn",
}
WORKFLOW_ROLE_REQUIREMENTS = {
    "architect_resolution": {"ARCHITECT"},
    "roadmap_contract_flow": {"TEST_AUTHOR", "GATE_REVIEWER"},
    "empirical_gate_contract_flow": {"TEST_AUTHOR", "GATE_REVIEWER"},
    "empirical_unattended_flow": {"EMPIRICAL"},
    "test_author_flow": {"TEST_AUTHOR", "GATE_REVIEWER"},
    "builder_flow": {"BUILDER", "REVIEWER"},
}
TASK_EXIT_HEAD = "<h031:repo-task-exit>"
UNKNOWN_HEAD = "<h031:unknown>"


def imported_names(tree: ast.Module) -> tuple[dict[str, str], dict[str, str]]:
    modules: dict[str, str] = {}
    symbols: dict[str, str] = {}
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                modules[alias.asname or alias.name] = alias.name
        elif isinstance(node, ast.ImportFrom) and node.module:
            for alias in node.names:
                symbols[alias.asname or alias.name] = f"{node.module}.{alias.name}"
    return modules, symbols


def qualified_expr(node: ast.expr, modules: dict[str, str], symbols: dict[str, str],
                   local_aliases: dict[str, str] | None = None) -> str:
    if isinstance(node, ast.Name):
        if local_aliases and node.id in local_aliases:
            return local_aliases[node.id]
        return symbols.get(node.id, node.id)
    parts: list[str] = []
    cur: ast.expr = node
    while isinstance(cur, ast.Attribute):
        parts.append(cur.attr)
        cur = cur.value
    if isinstance(cur, ast.Name):
        root = modules.get(cur.id, cur.id)
        return ".".join([root, *reversed(parts)])
    return ""


def qualified_call(node: ast.Call, modules: dict[str, str], symbols: dict[str, str],
                   local_aliases: dict[str, str] | None = None) -> str:
    return qualified_expr(node.func, modules, symbols, local_aliases)


def is_process_call(name: str) -> bool:
    return (
        name in PROCESS_CALLS
        or name.startswith("os.exec")
        or name.startswith("os.spawn")
    )


def first_literal(node: ast.Call) -> str | None:
    if not node.args:
        return None
    value = node.args[0]
    if isinstance(value, (ast.List, ast.Tuple)) and value.elts:
        first = value.elts[0]
        if isinstance(first, ast.Constant) and isinstance(first.value, str):
            return first.value
    if isinstance(value, ast.Constant) and isinstance(value.value, str):
        return value.value
    return None


def collect_callables(tree: ast.Module) -> tuple[
    dict[str, ast.FunctionDef | ast.AsyncFunctionDef], dict[str, str | None], set[str]
]:
    callables: dict[str, ast.FunctionDef | ast.AsyncFunctionDef] = {}
    owners: dict[str, str | None] = {}
    classes: set[str] = set()

    def visit_body(body: list[ast.stmt], prefix: str, owner_class: str | None,
                   parent_kind: str) -> None:
        for node in body:
            if isinstance(node, ast.ClassDef):
                class_id = f"{prefix}.{node.name}" if prefix else node.name
                classes.add(class_id)
                visit_body(node.body, class_id, class_id, "class")
            elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                if parent_kind == "module":
                    callable_id = node.name
                elif parent_kind == "class":
                    callable_id = f"{prefix}.{node.name}"
                else:
                    callable_id = f"{prefix}.<locals>.{node.name}"
                callables[callable_id] = node
                owners[callable_id] = owner_class
                visit_body(node.body, callable_id, owner_class, "function")

    visit_body(tree.body, "", None, "module")
    return callables, owners, classes


def callable_body_nodes(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> list[ast.AST]:
    found: list[ast.AST] = []
    todo: list[ast.AST] = list(fn.body)
    while todo:
        node = todo.pop()
        found.append(node)
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)):
            continue
        todo.extend(ast.iter_child_nodes(node))
    return found


def analyze_launch_graph(subject_text: str) -> dict[str, object]:
    subject_tree = ast.parse(subject_text)
    subject_funcs, class_owners, classes = collect_callables(subject_tree)
    modules, symbols = imported_names(subject_tree)
    graph: dict[str, set[str]] = {name: set() for name in subject_funcs}
    reverse: dict[str, set[str]] = {name: set() for name in subject_funcs}
    process_sites: list[tuple[str, str, int, str | None, bool]] = []
    run_sites: list[tuple[str, int, frozenset[str], tuple[str, ...] | None, str]] = []
    call_records: list[tuple[str, ast.Call, set[str]]] = []
    dynamic_resolution: list[tuple[str, str, int]] = []
    literal_strings: dict[str, set[str]] = {}

    by_simple: dict[str, set[str]] = {}
    methods: dict[str, set[str]] = {}
    classes_by_simple: dict[str, set[str]] = {}
    for class_id in classes:
        classes_by_simple.setdefault(class_id.rsplit(".", 1)[-1], set()).add(class_id)
    for callable_id in subject_funcs:
        simple = callable_id.rsplit(".", 1)[-1]
        by_simple.setdefault(simple, set()).add(callable_id)
        if class_owners[callable_id]:
            methods.setdefault(simple, set()).add(callable_id)

    module_strings: dict[str, str] = {}
    for node in subject_tree.body:
        if isinstance(node, (ast.Assign, ast.AnnAssign)):
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            value = node.value
            if isinstance(value, ast.Constant) and isinstance(value.value, str):
                for target in targets:
                    if isinstance(target, ast.Name):
                        module_strings[target.id] = value.value

    assignments: dict[str, dict[str, list[tuple[int, ast.expr]]]] = {}
    augmented: dict[str, dict[str, list[int]]] = {}
    for callable_id, fn in subject_funcs.items():
        assignments[callable_id] = {}
        augmented[callable_id] = {}
        for node in callable_body_nodes(fn):
            if isinstance(node, (ast.Assign, ast.AnnAssign)) and node.value is not None:
                targets = node.targets if isinstance(node, ast.Assign) else [node.target]
                for target in targets:
                    if isinstance(target, ast.Name):
                        assignments[callable_id].setdefault(target.id, []).append(
                            (node.lineno, node.value)
                        )
            elif isinstance(node, ast.AugAssign) and isinstance(node.target, ast.Name):
                augmented[callable_id].setdefault(node.target.id, []).append(node.lineno)

    # Ownership is contextual metadata only. Native process discovery below
    # walks the whole module and therefore cannot lose a site merely because
    # this callable model does not represent its surrounding syntax.
    parents: dict[ast.AST, ast.AST] = {}
    for parent in ast.walk(subject_tree):
        for child in ast.iter_child_nodes(parent):
            parents[child] = parent
    callable_node_ids = {id(node): name for name, node in subject_funcs.items()}

    def enclosing_callable(node: ast.AST) -> str | None:
        cur = parents.get(node)
        while cur is not None:
            if id(cur) in callable_node_ids:
                return callable_node_ids[id(cur)]
            if isinstance(cur, ast.Lambda):
                return f"<lambda@{cur.lineno}>"
            cur = parents.get(cur)
        return None

    def abstract_heads(expr: ast.expr, caller: str, before: int,
                       seen: frozenset[tuple[str, str, int]] = frozenset()) -> set[str]:
        if isinstance(expr, ast.Constant) and isinstance(expr.value, str):
            return {expr.value}
        if isinstance(expr, ast.Name):
            marker = (caller, expr.id, before)
            if marker in seen:
                return {UNKNOWN_HEAD}
            if any(line < before for line in augmented[caller].get(expr.id, [])):
                return {UNKNOWN_HEAD}
            prior = [
                (line, value) for line, value in assignments[caller].get(expr.id, [])
                if line < before
            ]
            if prior:
                values: set[str] = set()
                for line, value in prior:
                    values.update(abstract_heads(value, caller, line, seen | {marker}))
                return values or {UNKNOWN_HEAD}
            if expr.id in module_strings:
                return {module_strings[expr.id]}
            return {UNKNOWN_HEAD}
        if isinstance(expr, (ast.List, ast.Tuple)):
            if not expr.elts:
                return {UNKNOWN_HEAD}
            return abstract_heads(expr.elts[0], caller, before, seen)
        if isinstance(expr, ast.IfExp):
            return (
                abstract_heads(expr.body, caller, before, seen)
                | abstract_heads(expr.orelse, caller, before, seen)
            )
        if isinstance(expr, ast.BinOp) and isinstance(expr.op, ast.Add):
            left = abstract_heads(expr.left, caller, before, seen)
            right = abstract_heads(expr.right, caller, before, seen)
            if UNKNOWN_HEAD in left or UNKNOWN_HEAD in right:
                return {UNKNOWN_HEAD}
            return {a + b for a in left for b in right}
        if isinstance(expr, ast.BinOp) and isinstance(expr.op, ast.Div):
            right = abstract_heads(expr.right, caller, before, seen)
            if TASK_EXIT_HEAD in right:
                return {TASK_EXIT_HEAD}
            if UNKNOWN_HEAD in right:
                return {UNKNOWN_HEAD}
            # A statically named executable below the repository/worktree root
            # is command evidence, unlike an unresolved ambient executable.
            if isinstance(expr.left, ast.Name) and expr.left.id in {"repo", "wt", "root"}:
                return {f"<h031:repo-path>/{item}" for item in right}
            return {UNKNOWN_HEAD}
        if isinstance(expr, ast.Call):
            qname = qualified_call(expr, modules, symbols)
            if qname == "str" and len(expr.args) == 1:
                return abstract_heads(expr.args[0], caller, before, seen)
            if (
                isinstance(expr.func, ast.Attribute)
                and expr.func.attr == "get"
                and expr.args
                and isinstance(expr.args[0], ast.Constant)
                and expr.args[0].value == "exit_test"
            ):
                return {TASK_EXIT_HEAD}
            if isinstance(expr.func, ast.Attribute) and expr.func.attr == "join" and expr.args:
                separators = abstract_heads(expr.func.value, caller, before, seen)
                values = expr.args[0]
                if isinstance(values, (ast.List, ast.Tuple)):
                    parts = [abstract_heads(item, caller, before, seen) for item in values.elts]
                    if (
                        UNKNOWN_HEAD not in separators
                        and all(part and UNKNOWN_HEAD not in part for part in parts)
                    ):
                        rendered = {""}
                        for part in parts:
                            rendered = {
                                prefix + (separator if prefix else "") + suffix
                                for prefix in rendered for separator in separators for suffix in part
                            }
                        return rendered
                return {UNKNOWN_HEAD}
            return {UNKNOWN_HEAD}
        return {UNKNOWN_HEAD}

    def concrete_argv(expr: ast.expr, caller: str, before: int) -> tuple[str, ...] | None:
        if not isinstance(expr, (ast.List, ast.Tuple)):
            return None
        argv: list[str] = []
        for item in expr.elts:
            values = abstract_heads(item, caller, before)
            if len(values) != 1 or UNKNOWN_HEAD in values:
                return None
            argv.append(next(iter(values)))
        return tuple(argv)

    def context_free_heads(expr: ast.expr) -> set[str]:
        if isinstance(expr, ast.Constant) and isinstance(expr.value, str):
            return {expr.value}
        if isinstance(expr, (ast.List, ast.Tuple)) and expr.elts:
            return context_free_heads(expr.elts[0])
        if isinstance(expr, ast.BinOp) and isinstance(expr.op, ast.Add):
            left, right = context_free_heads(expr.left), context_free_heads(expr.right)
            if UNKNOWN_HEAD in left or UNKNOWN_HEAD in right:
                return {UNKNOWN_HEAD}
            return {a + b for a in left for b in right}
        if isinstance(expr, ast.Call) and isinstance(expr.func, ast.Attribute):
            if expr.func.attr == "join" and expr.args:
                separators = context_free_heads(expr.func.value)
                values = expr.args[0]
                if isinstance(values, (ast.List, ast.Tuple)):
                    parts = [context_free_heads(item) for item in values.elts]
                    if UNKNOWN_HEAD not in separators and all(UNKNOWN_HEAD not in part for part in parts):
                        rendered = {""}
                        for part in parts:
                            rendered = {
                                prefix + (separator if prefix else "") + suffix
                                for prefix in rendered for separator in separators for suffix in part
                            }
                        return rendered
        return {UNKNOWN_HEAD}

    # Global native-process inventory. Lambda forwarding is evaluated at its
    # call sites with the same bounded head evaluator used for ordinary generic
    # wrappers. Unsupported/unresolved executable semantics remain explicit.
    lambda_bindings: dict[str, ast.Lambda] = {}
    for node in ast.walk(subject_tree):
        if isinstance(node, (ast.Assign, ast.AnnAssign)) and node.value is not None:
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            if isinstance(node.value, ast.Lambda):
                for target in targets:
                    if isinstance(target, ast.Name):
                        lambda_bindings[target.id] = node.value

    global_process_sites: list[tuple[str, str, int]] = []
    global_process_nodes: list[tuple[str, ast.Call]] = []
    lambda_forwarders: dict[str, tuple[str, str, int]] = {}
    for node in ast.walk(subject_tree):
        if not isinstance(node, ast.Call):
            continue
        qualified = qualified_call(node, modules, symbols)
        if not is_process_call(qualified):
            continue
        owner = enclosing_callable(node) or "<module>"
        global_process_sites.append((owner, qualified, node.lineno))
        global_process_nodes.append((owner, node))
        cur: ast.AST | None = node
        enclosing_lambda: ast.Lambda | None = None
        while cur is not None:
            if isinstance(cur, ast.Lambda):
                enclosing_lambda = cur
                break
            cur = parents.get(cur)
        if enclosing_lambda and node.args:
            params = {a.arg for a in (*enclosing_lambda.args.posonlyargs, *enclosing_lambda.args.args)}
            first = node.args[0]
            if isinstance(first, ast.Name) and first.id in params:
                for binding, value in lambda_bindings.items():
                    if value is enclosing_lambda:
                        lambda_forwarders[binding] = (owner, qualified, node.lineno)

    global_semantic_violations: list[tuple[str, int, str]] = []
    lambda_call_classifications: list[tuple[str, int, tuple[str, ...]]] = []
    for node in ast.walk(subject_tree):
        if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Name):
            continue
        if node.func.id not in lambda_forwarders:
            continue
        caller = enclosing_callable(node)
        if caller is None or caller.startswith("<lambda@") or not node.args:
            heads = {UNKNOWN_HEAD}
        else:
            heads = abstract_heads(node.args[0], caller, node.lineno)
        lambda_call_classifications.append((node.func.id, node.lineno, tuple(sorted(heads))))
        if "codex" in heads or UNKNOWN_HEAD in heads:
            global_semantic_violations.append((node.func.id, node.lineno, repr(sorted(heads))))

    # Any native site outside a modeled function must still receive a verdict.
    # Forwarding lambdas are classified above at their invocation sites; other
    # unowned expression contexts are classified directly and fail closed.
    forwarded_lambda_lines = {line for _owner, _qualified, line in lambda_forwarders.values()}
    for owner, node in global_process_nodes:
        if owner != "<module>" and not owner.startswith("<lambda@"):
            continue
        if owner.startswith("<lambda@") and node.lineno in forwarded_lambda_lines:
            continue
        heads = context_free_heads(node.args[0]) if node.args else {UNKNOWN_HEAD}
        if "codex" in heads or UNKNOWN_HEAD in heads:
            global_semantic_violations.append((owner, node.lineno, repr(sorted(heads))))

    def resolve_targets(call: ast.Call, caller: str,
                        instances: dict[str, set[str]],
                        callable_aliases: dict[str, str]) -> set[str]:
        f = call.func
        if isinstance(f, ast.Name):
            if f.id in callable_aliases:
                return {callable_aliases[f.id]}
            if f.id in subject_funcs:
                return {f.id}
            hits = by_simple.get(f.id, set())
            return set(hits) if len(hits) == 1 else set()
        if not isinstance(f, ast.Attribute):
            return set()
        method = f.attr
        base = f.value
        owner = class_owners.get(caller)
        if isinstance(base, ast.Name):
            if base.id in {"self", "cls"} and owner:
                hit = f"{owner}.{method}"
                return {hit} if hit in subject_funcs else set()
            class_hits = classes_by_simple.get(base.id, set())
            resolved = {f"{class_id}.{method}" for class_id in class_hits}
            resolved = {x for x in resolved if x in subject_funcs}
            if resolved:
                return resolved
            instance_hits = instances.get(base.id, set())
            resolved = {f"{class_id}.{method}" for class_id in instance_hits}
            resolved = {x for x in resolved if x in subject_funcs}
            if resolved:
                return resolved
        # `Factory().method()` and other attribute-mediated calls are connected
        # conservatively when the method name identifies callable methods.
        return set(methods.get(method, set()))

    for fn_name, fn in subject_funcs.items():
        nodes = callable_body_nodes(fn)
        literal_strings[fn_name] = {
            node.value for node in nodes
            if isinstance(node, ast.Constant) and isinstance(node.value, str)
        }
        local_aliases: dict[str, str] = {}
        callable_aliases: dict[str, str] = {}
        instances: dict[str, set[str]] = {}
        for node in nodes:
            if not isinstance(node, (ast.Assign, ast.AnnAssign)):
                continue
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            value = node.value
            for target in targets:
                if not isinstance(target, ast.Name) or value is None:
                    continue
                resolved = qualified_expr(value, modules, symbols)
                if is_process_call(resolved):
                    local_aliases[target.id] = resolved
                if resolved in subject_funcs:
                    callable_aliases[target.id] = resolved
                if isinstance(value, ast.Call) and isinstance(value.func, ast.Name):
                    hits = classes_by_simple.get(value.func.id, set())
                    if hits:
                        instances[target.id] = set(hits)
        # Resolve callable aliases only after instance identities are known.
        for node in nodes:
            if not isinstance(node, (ast.Assign, ast.AnnAssign)) or node.value is None:
                continue
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            alias_targets: set[str] = set()
            value = node.value
            if isinstance(value, ast.Name) and value.id in subject_funcs:
                alias_targets = {value.id}
            elif isinstance(value, ast.Attribute) and isinstance(value.value, ast.Name):
                owner = class_owners.get(fn_name)
                base = value.value.id
                if base in {"self", "cls"} and owner:
                    candidate = f"{owner}.{value.attr}"
                    if candidate in subject_funcs:
                        alias_targets = {candidate}
                elif base in instances:
                    alias_targets = {
                        f"{class_id}.{value.attr}" for class_id in instances[base]
                        if f"{class_id}.{value.attr}" in subject_funcs
                    }
            for target in targets:
                if isinstance(target, ast.Name) and len(alias_targets) == 1:
                    callable_aliases[target.id] = next(iter(alias_targets))
        for node in nodes:
            if not isinstance(node, ast.Call):
                continue
            targets = resolve_targets(node, fn_name, instances, callable_aliases)
            call_records.append((fn_name, node, targets))
            for target in targets:
                graph[fn_name].add(target)
                reverse[target].add(fn_name)
            qualified = qualified_call(node, modules, symbols, local_aliases)
            if is_process_call(qualified):
                params = {
                    arg.arg for arg in (*fn.args.posonlyargs, *fn.args.args, *fn.args.kwonlyargs)
                }
                first = node.args[0] if node.args else None
                forwarded = isinstance(first, ast.Name) and first.id in params
                if forwarded:
                    forwarded = not any(
                        line < node.lineno
                        for line, _value in assignments[fn_name].get(first.id, [])
                    ) and not any(
                        line < node.lineno for line in augmented[fn_name].get(first.id, [])
                    ) and not any(
                        isinstance(other, ast.Call)
                        and other.lineno < node.lineno
                        and isinstance(other.func, ast.Attribute)
                        and isinstance(other.func.value, ast.Name)
                        and other.func.value.id == first.id
                        and other.func.attr in {"append", "extend", "insert", "remove", "pop", "clear"}
                        for other in nodes
                    )
                process_sites.append(
                    (fn_name, qualified, node.lineno, first_literal(node), forwarded)
                )
            if qualified in {
                "__import__", "importlib.import_module", "eval", "exec", "compile", "getattr"
            }:
                dynamic_resolution.append((fn_name, qualified, node.lineno))

    # Reconcile the global inventory against body-based callable analysis.
    # Signature defaults/decorators and any future executable AST context that
    # the call-graph model omits still receive command classification here.
    body_inventory = {(site[1], site[2]) for site in process_sites}
    for owner, node in global_process_nodes:
        qualified = qualified_call(node, modules, symbols)
        if (qualified, node.lineno) in body_inventory:
            continue
        if owner.startswith("<lambda@") and node.lineno in forwarded_lambda_lines:
            continue
        caller = owner if owner in subject_funcs else ""
        heads = (
            abstract_heads(node.args[0], caller, node.lineno)
            if node.args and caller else context_free_heads(node.args[0]) if node.args else {UNKNOWN_HEAD}
        )
        if "codex" in heads or UNKNOWN_HEAD in heads:
            finding = (owner, node.lineno, repr(sorted(heads)))
            if finding not in global_semantic_violations:
                global_semantic_violations.append(finding)

    sites_by_callable: dict[str, list[tuple[str, str, int, str | None, bool]]] = {}
    for site in process_sites:
        sites_by_callable.setdefault(site[0], []).append(site)
    generic_wrappers = {
        callable_id for callable_id, sites in sites_by_callable.items()
        if sites
        and all(site[4] for site in sites)
        and all(site[1].startswith("subprocess.") for site in sites)
    }
    for caller, node, targets in call_records:
        if not (targets & generic_wrappers):
            continue
        heads = frozenset(
            abstract_heads(node.args[0], caller, node.lineno)
            if node.args else {UNKNOWN_HEAD}
        )
        argv = concrete_argv(node.args[0], caller, node.lineno) if node.args else None
        run_sites.append((caller, node.lineno, heads, argv, ast.unparse(node)))

    def reachable(start: str) -> set[str]:
        seen: set[str] = set()
        todo = [start] if start in graph else []
        while todo:
            cur = todo.pop()
            if cur in seen:
                continue
            seen.add(cur)
            todo.extend(graph.get(cur, ()))
        return seen

    launcher_region = reachable("run_codex")
    generic_run_violations: list[tuple[str, int, str | None, str]] = []
    for site in run_sites:
        caller, line, heads, argv, rendered = site
        if caller in launcher_region:
            continue
        if "codex" in heads:
            if argv in {("codex", "--help"), ("codex", "exec", "--help")}:
                continue
            generic_run_violations.append((caller, line, "codex", rendered))
        elif UNKNOWN_HEAD in heads:
            generic_run_violations.append((caller, line, None, rendered))

    unexpected_process: list[tuple[str, str, int, str | None, bool]] = []
    launcher_process_nodes: set[str] = set()
    for site in process_sites:
        fn_name, qualified, _line, literal, _forwarded = site
        if fn_name in generic_wrappers:
            continue
        if qualified == "os.system" and literal == "clear":
            continue
        private_launcher_site = (
            fn_name in launcher_region
            and (fn_name == "run_codex" or reverse.get(fn_name, set()) <= launcher_region)
        )
        if private_launcher_site:
            launcher_process_nodes.add(fn_name)
        else:
            unexpected_process.append(site)

    agent_execution = bool(launcher_process_nodes) or any(
        caller in launcher_region for caller, _line, _heads, _argv, _rendered in run_sites
    )
    boundary_ok = (
        not unexpected_process
        and not generic_run_violations
        and not dynamic_resolution
        and not global_semantic_violations
        and agent_execution
    )

    role_contexts: dict[str, set[str]] = {}
    paths: dict[str, bool] = {}
    for root, required_roles in WORKFLOW_ROLE_REQUIREMENTS.items():
        reach = reachable(root)
        paths[root] = "run_codex" in reach
        strings: set[str] = set()
        for callable_id in reach:
            strings.update(literal_strings.get(callable_id, set()))
        role_contexts[root] = strings & set(EXPECTED)
        paths[root] = paths[root] and required_roles <= role_contexts[root]

    retry_path = "run_codex" in reachable("run_codex_resolving_architecture")
    main_reach = reachable("main")
    supervisor_reach = reachable("supervisor_resume")
    supervisor_strings: set[str] = set()
    for callable_id in supervisor_reach:
        supervisor_strings.update(literal_strings.get(callable_id, set()))
    resume_ok = (
        {"supervisor_resume", "bootstrap"} <= main_reach
        and "run_codex" in reachable("bootstrap")
        and "run" in supervisor_reach
        and "kickstart" in supervisor_strings
        and not ({"run_codex", "run_codex_resolving_architecture"} & supervisor_reach)
    )
    paths_ok = all(paths.values()) and retry_path and resume_ok
    workflow_roles = set().union(*role_contexts.values()) if role_contexts else set()

    process_boundary_nodes = (
        {"run_codex", "run_codex_resolving_architecture", "architect_resolution"}
        | launcher_process_nodes
        | {site[0] for site in unexpected_process}
        | {site[0] for site in generic_run_violations}
    )
    observer_violations: dict[str, list[str]] = {}
    for observer in ("status", "watch", "roadmap_status"):
        hits = sorted(reachable(observer) & process_boundary_nodes)
        if hits:
            observer_violations[observer] = hits

    return {
        "tree": subject_tree,
        "funcs": subject_funcs,
        "graph": graph,
        "reachable": reachable,
        "boundary_ok": boundary_ok,
        "paths_ok": paths_ok,
        "observer_clean": not observer_violations,
        "process_sites": process_sites,
        "global_process_sites": global_process_sites,
        "global_semantic_violations": global_semantic_violations,
        "lambda_call_classifications": lambda_call_classifications,
        "unexpected_process": unexpected_process,
        "generic_run_violations": generic_run_violations,
        "dynamic_resolution": dynamic_resolution,
        "generic_wrappers": generic_wrappers,
        "launcher_process_nodes": launcher_process_nodes,
        "workflow_roles": workflow_roles,
        "role_contexts": role_contexts,
        "path_results": paths,
        "retry_path": retry_path,
        "resume_ok": resume_ok,
        "observer_violations": observer_violations,
    }


def resolved_route(argv: list[str]) -> tuple[str, str]:
    # Deliberately begin with the conflicting user config. Explicit launch
    # arguments must replace both values.
    model = "user-config-other-model"
    effort = "ultra"
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in {"-m", "--model"} and i + 1 < len(argv):
            model = argv[i + 1]
            i += 2
            continue
        if arg.startswith("--model="):
            model = arg.split("=", 1)[1]
        value = None
        if arg in {"-c", "--config"} and i + 1 < len(argv):
            value = argv[i + 1]
            i += 1
        elif arg.startswith("--config="):
            value = arg.split("=", 1)[1]
        if value and "=" in value:
            key, raw = value.split("=", 1)
            if key.strip() == "model_reasoning_effort":
                effort = raw.strip().strip("\"'")
        i += 1
    return model, effort


