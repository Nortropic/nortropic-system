#!/usr/bin/env bash
# h-031-exit — explicit Codex-modellrouting per faktisk autopilotroll
#
# MUTANTPREDIKTION (före produktionsimplementation):
#   M01 journalen påstår rätt modell men argv saknar explicit routing   -> K2
#   M02 alla roller får max                                            -> K2 (BUILDER)
#   M03 okänd roll faller tillbaka till en default                      -> K4
#   M04 äldre persisted ultra återanvänds                               -> K2/K5
#   M05 klassmetod startar Codex utanför gemensam spawnpunkt             -> K1/K8
#   M06 observer når process via helper→metod→self.metod                  -> K6/K9
#   M07 argv är rätt men journalens källa/fält saknas                    -> K3
#   V01 upprepade rollcalls samlas bakom en helper utan effektändring    -> K10 PASS
#
# Provet använder en falsk codex-binär. Den fångar den faktiskt exekverade
# argv-listan och skriver en minimal giltig agentrapport. Därmed dömer K2
# launch-effekten, inte källkodens påståenden. En avsiktligt motstridig
# CODEX_HOME-konfiguration (annan modell + ultra) är startvärdet.

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "ODÖMBART K0 — ingen git-reporot"
  exit 2
}
SOURCE="$ROOT/scripts/nortropic-codex-autopilot.py"
SCHEMA="$ROOT/docs/loop/codex-autopilot-report.schema.json"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/nortropic-h031.XXXXXX")" || {
  echo "ODÖMBART K0 — temp-katalog kunde inte skapas"
  exit 2
}
cleanup() {
  rm -rf "$WORK"
}
trap cleanup EXIT HUP INT TERM

if [ ! -f "$SOURCE" ] || [ ! -f "$SCHEMA" ]; then
  echo "ODÖMBART K0 — källa eller rapportschema saknas"
  exit 2
fi

python3 - "$SOURCE" "$SCHEMA" "$WORK" <<'PY'
from __future__ import annotations

import ast
import importlib.util
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import traceback

source = Path(sys.argv[1]).resolve()
schema_source = Path(sys.argv[2]).resolve()
work = Path(sys.argv[3]).resolve()

EXPECTED = {
    "ARCHITECT": ("gpt-5.6-sol", "max"),
    "TEST_AUTHOR": ("gpt-5.6-sol", "max"),
    "GATE_REVIEWER": ("gpt-5.6-sol", "max"),
    "BUILDER": ("gpt-5.6-sol", "high"),
    "REVIEWER": ("gpt-5.6-sol", "max"),
    "EMPIRICAL": ("gpt-5.6-sol", "max"),
}
ROUTING_SOURCE = "AUTOPILOT_ROLE_POLICY"
checks: list[tuple[str, bool, str]] = []


def check(key: str, ok: bool, detail: str) -> None:
    checks.append((key, ok, detail))


def sh(*argv: str, cwd: Path | None = None) -> str:
    p = subprocess.run(
        list(argv), cwd=str(cwd) if cwd else None, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
    )
    if p.returncode != 0:
        raise RuntimeError(f"command rc={p.returncode}: {' '.join(argv)}\n{p.stdout}")
    return p.stdout


def call_name(node: ast.Call) -> str:
    f = node.func
    if isinstance(f, ast.Name):
        return f.id
    if isinstance(f, ast.Attribute) and isinstance(f.value, ast.Name):
        return f"{f.value.id}.{f.attr}"
    return ""


PROCESS_CALLS = {
    "subprocess.Popen", "subprocess.run", "subprocess.call",
    "subprocess.check_call", "subprocess.check_output",
    "subprocess.getoutput", "subprocess.getstatusoutput",
    "os.system", "os.popen", "os.posix_spawn", "os.posix_spawnp",
    "asyncio.create_subprocess_exec", "asyncio.create_subprocess_shell",
    "pty.spawn",
}
WORKFLOW_ROLE_REQUIREMENTS = {
    "architect_resolution": {"ARCHITECT"},
    "roadmap_contract_flow": {"TEST_AUTHOR", "GATE_REVIEWER"},
    "empirical_gate_contract_flow": {"TEST_AUTHOR", "GATE_REVIEWER"},
    "empirical_unattended_flow": {"EMPIRICAL"},
    "test_author_flow": {"TEST_AUTHOR", "GATE_REVIEWER"},
    "builder_flow": {"BUILDER", "REVIEWER"},
}
# These existing functions deliberately execute a command selected by a trusted
# gate path or construct a `gh` argv before calling the generic runner. They are
# not agent launchers. No call count or surrounding topology is frozen.
BENIGN_DYNAMIC_RUN_CALLERS = {"run_gate", "run_empirical_gate", "publish"}


def imported_names(tree: ast.Module) -> tuple[dict[str, str], dict[str, str]]:
    modules: dict[str, str] = {}
    symbols: dict[str, str] = {}
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                modules[alias.asname or alias.name] = alias.name
        elif isinstance(node, ast.ImportFrom) and node.module:
            for alias in node.names:
                symbols[alias.asname or alias.name] = f"{node.module}.{alias.name}"
    return modules, symbols


def qualified_expr(node: ast.expr, modules: dict[str, str], symbols: dict[str, str],
                   local_aliases: dict[str, str] | None = None) -> str:
    if isinstance(node, ast.Name):
        if local_aliases and node.id in local_aliases:
            return local_aliases[node.id]
        return symbols.get(node.id, node.id)
    parts: list[str] = []
    cur: ast.expr = node
    while isinstance(cur, ast.Attribute):
        parts.append(cur.attr)
        cur = cur.value
    if isinstance(cur, ast.Name):
        root = modules.get(cur.id, cur.id)
        return ".".join([root, *reversed(parts)])
    return ""


def qualified_call(node: ast.Call, modules: dict[str, str], symbols: dict[str, str],
                   local_aliases: dict[str, str] | None = None) -> str:
    return qualified_expr(node.func, modules, symbols, local_aliases)


def is_process_call(name: str) -> bool:
    return (
        name in PROCESS_CALLS
        or name.startswith("os.exec")
        or name.startswith("os.spawn")
    )


def first_literal(node: ast.Call) -> str | None:
    if not node.args:
        return None
    value = node.args[0]
    if isinstance(value, (ast.List, ast.Tuple)) and value.elts:
        first = value.elts[0]
        if isinstance(first, ast.Constant) and isinstance(first.value, str):
            return first.value
    if isinstance(value, ast.Constant) and isinstance(value.value, str):
        return value.value
    return None


def collect_callables(tree: ast.Module) -> tuple[
    dict[str, ast.FunctionDef | ast.AsyncFunctionDef], dict[str, str | None], set[str]
]:
    callables: dict[str, ast.FunctionDef | ast.AsyncFunctionDef] = {}
    owners: dict[str, str | None] = {}
    classes: set[str] = set()

    def visit_body(body: list[ast.stmt], prefix: str, owner_class: str | None,
                   parent_kind: str) -> None:
        for node in body:
            if isinstance(node, ast.ClassDef):
                class_id = f"{prefix}.{node.name}" if prefix else node.name
                classes.add(class_id)
                visit_body(node.body, class_id, class_id, "class")
            elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                if parent_kind == "module":
                    callable_id = node.name
                elif parent_kind == "class":
                    callable_id = f"{prefix}.{node.name}"
                else:
                    callable_id = f"{prefix}.<locals>.{node.name}"
                callables[callable_id] = node
                owners[callable_id] = owner_class
                visit_body(node.body, callable_id, owner_class, "function")

    visit_body(tree.body, "", None, "module")
    return callables, owners, classes


def callable_body_nodes(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> list[ast.AST]:
    found: list[ast.AST] = []
    todo: list[ast.AST] = list(fn.body)
    while todo:
        node = todo.pop()
        found.append(node)
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)):
            continue
        todo.extend(ast.iter_child_nodes(node))
    return found


def analyze_launch_graph(subject_text: str) -> dict[str, object]:
    subject_tree = ast.parse(subject_text)
    subject_funcs, class_owners, classes = collect_callables(subject_tree)
    modules, symbols = imported_names(subject_tree)
    graph: dict[str, set[str]] = {name: set() for name in subject_funcs}
    reverse: dict[str, set[str]] = {name: set() for name in subject_funcs}
    process_sites: list[tuple[str, str, int, str | None]] = []
    run_sites: list[tuple[str, int, str | None, str]] = []
    dynamic_resolution: list[tuple[str, str, int]] = []
    literal_strings: dict[str, set[str]] = {}

    by_simple: dict[str, set[str]] = {}
    methods: dict[str, set[str]] = {}
    classes_by_simple: dict[str, set[str]] = {}
    for class_id in classes:
        classes_by_simple.setdefault(class_id.rsplit(".", 1)[-1], set()).add(class_id)
    for callable_id in subject_funcs:
        simple = callable_id.rsplit(".", 1)[-1]
        by_simple.setdefault(simple, set()).add(callable_id)
        if class_owners[callable_id]:
            methods.setdefault(simple, set()).add(callable_id)

    def resolve_targets(call: ast.Call, caller: str,
                        instances: dict[str, set[str]]) -> set[str]:
        f = call.func
        if isinstance(f, ast.Name):
            if f.id in subject_funcs:
                return {f.id}
            hits = by_simple.get(f.id, set())
            return set(hits) if len(hits) == 1 else set()
        if not isinstance(f, ast.Attribute):
            return set()
        method = f.attr
        base = f.value
        owner = class_owners.get(caller)
        if isinstance(base, ast.Name):
            if base.id in {"self", "cls"} and owner:
                hit = f"{owner}.{method}"
                return {hit} if hit in subject_funcs else set()
            class_hits = classes_by_simple.get(base.id, set())
            resolved = {f"{class_id}.{method}" for class_id in class_hits}
            resolved = {x for x in resolved if x in subject_funcs}
            if resolved:
                return resolved
            instance_hits = instances.get(base.id, set())
            resolved = {f"{class_id}.{method}" for class_id in instance_hits}
            resolved = {x for x in resolved if x in subject_funcs}
            if resolved:
                return resolved
        # `Factory().method()` and other attribute-mediated calls are connected
        # conservatively when the method name identifies callable methods.
        return set(methods.get(method, set()))

    for fn_name, fn in subject_funcs.items():
        nodes = callable_body_nodes(fn)
        literal_strings[fn_name] = {
            node.value for node in nodes
            if isinstance(node, ast.Constant) and isinstance(node.value, str)
        }
        local_aliases: dict[str, str] = {}
        instances: dict[str, set[str]] = {}
        for node in nodes:
            if not isinstance(node, (ast.Assign, ast.AnnAssign)):
                continue
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            value = node.value
            for target in targets:
                if not isinstance(target, ast.Name) or value is None:
                    continue
                resolved = qualified_expr(value, modules, symbols)
                if is_process_call(resolved):
                    local_aliases[target.id] = resolved
                if isinstance(value, ast.Call) and isinstance(value.func, ast.Name):
                    hits = classes_by_simple.get(value.func.id, set())
                    if hits:
                        instances[target.id] = set(hits)
        for node in nodes:
            if not isinstance(node, ast.Call):
                continue
            targets = resolve_targets(node, fn_name, instances)
            for target in targets:
                graph[fn_name].add(target)
                reverse[target].add(fn_name)
            qualified = qualified_call(node, modules, symbols, local_aliases)
            if is_process_call(qualified):
                process_sites.append((fn_name, qualified, node.lineno, first_literal(node)))
            if "run" in targets:
                run_sites.append((fn_name, node.lineno, first_literal(node), ast.unparse(node)))
            if qualified in {
                "__import__", "importlib.import_module", "eval", "exec", "compile", "getattr"
            }:
                dynamic_resolution.append((fn_name, qualified, node.lineno))

    def reachable(start: str) -> set[str]:
        seen: set[str] = set()
        todo = [start] if start in graph else []
        while todo:
            cur = todo.pop()
            if cur in seen:
                continue
            seen.add(cur)
            todo.extend(graph.get(cur, ()))
        return seen

    launcher_region = reachable("run_codex")
    generic_run_violations: list[tuple[str, int, str | None, str]] = []
    for site in run_sites:
        caller, _line, head, rendered = site
        if caller in launcher_region:
            continue
        if head == "codex":
            if caller == "ensure_dependencies" and "--help" in rendered:
                continue
            generic_run_violations.append(site)
        elif head is None and caller not in BENIGN_DYNAMIC_RUN_CALLERS:
            generic_run_violations.append(site)

    unexpected_process: list[tuple[str, str, int, str | None]] = []
    launcher_process_nodes: set[str] = set()
    for site in process_sites:
        fn_name, qualified, _line, literal = site
        if fn_name == "run" and qualified == "subprocess.run":
            continue
        if fn_name == "watch" and qualified == "os.system" and literal == "clear":
            continue
        private_launcher_site = (
            fn_name in launcher_region
            and (fn_name == "run_codex" or reverse.get(fn_name, set()) <= launcher_region)
        )
        if private_launcher_site:
            launcher_process_nodes.add(fn_name)
        else:
            unexpected_process.append(site)

    agent_execution = bool(launcher_process_nodes) or any(
        caller in launcher_region for caller, _line, _head, _rendered in run_sites
    )
    boundary_ok = (
        not unexpected_process
        and not generic_run_violations
        and not dynamic_resolution
        and agent_execution
    )

    role_contexts: dict[str, set[str]] = {}
    paths: dict[str, bool] = {}
    for root, required_roles in WORKFLOW_ROLE_REQUIREMENTS.items():
        reach = reachable(root)
        paths[root] = "run_codex" in reach
        strings: set[str] = set()
        for callable_id in reach:
            strings.update(literal_strings.get(callable_id, set()))
        role_contexts[root] = strings & set(EXPECTED)
        paths[root] = paths[root] and required_roles <= role_contexts[root]

    retry_path = "run_codex" in reachable("run_codex_resolving_architecture")
    main_reach = reachable("main")
    supervisor_reach = reachable("supervisor_resume")
    supervisor_strings: set[str] = set()
    for callable_id in supervisor_reach:
        supervisor_strings.update(literal_strings.get(callable_id, set()))
    resume_ok = (
        {"supervisor_resume", "bootstrap"} <= main_reach
        and "run_codex" in reachable("bootstrap")
        and "run" in supervisor_reach
        and "kickstart" in supervisor_strings
        and not ({"run_codex", "run_codex_resolving_architecture"} & supervisor_reach)
    )
    paths_ok = all(paths.values()) and retry_path and resume_ok
    workflow_roles = set().union(*role_contexts.values()) if role_contexts else set()

    process_boundary_nodes = (
        {"run_codex", "run_codex_resolving_architecture", "architect_resolution"}
        | launcher_process_nodes
        | {site[0] for site in unexpected_process}
        | {site[0] for site in generic_run_violations}
    )
    observer_violations: dict[str, list[str]] = {}
    for observer in ("status", "watch", "roadmap_status"):
        hits = sorted(reachable(observer) & process_boundary_nodes)
        if hits:
            observer_violations[observer] = hits

    return {
        "tree": subject_tree,
        "funcs": subject_funcs,
        "graph": graph,
        "reachable": reachable,
        "boundary_ok": boundary_ok,
        "paths_ok": paths_ok,
        "observer_clean": not observer_violations,
        "process_sites": process_sites,
        "unexpected_process": unexpected_process,
        "generic_run_violations": generic_run_violations,
        "dynamic_resolution": dynamic_resolution,
        "launcher_process_nodes": launcher_process_nodes,
        "workflow_roles": workflow_roles,
        "role_contexts": role_contexts,
        "path_results": paths,
        "retry_path": retry_path,
        "resume_ok": resume_ok,
        "observer_violations": observer_violations,
    }


def resolved_route(argv: list[str]) -> tuple[str, str]:
    # Deliberately begin with the conflicting user config. Explicit launch
    # arguments must replace both values.
    model = "user-config-other-model"
    effort = "ultra"
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in {"-m", "--model"} and i + 1 < len(argv):
            model = argv[i + 1]
            i += 2
            continue
        if arg.startswith("--model="):
            model = arg.split("=", 1)[1]
        value = None
        if arg in {"-c", "--config"} and i + 1 < len(argv):
            value = argv[i + 1]
            i += 1
        elif arg.startswith("--config="):
            value = arg.split("=", 1)[1]
        if value and "=" in value:
            key, raw = value.split("=", 1)
            if key.strip() == "model_reasoning_effort":
                effort = raw.strip().strip("\"'")
        i += 1
    return model, effort


try:
    text = source.read_text(encoding="utf-8")
    analysis = analyze_launch_graph(text)
    tree = analysis["tree"]
    funcs = analysis["funcs"]
    required_api = {"run_codex", "status", "watch", "roadmap_status", "journal_root"}
    check("K0", required_api <= funcs.keys(), f"runtime API present={sorted(required_api & funcs.keys())}")
    check(
        "K1", bool(analysis["boundary_ok"]),
        "process_sites={} launcher_nodes={} unexpected={} generic_run={} dynamic={}".format(
            analysis["process_sites"], analysis["launcher_process_nodes"],
            analysis["unexpected_process"], analysis["generic_run_violations"],
            analysis["dynamic_resolution"],
        ),
    )
    check(
        "K1P", bool(analysis["paths_ok"]),
        "roles={} paths={} retry={} resume={}".format(
            sorted(analysis["workflow_roles"]), analysis["path_results"],
            analysis["retry_path"], analysis["resume_ok"],
        ),
    )

    repo = work / "repo"
    repo.mkdir()
    sh("git", "init", "-q", cwd=repo)
    sh("git", "config", "user.name", "h031-gate", cwd=repo)
    sh("git", "config", "user.email", "h031-gate@nortropic.invalid", cwd=repo)
    schema = repo / "docs/loop/codex-autopilot-report.schema.json"
    schema.parent.mkdir(parents=True)
    shutil.copyfile(schema_source, schema)
    (repo / "anchor.txt").write_text("h031\n", encoding="utf-8")
    sh("git", "add", ".", cwd=repo)
    sh("git", "commit", "-qm", "fixture", cwd=repo)

    fakebin = work / "fakebin"
    fakebin.mkdir()
    capture = work / "codex-argv.jsonl"
    fake = fakebin / "codex"
    fake.write_text(
        """#!/usr/bin/env python3
import json, os, pathlib, re, sys
argv = sys.argv[1:]
with pathlib.Path(os.environ['H031_CAPTURE']).open('a', encoding='utf-8') as f:
    f.write(json.dumps(argv) + '\\n')
out = pathlib.Path(argv[argv.index('-o') + 1])
prompt = argv[-1]
m = re.search(r'H031_GATE_ROLE=([A-Z_]+)', prompt)
role = m.group(1) if m else 'OVERIFIERAT'
out.write_text(json.dumps({
    'role': role, 'outcome': 'READY', 'owner_decision_required': False,
    'blocking_findings': []
}), encoding='utf-8')
print(json.dumps({'type': 'thread.started', 'thread_id': 'h031-' + role.lower()}))
""",
        encoding="utf-8",
    )
    fake.chmod(fake.stat().st_mode | stat.S_IXUSR)

    codex_home = work / "codex-home"
    codex_home.mkdir()
    (codex_home / "config.toml").write_text(
        'model = "user-config-other-model"\nmodel_reasoning_effort = "ultra"\n',
        encoding="utf-8",
    )
    os.environ["PATH"] = str(fakebin) + os.pathsep + os.environ.get("PATH", "")
    os.environ["CODEX_HOME"] = str(codex_home)
    os.environ["H031_CAPTURE"] = str(capture)

    spec = importlib.util.spec_from_file_location("h031_autopilot_subject", source)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load autopilot source")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)

    journal_file = module.journal_root(repo) / "events.jsonl"
    old = {
        "ts": "2026-01-01T00:00:00+00:00", "event": "AGENT_START",
        "role": "BUILDER", "model": "legacy-model",
        "reasoning_effort": "ultra", "model_routing_source": "USER_CONFIG",
    }
    journal_file.write_text(json.dumps(old, sort_keys=True) + "\n", encoding="utf-8")

    runtime_errors: list[str] = []
    for role in EXPECTED:
        try:
            module.run_codex(repo, repo, role, f"H031_GATE_ROLE={role}")
        except Exception as exc:
            runtime_errors.append(f"{role}:{type(exc).__name__}:{exc}")

    captures = [json.loads(line) for line in capture.read_text(encoding="utf-8").splitlines()] if capture.exists() else []
    routes = [resolved_route(argv) for argv in captures]
    expected_routes = [EXPECTED[role] for role in EXPECTED]
    check(
        "K2", not runtime_errors and routes == expected_routes,
        f"routes={routes} expected={expected_routes} errors={runtime_errors}",
    )

    records = [json.loads(line) for line in journal_file.read_text(encoding="utf-8").splitlines() if line.strip()]
    starts = [r for r in records[1:] if r.get("event") == "AGENT_START"]
    journal_ok = len(starts) == len(EXPECTED)
    if journal_ok:
        for rec, role in zip(starts, EXPECTED):
            model, effort = EXPECTED[role]
            journal_ok = journal_ok and all((
                rec.get("role") == role,
                rec.get("model") == model,
                rec.get("reasoning_effort") == effort,
                rec.get("model_routing_source") == ROUTING_SOURCE,
            ))
    check("K3", journal_ok, f"AGENT_START={starts}")

    before_capture = len(captures)
    before_runs = sorted((module.journal_root(repo) / "runs").glob("*"))
    before_lines = len(records)
    unknown_error = "NO_ERROR"
    try:
        module.run_codex(repo, repo, "UNKNOWN_ROLE", "H031_GATE_ROLE=UNKNOWN_ROLE")
    except Exception as exc:
        unknown_error = f"{type(exc).__name__}:{exc}"
    after_captures = [json.loads(line) for line in capture.read_text(encoding="utf-8").splitlines()] if capture.exists() else []
    after_runs = sorted((module.journal_root(repo) / "runs").glob("*"))
    after_records = [json.loads(line) for line in journal_file.read_text(encoding="utf-8").splitlines() if line.strip()]
    unknown_ok = (
        unknown_error != "NO_ERROR"
        and len(after_captures) == before_capture
        and len(after_runs) == len(before_runs)
        and len(after_records) == before_lines
    )
    check(
        "K4", unknown_ok,
        f"error={unknown_error} spawns={before_capture}->{len(after_captures)} runs={len(before_runs)}->{len(after_runs)} journal={before_lines}->{len(after_records)}",
    )

    old_preserved = after_records and after_records[0] == old
    no_new_ultra = all(
        r.get("reasoning_effort") != "ultra"
        for r in after_records[1:]
        if r.get("event") == "AGENT_START"
    ) and all(effort != "ultra" for _, effort in routes)
    check("K5", old_preserved and no_new_ultra, f"old_preserved={old_preserved} no_new_ultra={no_new_ultra}")

    check(
        "K6", bool(analysis["observer_clean"]),
        f"transitive_agent_reachability={analysis['observer_violations']}",
    )

    # Positive parser controls admit both supported CLI spellings.
    short_form = resolved_route(["-m", "gpt-5.6-sol", "-c", 'model_reasoning_effort="high"'])
    long_form = resolved_route(["--model=gpt-5.6-sol", "--config=model_reasoning_effort='max'"])
    check(
        "K7", short_form == EXPECTED["BUILDER"] and long_form == EXPECTED["REVIEWER"],
        f"short={short_form} long={long_form}",
    )

    # D: a perfect journal claim cannot satisfy the argv oracle when launch
    # configuration is absent.
    journal_only_claim = {
        "role": "ARCHITECT", "model": "gpt-5.6-sol", "reasoning_effort": "max",
        "model_routing_source": ROUTING_SOURCE,
    }
    journal_only_mutant = resolved_route([])
    journal_only_rejected = (
        journal_only_claim["model"] == EXPECTED["ARCHITECT"][0]
        and journal_only_claim["reasoning_effort"] == EXPECTED["ARCHITECT"][1]
        and journal_only_mutant != EXPECTED["ARCHITECT"]
    )
    check(
        "K7D", journal_only_rejected,
        f"journal_claim={journal_only_claim} executed_route={journal_only_mutant}",
    )

    # E: BUILDER is intentionally distinct from the all-max roles.
    all_max_builder_mutant = resolved_route(["--model", "gpt-5.6-sol", "-c", "model_reasoning_effort=max"])
    check(
        "K7E", all_max_builder_mutant != EXPECTED["BUILDER"],
        f"all_max_builder={all_max_builder_mutant} expected={EXPECTED['BUILDER']}",
    )

    # A: the SAME K1 oracle must inspect methods, not merely top-level defs.
    bypass_class = '''
class H031ClassBypass:
    @staticmethod
    def launch(wt, prompt):
        executable = "".join(("co", "dex"))
        command = [executable, "exec", prompt]
        return subprocess.call(command, cwd=str(wt))
'''
    bypass_needle = '        rem = run_codex_resolving_architecture(repo, wt, "BUILDER"'
    if bypass_needle not in text:
        raise RuntimeError("K8 mutant insertion point missing")
    bypass_mutant = text.replace(
        bypass_needle,
        '        H031ClassBypass.launch(wt, "retry")\n' + bypass_needle,
        1,
    ) + bypass_class
    bypass_analysis = analyze_launch_graph(bypass_mutant)
    bypass_rejected = not bool(bypass_analysis["boundary_ok"])
    check(
        "K8", bypass_rejected,
        f"A_class_method_launch_rejected={bypass_rejected} unexpected={bypass_analysis['unexpected_process']}",
    )

    # B: observer -> helper -> class method -> dynamic process launch.
    observer_helpers = '''
class H031ObserverBypass:
    def first_hop(self, repo):
        return self.launch(repo)

    def launch(self, repo):
        executable = "".join(("co", "dex"))
        command = [executable, "exec", "observer must not launch an agent"]
        return subprocess.call(command, cwd=str(repo))

def h031_observer_hop(repo):
    bypass = H031ObserverBypass()
    return bypass.first_hop(repo)
'''
    observer_needle = 'def status(repo: Path, wt_root: Path) -> None:\n'
    if observer_needle not in text:
        raise RuntimeError("K9 mutant insertion point missing")
    observer_mutant = text.replace(
        observer_needle,
        observer_needle + '    h031_observer_hop(repo)\n',
        1,
    ) + observer_helpers
    observer_analysis = analyze_launch_graph(observer_mutant)
    observer_rejected = not bool(observer_analysis["observer_clean"])
    check(
        "K9", observer_rejected,
        f"B_observer_class_method_rejected={observer_rejected} violations={observer_analysis['observer_violations']}",
    )

    # C: consolidate every repeated role-launch call through one helper. The
    # required role/context effects remain, but call counts and immediate
    # topology change. K1/K1P must admit this legitimate shape.
    class ConsolidateRoleLaunches(ast.NodeTransformer):
        def visit_Call(self, node: ast.Call) -> ast.AST:
            node = self.generic_visit(node)
            if isinstance(node.func, ast.Name) and node.func.id == "run_codex_resolving_architecture":
                node.func = ast.Name(id="h031_consolidated_role_launch", ctx=ast.Load())
            return node

    refactor_tree = ConsolidateRoleLaunches().visit(ast.parse(text))
    helper = ast.parse('''
def h031_consolidated_role_launch(*args, **kwargs):
    return run_codex_resolving_architecture(*args, **kwargs)
''').body[0]
    # Insert before the module's executable __main__ tail; only static judge
    # semantics are exercised, never the mutant's runtime.
    refactor_tree.body.insert(-1, helper)
    ast.fix_missing_locations(refactor_tree)
    refactor_analysis = analyze_launch_graph(ast.unparse(refactor_tree))
    refactor_admitted = all((
        bool(refactor_analysis["boundary_ok"]),
        bool(refactor_analysis["paths_ok"]),
        bool(refactor_analysis["observer_clean"]),
    ))
    check(
        "K10", refactor_admitted,
        "C_topology_refactor_admitted={} paths={} unexpected={}".format(
            refactor_admitted, refactor_analysis["path_results"],
            refactor_analysis["unexpected_process"],
        ),
    )

except Exception as exc:
    print(f"ODÖMBART K0 — gate harness exception: {type(exc).__name__}: {exc}")
    traceback.print_exc()
    sys.exit(2)

passed = 0
failed = 0
for key, ok, detail in checks:
    if ok:
        passed += 1
        print(f"PASS  {key} — {detail}")
    else:
        failed += 1
        print(f"FAIL  {key} — {detail}")
print(f"\n{passed} PASS, {failed} FAIL")
sys.exit(0 if failed == 0 else 1)
PY
rc=$?

case "$rc" in
  0|1) exit "$rc" ;;
  *) exit 2 ;;
esac
