def recv_frame(s):
    lead=b""
    while len(lead)<4:
        part=s.recv(4-len(lead))
        if not part:return None
        lead+=part
    size=struct.unpack(">I",lead)[0];raw=b""
    while len(raw)<size:
        part=s.recv(size-len(raw))
        if not part:return None
        raw+=part
    return json.loads(raw.decode())
def raw_request(header,fd_count=3,disconnect=False):
    s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.settimeout(4);s.connect(sock_path)
    raw=json.dumps(header,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode();fds=[]
    for index in range(fd_count):fds.append(os.open("/dev/null",os.O_RDONLY if index==0 else os.O_WRONLY))
    ancillary=[(socket.SOL_SOCKET,socket.SCM_RIGHTS,struct.pack(str(fd_count)+"i",*fds))] if fds else []
    s.sendmsg([struct.pack(">I",len(raw))+raw],ancillary)
    if disconnect:
        s.close();result="disconnected"
    else:
        s.sendall(struct.pack(">I",2)+b"{}");result=recv_frame(s);s.close()
    for fd in fds:os.close(fd)
    return result
