def rejected_response(value: Any) -> bool:
    if value is None or isinstance(value, str):
        return True
    return isinstance(value, dict) and value.get("class") == "request-rejected-v1"


def base_profile_composition_case(
    base: Path, python: Path, trust: Path, env: dict[str, str], live_canary: Path,
) -> tuple[bool, dict[str, Any]]:
    """Causally earn the no-staging profile through its own real child receipt."""
    workspace = base / "base-profile-workspace"
    child = workspace / "child"
    outer_sibling = workspace / "outer-sibling"
    for path in (workspace, child, outer_sibling):
        path.mkdir()
    outer_script = workspace / "outer.py"
    outer_script.write_text(BASE_OUTER_FIXTURE, encoding="utf-8")
    envelope = workspace / "envelope.json"
    proof_prefix = f".nortropic-h036-proof-{PROOF_NONCE}"

    def denied_ops(root: Path, family: str) -> dict[str, list[str]]:
        result: dict[str, list[str]] = {}
        prefix = f"{proof_prefix}-{family}"
        for name in ("write", "rename", "unlink", "hardlink"):
            source = root / f"{prefix}-{name}-source"
            if not source.exists():
                source.write_text("ORIGINAL", encoding="utf-8")
                source.chmod(0o600)
            if name == "write":
                result[name] = [str(source)]
            elif name == "rename":
                result[name] = [str(source), str(root / f"{prefix}-rename-target")]
            elif name == "unlink":
                result[name] = [str(source)]
            else:
                result[name] = [str(source), str(root / f"{prefix}-hardlink-target")]
        result["create"] = [str(root / f"{prefix}-created")]
        result["mkdir"] = [str(root / f"{prefix}-new-dir")]
        result["chmod"] = [result["write"][0]]
        return result

    protected_ops = {
        "live": denied_ops(live_canary, "live"),
        "trust": denied_ops(trust, "trust"),
        "ancestor": denied_ops(outer_sibling, "ancestor"),
    }

    def unchanged(ops: dict[str, list[str]]) -> bool:
        try:
            return (
                all(Path(ops[key][0]).read_text(encoding="utf-8") == "ORIGINAL"
                    for key in ("write", "rename", "unlink", "hardlink"))
                and not Path(ops["create"][0]).exists()
                and not Path(ops["mkdir"][0]).exists()
                and not Path(ops["rename"][1]).exists()
                and not Path(ops["hardlink"][1]).exists()
                and (Path(ops["chmod"][0]).stat().st_mode & 0o777) == 0o600
            )
        except OSError:
            return False

    direct_marker = child / "base-direct-marker"
    scratch = child / f"{proof_prefix}.allowed"
    direct_code = (
        "import errno,hashlib,json,os,pathlib,resource,sys;marker=pathlib.Path(sys.argv[1]);"
        "fd=os.open(marker,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600);os.write(fd,b'TARGET_STARTED\\n');os.fsync(fd);os.close(fd);raw=sys.stdin.buffer.read();fd_soft_limit=resource.getrlimit(resource.RLIMIT_NOFILE)[0];fds=[]"
        "\nfor token in os.listdir('/dev/fd'):"
        "\n if token.isdecimal() and int(token)>=3:"
        "\n  try:os.fstat(int(token));fds.append(int(token))"
        "\n  except OSError:pass"
        "\nfds=sorted(set(fds))"
        "\ndef attempt(path):"
        "\n try:fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600);os.close(fd);return 0"
        "\n except OSError as exc:return exc.errno"
        "\nkuvert=pathlib.Path(os.environ.get('NORTROPIC_KUVERT',''));kr=b'';km=None;kn=None"
        "\ntry:"
        "\n kfd=os.open(kuvert,os.O_RDONLY|os.O_NOFOLLOW);kst=os.fstat(kfd);km=oct(kst.st_mode&0o777);kn=kst.st_nlink"
        "\n while True:"
        "\n  part=os.read(kfd,65536)"
        "\n  if not part:break"
        "\n  kr+=part"
        "\n os.close(kfd)"
        "\nexcept OSError:pass"
        "\nbad=[key for key in os.environ if key.startswith(('DYLD_','GIT_','GH_','GITHUB_','PYTHON','SLACK_')) or key in {'LD_PRELOAD','LD_LIBRARY_PATH','NORTROPIC_TRUST_ROOT','NORTROPIC_STAGING_ROOT','NORTROPIC_RESULT_SINK','__PYVENV_LAUNCHER__'}]"
        "\nout={'trust':attempt(" + repr(str(trust / "base-direct-bad"))
        + "),'ancestor':attempt(" + repr(str(outer_sibling / "base-direct-bad"))
        + "),'bad_env':sorted(bad),'internal_env':sorted(key for key in os.environ if key.startswith('NORTROPIC_H036_')),'path':os.environ.get('PATH'),'fd_soft_limit':fd_soft_limit,'open_fds':fds,'stdio_identity':[[os.fstat(number).st_dev,os.fstat(number).st_ino] for number in (0,1,2)],'lineage':{'capability':os.environ.get('NORTROPIC_H036_CAPABILITY'),'session':os.environ.get('NORTROPIC_H036_SESSION_ID'),'level':os.environ.get('NORTROPIC_H036_LEVEL')},'kuvert':{'path':str(kuvert),'absolute':kuvert.is_absolute(),'same_stdin':kr==raw,'sha256':hashlib.sha256(kr).hexdigest(),'mode':km,'nlink':kn,'symlink':kuvert.is_symlink()}}"
        "\nwith marker.open('a',encoding='utf-8') as stream:stream.write(json.dumps(out,sort_keys=True,separators=(',',':'))+'\\n')"
        "\nsys.stdout.buffer.write(bytes.fromhex(" + repr(RAW_STDOUT.hex()) + "));sys.stdout.buffer.flush()"
        "\nsys.stderr.buffer.write(bytes.fromhex(" + repr(RAW_STDERR.hex()) + "));sys.stderr.buffer.flush()"
    )
    compile(direct_code, "h036-base-direct-fixture", "exec")
    payload = {
        "outer_started": str(workspace / "outer-started"),
        "live_create": str(live_canary / "base-outer-bad"),
        "trust_create": str(trust / "base-outer-bad"),
        "outer_allowed": str(outer_sibling / "base-outer-allowed"),
        "python": str(python),
        "direct_code": direct_code,
        "direct_marker": str(direct_marker),
        "raw_stdin_hex": RAW_STDIN.hex(),
        "proof_barrier": str(workspace / "proof-barrier.json"),
        "gate_go": str(workspace / "gate-go"),
    }
    envelope.write_text(json.dumps(payload, sort_keys=True), encoding="utf-8")
    base_env = dict(env)
    base_env.pop("NORTROPIC_STAGING_ROOT", None)
    base_env.pop("NORTROPIC_RESULT_SINK", None)
    before_roots = runtime_roots()
    argv = [
        str(python), "-I", "-S", "-B", str(CLI), "run", str(workspace),
        str(envelope), "15", "--", str(python), "-I", "-S", "-B", str(outer_script),
    ]
    proc = subprocess.Popen(
        argv, cwd=workspace, env=base_env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
    )
    barrier_path = Path(payload["proof_barrier"])
    barrier_ready = wait_file(barrier_path, 12)
    proof: dict[str, Any] = {}
    runtime_observation: dict[str, Any] = {}
    runtime_binding = False
    effects_before_go = False
    protected_before_go = False
    target_absent_before_go = not direct_marker.exists()
    if barrier_ready:
        try:
            barrier = strict_json(barrier_path.read_bytes())
            wire_hex = barrier.get("proof_wire_hex") if isinstance(barrier, dict) else None
            if isinstance(wire_hex, str):
                wire_proof = strict_json(bytes.fromhex(wire_hex))
                if isinstance(wire_proof, dict) and wire_proof == barrier.get("proof"):
                    proof = wire_proof
            child_pid = proof.get("child_pid")
            if type(child_pid) is int and child_pid > 1:
                runtime_binding, runtime_observation = barrier_runtime_observation(
                    before_roots, child_pid,
                    allowed_directory_identities=path_identities(
                        [ROOT, trust, base, workspace, child, outer_sibling,
                         live_canary],
                    ),
                )
            effects_before_go = scratch.is_file() and not scratch.is_symlink() \
                and scratch.read_bytes() == PROOF_BYTES
            protected_before_go = all(unchanged(ops) for ops in protected_ops.values())
            target_absent_before_go = barrier.get("target_before_go") is False \
                and not direct_marker.exists()
            Path(payload["gate_go"]).write_bytes(b"GO\n")
        except (OSError, Rig, ValueError):
            pass
    try:
        stdout, stderr = proc.communicate(timeout=35)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        stdout, stderr = proc.communicate(timeout=5)
    after_roots = runtime_roots()
    detail: dict[str, Any] = {
        "rc": proc.returncode,
        "stderr": stderr.decode("utf-8", "replace")[:500],
        "barrier_ready": barrier_ready,
        "runtime_observation": runtime_observation,
        "effects_before_go": effects_before_go,
        "protected_before_go": protected_before_go,
        "target_absent_before_go": target_absent_before_go,
        "runtime_delta": sorted(after_roots - before_roots),
    }
    try:
        observed = strict_json(stdout)
    except Rig as exc:
        return False, {**detail, "parse": str(exc), "stdout": stdout[:300].decode("utf-8", "replace")}
    if not isinstance(observed, dict):
        return False, detail
    outer = observed.get("outer", {})
    proof_effects = proof.get("effects", {}) if isinstance(proof, dict) else {}
    proof_core = dict(proof)
    proof_digest = proof_core.pop("proof_digest", None)
    proof_ok = (
        sorted(proof.keys()) == CONFIG_STATIC["protocol"]["proof_response_keys"]
        and proof.get("schema_version") == 1 and type(proof.get("schema_version")) is int
        and proof.get("class") == "profile-proof-v1"
        and proof.get("profile_sha256") == PROFILE_BASE_SHA256
        and proof.get("request_nonce") == PROOF_NONCE
        and proof.get("session_id") == outer.get("lineage", {}).get("session")
        and type(proof.get("child_euid")) is int
        and proof.get("child_euid") == os.geteuid()
        and type(proof.get("child_pid")) is int and proof.get("child_pid", -1) > 1
        and type(proof.get("child_pidversion")) is int
        and proof.get("child_pidversion", -1) >= 0
        and isinstance(proof_digest, str)
        and re.fullmatch(r"[0-9a-f]{64}", proof_digest) is not None
        and canonical_sha(proof_core) == proof_digest
        and isinstance(proof_effects, dict)
        and sorted(proof_effects) == BASE_PROOF_EFFECT_KEYS
        and all(type(proof_effects.get(key)) is int and proof_effects.get(key) == errno.EPERM
                for key in DENIED_BASE_PROOF_EFFECT_KEYS)
        and proof_effects.get("scratch_write_sha256") == PROOF_BYTES_SHA256
    )
    exact_helper = runtime_binding
    direct: dict[str, Any] = {}
    direct_first = False
    try:
        lines = direct_marker.read_text(encoding="utf-8").splitlines()
        direct_first = lines[0] == "TARGET_STARTED" and len(lines) == 2
        candidate = strict_json(lines[1].encode())
        if isinstance(candidate, dict):
            direct = candidate
    except (OSError, IndexError, Rig):
        pass
    outer_lineage = outer.get("lineage", {}) if isinstance(outer, dict) else {}
    direct_lineage = direct.get("lineage", {}) if isinstance(direct, dict) else {}
    try:
        outer_level = int(outer_lineage.get("level", ""))
    except (TypeError, ValueError):
        outer_level = -2
    lineage_ok = (
        isinstance(outer_lineage.get("capability"), str)
        and isinstance(direct_lineage.get("capability"), str)
        and re.fullmatch(r"[0-9a-f]{64}", outer_lineage["capability"]) is not None
        and re.fullmatch(r"[0-9a-f]{64}", direct_lineage["capability"]) is not None
        and outer_lineage["capability"] != direct_lineage["capability"]
        and outer_lineage.get("session") == direct_lineage.get("session")
        and re.fullmatch(r"[0-9a-f]{64}", str(outer_lineage.get("session", ""))) is not None
        and re.fullmatch(r"0|[1-9][0-9]*", str(outer_lineage.get("level", ""))) is not None
        and str(direct_lineage.get("level", "")) == str(outer_level + 1)
    )
    captured = observed.get("captured", {})
    final = observed.get("final", {})
    expected_stdio = observed.get("stdio_identity")
    helper_stdio = [
        role.get("dev_ino")
        for role in sorted(
            (value for value in runtime_observation.get("helper_fd_roles", [])
             if value.get("fd") in {0, 1, 2}),
            key=lambda value: value["fd"],
        )
    ]
    stdio_identity_ok = (
        isinstance(expected_stdio, list) and len(expected_stdio) == 3
        and len({tuple(value) for value in expected_stdio if isinstance(value, list)}) == 3
        and direct.get("stdio_identity") == expected_stdio
        and helper_stdio == expected_stdio
    )
    protected_after = all(unchanged(ops) for ops in protected_ops.values())
    kuvert = direct.get("kuvert", {}) if isinstance(direct, dict) else {}
    kuvert_ok = (
        isinstance(kuvert, dict) and kuvert.get("same_stdin") is True
        and kuvert.get("sha256") == sha(RAW_STDIN) and kuvert.get("absolute") is True
        and isinstance(kuvert.get("path"), str)
        and kuvert["path"].startswith("/private/tmp/.nortropic-h036-runtime-")
        and kuvert["path"] != str(envelope)
        and kuvert.get("mode") in {"0o400", "0o440", "0o444"}
        and kuvert.get("nlink") == 1 and kuvert.get("symlink") is False
    )
    ok = (
        proc.returncode == 0 and after_roots == before_roots
        and barrier_ready and target_absent_before_go and effects_before_go
        and protected_before_go and protected_after and proof_ok and exact_helper
        and isinstance(final, dict) and final.get("class") == "success"
        and captured == {
            "stdout": {"hex": RAW_STDOUT.hex(), "eof": True},
            "stderr": {"hex": RAW_STDERR.hex(), "eof": True},
        }
        and isinstance(outer, dict) and outer.get("live") == errno.EPERM
        and outer.get("trust") == errno.EPERM and outer.get("allowed") == 0
        and outer.get("bad_env") == []
        and direct_first and direct.get("trust") == errno.EPERM
        and direct.get("ancestor") == errno.EPERM and direct.get("bad_env") == []
        and direct.get("internal_env")
            == CONFIG_STATIC["target_environment"]["add_exact"][1:]
        and direct.get("path") == "/usr/bin:/bin"
        and target_fd_namespace_closed(direct)
        and stdio_identity_ok and lineage_ok and kuvert_ok
        and not (live_canary / "base-outer-bad").exists()
        and not (trust / "base-outer-bad").exists()
        and not (trust / "base-direct-bad").exists()
        and not (outer_sibling / "base-direct-bad").exists()
        and not scratch.exists()
    )
    detail.update({
        "profile_receipt_and_effects": proof_ok,
        "exact_helper_argv_environment": exact_helper,
        "lineage": lineage_ok,
        "authority_identity": {
            "session": outer_lineage.get("session") if isinstance(outer_lineage, dict) else None,
            "capabilities": [
                outer_lineage.get("capability") if isinstance(outer_lineage, dict) else None,
                direct_lineage.get("capability") if isinstance(direct_lineage, dict) else None,
            ],
            "runtime_root": runtime_observation.get("runtime_root"),
            "runtime_root_identity": runtime_observation.get("runtime_root_identity"),
            "socket": runtime_observation.get("socket"),
        },
        "captured_stdio": captured,
        "preserved_stdio_identity": stdio_identity_ok,
        "protected_after": protected_after,
    })
    return ok, detail


def primary_composition_case(
    base: Path, python: Path, workspace: Path, child: Path, trust: Path,
    envelope: Path, env: dict[str, str], live_canary: Path,
) -> tuple[bool, dict[str, Any]]:
    outer_script = workspace / "outer.py"
    inner_script = child / "inner.py"
    child_envelope = child / "envelope.json"
    outer_script.write_text(OUTER_FIXTURE, encoding="utf-8")
    inner_script.write_text(INNER_FIXTURE, encoding="utf-8")
    child_envelope.write_text("{}", encoding="utf-8")
    raw_child = workspace / "raw-child"
    raw_child.mkdir()
    same_envelope = workspace / "same-envelope.json"
    proof_prefix = f".nortropic-h036-proof-{PROOF_NONCE}"

    def denied_ops(root: Path, family: str) -> dict[str, list[str]]:
        result: dict[str, list[str]] = {}
        prefix = f"{proof_prefix}-{family}"
        for name in ("write", "rename", "unlink", "hardlink"):
            source = root / f"{prefix}-{name}-source"
            source.write_text("ORIGINAL", encoding="utf-8")
            source.chmod(0o600)
            if name == "write":
                result[name] = [str(source)]
            elif name == "rename":
                result[name] = [str(source), str(root / f"{prefix}-rename-target")]
            elif name == "unlink":
                result[name] = [str(source)]
            else:
                result[name] = [str(source), str(root / f"{prefix}-hardlink-target")]
        result["create"] = [str(root / f"{prefix}-created")]
        result["mkdir"] = [str(root / f"{prefix}-new-dir")]
        result["chmod"] = [result["write"][0]]
        return result
    protected_ops = {
        "live": denied_ops(live_canary, "live"),
        "trust": denied_ops(trust, "trust"),
    }
    outer_sibling = workspace / "outer-sibling"
    outer_sibling.mkdir()
    ancestor_sources = denied_ops(outer_sibling, "ancestor")
    staging = Path(env["NORTROPIC_STAGING_ROOT"])
    sink = Path(env["NORTROPIC_RESULT_SINK"])
    if sink.parent != staging or not staging.is_dir():
        raise Rig("gate staging/sink fixture identity")
    sink.write_text("EMPTY", encoding="utf-8")
    sink.chmod(0o600)
    sink_initial = sink.stat()
    staging_mode_before = staging.stat().st_mode & 0o777
    if (not stat.S_ISREG(sink_initial.st_mode) or sink.is_symlink()
            or sink_initial.st_nlink != 1):
        raise Rig("gate sink fixture must be nofollow regular nlink1")
    staging_sources = denied_ops(staging, "staging")
    scratch = raw_child / f"{proof_prefix}.allowed"
    request_marker_root = raw_child / "request-markers"
    request_marker_root.mkdir()
    direct_marker = request_marker_root / "valid"
    caller_path_canary = trust / "caller-selected-result"
    direct_code = (
        "import errno,hashlib,json,os,pathlib,resource,sys;"
        "marker=pathlib.Path(sys.argv[1]);"
        "\ntry:fd=os.open(marker,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)"
        "\nexcept FileExistsError:"
        "\n repeat=marker.parent/('unexpected-repeat-'+str(os.getpid()));repeat.write_text('SPAWNED');raise"
        "\nos.write(fd,b'TARGET_STARTED\\n');os.fsync(fd);os.close(fd);"
        "raw=sys.stdin.buffer.read();fd_soft_limit=resource.getrlimit(resource.RLIMIT_NOFILE)[0];fds=[];"
        "\nfor token in os.listdir('/dev/fd'):"
        "\n if token.isdecimal() and int(token)>=3:"
        "\n  try:os.fstat(int(token));fds.append(int(token))"
        "\n  except OSError:pass"
        "\nfds=sorted(set(fds))"
        "\nkuvert=pathlib.Path(os.environ.get('NORTROPIC_KUVERT',''));kr=b'';km=None;kn=None"
        "\ntry:"
        "\n kfd=os.open(kuvert,os.O_RDONLY|os.O_NOFOLLOW);kst=os.fstat(kfd);km=oct(kst.st_mode&0o777);kn=kst.st_nlink"
        "\n while True:"
        "\n  part=os.read(kfd,65536)"
        "\n  if not part:break"
        "\n  kr+=part"
        "\n os.close(kfd)"
        "\nexcept OSError:pass"
        "\ntarget=pathlib.Path(" + repr(str(outer_sibling / "direct-escape")) + ")"
        "\ntry:target.write_text('BAD');denied=0"
        "\nexcept OSError as exc:denied=exc.errno"
        "\nbad=[key for key in os.environ if key.startswith(('DYLD_','GIT_','GH_','GITHUB_','PYTHON','SLACK_')) or key in {'LD_PRELOAD','LD_LIBRARY_PATH','NORTROPIC_TRUST_ROOT','NORTROPIC_STAGING_ROOT','NORTROPIC_RESULT_SINK','__PYVENV_LAUNCHER__'}]"
        "\nout={'event':'TARGET_STARTED','denied':denied,'bad_env':sorted(bad),'internal_env':sorted(key for key in os.environ if key.startswith('NORTROPIC_H036_')),'fd_soft_limit':fd_soft_limit,'open_fds':fds,'stdio_identity':[[os.fstat(number).st_dev,os.fstat(number).st_ino] for number in (0,1,2)],'lineage':{'capability':os.environ.get('NORTROPIC_H036_CAPABILITY'),'session':os.environ.get('NORTROPIC_H036_SESSION_ID'),'level':os.environ.get('NORTROPIC_H036_LEVEL')},'kuvert':{'path':str(kuvert),'absolute':kuvert.is_absolute(),'same_stdin':kr==raw,'sha256':hashlib.sha256(kr).hexdigest(),'mode':km,'nlink':kn,'symlink':kuvert.is_symlink()}}"
        "\nwith marker.open('a',encoding='utf-8') as stream:stream.write(json.dumps(out,sort_keys=True,separators=(',',':'))+'\\n')"
        "\nsys.stdout.buffer.write(bytes.fromhex(" + repr(RAW_STDOUT.hex()) + "));sys.stdout.buffer.flush()"
        "\nsys.stderr.buffer.write(bytes.fromhex(" + repr(RAW_STDERR.hex()) + "));sys.stderr.buffer.flush()"
    )
    try:
        compile(direct_code, "h036-direct-fixture", "exec")
    except SyntaxError as exc:
        raise Rig(f"direct fixture syntax: {exc}") from exc
    outside = base / "cwd-symlink-outside"
    outside.mkdir()
    escape_link = raw_child / "escape-link"
    escape_link.symlink_to(outside, target_is_directory=True)
    outside_effect = outside / "outside-effect"
    symlink_code = (
        "import pathlib;pathlib.Path('outside-effect').write_text('BAD')"
    )
    inner_payload = {
        "target_started": str(child / "inner-target-started"),
        "trust_direct": str(trust / "inner-direct-target-bad"),
        "outer_sibling_direct": str(outer_sibling / "descendant-inner-bad"),
    }
    child_envelope.write_text(json.dumps(inner_payload, sort_keys=True), encoding="utf-8")
    same_payload = {
        "target_started": str(workspace / "same-target-started"),
        "trust_direct": str(trust / "same-direct-target-bad"),
        "outer_sibling_direct": str(outer_sibling / "same-workspace-allowed"),
    }
    same_envelope.write_text(json.dumps(same_payload, sort_keys=True), encoding="utf-8")
    payload = {
        "live_create": str(live_canary / "outer-create"),
        "trust_create": str(trust / "outer-create"),
        "staging_create": str(staging / "outer-create"),
        "outer_before": str(outer_sibling / "outer-before"),
        "outer_started": str(workspace / "outer-target-started"),
        "proof_barrier": str(workspace / "proof-barrier.json"),
        "gate_go": str(workspace / "gate-go"),
        "direct_marker": str(direct_marker),
        "request_marker_root": str(request_marker_root),
        "python": str(python),
        "cli": str(CLI),
        "workspace": str(workspace),
        "child": str(child),
        "child_envelope": str(child_envelope),
        "same_envelope": str(same_envelope),
        "inner": str(inner_script),
        "direct_code": direct_code,
        "symlink_code": symlink_code,
        "caller_path_canary": str(caller_path_canary),
        "raw_stdin_hex": RAW_STDIN.hex(),
        "trust": str(trust),
        "absent_marker": str(raw_child / "absent-session-target-bad"),
    }
    envelope.write_text(json.dumps(payload, sort_keys=True), encoding="utf-8")
    before_roots = runtime_roots()
    launch_argv = [
        str(python), "-I", "-S", "-B", str(CLI), "run", str(workspace),
        str(envelope), "15", "--", str(python), "-I", "-S", "-B", str(outer_script),
    ]
    occupied_fds: list[int] = []
    occupied_numbers: set[int] = set()
    try:
        for _index in range(12):
            occupied_fds.append(os.open(
                "/dev/null", os.O_RDONLY | getattr(os, "O_CLOEXEC", 0),
            ))
        occupied_numbers = set(occupied_fds)
        if occupied_numbers != set(range(3, 15)):
            raise Rig(
                "occupied-low-fd host fixture requires a clean 0/1/2 gate baseline"
            )
        proc = subprocess.Popen(
            launch_argv, cwd=workspace, env=env, stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
            close_fds=True, pass_fds=tuple(occupied_fds),
        )
    finally:
        for occupied_fd in occupied_fds:
            os.close(occupied_fd)
    barrier_path = Path(payload["proof_barrier"])
    barrier_ready = wait_file(barrier_path, 12)
    barrier: dict[str, Any] = {}
    proof: dict[str, Any] = {}
    runtime_observation: dict[str, Any] = {}
    runtime_binding = False
    proof_effects_before_go = False
    protected_before_go = False
    target_absent_before_go = not direct_marker.exists()

    def ops_unchanged(ops: dict[str, list[str]]) -> bool:
        source_keys = ("write", "rename", "unlink", "hardlink")
        try:
            return (
                all(Path(ops[key][0]).read_text(encoding="utf-8") == "ORIGINAL"
                    for key in source_keys)
                and not Path(ops["create"][0]).exists()
                and not Path(ops["mkdir"][0]).exists()
                and not Path(ops["rename"][1]).exists()
                and not Path(ops["hardlink"][1]).exists()
                and (Path(ops["chmod"][0]).stat().st_mode & 0o777) == 0o600
            )
        except OSError:
            return False

    if barrier_ready:
        try:
            candidate = strict_json(barrier_path.read_bytes())
            if isinstance(candidate, dict):
                barrier = candidate
            wire_hex = barrier.get("proof_wire_hex")
            if isinstance(wire_hex, str):
                wire_proof = strict_json(bytes.fromhex(wire_hex))
                if isinstance(wire_proof, dict) and wire_proof == barrier.get("proof"):
                    proof = wire_proof
            child_pid = proof.get("child_pid")
            if type(child_pid) is int and child_pid > 1:
                runtime_binding, runtime_observation = barrier_runtime_observation(
                    before_roots, child_pid,
                    occupied_launcher_fds=occupied_numbers,
                    require_10_29=True,
                    allowed_directory_identities=path_identities(
                        [ROOT, trust, base, workspace, child, raw_child,
                         outer_sibling, staging, live_canary],
                    ),
                    allowed_regular_identities=path_identities([sink]),
                )
            proof_effects_before_go = (
                scratch.is_file() and not scratch.is_symlink()
                and scratch.read_bytes() == PROOF_BYTES
                and sink.read_bytes() == PROOF_BYTES
            )
            protected_before_go = (
                all(ops_unchanged(ops) for ops in protected_ops.values())
                and ops_unchanged(ancestor_sources)
                and ops_unchanged(staging_sources)
                and staging.is_dir()
                and (staging.stat().st_mode & 0o777) == staging_mode_before
                and not (base / "staging-renamed").exists()
            )
            target_absent_before_go = (
                barrier.get("target_before_go") is False
                and not direct_marker.exists()
            )
            Path(payload["gate_go"]).write_bytes(b"GO\n")
        except (OSError, Rig, ValueError):
            pass
    try:
        stdout, stderr = proc.communicate(timeout=35)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        stdout, stderr = proc.communicate(timeout=5)
    run = subprocess.CompletedProcess(launch_argv, proc.returncode, stdout, stderr)
    after_roots = runtime_roots()
    detail: dict[str, Any] = {
        "rc": run.returncode,
        "stderr": run.stderr.decode("utf-8", "replace")[:500],
        "runtime_root_delta": sorted(after_roots - before_roots),
        "occupied_launcher_fds": sorted(occupied_numbers),
        "barrier_ready": barrier_ready,
        "proof_effects_before_go": proof_effects_before_go,
        "protected_before_go": protected_before_go,
        "target_absent_before_go": target_absent_before_go,
        "runtime_observation": runtime_observation,
    }
    try:
        observed = strict_json(run.stdout)
    except Rig as exc:
        detail["stdout"] = run.stdout[:500].decode("utf-8", "replace")
        detail["parse"] = str(exc)
        return False, detail
    if not isinstance(observed, dict):
        return False, detail
    outer = observed.get("outer", {})
    protocol = observed.get("protocol", {})
    negative = observed.get("negative", {})
    try:
        inner = strict_json(observed.get("nested_stdout", "").encode())
    except (AttributeError, Rig):
        inner = {}
    try:
        same_inner = strict_json(observed.get("same_stdout", "").encode())
    except (AttributeError, Rig):
        same_inner = {}
    stale = observed.get("stale", {})
    detail["observed_summary"] = {
        "outer": outer,
        "protocol_classes": {
            key: (value.get("class") if isinstance(value, dict) else str(value)[:60])
            for key, value in protocol.items()
        } if isinstance(protocol, dict) else {},
        "nested_rc": observed.get("nested_rc"),
        "same_rc": observed.get("same_rc"),
        "negative": negative,
    }
    stale_socket = Path(stale.get("socket", "/nonexistent")) if isinstance(stale, dict) else Path("/nonexistent")
    stale_connect_rejected = not stale_socket.exists()
    if stale_socket.exists():
        try:
            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            probe.settimeout(1)
            probe.connect(str(stale_socket))
        except OSError:
            stale_connect_rejected = True
        else:
            stale_connect_rejected = False
            probe.close()
    stale_env = dict(env)
    if isinstance(stale, dict):
        stale_env.update({
            "NORTROPIC_H036_SOCKET": str(stale.get("socket", "")),
            "NORTROPIC_H036_SESSION_ID": str(stale.get("session", "")),
            "NORTROPIC_H036_CAPABILITY": str(stale.get("capability", "")),
            "NORTROPIC_H036_LEVEL": str(stale.get("level", "")),
        })
    stale_run = launch(python, child, child_envelope, "2", ["/usr/bin/true"], stale_env, outer_timeout=8)
    denied_effect_keys = [
        *DENIED_BASE_PROOF_EFFECT_KEYS, *DENIED_STAGING_PROOF_EFFECT_KEYS,
    ]
    proof_effects = proof.get("effects", {}) if isinstance(proof, dict) else {}
    all_denied = isinstance(proof_effects, dict) and all(
        type(proof_effects.get(key)) is int
        and proof_effects.get(key) == errno.EPERM
        for key in denied_effect_keys
    ) and sorted(proof_effects) == STAGING_PROOF_EFFECT_KEYS
    proof_core = dict(proof) if isinstance(proof, dict) else {}
    proof_digest = proof_core.pop("proof_digest", None)
    proof_shape = (
        sorted(proof.keys()) == CONFIG_STATIC["protocol"]["proof_response_keys"]
        and proof.get("schema_version") == 1
        and type(proof.get("schema_version")) is int
        and proof.get("class") == "profile-proof-v1"
        and proof.get("profile_sha256") == PROFILE_SHA256
        and proof.get("request_nonce") == PROOF_NONCE
        and proof.get("session_id") == outer.get("lineage", {}).get("session")
        and type(proof.get("child_euid")) is int
        and proof.get("child_euid") == os.geteuid()
        and type(proof.get("child_pid")) is int
        and proof.get("child_pid", -1) > 1
        and type(proof.get("child_pidversion")) is int
        and proof.get("child_pidversion", -1) >= 0
        and isinstance(proof_digest, str)
        and re.fullmatch(r"[0-9a-f]{64}", proof_digest) is not None
        and canonical_sha(proof_core) == proof_digest
        and proof_effects.get("scratch_write_sha256") == PROOF_BYTES_SHA256
        and proof_effects.get("sink_write_sha256") == PROOF_BYTES_SHA256
    )
    exact_helper = runtime_binding
    protected_unchanged = (
        all(ops_unchanged(ops) for ops in protected_ops.values())
        and ops_unchanged(ancestor_sources)
        and ops_unchanged(staging_sources)
        and sink.read_text(encoding="utf-8") == "EMPTY"
        and (sink.stat().st_mode & 0o777) == 0o600
        and sink.stat().st_nlink == 1
        and not (staging / "sink-hardlink").exists()
        and not (staging / "sink-renamed").exists()
        and staging.is_dir()
        and (staging.stat().st_mode & 0o777) == staging_mode_before
        and not (base / "staging-renamed").exists()
    )
    semantic_rejections = (
        "replay", "forged", "cross_session", "random_capability_guess",
        "random_session_guess", "wrong_peer_pid", "wrong_peer_euid",
        "wrong_peer_pidversion", "peer_pid_bool", "peer_euid_bool",
        "peer_pidversion_bool", "peer_pid_float", "peer_euid_float",
        "peer_pidversion_float", "root_key", "profile_key", "caller_path", "outside",
        "missing_cwd", "cwd_slash", "cwd_empty", "schema_bool", "cap_type",
        "schema_float", "wrong_operation",
        "cap_length", "cap_upper", "session_type",
        "session_length", "nonce_type", "nonce_length", "envelope_mismatch",
        "envelope_type", "envelope_float", "stdin_mismatch",
        "argv_empty", "argv_nul", "argv_container", "timeout_bool", "timeout_float",
        "timeout_negative", "timeout_over", "request_nan", "request_pos_inf",
        "request_neg_inf", "env_duplicate", "env_reserved",
        "env_sensitive", "env_nul", "env_value_type", "env_container",
        "cwd_nested_container", "cwd_symlink",
        "fd_0", "fd_2", "fd_4",
    )
    malformed_rejections = (
        "duplicate_json", "oversize_header", "partial_header", "partial_envelope",
        "trailing_bytes",
    )
    missing_header_rejections = tuple(
        "missing_" + key for key in CONFIG_STATIC["protocol"]["header_keys"]
    )
    go_rejections = tuple(
        "go_" + name for name in (
            "missing_operation", "missing_proof_digest", "missing_request_nonce",
            "missing_schema_version", "wrong_operation", "wrong_nonce",
            "wrong_digest", "wrong_schema", "schema_bool", "schema_float",
            "schema_nan", "schema_pos_inf", "schema_neg_inf", "extra", "duplicate",
        )
    )
    go_protocol_ok = all(
        isinstance(protocol.get(name), dict)
        and isinstance(protocol[name].get("proof"), dict)
        and protocol[name]["proof"].get("class") == "profile-proof-v1"
        and protocol[name].get("target_before_go") is False
        and protocol[name].get("target_after_reject") is False
        and isinstance(protocol[name].get("final"), dict)
        and protocol[name]["final"].get("class") == "request-rejected-v1"
        for name in go_rejections
    ) if isinstance(protocol, dict) else False
    valid_protocol = protocol.get("valid", {}) if isinstance(protocol, dict) else {}
    protocol_ok = isinstance(protocol, dict) \
        and isinstance(valid_protocol, dict) \
        and valid_protocol.get("proof") == proof \
        and valid_protocol.get("target_before_go") is False \
        and isinstance(valid_protocol.get("final"), dict) \
        and valid_protocol["final"].get("class") == "success" \
        and valid_protocol.get("stdout") == {"hex": RAW_STDOUT.hex(), "eof": True} \
        and valid_protocol.get("stderr") == {"hex": RAW_STDERR.hex(), "eof": True} \
        and all(rejected_response(protocol.get(name)) for name in (
            *semantic_rejections, *missing_header_rejections, *malformed_rejections,
        )) \
        and go_protocol_ok \
        and protocol.get("disconnect") == "disconnected" \
        and sorted(path.name for path in request_marker_root.iterdir()) == ["valid"] \
        and not outside_effect.exists()
    direct: dict[str, Any] = {}
    direct_first = False
    try:
        direct_lines = direct_marker.read_text(encoding="utf-8").splitlines()
        direct_first = direct_lines[0] == "TARGET_STARTED" and len(direct_lines) == 2
        parsed_direct = strict_json(direct_lines[1].encode())
        if isinstance(parsed_direct, dict):
            direct = parsed_direct
    except (OSError, IndexError, Rig):
        pass

    def lineage(value: Any) -> tuple[str, str, int] | None:
        if not isinstance(value, dict):
            return None
        cap = value.get("capability")
        session = value.get("session")
        level = value.get("level")
        if not isinstance(cap, str) or re.fullmatch(r"[0-9a-f]{64}", cap) is None:
            return None
        if not isinstance(session, str) or re.fullmatch(r"[0-9a-f]{64}", session) is None:
            return None
        if not isinstance(level, str) or re.fullmatch(r"0|[1-9][0-9]*", level) is None:
            return None
        return cap, session, int(level)

    outer_lineage = lineage(outer.get("lineage"))
    inner_lineage = lineage(inner.get("lineage")) if isinstance(inner, dict) else None
    same_lineage = lineage(same_inner.get("lineage")) if isinstance(same_inner, dict) else None
    direct_lineage = lineage(direct.get("lineage"))
    lineage_ok = (
        outer_lineage is not None and inner_lineage is not None
        and same_lineage is not None and direct_lineage is not None
        and len({outer_lineage[0], inner_lineage[0], same_lineage[0], direct_lineage[0]}) == 4
        and inner_lineage[1] == outer_lineage[1] == direct_lineage[1] == same_lineage[1]
        and inner_lineage[2] == outer_lineage[2] + 1
        and same_lineage[2] == outer_lineage[2] + 1
        and direct_lineage[2] == outer_lineage[2] + 1
    )

    def kuvert_ok(value: Any, raw: bytes, caller: Path) -> bool:
        if not isinstance(value, dict):
            return False
        path = value.get("path")
        return (
            isinstance(path, str) and path.startswith("/private/tmp/.nortropic-h036-runtime-")
            and path != str(caller)
            and value.get("absolute") is True
            and value.get("same_stdin") is True
            and value.get("sha256") == sha(raw)
            and value.get("mode") in {"0o400", "0o440", "0o444"}
            and value.get("nlink") == 1
            and value.get("symlink") is False
        )

    env_ok = (
        isinstance(inner, dict) and isinstance(same_inner, dict)
        and outer.get("bad_env") == [] and inner.get("bad_env") == []
        and same_inner.get("bad_env") == [] and direct.get("bad_env") == []
        and outer.get("internal_env")
            == CONFIG_STATIC["target_environment"]["add_exact"][1:]
        and inner.get("internal_env")
            == CONFIG_STATIC["target_environment"]["add_exact"][1:]
        and same_inner.get("internal_env")
            == CONFIG_STATIC["target_environment"]["add_exact"][1:]
        and direct.get("internal_env")
            == CONFIG_STATIC["target_environment"]["add_exact"][1:]
        and outer.get("preserved") == "preserved-exact-value"
        and inner.get("preserved") == "preserved-exact-value"
        and same_inner.get("preserved") == "preserved-exact-value"
        and outer.get("path") == "/usr/bin:/bin"
        and inner.get("path") == "/usr/bin:/bin"
        and same_inner.get("path") == "/usr/bin:/bin"
        and target_fd_namespace_closed(outer)
        and target_fd_namespace_closed(inner)
        and target_fd_namespace_closed(same_inner)
        and target_fd_namespace_closed(direct)
    )
    kuverts_ok = (
        kuvert_ok(outer.get("kuvert"), envelope.read_bytes(), envelope)
        and kuvert_ok(inner.get("kuvert"), child_envelope.read_bytes(), child_envelope)
        and kuvert_ok(same_inner.get("kuvert"), same_envelope.read_bytes(), same_envelope)
        and kuvert_ok(direct.get("kuvert"), RAW_STDIN, envelope)
    )
    expected_stdio = valid_protocol.get("stdio_identity") \
        if isinstance(valid_protocol, dict) else None
    helper_stdio = [
        role.get("dev_ino")
        for role in sorted(
            (value for value in runtime_observation.get("helper_fd_roles", [])
             if value.get("fd") in {0, 1, 2}),
            key=lambda value: value["fd"],
        )
    ]
    helper_stdio_identity_ok = (
        isinstance(expected_stdio, list) and len(expected_stdio) == 3
        and helper_stdio == expected_stdio
        and direct.get("stdio_identity") == expected_stdio
    )
    ok = (
        run.returncode == 0
        and observed.get("nested_rc") == 0
        and outer.get("live_create") == errno.EPERM
        and outer.get("trust_create") == errno.EPERM
        and outer.get("staging_create") == errno.EPERM
        and outer.get("sibling_before") == 0
        and outer.get("target_started") == "TARGET_STARTED\n"
        and outer.get("runtime_mode") == "0o500"
        and outer.get("socket_mode") == "0o600"
        and barrier_ready and target_absent_before_go
        and proof_effects_before_go and protected_before_go
        and proof_shape and exact_helper
        and all_denied
        and protected_unchanged
        and inner.get("nested_rc") == 71
        and "sandbox_apply: Operation not permitted" in inner.get("nested_stderr", "")
        and inner.get("target_started") == "TARGET_STARTED\n"
        and inner.get("direct_trust_errno") == errno.EPERM
        and inner.get("direct_outer_sibling_errno") == errno.EPERM
        and not (outer_sibling / "descendant-inner-bad").exists()
        and observed.get("same_rc") == 0
        and same_inner.get("target_started") == "TARGET_STARTED\n"
        and same_inner.get("direct_trust_errno") == errno.EPERM
        and same_inner.get("direct_outer_sibling_errno") == 0
        and (outer_sibling / "same-workspace-allowed").read_bytes() == b""
        and direct_first and direct.get("denied") == errno.EPERM
        and helper_stdio_identity_ok
        and isinstance(direct.get("stdio_identity"), list)
        and len(direct["stdio_identity"]) == 3
        and len({tuple(value) for value in direct["stdio_identity"]
                 if isinstance(value, list)}) == 3
        and type(observed.get("pid")) is int and type(inner.get("pid")) is int
        and observed.get("pid") != inner.get("pid")
        and type(observed.get("nested_client_pid")) is int
        and observed.get("nested_client_pid") not in {observed.get("pid"), inner.get("pid")}
        and type(observed.get("same_client_pid")) is int
        and observed.get("same_client_pid") not in {
            observed.get("pid"), inner.get("pid"), same_inner.get("pid"),
            observed.get("nested_client_pid"),
        }
        and protocol_ok and lineage_ok and kuverts_ok
        and all(isinstance(negative.get(name), dict) and negative[name].get("rc") == 3
                for name in ("missing", "wrong"))
        and isinstance(negative.get("all_markers_absent"), dict)
        and negative["all_markers_absent"].get("rc") == 3
        and negative["all_markers_absent"].get("marker") is False
        and negative["all_markers_absent"].get("runtime_same") is True
        and "sandbox_apply: Operation not permitted" in (
            str(negative["all_markers_absent"].get("stdout", ""))
            + str(negative["all_markers_absent"].get("stderr", ""))
        )
        and not caller_path_canary.exists()
        and stale_connect_rejected
        and stale_run.returncode == 3
        and after_roots == before_roots
        and not (live_canary / "outer-create").exists()
        and not (trust / "outer-create").exists()
        and not (staging / "outer-create").exists()
        and not (workspace / "missing-cwd").exists()
        and not outside_effect.exists()
        and not scratch.exists()
    )
    detail.update({
        "profile_lineage_effects": all_denied,
        "protected_effects_unchanged": protected_unchanged,
        "strict_protocol": protocol_ok,
        "proof_shape_and_exact_helper": proof_shape and exact_helper,
        "causal_pre_go_effects": proof_effects_before_go and protected_before_go
            and target_absent_before_go,
        "fresh_subset_lineage": lineage_ok,
        "authority_identity": {
            "session": outer_lineage[1] if outer_lineage is not None else None,
            "capabilities": [
                value[0] if value is not None else None
                for value in (outer_lineage, inner_lineage, same_lineage, direct_lineage)
            ],
            "runtime_root": runtime_observation.get("runtime_root"),
            "runtime_root_identity": runtime_observation.get("runtime_root_identity"),
            "socket": runtime_observation.get("socket"),
        },
        "kuvert_binding": kuverts_ok,
        "closed_target_env_fds": env_ok,
        "helper_stdio_pipe_roles_match_scm_and_target": helper_stdio_identity_ok,
        "stale_rejected": stale_connect_rejected and stale_run.returncode == 3,
    })
    return ok and env_ok, detail


def later_top_identity_case(
    base: Path, python: Path, workspace: Path, envelope: Path, env: dict[str, str],
) -> tuple[bool, dict[str, Any]]:
    """Create a third top-level session and bind its fresh runtime/socket."""
    report = workspace / "later-top-identity.json"
    release = workspace / "later-top-release"
    script = base / "later-top-identity.py"
    script.write_text(
        "import json,os,pathlib,time\n"
        "socket_path=pathlib.Path(os.environ['NORTROPIC_H036_SOCKET']);root=socket_path.parent\n"
        "root_stat=root.lstat();socket_stat=socket_path.lstat()\n"
        "record={'capability':os.environ['NORTROPIC_H036_CAPABILITY'],'level':os.environ['NORTROPIC_H036_LEVEL'],'runtime_root':str(root),'runtime_root_identity':[root_stat.st_dev,root_stat.st_ino],'session':os.environ['NORTROPIC_H036_SESSION_ID'],'socket':str(socket_path),'socket_identity':[socket_stat.st_dev,socket_stat.st_ino]}\n"
        "pathlib.Path(" + repr(str(report)) + ").write_text(json.dumps(record,sort_keys=True,separators=(',',':')))\n"
        "deadline=time.monotonic()+8\n"
        "while time.monotonic()<deadline and not pathlib.Path(" + repr(str(release)) + ").is_file():time.sleep(0.01)\n"
        "raise SystemExit(0 if pathlib.Path(" + repr(str(release)) + ").is_file() else 9)\n",
        encoding="utf-8",
    )
    before = runtime_roots()
    argv = [
        str(python), "-I", "-S", "-B", str(CLI), "run", str(workspace),
        str(envelope), "12", "--", str(python), "-I", "-S", "-B", str(script),
    ]
    proc = subprocess.Popen(
        argv, cwd=workspace, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
    )
    ready = wait_file(report, 10)
    record: dict[str, Any] = {}
    during = runtime_roots() - before
    if ready:
        try:
            candidate = strict_json(report.read_bytes())
            if isinstance(candidate, dict):
                record = candidate
        except Rig:
            pass
        release.write_bytes(b"GO\n")
    try:
        stdout, stderr = proc.communicate(timeout=15)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        stdout, stderr = proc.communicate(timeout=5)
    root_path = Path(str(record.get("runtime_root", "/nonexistent")))
    socket_path = Path(str(record.get("socket", "/nonexistent")))
    shape = (
        ready and proc.returncode == 0 and len(during) == 1
        and str(root_path) == next(iter(during))
        and root_path.parent == Path("/private/tmp")
        and root_path.name.startswith(".nortropic-h036-runtime-")
        and socket_path.parent == root_path
        and isinstance(record.get("session"), str)
        and re.fullmatch(r"[0-9a-f]{64}", record["session"]) is not None
        and isinstance(record.get("capability"), str)
        and re.fullmatch(r"[0-9a-f]{64}", record["capability"]) is not None
        and record.get("level") == "0"
        and isinstance(record.get("runtime_root_identity"), list)
        and len(record["runtime_root_identity"]) == 2
        and isinstance(record.get("socket_identity"), list)
        and len(record["socket_identity"]) == 2
        and runtime_roots() == before and not root_path.exists() and not socket_path.exists()
    )
    return shape, {
        "rc": proc.returncode,
        "ready": ready,
        "record": record,
        "during_runtime_delta": sorted(during),
        "runtime_clean": runtime_roots() == before,
        "stdout": stdout.decode("utf-8", "replace")[:200],
        "stderr": stderr.decode("utf-8", "replace")[:200],
    }


def simple_lifecycle_cases(
    base: Path, python: Path, workspace: Path, envelope: Path, env: dict[str, str], trust: Path,
) -> tuple[bool, dict[str, Any]]:
    scripts = base / "lifecycle"
    scripts.mkdir()
    exact = scripts / "exact.py"
    exact.write_text("import sys;sys.stdout.buffer.write(b'H036-STDOUT-\\x00-\\xff\\n')\n", encoding="utf-8")
    success_before = runtime_roots()
    success = launch(
        python, workspace, envelope, "5",
        [str(python), "-I", "-S", "-B", str(exact)], env,
    )
    success_clean = runtime_roots() == success_before

    def outcome_case(name: str, action: str, timeout: str) -> tuple[
        subprocess.CompletedProcess[bytes], dict[str, int], bool,
    ]:
        ready = workspace / f"{name}-processes.json"
        script = scripts / f"{name}.py"
        script.write_text(
            "import json,os,pathlib,signal,subprocess,sys,time\n"
            "child=subprocess.Popen(['/bin/sleep','30'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,close_fds=True)\n"
            "pathlib.Path(" + repr(str(ready)) + ").write_text(json.dumps({'leader':os.getpid(),'child':child.pid},sort_keys=True))\n"
            "action=" + repr(action) + "\n"
            "if action=='nonzero':raise SystemExit(7)\n"
            "if action=='signal':os.kill(os.getpid(),signal.SIGTERM)\n"
            "time.sleep(30)\n",
            encoding="utf-8",
        )
        before = runtime_roots()
        run = launch(
            python, workspace, envelope, timeout,
            [str(python), "-I", "-S", "-B", str(script)], env,
            outer_timeout=18,
        )
        record: dict[str, int] = {}
        try:
            candidate = strict_json(ready.read_bytes())
            if isinstance(candidate, dict) and all(
                    type(candidate.get(key)) is int for key in ("leader", "child")):
                record = {"leader": candidate["leader"], "child": candidate["child"]}
        except (OSError, Rig):
            pass
        gone = bool(record) and all(wait_pid_gone(pid) for pid in record.values())
        return run, record, gone and runtime_roots() == before

    nonzero, nonzero_pids, nonzero_clean = outcome_case("nonzero", "nonzero", "5")
    signaled, signaled_pids, signaled_clean = outcome_case("self-sigterm", "signal", "5")
    timeout, timeout_pids, timeout_clean = outcome_case("timeout", "timeout", "0.4")
    missing_before = runtime_roots()
    missing = launch(python, workspace, envelope, "5", [str(base / "absent-command")], env)
    missing_clean = runtime_roots() == missing_before
    group_script = scripts / "group.py"
    group_script.write_text(
        "import subprocess,sys; p=subprocess.Popen(['/bin/sleep','30'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,close_fds=True);print(p.pid,flush=True)\n",
        encoding="utf-8",
    )
    group_before = runtime_roots()
    group = launch(python, workspace, envelope, "5", [str(python), "-I", "-S", "-B", str(group_script)], env)
    try:
        group_pid = int(group.stdout.strip())
    except ValueError:
        group_pid = -1
    escaped_marker = workspace / "setsid-result.json"
    escaped_identity = workspace / "setsid-identity.json"
    escaped = scripts / "setsid.py"
    escaped.write_text(
        "import errno,json,os,pathlib,socket,struct,time\n"
        "runtime=pathlib.Path(os.environ['NORTROPIC_KUVERT']).parent;held=os.open(os.environ['NORTROPIC_KUVERT'],os.O_RDONLY|os.O_NOFOLLOW)\n"
        "pid=os.fork()\n"
        "if pid:\n print(pid,flush=True);raise SystemExit(0)\n"
        "os.setsid();null=os.open('/dev/null',os.O_RDWR)\n"
        "for fd in (0,1,2):os.dup2(null,fd)\n"
        "if null>2:os.close(null)\n"
        "a,b=socket.socketpair();audit=struct.unpack('=8I',a.getsockopt(0,6,32));a.close();b.close()\n"
        "identity={'capability':os.environ['NORTROPIC_H036_CAPABILITY'],'euid':os.geteuid(),'lineage':'setsid-confined-target-v1','level':os.environ['NORTROPIC_H036_LEVEL'],'pgid':os.getpgrp(),'pid':os.getpid(),'pidversion':audit[7],'session':os.environ['NORTROPIC_H036_SESSION_ID'],'sid':os.getsid(0)}\n"
        "pathlib.Path(" + repr(str(escaped_identity)) + ").write_text(json.dumps(identity,sort_keys=True))\n"
        "time.sleep(0.8);out={}\n"
        "for key,path in " + repr({
            "trust": str(trust / "setsid-bad"),
            "live": str(ROOT / ".h036-setsid-bad"),
        }) + ".items():\n"
        " try:pathlib.Path(path).write_text('BAD');out[key]=0\n"
        " except OSError as exc:out[key]=exc.errno\n"
        "try:os.write(held,b'BAD');out['runtime_fd_write']=0\n"
        "except OSError as exc:out['runtime_fd_write']=exc.errno\n"
        "try:(runtime/'late-bad').write_text('BAD');out['runtime_path_create']=0\n"
        "except OSError as exc:out['runtime_path_create']=exc.errno\n"
        "os.close(held)\n"
        "out['socket_exists']=pathlib.Path(os.environ.get('NORTROPIC_H036_SOCKET','/absent')).exists()\n"
        "pathlib.Path(" + repr(str(escaped_marker)) + ").write_text(json.dumps(out,sort_keys=True))\n"
        "time.sleep(0.5)\n",
        encoding="utf-8",
    )
    setsid_before = runtime_roots()
    setsid_run = launch(python, workspace, envelope, "5", [str(python), "-I", "-S", "-B", str(escaped)], env)
    try:
        escaped_pid = int(setsid_run.stdout.strip())
    except ValueError:
        escaped_pid = -1
    harmless_ready = wait_file(escaped_marker)
    harmless = strict_json(escaped_marker.read_bytes()) if harmless_ready else {}
    setsid_identity_ready = wait_file(escaped_identity)
    try:
        setsid_identity = strict_json(escaped_identity.read_bytes()) \
            if setsid_identity_ready else {}
    except Rig:
        setsid_identity = {}
    setsid_process = process_start_record(escaped_pid) if escaped_pid > 0 else None
    setsid_bound = (
        isinstance(setsid_identity, dict) and isinstance(setsid_process, dict)
        and setsid_identity.get("pid") == escaped_pid
        and setsid_identity.get("pid") == setsid_process.get("pid")
        and setsid_identity.get("pgid") == setsid_process.get("pgid")
        and setsid_identity.get("sid") == setsid_process.get("sid")
        and setsid_identity.get("euid") == setsid_process.get("euid") == os.geteuid()
        and type(setsid_identity.get("pidversion")) is int
        and setsid_identity.get("pidversion", -1) >= 0
        and setsid_identity.get("lineage") == "setsid-confined-target-v1"
        and isinstance(setsid_identity.get("session"), str)
        and re.fullmatch(r"[0-9a-f]{64}", setsid_identity["session"]) is not None
        and isinstance(setsid_identity.get("capability"), str)
        and re.fullmatch(r"[0-9a-f]{64}", setsid_identity["capability"]) is not None
    )
    setsid_gone = setsid_bound and wait_pid_gone(escaped_pid)
    setsid_absence_samples = []
    for _sample in range(2):
        setsid_absence_samples.append(escaped_pid > 0 and not pid_alive(escaped_pid))
        time.sleep(0.05)
    interrupt_ready = workspace / "controller-interrupt-ready.json"
    interrupt_worker = scripts / "controller-interrupt.py"
    interrupt_worker.write_text(
        "import json,os,pathlib,socket,subprocess,time\n"
        "child=subprocess.Popen(['/bin/sleep','30'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,close_fds=True)\n"
        "s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.connect(os.environ['NORTROPIC_H036_SOCKET']);supervisor=int.from_bytes(s.getsockopt(0,2,4),'little',signed=True);s.close()\n"
        "pathlib.Path(" + repr(str(interrupt_ready)) + ").write_text(json.dumps({'leader':os.getpid(),'child':child.pid,'supervisor':supervisor,'socket':os.environ['NORTROPIC_H036_SOCKET'],'session':os.environ['NORTROPIC_H036_SESSION_ID'],'capability':os.environ['NORTROPIC_H036_CAPABILITY'],'level':os.environ['NORTROPIC_H036_LEVEL']},sort_keys=True))\n"
        "time.sleep(30)\n",
        encoding="utf-8",
    )
    interrupt_before = runtime_roots()
    interrupt_argv = [
        str(python), "-I", "-S", "-B", str(CLI), "run", str(workspace),
        str(envelope), "30", "--", str(python), "-I", "-S", "-B",
        str(interrupt_worker),
    ]
    interrupt_proc = subprocess.Popen(
        interrupt_argv, cwd=workspace, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
    )
    interrupt_record: dict[str, Any] = {}
    interrupt_ready_seen = wait_file(interrupt_ready, 10)
    if interrupt_ready_seen:
        try:
            candidate = strict_json(interrupt_ready.read_bytes())
            if isinstance(candidate, dict):
                interrupt_record = candidate
        except Rig:
            pass
        try:
            os.kill(interrupt_proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    try:
        interrupt_stdout, interrupt_stderr = interrupt_proc.communicate(timeout=12)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(interrupt_proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        interrupt_stdout, interrupt_stderr = interrupt_proc.communicate(timeout=5)
    interrupt_known = [
        interrupt_record.get(key) for key in ("leader", "child", "supervisor")
        if type(interrupt_record.get(key)) is int
    ]
    interrupt_gone = len(interrupt_known) == 3 and len(set(interrupt_known)) == 3 and all(
        wait_pid_gone(pid) for pid in interrupt_known
    )
    interrupt_socket = Path(str(interrupt_record.get("socket", "/nonexistent")))
    handoff_refused = not interrupt_socket.exists()
    if interrupt_socket.exists():
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        probe.settimeout(1)
        try:
            probe.connect(str(interrupt_socket))
        except OSError:
            handoff_refused = True
        else:
            handoff_refused = False
        finally:
            probe.close()
    stale_interrupt = None
    if interrupt_record:
        stale_env = dict(env)
        stale_env.update({
            "NORTROPIC_H036_SOCKET": str(interrupt_record.get("socket", "")),
            "NORTROPIC_H036_SESSION_ID": str(interrupt_record.get("session", "")),
            "NORTROPIC_H036_CAPABILITY": str(interrupt_record.get("capability", "")),
            "NORTROPIC_H036_LEVEL": str(interrupt_record.get("level", "")),
        })
        stale_interrupt = launch(
            python, workspace, envelope, "2", ["/usr/bin/true"], stale_env,
            outer_timeout=8,
        ).returncode
    interrupt_clean = (
        interrupt_ready_seen and interrupt_proc.returncode != 0 and interrupt_gone
        and handoff_refused and stale_interrupt == 3
        and runtime_roots() == interrupt_before and not interrupt_socket.exists()
    )

    detail = {
        "success_rc": success.returncode,
        "success_stdout_sha256": sha(success.stdout),
        "success_clean": success_clean,
        "nonzero_rc": nonzero.returncode,
        "nonzero_pids": nonzero_pids,
        "nonzero_clean": nonzero_clean,
        "signal_rc": signaled.returncode,
        "signal_pids": signaled_pids,
        "signal_clean": signaled_clean,
        "launch_rc": missing.returncode,
        "launch_clean": missing_clean,
        "group_pid": group_pid,
        "success_group_clean": runtime_roots() == group_before,
        "timeout_rc": timeout.returncode,
        "timeout_pids": timeout_pids,
        "timeout_clean": timeout_clean,
        "setsid_pid": escaped_pid,
        "setsid_identity": setsid_identity,
        "setsid_start_identity": setsid_process,
        "setsid_identity_bound": setsid_bound,
        "setsid_effect": harmless,
        "setsid_fixture_gone": setsid_gone,
        "setsid_absence_samples": setsid_absence_samples,
        "setsid_runtime_clean": runtime_roots() == setsid_before,
        "controller_interrupt": {
            "ready": interrupt_ready_seen,
            "launcher_rc": interrupt_proc.returncode,
            "known_pids": interrupt_known,
            "known_pids_gone": interrupt_gone,
            "handoff_refused": handoff_refused,
            "stale_rc": stale_interrupt,
            "runtime_clean": runtime_roots() == interrupt_before,
            "stdout": interrupt_stdout.decode("utf-8", "replace")[:200],
            "stderr": interrupt_stderr.decode("utf-8", "replace")[:200],
        },
    }
    ok = (
        success.returncode == 0 and success.stdout == b"H036-STDOUT-\x00-\xff\n"
        and success_clean
        and nonzero.returncode == 4 and b"nonzero_exit:" in nonzero.stdout
        and nonzero_clean
        and signaled.returncode == 4 and b"nonzero_exit:" in signaled.stdout
        and signaled_clean
        and missing.returncode == 3 and b"launch_failed:" in missing.stdout
        and missing_clean
        and group.returncode == 0 and group_pid > 0 and wait_pid_gone(group_pid)
        and runtime_roots() == group_before
        and timeout.returncode == 5 and b"timeout:" in timeout.stdout
        and timeout_clean
        and setsid_run.returncode == 0 and harmless_ready and setsid_gone
        and all(setsid_absence_samples)
        and harmless.get("live") == errno.EPERM
        and harmless.get("trust") == errno.EPERM
        and harmless.get("runtime_fd_write") == errno.EBADF
        and harmless.get("runtime_path_create") in {errno.EPERM, errno.ENOENT}
        and harmless.get("socket_exists") is False
        and runtime_roots() == setsid_before
        and interrupt_clean
    )
    return ok, detail


def negative_identity_and_overlap_cases(
    base: Path, python: Path, workspace: Path, envelope: Path, env: dict[str, str], trust: Path,
    live_canary: Path,
) -> tuple[bool, dict[str, Any]]:
    marker = workspace / "negative-marker"
    command = [str(python), "-I", "-S", "-B", "-c",
               "import pathlib;pathlib.Path(" + repr(str(marker)) + ").write_text('BAD')"]
    overlap_env = dict(env)
    overlap_env["NORTROPIC_TRUST_ROOT"] = str(workspace)
    overlap = launch(python, workspace, envelope, "3", command, overlap_env)
    no_sink_env = dict(env)
    no_sink_env.pop("NORTROPIC_STAGING_ROOT", None)
    no_sink_env.pop("NORTROPIC_RESULT_SINK", None)
    no_sink = launch(python, workspace, envelope, "3", ["/usr/bin/true"], no_sink_env)
    staging_only_env = dict(env)
    staging_only_env.pop("NORTROPIC_RESULT_SINK", None)
    staging_only = launch(python, workspace, envelope, "3", command, staging_only_env)
    sink_only_env = dict(env)
    sink_only_env.pop("NORTROPIC_STAGING_ROOT", None)
    sink_only = launch(python, workspace, envelope, "3", command, sink_only_env)
    trust_sink = trust / "overlap-result"
    trust_sink.write_text("ORIGINAL", encoding="utf-8")
    staging_trust_env = dict(env)
    staging_trust_env["NORTROPIC_STAGING_ROOT"] = str(trust)
    staging_trust_env["NORTROPIC_RESULT_SINK"] = str(trust_sink)
    staging_trust = launch(python, workspace, envelope, "3", command, staging_trust_env)
    workspace_sink = workspace / "overlap-result"
    workspace_sink.write_text("ORIGINAL", encoding="utf-8")
    staging_workspace_env = dict(env)
    staging_workspace_env["NORTROPIC_STAGING_ROOT"] = str(workspace)
    staging_workspace_env["NORTROPIC_RESULT_SINK"] = str(workspace_sink)
    staging_workspace = launch(python, workspace, envelope, "3", command, staging_workspace_env)
    valid_staging = base / "negative-staging"
    valid_staging.mkdir()
    outside_sink = base / "outside-staging-result"
    outside_sink.write_text("ORIGINAL", encoding="utf-8")
    outside_sink_env = dict(env)
    outside_sink_env["NORTROPIC_STAGING_ROOT"] = str(valid_staging)
    outside_sink_env["NORTROPIC_RESULT_SINK"] = str(outside_sink)
    outside_sink_run = launch(python, workspace, envelope, "3", command, outside_sink_env)
    symlink_target = base / "symlink-target"
    symlink_target.write_text("ORIGINAL", encoding="utf-8")
    symlink_sink = valid_staging / "symlink-result"
    symlink_sink.symlink_to(symlink_target)
    symlink_sink_env = dict(env)
    symlink_sink_env["NORTROPIC_STAGING_ROOT"] = str(valid_staging)
    symlink_sink_env["NORTROPIC_RESULT_SINK"] = str(symlink_sink)
    symlink_sink_run = launch(python, workspace, envelope, "3", command, symlink_sink_env)
    missing_sink_env = dict(env)
    missing_sink_env["NORTROPIC_STAGING_ROOT"] = str(valid_staging)
    missing_sink_env["NORTROPIC_RESULT_SINK"] = str(valid_staging / "missing-result")
    missing_sink_run = launch(python, workspace, envelope, "3", command, missing_sink_env)
    directory_sink = valid_staging / "directory-result"
    directory_sink.mkdir()
    directory_sink_env = dict(env)
    directory_sink_env["NORTROPIC_STAGING_ROOT"] = str(valid_staging)
    directory_sink_env["NORTROPIC_RESULT_SINK"] = str(directory_sink)
    directory_sink_run = launch(python, workspace, envelope, "3", command, directory_sink_env)
    hardlink_source = valid_staging / "hardlink-source"
    hardlink_source.write_text("ORIGINAL", encoding="utf-8")
    hardlink_sink = valid_staging / "hardlink-result"
    os.link(hardlink_source, hardlink_sink)
    hardlink_sink_env = dict(env)
    hardlink_sink_env["NORTROPIC_STAGING_ROOT"] = str(valid_staging)
    hardlink_sink_env["NORTROPIC_RESULT_SINK"] = str(hardlink_sink)
    hardlink_sink_run = launch(python, workspace, envelope, "3", command, hardlink_sink_env)
    live_overlap_sink = live_canary / "staging-overlap-result"
    live_overlap_sink.write_text("ORIGINAL", encoding="utf-8")
    live_overlap_env = dict(env)
    live_overlap_env["NORTROPIC_STAGING_ROOT"] = str(live_canary)
    live_overlap_env["NORTROPIC_RESULT_SINK"] = str(live_overlap_sink)
    live_overlap_run = launch(python, workspace, envelope, "3", command, live_overlap_env)
    descendant_staging = workspace / "descendant-staging"
    descendant_staging.mkdir()
    descendant_sink = descendant_staging / "result"
    descendant_sink.write_text("ORIGINAL", encoding="utf-8")
    descendant_env = dict(env)
    descendant_env["NORTROPIC_STAGING_ROOT"] = str(descendant_staging)
    descendant_env["NORTROPIC_RESULT_SINK"] = str(descendant_sink)
    descendant_overlap = launch(python, workspace, envelope, "3", command, descendant_env)
    staging_symlink_target = base / "staging-symlink-target"
    staging_symlink_target.mkdir()
    staging_symlink_sink = staging_symlink_target / "result"
    staging_symlink_sink.write_text("ORIGINAL", encoding="utf-8")
    staging_symlink_root = base / "staging-symlink-root"
    staging_symlink_root.symlink_to(staging_symlink_target, target_is_directory=True)
    staging_symlink_env = dict(env)
    staging_symlink_env["NORTROPIC_STAGING_ROOT"] = str(staging_symlink_root)
    staging_symlink_env["NORTROPIC_RESULT_SINK"] = str(staging_symlink_root / "result")
    staging_symlink_run = launch(
        python, workspace, envelope, "3", command, staging_symlink_env,
    )
    overlap_matrix: dict[str, Any] = {}

    def overlap_case(name: str, staging_root: Path, result_sink: Path) -> None:
        root_opened = staging_root.stat()
        sink_opened = result_sink.lstat()
        before_bytes = result_sink.read_bytes()
        before_mode = sink_opened.st_mode & 0o777
        case_env = dict(env)
        case_env["NORTROPIC_STAGING_ROOT"] = str(staging_root)
        case_env["NORTROPIC_RESULT_SINK"] = str(result_sink)
        run = launch(python, workspace, envelope, "3", command, case_env)
        after = result_sink.lstat()
        overlap_matrix[name] = {
            "rc": run.returncode,
            "root_canonical": str(staging_root.resolve()),
            "root_dev_ino": [root_opened.st_dev, root_opened.st_ino],
            "sink_canonical": str(result_sink.resolve()),
            "sink_dev_ino": [sink_opened.st_dev, sink_opened.st_ino],
            "unchanged": (
                result_sink.read_bytes() == before_bytes
                and (after.st_dev, after.st_ino) == (sink_opened.st_dev, sink_opened.st_ino)
                and (after.st_mode & 0o777) == before_mode
                and after.st_nlink == sink_opened.st_nlink
            ),
        }

    trust_descendant_root = trust / "descendant-staging"
    trust_descendant_root.mkdir()
    trust_descendant_sink = trust_descendant_root / "result"
    trust_descendant_sink.write_text("ORIGINAL", encoding="utf-8")
    overlap_case("staging_under_trust", trust_descendant_root, trust_descendant_sink)
    enclosing_sink = base / "enclosing-workspace-trust-result"
    enclosing_sink.write_text("ORIGINAL", encoding="utf-8")
    overlap_case("staging_encloses_workspace_and_trust", base, enclosing_sink)
    live_root_sink = ROOT / "README.md"
    overlap_case("staging_is_live_and_encloses_git", ROOT, live_root_sink)
    common_raw = str(git("rev-parse", "--git-common-dir", text=True)).strip()
    common_git = Path(common_raw)
    if not common_git.is_absolute():
        common_git = (ROOT / common_git).resolve()
    git_sink = common_git / "HEAD"
    overlap_case("staging_is_git_common_dir", common_git, git_sink)
    runtime_sink_fd, runtime_sink_raw = tempfile.mkstemp(
        prefix="h036-runtime-parent-overlap-", dir="/private/tmp",
    )
    os.write(runtime_sink_fd, b"ORIGINAL")
    os.fsync(runtime_sink_fd)
    os.close(runtime_sink_fd)
    runtime_parent_sink = Path(runtime_sink_raw)
    try:
        overlap_case("staging_encloses_private_runtime", Path("/private/tmp"), runtime_parent_sink)
        runtime_parent_unchanged = overlap_matrix[
            "staging_encloses_private_runtime"
        ]["unchanged"]
    finally:
        safe_remove_tree(runtime_parent_sink)
    overlap_matrix["staging_encloses_private_runtime"]["sink_removed_by_gate"] = \
        not runtime_parent_sink.exists()
    overlap_matrix_ok = (
        len(overlap_matrix) == 5
        and all(value.get("rc") == 3 and value.get("unchanged") is True
                for value in overlap_matrix.values())
        and runtime_parent_unchanged and not runtime_parent_sink.exists()
    )
    outside = base / "outside-workspace"
    outside.mkdir()
    # A complete inherited marker with no capability is fail-closed and may
    # never become a fresh raw bootstrap.
    incomplete_env = dict(env)
    incomplete_env.update({
        "NORTROPIC_H036_SESSION_ID": "11" * 32,
        "NORTROPIC_H036_SOCKET": str(base / "missing.sock"),
        "NORTROPIC_H036_LEVEL": "1",
    })
    incomplete = launch(python, workspace, envelope, "3", command, incomplete_env)
    missing_workspace = base / "public-missing-workspace"
    missing_workspace_marker = workspace / "missing-workspace-target-bad"
    missing_workspace_before = runtime_roots()
    missing_workspace_run = subprocess.run(
        [str(python), "-I", "-S", "-B", str(CLI), "run", str(missing_workspace),
         str(envelope), "3", "--", str(python), "-I", "-S", "-B", "-c",
         "import pathlib;pathlib.Path(" + repr(str(missing_workspace_marker))
         + ").write_text('BAD')"],
        cwd=workspace, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=8, check=False,
    )
    missing_workspace_clean = (
        not missing_workspace.exists() and not missing_workspace_marker.exists()
        and runtime_roots() == missing_workspace_before
    )
    canonical_source = launch(
        PYTHON_SOURCE, workspace, envelope, "3", ["/usr/bin/true"], env,
    )
    relocated = base / "relocated-cli"
    shutil.copyfile(CLI, relocated)
    relocated.chmod(0o500)
    relocated_run = subprocess.run(
        [str(python), "-I", "-S", "-B", str(relocated), "run", str(workspace),
         str(envelope), "3", "--", *command],
        cwd=workspace, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=8, check=False,
    )
    system_python = subprocess.run(
        ["/usr/bin/python3", "-I", "-S", "-B", str(CLI), "run", str(workspace),
         str(envelope), "3", "--", *command],
        cwd=workspace, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=8, check=False,
    )
    wrong_mode_root = base / "wrong-mode-authority"
    wrong_mode_python = make_python_snapshot(wrong_mode_root)
    wrong_mode_python.parent.chmod(0o700)
    wrong_mode = launch(
        wrong_mode_python, workspace, envelope, "3", command, env,
    )
    wrong_file_mode_root = base / "wrong-file-mode-authority"
    wrong_file_mode_python = make_python_snapshot(wrong_file_mode_root)
    wrong_file_mode_python.parent.chmod(0o700)
    wrong_file_mode_python.chmod(0o700)
    wrong_file_mode_python.parent.chmod(0o500)
    wrong_file_mode = launch(
        wrong_file_mode_python, workspace, envelope, "3", command, env,
    )
    wrong_digest_root = base / "wrong-digest-authority"
    wrong_digest_python = make_python_snapshot(wrong_digest_root)
    wrong_digest_python.parent.chmod(0o700)
    wrong_digest_python.chmod(0o700)
    with wrong_digest_python.open("ab") as stream:
        stream.write(b"H036-WRONG-DIGEST")
        stream.flush()
        os.fsync(stream.fileno())
    wrong_digest_python.chmod(0o500)
    wrong_digest_python.parent.chmod(0o500)
    wrong_digest = launch(
        wrong_digest_python, workspace, envelope, "3", command, env,
    )
    symlink_authority = base / "symlink-authority"
    symlink_authority.mkdir(mode=0o700)
    symlink_python = symlink_authority / "python3.12"
    symlink_python.symlink_to(python)
    symlink_authority.chmod(0o500)
    symlink_runtime = launch(
        symlink_python, workspace, envelope, "3", command, env,
    )
    override_marker = base / "override-helper-ran"
    override_helper = base / "override-helper.py"
    override_helper.write_text(
        "import pathlib;pathlib.Path(" + repr(str(override_marker))
        + ").write_text('BAD')\n",
        encoding="utf-8",
    )
    override_config = base / "override-config.json"
    override_config.write_text('{"schema_version":999}', encoding="utf-8")
    override_profile = base / "override-profile.sb"
    override_profile.write_text("(version 1)\n(allow default)\n", encoding="utf-8")
    override_env = dict(env)
    override_env.update({
        "NORTROPIC_H036_HELPER_OVERRIDE": str(override_helper),
        "NORTROPIC_H036_CONFIG_OVERRIDE": str(override_config),
        "NORTROPIC_H036_PROFILE_OVERRIDE": str(override_profile),
        "NORTROPIC_H036_LIVE_ROOT_OVERRIDE": str(base),
    })
    ignored_overrides = launch(
        python, workspace, envelope, "3",
        [str(python), "-I", "-S", "-B", "-c",
         "import json,os;print(json.dumps(sorted(k for k in os.environ if k.startswith('NORTROPIC_H036_'))))"],
        override_env,
    )
    try:
        ignored_override_env = strict_json(ignored_overrides.stdout)
    except Rig:
        ignored_override_env = None
    variant_root = base / "quote-'\"-line\n-unicode-雪"
    variant_workspace = variant_root / "workspace"
    variant_trust = variant_root / "trust"
    variant_workspace.mkdir(parents=True)
    variant_trust.mkdir()
    variant_envelope = variant_root / "envelope.json"
    variant_envelope.write_text("{}", encoding="utf-8")
    variant_env = dict(env)
    variant_env["NORTROPIC_TRUST_ROOT"] = str(variant_trust)
    variant_env.pop("NORTROPIC_STAGING_ROOT", None)
    variant_env.pop("NORTROPIC_RESULT_SINK", None)
    quoted_unicode = launch(
        python, variant_workspace, variant_envelope, "3", ["/usr/bin/true"],
        variant_env,
    )
    alias_parent = Path("/private/var/tmp")
    alias_result: int | None = None
    alias_effect_ok = False
    alias_overlap_result: int | None = None
    alias_overlap_unchanged = False
    if alias_parent.is_dir():
        alias_root = Path(tempfile.mkdtemp(prefix="h036-var-alias-", dir=alias_parent))
        try:
            alias_workspace = alias_root / "workspace"
            alias_workspace.mkdir()
            alias_staging = alias_root / "staging"
            alias_staging.mkdir()
            alias_sink = alias_staging / "result.json"
            alias_sink.write_text("ORIGINAL", encoding="utf-8")
            alias_sink.chmod(0o600)
            alias_envelope = alias_root / "envelope.json"
            alias_envelope.write_text("{}", encoding="utf-8")
            alias_arg = Path(str(alias_workspace).replace("/private/var/", "/var/", 1))
            alias_env = dict(env)
            alias_env["NORTROPIC_STAGING_ROOT"] = str(alias_staging).replace(
                "/private/var/", "/var/", 1)
            alias_env["NORTROPIC_RESULT_SINK"] = str(alias_sink).replace(
                "/private/var/", "/var/", 1)
            alias_workspace_effect = alias_workspace / "allowed-effect"
            alias_workspace_arg = Path(str(alias_workspace_effect).replace(
                "/private/var/", "/var/", 1))
            alias_sink_arg = Path(str(alias_sink).replace("/private/var/", "/var/", 1))
            alias_code = (
                "import json,pathlib,sys;"
                "pathlib.Path(sys.argv[1]).write_bytes(b'ALIAS-WORKSPACE');"
                "pathlib.Path(sys.argv[2]).write_bytes(b'ALIAS-SINK');"
                "print(json.dumps({'cwd':str(pathlib.Path.cwd().resolve()),"
                "'workspace':str(pathlib.Path(sys.argv[1]).resolve()),"
                "'sink':str(pathlib.Path(sys.argv[2]).resolve())},sort_keys=True))"
            )
            alias_run = launch(
                python, alias_arg, alias_envelope, "3",
                [str(python), "-I", "-S", "-B", "-c", alias_code,
                 str(alias_workspace_arg), str(alias_sink_arg)], alias_env,
            )
            alias_result = alias_run.returncode
            try:
                alias_observed = strict_json(alias_run.stdout)
            except Rig:
                alias_observed = {}
            alias_effect_ok = (
                alias_workspace_effect.read_bytes() == b"ALIAS-WORKSPACE"
                and alias_sink.read_bytes() == b"ALIAS-SINK"
                and isinstance(alias_observed, dict)
                and alias_observed.get("cwd") == str(alias_workspace)
                and alias_observed.get("workspace") == str(alias_workspace_effect)
                and alias_observed.get("sink") == str(alias_sink)
            )
            alias_overlap_sink = alias_workspace / "overlap-result"
            alias_overlap_sink.write_text("ORIGINAL", encoding="utf-8")
            alias_overlap_env = dict(env)
            alias_overlap_env["NORTROPIC_TRUST_ROOT"] = str(alias_root / "trust")
            (alias_root / "trust").mkdir()
            alias_overlap_env["NORTROPIC_STAGING_ROOT"] = str(alias_arg)
            alias_overlap_env["NORTROPIC_RESULT_SINK"] = str(
                alias_overlap_sink).replace("/private/var/", "/var/", 1)
            alias_overlap_marker = alias_workspace / "alias-overlap-target-bad"
            alias_overlap = launch(
                python, alias_workspace, alias_envelope, "3",
                [str(python), "-I", "-S", "-B", "-c",
                 "import pathlib;pathlib.Path(" + repr(str(alias_overlap_marker))
                 + ").write_text('BAD')"], alias_overlap_env,
            )
            alias_overlap_result = alias_overlap.returncode
            alias_overlap_unchanged = (
                alias_overlap_sink.read_text(encoding="utf-8") == "ORIGINAL"
                and not alias_overlap_marker.exists()
            )
        finally:
            safe_remove_tree(alias_root)
    negative_sinks_unchanged = (
        all(path.read_text(encoding="utf-8") == "ORIGINAL" for path in (
            trust_sink, workspace_sink, outside_sink, symlink_target,
            hardlink_source, hardlink_sink, live_overlap_sink,
            descendant_sink, staging_symlink_sink,
        ))
        and symlink_sink.is_symlink()
        and not (valid_staging / "missing-result").exists()
        and directory_sink.is_dir()
        and hardlink_source.stat().st_nlink == 2
        and hardlink_sink.stat().st_nlink == 2
    )
    detail = {
        "overlap": overlap.returncode,
        "optional_sink_absent": no_sink.returncode,
        "staging_only_rejected": staging_only.returncode,
        "sink_only_rejected": sink_only.returncode,
        "staging_trust_overlap": staging_trust.returncode,
        "staging_workspace_overlap": staging_workspace.returncode,
        "sink_outside_staging": outside_sink_run.returncode,
        "sink_symlink": symlink_sink_run.returncode,
        "sink_missing": missing_sink_run.returncode,
        "sink_nonregular": directory_sink_run.returncode,
        "sink_hardlink": hardlink_sink_run.returncode,
        "staging_live_overlap": live_overlap_run.returncode,
        "staging_workspace_descendant_overlap": descendant_overlap.returncode,
        "staging_root_symlink": staging_symlink_run.returncode,
        "canonical_devino_ancestor_descendant_overlap_matrix": overlap_matrix,
        "overlap_matrix_ok": overlap_matrix_ok,
        "negative_sinks_unchanged": negative_sinks_unchanged,
        "incomplete": incomplete.returncode,
        "public_missing_workspace": missing_workspace_run.returncode,
        "public_missing_workspace_clean": missing_workspace_clean,
        "canonical_python_source": canonical_source.returncode,
        "relocated": relocated_run.returncode,
        "system_python": system_python.returncode,
        "private_runtime_wrong_mode": wrong_mode.returncode,
        "private_python_wrong_mode_with_root_0500": wrong_file_mode.returncode,
        "private_runtime_wrong_digest": wrong_digest.returncode,
        "private_runtime_symlink": symlink_runtime.returncode,
        "ignored_authority_overrides": ignored_overrides.returncode,
        "ignored_override_target_internal_env": ignored_override_env,
        "override_helper_executed": override_marker.exists(),
        "quoted_newline_unicode_profile_parameters": quoted_unicode.returncode,
        "var_alias": alias_result,
        "var_alias_effect": alias_effect_ok,
        "var_private_overlap": alias_overlap_result,
        "var_private_overlap_unchanged": alias_overlap_unchanged,
        "marker": marker.exists(),
    }
    return (
        overlap.returncode == 3
        and no_sink.returncode == 0
        and staging_only.returncode == 3
        and sink_only.returncode == 3
        and staging_trust.returncode == 3
        and staging_workspace.returncode == 3
        and outside_sink_run.returncode == 3
        and symlink_sink_run.returncode == 3
        and missing_sink_run.returncode == 3
        and directory_sink_run.returncode == 3
        and hardlink_sink_run.returncode == 3
        and live_overlap_run.returncode == 3
        and descendant_overlap.returncode == 3
        and staging_symlink_run.returncode == 3
        and overlap_matrix_ok
        and negative_sinks_unchanged
        and incomplete.returncode == 3
        and missing_workspace_run.returncode == 1 and missing_workspace_clean
        and canonical_source.returncode == 0
        and relocated_run.returncode != 0
        and system_python.returncode != 0
        and wrong_mode.returncode == 3
        and wrong_file_mode.returncode == 3
        and wrong_digest.returncode == 3
        and symlink_runtime.returncode == 3
        and ignored_overrides.returncode == 0
        and ignored_override_env == CONFIG_STATIC["target_environment"]["add_exact"][1:]
        and not override_marker.exists()
        and quoted_unicode.returncode == 0
        and alias_result == 0 and alias_effect_ok
        and alias_overlap_result == 3 and alias_overlap_unchanged
        and not marker.exists()
    ), detail


def supervisor_death_case(
    python: Path, workspace: Path, envelope: Path, env: dict[str, str], base: Path,
) -> tuple[bool, dict[str, Any]]:
    ready = workspace / "supervisor-death-ready.json"
    worker = base / "supervisor-death.py"
    worker.write_text(
        "import json,os,pathlib,socket,subprocess,time\n"
        "child=subprocess.Popen(['/bin/sleep','30'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,close_fds=True)\n"
        "s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.connect(os.environ['NORTROPIC_H036_SOCKET'])\n"
        "server=int.from_bytes(s.getsockopt(0,2,4),'little',signed=True);s.close()\n"
        "pathlib.Path(" + repr(str(ready)) + ").write_text(json.dumps({'worker':os.getpid(),'child':child.pid,'supervisor':server,'socket':os.environ['NORTROPIC_H036_SOCKET']}));time.sleep(30)\n",
        encoding="utf-8",
    )
    before = runtime_roots()
    proc = subprocess.Popen(
        [str(python), "-I", "-S", "-B", str(CLI), "run", str(workspace),
         str(envelope), "30", "--", str(python), "-I", "-S", "-B", str(worker)],
        cwd=workspace, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
    )
    if not wait_file(ready, 8):
        try: os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError: pass
        proc.wait(timeout=5)
        return False, {"reason": "worker did not become ready"}
    record = strict_json(ready.read_bytes())
    supervisor = int(record["supervisor"])
    worker_pid = int(record["worker"])
    child_pid = int(record["child"])
    during_roots = runtime_roots() - before
    supervisor_argv, supervisor_env_evidence, supervisor_argv_bound = \
        process_argv_environment(supervisor)
    os.kill(supervisor, signal.SIGTERM)
    try:
        stdout, stderr = proc.communicate(timeout=12)
    except subprocess.TimeoutExpired:
        try: os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError: pass
        stdout, stderr = proc.communicate(timeout=5)
    worker_gone = wait_pid_gone(worker_pid)
    child_gone = wait_pid_gone(child_pid)
    supervisor_gone = wait_pid_gone(supervisor)
    after = runtime_roots()
    runtime_root = Path(next(iter(during_roots))) if len(during_roots) == 1 \
        else Path("/nonexistent")
    runtime_python = Path(supervisor_argv[0]) if supervisor_argv else Path("/nonexistent")
    runtime_python_ok, runtime_python_detail = stable_runtime_python(
        runtime_python, runtime_root,
    )
    detail = {
        "launcher_rc": proc.returncode,
        "stdout": stdout.decode("utf-8", "replace")[:300],
        "stderr": stderr.decode("utf-8", "replace")[:300],
        "worker_gone": worker_gone,
        "child_gone": child_gone,
        "supervisor_gone": supervisor_gone,
        "root_delta": sorted(after - before),
        "supervisor_argv": supervisor_argv,
        "runtime_python": runtime_python_detail,
    }
    exact_supervisor_argv = (
        len(supervisor_argv) == 10
        and supervisor_argv[:7] == [
            str(runtime_python), "-I", "-S", "-B", str(HELPER),
            "supervise-v1", "--control-fd",
        ]
        and supervisor_argv[8] == "--ready-fd"
        and valid_decimal_fd(supervisor_argv[7])
        and valid_decimal_fd(supervisor_argv[9])
        and supervisor_argv[7] != supervisor_argv[9]
    )
    environment_review_boundary = (
        supervisor_argv_bound
        and supervisor_env_evidence.get("exact_exec_environment_credit") is False
        and supervisor_env_evidence.get("dynamic_ps_environment_pass_predicate") is False
        and exact_supervisor_argv
        and runtime_python_ok and len(during_roots) == 1
    )
    return (
        proc.returncode != 0 and worker_gone and child_gone and supervisor_gone
        and after == before and not Path(record["socket"]).exists()
        and environment_review_boundary
    ), {
        **detail,
        "supervisor_environment_dynamic_credit": "NONE",
        "supervisor_kernel_argv_and_review_boundary": environment_review_boundary,
        "supervisor_environment_evidence": supervisor_env_evidence,
        "exact_environment_construction_credit": "IMMUTABLE_OBJECT_REVIEW_ONLY",
    }


def source_spelling_diagnostic() -> dict[str, Any]:
    """Non-credit hints for the separate immutable-object reviewer.

    Source spelling is neither necessary nor sufficient for product credit.
    Dynamic credit remains exclusively in the syscall and protocol matrices;
    independent review establishes reachability and stable-open ordering.
    """
    try:
        cli_raw = CLI.read_bytes()
        helper_raw = HELPER.read_bytes()
        cli_tree = ast.parse(cli_raw, filename=str(CLI))
        helper_tree = ast.parse(helper_raw, filename=str(HELPER))
    except (OSError, SyntaxError) as exc:
        return {"credit": "NONE", "reason": str(exc)}

    assignments: dict[str, Any] = {}
    for node in helper_tree.body:
        if isinstance(node, (ast.Assign, ast.AnnAssign)):
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            value_node = node.value
            for target in targets:
                if isinstance(target, ast.Name) and value_node is not None:
                    try:
                        assignments[target.id] = ast.literal_eval(value_node)
                    except (ValueError, TypeError):
                        pass
    exact_profiles = (
        assignments.get("PROFILE_TEMPLATE_BASE") == PROFILE_TEMPLATE_BASE
        and assignments.get("PROFILE_TEMPLATE_STAGING_SUFFIX")
            == PROFILE_TEMPLATE_STAGING_SUFFIX
    )
    profile_loads = {
        name: sum(isinstance(node, ast.Name) and node.id == name
                  and isinstance(node.ctx, ast.Load) for node in ast.walk(helper_tree))
        for name in ("PROFILE_TEMPLATE_BASE", "PROFILE_TEMPLATE_STAGING_SUFFIX")
    }

    trees = (cli_tree, helper_tree)
    constants = {
        node.value for tree in trees for node in ast.walk(tree)
        if isinstance(node, ast.Constant) and isinstance(node.value, str)
    }
    attributes = {
        node.attr for tree in trees for node in ast.walk(tree)
        if isinstance(node, ast.Attribute)
    }
    integer_subscripts = {
        node.slice.value for tree in trees for node in ast.walk(tree)
        if isinstance(node, ast.Subscript)
        and isinstance(node.slice, ast.Constant)
        and type(node.slice.value) is int
    }

    def call_name(call: ast.Call) -> str:
        parts: list[str] = []
        node: ast.AST = call.func
        while isinstance(node, ast.Attribute):
            parts.append(node.attr)
            node = node.value
        if isinstance(node, ast.Name):
            parts.append(node.id)
        return ".".join(reversed(parts))

    calls = [node for tree in trees for node in ast.walk(tree) if isinstance(node, ast.Call)]
    popen_calls = [node for node in calls if call_name(node).endswith("subprocess.Popen")]
    close_fds_exact = bool(popen_calls) and all(
        any(keyword.arg == "close_fds" and isinstance(keyword.value, ast.Constant)
            and keyword.value.value is True for keyword in call.keywords)
        for call in popen_calls
    )
    pass_fds_present = any(
        any(keyword.arg == "pass_fds" for keyword in call.keywords)
        for call in popen_calls
    )
    shell_free = all(not any(
        keyword.arg == "shell" and not (
            isinstance(keyword.value, ast.Constant) and keyword.value.value is False
        ) for keyword in call.keywords
    ) for call in calls)
    forbidden_calls = {
        name for name in map(call_name, calls)
        if name.endswith(("shutil.which", "os.system", "os.popen", "sandbox_check"))
    }
    required_literals = {
        "/usr/bin/sandbox-exec", "supervise-v1", "confined-exec-v1", "--proof-fd",
        "profile-proof-v1", "go-v1", "=8I", "peer_euid", "peer_pid",
        "peer_pidversion", "NORTROPIC_KUVERT", "NORTROPIC_H036_CAPABILITY",
        "NORTROPIC_H036_SESSION_ID", "NORTROPIC_H036_LEVEL",
    }
    primitives_ok = (
        required_literals <= constants
        and {"O_NOFOLLOW", "fstat", "open", "sha256", "getsockopt",
             "compare_digest", "killpg"} <= attributes
        and {1, 5, 7} <= integer_subscripts
        and close_fds_exact and pass_fds_present and shell_free
        and not forbidden_calls
    )
    detail = {
        "exact_profile_literals": exact_profiles,
        "profile_load_counts": profile_loads,
        "stable_open_and_peer_primitives": primitives_ok,
        "all_popen_close_fds_true": close_fds_exact,
        "pass_fds_present": pass_fds_present,
        "forbidden_calls": sorted(forbidden_calls),
        "review_obligation": (
            "independent immutable-object review must prove reachable same-opened "
            "helper/config/python/live-root identity and final-use rehash ordering; "
            "one unified post-profile path; exact closed supervisor/helper exec "
            "environment construction; and close_fds/exact pass_fds reachability"
        ),
    }
    return {
        **detail,
        "credit": "NONE_SUPPORTING_DIAGNOSTIC_ONLY",
        "diagnostic_result": (
            exact_profiles
            and all(count >= 1 for count in profile_loads.values())
            and primitives_ok
        ),
    }


def git_exception_case(
    base: Path, python: Path, envelope: Path, env: dict[str, str], trust: Path,
) -> tuple[bool, dict[str, Any]]:
    """Prove exact object/own-admin allows and every adjacent Git deny."""
    worktree = base / "git-exception-worktree"
    sibling = base / "git-exception-sibling"
    marker_name = f"h036-git-effect-{os.getpid()}-{time.monotonic_ns()}"
    payload = ("H036-GIT-OBJECT-PROOF:" + marker_name).encode("utf-8")
    object_format = str(git("rev-parse", "--show-object-format", text=True)).strip()
    if object_format != "sha1":
        return False, {"reason": f"unexpected repository object format {object_format!r}"}
    oid = hashlib.sha1(f"blob {len(payload)}\0".encode("ascii") + payload).hexdigest()
    refs_before = git("for-each-ref", "--format=%(refname)%00%(objectname)")
    worktree_list_before = git("worktree", "list", "--porcelain", "-z")
    common = Path(str(git(
        "rev-parse", "--path-format=absolute", "--git-common-dir", text=True,
    )).strip()).resolve(strict=True)
    worktrees_admin = common / "worktrees"

    def directory_state(path: Path) -> list[tuple[str, int, int, str]] | None:
        if not path.exists():
            return None
        result: list[tuple[str, int, int, str]] = []
        for item in sorted(path.iterdir(), key=lambda candidate: candidate.name):
            opened = item.lstat()
            digest = path_sha(item) if stat.S_ISREG(opened.st_mode) else (
                os.readlink(item) if stat.S_ISLNK(opened.st_mode) else ""
            )
            result.append((item.name, opened.st_mode, opened.st_size, digest))
        return result

    worktrees_admin_before = directory_state(worktrees_admin)
    worktree_added = False
    sibling_added = False
    object_path: Path | None = None
    object_preexisted = True
    fanout: Path | None = None
    fanout_before: list[tuple[str, int, int, str]] | None = None
    fanout_created_identity: tuple[int, int] | None = None
    gitdir: Path | None = None
    sibling_gitdir: Path | None = None
    run: subprocess.CompletedProcess[bytes] | None = None
    observed: dict[str, Any] = {}
    object_created = False
    index_changed = False
    admin_exact = False
    denied_exact = False
    git_overlap_rejected = False
    cleanup_ok = False
    protected_files: dict[Path, tuple[bytes, int, tuple[int, int], int]] = {}
    config_identity: tuple[int, int] | None = None
    transient_paths: list[Path] = []
    try:
        git("worktree", "add", "--detach", str(worktree), PUBLISHED_H034_SHA)
        worktree_added = True
        git("worktree", "add", "--detach", str(sibling), PUBLISHED_H034_SHA)
        sibling_added = True

        def gitdir_for(path: Path) -> tuple[Path, Path]:
            dotgit = path / ".git"
            raw = dotgit.read_text(encoding="utf-8").strip()
            if not raw.startswith("gitdir: "):
                raise Rig("temporary worktree gitfile shape")
            return dotgit, Path(raw[8:]).resolve(strict=True)

        dotgit, gitdir = gitdir_for(worktree)
        _sibling_dotgit, sibling_gitdir = gitdir_for(sibling)
        overlap_sink = gitdir / "HEAD"
        overlap_before = overlap_sink.read_bytes()
        overlap_marker = worktree / "git-overlap-marker"
        overlap_env = dict(env)
        overlap_env["NORTROPIC_TRUST_ROOT"] = str(trust)
        overlap_env["NORTROPIC_STAGING_ROOT"] = str(gitdir)
        overlap_env["NORTROPIC_RESULT_SINK"] = str(overlap_sink)
        overlap_run = launch(
            python, worktree, envelope, "3",
            [str(python), "-I", "-S", "-B", "-c",
             "import pathlib;pathlib.Path(" + repr(str(overlap_marker))
             + ").write_text('BAD')"],
            overlap_env, outer_timeout=10,
        )
        git_overlap_rejected = (
            overlap_run.returncode == 3 and not overlap_marker.exists()
            and overlap_sink.read_bytes() == overlap_before
        )
        object_path = common / "objects" / oid[:2] / oid[2:]
        object_preexisted = object_path.exists()
        if object_preexisted:
            raise Rig("unique Git proof object unexpectedly preexists")
        fanout = object_path.parent
        fanout_before = directory_state(fanout)
        index = gitdir / "index"
        index_before = path_sha(index) if index.is_file() else "ABSENT"
        objects_info = common / "objects" / "info"
        info_before = directory_state(objects_info)
        info_marker = objects_info / marker_name
        commondir = gitdir / "commondir"
        gitdir_gitfile = gitdir / "gitdir"
        config_worktree = gitdir / "config.worktree"
        sibling_marker = sibling_gitdir / marker_name
        sibling_before = directory_state(sibling_gitdir)
        for path in (commondir, gitdir_gitfile, dotgit):
            protected_files[path] = nofollow_file_snapshot(path)
        try:
            config_worktree.lstat()
        except FileNotFoundError:
            pass
        else:
            raise Rig("temporary worktree config.worktree unexpectedly preexists")
        config_canary = b"H036-ORIGINAL-WORKTREE-CONFIG\n"
        config_identity = create_nofollow_file(config_worktree, config_canary, 0o600)
        transient_paths.extend([info_marker, sibling_marker])
        paths = {
            "objects_info": str(info_marker),
            "commondir": str(commondir),
            "gitdir_gitfile": str(gitdir_gitfile),
            "worktree_gitfile": str(dotgit),
            "config_worktree": str(config_worktree),
            "sibling_admin": str(sibling_marker),
        }
        script = worktree / "git-effect.py"
        script.write_text(
            "import json,os,subprocess,sys\n"
            "git='/usr/bin/git';payload=bytes.fromhex(" + repr(payload.hex()) + ");paths=json.loads(sys.argv[1])\n"
            "closed={'PATH':'/usr/bin:/bin','LANG':'C','LC_ALL':'C','HOME':'/var/empty','GIT_CONFIG_NOSYSTEM':'1','GIT_CONFIG_GLOBAL':'/dev/null'}\n"
            "write=subprocess.run([git,'hash-object','-w','--stdin'],input=payload,env=closed,stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=False)\n"
            "oid=write.stdout.decode().strip();entry='100644,'+oid+','+" + repr(marker_name) + "\n"
            "admin=subprocess.run([git,'update-index','--add','--cacheinfo',entry],env=closed,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=False)\n"
            "def create(path):\n"
            " try:fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600);os.write(fd,b'BAD');os.close(fd);return 0\n"
            " except OSError as exc:return exc.errno\n"
            "def overwrite(path):\n"
            " try:fd=os.open(path,os.O_WRONLY|os.O_TRUNC);os.write(fd,b'BAD');os.close(fd);return 0\n"
            " except OSError as exc:return exc.errno\n"
            "denied={'objects_info':create(paths['objects_info']),'commondir':overwrite(paths['commondir']),'gitdir_gitfile':overwrite(paths['gitdir_gitfile']),'worktree_gitfile':overwrite(paths['worktree_gitfile']),'config_worktree':overwrite(paths['config_worktree']),'sibling_admin':create(paths['sibling_admin'])}\n"
            "print(json.dumps({'write_rc':write.returncode,'admin_rc':admin.returncode,'oid':oid,'denied':denied},sort_keys=True))\n",
            encoding="utf-8",
        )
        git_env = dict(env)
        git_env["NORTROPIC_TRUST_ROOT"] = str(trust)
        git_env.pop("NORTROPIC_STAGING_ROOT", None)
        git_env.pop("NORTROPIC_RESULT_SINK", None)
        run = launch(
            python, worktree, envelope, "8",
            [str(python), "-I", "-S", "-B", str(script),
             json.dumps(paths, sort_keys=True, separators=(",", ":"))],
            git_env, outer_timeout=20,
        )
        try:
            candidate = strict_json(run.stdout)
            if isinstance(candidate, dict):
                observed = candidate
        except Rig:
            pass
        object_created = object_path.is_file() and not object_path.is_symlink()
        if fanout_before is None and fanout.is_dir() and not fanout.is_symlink():
            fanout_opened = fanout.lstat()
            fanout_created_identity = (fanout_opened.st_dev, fanout_opened.st_ino)
        index_changed = index.is_file() and path_sha(index) != index_before
        listed = str(git(
            "-C", str(worktree), "ls-files", "--stage", "--", marker_name,
            text=True,
        )).strip()
        admin_exact = listed == f"100644 {oid} 0\t{marker_name}"
        denied_expected = {
            "commondir": errno.EPERM,
            "config_worktree": errno.EPERM,
            "gitdir_gitfile": errno.EPERM,
            "objects_info": errno.EPERM,
            "sibling_admin": errno.EPERM,
            "worktree_gitfile": errno.EPERM,
        }
        denied_exact = (
            observed.get("denied") == denied_expected
            and directory_state(objects_info) == info_before
            and directory_state(sibling_gitdir) == sibling_before
            and all(nofollow_file_snapshot(path) == before
                    for path, before in protected_files.items())
            and nofollow_file_snapshot(config_worktree) == (
                config_canary, 0o600, config_identity, 1,
            )
            and not info_marker.exists() and not sibling_marker.exists()
            and not (gitdir / "index.lock").exists()
        )
        refs_unchanged = git(
            "for-each-ref", "--format=%(refname)%00%(objectname)"
        ) == refs_before
        ok = (
            run.returncode == 0 and observed.get("write_rc") == 0
            and observed.get("admin_rc") == 0 and observed.get("oid") == oid
            and object_created and index_changed and admin_exact and denied_exact
            and refs_unchanged and git_overlap_rejected
        )
    except (OSError, Rig, StopIteration, subprocess.SubprocessError) as exc:
        ok = False
        observed = {**observed, "rig_error": str(exc)}
    finally:
        if config_identity is not None:
            try:
                safe_remove_tree(config_worktree)
            except (OSError, Rig):
                pass
        for path in transient_paths:
            try:
                safe_remove_tree(path)
            except (OSError, Rig):
                pass
        # Gate-created worktree roots and their exact admin roots are removed
        # through the same nofollow dirfd primitive.  No global `worktree
        # prune` may delete unrelated stale owner state.
        for path in (sibling if sibling_added else None,
                     worktree if worktree_added else None,
                     sibling_gitdir, gitdir):
            if path is not None:
                try:
                    safe_remove_tree(path)
                except (OSError, Rig):
                    pass
        if object_path is not None and not object_preexisted:
            try:
                safe_remove_tree(object_path)
            except (OSError, Rig):
                pass
        if fanout is not None and fanout_before is None \
                and fanout_created_identity is not None:
            try:
                safe_remove_empty_directory(fanout, fanout_created_identity)
            except (OSError, Rig):
                pass
        cleanup_ok = (
            not worktree.exists() and not sibling.exists()
            and (object_path is None or object_preexisted or not object_path.exists())
            and (fanout is None or directory_state(fanout) == fanout_before)
            and git("for-each-ref", "--format=%(refname)%00%(objectname)") == refs_before
            and git("worktree", "list", "--porcelain", "-z") == worktree_list_before
            and directory_state(worktrees_admin) == worktrees_admin_before
        )
    detail = {
        "returncode": None if run is None else run.returncode,
        "observed": observed,
        "object_format": object_format,
        "object_oid": oid,
        "object_created": object_created,
        "own_worktree_index_changed": index_changed,
        "own_admin_exact": admin_exact,
        "adjacent_git_denies_exact": denied_exact,
        "git_staging_overlap_rejected": git_overlap_rejected,
        "cleanup_object_fanout_admin_refs_exact": cleanup_ok,
    }
    return ok and cleanup_ok, detail


def run_subject_matrix() -> tuple[bool, dict[str, Any]]:
    run_root = Path(tempfile.mkdtemp(prefix="h036-subject-gate-", dir="/private/tmp"))
    live_canary = ROOT / f".h036-live-canary-{os.getpid()}-{time.monotonic_ns()}"
    before_pycache = repo_pycache_state()
    before_runtime = runtime_roots()
    detail: dict[str, Any] = {}
    try:
        workspace = run_root / "workspace"
        child = workspace / "child"
        trust = run_root / "trust"
        staging = run_root / "staging"
        shim = run_root / "shim"
        for path in (workspace, child, trust, staging, shim, live_canary):
            path.mkdir()
        (trust / "protected").write_text("ORIGINAL", encoding="utf-8")
        envelope = run_root / "envelope.json"
        envelope.write_text("{}", encoding="utf-8")
        shim_marker = run_root / "path-shim-ran"
        shim_exec = shim / "sandbox-exec"
        shim_exec.write_text("#!/bin/sh\nprintf BAD > " + str(shim_marker) + "\nexit 99\n", encoding="utf-8")
        shim_exec.chmod(0o700)
        canary = "h036-supervisor-secret-" + hashlib.sha256(os.urandom(32)).hexdigest()
        env = closed_subject_env(trust, shim, canary)
        env["NORTROPIC_STAGING_ROOT"] = str(staging)
        env["NORTROPIC_RESULT_SINK"] = str(staging / "result.json")
        python_one = make_python_snapshot(run_root)
        classifier_ok, classifier = descriptor_classifier_selftests()
        detail["retained_fd_observer_and_classifier_falsification"] = classifier
        base_profile_ok, base_profile = base_profile_composition_case(
            run_root, python_one, trust, env, live_canary,
        )
        detail["connected_subject_base_profile_protocol"] = base_profile
        primary_ok, primary = primary_composition_case(
            run_root, python_one, workspace, child, trust, envelope, env, live_canary,
        )
        detail["connected_subject_profile_protocol_env"] = primary
        later_ok, later = later_top_identity_case(
            run_root, python_one, workspace, envelope, env,
        )
        detail["later_top_session_identity"] = later
        base_identity = base_profile.get("authority_identity", {}) \
            if isinstance(base_profile, dict) else {}
        primary_identity = primary.get("authority_identity", {}) \
            if isinstance(primary, dict) else {}
        later_identity = later.get("record", {}) if isinstance(later, dict) else {}
        sessions = [
            base_identity.get("session"), primary_identity.get("session"),
            later_identity.get("session"),
        ]
        capabilities = [
            *(base_identity.get("capabilities", [])
              if isinstance(base_identity.get("capabilities"), list) else []),
            *(primary_identity.get("capabilities", [])
              if isinstance(primary_identity.get("capabilities"), list) else []),
            later_identity.get("capability"),
        ]
        runtime_paths = [
            base_identity.get("runtime_root"), primary_identity.get("runtime_root"),
            later_identity.get("runtime_root"),
        ]
        runtime_identities = [
            base_identity.get("runtime_root_identity"),
            primary_identity.get("runtime_root_identity"),
            later_identity.get("runtime_root_identity"),
        ]
        base_socket = base_identity.get("socket", {}) \
            if isinstance(base_identity.get("socket"), dict) else {}
        primary_socket = primary_identity.get("socket", {}) \
            if isinstance(primary_identity.get("socket"), dict) else {}
        socket_paths = [
            base_socket.get("path"), primary_socket.get("path"),
            later_identity.get("socket"),
        ]
        socket_identities = [
            base_socket.get("dev_ino"), primary_socket.get("dev_ino"),
            later_identity.get("socket_identity"),
        ]
        authority_separation = (
            later_ok
            and all(isinstance(value, str)
                    and re.fullmatch(r"[0-9a-f]{64}", value) is not None
                    for value in sessions)
            and len(set(sessions)) == 3
            and all(isinstance(value, str)
                    and re.fullmatch(r"[0-9a-f]{64}", value) is not None
                    for value in capabilities)
            and len(capabilities) >= 7 and len(set(capabilities)) == len(capabilities)
            and all(isinstance(value, str) for value in runtime_paths)
            and len(set(runtime_paths)) == 3
            and all(isinstance(value, list) and len(value) == 2
                    for value in runtime_identities)
            and len({tuple(value) for value in runtime_identities}) == 3
            and all(isinstance(value, str) for value in socket_paths)
            and len(set(socket_paths)) == 3
            and all(isinstance(value, list) and len(value) == 2
                    for value in socket_identities)
            and len({tuple(value) for value in socket_identities}) == 3
        )
        detail["cross_session_capability_runtime_socket_separation"] = {
            "ok": authority_separation,
            "sessions": sessions,
            "capabilities": capabilities,
            "runtime_paths": runtime_paths,
            "runtime_identities": runtime_identities,
            "socket_paths": socket_paths,
            "socket_identities": socket_identities,
        }
        lifecycle_ok, lifecycle = simple_lifecycle_cases(
            run_root, python_one, workspace, envelope, env, trust,
        )
        detail["lifecycle_and_harmless_survivor"] = lifecycle
        negatives_ok, negatives = negative_identity_and_overlap_cases(
            run_root, python_one, workspace, envelope, env, trust, live_canary,
        )
        detail["identity_overlap_alias_negatives"] = negatives
        death_ok, death = supervisor_death_case(
            python_one, workspace, envelope, env, run_root,
        )
        detail["supervisor_death_kernel_argv_and_environment_review_boundary"] = death
        git_ok, git_detail = git_exception_case(
            run_root, python_one, envelope, env, trust,
        )
        detail["git_object_and_own_worktree_admin_exception"] = git_detail
        # Mechanism-neutral positive: a second independently created 0500
        # same-byte private runtime is accepted; no relocated launcher/helper
        # is.  This is the only authorized relocation class.
        second_root = run_root / "second-authority"
        second_root.mkdir()
        python_two = make_python_snapshot(second_root)
        second = launch(python_two, workspace, envelope, "3", ["/usr/bin/true"], env)
        second_ok = second.returncode == 0
        detail["second_private_snapshot"] = {
            "rc": second.returncode,
            "digest": path_sha(python_two),
            "root_mode": oct(python_two.parent.stat().st_mode & 0o777),
        }
        after_pycache = repo_pycache_state()
        pycache_ok = after_pycache == before_pycache
        detail["repository_pycache_delta"] = sorted(set(after_pycache) ^ set(before_pycache))
        detail["path_shim_executed"] = shim_marker.exists()
        detail["groups"] = {
            "connected_actual_subject_chain": primary_ok and base_profile_ok,
            "profile_lineage_syscalls_and_reopen_negatives": primary_ok and base_profile_ok,
            "strict_protocol_fd_replay_cross_session": primary_ok and authority_separation,
            "target_sanitizer_fd_no_caller_path_and_supervisor_env_review_boundary": (
                primary_ok and death_ok
            ),
            "snapshot_relocation_identity_and_no_pyc": (
                negatives_ok and second_ok and pycache_ok
            ),
            "lifecycle_revoke_and_harmless_setsid": lifecycle_ok and death_ok,
            "mechanism_neutral_private_snapshot_positive": second_ok,
            "dynamic_profile_binding_and_git_exception": (
                base_profile_ok and primary_ok and git_ok
            ),
            "complete_supervisor_fd_accounting_observer": classifier_ok,
        }
        return (
            classifier_ok
            and base_profile_ok and primary_ok and authority_separation
            and lifecycle_ok and negatives_ok and death_ok
            and git_ok and second_ok
            and pycache_ok and not shim_marker.exists()
            and runtime_roots() == before_runtime
        ), detail
    finally:
        safe_remove_tree(live_canary)
        safe_remove_tree(run_root)
        # The subject must normally own this cleanup.  Gate cleanup is only a
        # bounded fail-safe and never turns residue into PASS.
        for residue in runtime_roots() - before_runtime:
            try:
                safe_remove_tree(Path(residue))
            except OSError:
                pass


REFERENCE_SCRIPT = r'''import errno,json,os,pathlib,secrets,socket,struct,subprocess,sys,tempfile,time
PY=sys.argv[1];SANDBOX="/usr/bin/sandbox-exec";SELF=os.path.realpath(__file__)
def profile(*roots):return "\n".join(["(version 1)","(allow default)",*[f'(deny file-write* (subpath {json.dumps(root)}))' for root in roots]])
def effect(path):
 try:open(os.path.join(path,"effect"),"w").write("x");return 0
 except OSError as exc:return exc.errno
def identity(lineage,nonce):
 a,b=socket.socketpair();audit=struct.unpack("=8I",a.getsockopt(0,6,32));a.close();b.close();return {"euid":os.geteuid(),"lineage":lineage,"nonce":nonce,"pgid":os.getpgrp(),"pid":os.getpid(),"pidversion":audit[7],"sid":os.getsid(0)}
mode=sys.argv[2] if len(sys.argv)>2 else "main"
if mode=="linger":
 status_path,cap=sys.argv[3:5];status=identity("reference-error-child-v1",cap);fd=os.open(status_path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600);os.write(fd,json.dumps(status,sort_keys=True).encode());os.fsync(fd);os.close(fd);time.sleep(120);raise SystemExit(0)
if mode=="outer":
 outer,inner,sock_path,cap,status_path=sys.argv[3:8];before=[effect(outer),effect(inner)]
 status=identity("reference-outer-v1",cap);status_fd=os.open(status_path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600);os.write(status_fd,json.dumps(status,sort_keys=True).encode());os.fsync(status_fd);os.close(status_fd)
 nested=subprocess.run([SANDBOX,"-p","(version 1)\n(allow default)","/usr/bin/true"],stdout=subprocess.PIPE,stderr=subprocess.PIPE)
 s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.settimeout(5);s.connect(sock_path);s.sendall((cap+"\n").encode());raw=b""
 while not raw.endswith(b"\n"):
  part=s.recv(65536)
  if not part:raise ConnectionError("reference supervisor closed")
  raw+=part
 s.close()
 print(json.dumps({"before":before,"nested_rc":nested.returncode,"nested_stderr":nested.stderr.decode(),"response":json.loads(raw)}));raise SystemExit(0)
if mode=="inner":
 outer,inner,allowed=sys.argv[3:6];print(json.dumps({"outer":effect(outer),"inner":effect(inner),"allowed":effect(allowed)}));raise SystemExit(0)
control=pathlib.Path(sys.argv[3])
base=tempfile.mkdtemp(prefix="h036-reference-",dir="/private/tmp")
listen=None;conn=None;proc=None;linger=None
try:
 outer=os.path.join(base,"outer");inner=os.path.join(base,"inner");allowed=os.path.join(base,"allowed")
 for path in (outer,inner,allowed):os.mkdir(path)
 sock_path=os.path.join(base,"s");listen=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);listen.bind(sock_path);listen.listen(1);listen.settimeout(5);cap=secrets.token_hex(32)
 outer_status=os.path.join(base,"outer-identity.json");proc=subprocess.Popen([SANDBOX,"-p",profile(outer),PY,"-I","-S","-B",SELF,PY,"outer",outer,inner,sock_path,cap,outer_status],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,close_fds=True)
 deadline=time.monotonic()+3
 while time.monotonic()<deadline and not os.path.isfile(outer_status):time.sleep(0.01)
 if not os.path.isfile(outer_status):raise RuntimeError("outer identity absent")
 with open(outer_status,encoding="utf-8") as stream:outer_identity=json.load(stream)
 members=[identity("reference-main-v1",cap),outer_identity]
 if mode=="force-error":
  linger_status=os.path.join(base,"error-child-identity.json");linger=subprocess.Popen([PY,"-I","-S","-B",SELF,PY,"linger",linger_status,cap],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,close_fds=True)
  deadline=time.monotonic()+3
  while time.monotonic()<deadline and not os.path.isfile(linger_status):time.sleep(0.01)
  if not os.path.isfile(linger_status):raise RuntimeError("error child identity absent")
  with open(linger_status,encoding="utf-8") as stream:members.append(json.load(stream))
 cfd=os.open(control,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600);os.write(cfd,json.dumps({"base":base,"capability":cap,"members":members,"socket":sock_path},sort_keys=True).encode());os.fsync(cfd);os.close(cfd)
 if mode=="force-hang":time.sleep(120)
 if mode=="force-error":os._exit(86)
 try:conn,_=listen.accept()
 except Exception as exc:
  out,err=proc.communicate(timeout=2);raise RuntimeError(f"outer did not connect rc={proc.returncode} out={out!r} err={err!r}") from exc
 conn.settimeout(5);peer=struct.unpack("i",conn.getsockopt(0,2,4))[0];token=struct.unpack("=8I",conn.getsockopt(0,6,32));got=b""
 while not got.endswith(b"\n"):
  part=conn.recv(65536)
  if not part:raise ConnectionError("reference client closed")
  got+=part
 authenticated=peer==proc.pid and token[5]==proc.pid and secrets.compare_digest(got.decode().strip(),cap)
 child=subprocess.run([SANDBOX,"-p",profile(outer,inner),PY,"-I","-S","-B",SELF,PY,"inner",outer,inner,allowed],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=8)
 response={"authenticated":authenticated,"peer_pid":peer==proc.pid,"audit_pid":token[5]==proc.pid,"child_rc":child.returncode,"effects":json.loads(child.stdout)}
 conn.sendall((json.dumps(response)+"\n").encode());conn.close();conn=None;listen.close();listen=None;out,err=proc.communicate(timeout=8);outer_result=json.loads(out)
 result={"outer_rc":proc.returncode,"outer":outer_result,"response":response};print(json.dumps(result,sort_keys=True))
 ok=proc.returncode==0 and outer_result["before"]==[errno.EPERM,0] and outer_result["nested_rc"]==71 and "sandbox_apply: Operation not permitted" in outer_result["nested_stderr"] and authenticated and response["effects"]=={"outer":errno.EPERM,"inner":errno.EPERM,"allowed":0}
 raise SystemExit(0 if ok else 1)
finally:
 for item in (conn,listen):
  if item is not None:
   try:item.close()
   except OSError:pass
 if proc is not None and proc.poll() is None:
  proc.terminate()
  try:proc.communicate(timeout=2)
  except subprocess.TimeoutExpired:proc.kill();proc.communicate(timeout=2)
'''


def reference_script_case(mode: str) -> tuple[bool, dict[str, Any]]:
    root = Path(tempfile.mkdtemp(prefix="h036-reference-host-", dir="/private/tmp"))
    ok = False
    detail: dict[str, Any] = {}
    try:
        script = root / "reference.py"
        control = root / "postspawn.json"
        script.write_text(REFERENCE_SCRIPT, encoding="utf-8")
        timeout = 0.7 if mode == "force-hang" else 20.0
        run, ownership = owned_group_run(
            [
                str(PYTHON_SOURCE), "-I", "-S", "-B", str(script),
                str(PYTHON_SOURCE), mode, str(control),
            ],
            env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"},
            cwd=root, timeout=timeout, identity_path=control,
        )
        record: dict[str, Any] = {}
        try:
            candidate = strict_json(control.read_bytes())
            if isinstance(candidate, dict):
                record = candidate
        except (OSError, Rig):
            pass
        internal_base = Path(str(record.get("base", "/nonexistent")))
        internal_socket = Path(str(record.get("socket", "/nonexistent")))
        members = record.get("members") if isinstance(record.get("members"), list) else []
        main_member = next(
            (item for item in members
             if isinstance(item, dict) and item.get("lineage") == "reference-main-v1"),
            {},
        )
        outer_member = next(
            (item for item in members
             if isinstance(item, dict) and item.get("lineage") == "reference-outer-v1"),
            {},
        )
        postspawn = (
            type(main_member.get("pid")) is int
            and main_member.get("pid") == ownership.get("leader", {}).get("pid")
            and type(outer_member.get("pid")) is int
            and outer_member.get("pid") not in {main_member.get("pid"), 0, 1}
            and main_member.get("pgid") == ownership.get("pgid")
            and outer_member.get("pgid") == ownership.get("pgid")
            and main_member.get("sid") == ownership.get("pgid")
            and outer_member.get("sid") == ownership.get("pgid")
            and main_member.get("euid") == os.geteuid()
            and outer_member.get("euid") == os.geteuid()
            and type(main_member.get("pidversion")) is int
            and type(outer_member.get("pidversion")) is int
            and isinstance(record.get("capability"), str)
            and re.fullmatch(r"[0-9a-f]{64}", record["capability"]) is not None
            and main_member.get("nonce") == record.get("capability")
            and outer_member.get("nonce") == record.get("capability")
        )
        known = set(ownership.get("known_pids", []))
        declared_pids = {
            item.get("pid") for item in members
            if isinstance(item, dict) and type(item.get("pid")) is int
        }
        forced_members = mode == "normal" or declared_pids.issubset(known)
        sockets_closed = ownership.get("group_absent") is True
        if sockets_closed and internal_base.name.startswith("h036-reference-"):
            safe_remove_tree(internal_base)
        internal_absent = not internal_base.exists() and not internal_socket.exists()
        detail = {
            "returncode": run.returncode,
            "stderr": run.stderr.decode("utf-8", "replace")[:2000],
            "script_sha256": sha(REFERENCE_SCRIPT.encode()),
            "mode": mode,
            "postspawn": postspawn,
            "ownership": ownership,
            "forced_members_bound": forced_members,
            "sockets_closed_before_internal_root_remove": sockets_closed,
            "internal_root_absent": internal_absent,
        }
        if mode == "normal":
            try:
                detail["effect"] = strict_json(run.stdout)
            except Rig:
                detail["stdout"] = run.stdout.decode("utf-8", "replace")[:500]
            ok = (
                run.returncode == 0 and not ownership.get("timed_out")
                and postspawn and forced_members and internal_absent
                and ownership.get("identity_bound") is True
                and ownership.get("wnowait_exit_observed") is True
                and ownership.get("leader_reserved_until_cleanup") is True
                and ownership.get("group_absent") is True
                and ownership.get("reaped") is True
            )
        elif mode == "force-hang":
            ok = (
                run.returncode != 0 and ownership.get("timed_out") is True
                and ownership.get("termination") in {"term", "kill"}
                and postspawn and forced_members and internal_absent
                and ownership.get("identity_bound") is True
                and ownership.get("wnowait_exit_observed") is False
                and ownership.get("leader_reserved_until_cleanup") is True
                and ownership.get("group_absent") is True
                and ownership.get("reaped") is True
            )
        else:
            ok = (
                mode == "force-error" and run.returncode != 0
                and run.returncode == 86
                and ownership.get("timed_out") is False
                and ownership.get("termination") in {"term", "kill"}
                and postspawn and forced_members and internal_absent
                and ownership.get("identity_bound") is True
                and ownership.get("wnowait_exit_observed") is True
                and ownership.get("leader_reserved_until_cleanup") is True
                and ownership.get("group_absent") is True
                and ownership.get("reaped") is True
            )
    finally:
        safe_remove_tree(root)
    detail["wrapper_root_absent"] = not root.exists()
    return ok and detail["wrapper_root_absent"], detail


def reference_host_effect() -> tuple[bool, dict[str, Any]]:
    normal_ok, normal = reference_script_case("normal")
    hang_ok, hang = reference_script_case("force-hang")
    error_ok, error = reference_script_case("force-error")
    observer_ok, observer = kernel_process_observer_selftests()
    classifier_ok, classifier = descriptor_classifier_selftests()
    cleanup_ok, cleanup = cleanup_nofollow_selftests()
    git_cleanup_ok, git_cleanup = git_cleanup_harness_selftest()
    return (
        normal_ok and hang_ok and error_ok and observer_ok
        and classifier_ok and cleanup_ok and git_cleanup_ok
    ), {
        "normal": normal,
        "forced_postspawn_hang_nonpass_and_clean": hang,
        "forced_postspawn_error_nonpass_and_clean": error,
        "kernel_argv_no_env_credit_and_complete_fd_observer": observer,
        "retained_fd_classifier_falsification": classifier,
        "nofollow_dirfd_cleanup_symlink_falsification": cleanup,
        "exact_git_worktree_admin_config_object_cleanup": git_cleanup,
    }


def reference_exact_profile_effect() -> tuple[bool, dict[str, Any]]:
    root = Path(tempfile.mkdtemp(prefix="h036-reference-profile-", dir="/private/tmp"))
    try:
        live = root / "live"
        live_git = live / ".git"
        objects = live_git / "objects"
        objects_info = objects / "info"
        worktree_gitdir = live_git / "worktrees" / "proof"
        trust = root / "trust"
        runtime = root / "runtime"
        ancestor = root / "ancestor"
        current = ancestor / "current"
        current_dotgit = current / ".git"
        staging = root / "staging"
        for path in (
            objects_info, worktree_gitdir, trust, runtime, current_dotgit, staging,
        ):
            path.mkdir(parents=True, exist_ok=True)
        commondir = worktree_gitdir / "commondir"
        gitfile = worktree_gitdir / "gitdir"
        config = worktree_gitdir / "config.worktree"
        for path in (commondir, gitfile, config):
            path.write_text("ORIGINAL", encoding="utf-8")
        sink = staging / "result"
        sink.write_text("EMPTY", encoding="utf-8")
        paths = {
            "scratch": str(current / "scratch"),
            "sink": str(sink),
            "live": str(live / "bad"),
            "trust": str(trust / "bad"),
            "runtime": str(runtime / "bad"),
            "staging": str(staging / "bad"),
            "object": str(objects / "allowed-object"),
            "admin": str(worktree_gitdir / "allowed-index-lock"),
            "info": str(objects_info / "bad"),
            "commondir": str(commondir),
            "gitfile": str(gitfile),
            "config": str(config),
        }
        target = r'''import json,os,sys
p=json.loads(sys.argv[1]);out={}
def create(name):
 try:fd=os.open(p[name],os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600);os.write(fd,b"PROOF");os.close(fd);return 0
 except OSError as exc:return exc.errno
def write(name):
 try:fd=os.open(p[name],os.O_WRONLY|os.O_TRUNC);os.write(fd,b"PROOF");os.close(fd);return 0
 except OSError as exc:return exc.errno
for name in ("scratch","live","trust","runtime","staging","object","admin","info"):out[name]=create(name)
for name in ("sink","commondir","gitfile","config"):out[name]=write(name)
print(json.dumps(out,sort_keys=True,separators=(",",":")))
'''
        parameters = {
            "LIVE_ROOT": live,
            "LIVE_GIT": live_git,
            "GIT_OBJECTS": objects,
            "GIT_OBJECTS_INFO": objects_info,
            "WORKTREE_GITDIR": worktree_gitdir,
            "WORKTREE_COMMDIR": commondir,
            "WORKTREE_GITFILE": gitfile,
            "WORKTREE_CONFIG": config,
            "TRUST_ROOT": trust,
            "RUNTIME_ROOT": runtime,
            "ANCESTOR_WORKSPACE": ancestor,
            "CURRENT_WORKSPACE": current,
            "CURRENT_WORKSPACE_DOTGIT": current_dotgit,
            "STAGING_ROOT": staging,
            "RESULT_SINK": sink,
        }
        argv = [str(SANDBOX_EXEC)]
        for name in CONFIG_STATIC["seatbelt"]["parameter_order_by_profile_sha256"][PROFILE_SHA256]:
            argv.extend(["-D", f"{name}={parameters[name]}"])
        argv.extend([
            "-p", PROFILE_TEMPLATE_WITH_STAGING, str(PYTHON_SOURCE), "-I", "-S", "-B",
            "-c", target, json.dumps(paths, sort_keys=True, separators=(",", ":")),
        ])
        run, ownership = owned_group_run(
            argv, cwd=current, env=CONFIG_STATIC["supervisor_environment"], timeout=8,
        )
        try:
            observed = strict_json(run.stdout)
        except Rig:
            observed = {}
        expected = {
            "scratch": 0, "sink": 0, "object": 0, "admin": 0,
            "live": errno.EPERM, "trust": errno.EPERM, "runtime": errno.EPERM,
            "staging": errno.EPERM, "info": errno.EPERM,
            "commondir": errno.EPERM, "gitfile": errno.EPERM,
            "config": errno.EPERM,
        }
        independent = (
            (current / "scratch").read_bytes() == b"PROOF"
            and sink.read_bytes() == b"PROOF"
            and (objects / "allowed-object").read_bytes() == b"PROOF"
            and (worktree_gitdir / "allowed-index-lock").read_bytes() == b"PROOF"
            and all(not Path(paths[name]).exists()
                    for name in ("live", "trust", "runtime", "staging", "info"))
            and all(Path(paths[name]).read_text(encoding="utf-8") == "ORIGINAL"
                    for name in ("commondir", "gitfile", "config"))
        )
        detail = {
            "returncode": run.returncode,
            "stderr": run.stderr.decode("utf-8", "replace")[:500],
            "profile_sha256": PROFILE_SHA256,
            "observed": observed,
            "independent_effects": independent,
            "owned_group": ownership,
        }
        strict_effect_types = isinstance(observed, dict) and all(
            type(observed.get(key)) is int for key in expected
        )
        return (
            run.returncode == 0 and strict_effect_types
            and observed == expected and independent
            and ownership.get("identity_bound") is True
            and ownership.get("timed_out") is False
            and ownership.get("wnowait_exit_observed") is True
            and ownership.get("leader_reserved_until_cleanup") is True
            and ownership.get("group_absent") is True
            and ownership.get("reaped") is True
        ), {**detail, "strict_effect_types": strict_effect_types}
    finally:
        safe_remove_tree(root)


def finish(phase: str, *, reference_only: bool = False) -> int:
    print("MATERIAL_PROPERTIES_JUDGE_ONLY=" +
          ("REFERENCE_HOST_NOT_SUBJECT" if reference_only else "NONE"))
    print(f"H036_GATE_SUMMARY={passed} PASS {failed} FAIL")
    if failed == 0:
        print("H036_GATE_RESULT=PASS")
        return 0
    if phase == "preproduct" and failed == 1 and failed_labels == [(LABEL, json.dumps({
        "failure_signature": FAILURE_SIGNATURE,
        "reason": REASON,
    }, ensure_ascii=False, sort_keys=True))]:
        print(f"H036_GATE_RESULT=RED_EXPECTED label={LABEL} reason={REASON}")
        return 1
    print("H036_GATE_RESULT=FAIL")
    return 1


def main(argv: list[str]) -> int:
    preproduct = not argv
    product_mode = len(argv) == 3 and argv[0] == "--product"
    reference_mode = argv == ["--reference-host"]
    if not (preproduct or product_mode or reference_mode):
        print("RIG_ERROR: usage: h-036-exit [--product BASE_SHA CANDIDATE_SHA|--reference-host]",
              file=sys.stderr)
        return 2
    try:
        static_contract_checks()
        phase = product_phase()
        if reference_mode:
            host_preflight()
            topology_ok, topology = reference_host_effect()
            profile_ok, profile = reference_exact_profile_effect()
            check(
                topology_ok and profile_ok,
                "J_H036_REFERENCE_PRE_SANDBOX_TOPOLOGY_SATISFIABLE",
                {"topology": topology, "exact_profile": profile},
            )
            return finish("reference", reference_only=True)
        if product_mode:
            identity_ok, identity_detail = product_identity(argv[1], argv[2])
            check(identity_ok, "A_H036_EXACT_DIRECT_CHILD_THREE_FILE_PRODUCT_IDENTITY",
                  identity_detail)
            if phase != "product":
                raise Rig("--product requires all three product bytes")
            effect_ok = False
            effect_detail: dict[str, Any] = {"reason": "identity rejected before execution"}
            if identity_ok:
                effect_ok, effect_detail = subject_effects()
            check(effect_ok, LABEL, effect_detail)
        elif phase == "preproduct":
            check(False, LABEL, {
                "failure_signature": FAILURE_SIGNATURE,
                "reason": REASON,
            })
        else:
            print("H036_GATE_RESULT=PRODUCT_IDENTITY_REQUIRED")
            print("MATERIAL_PROPERTIES_JUDGE_ONLY=NONE")
            return 2
        return finish(phase)
    except Undecidable as exc:
        print(f"ODÖMBART H036_HOST_ENVIRONMENT — {exc}")
        print("MATERIAL_PROPERTIES_JUDGE_ONLY=NONE")
        return 2
    except (OSError, ValueError, subprocess.SubprocessError, Rig) as exc:
        print(f"RIG_ERROR: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
