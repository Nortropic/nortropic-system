def attempt(path):
    try:fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600);os.close(fd);return 0
    except OSError as exc:return exc.errno
bad=[key for key in os.environ if key.startswith(("DYLD_","GIT_","GH_","GITHUB_","PYTHON","SLACK_")) or key in {"LD_PRELOAD","LD_LIBRARY_PATH","NORTROPIC_TRUST_ROOT","NORTROPIC_STAGING_ROOT","NORTROPIC_RESULT_SINK","__PYVENV_LAUNCHER__"}]
