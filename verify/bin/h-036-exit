last_frame_raw=[b""]
def recv_frame(s):
    last_frame_raw[0]=b""
    lead=b""
    while len(lead)<4:
        part=s.recv(4-len(lead))
        if not part:return None
        lead+=part
    size=struct.unpack(">I",lead)[0]
    if size>1048576:raise ValueError("response frame oversized")
    body=b""
    while len(body)<size:
        part=s.recv(size-len(body))
        if not part:return None
        body+=part
    last_frame_raw[0]=body
    def pairs(items):
        out={}
        for key,value in items:
            if key in out:raise ValueError("duplicate response key")
            out[key]=value
        return out
    return json.loads(body.decode(),object_pairs_hook=pairs,parse_constant=lambda token:(_ for _ in ()).throw(ValueError("nonfinite response")))
def send_frame(s,value,reorder=False):
    if reorder:body=json.dumps(dict(sorted(value.items(),reverse=True)),separators=(",",":"),ensure_ascii=False).encode()
    else:body=json.dumps(value,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode()
    s.sendall(struct.pack(">I",len(body))+body)
def read_pipe(fd):
    os.set_blocking(fd,False);out=b"";eof=False;deadline=time.monotonic()+3
    while time.monotonic()<deadline:
        ready,_,_=select.select([fd],[],[],0.05)
        if not ready:continue
        part=os.read(fd,65536)
        if not part:eof=True;break
        out+=part
    return {"hex":out.hex(),"eof":eof}
