passed = 0
failed = 0
failed_labels: list[tuple[str, str]] = []


class Rig(Exception):
    pass


class Undecidable(Exception):
    pass


def sha(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def path_sha(path: Path) -> str:
    return sha(path.read_bytes())


def strict_json(raw: bytes) -> Any:
    def pairs(items: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in items:
            if key in result:
                raise Rig(f"duplicate JSON key: {key}")
            result[key] = value
        return result

    try:
        text = raw.decode("utf-8")
        value = json.loads(
            text,
            object_pairs_hook=pairs,
            parse_constant=lambda token: (_ for _ in ()).throw(
                ValueError(f"non-finite JSON number: {token}")
            ),
        )
    except (UnicodeError, ValueError) as exc:
        raise Rig(f"strict JSON rejected: {exc}") from exc
    return value


def canonical_sha(value: Any) -> str:
    return sha(json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
    ).encode("utf-8"))


def check(condition: bool, label: str, detail: Any = "") -> None:
    global passed, failed
    if condition:
        passed += 1
        print(f"PASS {label}")
    else:
        failed += 1
        if not isinstance(detail, str):
            detail = json.dumps(detail, ensure_ascii=False, sort_keys=True)
        failed_labels.append((label, detail))
        print(f"FAIL {label}" + (f" — {detail}" if detail else ""))


def closed_git_env(temp: Path | None = None) -> dict[str, str]:
    env = {
        "PATH": "/usr/bin:/bin",
        "LANG": "C",
        "LC_ALL": "C",
        "HOME": "/var/empty",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_ATTR_NOSYSTEM": "1",
        "GIT_PAGER": "cat",
        "PAGER": "cat",
    }
    if temp is not None:
        env["TMPDIR"] = str(temp.resolve(strict=True))
    return env


def trusted_git_valid() -> bool:
    if not TRUSTED_GIT.is_file() or TRUSTED_GIT.is_symlink():
        return False
    if path_sha(TRUSTED_GIT) != TRUSTED_GIT_SHA256:
        return False
    run = subprocess.run(
        [str(TRUSTED_GIT), "--version"], env=closed_git_env(), cwd=ROOT,
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, timeout=5, check=False,
    )
    return run.returncode == 0 and run.stdout.strip() == TRUSTED_GIT_VERSION


def git(*args: str, text: bool = False, check_result: bool = True) -> bytes | str:
    argv = [
        str(TRUSTED_GIT), "--no-replace-objects", "--no-pager",
        "--literal-pathspecs", *args,
    ]
    run = subprocess.run(
        argv, cwd=ROOT, env=closed_git_env(), stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30,
        check=False,
    )
    if check_result and run.returncode != 0:
        raise Rig(
            f"trusted git failed rc={run.returncode} argv={args!r}: "
            f"{run.stderr.decode('utf-8', 'replace')[:300]}"
        )
    return run.stdout.decode("utf-8") if text else run.stdout


def raw_commit(oid: str) -> tuple[str, list[str]]:
    raw = git("cat-file", "commit", oid)
    assert isinstance(raw, bytes)
    header = raw.split(b"\n\n", 1)[0].splitlines()
    trees = [line[5:].decode("ascii") for line in header if line.startswith(b"tree ")]
    parents = [line[7:].decode("ascii") for line in header if line.startswith(b"parent ")]
    if len(trees) != 1 or not all(re.fullmatch(r"[0-9a-f]{40}", x) for x in [*trees, *parents]):
        raise Rig(f"noncanonical commit core: {oid}")
    return trees[0], parents


def git_blob(commit: str, path: str, *, optional: bool = False) -> tuple[str, str, bytes] | None:
    listing = git("ls-tree", "-z", commit, "--", path)
    assert isinstance(listing, bytes)
    entries = [item for item in listing.split(b"\0") if item]
    if not entries and optional:
        return None
    if len(entries) != 1:
        raise Rig(f"tree cardinality for {commit}:{path}: {len(entries)}")
    meta, raw_path = entries[0].split(b"\t", 1)
    mode, kind, oid = meta.decode("ascii").split(" ")
    if raw_path.decode("utf-8") != path or kind != "blob":
        raise Rig(f"tree identity for {commit}:{path}")
    blob = git("cat-file", "blob", oid)
    assert isinstance(blob, bytes)
    return mode, oid, blob


def published_h034_identity() -> bool:
    tree, parents = raw_commit(PUBLISHED_H034_SHA)
    if tree != PUBLISHED_H034_TREE or parents != PUBLISHED_H034_PARENTS:
        return False
    candidate_tree, candidate_parents = raw_commit(H034_REVIEW_CANDIDATE)
    if candidate_tree != H034_REVIEW_TREE or candidate_parents != [PUBLISHED_H034_PARENTS[0]]:
        return False
    h034 = git_blob(PUBLISHED_H034_SHA, "verify/bin/h-034-exit")
    registry = git_blob(PUBLISHED_H034_SHA, "specs/owner-production-paths.v1.json")
    if h034 is None or registry is None:
        return False
    return sha(h034[2]) == PINNED_UNCHANGED["verify/bin/h-034-exit"] \
        and sha(registry[2]) == REGISTRY_SHA256


def config_oracle(
    document: Any, expected_launcher_sha: str, expected_helper_sha: str,
) -> tuple[bool, str]:
    if not isinstance(document, dict):
        return False, "config is not object"
    expected = json.loads(json.dumps(CONFIG_STATIC))
    products = document.get("products")
    seatbelt = document.get("seatbelt")
    if not isinstance(products, dict) or not isinstance(seatbelt, dict):
        return False, "missing product or seatbelt section"
    launcher = products.get("launcher")
    helper = products.get("runtime_snapshot")
    if not isinstance(launcher, dict) or not isinstance(helper, dict):
        return False, "bad product section"
    launcher_sha = launcher.get("sha256")
    helper_sha = helper.get("sha256")
    if not all(isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value)
               for value in (launcher_sha, helper_sha)):
        return False, "dynamic digest format"
    expected["products"]["launcher"]["sha256"] = launcher_sha
    expected["products"]["runtime_snapshot"]["sha256"] = helper_sha
    if document != expected:
        return False, "strict config shape/value mismatch"
    if launcher_sha != expected_launcher_sha or helper_sha != expected_helper_sha:
        return False, "config product digest mismatch"
    forbidden_fragments = (
        str(ROOT), "/Users/", "session_id_value", "requester_path_value",
        "profile_override_path_value", "config_self_sha256",
    )
    serialized = json.dumps(document, sort_keys=True, separators=(",", ":"))
    if any(fragment in serialized for fragment in forbidden_fragments):
        return False, "config contains live/session/socket/requester/self authority"
    return True, PROFILE_SHA256


def exact_config(raw: bytes) -> tuple[bool, str]:
    try:
        document = strict_json(raw)
    except Rig as exc:
        return False, str(exc)
    return config_oracle(document, path_sha(CLI), path_sha(HELPER))


def config_oracle_selftests() -> bool:
    launcher_sha = "11" * 32
    helper_sha = "22" * 32
    good = json.loads(json.dumps(CONFIG_STATIC))
    good["products"]["launcher"]["sha256"] = launcher_sha
    good["products"]["runtime_snapshot"]["sha256"] = helper_sha
    if not config_oracle(good, launcher_sha, helper_sha)[0]:
        return False
    mutants: list[dict[str, Any]] = []
    for flags in (["-I", "-S"], ["-I", "-S", "-B", "-B"], ["-B", "-I", "-S"]):
        mutant = json.loads(json.dumps(good))
        mutant["python"]["child_flags"] = flags
        mutants.append(mutant)
    v1_drift = json.loads(json.dumps(good))
    v1_drift["python"]["isolated_flags"] = ["-I", "-S", "-B"]
    mutants.append(v1_drift)
    self_digest = json.loads(json.dumps(good))
    self_digest["config_self_sha256"] = "44" * 32
    mutants.append(self_digest)
    live = json.loads(json.dumps(good))
    live["live_root"] = str(ROOT)
    mutants.append(live)
    override = json.loads(json.dumps(good))
    override["authority"]["profile_override_allowed"] = True
    mutants.append(override)
    inherited = json.loads(json.dumps(good))
    inherited["inherits"]["sha256"] = "00" * 32
    mutants.append(inherited)
    profile = json.loads(json.dumps(good))
    profile["seatbelt"]["profile_sha256"] = "33" * 32
    mutants.append(profile)
    base_profile = json.loads(json.dumps(good))
    base_profile["seatbelt"]["profile_without_staging_sha256"] = "55" * 32
    mutants.append(base_profile)
    return all(not config_oracle(mutant, launcher_sha, helper_sha)[0] for mutant in mutants)


def task_rows(spec: dict[str, Any], task_id: str) -> list[dict[str, Any]]:
    tasks = spec.get("tasks")
    if not isinstance(tasks, list):
        raise Rig("task spec lacks tasks list")
    return [row for row in tasks if isinstance(row, dict) and row.get("id") == task_id]


def static_contract_checks() -> None:
    try:
        compile(INNER_FIXTURE, "h036-inner-fixture", "exec")
        compile(OUTER_FIXTURE, "h036-outer-fixture", "exec")
        compile(BASE_OUTER_FIXTURE, "h036-base-outer-fixture", "exec")
    except SyntaxError as exc:
        raise Rig(f"embedded fixture syntax: {exc}") from exc
    check(trusted_git_valid(), "F_H036_TRUSTED_GIT_IDENTITY")
    check(published_h034_identity(), "F_H036_PUBLISHED_H034_MERGE_TREE_AND_ORDERED_PARENTS")
    check(
        H034_REVIEW_SHA256 == "2ce3f996eb6d2fd6c338f728d545ed25caea9ba0c99dd3676c17e1e595e27474"
        and H034_REVIEW_CANDIDATE == PUBLISHED_H034_PARENTS[1]
        and H034_REVIEW_TREE == PUBLISHED_H034_TREE,
        "F_H036_H034_INDEPENDENT_READY_REVIEW_IDENTITY_PINNED",
    )
    check(
        all((ROOT / path).is_file() and not (ROOT / path).is_symlink()
            and path_sha(ROOT / path) == digest
            for path, digest in PINNED_UNCHANGED.items()),
        "F_H036_H017_H034_H035_H037_DELEGATION_CONSTITUTION_AUTOPILOT_AUTHORITY_PRESERVED",
    )
    registry = strict_json(REGISTRY.read_bytes())
    check(registry == EXPECTED_REGISTRY, "F_H036_REGISTRY_V2_EXACT_ORDERED_UNION7")
    check(config_oracle_selftests() and fd_token_oracle_selftests(),
          "J_H036_STRICT_V2_V1_INHERITANCE_B_FLAG_AND_NO_OVERRIDE_CONFIG_ORACLE")

    spec = strict_json(SPEC.read_bytes())
    if not isinstance(spec, dict):
        raise Rig("task spec is not object")
    h036 = task_rows(spec, "h-036")
    check(len(h036) == 1, "F_H036_EXACTLY_ONE_TASK")
    if len(h036) != 1:
        raise Rig("H036 task cardinality prevents exact checks")
    task = h036[0]
    check(
        task.get("authority_class") == "owner_authority"
        and task.get("allowed_write") == []
        and task.get("owner_author_allowed_write") == PRODUCT_PATHS
        and task.get("docs_impact") == []
        and task.get("depends_on") == ["h-034"]
        and task.get("exit_test") == "verify/bin/h-036-exit"
        and task.get("max_changed_files") == 3
        and task.get("max_added_lines") == MAX_ADDED_LINES,
        "F_H036_EXACT_OWNER_TASK_DEPENDENCY_SURFACE_AND_BUDGET",
    )
    observed_task_sha = canonical_sha(task)
    check(observed_task_sha == TASK_CANONICAL_SHA256,
          "F_H036_EXACT_FROZEN_TASK_AND_RUNTIME_CONTRACT",
          {"expected": TASK_CANONICAL_SHA256, "observed": observed_task_sha})
    contract = task.get("h036_pre_sandbox_runtime_supervisor")
    check(
        isinstance(contract, dict)
        and contract.get("product_identity", {}).get("paths_and_modes")
            == [[path, PRODUCT_MODES[path]] for path in PRODUCT_PATHS]
        and contract.get("product_identity", {}).get("unbound_product_checkout_credit") is False
        and contract.get("future_dependency_transition", {}).get("h032_later_depends_exactly_on")
            == ["h-036"]
        and contract.get("prerequisite_publication", {}).get("completed_phase_gate_transition", {})
            .get("after_h036_expected_red_labels") == H034_TEMPORAL_RED_LABELS
        and contract.get("prerequisite_publication", {}).get("completed_phase_gate_transition", {})
            .get("post_h036_green_claim_forbidden") is True,
        "F_H036_THREE_PATH_RUNTIME_AND_TEMPORAL_DEPENDENCY_CONTRACT",
    )
    protocol = contract.get("handoff_protocol", {}) if isinstance(contract, dict) else {}
    profile_contract = contract.get("profile_composition", {}) \
        if isinstance(contract, dict) else {}
    helper_contract = contract.get("post_profile_helper", {}) \
        if isinstance(contract, dict) else {}
    evidence_contract = contract.get("evidence_authority", {}) \
        if isinstance(contract, dict) else {}
    check(
        protocol.get("peer_identity_is_authority") is False
        and protocol.get("original_outer_leader_pid_equality") is False
        and protocol.get("authority_source")
            == "UNFORGEABLE_CAPABILITY_TO_SERVER_OWNED_PROFILE_STATE_ONLY",
        "J_H036_DESCENDANT_PEER_IDENTITY_NOT_OUTER_LEADER_AUTHORITY",
    )
    if (
        protocol.get("header_keys_exact") != CONFIG_STATIC["protocol"]["header_keys"]
        or profile_contract.get("template_variants", {}).get("without_staging", {})
            .get("sha256") != PROFILE_BASE_SHA256
        or profile_contract.get("template_variants", {}).get("with_staging", {})
            .get("sha256") != PROFILE_SHA256
        or helper_contract.get("proof_response_keys_exact")
            != CONFIG_STATIC["protocol"]["proof_response_keys"]
        or helper_contract.get("go_request_keys_exact")
            != CONFIG_STATIC["protocol"]["go_request_keys"]
        or evidence_contract.get("source_spelling_or_ast_oracle")
            != "NON_CREDIT_SUPPORTING_DIAGNOSTIC_ONLY_NOT_IN_EXECUTABLE_ACCEPTANCE_OR_SUMMARY_AND_CANNOT_FAIL_A_SOUND_PRODUCT"
        or protocol.get("stdio_causal_effect")
            != "FD0_BYTES_EXACTLY_EQUAL_SEPARATELY_FRAMED_ENVELOPE_ALL_THREE_TARGET_DEV_INO_IDENTITIES_EQUAL_THE_PASSED_DESCRIPTORS_AND_FD1_FD2_DELIVER_EXACT_BINARY_TARGET_SENTINELS_AND_EOF"
    ):
        raise Rig("H036 task protocol/profile/proof authority drift")
    expected_task_shas = {
        "h-032": H032_TASK_CANONICAL_SHA256,
        "h-034": H034_TASK_CANONICAL_SHA256,
        "h-035": H035_TASK_CANONICAL_SHA256,
        "h-037": H037_TASK_CANONICAL_SHA256,
    }
    check(all(len(task_rows(spec, task_id)) == 1
              and canonical_sha(task_rows(spec, task_id)[0]) == digest
              for task_id, digest in expected_task_shas.items()),
          "F_H036_H032_H034_H035_H037_TASK_ROWS_PRESERVED")

    owner = OWNER_WORKFLOW.read_text(encoding="utf-8")
    decision = DECISION_LOG.read_text(encoding="utf-8")
    drift = DRIFT.read_text(encoding="utf-8")
    owner_terms = (
        "<!-- H036_PRE_SANDBOX_RUNTIME_SUPERVISOR_CONTRACT_V1 -->",
        PUBLISHED_H034_SHA,
        H034_REVIEW_SHA256,
        "H-036 depends exactly on published H-034",
        "LOCAL_PEERTOKEN",
        "post-profile syscall proof",
        "verify/bin/h-036-exit --product <base-sha> <candidate-sha>",
        "H-032 later depends exactly on published H-036",
        "not a post-H-036 green",
    )
    check(all(term in owner for term in owner_terms),
          "F_H036_OWNER_WORKFLOW_AUTHORITY_AND_LIFECYCLE_CONTRACT")
    check(decision.count("H-036 pre-sandbox runtime supervisor contract") == 1,
          "F_H036_DECISION_LOG_SINGLE_ENTRY")
    check(drift.count("## 2026-08-25 — H-036 pre-sandbox runtime supervisor contract") == 1,
          "F_H036_DRIFT_SINGLE_ENTRY")


def product_phase() -> str:
    helper = HELPER.exists()
    config = CONFIG.exists()
    if not helper and not config and path_sha(CLI) == OLD_CLI_SHA256:
        return "preproduct"
    if helper and config and path_sha(CLI) != OLD_CLI_SHA256:
        if not HELPER.is_file() or HELPER.is_symlink() or not CONFIG.is_file() or CONFIG.is_symlink():
            raise Rig("product path type is not regular no-symlink")
        ok, detail = exact_config(CONFIG.read_bytes())
        if not ok:
            raise Rig(f"runtime authority v2 rejected: {detail}")
        return "product"
    raise Rig("partial, unchanged, or path-type-invalid H036 product state")


def diff_entries(base: str, candidate: str) -> list[tuple[str, str]]:
    raw = git("diff-tree", "-r", "--no-commit-id", "--name-status", "-z",
              "--no-renames", base, candidate)
    assert isinstance(raw, bytes)
    fields = raw.split(b"\0")
    if fields and fields[-1] == b"":
        fields.pop()
    if len(fields) % 2:
        raise Rig("malformed diff-tree output")
    result: list[tuple[str, str]] = []
    for index in range(0, len(fields), 2):
        status_text = fields[index].decode("ascii")
        path = fields[index + 1].decode("utf-8")
        if status_text not in {"A", "M"}:
            raise Rig(f"unexpected product status: {status_text}")
        result.append((status_text, path))
    return result


def added_lines(base: str, candidate: str) -> tuple[int, dict[str, int]]:
    raw = git("diff", "--numstat", "-z", "--no-renames", base, candidate,
              "--", *PRODUCT_PATHS)
    assert isinstance(raw, bytes)
    rows = [row for row in raw.split(b"\0") if row]
    per_path: dict[str, int] = {}
    for row in rows:
        fields = row.decode("utf-8").split("\t")
        if len(fields) != 3 or fields[0] == "-" or fields[1] == "-":
            raise Rig("binary or malformed numstat product")
        per_path[fields[2]] = int(fields[0])
    return sum(per_path.values()), per_path


def checkout_clean(candidate: str) -> bool:
    head = str(git("rev-parse", "--verify", "HEAD", text=True)).strip()
    if head != candidate:
        return False
    status_raw = git("status", "--porcelain=v2", "-z", "--untracked-files=all")
    assert isinstance(status_raw, bytes)
    if status_raw:
        return False
    flags = git("ls-files", "-v", "-z")
    assert isinstance(flags, bytes)
    # Lowercase prefix means assume-unchanged; S/s means skip-worktree.
    for item in [x for x in flags.split(b"\0") if x]:
        prefix = item[:1]
        if prefix.islower() or prefix in {b"S", b"s"}:
            return False
    return True


def product_identity(base: str, candidate: str) -> tuple[bool, dict[str, Any]]:
    detail: dict[str, Any] = {"base": base, "candidate": candidate}
    if not re.fullmatch(r"[0-9a-f]{40}", base) or not re.fullmatch(r"[0-9a-f]{40}", candidate):
        return False, {**detail, "reason": "noncanonical oid"}
    try:
        _base_tree, _base_parents = raw_commit(base)
        _candidate_tree, candidate_parents = raw_commit(candidate)
        detail["candidate_parents"] = candidate_parents
        if candidate_parents != [base]:
            return False, {**detail, "reason": "not direct single child"}
        if not checkout_clean(candidate):
            return False, {**detail, "reason": "HEAD or physical/index state not clean"}
        changed = diff_entries(base, candidate)
        detail["changed"] = changed
        if changed != [
            ("M", "controller/launch/cli"),
            ("A", "controller/launch/runtime_snapshot.py"),
            ("A", "config/python-runtime-authority-v2.json"),
        ]:
            return False, {**detail, "reason": "wrong exact no-renames diff"}
        for path in PRODUCT_PATHS:
            before = git_blob(base, path, optional=True)
            after = git_blob(candidate, path)
            if after is None or after[0] != PRODUCT_MODES[path]:
                return False, {**detail, "reason": f"wrong candidate mode/type {path}"}
            if path == "controller/launch/cli":
                if before is None or before[0] != "100755" or sha(before[2]) != OLD_CLI_SHA256:
                    return False, {**detail, "reason": "wrong preproduct launcher identity"}
            elif before is not None:
                return False, {**detail, "reason": f"new path already exists at base: {path}"}
            if after[2] != (ROOT / path).read_bytes():
                return False, {**detail, "reason": f"checkout/object mismatch: {path}"}
        total, per_path = added_lines(base, candidate)
        detail["added_lines"] = total
        detail["added_by_path"] = per_path
        if set(per_path) != set(PRODUCT_PATHS) or total > MAX_ADDED_LINES:
            return False, {**detail, "reason": "cumulative product line budget"}
        for path in ("specs/tasks.spec.json", "verify/bin/h-036-exit"):
            before = git_blob(base, path)
            after = git_blob(candidate, path)
            if before is None or after is None or before[1] != after[1] \
                    or after[2] != (ROOT / path).read_bytes():
                return False, {**detail, "reason": f"frozen contract changed: {path}"}
        ok, why = exact_config(CONFIG.read_bytes())
        if not ok:
            return False, {**detail, "reason": why}
        if git_blob(candidate, "config/python-runtime-authority-v2.json")[2] != CONFIG.read_bytes():
            return False, {**detail, "reason": "config not candidate object"}
    except (OSError, ValueError, subprocess.SubprocessError, Rig) as exc:
        return False, {**detail, "reason": str(exc)}
    return True, detail


def host_preflight() -> None:
    if sys.platform != "darwin":
        raise Undecidable("H036 requires the authorized macOS host")
    if not SANDBOX_EXEC.is_file() or SANDBOX_EXEC.is_symlink() \
            or path_sha(SANDBOX_EXEC) != SANDBOX_EXEC_SHA256:
        raise Undecidable("pinned /usr/bin/sandbox-exec unavailable")
    if not PYTHON_SOURCE.is_file() or PYTHON_SOURCE.is_symlink() \
            or path_sha(PYTHON_SOURCE) != PYTHON_SHA256:
        raise Undecidable("pinned Python 3.12.13 unavailable")
    version = subprocess.run(
        [str(PYTHON_SOURCE), "-I", "-S", "-B", "-c",
         "import sys;print(sys.version.split()[0])"],
        env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"},
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, timeout=5, check=False,
    )
    if version.returncode != 0 or version.stdout.strip() != PYTHON_VERSION:
        raise Undecidable("pinned Python version mismatch")
    probe = subprocess.run(
        [str(SANDBOX_EXEC), "-p", "(version 1)\n(allow default)", "/usr/bin/true"],
        env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"},
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, timeout=5, check=False,
    )
    if probe.returncode == 71 and "sandbox_apply: Operation not permitted" in probe.stderr:
        raise Undecidable("gate itself is already Seatbelt-confined; un-nested host required")
    if probe.returncode != 0:
        raise Undecidable(f"Seatbelt availability probe rc={probe.returncode}: {probe.stderr[:200]}")


def runtime_roots() -> set[str]:
    parent = Path("/private/tmp")
    try:
        return {str(path) for path in parent.iterdir()
                if path.name.startswith(".nortropic-h036-runtime-")}
    except OSError as exc:
        raise Undecidable(f"cannot inspect fixed runtime parent: {exc}") from exc


def make_python_snapshot(root: Path) -> Path:
    snapshot_root = root / "python-authority"
    snapshot_root.mkdir(mode=0o700)
    snapshot = snapshot_root / "python3.12"
    source_fd = os.open(PYTHON_SOURCE, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0))
    try:
        opened = os.fstat(source_fd)
        if not stat.S_ISREG(opened.st_mode):
            raise Rig("pinned Python source is not regular")
        with os.fdopen(os.dup(source_fd), "rb", closefd=True) as source, \
                snapshot.open("xb") as target:
            shutil.copyfileobj(source, target)
            target.flush()
            os.fsync(target.fileno())
    finally:
        os.close(source_fd)
    snapshot.chmod(0o500)
    snapshot_root.chmod(0o500)
    if path_sha(snapshot) != PYTHON_SHA256:
        raise Rig("gate private Python snapshot digest mismatch")
    return snapshot


def subject_effects() -> tuple[bool, dict[str, Any]]:
    """Run only the actual three-file product through the public launcher.

    The fixture scripts are gate data.  They report observations, while credit
    comes from controller-owned path state and real syscall outcomes inspected
    by this gate.  No source-form match or subject marker can replace effects.
    """
    host_preflight()
    return run_subject_matrix()


def closed_subject_env(trust: Path, shim: Path, canary: str) -> dict[str, str]:
    return {
        "PATH": f"{shim}:/usr/bin:/bin",
        "LANG": "C",
        "LC_ALL": "C",
        "NORTROPIC_TRUST_ROOT": str(trust),
        "H036_GATE_PRESERVE": "preserved-exact-value",
        "H036_GATE_SUPERVISOR_CANARY": canary,
        "GH_TOKEN": "must-not-reach-target",
        "GITHUB_TOKEN": "must-not-reach-target",
        "SLACK_TOKEN": "must-not-reach-target",
        "GIT_CONFIG_GLOBAL": "/forbidden/git-config",
        "GIT_DIR": "/forbidden/git-dir",
        "DYLD_INSERT_LIBRARIES": "/forbidden/loader.dylib",
        "DYLD_LIBRARY_PATH": "/forbidden/dyld",
        "PYTHONPATH": "/forbidden/pythonpath",
        "PYTHONHOME": "/forbidden/pythonhome",
        "PYTHONDONTWRITEBYTECODE": "0",
        "LD_PRELOAD": "/forbidden/preload.so",
        "LD_LIBRARY_PATH": "/forbidden/ld",
        "__PYVENV_LAUNCHER__": "/forbidden/launcher",
    }


def launch(
    python: Path,
    workspace: Path,
    envelope: Path,
    timeout_seconds: str,
    command: list[str],
    env: dict[str, str],
    *,
    outer_timeout: float = 30.0,
) -> subprocess.CompletedProcess[bytes]:
    if not workspace.is_dir() or not envelope.is_file():
        raise Rig("gate launch fixture must preexist")
    return subprocess.run(
        [str(python), "-I", "-S", "-B", str(CLI), "run", str(workspace),
         str(envelope), timeout_seconds, "--", *command],
        cwd=workspace, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=outer_timeout,
        check=False,
    )


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def wait_pid_gone(pid: int, seconds: float = 6.0) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if not pid_alive(pid):
            return True
        time.sleep(0.05)
    return not pid_alive(pid)


def wait_file(path: Path, seconds: float = 6.0) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if path.is_file():
            return True
        time.sleep(0.05)
    return path.is_file()


def process_start_record(pid: int) -> dict[str, Any] | None:
    """Return one exact BSD process identity without trusting a PID alone."""
    try:
        run = subprocess.run(
            [
                "/bin/ps", "-p", str(pid), "-o", "pid=", "-o", "ppid=",
                "-o", "pgid=", "-o", "uid=", "-o", "lstart=", "-o", "stat=",
                "-o", "command=",
            ],
            env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"},
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, timeout=3, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    fields = run.stdout.strip().split(None, 10)
    if run.returncode != 0 or len(fields) != 11:
        return None
    try:
        observed_pid, ppid, pgid, euid = (int(fields[index]) for index in range(4))
        sid = os.getsid(observed_pid)
    except (ProcessLookupError, ValueError):
        return None
    return {
        "pid": observed_pid,
        "ppid": ppid,
        "pgid": pgid,
        "sid": sid,
        "euid": euid,
        "start": " ".join(fields[4:9]),
        "state": fields[9],
        "command": fields[10],
    }


def process_table_snapshot() -> list[dict[str, Any]]:
    """Enumerate the BSD process table with start, group and session identity."""
    try:
        run = subprocess.run(
            [
                "/bin/ps", "-axo", "pid=", "-o", "ppid=", "-o", "pgid=",
                "-o", "uid=", "-o", "lstart=", "-o", "stat=", "-o", "command=",
            ],
            env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"},
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, timeout=3, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return [{"rig_error": "process-enumeration-failed"}]
    result: list[dict[str, Any]] = []
    for line in run.stdout.splitlines():
        fields = line.strip().split(None, 10)
        if len(fields) != 11:
            continue
        try:
            observed_pid, ppid, observed_pgid, euid = (
                int(fields[index]) for index in range(4)
            )
            sid = os.getsid(observed_pid)
        except (ProcessLookupError, ValueError):
            continue
        result.append({
            "pid": observed_pid,
            "ppid": ppid,
            "pgid": observed_pgid,
            "sid": sid,
            "euid": euid,
            "start": " ".join(fields[4:9]),
            "state": fields[9],
            "command": fields[10],
        })
    return sorted(result, key=lambda item: int(item.get("pid", -1)))


def process_group_snapshot(pgid: int) -> list[dict[str, Any]]:
    table = process_table_snapshot()
    errors = [item for item in table if "rig_error" in item]
    return errors or [item for item in table if item.get("pgid") == pgid]


def process_session_snapshot(sid: int) -> list[dict[str, Any]]:
    table = process_table_snapshot()
    errors = [item for item in table if "rig_error" in item]
    return errors or [item for item in table if item.get("sid") == sid]


def child_exit_wnowait(pid: int) -> tuple[bool, str]:
    """Observe one direct child exit without consuming its wait status."""
    libc_name = ctypes.util.find_library("c") or "/usr/lib/libSystem.B.dylib"
    libc = ctypes.CDLL(libc_name, use_errno=True)
    waitid = libc.waitid
    waitid.argtypes = [ctypes.c_int, ctypes.c_uint, ctypes.c_void_p, ctypes.c_int]
    waitid.restype = ctypes.c_int
    info = ctypes.create_string_buffer(256)
    ctypes.set_errno(0)
    rc = waitid(
        int(os.P_PID), int(pid), ctypes.byref(info),
        int(os.WEXITED | os.WNOHANG | os.WNOWAIT),
    )
    if rc != 0:
        value = ctypes.get_errno()
        return False, f"waitid:{value}:{os.strerror(value)}"
    # Darwin zero-fills siginfo when WNOHANG has no event.  Any populated
    # field under WEXITED is an exited child, still reserved and unreaped.
    return any(info.raw), ""


def owned_group_run(
    argv: list[str], *, cwd: Path, env: dict[str, str], timeout: float,
    identity_path: Path | None = None,
) -> tuple[subprocess.CompletedProcess[bytes], dict[str, Any]]:
    """Run one test fixture in a gate-owned session and always reap its group.

    The direct ``Popen`` object pins the leader PID against reuse until it is
    communicated/reaped.  Its exact start record reserves the PGID while TERM
    settles.  Every still-live member must match the pre-TERM start/euid/group/
    session record and, for forced reference cases, a fixture-reported audit
    pidversion plus lineage nonce.  KILL therefore precedes leader reap; a
    zombie-only group is reaped without signalling a potentially reused PGID.
    """
    proc = subprocess.Popen(
        argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
        close_fds=True,
    )
    leader = process_start_record(proc.pid)
    try:
        pgid = os.getpgid(proc.pid)
    except ProcessLookupError:
        pgid = -1
    identity_ok = (
        leader is not None and leader.get("pid") == proc.pid
        and leader.get("pgid") == proc.pid and leader.get("sid") == proc.pid
        and leader.get("euid") == os.geteuid() and pgid == proc.pid
    )
    timed_out = False
    exit_observed_wnowait = False
    waitid_error = ""
    termination = "none"
    stdout = b""
    stderr = b""
    cleanup_before: list[dict[str, Any]] = []
    signal_error = ""
    authority: dict[str, Any] = {}
    member_authority_bound = identity_path is None
    leader_reserved_until_cleanup = False
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        exit_observed_wnowait, waitid_error = child_exit_wnowait(proc.pid)
        if waitid_error or exit_observed_wnowait:
            break
        time.sleep(0.01)
    timed_out = not exit_observed_wnowait
    # WNOWAIT is the direct kernel proof that this Popen-owned child has
    # exited but remains unreaped.  Its PID/PGID reservation does not depend on
    # whether `/bin/ps` chooses to display the zombie.
    leader_reserved_until_cleanup = (
        exit_observed_wnowait and proc.returncode is None
    )
    try:
        if identity_path is not None:
            try:
                candidate = strict_json(identity_path.read_bytes())
                if isinstance(candidate, dict):
                    authority = candidate
            except (OSError, Rig):
                authority = {}
        cleanup_before = process_group_snapshot(pgid) if pgid > 1 else []
        enumeration_ok = not any("rig_error" in item for item in cleanup_before)
        identity_ok = identity_ok and not waitid_error and enumeration_ok
        declared_for_empty = authority.get("members") \
            if isinstance(authority, dict) else None
        if not cleanup_before and identity_path is not None:
            member_authority_bound = (
                isinstance(declared_for_empty, list) and len(declared_for_empty) >= 2
                and all(
                    isinstance(item, dict)
                    and type(item.get("pid")) is int and item.get("pid", -1) > 1
                    and type(item.get("pidversion")) is int
                    and item.get("pidversion", -1) >= 0
                    and item.get("euid") == os.geteuid()
                    and item.get("pgid") == pgid and item.get("sid") == pgid
                    and isinstance(item.get("nonce"), str)
                    and re.fullmatch(r"[0-9a-f]{64}", item["nonce"]) is not None
                    for item in declared_for_empty
                )
            )
            identity_ok = identity_ok and member_authority_bound
        if cleanup_before:
            current = process_start_record(proc.pid)
            leader_still_bound = leader_reserved_until_cleanup or (
                current is not None and leader is not None
                and (current.get("pid"), current.get("pgid"), current.get("start"))
                == (leader.get("pid"), leader.get("pgid"), leader.get("start"))
            )
            leader_reserved_until_cleanup = leader_reserved_until_cleanup or (
                leader_still_bound and proc.returncode is None
            )
            identity_ok = identity_ok and leader_still_bound
            initial_by_pid = {
                item.get("pid"): item for item in cleanup_before
                if type(item.get("pid")) is int
            }

            def authoritative(item: dict[str, Any]) -> bool:
                initial = initial_by_pid.get(item.get("pid"))
                if not isinstance(initial, dict):
                    return False
                stable = (
                    item.get("pid"), item.get("pgid"), item.get("sid"),
                    item.get("euid"), item.get("start"),
                ) == (
                    initial.get("pid"), initial.get("pgid"), initial.get("sid"),
                    initial.get("euid"), initial.get("start"),
                )
                if identity_path is None:
                    return stable
                members = authority.get("members")
                if not isinstance(members, list):
                    return False
                declared = next(
                    (value for value in members
                     if isinstance(value, dict) and value.get("pid") == item.get("pid")),
                    None,
                )
                return stable and isinstance(declared, dict) and (
                    declared.get("pid"), declared.get("pgid"), declared.get("sid"),
                    declared.get("euid"),
                ) == (
                    item.get("pid"), item.get("pgid"), item.get("sid"),
                    item.get("euid"),
                ) and type(declared.get("pidversion")) is int \
                    and declared.get("pidversion", -1) >= 0 \
                    and declared.get("lineage") in {
                        "reference-main-v1", "reference-outer-v1",
                        "reference-error-child-v1",
                    } \
                    and isinstance(declared.get("nonce"), str) \
                    and re.fullmatch(r"[0-9a-f]{64}", declared["nonce"]) is not None

            member_authority_bound = all(authoritative(item) for item in cleanup_before)
            identity_ok = identity_ok and member_authority_bound
            live_before = [
                item for item in cleanup_before
                if "rig_error" not in item
                and not str(item.get("state", "")).startswith("Z")
            ]
            # Popen(start_new_session=True) is the cleanup capability.  The
            # unreaped direct leader reserves its PID/PGID even when process
            # diagnostics or a fixture receipt are missing.  Missing evidence
            # makes PASS impossible; it must never suppress cleanup.
            cleanup_authority = pgid == proc.pid and proc.returncode is None
            if cleanup_authority and (timed_out or live_before):
                try:
                    os.killpg(pgid, signal.SIGTERM)
                    termination = "term"
                except ProcessLookupError:
                    pass
            deadline = time.monotonic() + 2.0
            while time.monotonic() < deadline:
                remaining_now = process_group_snapshot(pgid)
                if any("rig_error" in item for item in remaining_now):
                    identity_ok = False
                    break
                if not any(
                    not str(item.get("state", "")).startswith("Z")
                    for item in remaining_now
                ):
                    break
                time.sleep(0.05)
            remaining = process_group_snapshot(pgid)
            live_remaining = [
                item for item in remaining
                if "rig_error" not in item
                and not str(item.get("state", "")).startswith("Z")
            ]
            if any("rig_error" in item for item in remaining):
                identity_ok = False
            live_bound = all(authoritative(item) for item in live_remaining)
            identity_ok = identity_ok and live_bound
            if (live_remaining or any("rig_error" in item for item in remaining)) \
                    and cleanup_authority:
                try:
                    os.killpg(pgid, signal.SIGKILL)
                    termination = "kill"
                except (ProcessLookupError, PermissionError) as exc:
                    signal_error = type(exc).__name__
        try:
            stdout, stderr = proc.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            # The leader is still unreaped here, so its Popen-owned PGID is
            # still safe to signal even when evidence was incomplete.
            if pgid == proc.pid and proc.returncode is None:
                try:
                    os.killpg(pgid, signal.SIGKILL)
                    termination = "kill"
                except (ProcessLookupError, PermissionError) as exc:
                    signal_error = type(exc).__name__
            stdout, stderr = proc.communicate(timeout=5)
    finally:
        # No path exits with a live direct child.  This final guard is cleanup
        # authority only and can never repair missing PASS evidence.
        if proc.returncode is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            try:
                stdout, stderr = proc.communicate(timeout=5)
            except subprocess.TimeoutExpired as exc:
                raise Rig("owned group could not be reaped") from exc
    declared_members = authority.get("members") if isinstance(authority, dict) else []
    if not isinstance(declared_members, list):
        declared_members = []
    tracked_pids = {
        proc.pid,
        *(
            item.get("pid") for item in cleanup_before
            if type(item.get("pid")) is int
        ),
        *(
            item.get("pid") for item in declared_members
            if isinstance(item, dict) and type(item.get("pid")) is int
        ),
    }
    absence_samples: list[bool] = []
    for _sample in range(2):
        absence_samples.append(
            pgid > 1
            and not process_group_snapshot(pgid)
            and not process_session_snapshot(pgid)
            and all(not pid_alive(pid) for pid in tracked_pids)
        )
        time.sleep(0.05)
    final = subprocess.CompletedProcess(argv, proc.returncode, stdout, stderr)
    return final, {
        "leader": leader,
        "pgid": pgid,
        "identity_bound": identity_ok,
        "member_authority_bound": member_authority_bound,
        "timed_out": timed_out,
        "waitid_error": waitid_error,
        "wnowait_exit_observed": exit_observed_wnowait,
        "leader_reserved_until_cleanup": leader_reserved_until_cleanup,
        "termination": termination,
        "signal_error": signal_error,
        "cleanup_members": cleanup_before,
        "known_pids": sorted(tracked_pids),
        "zombies_before_cleanup": [
            item.get("pid") for item in cleanup_before
            if str(item.get("state", "")).startswith("Z")
        ],
        "absence_samples": absence_samples,
        "group_absent": all(absence_samples),
        "reaped": proc.returncode is not None,
    }


def kernel_process_argv(pid: int) -> tuple[list[str], bool]:
    """Read exact NUL-delimited argv through Darwin KERN_PROCARGS2."""
    before = process_start_record(pid)
    if before is None:
        return [], False
    libc_name = ctypes.util.find_library("c") or "/usr/lib/libSystem.B.dylib"
    libc = ctypes.CDLL(libc_name, use_errno=True)
    sysctl = libc.sysctl
    sysctl.argtypes = [
        ctypes.POINTER(ctypes.c_int), ctypes.c_uint, ctypes.c_void_p,
        ctypes.POINTER(ctypes.c_size_t), ctypes.c_void_p, ctypes.c_size_t,
    ]
    sysctl.restype = ctypes.c_int
    argmax = ctypes.c_int()
    argmax_size = ctypes.c_size_t(ctypes.sizeof(argmax))
    argmax_mib = (ctypes.c_int * 2)(1, 8)  # CTL_KERN, KERN_ARGMAX
    if sysctl(argmax_mib, 2, ctypes.byref(argmax), ctypes.byref(argmax_size), None, 0) != 0 \
            or not 4096 <= argmax.value <= 16 * 1024 * 1024:
        return [], False
    buffer = ctypes.create_string_buffer(argmax.value)
    size = ctypes.c_size_t(len(buffer))
    procargs_mib = (ctypes.c_int * 3)(1, 49, pid)  # CTL_KERN, KERN_PROCARGS2
    if sysctl(procargs_mib, 3, buffer, ctypes.byref(size), None, 0) != 0 \
            or size.value < ctypes.sizeof(ctypes.c_int):
        return [], False
    raw = buffer.raw[:size.value]
    argc = struct.unpack_from("=i", raw)[0]
    if not 1 <= argc <= 4096:
        return [], False
    position = ctypes.sizeof(ctypes.c_int)
    executable_end = raw.find(b"\0", position)
    if executable_end < 0:
        return [], False
    position = executable_end
    while position < len(raw) and raw[position] == 0:
        position += 1
    argv_raw: list[bytes] = []
    for _index in range(argc):
        end = raw.find(b"\0", position)
        if end < 0:
            return [], False
        argv_raw.append(raw[position:end])
        position = end + 1
    try:
        argv = [value.decode("utf-8", "strict") for value in argv_raw]
    except UnicodeError:
        return [], False
    after = process_start_record(pid)
    bound = after is not None and (
        before.get("pid"), before.get("euid"), before.get("start"),
        before.get("pgid"), before.get("sid"),
    ) == (
        after.get("pid"), after.get("euid"), after.get("start"),
        after.get("pgid"), after.get("sid"),
    )
    return argv, bound


def process_argv_environment(
    pid: int,
) -> tuple[list[str], dict[str, Any], bool]:
    """Bind exact kernel argv; never award cross-process environment credit.

    Darwin's cross-process KERN_PROCARGS2 result ends after ``argc`` argv
    strings on the required host; it does not expose a NUL-preserving envp.
    ``ps eww`` is space-delimited/non-injective and, on this host, emits no
    envp at all.  It is therefore absent from every PASS predicate.  Exact
    environment construction and ``close_fds/pass_fds`` reachability are
    mandatory immutable-object-review obligations.
    """
    argv, kernel_bound = kernel_process_argv(pid)
    if not kernel_bound or not argv or any(re.search(r"\s", value) for value in argv):
        return argv, {"credit": "NONE"}, False
    return argv, {
        "credit": "NONE_ENVIRONMENT_IMMUTABLE_OBJECT_REVIEW_ONLY",
        "exact_exec_environment_credit": False,
        "dynamic_ps_environment_pass_predicate": False,
        "required_host_cross_process_nul_envp": "UNAVAILABLE",
    }, True


def valid_decimal_fd(value: Any) -> bool:
    return (
        isinstance(value, str)
        and re.fullmatch(r"0|[1-9][0-9]*", value) is not None
        and int(value) >= 3
    )


def fd_token_oracle_selftests() -> bool:
    valid = ("3", "9", "10", "29", "2147483647")
    invalid: tuple[Any, ...] = (
        "0", "1", "2", "-3", "+3", "03", "3.0", "3x", "", 3, True,
    )
    return all(valid_decimal_fd(value) for value in valid) \
        and all(not valid_decimal_fd(value) for value in invalid)


def kernel_process_observer_selftests() -> tuple[bool, dict[str, Any]]:
    """Prove argv is exact and ps env evidence stays explicitly non-credit."""
    cases = {
        "exact": dict(CONFIG_STATIC["supervisor_environment"]),
        "lang_trailing_space": {
            **CONFIG_STATIC["supervisor_environment"], "LANG": "C ",
        },
        "embedded_credential_boundary": {
            **CONFIG_STATIC["supervisor_environment"],
            "PATH": "/usr/bin:/bin GH_TOKEN=must-not-reach-target",
        },
        "embedded_loader_boundary": {
            **CONFIG_STATIC["supervisor_environment"],
            "LANG": "C DYLD_INSERT_LIBRARIES=/forbidden/loader.dylib",
        },
    }
    observed: dict[str, Any] = {}
    ok = True
    for name, environment in cases.items():
        proc = subprocess.Popen(
            ["/bin/sleep", "30"], env=environment, stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True, close_fds=True,
        )
        try:
            argv, environment_evidence, corroborated = process_argv_environment(proc.pid)
            fd_table, fd_bound = process_open_fds(proc.pid)
            observed[name] = {
                "argv": argv, "environment_evidence": environment_evidence,
                "corroborated": corroborated, "complete_fd_table": fd_table,
                "fd_table_identity_bound": fd_bound,
            }
            ok = ok and argv == ["/bin/sleep", "30"] \
                and environment_evidence.get("exact_exec_environment_credit") is False \
                and environment_evidence.get("dynamic_ps_environment_pass_predicate") is False \
                and corroborated is True \
                and fd_bound and {number for number, _kind in fd_table} == {0, 1, 2}
        finally:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                proc.communicate(timeout=2)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
                proc.communicate(timeout=2)
    return ok, observed


def process_open_fds(pid: int) -> tuple[list[tuple[int, int]], bool]:
    """Return the complete Darwin libproc FD table for one stable PID."""
    before = process_start_record(pid)
    if before is None:
        return [], False
    libproc_name = ctypes.util.find_library("proc") or "/usr/lib/libproc.dylib"
    libproc = ctypes.CDLL(libproc_name, use_errno=True)
    proc_pidinfo = libproc.proc_pidinfo
    proc_pidinfo.argtypes = [
        ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int,
    ]
    proc_pidinfo.restype = ctypes.c_int
    required = proc_pidinfo(pid, 1, 0, None, 0)  # PROC_PIDLISTFDS
    if required <= 0 or required > 16 * 1024 * 1024:
        return [], False
    received = -1
    buffer = ctypes.create_string_buffer(1)
    stable_size = False
    for _attempt in range(4):
        capacity = max(required * 2 + 4096, 8192)
        if capacity > 16 * 1024 * 1024:
            return [], False
        first = ctypes.create_string_buffer(capacity)
        first_received = proc_pidinfo(pid, 1, 0, first, len(first))
        required_after = proc_pidinfo(pid, 1, 0, None, 0)
        if first_received < 0 or required_after <= 0 \
                or required_after > 16 * 1024 * 1024:
            return [], False
        second = ctypes.create_string_buffer(capacity)
        second_received = proc_pidinfo(pid, 1, 0, second, len(second))
        if second_received < 0:
            return [], False
        if (
            first_received == second_received
            and first_received < capacity
            and first_received % 8 == 0
            and first.raw[:first_received] == second.raw[:second_received]
            and required_after < capacity
        ):
            buffer = second
            received = second_received
            stable_size = True
            break
        required = max(required_after, first_received, second_received)
    if not stable_size or received % 8 != 0:
        return [], False
    values = [
        struct.unpack_from("=iI", buffer.raw, offset)
        for offset in range(0, received, 8)
    ]
    after = process_start_record(pid)
    bound = after is not None and (
        before.get("pid"), before.get("euid"), before.get("start"),
        before.get("pgid"), before.get("sid"),
    ) == (
        after.get("pid"), after.get("euid"), after.get("start"),
        after.get("pgid"), after.get("sid"),
    ) and len({number for number, _kind in values}) == len(values) \
        and all(number >= 0 for number, _kind in values)
    return sorted(values), bound


class _ProcFileInfo(ctypes.Structure):
    _fields_ = [
        ("openflags", ctypes.c_uint32), ("status", ctypes.c_uint32),
        ("offset", ctypes.c_int64), ("kind", ctypes.c_int32),
        ("guardflags", ctypes.c_uint32),
    ]


class _VinfoStat(ctypes.Structure):
    _fields_ = [
        ("dev", ctypes.c_uint32), ("mode", ctypes.c_uint16),
        ("nlink", ctypes.c_uint16), ("ino", ctypes.c_uint64),
        ("uid", ctypes.c_uint32), ("gid", ctypes.c_uint32),
        ("atime", ctypes.c_int64), ("atimensec", ctypes.c_int64),
        ("mtime", ctypes.c_int64), ("mtimensec", ctypes.c_int64),
        ("ctime", ctypes.c_int64), ("ctimensec", ctypes.c_int64),
        ("birthtime", ctypes.c_int64), ("birthtimensec", ctypes.c_int64),
        ("size", ctypes.c_int64), ("blocks", ctypes.c_int64),
        ("blksize", ctypes.c_int32), ("flags", ctypes.c_uint32),
        ("gen", ctypes.c_uint32), ("rdev", ctypes.c_uint32),
        ("qspare", ctypes.c_int64 * 2),
    ]


class _PipeInfo(ctypes.Structure):
    _fields_ = [
        ("pipe_stat", _VinfoStat), ("handle", ctypes.c_uint64),
        ("peerhandle", ctypes.c_uint64), ("status", ctypes.c_int32),
        ("reserved", ctypes.c_int32),
    ]


class _PipeFdInfo(ctypes.Structure):
    _fields_ = [("file", _ProcFileInfo), ("pipe", _PipeInfo)]


def process_fd_roles(
    pid: int, table: list[tuple[int, int]],
) -> tuple[list[dict[str, Any]], bool]:
    """Bind every listed fd to libproc type, access mode and object identity."""
    if ctypes.sizeof(_ProcFileInfo) != 24 \
            or ctypes.sizeof(_VinfoStat) != 136 \
            or ctypes.sizeof(_PipeFdInfo) != 184:
        return [], False
    before = process_start_record(pid)
    if before is None:
        return [], False
    libproc_name = ctypes.util.find_library("proc") or "/usr/lib/libproc.dylib"
    libproc = ctypes.CDLL(libproc_name, use_errno=True)
    proc_pidfdinfo = libproc.proc_pidfdinfo
    proc_pidfdinfo.argtypes = [
        ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_void_p, ctypes.c_int,
    ]
    proc_pidfdinfo.restype = ctypes.c_int
    flavor_by_type = {1: 2, 2: 3, 6: 6}
    def read_roles_once() -> list[dict[str, Any]] | None:
        observed: list[dict[str, Any]] = []
        for number, fd_type in table:
            flavor = flavor_by_type.get(fd_type)
            if flavor is None:
                return None
            raw = ctypes.create_string_buffer(8192)
            received = proc_pidfdinfo(pid, number, flavor, raw, len(raw))
            if received < ctypes.sizeof(_ProcFileInfo) + ctypes.sizeof(_VinfoStat) \
                    or received >= len(raw):
                return None
            file_info = _ProcFileInfo.from_buffer_copy(raw.raw)
            identity = _VinfoStat.from_buffer_copy(
                raw.raw, ctypes.sizeof(_ProcFileInfo),
            )
            role: dict[str, Any] = {
                "fd": number, "type": fd_type,
                "access_mode": file_info.openflags & os.O_ACCMODE,
                "close_on_exec": bool(file_info.status & 2),
                "dev_ino": [identity.dev, identity.ino],
                "mode": identity.mode, "nlink": identity.nlink,
            }
            if fd_type == 6:
                if received != ctypes.sizeof(_PipeFdInfo):
                    return None
                pipe = _PipeFdInfo.from_buffer_copy(raw.raw)
                role.update({
                    "pipe_handle": pipe.pipe.handle,
                    "pipe_peer_handle": pipe.pipe.peerhandle,
                })
            elif fd_type == 2:
                if received < ctypes.sizeof(_ProcFileInfo) \
                        + ctypes.sizeof(_VinfoStat) + 28:
                    return None
                socket_handle, socket_pcb, socket_type, socket_protocol, socket_family = \
                    struct.unpack_from(
                        "=QQiii", raw.raw,
                        ctypes.sizeof(_ProcFileInfo) + ctypes.sizeof(_VinfoStat),
                    )
                role.update({
                    "socket_handle": socket_handle, "socket_pcb": socket_pcb,
                    "socket_type": socket_type,
                    "socket_protocol": socket_protocol,
                    "socket_family": socket_family,
                })
            observed.append(role)
        return observed

    roles = read_roles_once()
    roles_again = read_roles_once()
    if roles is None or roles_again is None or roles != roles_again:
        return [], False
    after_table, table_bound = process_open_fds(pid)
    after = process_start_record(pid)
    bound = table_bound and after_table == table and after is not None and (
        before.get("pid"), before.get("euid"), before.get("start"),
        before.get("pgid"), before.get("sid"),
    ) == (
        after.get("pid"), after.get("euid"), after.get("start"),
        after.get("pgid"), after.get("sid"),
    ) and len(roles) == len(table)
    return roles, bound


def target_fd_namespace_closed(record: Any) -> bool:
    """Validate a target's complete /dev/fd scan and inherited RLIMIT."""
    soft_limit = resource.getrlimit(resource.RLIMIT_NOFILE)[0]
    return (
        isinstance(record, dict)
        and type(record.get("fd_soft_limit")) is int
        and record.get("fd_soft_limit") == soft_limit
        and record.get("open_fds") == []
    )


def stable_runtime_python(path: Path, root: Path) -> tuple[bool, dict[str, Any]]:
    detail: dict[str, Any] = {"path": str(path)}
    fd = -1
    try:
        root_stat = root.lstat()
        before = path.lstat()
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0))
        opened = os.fstat(fd)
        digest = hashlib.sha256()
        while True:
            block = os.read(fd, 1024 * 1024)
            if not block:
                break
            digest.update(block)
        after = path.lstat()
        detail.update({
            "root_dev_ino": [root_stat.st_dev, root_stat.st_ino],
            "root_mode": oct(root_stat.st_mode & 0o777),
            "python_dev_ino": [opened.st_dev, opened.st_ino],
            "python_mode": oct(opened.st_mode & 0o777),
            "python_sha256": digest.hexdigest(),
        })
        ok = (
            root.parent == Path("/private/tmp")
            and root.name.startswith(".nortropic-h036-runtime-")
            and not root.is_symlink() and stat.S_ISDIR(root_stat.st_mode)
            and (root_stat.st_mode & 0o777) == 0o500
            and path.parent == root and not path.is_symlink()
            and stat.S_ISREG(before.st_mode) and stat.S_ISREG(opened.st_mode)
            and stat.S_ISREG(after.st_mode)
            and (before.st_dev, before.st_ino) == (opened.st_dev, opened.st_ino)
            == (after.st_dev, after.st_ino)
            and (opened.st_mode & 0o777) == 0o500
            and opened.st_nlink == 1 and digest.hexdigest() == PYTHON_SHA256
        )
        return ok, detail
    except OSError as exc:
        return False, {**detail, "error": f"{type(exc).__name__}:{exc.errno}"}
    finally:
        if fd >= 0:
            os.close(fd)


def runtime_canaries_unchanged(root: Path) -> tuple[bool, dict[str, Any]]:
    prefix = f".nortropic-h036-proof-{PROOF_NONCE}-runtime"
    sources = {
        name: root / f"{prefix}-{name}-source"
        for name in ("write", "rename", "unlink", "hardlink")
    }
    absent = {
        "create": root / f"{prefix}-created",
        "mkdir": root / f"{prefix}-new-dir",
        "rename_target": root / f"{prefix}-rename-target",
        "hardlink_target": root / f"{prefix}-hardlink-target",
    }
    source_state: dict[str, Any] = {}
    ok = True
    for name, path in sources.items():
        try:
            opened = path.lstat()
            raw = path.read_bytes()
            source_state[name] = {
                "dev_ino": [opened.st_dev, opened.st_ino],
                "mode": oct(opened.st_mode & 0o777),
                "nlink": opened.st_nlink,
                "sha256": sha(raw),
            }
            ok = ok and not path.is_symlink() and stat.S_ISREG(opened.st_mode) \
                and raw == b"ORIGINAL" and (opened.st_mode & 0o777) == 0o600 \
                and opened.st_nlink == 1
        except OSError as exc:
            source_state[name] = {"error": f"{type(exc).__name__}:{exc.errno}"}
            ok = False
    absent_state = {name: not path.exists() for name, path in absent.items()}
    return ok and all(absent_state.values()), {
        "sources": source_state,
        "targets_absent": absent_state,
    }


def path_identities(paths: list[Path]) -> set[tuple[int, int]]:
    result: set[tuple[int, int]] = set()
    for path in paths:
        try:
            info = os.lstat(path)
        except OSError:
            continue
        result.add((info.st_dev, info.st_ino))
    return result


def classify_retained_fds(
    roles: list[dict[str, Any]], *,
    passed_stdio_identities: set[tuple[int, int]],
    allowed_directory_identities: set[tuple[int, int]],
    allowed_regular_identities: set[tuple[int, int]],
) -> tuple[dict[str, str], list[int]]:
    """Account every retained descriptor by class; unclassifiable fails closed.

    Closed classes only: AF_UNIX stream sockets; non-regular stdio at 0/1/2;
    SCM-passed stdio pipe identities; entropy character devices; lane-known
    sealed-root directory identities; lane-known regular-file identities.
    Any other retained kernel object — foreign socket family, unexpected pipe,
    /dev/null filler outside stdio, unknown directory or regular file — is
    unaccounted regardless of its descriptor number, and aliases/dups are
    classified per descriptor by the same attribute rules.
    """
    entropy = path_identities([Path("/dev/urandom"), Path("/dev/random")])
    classification: dict[str, str] = {}
    unaccounted: list[int] = []
    for role in roles:
        number = role.get("fd")
        if type(number) is not int:
            unaccounted.append(-1)
            continue
        mode = role.get("mode")
        mode = mode if type(mode) is int else 0
        pair = role.get("dev_ino")
        identity = tuple(pair) if isinstance(pair, list) and len(pair) == 2 else ()
        verdict: str | None = None
        if role.get("type") == 2:
            if role.get("socket_family") == socket.AF_UNIX \
                    and role.get("socket_type") == socket.SOCK_STREAM:
                verdict = "af_unix_stream_socket"
        elif number in (0, 1, 2):
            if stat.S_ISFIFO(mode) or stat.S_ISCHR(mode):
                verdict = "stdio_nonregular"
        elif stat.S_ISFIFO(mode):
            if identity in passed_stdio_identities:
                verdict = "passed_stdio_pipe"
        elif stat.S_ISCHR(mode):
            if identity in entropy:
                verdict = "entropy_device"
        elif stat.S_ISDIR(mode):
            if identity in allowed_directory_identities:
                verdict = "sealed_root_dirfd"
        elif stat.S_ISREG(mode):
            if identity in allowed_regular_identities:
                verdict = "lane_known_regular"
        if verdict is None:
            unaccounted.append(number)
        else:
            classification[str(number)] = verdict
    return classification, sorted(unaccounted)


def descriptor_classifier_selftests() -> tuple[bool, dict[str, Any]]:
    """Falsify the retained-descriptor observer and closed classifier.

    A probe process holds devnull stdio plus an AF_INET socket, an AF_UNIX
    stream socket, an open regular file and a pipe end at descriptor 200.
    The complete enumeration must expose every descriptor including the high
    number; the blind classifier must flag the foreign-family socket, the
    unknown regular file and the unknown pipe as unaccounted, and the
    identity-informed pass must admit exactly the known identities while the
    foreign socket family stays unaccounted under every identity set.
    """
    detail: dict[str, Any] = {}
    try:
        os.fstat(200)
        return False, {"reason": "descriptor 200 unexpectedly open in gate"}
    except OSError:
        pass
    pipe_read = pipe_write = -1
    spec_fd = -1
    duped = False
    inet = unix_a = unix_b = None
    witness = probe = None
    try:
        pipe_read, pipe_write = os.pipe()
        os.dup2(pipe_read, 200)
        duped = True
        inet = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        unix_a, unix_b = socket.socketpair()
        spec_fd = os.open(SPEC, os.O_RDONLY | os.O_NOFOLLOW)
        pass_numbers = sorted({inet.fileno(), unix_a.fileno(), spec_fd, 200})
        expected_numbers = {0, 1, 2, *pass_numbers}
        witness = subprocess.Popen(
            ["/bin/sleep", "30"], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            close_fds=True, pass_fds=tuple(pass_numbers),
        )
        probe = subprocess.Popen(
            ["/bin/sleep", "30"], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            close_fds=True, pass_fds=tuple(pass_numbers),
        )

        def settled_table(pid: int) -> tuple[list[tuple[int, int]], bool, set[int]]:
            table: list[tuple[int, int]] = []
            bound = False
            numbers: set[int] = set()
            for _attempt in range(40):
                table, bound = process_open_fds(pid)
                numbers = {number for number, _kind in table}
                if bound and numbers == expected_numbers:
                    break
                time.sleep(0.05)
            return table, bound, numbers

        witness_table, witness_bound, witness_numbers = settled_table(witness.pid)
        witness_roles, witness_roles_bound = process_fd_roles(
            witness.pid, witness_table,
        )
        witness_pipe = next(
            (role for role in witness_roles if role.get("fd") == 200), {},
        )
        witness_pair = witness_pipe.get("dev_ino")
        witness_pipe_identity = tuple(witness_pair) \
            if isinstance(witness_pair, list) and len(witness_pair) == 2 else ()
        table, table_bound, numbers = settled_table(probe.pid)
        roles, roles_bound = process_fd_roles(probe.pid, table)
        blind, blind_unaccounted = classify_retained_fds(
            roles, passed_stdio_identities=set(),
            allowed_directory_identities=set(),
            allowed_regular_identities=set(),
        )
        spec_stat = os.fstat(spec_fd)
        informed, informed_unaccounted = classify_retained_fds(
            roles,
            passed_stdio_identities=(
                {witness_pipe_identity} if witness_pipe_identity else set()
            ),
            allowed_directory_identities=set(),
            allowed_regular_identities={(spec_stat.st_dev, spec_stat.st_ino)},
        )
        detail.update({
            "pass_numbers": pass_numbers,
            "witness_numbers": sorted(witness_numbers),
            "witness_pipe_identity": list(witness_pipe_identity),
            "table_numbers": sorted(numbers),
            "blind_classification": blind,
            "blind_unaccounted": blind_unaccounted,
            "informed_classification": informed,
            "informed_unaccounted": informed_unaccounted,
        })
        ok = (
            witness_bound and witness_roles_bound
            and witness_numbers == expected_numbers
            and bool(witness_pipe_identity)
            and table_bound and roles_bound
            and numbers == expected_numbers
            and 200 in numbers
            and blind_unaccounted == sorted({inet.fileno(), spec_fd, 200})
            and all(blind.get(str(number)) == "stdio_nonregular"
                    for number in (0, 1, 2))
            and blind.get(str(unix_a.fileno())) == "af_unix_stream_socket"
            and informed_unaccounted == [inet.fileno()]
            and informed.get("200") == "passed_stdio_pipe"
            and informed.get(str(spec_fd)) == "lane_known_regular"
            # Number-agnostic: legitimate descriptors are accounted at both low
            # (<10) and high (200) descriptor numbers; only the foreign AF_INET
            # is unaccounted.  Accounting never turns on the descriptor number.
            and min(int(number) for number in informed) < 10
            and max(int(number) for number in informed) == 200
        )
        return ok, detail
    finally:
        for child in (witness, probe):
            if child is not None:
                child.kill()
                child.wait(timeout=5)
        for closer in (inet, unix_a, unix_b):
            if closer is not None:
                closer.close()
        if spec_fd >= 0:
            os.close(spec_fd)
        if duped:
            os.close(200)
        for fd in (pipe_read, pipe_write):
            if fd >= 0:
                try:
                    os.close(fd)
                except OSError:
                    pass


def barrier_runtime_observation(
    before_roots: set[str], child_pid: int, *,
    occupied_launcher_fds: set[int] | None = None,
    require_10_29: bool = False,
    allowed_directory_identities: set[tuple[int, int]] | None = None,
    allowed_regular_identities: set[tuple[int, int]] | None = None,
) -> tuple[bool, dict[str, Any]]:
    """Bind the helper and supervisor to the sole live internal snapshot."""
    delta = runtime_roots() - before_roots
    detail: dict[str, Any] = {"runtime_delta": sorted(delta), "child_pid": child_pid}
    if len(delta) != 1:
        return False, detail
    root = Path(next(iter(delta)))
    helper_argv, helper_env_evidence, helper_argv_bound = \
        process_argv_environment(child_pid)
    helper_fd_table, helper_fds_bound = process_open_fds(child_pid)
    helper_fd_roles, helper_fd_roles_bound = process_fd_roles(
        child_pid, helper_fd_table,
    )
    helper_fd_numbers = {number for number, _kind in helper_fd_table}
    runtime_python = Path(helper_argv[0]) if helper_argv else Path("/nonexistent")
    snapshot_ok, snapshot = stable_runtime_python(runtime_python, root)
    runtime_canaries_ok, runtime_canaries = runtime_canaries_unchanged(root)
    detail.update({
        "runtime_root": str(root),
        "runtime_root_identity": snapshot.get("root_dev_ino"),
        "runtime_python": snapshot,
        "runtime_proof_canaries": runtime_canaries,
        "helper_argv": helper_argv,
        "helper_environment_evidence": helper_env_evidence,
        "helper_complete_fd_table": helper_fd_table,
        "helper_fd_roles": helper_fd_roles,
    })
    helper_exact = (
        helper_argv_bound
        and helper_env_evidence.get("exact_exec_environment_credit") is False
        and len(helper_argv) == 8
        and helper_argv[:7] == [
            str(runtime_python), "-I", "-S", "-B", str(HELPER),
            "confined-exec-v1", "--proof-fd",
        ]
        and valid_decimal_fd(helper_argv[7])
    )
    proof_fd = int(helper_argv[7]) if helper_exact else -1
    helper_role_by_fd = {
        role.get("fd"): role for role in helper_fd_roles
        if type(role.get("fd")) is int
    }
    stdio_roles = [helper_role_by_fd.get(number, {}) for number in (0, 1, 2)]
    proof_role = helper_role_by_fd.get(proof_fd, {})
    helper_fd_exact = (
        helper_exact and helper_fds_bound and helper_fd_roles_bound
        and helper_fd_numbers == {0, 1, 2, proof_fd}
        and [role.get("type") for role in stdio_roles] == [6, 6, 6]
        and [role.get("access_mode") for role in stdio_roles]
            == [os.O_RDONLY, os.O_WRONLY, os.O_WRONLY]
        and all(stat.S_ISFIFO(int(role.get("mode", 0))) for role in stdio_roles)
        and proof_role.get("type") == 2
        and proof_role.get("access_mode") == os.O_RDWR
        and proof_role.get("socket_type") == socket.SOCK_STREAM
        and proof_role.get("socket_family") == socket.AF_UNIX
        and proof_role.get("socket_handle") not in {None, 0}
        and len({tuple(role.get("dev_ino", []))
                 for role in [*stdio_roles, proof_role]}) == 4
    )
    supervisor_candidates: list[dict[str, Any]] = []
    for record in process_table_snapshot():
        pid = record.get("pid")
        if type(pid) is not int or pid == child_pid or record.get("euid") != os.geteuid():
            continue
        command = str(record.get("command", ""))
        if str(HELPER) not in command or " supervise-v1 " not in f" {command} ":
            continue
        argv, environment, parsed = process_argv_environment(pid)
        if len(argv) >= 6 and argv[4:6] == [str(HELPER), "supervise-v1"]:
            supervisor_candidates.append({
                "record": record, "argv": argv,
                "environment_evidence": environment, "kernel_argv_bound": parsed,
            })
    supervisor_exact = False
    supervisor_fd_exact = False
    high_fd_exercised = not require_10_29
    if len(supervisor_candidates) == 1:
        candidate = supervisor_candidates[0]
        supervisor_argv = candidate["argv"]
        supervisor_exact = (
            candidate["kernel_argv_bound"] is True
            and candidate["environment_evidence"].get(
                "exact_exec_environment_credit"
            ) is False
            and len(supervisor_argv) == 10
            and supervisor_argv[:7] == [
                str(runtime_python), "-I", "-S", "-B", str(HELPER),
                "supervise-v1", "--control-fd",
            ]
            and supervisor_argv[8] == "--ready-fd"
            and valid_decimal_fd(supervisor_argv[7])
            and valid_decimal_fd(supervisor_argv[9])
            and supervisor_argv[7] != supervisor_argv[9]
        )
        supervisor_pid = candidate["record"]["pid"]
        supervisor_fd_table, supervisor_fds_bound = process_open_fds(supervisor_pid)
        supervisor_fd_roles, supervisor_fd_roles_bound = process_fd_roles(
            supervisor_pid, supervisor_fd_table,
        )
        supervisor_fd_numbers = {number for number, _kind in supervisor_fd_table}
        # The caller-occupied launcher fds are informational only: leak detection
        # is by descriptor identity/type through the complete classifier, never by
        # descriptor number.  A supervisor that legitimately reopens its listener,
        # connection and helper descriptors reuses low numbers 3-14 by POSIX
        # lowest-available allocation; an actually leaked caller filler is a
        # /dev/null character device (non-entropy) at fd>=3 and is already
        # unaccounted.  Number disjointness would false-fail a sound supervisor.
        occupied = occupied_launcher_fds or set()
        control_fd = int(supervisor_argv[7]) if valid_decimal_fd(supervisor_argv[7]) else -1
        ready_fd = int(supervisor_argv[9]) if valid_decimal_fd(supervisor_argv[9]) else -1
        allowed_directories = set(allowed_directory_identities or set())
        root_identity = snapshot.get("root_dev_ino")
        if isinstance(root_identity, list) and len(root_identity) == 2:
            allowed_directories.add(tuple(root_identity))
        allowed_regular = set(allowed_regular_identities or set())
        allowed_regular |= path_identities([runtime_python, HELPER, CLI, CONFIG])
        supervisor_role_by_fd = {
            role.get("fd"): role for role in supervisor_fd_roles
            if type(role.get("fd")) is int
        }
        control_role = supervisor_role_by_fd.get(control_fd, {})
        helper_stdio_identities = {
            tuple(role.get("dev_ino"))
            for role in stdio_roles
            if isinstance(role.get("dev_ino"), list)
            and len(role.get("dev_ino")) == 2
        }
        fd_classification, unaccounted_fds = classify_retained_fds(
            supervisor_fd_roles,
            passed_stdio_identities=helper_stdio_identities,
            allowed_directory_identities=allowed_directories,
            allowed_regular_identities=allowed_regular,
        )
        supervisor_fd_exact = (
            supervisor_exact and supervisor_fds_bound
            and supervisor_fd_roles_bound
            and len(supervisor_fd_roles) == len(supervisor_fd_numbers)
            and {0, 1, 2, control_fd} <= supervisor_fd_numbers
            and control_role.get("type") == 2
            and control_role.get("socket_family") == socket.AF_UNIX
            and control_role.get("socket_type") == socket.SOCK_STREAM
            and control_role.get("socket_handle") not in {None, 0}
            and ready_fd not in supervisor_fd_numbers
            and not unaccounted_fds
        )
        candidate["fd_classification"] = fd_classification
        candidate["unaccounted_fds"] = unaccounted_fds
        live_internal_fds = {
            control_fd,
            *(number for number in helper_fd_numbers if number >= 3),
        }
        high_fd_exercised = any(10 <= number <= 29 for number in live_internal_fds)
        candidate["complete_fd_table"] = supervisor_fd_table
        candidate["complete_fd_roles"] = supervisor_fd_roles
        candidate["caller_occupied_launcher_fds"] = sorted(occupied)
    direct_entries: list[tuple[Path, os.stat_result]] = []
    try:
        for entry in root.iterdir():
            direct_entries.append((entry, entry.lstat()))
    except OSError:
        direct_entries = []
    sockets = [
        (entry, opened) for entry, opened in direct_entries
        if stat.S_ISSOCK(opened.st_mode)
    ]
    socket_exact = (
        len(sockets) == 1 and sockets[0][0].parent == root
        and not sockets[0][0].is_symlink()
        and (sockets[0][1].st_mode & 0o777) == 0o600
    )
    if sockets:
        detail["socket"] = {
            "path": str(sockets[0][0]),
            "dev_ino": [sockets[0][1].st_dev, sockets[0][1].st_ino],
            "mode": oct(sockets[0][1].st_mode & 0o777),
        }
    detail["supervisor_candidates"] = supervisor_candidates
    detail["checks"] = {
        "sole_runtime_root": len(delta) == 1,
        "stable_internal_python": snapshot_ok,
        "runtime_canaries_readback": runtime_canaries_ok,
        "exact_helper_kernel_tokens_environment_review_only": helper_exact,
        "complete_helper_fd_namespace": helper_fd_exact,
        "exact_supervisor_kernel_tokens_environment_review_only": supervisor_exact,
        "complete_supervisor_fd_accounting_fail_closed": supervisor_fd_exact,
        "live_internal_decimal_fd_10_29_exercised": high_fd_exercised,
        "exact_socket": socket_exact,
    }
    return (
        snapshot_ok and runtime_canaries_ok and helper_exact and helper_fd_exact
        and supervisor_exact and supervisor_fd_exact and high_fd_exercised
        and socket_exact
    ), detail


def repo_pycache_state() -> dict[str, tuple[int, int, str]]:
    result: dict[str, tuple[int, int, str]] = {}
    for path in ROOT.rglob("*"):
        try:
            if path.name == "__pycache__" or path.suffix in {".pyc", ".pyo"}:
                opened = path.lstat()
                digest = path_sha(path) if stat.S_ISREG(opened.st_mode) else ""
                result[str(path.relative_to(ROOT))] = (opened.st_mode, opened.st_size, digest)
        except OSError:
            continue
    return result


def _same_dev_ino(left: os.stat_result, right: os.stat_result) -> bool:
    return (left.st_dev, left.st_ino) == (right.st_dev, right.st_ino)


def _stable_parent_fd(path: Path) -> tuple[int, str]:
    if not path.is_absolute() or path.name in {"", ".", ".."}:
        raise Rig(f"unsafe cleanup path {path!s}")
    parent_before = path.parent.lstat()
    if not stat.S_ISDIR(parent_before.st_mode) or stat.S_ISLNK(parent_before.st_mode):
        raise Rig(f"cleanup parent is not a nofollow directory: {path.parent!s}")
    parent_fd = os.open(
        path.parent,
        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
    )
    parent_opened = os.fstat(parent_fd)
    parent_after = path.parent.lstat()
    if not (_same_dev_ino(parent_before, parent_opened)
            and _same_dev_ino(parent_opened, parent_after)):
        os.close(parent_fd)
        raise Rig(f"cleanup parent identity changed: {path.parent!s}")
    return parent_fd, path.name


def _open_cleanup_directory(
    parent_fd: int, name: str, expected: os.stat_result,
) -> int:
    flags = (
        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        | getattr(os, "O_CLOEXEC", 0)
    )
    try:
        child_fd = os.open(name, flags, dir_fd=parent_fd)
    except PermissionError:
        # No pathname chmod and never a symlink: fchmodat is anchored to the
        # already-open parent, then the exact dev/ino must still match before
        # the directory is opened and changed through its own descriptor.
        os.chmod(name, 0o700, dir_fd=parent_fd, follow_symlinks=False)
        after_chmod = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        if not _same_dev_ino(expected, after_chmod) \
                or not stat.S_ISDIR(after_chmod.st_mode):
            raise Rig(f"cleanup directory changed during nofollow chmod: {name}")
        child_fd = os.open(name, flags, dir_fd=parent_fd)
    opened = os.fstat(child_fd)
    current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if not stat.S_ISDIR(opened.st_mode) \
            or not _same_dev_ino(expected, opened) \
            or not _same_dev_ino(opened, current):
        os.close(child_fd)
        raise Rig(f"cleanup directory identity changed: {name}")
    os.fchmod(child_fd, 0o700)
    return child_fd


def _purge_cleanup_directory(directory_fd: int) -> None:
    for name in os.listdir(directory_fd):
        if name in {"", ".", ".."} or "/" in name or "\0" in name:
            raise Rig("invalid cleanup directory entry")
        before = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if stat.S_ISDIR(before.st_mode):
            child_fd = _open_cleanup_directory(directory_fd, name, before)
            try:
                _purge_cleanup_directory(child_fd)
            finally:
                os.close(child_fd)
            current = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            if not _same_dev_ino(before, current) or not stat.S_ISDIR(current.st_mode):
                raise Rig(f"cleanup child directory replaced: {name}")
            os.rmdir(name, dir_fd=directory_fd)
        else:
            # unlinkat removes a symlink entry; it can never chmod, open or
            # mutate the referent.  Regular files also require no mode change.
            os.unlink(name, dir_fd=directory_fd)


def safe_remove_tree(path: Path) -> None:
    """Remove one exact root without following/chmodding a hostile symlink."""
    parent_fd, leaf = _stable_parent_fd(path)
    try:
        try:
            root_before = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            return
        if not stat.S_ISDIR(root_before.st_mode):
            os.unlink(leaf, dir_fd=parent_fd)
            return
        root_fd = _open_cleanup_directory(parent_fd, leaf, root_before)
        try:
            _purge_cleanup_directory(root_fd)
        finally:
            os.close(root_fd)
        root_after = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
        if not _same_dev_ino(root_before, root_after) \
                or not stat.S_ISDIR(root_after.st_mode):
            raise Rig(f"cleanup root identity changed: {path!s}")
        os.rmdir(leaf, dir_fd=parent_fd)
    finally:
        os.close(parent_fd)


def nofollow_file_snapshot(path: Path) -> tuple[bytes, int, tuple[int, int], int]:
    before = path.lstat()
    fd = os.open(
        path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        opened = os.fstat(fd)
        chunks: list[bytes] = []
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
        after = path.lstat()
        if not stat.S_ISREG(opened.st_mode) \
                or not _same_dev_ino(before, opened) \
                or not _same_dev_ino(opened, after):
            raise Rig(f"nofollow file identity changed: {path!s}")
        return (
            b"".join(chunks), opened.st_mode & 0o777,
            (opened.st_dev, opened.st_ino), opened.st_nlink,
        )
    finally:
        os.close(fd)


def create_nofollow_file(path: Path, raw: bytes, mode: int) -> tuple[int, int]:
    parent_fd, leaf = _stable_parent_fd(path)
    fd = -1
    try:
        try:
            os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise Rig(f"nofollow canary path preexists: {path!s}")
        fd = os.open(
            leaf,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
            | getattr(os, "O_CLOEXEC", 0),
            mode, dir_fd=parent_fd,
        )
        os.fchmod(fd, mode)
        view = memoryview(raw)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                raise Rig(f"short nofollow canary write: {path!s}")
            view = view[written:]
        os.fsync(fd)
        opened = os.fstat(fd)
        current = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
        if not stat.S_ISREG(opened.st_mode) or not _same_dev_ino(opened, current):
            raise Rig(f"nofollow canary identity changed: {path!s}")
        return opened.st_dev, opened.st_ino
    finally:
        if fd >= 0:
            os.close(fd)
        os.close(parent_fd)


def safe_remove_empty_directory(path: Path, expected_dev_ino: tuple[int, int]) -> None:
    parent_fd, leaf = _stable_parent_fd(path)
    try:
        opened = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
        if not stat.S_ISDIR(opened.st_mode) \
                or (opened.st_dev, opened.st_ino) != expected_dev_ino:
            raise Rig(f"empty cleanup directory identity mismatch: {path!s}")
        directory_fd = _open_cleanup_directory(parent_fd, leaf, opened)
        try:
            if os.listdir(directory_fd):
                raise Rig(f"refusing to remove nonempty shared directory: {path!s}")
        finally:
            os.close(directory_fd)
        current = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
        if not _same_dev_ino(opened, current):
            raise Rig(f"empty cleanup directory replaced: {path!s}")
        os.rmdir(leaf, dir_fd=parent_fd)
    finally:
        os.close(parent_fd)


def cleanup_nofollow_selftests() -> tuple[bool, dict[str, Any]]:
    """Falsify root, child and config-leaf symlink cleanup escapes."""
    fixture = Path(tempfile.mkdtemp(prefix="h036-cleanup-fixture-", dir="/private/tmp"))
    external = Path(tempfile.mkdtemp(prefix="h036-cleanup-external-", dir="/private/tmp"))
    detail: dict[str, Any] = {}
    try:
        external_file = external / "outside"
        external_file.write_bytes(b"OUTSIDE-UNCHANGED")
        external_file.chmod(0o400)
        external_dir = external / "outside-dir"
        external_dir.mkdir(mode=0o700)
        external_dir_file = external_dir / "canary"
        external_dir_file.write_bytes(b"DIRECTORY-UNCHANGED")
        external_dir.chmod(0o500)
        file_before = external_file.lstat()
        dir_before = external_dir.lstat()

        root_link = fixture / "hostile-root"
        root_link.symlink_to(external_dir, target_is_directory=True)
        safe_remove_tree(root_link)

        hostile_child_root = fixture / "hostile-child-root"
        hostile_child_root.mkdir()
        (hostile_child_root / "child-link").symlink_to(
            external_dir, target_is_directory=True,
        )
        safe_remove_tree(hostile_child_root)

        config_link = fixture / "config.worktree"
        config_link.symlink_to(external_file)
        safe_remove_tree(config_link)

        locked = fixture / "locked"
        locked.mkdir()
        (locked / "leaf").write_bytes(b"LOCKED")
        locked.chmod(0o000)
        safe_remove_tree(locked)

        file_after = external_file.lstat()
        dir_after = external_dir.lstat()
        ok = (
            not root_link.exists() and not root_link.is_symlink()
            and not hostile_child_root.exists()
            and not config_link.exists() and not config_link.is_symlink()
            and not locked.exists()
            and external_file.read_bytes() == b"OUTSIDE-UNCHANGED"
            and external_dir_file.read_bytes() == b"DIRECTORY-UNCHANGED"
            and _same_dev_ino(file_before, file_after)
            and _same_dev_ino(dir_before, dir_after)
            and (file_after.st_mode & 0o777) == 0o400
            and (dir_after.st_mode & 0o777) == 0o500
        )
        detail = {
            "hostile_root_symlink_removed_without_follow": not root_link.is_symlink(),
            "hostile_child_symlink_removed_without_follow": not hostile_child_root.exists(),
            "hostile_config_symlink_removed_without_follow": not config_link.is_symlink(),
            "locked_directory_removed_by_nofollow_dirfd": not locked.exists(),
            "external_file_dev_ino": [file_after.st_dev, file_after.st_ino],
            "external_file_mode": oct(file_after.st_mode & 0o777),
            "external_directory_dev_ino": [dir_after.st_dev, dir_after.st_ino],
            "external_directory_mode": oct(dir_after.st_mode & 0o777),
            "external_bytes_unchanged": True,
        }
        return ok, detail
    except (OSError, Rig) as exc:
        return False, {**detail, "error": str(exc)}
    finally:
        safe_remove_tree(fixture)
        # Verification is complete before the external fixture is deliberately
        # removed through the same nofollow cleanup primitive.
        safe_remove_tree(external)


def git_cleanup_harness_selftest() -> tuple[bool, dict[str, Any]]:
    """Exercise exact worktree/admin/config/object-fanout cleanup primitives."""
    root = Path(tempfile.mkdtemp(prefix="h036-git-cleanup-", dir="/private/tmp"))
    worktree = root / "worktree"
    admin: Path | None = None
    before_list = git("worktree", "list", "--porcelain", "-z")
    before_refs = git("for-each-ref", "--format=%(refname)%00%(objectname)")
    common = Path(str(git(
        "rev-parse", "--path-format=absolute", "--git-common-dir", text=True,
    )).strip()).resolve(strict=True)
    worktrees_admin = common / "worktrees"

    def admin_entries() -> list[tuple[str, int, int]]:
        try:
            return sorted(
                (entry.name, entry.lstat().st_dev, entry.lstat().st_ino)
                for entry in worktrees_admin.iterdir()
            )
        except FileNotFoundError:
            return []

    before_admin = admin_entries()
    detail: dict[str, Any] = {}
    ok = False
    try:
        git("worktree", "add", "--detach", str(worktree), PUBLISHED_H034_SHA)
        dotgit_raw, _mode, _identity, _nlink = nofollow_file_snapshot(worktree / ".git")
        prefix = b"gitdir: "
        if not dotgit_raw.startswith(prefix):
            raise Rig("cleanup selftest worktree gitfile shape")
        admin = Path(dotgit_raw[len(prefix):].strip().decode("utf-8", "strict"))
        admin = admin.resolve(strict=True)
        if admin.parent != worktrees_admin or admin.is_symlink():
            raise Rig("cleanup selftest admin root authority")

        external = root / "external"
        external.write_bytes(b"GIT-EXTERNAL-UNCHANGED")
        external.chmod(0o400)
        external_before = external.lstat()
        config = admin / "config.worktree"
        config_identity = create_nofollow_file(config, b"CONFIG-CANARY\n", 0o600)
        if nofollow_file_snapshot(config)[2] != config_identity:
            raise Rig("cleanup selftest config identity")
        safe_remove_tree(config)
        config.symlink_to(external)
        safe_remove_tree(config)
        external_after = external.lstat()

        fake_objects = root / "objects"
        fake_objects.mkdir()
        fanout = fake_objects / "ab"
        fanout.mkdir()
        fanout_stat = fanout.lstat()
        fake_object = fanout / ("c" * 38)
        fake_object.write_bytes(b"FAKE-LOOSE-OBJECT")
        safe_remove_tree(fake_object)
        safe_remove_empty_directory(
            fanout, (fanout_stat.st_dev, fanout_stat.st_ino),
        )

        safe_remove_tree(worktree)
        safe_remove_tree(admin)
        admin = None
        ok = (
            external.read_bytes() == b"GIT-EXTERNAL-UNCHANGED"
            and _same_dev_ino(external_before, external_after)
            and (external_after.st_mode & 0o777) == 0o400
            and not worktree.exists()
            and not fanout.exists()
            and git("worktree", "list", "--porcelain", "-z") == before_list
            and git("for-each-ref", "--format=%(refname)%00%(objectname)")
                == before_refs
            and admin_entries() == before_admin
        )
        detail = {
            "exact_worktree_root_removed": not worktree.exists(),
            "exact_admin_root_removed": admin_entries() == before_admin,
            "config_symlink_external_unchanged": (
                external.read_bytes() == b"GIT-EXTERNAL-UNCHANGED"
                and _same_dev_ino(external_before, external_after)
                and (external_after.st_mode & 0o777) == 0o400
            ),
            "object_fanout_exact_empty_cleanup": not fanout.exists(),
            "worktree_list_restored": git(
                "worktree", "list", "--porcelain", "-z",
            ) == before_list,
            "refs_unchanged": git(
                "for-each-ref", "--format=%(refname)%00%(objectname)",
            ) == before_refs,
        }
    except (OSError, UnicodeError, Rig, subprocess.SubprocessError) as exc:
        detail = {**detail, "error": str(exc)}
    finally:
        if worktree.exists() or worktree.is_symlink():
            safe_remove_tree(worktree)
        if admin is not None:
            try:
                safe_remove_tree(admin)
            except (OSError, Rig):
                pass
        safe_remove_tree(root)
    return ok, detail


