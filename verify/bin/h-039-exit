    changes: list[tuple[str, str, str, str]],
) -> bool:
    return changes == [
        (path, PRODUCT_MODES[path], PRODUCT_MODES[path], "M")
        for path in R19_PRODUCT_GIT_ORDER
    ]


def exact_r8_product_change_shape(
    changes: list[tuple[str, str, str, str]],
) -> bool:
    return changes == [
        (path, PRODUCT_MODES[path], PRODUCT_MODES[path], "M")
        for path in R8_PRODUCT_GIT_ORDER
    ]


def stable_checkout_blob(path: str, expected: bytes) -> bool:
    target = ROOT / path
    descriptor = -1
    try:
        descriptor = os.open(
            target,
            os.O_RDONLY | os.O_CLOEXEC
            | getattr(os, "O_NOFOLLOW_ANY") | 0x00002000,
        )
        before = os.fstat(descriptor)
        expected_mode = 0o755 if path == "verify/bin/h-039-exit" else 0o644
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 \
                or stat.S_IMODE(before.st_mode) != expected_mode \
                or before.st_size > 4194304:
            return False
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                return False
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            return False
        after = os.fstat(descriptor)
        named = os.lstat(target)
        identity = lambda value: (
            value.st_dev, value.st_ino, value.st_mode, value.st_uid,
            value.st_gid, value.st_nlink, value.st_size,
            value.st_mtime_ns, value.st_ctime_ns,
        )
        return (
            identity(before) == identity(after) == identity(named)
            and b"".join(chunks) == expected
        )
    except OSError:
        return False
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def stable_product_checkout_blob(path: str, expected: bytes) -> bool:
    target = ROOT / path
    descriptor = -1
    try:
        descriptor = os.open(
            target,
            os.O_RDONLY | os.O_CLOEXEC
            | getattr(os, "O_NOFOLLOW_ANY") | 0x00002000,
        )
        before = os.fstat(descriptor)
        expected_mode = int(PRODUCT_MODES[path], 8) & 0o777
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 \
                or stat.S_IMODE(before.st_mode) != expected_mode \
                or before.st_size > PRODUCT_BYTE_LIMITS[path]:
            return False
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                return False
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            return False
        after = os.fstat(descriptor)
        named = os.lstat(target)
        identity = lambda value: (
            value.st_dev, value.st_ino, value.st_mode, value.st_uid,
            value.st_gid, value.st_nlink, value.st_size,
            value.st_mtime_ns, value.st_ctime_ns,
        )
        return (
            identity(before) == identity(after) == identity(named)
            and b"".join(chunks) == expected
        )
    except (KeyError, OSError):
        return False
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def r22_product_checkout_mode_selftests() -> None:
    global ROOT
    temporary = Path(tempfile.mkdtemp(prefix="h039-r22-mode-", dir="/private/tmp"))
    saved_root = ROOT
    saved_lstat = os.lstat
    try:
        check(
            source_function_bytes(
                GATE.read_bytes(), ["stable_product_checkout_blob"],
            ) == source_function_bytes(
                blob(R22_AUTHORITY_BASE, "verify/bin/h-039-exit"),
                ["stable_product_checkout_blob"],
            ),
            "A_H039_R22_STABLE_PRODUCT_CHECKOUT_HELPER_BYTE_EXACT_INHERITED",
        )
        ROOT = temporary
        fixtures: dict[str, bytes] = {}
        for index, path in enumerate(R22_PRODUCT_PATHS):
            target = ROOT / path
            expected = f"R22_PRODUCT_MODE_FIXTURE_{index}".encode()
            fixtures[path] = expected
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(expected)
            expected_mode = int(PRODUCT_MODES[path], 8) & 0o777
            os.chmod(target, expected_mode)
            check(
                stable_product_checkout_blob(path, expected),
                f"A_H039_R22_PRODUCT_CHECKOUT_MODE_{expected_mode:04o}_{index}",
            )
            wrong_mode = 0o644 if expected_mode == 0o755 else 0o755
            os.chmod(target, wrong_mode)
            check(
                not stable_product_checkout_blob(path, expected),
                f"N_H039_R22_PRODUCT_CHECKOUT_WRONG_MODE_{wrong_mode:04o}_{index}",
            )
            os.chmod(target, expected_mode)

        executable_path = R22_PRODUCT_PATHS[0]
        executable = ROOT / executable_path
        expected = fixtures[executable_path]
        executable.write_bytes(b"R22_EXECUTABLE_CONTENT_SUBSTITUTION")
        os.chmod(executable, 0o755)
        check(
            not stable_product_checkout_blob(executable_path, expected),
            "N_H039_R22_PRODUCT_CHECKOUT_EXECUTABLE_CONTENT_SUBSTITUTION_REJECTED",
        )
        executable.write_bytes(expected)
        os.chmod(executable, 0o755)
        executable.unlink()
        symlink_target = ROOT / "same-byte-executable"
        symlink_target.write_bytes(expected)
        os.chmod(symlink_target, 0o755)
        executable.symlink_to(symlink_target)
        check(
            not stable_product_checkout_blob(executable_path, expected),
            "N_H039_R22_PRODUCT_CHECKOUT_SAME_BYTE_0755_SYMLINK_REJECTED",
        )
        executable.unlink()
        executable.write_bytes(expected)
        os.chmod(executable, 0o755)
        replacement = ROOT / "same-byte-executable-replacement"
        replacement.write_bytes(expected)
        os.chmod(replacement, 0o755)
        replaced = False

        def rebind_lstat(path: Any, *args: Any, **kwargs: Any):
            nonlocal replaced
            if not replaced and Path(path) == executable:
                replaced = True
                os.replace(replacement, executable)
            return saved_lstat(path, *args, **kwargs)

        os.lstat = rebind_lstat
        check(
            not stable_product_checkout_blob(executable_path, expected)
            and replaced,
            "N_H039_R22_PRODUCT_CHECKOUT_SAME_BYTE_MODE_DISTINCT_INODE_REBIND_REJECTED",
        )
    finally:
        os.lstat = saved_lstat
        ROOT = saved_root
        shutil.rmtree(temporary)


def r17_contract_candidate_graph(candidate: str) -> tuple[bool, dict[str, Any]]:
    try:
        changes = raw_changes(R17_AUTHORITY_BASE, candidate)
        additions, deletions = line_delta(R17_AUTHORITY_BASE, candidate)
        detail = {
            "authority_tree": commit_tree(R17_AUTHORITY_BASE),
            "authority_parents": commit_parents(R17_AUTHORITY_BASE),
            "candidate": candidate,
            "candidate_parents": commit_parents(candidate),
            "changes": changes,
            "additions": additions,
            "deletions": deletions,
        }
        ok = (
            object_type(R17_AUTHORITY_BASE) == "commit"
            and detail["authority_tree"] == R17_AUTHORITY_TREE
            and detail["authority_parents"] == R17_AUTHORITY_PARENTS
            and object_type(candidate) == "commit"
            and candidate not in {
                R17_AUTHORITY_BASE, CONTRACT_AUTHORITY_BASE,
                PUBLISHED_H039_R8_CONTRACT_MERGE,
                PUBLISHED_H039_R8_PRODUCT_CANDIDATE,
                PUBLISHED_H039_R8_PRODUCT_MERGE,
                PUBLISHED_H039_R9_PRODUCT_CANDIDATE,
            }
            and detail["candidate_parents"] == [R17_AUTHORITY_BASE]
            and exact_contract_change_shape(changes)
            and type(additions) is int and additions <= MAX_ADDED_LINES
            and type(deletions) is int and deletions <= MAX_DELETED_LINES
        )
        return ok, detail
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "candidate": candidate}


def r17_contract_candidate_identity(candidate: str) -> tuple[bool, dict[str, Any]]:
    graph_ok, graph = r17_contract_candidate_graph(candidate)
    try:
        remote_main = observed_production_main()
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        checkout_equal = all(
            stable_checkout_blob(path, blob(candidate, path))
            for path in TEST_AUTHOR_GIT_ORDER
        )
        ok = (
            graph_ok and remote_main == R17_AUTHORITY_BASE
            and head == candidate and status_raw == b"" and checkout_equal
        )
        return ok, {
            "graph": graph, "remote_main": remote_main, "head": head,
            "status": status_raw.decode("utf-8", "replace"),
            "checkout_equal": checkout_equal,
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "graph": graph}


def r17_contract_publication_graph(merge: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(merge)
        if len(parents) != 2:
            return False, {"parents": parents}
        authority, candidate = parents
        graph_ok, graph = r17_contract_candidate_graph(candidate)
        merge_changes = raw_changes(R17_AUTHORITY_BASE, merge)
        merge_tree = commit_tree(merge)
        candidate_tree = commit_tree(candidate)
        ok = (
            object_type(merge) == "commit" and authority == R17_AUTHORITY_BASE
            and graph_ok and merge_tree == candidate_tree
            and exact_contract_change_shape(merge_changes)
        )
        return ok, {
            "parents": parents, "graph": graph, "merge_changes": merge_changes,
            "merge_tree": merge_tree, "candidate_tree": candidate_tree,
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "merge": merge}


def r17_contract_publication_identity(merge: str) -> tuple[bool, dict[str, Any]]:
    graph_ok, graph = r17_contract_publication_graph(merge)
    try:
        remote_main = observed_production_main()
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        checkout_equal = all(
            stable_checkout_blob(path, blob(merge, path))
            for path in TEST_AUTHOR_GIT_ORDER
        )
        ok = (
            graph_ok and remote_main == merge and head == merge
            and status_raw == b"" and checkout_equal
        )
        return ok, {
            "graph": graph, "remote_main": remote_main, "head": head,
            "status": status_raw.decode("utf-8", "replace"),
            "checkout_equal": checkout_equal,
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "graph": graph}


