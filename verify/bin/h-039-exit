def r23_run_confined_harness(harness: bytes, stem: str, expected: bytes) -> None:
    if path_sha(SANDBOX_EXEC) != SANDBOX_EXEC_SHA256 \
            or path_sha(BUILD_COMPILER) != BUILD_COMPILER_SHA256 \
            or path_sha(BUILD_SDK / "SDKSettings.json") \
            != BUILD_SDK_SETTINGS_SHA256:
        raise Undecidable("R23 pinned confined harness tool identity drift")
    temporary = Path(tempfile.mkdtemp(prefix=f"h039-r23-{stem}-", dir="/private/tmp"))
    try:
        source_path, executable = temporary / f"{stem}.c", temporary / stem
        source_path.write_bytes(harness)
        environment = {"HOME": "/var/empty", "TMPDIR": str(temporary),
                       "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"}
        build = bounded_run([
            str(SANDBOX_EXEC), "-D", f"H039_BUILD_EXECUTABLE={BUILD_COMPILER}",
            "-D", f"H039_BUILD_ROOT={temporary}", "-p", BUILD_REVIEW_PROFILE,
            str(BUILD_COMPILER), "-std=c11", "-O0", "-Wall", "-Wextra",
            "-Werror", "-Wno-unused-parameter", "-arch", "arm64", "-isysroot",
            str(BUILD_SDK), "-mmacosx-version-min=15.0", str(source_path), "-o",
            str(executable)], cwd=temporary, env=environment, timeout=30)
        if build.returncode == 71 and b"sandbox_apply: Operation not permitted" in build.stderr:
            raise Undecidable(f"outer Seatbelt denied R23 {stem} build")
        if build.returncode or build.stdout or build.stderr:
            raise Rig(f"R23 {stem} build failed rc={build.returncode} stdout={build.stdout!r} stderr={build.stderr!r}")
        run = bounded_run([
            str(SANDBOX_EXEC), "-D", f"H039_EXECUTABLE={executable}", "-D",
            f"H039_MEDIATOR={executable}", "-D", f"H039_TEST_ROOT={temporary}",
            "-p", INSTALLER_REVIEW_PROFILE, str(executable)], cwd="/",
            env=environment, timeout=10)
        if run.returncode == 71 and b"sandbox_apply: Operation not permitted" in run.stderr:
            raise Undecidable(f"outer Seatbelt denied R23 {stem} execution")
        if run.returncode or run.stderr or run.stdout != expected:
            raise Rig(f"R23 {stem} rejected rc={run.returncode} stdout={run.stdout!r} stderr={run.stderr!r}")
    finally:
        shutil.rmtree(temporary)


def r23_compiled_scan2_harness() -> None:
    exact = r23_exact_c_function(r23_expected_production_source(), "close_inherited")
    harness = R23_SCAN2_HARNESS_HEAD + exact + R23_SCAN2_HARNESS_TAIL
    r23_run_confined_harness(harness, "scan2", b"R23_COMPILED_SCAN2_HARNESS=PASS\n")
    check(True, "A_H039_R23_EXACT_COMPILED_POPULATED_SCAN2_CAUSAL_HARNESS",
          {"exact_function_sha256": sha(exact), "harness_sha256": sha(harness)})


def r23_connected_updater_harness() -> None:
    expected = r23_expected_production_source()
    support = b"\n".join(
        r23_exact_c_function(expected, name)
        for name in (
            "same_stat", "write_all", "pread_all", "stable_read_fd",
            "stable_named_fd", "fixed_dir_at", "flush_dir",
            "durable_fixed_dir_at", "exact_regular_bytes",
            "same_rename_identity", "stage_embedded_mediator",
            "remove_fixed_staging",
        )
    )
    extracted = R23_UPDATER_HELPERS
    if expected.count(extracted) != 1 \
            or r23_exact_c_function(expected, "upgrade_installed_mediator") \
            not in extracted:
        raise Rig("R23 exact updater helper closure extraction drift")
    harness = (
        R23_CONNECTED_CLOSURE_HARNESS_HEAD + support + b"\n" + extracted
        + R23_CONNECTED_CLOSURE_HARNESS_TAIL
    )
    r23_run_confined_harness(
        harness, "updater", b"R23_CONNECTED_UPDATER_CLOSURE_HARNESS=PASS\n",
    )
    check(
        True,
        "A_H039_R23_EXACT_UPDATER_HELPER_CLOSURE_CONNECTED_O0_O3_N0_N4_"
        "SYSCALL_HARNESS",
        {"source_sha256": sha(extracted), "harness_sha256": sha(harness)},
    )


def r23_source_contract_checks(raw: bytes) -> None:
    expected = r23_expected_production_source()
    if raw != expected:
        raise Rig(
            "R23 source is not the exact whole published-R13 plus scan2, "
            "compile-guard, fixed-updater and fixed-dispatch transform"
        )
    marker = b"\n#ifdef H039_INSTALLER\n#define Q1(x) #x"
    if raw.count(marker) != 1:
        raise Rig("R23 installer boundary absent or duplicated")
    prefix, installer_tail = raw.split(marker, 1)
    expected_prefix = r23_expected_runtime_prefix()
    if prefix + marker != expected_prefix:
        raise Rig("R23 changed production runtime outside exact populated scan2")
    if prefix.count(R22_DIAGNOSTIC_BRANCH) != 1:
        raise Rig("R23 historical R22 diagnostic branch changed or duplicated")
    close_body = c_function_body(c_semantic_source(prefix.decode("utf-8")), "close_inherited")
    if (
        close_body.count("proc_pidinfo(getpid(),PROC_PIDLISTFDS,0,NULL,0)") != 1
        or close_body.count("struct proc_fdinfo final_list[17]") != 1
        or close_body.count(
            "proc_pidinfo(getpid(),PROC_PIDLISTFDS,0,final_list,(int)sizeof final_list)"
        ) != 1
        or close_body.count(
            "return got==(int)sizeof *final_list&&final_list[0].proc_fd==0;"
        ) != 1
        or "errno" in close_body
    ):
        raise Rig("R23 populated FD scan2 exact source contract mismatch")
    full = c_semantic_source(raw.decode("utf-8"))
    update_body = c_function_body(full, "upgrade_installed_mediator")
    directory_shape = c_function_body(full, "upgrade_directory_shape")
    guard_shape = c_function_body(full, "upgrade_guard_shape")
    if any(token not in directory_shape for token in (
        "S_ISDIR(s->st_mode)", "s->st_uid==0", "s->st_gid==0",
        "(s->st_mode&07777)==0555",
    )) or full.count("upgrade_directory_shape(&retained)") != 1 \
            or guard_shape.count("upgrade_rebound_dir(ns,") != 5:
        raise Rig("R23 retained runtime directory repeated shape binding missing")
    lock_shape = c_function_body(full, "upgrade_lock_shape")
    if any(token not in lock_shape for token in (
        "S_ISREG(s->st_mode)", "s->st_uid==0", "s->st_gid==0",
        "(s->st_mode&07777)==0600", "s->st_nlink==1", "s->st_size==0",
    )) or full.count("upgrade_lock_shape(&retained)") != 1:
        raise Rig("R23 retained lock full repeated shape binding missing")
    if any(token not in full for token in (
        "F_OFD_SETLK", "F_WRLCK", "H039_OLD_MEDIATOR_SHA256",
        "H039_OLD_MEDIATOR_SIZE",
    )):
        raise Rig("R23 fixed updater lock or old identity primitive missing")
    required = (
        "retained_installed_version(",
        "renameatx_np", "RENAME_NOFOLLOW_ANY", "RENAME_RESOLVE_BENEATH",
        "flush_dir(project)", "flush_dir(helpers)",
        "remove_fixed_staging", "exact_empty(project)",
        "upgrade_project_rebound(ns,project)",
        "upgrade_helpers_rebound(helpers)", "upgrade_guard_close(&guard)",
    )
    if any(token not in update_body for token in required):
        raise Rig("R23 fixed old-R12 to new-R14 updater primitive missing")
    forbidden = (
        "RENAME_SWAP", "RENAME_EXCL", "system(", "exec", "fork(",
        "posix_spawn", "popen(", "process", "kill(", "unlink(",
        "rename(", "argv", "getenv(",
    )
    if any(token in update_body for token in forbidden):
        raise Rig("R23 updater contains forbidden general or in-place authority")
    if re.search(r"(?<!f)chmod\s*\(", update_body) \
            or re.search(r"(?<!f)write\s*\(", update_body):
        raise Rig("R23 updater writes or chmods the installed helper in place")
    if update_body.count(
        'renameatx_np(project,"mediator",helpers,'
        '"se.nortropic.runtime-cleanup-mediator",'
    ) != 1:
        raise Rig("R23 updater does not rename exactly fixed stage to fixed helper")
    apply = c_function_body(full, "apply_install")
    if apply.count("upgrade_installed_mediator(") != 1 \
            or apply.count("finalizing&&prefix==5&&has_lock") != 1:
        raise Rig("R23 updater is absent or multiply dispatched")
    if R22_DIAGNOSTIC_DEFINE.encode() in installer_tail:
        raise Rig("R23 historical diagnostic define leaked into installer branch")


def r23_source_contract_selftests() -> None:
    r23_scan2_causal_selftests()
    r23_update_state_selftests()
    r23_update_event_trace_selftests()
    r23_compiled_scan2_harness()
    r23_connected_updater_harness()
    prefix = r23_expected_runtime_prefix()
    check(
        prefix.count(R23_NEW_SCAN2) == 1 and prefix.count(R23_OLD_SCAN2) == 0,
        "A_H039_R23_EXACT_R13_TO_POPULATED_SCAN2_PREFIX_TRANSFORM",
    )
    expected = r23_expected_production_source()
    r23_source_contract_checks(expected)
    check(
        expected.count(R23_NEW_SCAN2) == 1
        and expected.count(R23_NEW_INSTALLER_COMPILE_GUARD) == 1
        and expected.count(R23_UPDATER_HELPERS) == 1
        and expected.count(R23_DISPATCH_REPLACEMENT) == 1,
        "A_H039_R23_EXACT_WHOLE_R13_TO_R14_SOURCE_TRANSFORM",
        {"sha256": sha(expected), "size": len(expected)},
    )
    scan_mutants = {
        "NULL_QUERY_RESTORED": prefix.replace(R23_NEW_SCAN2, R23_OLD_SCAN2, 1),
        "CAPACITY_16": prefix.replace(b"final_list[17]", b"final_list[16]", 1),
        "CAPACITY_18": prefix.replace(b"final_list[17]", b"final_list[18]", 1),
        "SHORT_ACCEPT": prefix.replace(b"got==(int)sizeof *final_list", b"got<=(int)sizeof *final_list", 1),
        "EXTRA_ACCEPT": prefix.replace(b"got==(int)sizeof *final_list", b"got>=(int)sizeof *final_list", 1),
        "NONZERO_ACCEPT": prefix.replace(b"final_list[0].proc_fd==0", b"final_list[0].proc_fd>=0", 1),
        "DECOY_SECOND_FETCH": prefix.replace(R23_NEW_SCAN2, R23_NEW_SCAN2 + R23_NEW_SCAN2, 1),
    }
    for label, mutant in scan_mutants.items():
        check(
            mutant != prefix and mutant != r23_expected_runtime_prefix(),
            f"N_H039_R23_SCAN2_SOURCE_{label}",
        )
    source_mutants = {
        "OLD_COMPILE_GUARD": expected.replace(
            R23_NEW_INSTALLER_COMPILE_GUARD,
            R23_OLD_INSTALLER_COMPILE_GUARD, 1,
        ),
        "UPDATER_DELETED": expected.replace(R23_UPDATER_HELPERS, b"", 1),
        "UPDATER_DECOY": expected.replace(
            R23_UPDATER_HELPERS,
            R23_UPDATER_HELPERS + b"\n/* updater decoy */\n", 1,
        ),
        "DISPATCH_DELETED": expected.replace(
            R23_DISPATCH_REPLACEMENT, R23_DISPATCH_ANCHOR, 1,
        ),
        "LOCK_RELEASE_EARLY": expected.replace(
            b"if(old_fd>=0&&close(old_fd))ok=0;if(new_fd>=0&&close(new_fd))ok=0;"
            b"if(!upgrade_guard_close(&guard))ok=0;return ok;",
            b"if(!upgrade_guard_close(&guard))ok=0;if(old_fd>=0&&close(old_fd))ok=0;"
            b"if(new_fd>=0&&close(new_fd))ok=0;return ok;", 1,
        ),
        "RENAME_EXCL": expected.replace(
            b"unsigned flags=RENAME_NOFOLLOW_ANY|RENAME_RESOLVE_BENEATH;",
            b"unsigned flags=RENAME_EXCL|RENAME_NOFOLLOW_ANY|RENAME_RESOLVE_BENEATH;",
            1,
        ),
        "PROJECT_REBIND_REMOVED": expected.replace(
            b"||!upgrade_project_rebound(ns,project)||!exact_empty(project)",
            b"||!exact_empty(project)", 1,
        ),
    }
    for label, mutant in source_mutants.items():
        rejected = mutant != expected
        try:
            r23_source_contract_checks(mutant)
        except Rig:
            pass
        else:
            rejected = False
        check(rejected, f"N_H039_R23_WHOLE_SOURCE_{label}")


def strict_json(raw: bytes) -> Any:
    def pairs(items):
        out: dict[str, Any] = {}
        for key, value in items:
            if key in out:
                raise Rig(f"duplicate JSON key: {key}")
            out[key] = value
        return out

    try:
        return json.loads(
            raw.decode("utf-8"), object_pairs_hook=pairs,
            parse_constant=lambda value: (_ for _ in ()).throw(
                Rig(f"non-finite JSON value: {value}")),
        )
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise Rig(f"invalid strict JSON: {exc}") from exc


def check(ok: bool, label: str, detail: Any = "") -> None:
    global passed, failed
    rendered = detail if isinstance(detail, str) else canonical(detail).decode()
    if ok:
        passed += 1
        print(f"PASS {label}")
    else:
        failed += 1
        failed_labels.append((label, rendered))
        print(f"FAIL {label}" + (f" — {rendered}" if rendered else ""))


def frozen_h037_runtime() -> dict[str, Any]:
    global _H037_RUNTIME
    if _H037_RUNTIME is None:
        if path_sha(H037_GATE) != PINNED["verify/bin/h-037-exit"]:
            raise Rig("H037 closed Git helper identity drift")
        _H037_RUNTIME = runpy.run_path(
            str(H037_GATE), run_name="h039_frozen_h037",
        )
    return _H037_RUNTIME


def git(args: list[str], *, cwd: Path = ROOT, check_rc: bool = True) -> bytes:
    if cwd.resolve(strict=True) != ROOT.resolve(strict=True):
        raise Rig("identity Git is bound only to the authenticated H039 checkout")
    h037 = frozen_h037_runtime()
    try:
        binding = h037["canonical_git_binding"](ROOT)
        run = h037["identity_git"](binding, *args, text=False)
    except Exception as exc:
        raise Rig(f"closed Git binding failed: {exc}") from exc
    if check_rc and (run.returncode != 0 or run.stderr):
        raise Rig(
            f"git {' '.join(args)} rc={run.returncode} stderr={run.stderr!r}"
        )
    return run.stdout


def observed_production_main() -> str:
    global _H035_RUNTIME
    if _H035_RUNTIME is None:
        if path_sha(H035_GATE) != PINNED["verify/bin/h-035-exit"]:
            raise Rig("H035 production-remote observer identity drift")
        _H035_RUNTIME = runpy.run_path(
            str(H035_GATE), run_name="h039_frozen_h035",
        )
    try:
        origin, main_sha = _H035_RUNTIME["r15_observed_remote_main"](ROOT)
    except Exception as exc:
        raise Undecidable(f"authenticated production-main observation failed: {exc}") from exc
    if origin != PRODUCTION_ORIGIN or not valid_hex(main_sha, 40):
        raise Rig("production origin/main identity mismatch")
    return main_sha


def object_type(oid: str) -> str:
    return git(["cat-file", "-t", oid]).decode("ascii").strip()


def commit_parents(commit: str) -> list[str]:
    raw = git(["show", "-s", "--format=%P", commit]).decode().strip()
    return raw.split() if raw else []


def commit_tree(commit: str) -> str:
    return git(["show", "-s", "--format=%T", commit]).decode().strip()


def blob(commit: str, path: str) -> bytes:
    if object_type(commit) != "commit":
        raise Rig(f"not commit: {commit}")
    return git(["show", f"{commit}:{path}"])


def blob_size(commit: str, path: str) -> int:
    raw = git(["cat-file", "-s", f"{commit}:{path}"])
    try:
        value = int(raw.decode("ascii").strip())
    except (UnicodeError, ValueError) as exc:
        raise Rig(f"invalid Git blob size for {path}") from exc
    if value < 0:
        raise Rig(f"negative Git blob size for {path}")
    return value


def task_rows(spec: dict[str, Any], task_id: str) -> list[dict[str, Any]]:
    tasks = spec.get("tasks")
    if not isinstance(tasks, list):
        return []
    return [row for row in tasks if isinstance(row, dict) and row.get("id") == task_id]


def exact_contract(row: Any) -> bool:
    return isinstance(row, dict) and sha(canonical(row)) == EXPECTED_H039_ROW_SHA256


def static_contract_checks() -> dict[str, Any]:
    for path, digest in PINNED.items():
        check(path_sha(ROOT / path) == digest, f"A_H039_PINNED_{path.upper().replace('/', '_').replace('.', '_')}")
    check(
        commit_tree(R17_AUTHORITY_BASE) == R17_AUTHORITY_TREE
        and commit_parents(R17_AUTHORITY_BASE) == R17_AUTHORITY_PARENTS,
        "A_H039_R17_AUTHORITY_BASE_TREE_AND_ORDERED_PARENTS",
    )
    check(
        commit_tree(R18_AUTHORITY_BASE) == R18_AUTHORITY_TREE
        and commit_parents(R18_AUTHORITY_BASE) == R18_AUTHORITY_PARENTS,
        "A_H039_R18_AUTHORITY_BASE_TREE_AND_ORDERED_PARENTS",
    )
    check(
        commit_tree(R19_AUTHORITY_BASE) == R19_AUTHORITY_TREE
        and commit_parents(R19_AUTHORITY_BASE) == R19_AUTHORITY_PARENTS,
        "A_H039_R19_AUTHORITY_BASE_TREE_AND_ORDERED_PARENTS",
    )
    check(
        commit_tree(R20_AUTHORITY_BASE) == R20_AUTHORITY_TREE
        and commit_parents(R20_AUTHORITY_BASE) == R20_AUTHORITY_PARENTS,
        "A_H039_R20_AUTHORITY_BASE_TREE_AND_ORDERED_PARENTS",
    )
    check(
        commit_tree(R21_AUTHORITY_BASE) == R21_AUTHORITY_TREE
        and commit_parents(R21_AUTHORITY_BASE) == R21_AUTHORITY_PARENTS
        and commit_parents(R21_R20_CONTRACT_CANDIDATE) == [R20_AUTHORITY_BASE]
        and sha(blob(R21_AUTHORITY_BASE, "verify/bin/h-039-exit"))
        == R21_R20_GATE_SHA256
        and sha(blob(R21_AUTHORITY_BASE, "specs/tasks.spec.json"))
        == R21_R20_SPEC_SHA256,
        "A_H039_R21_AUTHORITY_BASE_GRAPH_GATE_AND_SPEC",
    )
    check(
        object_type(REJECTED_R21_R1_CANDIDATE) == "commit"
        and commit_tree(REJECTED_R21_R1_CANDIDATE) == REJECTED_R21_R1_TREE
        and commit_parents(REJECTED_R21_R1_CANDIDATE) == [R21_AUTHORITY_BASE]
        and sha(blob(REJECTED_R21_R1_CANDIDATE, "verify/bin/h-039-exit"))
        == REJECTED_R21_R1_GATE_SHA256
        and sha(blob(REJECTED_R21_R1_CANDIDATE, "specs/tasks.spec.json"))
        == REJECTED_R21_R1_SPEC_SHA256,
        "A_H039_R21_REJECTED_R1_GLOBAL_NORMALIZATION_ESCAPE_IMMUTABLE_NO_CREDIT",
    )
    check(
        commit_tree(R22_AUTHORITY_BASE) == R22_AUTHORITY_TREE
        and commit_parents(R22_AUTHORITY_BASE) == R22_AUTHORITY_PARENTS
        and commit_parents(R22_R21_CONTRACT_CANDIDATE) == [R21_AUTHORITY_BASE]
        and sha(blob(R22_AUTHORITY_BASE, "verify/bin/h-039-exit"))
        == R22_R21_GATE_SHA256
        and sha(blob(R22_AUTHORITY_BASE, "specs/tasks.spec.json"))
        == R22_R21_SPEC_SHA256,
        "A_H039_R22_AUTHORITY_BASE_GRAPH_GATE_AND_SPEC",
    )
    check(
        commit_tree(R23_AUTHORITY_BASE) == R23_AUTHORITY_TREE
        and commit_parents(R23_AUTHORITY_BASE) == R23_AUTHORITY_PARENTS
        and sha(blob(R23_AUTHORITY_BASE, "verify/bin/h-039-exit"))
        == R23_BASE_GATE_SHA256
        and sha(blob(R23_AUTHORITY_BASE, "specs/tasks.spec.json"))
        == R23_BASE_SPEC_SHA256,
        "A_H039_R23_AUTHORITY_BASE_GRAPH_GATE_AND_SPEC",
    )
    check(
        object_type(REJECTED_R22_R1_CANDIDATE) == "commit"
        and commit_tree(REJECTED_R22_R1_CANDIDATE) == REJECTED_R22_R1_TREE
        and commit_parents(REJECTED_R22_R1_CANDIDATE) == [R22_AUTHORITY_BASE]
        and sha(blob(REJECTED_R22_R1_CANDIDATE, "verify/bin/h-039-exit"))
        == REJECTED_R22_R1_GATE_SHA256
        and sha(blob(REJECTED_R22_R1_CANDIDATE, "specs/tasks.spec.json"))
        == REJECTED_R22_R1_SPEC_SHA256,
        "A_H039_R22_REJECTED_R1_PHASE_AND_RECORD_LITERAL_GAPS_IMMUTABLE_NO_CREDIT",
    )
    check(
        object_type(REJECTED_R22_R2_CANDIDATE) == "commit"
        and commit_tree(REJECTED_R22_R2_CANDIDATE) == REJECTED_R22_R2_TREE
        and commit_parents(REJECTED_R22_R2_CANDIDATE) == [R22_AUTHORITY_BASE]
        and sha(blob(REJECTED_R22_R2_CANDIDATE, "verify/bin/h-039-exit"))
        == REJECTED_R22_R2_GATE_SHA256
        and sha(blob(REJECTED_R22_R2_CANDIDATE, "specs/tasks.spec.json"))
        == REJECTED_R22_R2_SPEC_SHA256,
        "A_H039_R22_REJECTED_R2_UMASK_MODE_AND_WORDING_GAPS_IMMUTABLE_NO_CREDIT",
    )
    check(
        object_type(REJECTED_R22_R3_CANDIDATE) == "commit"
        and commit_tree(REJECTED_R22_R3_CANDIDATE) == REJECTED_R22_R3_TREE
        and commit_parents(REJECTED_R22_R3_CANDIDATE) == [R22_AUTHORITY_BASE]
        and sha(blob(REJECTED_R22_R3_CANDIDATE, "verify/bin/h-039-exit"))
        == REJECTED_R22_R3_GATE_SHA256
        and sha(blob(REJECTED_R22_R3_CANDIDATE, "specs/tasks.spec.json"))
        == REJECTED_R22_R3_SPEC_SHA256,
        "A_H039_R22_REJECTED_R3_TWO_OPEN_CONTINUITY_GAP_IMMUTABLE_NO_CREDIT",
    )
    check(commit_tree(CONTRACT_AUTHORITY_BASE) == CONTRACT_AUTHORITY_TREE,
          "A_H039_AUTHORITY_BASE_TREE")
    check(commit_parents(CONTRACT_AUTHORITY_BASE) == CONTRACT_AUTHORITY_PARENTS,
          "A_H039_AUTHORITY_BASE_ORDERED_PARENTS")
    check(
        commit_tree(R15_CONTRACT_AUTHORITY_BASE) == R15_CONTRACT_AUTHORITY_TREE
        and commit_parents(R15_CONTRACT_AUTHORITY_BASE)
        == R15_CONTRACT_AUTHORITY_PARENTS,
        "A_H039_R15_HISTORICAL_CONTRACT_AUTHORITY_IDENTITY",
    )
    check(
        object_type(REJECTED_R14_DIAGNOSTIC_CANDIDATE) == "commit"
        and commit_tree(REJECTED_R14_DIAGNOSTIC_CANDIDATE)
        == REJECTED_R14_DIAGNOSTIC_TREE
        and commit_parents(REJECTED_R14_DIAGNOSTIC_CANDIDATE)
        == [R15_CONTRACT_AUTHORITY_BASE],
        "A_H039_R15_REJECTED_R14_PRODUCT_IMMUTABLE_NO_CREDIT_IDENTITY",
    )
    check(object_type(PUBLISHED_H036_PRODUCT_MERGE) == "commit",
          "A_H039_PUBLISHED_H036_PRODUCT_MERGE_EXISTS")
    check(
        object_type(PUBLISHED_H039_R5_PRODUCT_MERGE) == "commit"
        and commit_tree(PUBLISHED_H039_R5_PRODUCT_MERGE)
        == PUBLISHED_H039_R5_PRODUCT_TREE
        and commit_parents(PUBLISHED_H039_R5_PRODUCT_MERGE)
        == PUBLISHED_H039_R5_PRODUCT_PARENTS,
        "A_H039_PUBLISHED_R5_PRODUCT_MERGE_IDENTITY",
    )
    for path, digest in PUBLISHED_H039_R5_PRODUCT_BLOBS.items():
        check(
            sha(blob(PUBLISHED_H039_R5_PRODUCT_MERGE, path)) == digest,
            f"A_H039_PUBLISHED_R5_{path.upper().replace('/', '_').replace('.', '_')}",
        )
    check(
        object_type(PUBLISHED_H039_R7_PRODUCT_MERGE) == "commit"
        and commit_tree(PUBLISHED_H039_R7_PRODUCT_MERGE)
        == PUBLISHED_H039_R7_PRODUCT_TREE
        and commit_parents(PUBLISHED_H039_R7_PRODUCT_MERGE)
        == PUBLISHED_H039_R7_PRODUCT_PARENTS,
        "A_H039_PUBLISHED_R7_PRODUCT_MERGE_IDENTITY",
    )
    for path, digest in PUBLISHED_H039_R7_PRODUCT_BLOBS.items():
