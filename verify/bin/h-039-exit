def source_function_bytes(raw: bytes, names: list[str]) -> dict[str, bytes]:
    try:
        text = raw.decode("utf-8")
        tree = ast.parse(text)
    except (UnicodeError, SyntaxError) as exc:
        raise Rig(f"installed engine source parse failed: {exc}") from exc
    lines = text.splitlines(keepends=True)
    found: dict[str, bytes] = {}
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) \
                and node.name in names:
            if node.name in found or node.end_lineno is None:
                raise Rig(f"ambiguous installed engine function: {node.name}")
            found[node.name] = "".join(
                lines[node.lineno - 1:node.end_lineno]
            ).encode("utf-8")
    if sorted(found) != sorted(names):
        raise Rig("installed engine function set incomplete")
    return found


def r17_installed_engine_selftests() -> None:
    current = source_function_bytes(GATE.read_bytes(), R17_INSTALLED_ENGINE_FUNCTIONS)
    authority = source_function_bytes(
        blob(R17_AUTHORITY_BASE, "verify/bin/h-039-exit"),
        R17_INSTALLED_ENGINE_FUNCTIONS,
    )
    check(
        current == authority,
        "A_H039_R17_INSTALLED_ENGINE_FUNCTIONS_BYTE_EQUIVALENT_TO_931E58F4",
        {name: sha(raw) for name, raw in current.items()},
    )
    for name in R17_INSTALLED_ENGINE_FUNCTIONS:
        mutant = dict(current)
        mutant[name] += b"\n# MUTANT"
        check(
            mutant != authority,
            f"N_H039_R17_INSTALLED_ENGINE_BYTE_MUTANT_{name.upper()}",
        )


