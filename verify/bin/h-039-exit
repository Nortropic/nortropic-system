        check(
            r13_preeffects_migration_oracle(
                fixture, r8_bytes=r13_r8_bytes, r8_cdhash=r13_r8_cdhash,
            ),
            f"A_H039_R13_PRE_EFFECTS_MIGRATION_{phase}",
        )
        alias_index = 0
        for path, value in r13_nodes(fixture):
            for alias_kind, replacement in r13_equality_aliases(value):
                mutant = r13_replace(fixture, path, replacement)
                if not mutant == fixture or type(replacement) is type(value):
                    raise Rig(
                        f"noncausal R13 typed-tree alias at {path!r}: {alias_kind}"
                    )
                check(
                    not r13_preeffects_migration_oracle(
                        mutant, r8_bytes=r13_r8_bytes,
                        r8_cdhash=r13_r8_cdhash,
                    ),
                    f"N_H039_R13_TYPED_TREE_{phase}_{alias_index:04d}",
                )
