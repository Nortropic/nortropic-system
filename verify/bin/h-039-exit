            "r10_diagnostic_reexecution_or_restage", True)),
        ("WORKFLOW_CREDIT", lambda value: value.__setitem__(
            "workflow_evidence_grants_credit", True)),
        ("PRODUCT_BYTES", lambda value: value.__setitem__(
            "new_product_bytes", True)),
        ("AUTHORITY_WIDENED", lambda value: value.__setitem__(
            "broader_authority", True)),
    ):
        mutant = copy.deepcopy(registry)
        mutate(mutant)
        check(
            not exact_typed_tree(mutant, expected),
            f"N_H039_R20_REGISTRY_{label}",
        )
    sample_merge = "ab" * 20
    check(
        exact_r20_installed_argv([
            "--r20-installed", sample_merge, R20_AUTHORITY_BASE,
        ]),
        "A_H039_R20_EXACT_INSTALLED_CLI_SHAPE",
    )
    for index, mutant in enumerate((
        [], ["--r20-installed"], ["--r20-installed", sample_merge],
        ["--r20-installed", sample_merge, R20_R12_CONTRACT_MERGE],
        ["--r20-installed", sample_merge.upper(), R20_AUTHORITY_BASE],
        ["--r20-installed", sample_merge, R20_AUTHORITY_BASE, "extra"],
        ["--r19-published", sample_merge, R20_AUTHORITY_BASE],
        ["--r18-installed", R20_AUTHORITY_BASE],
    )):
        check(
            not exact_r20_installed_argv(mutant),
            f"N_H039_R20_INSTALLED_CLI_MUTANT_{index:02d}",
    )


def exact_r22_product_argv(argv: Any) -> bool:
    return (
        type(argv) is list and len(argv) == 3
        and type(argv[0]) is str and argv[0] == "--r22-product"
        and type(argv[1]) is str and valid_hex(argv[1], 40)
        and type(argv[2]) is str and valid_hex(argv[2], 40)
    )


def exact_r22_publication_argv(argv: Any) -> bool:
    return (
        type(argv) is list and len(argv) == 2
        and type(argv[0]) is str and argv[0] == "--r22-published"
        and type(argv[1]) is str and valid_hex(argv[1], 40)
    )


def exact_r23_product_argv(argv: Any) -> bool:
    return (
        type(argv) is list and len(argv) == 3
        and all(type(value) is str for value in argv)
        and argv[0] == "--r23-product"
        and valid_hex(argv[1], 40) and valid_hex(argv[2], 40)
    )


def exact_r23_publication_argv(argv: Any) -> bool:
    return (
        type(argv) is list and len(argv) == 2
        and all(type(value) is str for value in argv)
        and argv[0] == "--r23-published" and valid_hex(argv[1], 40)
    )


def r23_registry_selftests(row: dict[str, Any]) -> None:
    registry = row["h039_os_exclusive_runtime_cleanup"][
        "r23_fd_scan_and_fixed_update"
    ]
    expected = r23_registry_expected()
    check(
        exact_typed_tree(registry, expected),
        "A_H039_R23_REGISTRY_SELFTEST_ANCHOR",
    )
    for label, mutate in (
        ("KEY_REMOVED", lambda value: value.pop("fixed_object_update")),
        ("KEY_ADDED", lambda value: value.__setitem__("alternate", False)),
        ("BASE_CHANGED", lambda value: value.__setitem__("authority_base", "00" * 20)),
        ("PARENTS_SWAPPED", lambda value: value["authority_ordered_parents"].reverse()),
        ("PATH_REMOVED", lambda value: value["product_change_paths"].pop()),
        ("STATUS_CHANGED", lambda value: value[
            "owner_adjudicated_r22_lifecycle"].__setitem__("exit_status", 0)),
        ("RETRY", lambda value: value[
            "owner_adjudicated_r22_lifecycle"].__setitem__(
                "diagnostic_consumed_removed_never_restage_or_run", False)),
        ("NULL_SIZE", lambda value: value["production_scan2"].__setitem__(
            "null_sizing_query", True)),
        ("CAPACITY_WIDENED", lambda value: value["production_scan2"].__setitem__(
            "allocation", "DYNAMIC")),
        ("OLD_DIGEST_CHANGED", lambda value: value["production_recipe"].__setitem__(
            "old_mediator_sha256", "00" * 32)),
        ("CALLER_PATH", lambda value: value["fixed_object_update"].__setitem__(
            "caller_path_fd_input", True)),
        ("LOCK_RELEASE_EARLY", lambda value: value["fixed_object_update"].__setitem__(
            "staging_removed_before_lock_release", False)),
        ("INPLACE", lambda value: value["fixed_object_update"].__setitem__(
            "installed_inode_inplace_write_chmod_dd_or_swap", True)),
        ("CRASH_STATE_ADDED", lambda value: value[
            "representable_crash_states"].append("ARBITRARY")),
        ("R24_PREMATURE", lambda value: value.__setitem__(
            "r24_installed_lane_available_in_r23", True)),
        ("AUTHORITY_WIDENED", lambda value: value.__setitem__(
            "broader_authority", True)),
    ):
        mutant = copy.deepcopy(registry)
        mutate(mutant)
        check(not exact_typed_tree(mutant, expected), f"N_H039_R23_REGISTRY_{label}")
    sample = "ab" * 20
    check(
        exact_r23_product_argv(["--r23-product", sample, "cd" * 20])
        and exact_r23_publication_argv(["--r23-published", sample]),
        "A_H039_R23_EXACT_PRODUCT_AND_PUBLICATION_CLI_SHAPES",
    )
    check(
        exact_r22_product_argv(["--r22-product", sample, "cd" * 20])
        and exact_r22_publication_argv(["--r22-published", sample])
        and not exact_r23_product_argv(["--r22-product", sample, "cd" * 20])
        and not exact_r23_publication_argv(["--r22-published", sample]),
        "N_H039_R23_HISTORICAL_R22_CLI_SHAPES_ARE_STALE",
    )
    invalid = (
        [], ["--r23-product", sample],
        ["--r23-product", sample, "CD" * 20],
        ["--r23-published", sample, "extra"],
        ["--r24-installed", sample], ["--r22-product", sample, "cd" * 20],
    )
    for index, argv in enumerate(invalid):
        check(
            not exact_r23_product_argv(argv) and not exact_r23_publication_argv(argv),
            f"N_H039_R23_CLI_MUTANT_{index:02d}",
        )


def r23_dispatch_retained_selftests() -> None:
    try:
        source = GATE.read_text(encoding="utf-8")
        tree = ast.parse(source, filename=str(GATE))
    except (OSError, UnicodeError, SyntaxError) as exc:
        raise Rig("R23 executing gate AST is unavailable") from exc
    functions = {
        node.name: node for node in tree.body if isinstance(node, ast.FunctionDef)
    }
    if not {
        "main", "r23_product_material_with_retained_installed",
        "r23_product_material_checks", "r23_compiled_production_views",
    } \
            <= functions.keys():
        raise Rig("R23 retained review dispatch functions absent")

    def name(call: ast.Call) -> str:
        if isinstance(call.func, ast.Name):
            return call.func.id
        if isinstance(call.func, ast.Attribute) \
                and isinstance(call.func.value, ast.Name):
            return f"{call.func.value.id}.{call.func.attr}"
        return ""

    wrapper = functions["r23_product_material_with_retained_installed"]
    wrapper_calls = [node for node in ast.walk(wrapper) if isinstance(node, ast.Call)]
    wrapper_names = [name(node) for node in wrapper_calls]
    closes = [node for node in wrapper_calls if name(node) == "os.close"]
    finalizers = [
        node for node in ast.walk(wrapper) if isinstance(node, ast.Try)
        and closes and any(closes[0] in ast.walk(item) for item in node.finalbody)
    ]
    wrapper_text = ast.get_source_segment(source, wrapper) or ""
    if (
        wrapper_names.count("r22_open_installed_retained") != 1
        or wrapper_names.count("r22_retained_installed_snapshot") != 2
        or wrapper_names.count("r23_product_material_checks") != 1
        or wrapper_names.count("fixed_installation_snapshot") != 2
        or wrapper_names.count("exact_typed_tree") != 1
        or wrapper_names.count("os.close") != 1
        or wrapper_names.count("fcntl.fcntl") != 5
        or len(finalizers) != 1
        or "os.open" in wrapper_names or "os.dup" in wrapper_names
        or "os.set_inheritable" in wrapper_names
        or wrapper_text.count("require_clean_metadata=True") != 2
        or wrapper_text.count("finally:") != 1
        or wrapper_text.count("errno.EBADF") != 1
    ):
        raise Rig("R23 retained installed/namespace wrapper shape drift")
    main = functions["main"]
    main_calls = [node for node in ast.walk(main) if isinstance(node, ast.Call)]
    main_names = [name(node) for node in main_calls]
    main_text = ast.get_source_segment(source, main) or ""
    stale_r22 = {
        "exact_r22_product_argv", "exact_r22_publication_argv",
        "r22_product_identity", "r22_product_publication_identity",
        "r22_product_material_checks",
        "r22_product_material_with_retained_installed",
        "r22_compiled_diagnostic_views", "r22_compiled_diagnostic_checks",
    }
    production_chain_names = {
        name(node) for function_name in (
            "r23_product_material_with_retained_installed",
            "r23_product_material_checks", "r23_compiled_production_views",
        ) for node in ast.walk(functions[function_name])
        if isinstance(node, ast.Call)
    }
    if "--r22-product" in main_text or "--r22-published" in main_text \
            or stale_r22 & set(main_names) \
            or stale_r22 & production_chain_names:
        raise Rig("R23 historical R22 product/publication material lane is runnable")
    ordered = ("seatbelt_profile_selftests", "r23_source_contract_selftests",
               "r23_dispatch_retained_selftests")
    order_lines = [next(node.lineno for node in main_calls if name(node) == item)
                   if main_names.count(item) == 1 else -1 for item in ordered]
    if order_lines != sorted(order_lines) or -1 in order_lines:
        raise Rig("R23 pinned Seatbelt authentication does not precede harnesses")
    for phase in ("r23_product", "r23_published"):
        branches = [
            node for node in ast.walk(main) if isinstance(node, ast.If)
            and isinstance(node.test, ast.Name) and node.test.id == phase
        ]
        if len(branches) != 1:
            raise Rig(f"R23 {phase} branch cardinality drift")
        calls = [node for node in ast.walk(branches[0]) if isinstance(node, ast.Call)]
        names = [name(node) for node in calls]
        required = (
            "r23_r22_lifecycle_evidence_checks", "r22_int2_evidence_checks",
            "r23_product_material_with_retained_installed",
        )
        lines = [next(node.lineno for node in calls if name(node) == item)
                 if names.count(item) == 1 else -1 for item in required]
        if lines != sorted(lines) or -1 in lines \
                or "r23_product_material_checks" in names \
                or "r22_open_installed_retained" in names \
                or "os.open" in names or "os.close" in names:
            raise Rig(f"R23 {phase} does not bind identity before retained review")
    check(
        True,
        "A_H039_R23_PRODUCT_LANES_ONE_RETAINED_OLD_FD_AND_NAMESPACE_NO_EFFECT",
    )
    check(
        True,
        "N_H039_R23_R22_PRODUCT_PUBLICATION_CLI_AND_DIAGNOSTIC_COMPILE_STALE",
    )


