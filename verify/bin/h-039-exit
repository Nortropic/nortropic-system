    pred_bad_digest = {**predecessor, "effect_sha256": "99" * 32}
    pred_gap = {**predecessor, "sequence": predecessor["sequence"] + 2}
    pred_gap["effect_sha256"] = sha(canonical({
        **{key: value for key, value in pred_gap.items() if key != "effect_sha256"},
        "zero_runtime_residue": True,
    }))
    pred_create_collision = {**predecessor, "create_request_nonce": fresh_nonce}
    pred_cleanup_collision = {**predecessor, "cleanup_request_nonce": fresh_nonce}
    pred_cross_operation_collision = {
        **predecessor,
        "cleanup_request_nonce": predecessor["create_request_nonce"],
    }
    for pred in (
        pred_create_collision, pred_cleanup_collision, pred_cross_operation_collision,
    ):
        pred["effect_sha256"] = sha(canonical({
            **{key: value for key, value in pred.items() if key != "effect_sha256"},
            "zero_runtime_residue": True,
        }))
    for label, pred in (
        ("PREDECESSOR_MALFORMED", {**predecessor, "extra": False}),
        ("PREDECESSOR_BAD_DIGEST", pred_bad_digest),
        ("PREDECESSOR_ABSENT_SEQUENCE_GT1", None),
        ("PREDECESSOR_SEQUENCE_GAP", pred_gap),
        ("PREDECESSOR_CREATE_COLLISION", pred_create_collision),
        ("PREDECESSOR_CLEANUP_COLLISION", pred_cleanup_collision),
        ("PREDECESSOR_CROSS_OPERATION_COLLISION", pred_cross_operation_collision),
    ):
        current_tmp_mutants.append((
            label, current_q, fresh_tmp, {**reconcile_args, "predecessor": pred},
        ))
    current_tmp_mutants.append((
        "PREDECESSOR_PRESENT_SEQUENCE_ONE", sequence_one_current,
        sequence_one_temp, reconcile_args,
    ))
    old_create_collision = modeled_current_record(
        state, "QUARANTINING", state["create_request_nonce"],
    )
    current_tmp_mutants.append((
        "OLD_CLEANUP_EQUALS_CURRENT_CREATE", old_create_collision,
        fresh_tmp, reconcile_args,
    ))
    for label, old_record, next_record, args in current_tmp_mutants:
        admitted, unchanged = reconcile_fixture(old_record, next_record, **args)
        check(
            not admitted and unchanged == old_record,
            f"N_H039_R5_CURRENT_TMP_{label}",
        )
    for barrier, expected_phase, expected_location in (
        (1, "QUARANTINING", "active"),
        (2, "QUARANTINING", "quarantine"),
        (3, "CLEANING", "quarantine"),
        (4, "CLEANING", "quarantine"),
        (5, "CLEANING", None),
        (6, "CLEANING", None),
    ):
        _, crashed = cleanup_model(**defaults, crash_barrier=barrier)
        continuation = cleanup if barrier >= 4 else {
            **cleanup, "request_nonce": f"{barrier + 5:02x}" * 32,
        }
        if barrier <= 3:
            _probe_result, orientation_probe = cleanup_model(
                **{**defaults, "request": continuation, "state": crashed},
                crash_barrier=1,
            )
            check(
                orientation_probe["phase"] == crashed["phase"]
                and orientation_probe["location"] == crashed["location"],
                f"A_H039_MODEL_CRASH_BARRIER_{barrier}_RESUME_PRESERVES_ORIENTATION",
            )
        resumed, recovered = cleanup_model(
            **{**defaults, "request": continuation, "state": crashed},
            crash_barrier=None,
        )
        check(
            crashed["phase"] == expected_phase
            and crashed["location"] == expected_location
            and resumed and recovered["phase"] is None
            and recovered.get("state_present") is False
            and recovered.get("receipt_temp") is False
            and recovered.get("receipt_cleanup_request_nonce")
            == continuation["request_nonce"]
            and valid_hex(recovered.get("receipt")),
            f"A_H039_MODEL_CRASH_BARRIER_{barrier}_RECOVERS",
        )
        if barrier >= 4:
            check(
                recovered.get("receipt_record") == crashed["receipt_temp_record"]
                and recovered.get("receipt")
                == sha(canonical(crashed["receipt_temp_record"]))
                and recovered.get("receipt_temp_write_count")
                == crashed.get("receipt_temp_write_count") == 1
                and recovered.get("residue") == []
                and recovered.get("state_present") is False,
                f"A_H039_MODEL_CRASH_BARRIER_{barrier}_TEMP_PUBLISHED_BYTE_EXACT",
            )
            different = {**cleanup, "request_nonce": "55" * 32}
            check(
                cleanup_nonce_disposition(crashed, cleanup["request_nonce"])
                == "TEMP_CONTINUATION"
                and cleanup_nonce_disposition(crashed, different["request_nonce"])
                == "CAPACITY",
                f"A_H039_MODEL_CRASH_BARRIER_{barrier}_EXACT_NONCE_DISPOSITION",
            )
            if barrier in {4, 5}:
                check(
                    crashed["location"] == ("quarantine" if barrier == 4 else None),
                    "A_H039_MODEL_DURABLE_TEMP_"
                    + ("Q_PRESENT" if barrier == 4 else "Q_ABSENT")
                    + "_SAME_NONCE_CONTINUATION",
                )
            rejected, unchanged = cleanup_model(
                **{**defaults, "request": different, "state": crashed},
                crash_barrier=None,
            )
            check(
                not rejected and unchanged == crashed,
                f"N_H039_MODEL_CRASH_BARRIER_{barrier}_NONCE_REWRITE",
            )
            for label, poisoned in (
                ("CREATE_COLLISION", {
                    **crashed,
                    "create_request_nonce": crashed["cleanup_request_nonce"],
                }),
                ("LAST_CREATE_COLLISION", {
                    **crashed,
                    "last_create_request_nonce": crashed["cleanup_request_nonce"],
                }),
                ("LAST_CLEANUP_COLLISION", {
                    **crashed,
                    "last_cleanup_request_nonce": crashed["cleanup_request_nonce"],
                }),
            ):
                rejected, unchanged = cleanup_model(
                    **{**defaults, "state": poisoned}, crash_barrier=None,
                )
                check(
                    not rejected and unchanged == poisoned,
                    f"N_H039_MODEL_CRASH_BARRIER_{barrier}_{label}",
                )
            for label, key, replacement in (
                ("TEMP_RUNTIME", "runtime_id", "99" * 16),
                ("TEMP_CAPABILITY", "capability_sha256", "99" * 32),
                ("TEMP_CREATE_NONCE", "create_request_nonce", "99" * 32),
                ("TEMP_CLEANUP_NONCE", "cleanup_request_nonce", "99" * 32),
                ("TEMP_SEQUENCE", "sequence", crashed["sequence"] + 1),
                ("TEMP_SCHEMA", "schema_version", 2),
                ("TEMP_EFFECT", "effect_sha256", "99" * 32),
            ):
                poisoned = copy.deepcopy(crashed)
                poisoned["receipt_temp_record"][key] = replacement
                rejected, unchanged = cleanup_model(
                    **{**defaults, "state": poisoned}, crash_barrier=None,
                )
                check(
                    not rejected and unchanged == poisoned,
                    f"N_H039_MODEL_CRASH_BARRIER_{barrier}_{label}",
                )
            extra_temp = copy.deepcopy(crashed)
            extra_temp["receipt_temp_record"]["extra"] = False
            rejected, unchanged = cleanup_model(
                **{**defaults, "state": extra_temp}, crash_barrier=None,
            )
            check(
                not rejected and unchanged == extra_temp,
                f"N_H039_MODEL_CRASH_BARRIER_{barrier}_TEMP_EXTRA_KEY",
            )
            for label, poisoned in (
                ("TEMP_WRONG_PHASE", {**crashed, "phase": "QUARANTINING"}),
                ("TEMP_NONEMPTY_Q", {**crashed, "residue": ["unexpected"]}),
                ("TERMINAL_LOCATION", {
                    **crashed, "state_present": False, "location": "quarantine",
                }),
            ):
                rejected, unchanged = cleanup_model(
                    **{**defaults, "state": poisoned}, crash_barrier=None,
                )
                check(
                    not rejected and unchanged == poisoned,
                    f"N_H039_MODEL_CRASH_BARRIER_{barrier}_{label}",
                )
        elif barrier >= 1:
            rejected, unchanged = cleanup_model(
                **{**defaults, "state": crashed}, crash_barrier=None,
            )
            check(
                not rejected and unchanged == crashed,
                f"N_H039_MODEL_CRASH_BARRIER_{barrier}_INCOMPLETE_REPLAY",
            )
    _, pretemp = cleanup_model(**defaults, crash_barrier=3)
    fresh_pretemp = {**cleanup, "request_nonce": "aa" * 32}
    _, pretemp_resumed = cleanup_model(
        **{**defaults, "request": fresh_pretemp, "state": pretemp},
        crash_barrier=3,
    )
    _, with_temp = cleanup_model(**defaults, crash_barrier=4)
    posttemp_accepted, posttemp_unchanged = cleanup_model(
        **{**defaults, "request": fresh_pretemp, "state": with_temp},
        crash_barrier=None,
    )
    check(
        pretemp_resumed["cleanup_request_nonce"] == fresh_pretemp["request_nonce"]
        and pretemp_resumed["phase"] == "CLEANING"
        and pretemp_resumed["location"] == "quarantine"
        and not posttemp_accepted and posttemp_unchanged == with_temp,
        "A_H039_MODEL_PRETEMP_DISTINCT_NONCE_ADMITTED_POSTTEMP_REWRITE_DENIED",
    )
    reserving = create_handoff_model(
        phase="RESERVING", ack=None, fifo_eof=True, members_busy=False,
    )
    publishing = create_handoff_model(
        phase="CREATING", ack=None, fifo_eof=True, members_busy=False,
    )
    preparing = create_handoff_model(
        phase="PUBLISHING", ack=None, fifo_eof=True, members_busy=False,
    )
    prepared = create_handoff_model(
        phase="PREPARING", ack=None, fifo_eof=True, members_busy=False,
    )
    active = create_handoff_model(
        phase="PREPARED", ack=b"A", fifo_eof=False, members_busy=True,
    )
    check(
        reserving == ("CREATING", False, True)
        and publishing == ("PUBLISHING", False, True)
        and preparing == ("PREPARING", False, True)
        and prepared == ("PREPARED", False, True)
        and active == ("ACTIVE", True, False),
        "A_H039_MODEL_TWO_PHASE_PREPARED_ACK_ACTIVE",
    )
    for label, ack, eof, busy in (
        ("WRONG_ACK_LIVE", b"X", False, True),
        ("LIVE_FIFO", None, False, False),
        ("BUSY_MEMBER", None, True, True),
    ):
        phase, authority, recoverable = create_handoff_model(
            phase="PREPARED", ack=ack, fifo_eof=eof, members_busy=busy,
        )
        check(phase == "PREPARED" and not authority and not recoverable,
              f"N_H039_MODEL_PREPARED_{label}")
    check(create_handoff_model(
        phase="PREPARED", ack=b"X", fifo_eof=True, members_busy=False,
    ) == ("PREPARED", False, True),
        "A_H039_MODEL_WRONG_ACK_RECOVERS_ONLY_AFTER_CLOSE_EOF_NOT_BUSY")
    check(create_handoff_model(
        phase="ACTIVE", ack=None, fifo_eof=True, members_busy=False,
    ) == ("CLEANING", False, True),
        "A_H039_MODEL_SOLE_ABANDONED_ACTIVE_RECOVERS_AFTER_EOF_NOT_BUSY")
    check(create_handoff_model(
        phase="ACTIVE", ack=None, fifo_eof=False, members_busy=False,
    ) == ("ACTIVE", True, False),
        "N_H039_MODEL_ACTIVE_LIVE_LEASE_NEVER_RECOVERS")


def ofd_lock_reference() -> None:
    if sys.platform != "darwin" or getattr(fcntl, "F_OFD_SETLK", None) != 90:
        raise Undecidable("Darwin F_OFD_SETLK=90 required")
    root = Path(tempfile.mkdtemp(prefix="h039-ofd-", dir="/private/tmp"))
    lock = root / "lock"
    lock.write_bytes(b"")
    lock.chmod(0o600)
    first = os.open(lock, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
    duplicate = os.dup(first)
    independent = os.open(lock, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
    flock = struct.pack("@qqihh", 0, 0, 0, fcntl.F_WRLCK, os.SEEK_SET)

    def conflicts() -> bool:
        try:
            fcntl.fcntl(independent, fcntl.F_OFD_SETLK, flock)
            return False
        except OSError as exc:
            return exc.errno == errno.EAGAIN

    try:
        fcntl.fcntl(first, fcntl.F_OFD_SETLK, flock)
        before = conflicts()
        os.close(first)
        first = -1
        after_one_close = conflicts()
        os.close(duplicate)
        duplicate = -1
        released_after_last = not conflicts()
        check(
            before and after_one_close and released_after_last,
            "A_H039_DARWIN_OFD_LOCK_LAST_DESCRIPTION_REFERENCE",
            {"before": before, "after_one_close": after_one_close,
             "released_after_last": released_after_last},
        )
    finally:
        close_all((first, duplicate, independent))
        shutil.rmtree(root)


def connected_stream_unlink_reference() -> None:
    """Bind the Darwin fact that NODELETEBUSY does not cover accepted streams."""
    if sys.platform != "darwin":
        raise Undecidable("Darwin accepted-stream NODELETEBUSY reference required")
    root = Path(tempfile.mkdtemp(prefix="h039-stream-", dir="/private/tmp"))
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    accepted: socket.socket | None = None
    root_fd = -1
    try:
        path = root / "portal.sock"
        try:
            listener.bind(str(path))
        except OSError as exc:
            if exc.errno == errno.EPERM:
                raise Undecidable("outer sandbox denied AF_UNIX reference bind") from exc
            raise
        listener.listen(1)
        client.connect(str(path))
        accepted, _address = listener.accept()
        listener.close()
        root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        libc = ctypes.CDLL(None, use_errno=True)
        libc.unlinkat.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int)
        libc.unlinkat.restype = ctypes.c_int
        flags = 0x0800 | 0x2000 | 0x4000
        result = libc.unlinkat(root_fd, b"portal.sock", flags)
        observed_errno = ctypes.get_errno()
        if result != 0:
            raise Undecidable(
                f"accepted-stream NODELETEBUSY host result changed errno={observed_errno}"
            )
        client.sendall(b"still-live")
        client_to_server = accepted.recv(32)
        accepted.sendall(b"reply")
        server_to_client = client.recv(32)
        check(
            not path.exists() and client_to_server == b"still-live"
            and server_to_client == b"reply",
            "A_H039_ACCEPTED_STREAM_SURVIVES_NODELETEBUSY_NAME_REMOVAL",
        )
    finally:
        client.close()
        if accepted is not None:
            accepted.close()
        listener.close()
        close_all((root_fd,))
        shutil.rmtree(root)


def stable_identity(value: os.stat_result) -> tuple[int, ...]:
    return (
        value.st_dev, value.st_ino, stat.S_IFMT(value.st_mode), value.st_uid,
        value.st_gid, stat.S_IMODE(value.st_mode), value.st_nlink,
        value.st_size, value.st_mtime_ns, value.st_ctime_ns,
    )


def retained_directory_identity(value: os.stat_result) -> tuple[int, ...]:
    return (
        value.st_dev, value.st_ino, stat.S_IFMT(value.st_mode), value.st_uid,
        value.st_gid, stat.S_IMODE(value.st_mode),
    )


def require_retained_directory(
    descriptor: int, expected: tuple[int, ...], *, label: str,
) -> os.stat_result:
    if type(descriptor) is not int or descriptor < 3 \
            or not strict_identity_tuple(expected, 6):
        raise Rig(f"{label} retained directory capability rejected")
    opened = os.fstat(descriptor)
    if (
        not stat.S_ISDIR(opened.st_mode) or opened.st_uid != os.getuid()
        or stat.S_IMODE(opened.st_mode) not in {0o700, 0o755}
        or opened.st_nlink < 1
        or retained_directory_identity(opened) != expected
        or fcntl.fcntl(descriptor, fcntl.F_GETFD) & fcntl.FD_CLOEXEC == 0
    ):
        raise Rig(f"{label} retained directory identity rejected")
    return opened


def strict_identity_tuple(value: Any, length: int) -> bool:
    return (
        isinstance(value, tuple) and len(value) == length
        and all(type(member) is int and member >= 0 for member in value)
    )


def stable_directory_at(parent_fd: int, name: str) -> int:
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name) or name in {".", ".."}:
        raise Rig("unsafe directory leaf")
    nofollow_any = getattr(os, "O_NOFOLLOW_ANY", None)
    if sys.platform != "darwin" or nofollow_any is None:
        raise Undecidable("Darwin O_NOFOLLOW_ANY required")
    descriptor = os.open(
        name, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | nofollow_any,
        dir_fd=parent_fd,
    )
    try:
        opened = os.fstat(descriptor)
        rebound = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        if (
            not stat.S_ISDIR(opened.st_mode) or opened.st_uid != os.getuid()
            or stat.S_IMODE(opened.st_mode) not in {0o700, 0o755}
            or opened.st_nlink < 1
            or stable_identity(opened) != stable_identity(rebound)
        ):
            raise Rig("stable directory identity rejected")
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def stable_read_at(
    parent_fd: int, name: str, *, maximum: int, allowed_modes: set[int],
    after_read: Any = None,
) -> tuple[bytes, tuple[int, ...]]:
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name) or name in {".", ".."}:
        raise Rig("unsafe stable-read leaf")
    nofollow_any = getattr(os, "O_NOFOLLOW_ANY", None)
    if sys.platform != "darwin" or nofollow_any is None:
        raise Undecidable("Darwin O_NOFOLLOW_ANY required")
    descriptor = os.open(
        name,
        os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow_any | 0x00002000,
        dir_fd=parent_fd,
    )
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid()
            or stat.S_IMODE(before.st_mode) not in allowed_modes
            or before.st_nlink != 1
            or before.st_size > maximum
        ):
            raise Rig("stable-read identity rejected")
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(descriptor, min(65536, maximum + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > maximum:
                raise Rig("stable-read size exceeded")
        if after_read is not None:
            after_read()
        after = os.fstat(descriptor)
        rebound = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        if stable_identity(before) != stable_identity(after) \
                or stable_identity(after) != stable_identity(rebound) \
                or total != after.st_size:
            raise Rig("stable-read object changed or rebound")
        return b"".join(chunks), stable_identity(after)
    finally:
        os.close(descriptor)


def load_managed_envelope(
    journal_root_fd: int, envelope_fd: int, binding: dict[str, Any],
    *, after_read: Any = None,
) -> tuple[bytes, tuple[int, ...]]:
    exact_binding_keys = {
        "envelope_absolute", "envelope_identity", "envelope_length", "envelope_sha256",
        "events_identity", "events_length", "events_sha256", "head",
        "journal_root_absolute", "journal_root_identity", "role", "run_identity",
        "run_name", "worktree",
    }
    if not isinstance(binding, dict) or set(binding) != exact_binding_keys:
        raise Rig("managed retained-origin binding schema rejected")
    journal_root_identity = binding["journal_root_identity"]
    require_retained_directory(
        journal_root_fd, journal_root_identity, label="managed journal root",
    )
    run_name = binding["run_name"]
    role = binding["role"]
    worktree = binding["worktree"]
    head = binding["head"]
    journal_root_absolute = binding["journal_root_absolute"]
    envelope_absolute = binding["envelope_absolute"]
    if (
        not isinstance(run_name, str) or not isinstance(role, str)
        or not isinstance(worktree, str) or not isinstance(head, str)
        or not isinstance(journal_root_absolute, str)
        or not isinstance(envelope_absolute, str)
        or not strict_identity_tuple(binding["journal_root_identity"], 6)
        or not strict_identity_tuple(binding["run_identity"], 6)
        or not strict_identity_tuple(binding["events_identity"], 10)
        or not strict_identity_tuple(binding["envelope_identity"], 10)
        or type(binding["events_length"]) is not int or binding["events_length"] < 1
        or type(binding["envelope_length"]) is not int or binding["envelope_length"] < 0
        or not valid_hex(binding["events_sha256"])
        or not valid_hex(binding["envelope_sha256"])
        or not re.fullmatch(r"[0-9]{8}-[0-9]{6}-[a-z_]+", run_name)
        or not re.fullmatch(r"[A-Z_]+", role)
        or not run_name.endswith("-" + role.lower())
        or not os.path.isabs(worktree) or os.path.normpath(worktree) != worktree
        or not os.path.isabs(journal_root_absolute)
        or os.path.normpath(journal_root_absolute) != journal_root_absolute
        or not os.path.isabs(envelope_absolute)
        or os.path.normpath(envelope_absolute) != envelope_absolute
        or envelope_absolute != os.path.join(
            journal_root_absolute, "runs", run_name, "provider-envelope.json",
        )
        or not valid_hex(head, 40)
    ):
        raise Rig("managed current-run selector rejected")
    if descriptor_path(journal_root_fd) != Path(journal_root_absolute):
        raise Rig("managed journal root capability path differs from controller binding")
    runs_fd = run_fd = -1
    try:
        events_raw, events_identity = stable_read_at(
            journal_root_fd, "events.jsonl", maximum=4194304,
            allowed_modes={0o600, 0o644},
        )
        if events_identity != binding["events_identity"] \
                or len(events_raw) != binding["events_length"] \
                or sha(events_raw) != binding["events_sha256"]:
            raise Rig("managed AGENT_START journal differs from controller binding")
        if not events_raw or not events_raw.endswith(b"\n"):
            raise Rig("managed AGENT_START journal is incomplete")
        records = [strict_json(line) for line in events_raw.splitlines()]
        origin = records[-1]
        exact_keys = {
            "event", "head", "model", "model_routing_source",
            "reasoning_effort", "role", "ts", "worktree",
        }
        if (
            any(not isinstance(record, dict) for record in records)
            or not isinstance(origin, dict) or set(origin) != exact_keys
            or origin.get("event") != "AGENT_START"
            or origin.get("role") != role or origin.get("worktree") != worktree
            or origin.get("head") != head
            or not isinstance(origin.get("ts"), str) or not origin["ts"]
            or not isinstance(origin.get("model"), str) or not origin["model"]
            or not isinstance(origin.get("model_routing_source"), str)
            or not origin["model_routing_source"]
            or not isinstance(origin.get("reasoning_effort"), str)
            or not origin["reasoning_effort"]
        ):
            raise Rig("managed envelope journal origin rejected")
        runs_fd = stable_directory_at(journal_root_fd, "runs")
        run_fd = stable_directory_at(runs_fd, run_name)
        if retained_directory_identity(os.fstat(run_fd)) != binding["run_identity"]:
            raise Rig("managed current-run directory differs from controller binding")
        if type(envelope_fd) is not int or envelope_fd < 3 \
                or fcntl.fcntl(envelope_fd, fcntl.F_GETFL) & os.O_ACCMODE != os.O_RDONLY \
                or fcntl.fcntl(envelope_fd, fcntl.F_GETFD) & fcntl.FD_CLOEXEC == 0:
            raise Rig("managed envelope capability is not retained read-only/CLOEXEC")
        before = os.fstat(envelope_fd)
        if stable_identity(before) != binding["envelope_identity"] \
                or not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid() \
                or stat.S_IMODE(before.st_mode) not in {0o600, 0o644} \
                or before.st_nlink != 1 or before.st_size > 1048576:
            raise Rig("managed envelope capability differs from controller binding")
        if descriptor_path(envelope_fd) != Path(envelope_absolute):
            raise Rig("managed envelope capability path differs from controller binding")
        os.lseek(envelope_fd, 0, os.SEEK_SET)
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(envelope_fd, min(65536, 1048577 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > 1048576:
                raise Rig("managed envelope capability exceeded byte limit")
        if after_read is not None:
            after_read()
        payload = b"".join(chunks)
        after = os.fstat(envelope_fd)
        rebound = os.stat(
            "provider-envelope.json", dir_fd=run_fd, follow_symlinks=False,
        )
        identity = stable_identity(after)
        if stable_identity(before) != identity \
                or identity != stable_identity(rebound) \
                or identity != binding["envelope_identity"] \
                or total != after.st_size or total != binding["envelope_length"] \
                or sha(payload) != binding["envelope_sha256"] \
                or descriptor_path(journal_root_fd) != Path(journal_root_absolute) \
                or descriptor_path(envelope_fd) != Path(envelope_absolute):
            raise Rig("managed retained envelope changed, replayed, or rebound")
        return payload, identity
    finally:
        close_all((run_fd, runs_fd))


def open_managed_cwd(
    ancestor_fd: int, ancestor_identity: tuple[int, ...],
    ancestor_absolute: str, candidate: str,
) -> int:
    nofollow_any = getattr(os, "O_NOFOLLOW_ANY", None)
    if sys.platform != "darwin" or nofollow_any is None:
        raise Undecidable("Darwin O_NOFOLLOW_ANY required")
    require_retained_directory(
        ancestor_fd, ancestor_identity, label="managed workspace ancestor",
    )
    if (
        not os.path.isabs(ancestor_absolute)
        or os.path.normpath(ancestor_absolute) != ancestor_absolute
        or not os.path.isabs(candidate) or os.path.normpath(candidate) != candidate
    ):
        raise Rig("managed cwd is not absolute lexically canonical")
    try:
        relative = Path(candidate).relative_to(Path(ancestor_absolute))
    except ValueError as exc:
        raise Rig("managed cwd escapes ancestor workspace") from exc
    current = os.dup(ancestor_fd)
    try:
        fcntl.fcntl(current, fcntl.F_SETFD, fcntl.FD_CLOEXEC)
        for component in relative.parts:
            if component in {"", ".", ".."}:
                raise Rig("managed cwd component rejected")
            following = stable_directory_at(current, component)
            os.close(current)
            current = following
        return current
    except Exception:
        os.close(current)
        raise


def managed_option_a_reference() -> None:
    root = Path(tempfile.mkdtemp(prefix="h039-managed-", dir="/private/tmp"))
    root.chmod(0o700)
    runs = root / "runs"
    runs.mkdir(mode=0o700)
    run_name = "20260902-123456-test_author"
    role = "TEST_AUTHOR"
    worktree = "/private/tmp/h039-reference-worktree"
    head = "91" * 20
    run = runs / run_name
    run.mkdir(mode=0o700)
    payload = b"H039-MANAGED-ENVELOPE\x00WITH-BINARY-BYTES\xff"
    envelope = run / "provider-envelope.json"
    envelope.write_bytes(payload)
    envelope.chmod(0o600)
    events = root / "events.jsonl"

    def write_events(
        *, selected_role: str = role,
        selected_worktree: str = worktree, selected_head: str = head,
        trailing: dict[str, Any] | None = None,
        extra_agent_field: tuple[str, Any] | None = None,
    ) -> None:
        agent_start = {
            "event": "AGENT_START", "head": selected_head,
            "model": "gpt-5.6-sol",
            "model_routing_source": "AUTOPILOT_ROLE_POLICY",
            "reasoning_effort": "max", "role": selected_role,
            "ts": "2026-09-02T10:34:57+00:00",
            "worktree": selected_worktree,
        }
        if extra_agent_field is not None:
            agent_start[extra_agent_field[0]] = extra_agent_field[1]
        records = [
            {"event": "BOOT", "ts": "2026-09-02T10:00:00+00:00"},
            agent_start,
        ]
        if trailing is not None:
            records.append(trailing)
        events.write_bytes(b"".join(canonical(record) + b"\n" for record in records))
        events.chmod(0o600)

    def rejects(action: Any, label: str) -> None:
        rejected = False
        try:
            action()
        except (OSError, Rig):
            rejected = True
        check(rejected, label)

    write_events()
    journal_root_fd = os.open(
        root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
        | getattr(os, "O_NOFOLLOW_ANY"),
    )
    journal_root_identity = retained_directory_identity(os.fstat(journal_root_fd))
    envelope_fd = os.open(
        envelope, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
        | getattr(os, "O_NOFOLLOW_ANY") | 0x00002000,
    )

    def prebind() -> dict[str, Any]:
        events_raw = events.read_bytes()
        return {
            "envelope_absolute": str(envelope),
            "envelope_identity": stable_identity(os.fstat(envelope_fd)),
            "envelope_length": len(payload), "envelope_sha256": sha(payload),
            "events_identity": stable_identity(os.lstat(events)),
            "events_length": len(events_raw), "events_sha256": sha(events_raw),
            "head": head, "journal_root_absolute": str(root),
            "journal_root_identity": journal_root_identity,
            "role": role, "run_identity": retained_directory_identity(os.lstat(run)),
            "run_name": run_name, "worktree": worktree,
        }

    active_binding = prebind()

    def refresh_binding() -> None:
        nonlocal active_binding
        active_binding = prebind()

    def load(
        *, after_read: Any = None, binding: dict[str, Any] | None = None,
    ) -> tuple[bytes, tuple[int, ...]]:
        return load_managed_envelope(
            journal_root_fd, envelope_fd,
            active_binding if binding is None else binding,
            after_read=after_read,
        )

    try:
        loaded, source_identity = load()
        check(loaded == payload, "A_H039_MANAGED_CURRENT_RUN_STABLE_ENVELOPE")

        original_read = os.read
        try:
            os.read = lambda descriptor, count: original_read(  # type: ignore[assignment]
                descriptor, min(count, 1),
            )
            fragmented_loaded, _fragmented_identity = load()
        finally:
            os.read = original_read  # type: ignore[assignment]
        check(
            fragmented_loaded == payload,
            "A_H039_MANAGED_COMPLETE_FRAGMENTED_READ",
        )

        wrong_length = dict(active_binding)
        wrong_length["envelope_length"] += 1
        rejects(lambda: load(binding=wrong_length), "N_H039_MANAGED_PREBOUND_LENGTH")
        wrong_digest = dict(active_binding)
        wrong_digest["envelope_sha256"] = "00" * 32
        rejects(lambda: load(binding=wrong_digest), "N_H039_MANAGED_PREBOUND_DIGEST")
        wrong_leaf_identity = dict(active_binding)
        wrong_leaf_identity["envelope_identity"] = (
            active_binding["envelope_identity"][0] + 1,
            *active_binding["envelope_identity"][1:],
        )
        rejects(
            lambda: load(binding=wrong_leaf_identity),
            "N_H039_MANAGED_PREBOUND_ENVELOPE_IDENTITY",
        )
        wrong_run_identity = dict(active_binding)
        wrong_run_identity["run_identity"] = (
            active_binding["run_identity"][0] + 1,
            *active_binding["run_identity"][1:],
        )
        rejects(
            lambda: load(binding=wrong_run_identity),
            "N_H039_MANAGED_PREBOUND_RUN_IDENTITY",
        )

        early_eof_calls = 0
        def injected_early_eof(descriptor: int, count: int) -> bytes:
            nonlocal early_eof_calls
            early_eof_calls += 1
            if early_eof_calls > 1:
                return b""
            return original_read(descriptor, min(count, 1))
        try:
            os.read = injected_early_eof  # type: ignore[assignment]
            rejects(load, "N_H039_MANAGED_PARTIAL_EARLY_EOF")
        finally:
            os.read = original_read  # type: ignore[assignment]

        wrong_root_binding = dict(active_binding)
        wrong_root_binding["journal_root_identity"] = (
            journal_root_identity[0] + 1, *journal_root_identity[1:],
        )
        rejects(
            lambda: load(binding=wrong_root_binding),
            "N_H039_MANAGED_WRONG_RETAINED_ROOT_IDENTITY",
        )
        wrong_root_path = dict(active_binding)
        wrong_root_path["journal_root_absolute"] = "/private/tmp/wrong-journal-root"
        rejects(
            lambda: load(binding=wrong_root_path),
            "N_H039_MANAGED_WRONG_RETAINED_ROOT_PATH",
        )
        wrong_envelope_path = dict(active_binding)
        wrong_envelope_path["envelope_absolute"] = str(run / "wrong-envelope.json")
        rejects(
            lambda: load(binding=wrong_envelope_path),
            "N_H039_MANAGED_WRONG_RETAINED_ENVELOPE_PATH",
        )
        boolean_identity = dict(active_binding)
        boolean_identity["envelope_identity"] = (
            True, *active_binding["envelope_identity"][1:],
        )
        rejects(
            lambda: load(binding=boolean_identity),
            "N_H039_MANAGED_BOOLEAN_IDENTITY_ALIAS",
        )
        events.chmod(0o666)
        rejects(load, "N_H039_MANAGED_UNSAFE_EVENTS_MODE")
        write_events()
        refresh_binding()
        write_events(extra_agent_field=("envelope_sha256", "00" * 32))
        rejects(load, "N_H039_MANAGED_UNAUTHORIZED_EXPANDED_AGENT_START")
        write_events()
        refresh_binding()
        write_events(selected_role="BUILDER")
        rejects(load, "N_H039_MANAGED_STALE_AGENT_START_ROLE")
        write_events()
        refresh_binding()
        write_events(selected_worktree="/private/tmp/stale-worktree")
        rejects(load, "N_H039_MANAGED_STALE_AGENT_START_WORKTREE")
        write_events()
        refresh_binding()
        write_events(selected_head="92" * 20)
        rejects(load, "N_H039_MANAGED_STALE_AGENT_START_HEAD")
        write_events()
        refresh_binding()
        write_events(trailing={"event": "OTHER", "ts": "later"})
        rejects(load, "N_H039_MANAGED_AGENTS_START_NOT_CURRENT")
        write_events()
        refresh_binding()

        envelope.chmod(0o644)
        refresh_binding()
        loaded_0644, _identity_0644 = load()
        check(loaded_0644 == payload, "A_H039_MANAGED_EXISTING_0644_ENVELOPE")
        envelope.chmod(0o666)
        rejects(load, "N_H039_MANAGED_UNSAFE_MODE")
        envelope.chmod(0o600)
        refresh_binding()
        alias = run / "hardlink"
        os.link(envelope, alias)
        rejects(load, "N_H039_MANAGED_HARDLINK")
        alias.unlink()
        refresh_binding()
        retained_leaf = run / "retained-envelope"
        envelope.rename(retained_leaf)
        envelope.symlink_to(retained_leaf.name)
        rejects(load, "N_H039_MANAGED_LEAF_SYMLINK")
        envelope.unlink()
        retained_leaf.rename(envelope)
        refresh_binding()

        retained_run = runs / "retained-run"
        run.rename(retained_run)
        run.symlink_to(retained_run.name)
        rejects(load, "N_H039_MANAGED_ANCESTOR_SYMLINK")
        run.unlink()
        retained_run.rename(run)
        refresh_binding()

        original = envelope.read_bytes()
        rejects(
            lambda: load(after_read=lambda: envelope.write_bytes(b"Z" + original[1:])),
            "N_H039_MANAGED_SAME_SIZE_MUTATION",
        )
        envelope.write_bytes(original)
        envelope.chmod(0o600)
        write_events()
        refresh_binding()
        rejects(
            lambda: load(after_read=lambda: envelope.write_bytes(original + b"GROWTH")),
            "N_H039_MANAGED_GROWTH_DURING_READ",
        )
        envelope.write_bytes(original)
        envelope.chmod(0o600)
        write_events()
        refresh_binding()

        replacement = run / "replacement"
        replacement.write_bytes(payload)
        replacement.chmod(0o600)
        held = run / "held"
        envelope.rename(held)
        replacement.rename(envelope)
        rejects(load, "N_H039_MANAGED_PREOPEN_REPLAY_SUBSTITUTION")
        envelope.unlink()
        held.rename(envelope)
        refresh_binding()
        replacement.write_bytes(payload)
        replacement.chmod(0o600)
        def replace_leaf() -> None:
            envelope.rename(held)
            replacement.rename(envelope)
        rejects(
            lambda: load(after_read=replace_leaf),
            "N_H039_MANAGED_NAME_REPLACEMENT",
        )
        envelope.unlink()
        held.rename(envelope)
        write_events()
        refresh_binding()

        oversized = b"X" * 1048577
        envelope.write_bytes(oversized)
        envelope.chmod(0o600)
        write_events()
        rejects(load, "N_H039_MANAGED_OVERSIZE")
        envelope.write_bytes(payload)
        envelope.chmod(0o600)
        write_events()
        refresh_binding()
        loaded, source_identity = load()
        os.close(envelope_fd)
        envelope_fd = -1
        os.close(journal_root_fd)
        journal_root_fd = -1

        script = (
            "import hashlib,json,os;raw=b''\n"
            "while True:\n c=os.read(0,65536)\n if not c: break\n raw+=c\n"
            "p=os.fork()\n"
            "if p:\n os.waitpid(p,0);os._exit(0)\n"
            "os.setsid();p=os.fork()\n"
            "if p: os._exit(0)\n"
            "fds=[]\n"
            "for n in os.listdir('/dev/fd'):\n"
            " try:\n  fd=int(n);st=os.fstat(fd)\n"
            " except (ValueError,OSError): continue\n"
            " if fd>=3: fds.append([fd,st.st_dev,st.st_ino])\n"
            "out={'sha256':hashlib.sha256(raw).hexdigest(),'length':len(raw),"
            "'kuvert':'NORTROPIC_KUVERT' in os.environ,'source_path':any('envelope' in v for v in os.environ.values()),'fds':fds}\n"
            "os.write(1,(json.dumps(out,sort_keys=True,separators=(',',':'))+'\\n').encode());os._exit(0)\n"
        )
        target = subprocess.run(
            [sys.executable, "-I", "-S", "-B", "-c", script], input=loaded,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, close_fds=True,
            cwd="/", env={"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
            timeout=10, check=False,
        )
        proof = strict_json(target.stdout.strip())
        source_seen = any(
            tuple(item[1:]) == source_identity[:2]
            for item in proof.get("fds", []) if isinstance(item, list) and len(item) == 3
        ) if isinstance(proof, dict) else True
        check(
            target.returncode == 0 and target.stderr == b""
            and isinstance(proof, dict) and proof.get("sha256") == sha(payload)
            and proof.get("length") == len(payload) and proof.get("kuvert") is False
            and proof.get("source_path") is False and not source_seen,
            "A_H039_MANAGED_STDIN_DOUBLE_FORK_SETSID_ZERO_SOURCE_LEAK",
            {"rc": target.returncode, "stderr": target.stderr.decode("utf-8", "replace"),
             "proof": proof, "source_seen": source_seen},
        )

        workspace = root / "workspace"
        descendant = workspace / "child" / "grandchild"
        descendant.mkdir(parents=True, mode=0o700)
        workspace.chmod(0o700)
        (workspace / "child").chmod(0o700)
        descendant.chmod(0o700)
        workspace_fd = os.open(
            workspace, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
            | getattr(os, "O_NOFOLLOW_ANY"),
        )
        workspace_identity = retained_directory_identity(os.fstat(workspace_fd))
        allowed_root = open_managed_cwd(
            workspace_fd, workspace_identity, str(workspace), str(workspace),
        )
        allowed_descendant = open_managed_cwd(
            workspace_fd, workspace_identity, str(workspace), str(descendant),
        )
        check(
            stat.S_ISDIR(os.fstat(allowed_root).st_mode)
            and stat.S_ISDIR(os.fstat(allowed_descendant).st_mode)
            and not (workspace / "session-top").exists(),
            "A_H039_MANAGED_CWD_PRIVATE_ANCESTOR_EQUAL_OR_DESCENDANT",
        )
        close_all((allowed_root, allowed_descendant))
        sibling = root / "sibling"
        sibling.mkdir(mode=0o700)
        rejects(lambda: close_all((open_managed_cwd(
            workspace_fd, workspace_identity, str(workspace), str(sibling),
        ),)),
                "N_H039_MANAGED_CWD_SIBLING")
        rejects(lambda: close_all((open_managed_cwd(
            workspace_fd, workspace_identity, str(workspace),
            str(descendant / ".."),
        ),)),
                "N_H039_MANAGED_CWD_NONCANONICAL_DOTDOT")
        symlink = workspace / "linked"
        symlink.symlink_to(descendant)
        rejects(lambda: close_all((open_managed_cwd(
            workspace_fd, workspace_identity, str(workspace), str(symlink),
        ),)),
                "N_H039_MANAGED_CWD_SYMLINK")
        original_descendant_identity = retained_directory_identity(descendant.stat())
        retained_workspace = root / "retained-workspace"
        workspace.rename(retained_workspace)
        replacement_descendant = workspace / "child" / "grandchild"
        replacement_descendant.mkdir(parents=True, mode=0o700)
        workspace.chmod(0o700)
        (workspace / "child").chmod(0o700)
        replacement_descendant.chmod(0o700)
        retained_result = open_managed_cwd(
            workspace_fd, workspace_identity, str(workspace), str(descendant),
        )
        check(
            retained_directory_identity(os.fstat(retained_result))
            == original_descendant_identity,
            "A_H039_MANAGED_CWD_RETAINED_CAPABILITY_NO_PATH_REOPEN",
        )
        os.close(retained_result)
        shutil.rmtree(workspace)
        retained_workspace.rename(workspace)
        os.close(workspace_fd)
    finally:
        close_all((locals().get("workspace_fd", -1), envelope_fd, journal_root_fd))
        shutil.rmtree(root)


def fd_relative_integration_reference() -> None:
    """Prove final-path portal, helper-only hidden FD and zero envelope leak."""
    if sys.platform != "darwin" or not Path("/usr/bin/sandbox-exec").is_file():
        raise Undecidable("Darwin sandbox-exec host required for FD-relative reference")
    root = Path(tempfile.mkdtemp(prefix="h39-", dir="/private/tmp"))
    active = root / "a"
    compound = active / ("o-" + "ab" * 16)
    portal = compound / "p"
    hidden = compound / "h"
    runtime_object = hidden / "r"
    active.mkdir(mode=0o700)
    compound.mkdir(mode=0o700)
    portal.mkdir(mode=0o700)
    hidden.mkdir(mode=0o700)
    runtime_object.mkdir(mode=0o700)
    executable = portal / "python"
    python_source = Path(
        "/opt/homebrew/Cellar/python@3.12/3.12.13_4/Frameworks/"
        "Python.framework/Versions/3.12/Resources/Python.app/Contents/MacOS/Python"
    )
    source_fd = -1
    try:
        source_fd = os.open(
            python_source,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
            | getattr(os, "O_NOFOLLOW_ANY") | 0x00002000,
        )
        python_stat = os.fstat(source_fd)
        source_identity = stable_identity(python_stat)
        chunks: list[bytes] = []
        total = 0
        while total <= 33568:
            chunk = os.read(source_fd, min(65536, 33569 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        python_bytes = b"".join(chunks)
        rebound = os.lstat(python_source)
        if (
            stable_identity(os.fstat(source_fd)) != source_identity
            or stable_identity(rebound) != source_identity
            or sha(python_bytes)
            != "9ea12d11e0573548d6d8b0added1740b2d6377366081dbca05c19746ce7c616e"
            or not stat.S_ISREG(python_stat.st_mode)
            or python_stat.st_uid != CLIENT_UID or python_stat.st_gid != 80
            or stat.S_IMODE(python_stat.st_mode) != 0o755
            or python_stat.st_nlink != 1 or python_stat.st_size != 33568
            or len(python_bytes) != 33568
        ):
            raise Undecidable("published H036 Python app identity unavailable")
    except Undecidable:
        shutil.rmtree(root)
        raise
    except OSError as exc:
        shutil.rmtree(root)
        raise Undecidable("published H036 Python app stable open unavailable") from exc
    finally:
        close_all((source_fd,))
    executable.write_bytes(python_bytes)
    executable.chmod(0o555)
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    socket_path = portal / "c"
    try:
        listener.bind(str(socket_path))
    except OSError as exc:
        listener.close()
        shutil.rmtree(root)
        if exc.errno == errno.EPERM:
            raise Undecidable("outer sandbox denied AF_UNIX reference bind") from exc
        raise
    listener.listen(1)
    listener.settimeout(10)
    os.chown(socket_path, -1, CLIENT_GID)
    socket_path.chmod(0o620)
    portal.chmod(0o555)
    compound.chmod(0o555)
    active.chmod(0o555)
    directory_fd = os.open(
        runtime_object, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    portal.chmod(0o550)
    try:
        production_socket = NAMESPACE / "a" / ("o-" + "ab" * 16) / "p" / "c"
        check(
            listener.getsockname() == str(socket_path)
            and len(os.fsencode(production_socket)) == 85
            and len(os.fsencode(production_socket)) < 104
            and sorted(path.name for path in portal.iterdir()) == ["c", "python"],
            "A_H039_FINAL_ACTIVE_SOCKET_IDENTITY_AND_SUN_PATH_BUDGET",
            {"getsockname": listener.getsockname(),
             "production_length": len(os.fsencode(production_socket))},
        )
        hidden.chmod(0)
        direct_denied = False
        try:
            os.open(runtime_object / "direct", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except PermissionError:
            direct_denied = True
        proof_fd = os.open(
            "controller-openat", os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600, dir_fd=directory_fd,
        )
        os.write(proof_fd, b"CONTROLLER-OPENAT")
        os.close(proof_fd)

        profile = (
            "(version 1)\n(allow default)\n"
            f'(deny file-read* (subpath "{hidden}"))\n'
            f'(deny file-write* (subpath "{hidden}"))\n'
        )
        helper_script = (
            "import errno,os,sys;"
            "fd=int(sys.argv[1]);result='OPEN';"
            "\ntry: os.open('helper-seatbelt',os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600,dir_fd=fd)\n"
            "except OSError as e: result='EPERM' if e.errno==errno.EPERM else 'ERR'+str(e.errno)\n"
            "print(result)"
        )
        helper = subprocess.run(
            ["/usr/bin/sandbox-exec", "-p", profile, str(executable),
             "-I", "-S", "-B", "-c", helper_script, str(directory_fd)],
            pass_fds=(directory_fd,), close_fds=True,
            env={"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=10, check=False,
        )
        if helper.returncode != 0 and b"sandbox_apply: Operation not permitted" in helper.stderr:
            raise Undecidable("outer Seatbelt denied nested sandbox reference")
        check(
            direct_denied and helper.returncode == 0
            and helper.stdout == b"EPERM\n" and helper.stderr == b"",
            "A_H039_HELPER_ONLY_HIDDEN_DIRFD_SEATBELT_EPERM",
            {"direct_denied": direct_denied, "rc": helper.returncode,
             "stdout": helper.stdout.decode("utf-8", "replace"),
             "stderr": helper.stderr.decode("utf-8", "replace")},
        )

        hidden_stat = os.fstat(directory_fd)
        script = (
            "import errno,os,socket,sys;"
            "p=sys.argv[1];dev=int(sys.argv[2]);ino=int(sys.argv[3]);"
            "s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.connect(p);"
            "s.sendall(b'H039-PORTAL');reply=s.recv(32);s.close();"
            "seen=False;"
            "\nfor fd in range(3,256):\n"
            " try:\n  st=os.fstat(fd);seen=seen or (st.st_dev==dev and st.st_ino==ino)\n"
            " except OSError: pass\n"
            "print('CONNECTED|'+('LEAK' if seen else 'NOHIDDEN')+'|'+reply.decode()+'|'+"
            "('NO_KUVERT' if 'NORTROPIC_KUVERT' not in os.environ else 'KUVERT_LEAK'))"
        )
        process = subprocess.Popen(
             ["/usr/bin/sandbox-exec", "-p", profile, str(executable),
             "-I", "-S", "-B", "-c", script, str(socket_path),
             str(hidden_stat.st_dev), str(hidden_stat.st_ino)],
            close_fds=True,
            env={"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        ready, _writable, _exceptional = select.select([listener], [], [], 10)
        if not ready:
            stdout, stderr = process.communicate(timeout=2)
            raise Rig(
                "confined portal target did not connect "
                f"rc={process.returncode} stdout={stdout!r} stderr={stderr!r}"
            )
        connection, _address = listener.accept()
        try:
            request = connection.recv(32)
            accepted_local = connection.getsockname()
            connection.sendall(b"PORTAL-ACK")
        finally:
            connection.close()
        stdout, stderr = process.communicate(timeout=10)
        if process.returncode != 0 and b"sandbox_apply: Operation not permitted" in stderr:
            raise Undecidable("outer Seatbelt denied nested target reference")
        check(
            process.returncode == 0 and request == b"H039-PORTAL"
            and accepted_local == str(socket_path)
            and stdout == b"CONNECTED|NOHIDDEN|PORTAL-ACK|NO_KUVERT\n"
            and stderr == b"",
            "A_H039_PORTAL_RECONNECT_ZERO_HIDDEN_OR_KUVERT_LEAK",
            {"accepted_local": accepted_local, "rc": process.returncode,
             "stdout": stdout.decode("utf-8", "replace"),
             "stderr": stderr.decode("utf-8", "replace")},
        )
    finally:
        hidden.chmod(0o700)
        portal.chmod(0o700)
        compound.chmod(0o700)
        active.chmod(0o700)
        os.close(directory_fd)
        listener.close()
        shutil.rmtree(root)



def raw_changes(old: str, new: str) -> list[tuple[str, str, str, str]]:
    raw = git(["diff-tree", "-r", "--no-commit-id", "--no-renames", "-z", "--raw", old, new])
    records = raw.split(b"\0")
    if records[-1:] != [b""]:
        raise Rig("unterminated diff-tree output")
    records.pop()
    out: list[tuple[str, str, str, str]] = []
    index = 0
    while index < len(records):
        header = records[index]
        index += 1
        if index >= len(records):
            raise Rig("missing diff path")
        path_raw = records[index]
        index += 1
        try:
            path = path_raw.decode("utf-8")
            fields = header.decode("ascii").split()
        except UnicodeError as exc:
            raise Rig(f"invalid diff encoding: {exc}") from exc
        if len(fields) != 5 or not fields[0].startswith(":"):
            raise Rig(f"invalid raw diff header: {header!r}")
        old_mode = fields[0][1:]
        new_mode = fields[1]
        status_code = fields[4]
        if status_code not in {"A", "M"} or "\n" in path or "\\" in path:
            raise Rig("invalid path/status in raw diff")
        out.append((path, old_mode, new_mode, status_code))
    return out


def line_delta(old: str, new: str) -> tuple[int, int]:
    raw = git(["diff", "--numstat", "--no-renames", old, new]).decode("utf-8")
    additions = 0
    deletions = 0
    for line in raw.splitlines():
        added, deleted, _path = line.split("\t", 2)
        if added != "-":
            additions += int(added)
        if deleted != "-":
            deletions += int(deleted)
    return additions, deletions


def exact_contract_change_shape(changes: list[tuple[str, str, str, str]]) -> bool:
    return changes == [
        (
            path,
            "100755" if path == "verify/bin/h-039-exit" else "100644",
            "100755" if path == "verify/bin/h-039-exit" else "100644",
            "M",
        )
        for path in TEST_AUTHOR_GIT_ORDER
    ]


def exact_product_change_shape(changes: list[tuple[str, str, str, str]]) -> bool:
    return changes == [
        (path, PRODUCT_MODES[path], PRODUCT_MODES[path], "M")
        for path in PRODUCT_GIT_ORDER
    ]


def exact_contract_merge(base: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(base)
        if len(parents) != 2:
            return False, {"parents": parents}
        authority, candidate = parents
        candidate_parents = commit_parents(candidate)
        changes = raw_changes(authority, candidate)
        ok = (
            authority == CONTRACT_AUTHORITY_BASE
            and candidate_parents == [CONTRACT_AUTHORITY_BASE]
            and commit_tree(base) == commit_tree(candidate)
            and exact_contract_change_shape(changes)
        )
        return ok, {"parents": parents, "candidate_parents": candidate_parents,
                    "changes": changes, "tree": commit_tree(base)}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc)}


def product_identity(
    base: str, candidate: str, *, require_checkout: bool = True,
    require_contract_publication: bool = True,
) -> tuple[bool, dict[str, Any]]:
    merge_ok, merge_detail = exact_contract_merge(base)
    try:
        parents = commit_parents(candidate)
        changes = raw_changes(base, candidate)
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status = git(["status", "--porcelain=v1", "--untracked-files=all"])
        frozen_equal = all(
            blob(candidate, path) == blob(base, path)
            for path in ("specs/tasks.spec.json", "verify/bin/h-039-exit",
                         "specs/owner-production-paths.v1.json",
                         "verify/h039/runtime-cleanup-mediator")
        )
        product_sizes = {
            path: blob_size(candidate, path) for path in PRODUCT_PATHS
        }
        added_lines, deleted_lines = line_delta(base, candidate)
        bounded_product = (
            all(product_sizes[path] <= PRODUCT_BYTE_LIMITS[path]
                for path in PRODUCT_PATHS)
            and sum(product_sizes.values()) <= MAX_AGGREGATE_PRODUCT_BYTES
        )
        remote_main = observed_production_main() \
            if require_contract_publication else None
        ok = (
            merge_ok and parents == [base]
            and exact_product_change_shape(changes)
            and added_lines <= MAX_ADDED_LINES
            and deleted_lines <= MAX_DELETED_LINES
            and frozen_equal and bounded_product
            and (not require_contract_publication or remote_main == base)
            and (not require_checkout or (head == candidate and status == b""))
        )
        return ok, {"merge": merge_detail, "parents": parents,
                    "changes": changes, "head": head, "status": status.decode(),
                    "frozen_equal": frozen_equal, "product_sizes": product_sizes,
                    "bounded_product": bounded_product, "added_lines": added_lines,
                    "deleted_lines": deleted_lines, "remote_main": remote_main}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "merge": merge_detail}


def product_publication_identity(merge: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(merge)
        if len(parents) != 2:
            return False, {"parents": parents}
        contract_merge, candidate = parents
        product_ok, product_detail = product_identity(
            contract_merge, candidate, require_checkout=False,
            require_contract_publication=False,
        )
        remote_main = observed_production_main()
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status = git(["status", "--porcelain=v1", "--untracked-files=all"])
        executing_bytes_equal = (
            SPEC.read_bytes() == blob(merge, "specs/tasks.spec.json")
            and GATE.read_bytes() == blob(merge, "verify/bin/h-039-exit")
        )
        ok = (
            product_ok and commit_tree(merge) == commit_tree(candidate)
            and remote_main == merge and head == merge and status == b""
            and executing_bytes_equal
        )
        return ok, {
            "parents": parents, "tree": commit_tree(merge),
            "candidate_tree": commit_tree(candidate), "remote_main": remote_main,
            "head": head, "status": status.decode(),
            "executing_bytes_equal": executing_bytes_equal, "product": product_detail,
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc)}


def product_bytes(path: str, commit: str | None) -> bytes:
    limit = PRODUCT_BYTE_LIMITS[path]
    if commit is not None:
        size = blob_size(commit, path)
        if size > limit:
            raise Rig(f"product blob exceeds frozen byte limit: {path}")
        raw = blob(commit, path)
    else:
        value = os.lstat(ROOT / path)
        if not stat.S_ISREG(value.st_mode) or value.st_size > limit:
            raise Rig(f"checkout product exceeds frozen byte limit: {path}")
        raw = (ROOT / path).read_bytes()
    if len(raw) > limit:
        raise Rig(f"product read exceeds frozen byte limit: {path}")
    return raw


def manifest_checks(
    commit: str | None = None, *, r13_product: bool = True,
    diagnostic_product: bool = False,
) -> tuple[dict[str, Any], dict[str, Any]]:
    recipe_raw = product_bytes("verify/h039/build-recipe.json", commit)
    manifest_raw = product_bytes("verify/h039/identity-manifest.json", commit)
    source_raw = product_bytes("controller/runtime-cleanup/native/mediator.c", commit)
    mediator_raw = product_bytes("verify/h039/runtime-cleanup-mediator", commit)
    installer_raw = product_bytes("controller/runtime-cleanup/install", commit)
    recipe = strict_json(recipe_raw)
    manifest = strict_json(manifest_raw)
    mediator_digest = sha(mediator_raw)
    mediator_size = len(mediator_raw)
    compiler = "/Library/Developer/CommandLineTools/usr/bin/clang"
    sdk = "/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk"
    common_compile = [
        compiler, "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
        "-fstack-protector-strong", "-D_FORTIFY_SOURCE=2", "-arch", "arm64",
        "-isysroot", sdk, "-mmacosx-version-min=15.0", "-Wl,-pie",
        "-Wl,-dead_strip",
    ]
    expected_recipe = {
        "codesign_path": "/usr/bin/codesign",
        "codesign_sha256": "9755ad3afc25a3ce6f8c281425ff732a5819f0b973846b7641a11892a2081abc",
        "compiler_path": compiler,
        "compiler_sha256": "f30550eab15fdf5ab8c0dc54c52679711241e5d4b636b027e18c09fef531775d",
        "compiler_version": "Apple clang version 21.0.0 (clang-2100.1.1.101)",
        "installer_compile_argv": [
            *common_compile,
            *(["-Wno-unused-function"] if diagnostic_product else []),
            "-DH039_INSTALLER=1",
            *(["-DH039_ROOT_ENTRY_FD0_NORMALIZATION=1"] if r13_product else []),
            *(["-DH039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC=1"]
              if diagnostic_product else []),
            f"-DH039_MEDIATOR_SHA256={mediator_digest}",
            f"-DH039_MEDIATOR_SIZE={mediator_size}",
            "-Wl,-segprot,__H039RO,r,r",
            "-Wl,-sectcreate,__H039RO,__h039med,verify/h039/runtime-cleanup-mediator",
            "controller/runtime-cleanup/native/mediator.c",
            "-o", "controller/runtime-cleanup/install",
        ],
        "installer_sign_argv": [
            "/usr/bin/codesign", "--force", "--options", "runtime", "--sign", "-",
            "--identifier", "se.nortropic.runtime-cleanup-installer", "--timestamp=none",
            "controller/runtime-cleanup/install",
        ],
        "language": "C", "schema_version": 1,
        "mediator_compile_argv": [
            *common_compile,
            "controller/runtime-cleanup/native/mediator.c",
            "-o", "verify/h039/runtime-cleanup-mediator",
        ],
        "mediator_sign_argv": [
            "/usr/bin/codesign", "--force", "--options", "runtime", "--sign", "-",
            "--identifier", "se.nortropic.runtime-cleanup-mediator", "--timestamp=none",
            "verify/h039/runtime-cleanup-mediator",
        ],
        "sdk_path": sdk,
        "sdk_settings_sha256": "f8d005f09381389167f9e0aeaa169bc9e7dff162ef22ca2fd8e98df7ff1acafe",
        "sdk_version": "26.5",
        "source_mode": "100644",
    }
    if not isinstance(recipe, dict) \
            or type(recipe.get("schema_version")) is not int \
            or recipe != expected_recipe:
        raise Rig("build recipe mismatch")
    required = {
        "schema_version", "artifact_path", "artifact_sha256", "source_sha256",
        "installer_path", "installer_sha256", "recipe_sha256",
        "installer_size", "embedded_mediator_section",
        "embedded_mediator_sha256", "embedded_mediator_size",
        "bootstrap_installer_path", "bootstrap_operation",
        "mediator_codesign_cdhash", "installer_codesign_cdhash",
        "mediator_lc_uuid", "installer_lc_uuid", "platform", "minos", "sdk",
        "mediator_dependencies", "installer_dependencies", "installed_path",
        "installed_uid", "installed_gid", "installed_mode", "namespace_path",
        "namespace_uid", "namespace_gid", "namespace_mode", "authorized_client_uid",
        "authorized_client_gid", "private_python_source",
        "private_python_source_sha256", "namespace_children",
        "state_fixed_entries", "compiler_version", "sdk_version",
        "sdk_settings_sha256", "source_mode", "zero_entitlements",
    }
    if not isinstance(manifest, dict) or set(manifest) != required:
        raise Rig("identity manifest key mismatch")
    integer_manifest_keys = {
        "schema_version", "installed_uid", "installed_gid", "namespace_uid",
        "namespace_gid", "authorized_client_uid", "authorized_client_gid",
        "installer_size", "embedded_mediator_size",
    }
    if any(type(manifest.get(key)) is not int for key in integer_manifest_keys) \
            or manifest.get("zero_entitlements") is not True:
        raise Rig("identity manifest integer/boolean type mismatch")
    exact = {
        "schema_version": 1,
        "artifact_path": "verify/h039/runtime-cleanup-mediator",
        "artifact_sha256": mediator_digest,
        "source_sha256": sha(source_raw),
        "installer_path": "controller/runtime-cleanup/install",
        "installer_sha256": sha(installer_raw),
        "installer_size": len(installer_raw),
        "embedded_mediator_section": "__H039RO,__h039med",
        "embedded_mediator_sha256": mediator_digest,
        "embedded_mediator_size": mediator_size,
        "bootstrap_installer_path": str(PROTECTED_INSTALLER),
        "bootstrap_operation": "bootstrap",
        "recipe_sha256": sha(recipe_raw),
        "installed_path": str(INSTALLED), "installed_uid": 0, "installed_gid": 0,
        "installed_mode": "04555", "namespace_path": str(NAMESPACE),
        "namespace_uid": 0, "namespace_gid": 0, "namespace_mode": "0555",
        "authorized_client_uid": CLIENT_UID, "authorized_client_gid": CLIENT_GID,
        "private_python_source": (
            "/opt/homebrew/Cellar/python@3.12/3.12.13_4/Frameworks/Python.framework/"
            "Versions/3.12/Resources/Python.app/Contents/MacOS/Python"
        ),
        "private_python_source_sha256": (
            "9ea12d11e0573548d6d8b0added1740b2d6377366081dbca05c19746ce7c616e"
        ),
        "namespace_children": LAYOUT,
        "state_fixed_entries": ["lock"],
        "compiler_version": expected_recipe["compiler_version"],
        "sdk_version": expected_recipe["sdk_version"],
        "sdk_settings_sha256": expected_recipe["sdk_settings_sha256"],
        "source_mode": "100644", "zero_entitlements": True,
    }
    if any(manifest.get(key) != value for key, value in exact.items()):
        raise Rig("identity manifest exact value mismatch")
    for key in (
        "artifact_sha256", "source_sha256", "installer_sha256", "recipe_sha256",
        "embedded_mediator_sha256",
    ):
        if not valid_hex(manifest.get(key)):
            raise Rig(f"manifest digest malformed: {key}")
    if installer_raw.count(mediator_raw) != 1:
        raise Rig("installer does not contain exactly one byte-exact mediator image")
    for key in ("mediator_codesign_cdhash", "installer_codesign_cdhash"):
        if not valid_hex(manifest.get(key), 40):
            raise Rig(f"manifest CDHash malformed: {key}")
    for key in ("mediator_lc_uuid", "installer_lc_uuid"):
        if not isinstance(manifest.get(key), str) or re.fullmatch(
            r"[0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12}", manifest[key],
        ) is None:
            raise Rig(f"manifest UUID malformed: {key}")
    for key in ("mediator_dependencies", "installer_dependencies"):
        dependencies = manifest.get(key)
        if not isinstance(dependencies, list) or not dependencies or any(
            not isinstance(value, str)
            or not value.startswith(("/usr/lib/", "/System/Library/Frameworks/"))
            for value in dependencies
        ):
            raise Rig(f"non-Apple dependency: {key}")
    compiler_path = Path(expected_recipe["compiler_path"])
    sdk_path = Path(expected_recipe["sdk_path"])
    codesign_path = Path(expected_recipe["codesign_path"])
    try:
        observed_compiler = tool(["/usr/bin/xcrun", "--find", "clang"]).decode().strip()
        observed_sdk = Path(
            tool(["/usr/bin/xcrun", "--sdk", "macosx", "--show-sdk-path"])
            .decode().strip()
        ).resolve()
        observed_version = tool([str(compiler_path), "--version"]).decode().splitlines()[0]
    except (OSError, Rig, IndexError) as exc:
        raise Undecidable(f"pinned Apple build toolchain unavailable: {exc}") from exc
    if (
        observed_compiler != str(compiler_path) or observed_sdk != sdk_path
        or observed_version != expected_recipe["compiler_version"]
        or path_sha(compiler_path) != expected_recipe["compiler_sha256"]
        or path_sha(sdk_path / "SDKSettings.json")
        != expected_recipe["sdk_settings_sha256"]
        or path_sha(codesign_path) != expected_recipe["codesign_sha256"]
    ):
        raise Undecidable("pinned Apple build toolchain identity drift")
    return recipe, manifest


def bounded_run(
    argv: list[str], *, cwd: str | Path, env: dict[str, str], timeout: float,
) -> subprocess.CompletedProcess[bytes]:
    process = subprocess.Popen(
        argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, close_fds=True, cwd=cwd, env=env,
        start_new_session=True,
    )
    assert process.stdout is not None and process.stderr is not None
    selector = selectors.DefaultSelector()
    buffers = {process.stdout.fileno(): bytearray(), process.stderr.fileno(): bytearray()}
    streams = {process.stdout.fileno(): process.stdout, process.stderr.fileno(): process.stderr}
    for descriptor in streams:
        os.set_blocking(descriptor, False)
        selector.register(descriptor, selectors.EVENT_READ)
    deadline = time.monotonic() + timeout
    failure: str | None = None
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                failure = "timeout"
                break
            for key, _mask in selector.select(min(0.1, remaining)):
                descriptor = int(key.fd)
                try:
                    chunk = os.read(descriptor, 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(descriptor)
                    continue
                buffers[descriptor].extend(chunk)
                if sum(len(value) for value in buffers.values()) > MAX_CHILD_OUTPUT_BYTES:
                    failure = "output limit"
                    break
            if failure is not None:
                break
        if failure is None:
            remaining = deadline - time.monotonic()
            try:
                returncode = process.wait(timeout=max(0.0, remaining))
            except subprocess.TimeoutExpired:
                failure = "timeout"
        if failure is not None:
            try:
                if os.getpgid(process.pid) != process.pid:
                    raise Rig("candidate child is not its registered process-group leader")
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired as exc:
                raise Rig("candidate process group could not be reaped") from exc
            raise Rig(f"candidate process exceeded {failure}")
        return subprocess.CompletedProcess(
            argv, returncode,
            bytes(buffers[process.stdout.fileno()]),
            bytes(buffers[process.stderr.fileno()]),
        )
    finally:
        selector.close()
        process.stdout.close()
        process.stderr.close()


def seatbelt_profile_selftests() -> None:
    """Causally bind the two deny-default host-runtime profiles."""
    expected_host_files = (
        (SANDBOX_EXEC, SANDBOX_EXEC_SHA256, 0o755, "sandbox-exec"),
        (SEATBELT_WRITE_PROBE, SEATBELT_WRITE_PROBE_SHA256, 0o755, "touch"),
        (SEATBELT_EXEC_DENY_PROBE, SEATBELT_EXEC_DENY_PROBE_SHA256, 0o755, "echo"),
        (SEATBELT_READ_PROBE, SEATBELT_READ_PROBE_SHA256, 0o755, "ls"),
        (SEATBELT_NETWORK_PROBE, SEATBELT_NETWORK_PROBE_SHA256, 0o555, "nc"),
        (BUILD_COMPILER, BUILD_COMPILER_SHA256, 0o755, "clang"),
        (BUILD_CODESIGN, BUILD_CODESIGN_SHA256, 0o755, "codesign"),
        (
            BUILD_SDK / "SDKSettings.json", BUILD_SDK_SETTINGS_SHA256,
            0o644, "SDKSettings.json",
        ),
    )
    for path, digest, mode, label in expected_host_files:
        try:
            value = os.lstat(path)
        except OSError as exc:
            raise Undecidable(f"pinned build-review {label} unavailable") from exc
        if (
            not stat.S_ISREG(value.st_mode) or value.st_uid != 0
            or value.st_gid != 0 or stat.S_IMODE(value.st_mode) != mode
            or value.st_nlink != 1 or path.is_symlink() or path_sha(path) != digest
        ):
            raise Undecidable(f"pinned build-review {label} identity drift")
    check(True, "A_H039_SEATBELT_PROFILE_PINNED_HOST_IDENTITIES")

    temporary = Path(tempfile.mkdtemp(prefix="h039-seatbelt-selftest-", dir="/private/tmp"))
    project = temporary / "project"
    project.mkdir(mode=0o700)
    installer_test_root = temporary / "installer-review-root"
    installer_test_root.mkdir(mode=0o700)
    installer_enumeration = installer_test_root / "enumeration"
    installer_enumeration.mkdir(mode=0o700)
    (installer_enumeration / "alpha").write_bytes(b"H039-ALPHA\n")
    (installer_enumeration / "beta").write_bytes(b"H039-BETA\n")
    installer_outside = temporary / "outside-review-root"
    installer_outside.mkdir(mode=0o700)
    installer_outside_secret = installer_outside / "outside-secret"
    installer_outside_secret.write_bytes(b"H039-OUTSIDE-SECRET\n")
    installer_fixture = temporary / "mediator-fixture"
    installer_fixture.write_bytes(b"H039-INSTALLER-MEDIATOR-FIXTURE\n")
    installer_fixture.chmod(0o600)
    listener: socket.socket | None = None

    def no_sigabrt(result: subprocess.CompletedProcess[bytes]) -> bool:
        return result.returncode not in {-signal.SIGABRT, 128 + signal.SIGABRT}

    def nested_refusal(result: subprocess.CompletedProcess[bytes], label: str) -> None:
        if result.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in result.stderr:
            raise Undecidable(f"outer Seatbelt denied nested {label} sandbox")

    def build_argv(executable: Path, arguments: list[str]) -> list[str]:
        return [
            str(SANDBOX_EXEC),
            "-D", f"H039_BUILD_EXECUTABLE={executable}",
            "-D", f"H039_BUILD_ROOT={project}",
            "-p", BUILD_REVIEW_PROFILE,
            *arguments,
        ]

    def installer_argv(executable: Path, arguments: list[str]) -> list[str]:
        return [
            str(SANDBOX_EXEC),
            "-D", f"H039_EXECUTABLE={executable}",
            "-D", f"H039_MEDIATOR={installer_fixture}",
            "-D", f"H039_TEST_ROOT={installer_test_root}",
            "-p", INSTALLER_REVIEW_PROFILE,
            *arguments,
        ]

    environment = {
        "HOME": "/var/empty", "TMPDIR": str(project),
        "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin",
    }
    try:
        inside = project / "inside-write"
        inside_result = bounded_run(
            build_argv(
                SEATBELT_WRITE_PROBE,
                [str(SEATBELT_WRITE_PROBE), str(inside)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(inside_result, "build-review")
        inside_value = os.lstat(inside) if inside.exists() else None
        check(
            no_sigabrt(inside_result) and inside_result.returncode == 0
            and inside_result.stdout == b"" and inside_result.stderr == b""
            and inside_value is not None and stat.S_ISREG(inside_value.st_mode)
            and inside_value.st_uid == os.getuid()
            and inside_value.st_nlink == 1 and inside_value.st_size == 0,
            "A_H039_BUILD_SEATBELT_INSIDE_WRITE_SUCCEEDS",
            {
                "rc": inside_result.returncode,
                "stdout": inside_result.stdout.decode("utf-8", "replace"),
                "stderr": inside_result.stderr.decode("utf-8", "replace"),
            },
        )

        outside = temporary / "outside-write"
        outside_result = bounded_run(
            build_argv(
                SEATBELT_WRITE_PROBE,
                [str(SEATBELT_WRITE_PROBE), str(outside)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(outside_result, "build-review")
        check(
            no_sigabrt(outside_result) and outside_result.returncode == 1
            and outside_result.stdout == b""
            and b"Operation not permitted" in outside_result.stderr
            and not outside.exists() and not outside.is_symlink(),
            "N_H039_BUILD_SEATBELT_OUTSIDE_WRITE_DENIED",
            {
                "rc": outside_result.returncode,
                "stdout": outside_result.stdout.decode("utf-8", "replace"),
                "stderr": outside_result.stderr.decode("utf-8", "replace"),
            },
        )

        wrong_exec_result = bounded_run(
            build_argv(
                SEATBELT_WRITE_PROBE,
                [str(SEATBELT_EXEC_DENY_PROBE), "H039-FORBIDDEN-EXEC"],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(wrong_exec_result, "build-review")
        check(
            no_sigabrt(wrong_exec_result) and wrong_exec_result.returncode == 71
            and wrong_exec_result.stdout == b""
            and b"Operation not permitted" in wrong_exec_result.stderr,
            "N_H039_BUILD_SEATBELT_ARBITRARY_EXEC_DENIED",
            {
                "rc": wrong_exec_result.returncode,
                "stdout": wrong_exec_result.stdout.decode("utf-8", "replace"),
                "stderr": wrong_exec_result.stderr.decode("utf-8", "replace"),
            },
        )

        listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            listener.bind(("127.0.0.1", 0))
            listener.listen(1)
            listener.setblocking(False)
        except OSError as exc:
            if exc.errno in {errno.EPERM, errno.EACCES}:
                raise Undecidable("outer sandbox denied build-review network canary") from exc
            raise
        port = listener.getsockname()[1]
        network_result = bounded_run(
            build_argv(
                SEATBELT_NETWORK_PROBE,
                [str(SEATBELT_NETWORK_PROBE), "-z", "-w", "1", "127.0.0.1", str(port)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(network_result, "build-review")
        connected = False
        try:
            connection, _address = listener.accept()
        except BlockingIOError:
            pass
        else:
            connected = True
            connection.close()
        check(
            no_sigabrt(network_result) and network_result.returncode == 1
            and network_result.stdout == b"" and network_result.stderr == b""
            and not connected and "(allow network" not in BUILD_REVIEW_PROFILE,
            "N_H039_BUILD_SEATBELT_NETWORK_DENIED",
            {
                "rc": network_result.returncode,
                "stdout": network_result.stdout.decode("utf-8", "replace"),
                "stderr": network_result.stderr.decode("utf-8", "replace"),
                "connected": connected,
            },
        )
        listener.close()
        listener = None

        source = project / "profile-probe.c"
        binary = project / "profile-probe"
        source.write_bytes(b"int main(void) { return 0; }\n")
        compile_argv = [
            str(BUILD_COMPILER), "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
            "-fstack-protector-strong", "-D_FORTIFY_SOURCE=2", "-arch", "arm64",
            "-isysroot", str(BUILD_SDK), "-mmacosx-version-min=15.0", "-Wl,-pie",
            "-Wl,-dead_strip", source.name, "-o", binary.name,
        ]
        compile_result = bounded_run(
            build_argv(BUILD_COMPILER, compile_argv),
            cwd=project, env=environment, timeout=60,
        )
        nested_refusal(compile_result, "build-review")
        binary_before_sign = os.lstat(binary) if binary.exists() else None
        check(
            no_sigabrt(compile_result) and compile_result.returncode == 0
            and compile_result.stdout == b"" and compile_result.stderr == b""
            and binary_before_sign is not None
            and stat.S_ISREG(binary_before_sign.st_mode)
            and binary_before_sign.st_uid == os.getuid()
            and binary_before_sign.st_nlink == 1
            and binary_before_sign.st_size > 0,
            "A_H039_BUILD_SEATBELT_EXACT_CLANG_COMPILE",
            {
                "rc": compile_result.returncode,
                "stdout": compile_result.stdout.decode("utf-8", "replace"),
                "stderr": compile_result.stderr.decode("utf-8", "replace"),
            },
        )

        sign_argv = [
            str(BUILD_CODESIGN), "--force", "--options", "runtime", "--sign", "-",
            "--identifier", "se.nortropic.runtime-cleanup-profile-probe",
            "--timestamp=none", binary.name,
        ]
        sign_result = bounded_run(
            build_argv(BUILD_CODESIGN, sign_argv),
            cwd=project, env=environment, timeout=60,
        )
        nested_refusal(sign_result, "build-review")
        verify_argv = [str(BUILD_CODESIGN), "--verify", "--strict", binary.name]
        verify_result = bounded_run(
            build_argv(BUILD_CODESIGN, verify_argv),
            cwd=project, env=environment, timeout=60,
        )
        nested_refusal(verify_result, "build-review")
        check(
            no_sigabrt(sign_result) and no_sigabrt(verify_result)
            and sign_result.returncode == 0 and verify_result.returncode == 0
            and verify_result.stdout == b"" and verify_result.stderr == b""
            and binary.exists() and stat.S_ISREG(os.lstat(binary).st_mode)
            and os.lstat(binary).st_nlink == 1,
            "A_H039_BUILD_SEATBELT_EXACT_CODESIGN_SIGN_AND_VERIFY",
            {
                "sign_rc": sign_result.returncode,
                "sign_stdout": sign_result.stdout.decode("utf-8", "replace"),
                "sign_stderr": sign_result.stderr.decode("utf-8", "replace"),
                "verify_rc": verify_result.returncode,
                "verify_stdout": verify_result.stdout.decode("utf-8", "replace"),
                "verify_stderr": verify_result.stderr.decode("utf-8", "replace"),
            },
        )

        installer_started = bounded_run(
            installer_argv(
                SEATBELT_EXEC_DENY_PROBE,
                [str(SEATBELT_EXEC_DENY_PROBE), "H039-INSTALLER-PROFILE-STARTED"],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_started, "installer-review")
        check(
            no_sigabrt(installer_started) and installer_started.returncode == 0
            and installer_started.stdout == b"H039-INSTALLER-PROFILE-STARTED\n"
            and installer_started.stderr == b"",
            "A_H039_INSTALLER_SEATBELT_EXACT_EXEC_STARTS",
            {
                "rc": installer_started.returncode,
                "stdout": installer_started.stdout.decode("utf-8", "replace"),
                "stderr": installer_started.stderr.decode("utf-8", "replace"),
            },
        )

        installer_inside_read = bounded_run(
            installer_argv(
                SEATBELT_READ_PROBE,
                [str(SEATBELT_READ_PROBE), "-1", str(installer_enumeration)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_inside_read, "installer-review")
        check(
            no_sigabrt(installer_inside_read)
            and installer_inside_read.returncode == 0
            and installer_inside_read.stdout == b"alpha\nbeta\n"
            and installer_inside_read.stderr == b"",
            "A_H039_INSTALLER_SEATBELT_PRIVATE_ROOT_ENUMERATION",
            {
                "rc": installer_inside_read.returncode,
                "stdout": installer_inside_read.stdout.decode("utf-8", "replace"),
                "stderr": installer_inside_read.stderr.decode("utf-8", "replace"),
            },
        )

        installer_outside_read = bounded_run(
            installer_argv(
                SEATBELT_READ_PROBE,
                [str(SEATBELT_READ_PROBE), "-1", str(installer_outside)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_outside_read, "installer-review")
        check(
            no_sigabrt(installer_outside_read)
            and installer_outside_read.returncode == 1
            and installer_outside_read.stdout == b""
            and b"Operation not permitted" in installer_outside_read.stderr
            and installer_outside_secret.read_bytes() == b"H039-OUTSIDE-SECRET\n",
            "N_H039_INSTALLER_SEATBELT_OUTSIDE_ROOT_READ_DENIED",
            {
                "rc": installer_outside_read.returncode,
                "stdout": installer_outside_read.stdout.decode("utf-8", "replace"),
                "stderr": installer_outside_read.stderr.decode("utf-8", "replace"),
            },
        )

        installer_write = temporary / "installer-write"
        installer_write_result = bounded_run(
            installer_argv(
                SEATBELT_WRITE_PROBE,
                [str(SEATBELT_WRITE_PROBE), str(installer_write)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_write_result, "installer-review")
        check(
            no_sigabrt(installer_write_result)
            and installer_write_result.returncode == 1
            and installer_write_result.stdout == b""
            and b"Operation not permitted" in installer_write_result.stderr
            and not installer_write.exists() and not installer_write.is_symlink(),
            "N_H039_INSTALLER_SEATBELT_WRITE_DENIED",
            {
                "rc": installer_write_result.returncode,
                "stdout": installer_write_result.stdout.decode("utf-8", "replace"),
                "stderr": installer_write_result.stderr.decode("utf-8", "replace"),
            },
        )

        installer_wrong_exec = bounded_run(
            installer_argv(
                SEATBELT_EXEC_DENY_PROBE,
                [str(SEATBELT_WRITE_PROBE), str(installer_write)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_wrong_exec, "installer-review")
        check(
            no_sigabrt(installer_wrong_exec)
            and installer_wrong_exec.returncode == 71
            and installer_wrong_exec.stdout == b""
            and b"Operation not permitted" in installer_wrong_exec.stderr
            and not installer_write.exists() and not installer_write.is_symlink(),
            "N_H039_INSTALLER_SEATBELT_ALTERNATE_EXEC_DENIED",
            {
                "rc": installer_wrong_exec.returncode,
                "stdout": installer_wrong_exec.stdout.decode("utf-8", "replace"),
                "stderr": installer_wrong_exec.stderr.decode("utf-8", "replace"),
            },
        )
    finally:
        if listener is not None:
            listener.close()
        shutil.rmtree(temporary)


def tool(argv: list[str]) -> bytes:
    result = bounded_run(
        argv, cwd="/", env={"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
        timeout=20,
    )
    if result.returncode != 0:
        raise Rig(f"tool failed {argv!r}: {result.stderr!r}")
    return result.stdout + result.stderr


def parse_vtool_build(build: str) -> tuple[str, str, str]:
    matches = [
        re.search(r"^ *platform +(\S+)$", build, re.MULTILINE),
        re.search(r"^ *minos +(\S+)$", build, re.MULTILINE),
        re.search(r"^ *sdk +(\S+)$", build, re.MULTILINE),
    ]
    if not all(matches):
        raise Rig("incomplete Mach-O build-version identity")
    return tuple(match.group(1) for match in matches if match is not None)


def macho_identity(path: Path, identifier: str) -> dict[str, Any]:
    file_text = tool(["/usr/bin/file", "-b", str(path)]).decode("utf-8", "replace")
    if "Mach-O 64-bit executable arm64" not in file_text:
        raise Rig(f"not exact arm64 Mach-O: {path}")
    codesign = tool(["/usr/bin/codesign", "-d", "--verbose=4", str(path)]).decode()
    if (
        f"Identifier={identifier}" not in codesign
        or "Signature=adhoc" not in codesign
        or re.search(r"flags=0x[0-9a-f]+\([^\n)]*runtime[^\n)]*\)", codesign) is None
        or "TeamIdentifier=not set" not in codesign
        or "Timestamp=" in codesign
    ):
        raise Rig("Mach-O signing/hardened-runtime identity mismatch")
    entitlement_text = tool(
        ["/usr/bin/codesign", "-d", "--entitlements", ":-", str(path)],
    ).decode("utf-8", "replace")
    if "<?xml" in entitlement_text or "<plist" in entitlement_text:
        raise Rig("Mach-O carries forbidden entitlements")
    match_cd = re.search(r"^CDHash=([0-9a-f]{40})$", codesign, re.MULTILINE)
    uuid_text = tool(["/usr/bin/dwarfdump", "--uuid", str(path)]).decode()
    match_uuid = re.search(
        r"UUID: ([0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12}) \(arm64\)",
        uuid_text,
    )
    headers = tool(["/usr/bin/otool", "-hv", str(path)]).decode()
    if "PIE" not in headers:
        raise Rig("Mach-O is not PIE")
    load_commands = tool(["/usr/bin/otool", "-l", str(path)]).decode()
    if "LC_RPATH" in load_commands:
        raise Rig("Mach-O contains forbidden LC_RPATH")
    if "@rpath" in load_commands or "@loader_path" in load_commands:
        raise Rig("Mach-O contains forbidden dynamic-loader path")
    load = tool(["/usr/bin/otool", "-L", str(path)]).decode().splitlines()[1:]
    dependencies = sorted(line.strip().split(" ", 1)[0] for line in load if line.strip())
    if not dependencies or any(
        not (item.startswith("/usr/lib/") or item.startswith("/System/Library/Frameworks/"))
        for item in dependencies
    ):
        raise Rig("Mach-O has non-Apple dependency")
    build = tool(["/usr/bin/vtool", "-show-build", str(path)]).decode()
    platform, minos, sdk = parse_vtool_build(build)
    undefined_symbols = sorted({
        line.strip() for line in
        tool(["/usr/bin/nm", "-u", str(path)]).decode().splitlines()
        if line.strip()
    })
    if not all((match_cd, match_uuid)):
        raise Rig("incomplete Mach-O identity")
    return {
        "cdhash": match_cd.group(1), "uuid": match_uuid.group(1),
        "dependencies": dependencies, "platform": platform,
        "minos": minos, "sdk": sdk, "undefined_symbols": undefined_symbols,
    }


def macho_checks(
    manifest: dict[str, Any], commit: str | None = None, *,
    diagnostic_product: bool = False,
) -> None:
    temporary = Path(tempfile.mkdtemp(prefix="h039-macho-", dir="/private/tmp"))
    try:
        identities: dict[str, dict[str, Any]] = {}
        for name, product_path in (
            ("mediator", "verify/h039/runtime-cleanup-mediator"),
            ("installer", "controller/runtime-cleanup/install"),
        ):
            target = temporary / name
            target.write_bytes(product_bytes(product_path, commit))
            target.chmod(0o755)
            identities[name] = macho_identity(
                target, f"se.nortropic.runtime-cleanup-{name}",
            )
        for name in ("mediator", "installer"):
            actual = identities[name]
            if actual["cdhash"] != manifest[f"{name}_codesign_cdhash"] \
                    or actual["uuid"] != manifest[f"{name}_lc_uuid"] \
                    or actual["dependencies"] != manifest[f"{name}_dependencies"]:
                raise Rig(f"{name} Mach-O manifest drift")
        installer_allowed_symbols = {
            "__NSGetExecutablePath", "___chkstk_darwin", "___error",
            "___stack_chk_fail", "___stack_chk_guard", "___strcpy_chk",
            "_bzero", "_chdir", "_close", "_closedir",
            "_dup", "_environ", "_fchmod", "_fchown", "_fcntl", "_fdopendir",
            "_free", "_fstat", "_fstatat", "_fsync", "_getegid",
            "_geteuid", "_getgid", "_getpid", "_getsectiondata",
            "_getuid", "_lstat", "_malloc", "_memcmp", "_memcpy",
            "_mkdirat", "_open", "_openat", "_pread", "_proc_pidinfo",
            "_readdir", "_renameatx_np", "_snprintf", "_strcmp",
            "_strlen", "_strrchr", "_strstr", "_umask", "_unlinkat",
            "_write",
        }
        installer_required_symbols = {
            "_chdir", "_close", "_environ", "_free", "_getegid", "_geteuid",
            "_fcntl", "_getgid", "_getpid", "_getsectiondata", "_getuid",
            "_malloc", "_proc_pidinfo", "_renameatx_np", "_umask",
        }
        installer_symbols = set(identities["installer"]["undefined_symbols"])
        if diagnostic_product:
            if installer_symbols != R14_DIAGNOSTIC_UNDEFINED_SYMBOLS:
                raise Rig(
                    "diagnostic installer imports are not the exact frozen set"
                )
        elif not installer_required_symbols <= installer_symbols \
                or not installer_symbols <= installer_allowed_symbols:
            raise Rig("installer imported symbol authority is not exact closed bootstrap set")
        installer_path = temporary / "installer"
        installer_load = tool(["/usr/bin/otool", "-l", str(installer_path)]).decode()
        section_matches = re.findall(
            r"sectname __h039med\n\s+segname __H039RO\n"
            r"\s+addr 0x[0-9a-f]+\n\s+size (0x[0-9a-f]+)\n"
            r"\s+offset ([0-9]+)",
            installer_load,
        )
        read_only_segments = re.findall(
            r"cmd LC_SEGMENT_64\n\s+cmdsize [0-9]+\n\s+segname __H039RO\n"
            r"[\s\S]*?\n\s+maxprot (0x[0-9a-f]+)\n"
            r"\s+initprot (0x[0-9a-f]+)",
            installer_load,
        )
        installer_raw = installer_path.read_bytes()
        section_ok = False
        if len(section_matches) == 1:
            size_raw, offset_raw = section_matches[0]
            section_size = int(size_raw, 16)
            section_offset = int(offset_raw, 10)
            section_ok = (
                section_size == manifest["embedded_mediator_size"]
                and 0 <= section_offset <= len(installer_raw) - section_size
                and sha(installer_raw[section_offset:section_offset + section_size])
                == manifest["embedded_mediator_sha256"]
                and installer_raw[section_offset:section_offset + section_size]
                == product_bytes("verify/h039/runtime-cleanup-mediator", commit)
            )
        if (
            manifest.get("embedded_mediator_section") != "__H039RO,__h039med"
            or not section_ok or read_only_segments != [("0x00000001", "0x00000001")]
        ):
            raise Rig("installer embedded mediator section bytes or read-only mapping mismatch")
        if any(
            identities[name][field] != manifest[field]
            for name in ("mediator", "installer")
            for field in ("platform", "minos", "sdk")
        ):
            raise Rig("Mach-O platform/minos/sdk drift")
    finally:
        shutil.rmtree(temporary)


def reproducible_rebuild(recipe: dict[str, Any], commit: str | None = None) -> None:
    temporary = Path(tempfile.mkdtemp(prefix="h039-rebuild-", dir="/private/tmp"))
    project = temporary / "project"
    project.mkdir(mode=0o700)
    try:
        for directory in (
            "controller/runtime-cleanup/native", "verify/h039",
        ):
            (project / directory).mkdir(parents=True, exist_ok=True)
        (project / "controller/runtime-cleanup/native/mediator.c").write_bytes(
            product_bytes("controller/runtime-cleanup/native/mediator.c", commit)
        )
        for path, digest, label in (
            (SANDBOX_EXEC, SANDBOX_EXEC_SHA256, "sandbox-exec"),
            (SEATBELT_WRITE_PROBE, SEATBELT_WRITE_PROBE_SHA256, "touch"),
        ):
            value = os.lstat(path)
            if (
                not stat.S_ISREG(value.st_mode) or value.st_uid != 0
                or value.st_gid != 0 or stat.S_IMODE(value.st_mode) != 0o755
                or value.st_nlink != 1 or path.is_symlink() or path_sha(path) != digest
            ):
                raise Undecidable(f"pinned build-review {label} identity drift")

        def build_argv(executable: str, arguments: list[str]) -> list[str]:
            return [
                str(SANDBOX_EXEC),
                "-D", f"H039_BUILD_EXECUTABLE={executable}",
                "-D", f"H039_BUILD_ROOT={project}",
                "-p", BUILD_REVIEW_PROFILE,
                *arguments,
            ]

        outside = temporary / "seatbelt-write-canary"
        probe = bounded_run(
            build_argv(str(SEATBELT_WRITE_PROBE), [str(SEATBELT_WRITE_PROBE), str(outside)]),
            cwd="/", env={"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
            timeout=10,
        )
        if probe.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in probe.stderr:
            raise Undecidable("outer Seatbelt denied nested build-review sandbox")
        if probe.returncode == 0 or outside.exists() or outside.is_symlink() \
                or b"Operation not permitted" not in probe.stderr:
            raise Rig("build-review deny-default Seatbelt boundary was not effective")
        for key in (
            "mediator_compile_argv", "mediator_sign_argv",
            "installer_compile_argv", "installer_sign_argv",
        ):
            result = bounded_run(
                build_argv(recipe[key][0], recipe[key]), cwd=project,
                env={
                    "HOME": "/var/empty", "TMPDIR": str(project),
                    "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin",
                },
                timeout=60,
            )
            if result.returncode == 71 \
                    and b"sandbox_apply: Operation not permitted" in result.stderr:
                raise Undecidable("outer Seatbelt denied nested build-review sandbox")
            if result.returncode != 0:
                raise Rig(f"rebuild {key} failed: {result.stderr!r}")
            if key == "mediator_sign_argv" and sha(
                (project / "verify/h039/runtime-cleanup-mediator").read_bytes()
            ) != sha(product_bytes("verify/h039/runtime-cleanup-mediator", commit)):
                raise Rig("reproducible mediator mismatch before installer build")
        for product_path in (
            "verify/h039/runtime-cleanup-mediator",
            "controller/runtime-cleanup/install",
        ):
            if (project / product_path).read_bytes() != product_bytes(product_path, commit):
                raise Rig(f"reproducible product mismatch: {product_path}")
    finally:
        shutil.rmtree(temporary)


def r14_ir_control_flow_valid(ir: bytes, *, exact_image: bool) -> bool:
    if exact_image and (
        len(ir) != R14_DIAGNOSTIC_IR_SIZE or sha(ir) != R14_DIAGNOSTIC_IR_SHA256
    ):
        return False
    try:
        ir_text = ir.decode("utf-8")
    except UnicodeError:
        return False
    bootstrap_match = re.search(
        r"define range\(i32 0, 126\) i32 @installer_bootstrap\(i32[^\n]*\) #[0-9]+ \{"
        r"([\s\S]*?)\n\}", ir_text,
    )
    main_match = re.search(
        r"define range\(i32 0, 126\) i32 @main\(i32[^\n]*\) #[0-9]+ \{"
        r"([\s\S]*?)\n\}", ir_text,
    )
    if bootstrap_match is None or main_match is None:
        return False
    bootstrap = bootstrap_match.group(1)
    main = main_match.group(1)
    bootstrap_codes = {
        int(value) for value in re.findall(
            r"\[\s*(-?[0-9]+),\s*%[0-9]+\s*\]", bootstrap
        )
    }
    main_codes = {
        int(value) for value in re.findall(
            r"\[\s*(-?[0-9]+),\s*%[0-9]+\s*\]", main
        )
    }
    exact_call = (
        "tail call i32 @installer_bootstrap(i32 noundef 2, "
        "ptr noundef nonnull readonly %1)"
    )
    return (
        set(range(6, 126)).issubset(bootstrap_codes)
        and set(range(1, 6)).issubset(main_codes)
        and ir_text.count("call i32 @installer_bootstrap(") == 1
        and exact_call in main
        and "call i32 %" not in main
        and "select i1" in bootstrap
        and "i32 0, i32 125" in bootstrap
        and "ret i32" in bootstrap and "ret i32" in main
        and "i32 126" not in bootstrap
    )


def r14_ir_control_flow_selftests(ir: bytes) -> None:
    check(r14_ir_control_flow_valid(ir, exact_image=True),
          "A_H039_R14_R4_EXACT_OWNING_CFG_AND_SOLE_DOMINATING_CALL")
    mutants = {
        "LOCAL18_REMOVED": ir.replace(b"[ 18, %90 ],", b"[ 17, %90 ],", 1),
        "LOCAL19_REMOVED": ir.replace(b"[ 19, %91 ],", b"[ 17, %91 ],", 1),
        "LOCAL28_REMOVED": ir.replace(b"[ 28, %126 ],", b"[ 27, %126 ],", 1),
        "LOCAL29_REMOVED": ir.replace(b"[ 29, %128 ],", b"[ 27, %128 ],", 1),
        "LOCAL62_REMOVED": ir.replace(b"[ 62, %241 ]", b"[ 61, %241 ]", 1),
        "KNOWN_ARGC_RELOADED": ir.replace(b"i32 noundef 2, ptr noundef nonnull readonly %1", b"i32 noundef %0, ptr noundef nonnull readonly %1", 1),
        "ARG_CHANGED": ir.replace(b"ptr noundef nonnull readonly %1)", b"ptr noundef nonnull readonly %7)", 1),
        "INDIRECT_CALL": ir.replace(b"call i32 @installer_bootstrap(", b"call i32 %17(", 1),
        "ADDED_CALLER": ir + b"\ndefine i32 @decoy(){ %1 = call i32 @installer_bootstrap(i32 2, ptr null)\n ret i32 %1\n}\n",
    }
    for label, mutant in mutants.items():
        if mutant == ir:
            raise Rig(f"R14-R4 IR selftest mutant was inert: {label}")
        check(not r14_ir_control_flow_valid(mutant, exact_image=False),
              f"N_H039_R14_R4_IR_{label}")


def r14_reference_rebuild() -> None:
    """Compile the sole R9 source before freeze; no product bytes are adopted."""
    temporary = Path(tempfile.mkdtemp(prefix="h039-r14-reference-", dir="/private/tmp"))
    project = temporary / "project"
    source_path = project / "controller/runtime-cleanup/native/mediator.c"
    mediator_path = project / "verify/h039/runtime-cleanup-mediator"
    output_path = project / "controller/runtime-cleanup/install"
    ir_path = project / "verify/h039/r14-diagnostic.ll"
    try:
        source_path.parent.mkdir(parents=True)
        mediator_path.parent.mkdir(parents=True)
        source = r14_expected_diagnostic_source()
        r14_diagnostic_source_checks(source)
        source_path.write_bytes(source)
        mediator = blob(
            PUBLISHED_H039_R8_PRODUCT_MERGE,
            "verify/h039/runtime-cleanup-mediator",
        )
        mediator_path.write_bytes(mediator)
        compiler = "/Library/Developer/CommandLineTools/usr/bin/clang"
        sdk = "/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk"
        compile_argv = [
            compiler, "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
            "-fstack-protector-strong", "-D_FORTIFY_SOURCE=2", "-arch", "arm64",
            "-isysroot", sdk, "-mmacosx-version-min=15.0", "-Wl,-pie",
            "-Wl,-dead_strip", "-Wno-unused-function", "-DH039_INSTALLER=1",
            "-DH039_ROOT_ENTRY_FD0_NORMALIZATION=1",
            "-DH039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC=1",
            f"-DH039_MEDIATOR_SHA256={sha(mediator)}",
            f"-DH039_MEDIATOR_SIZE={len(mediator)}",
            "-Wl,-segprot,__H039RO,r,r",
            "-Wl,-sectcreate,__H039RO,__h039med,verify/h039/runtime-cleanup-mediator",
            "controller/runtime-cleanup/native/mediator.c", "-o",
            "controller/runtime-cleanup/install",
        ]
        result = bounded_run(
            [
                str(SANDBOX_EXEC), "-D", f"H039_BUILD_EXECUTABLE={compiler}",
                "-D", f"H039_BUILD_ROOT={project}", "-p", BUILD_REVIEW_PROFILE,
                *compile_argv,
            ],
            cwd=project,
            env={
                "HOME": "/var/empty", "TMPDIR": str(project), "LANG": "C",
                "LC_ALL": "C", "PATH": "/usr/bin:/bin",
            },
            timeout=60,
        )
        if result.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in result.stderr:
            raise Undecidable("outer Seatbelt denied R14 reference build sandbox")
        if result.returncode != 0 or result.stdout or result.stderr:
            raise Rig(
                "sole R14 diagnostic reference does not compile exactly: "
                f"rc={result.returncode} stdout={result.stdout!r} stderr={result.stderr!r}"
            )
        value = os.lstat(output_path)
        if (
            not stat.S_ISREG(value.st_mode) or value.st_nlink != 1
            or value.st_size <= 0
            or value.st_size > PRODUCT_BYTE_LIMITS["controller/runtime-cleanup/install"]
        ):
            raise Rig("R14 reference build output identity or size rejected")
        symbols = {
            line.strip() for line in
            tool(["/usr/bin/nm", "-u", str(output_path)]).decode().splitlines()
            if line.strip()
        }
        if symbols != R14_DIAGNOSTIC_UNDEFINED_SYMBOLS:
            raise Rig("R14 reference build undefined-import set drift")
        ir_argv = [
            compiler, "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
            "-fstack-protector-strong", "-D_FORTIFY_SOURCE=2", "-arch", "arm64",
            "-isysroot", sdk, "-mmacosx-version-min=15.0", "-Wno-unused-function",
            "-DH039_INSTALLER=1", "-DH039_ROOT_ENTRY_FD0_NORMALIZATION=1",
            "-DH039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC=1",
            f"-DH039_MEDIATOR_SHA256={sha(mediator)}",
            f"-DH039_MEDIATOR_SIZE={len(mediator)}", "-S", "-emit-llvm",
            "controller/runtime-cleanup/native/mediator.c", "-o",
            "verify/h039/r14-diagnostic.ll",
        ]
        ir_result = bounded_run(
            [
                str(SANDBOX_EXEC), "-D", f"H039_BUILD_EXECUTABLE={compiler}",
                "-D", f"H039_BUILD_ROOT={project}", "-p", BUILD_REVIEW_PROFILE,
                *ir_argv,
            ], cwd=project,
            env={
                "HOME": "/var/empty", "TMPDIR": str(project), "LANG": "C",
                "LC_ALL": "C", "PATH": "/usr/bin:/bin",
            }, timeout=60,
        )
        if ir_result.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in ir_result.stderr:
            raise Undecidable("outer Seatbelt denied R14 IR reference build sandbox")
        if ir_result.returncode != 0 or ir_result.stdout or ir_result.stderr:
            raise Rig("exact optimized LLVM IR build failed or emitted output")
        ir = ir_path.read_bytes()
        if not r14_ir_control_flow_valid(ir, exact_image=True):
            raise Rig(
                "optimized diagnostic IR is not the frozen exact control-flow image: "
                f"size={len(ir)} sha256={sha(ir)}"
            )
        r14_ir_control_flow_selftests(ir)
    finally:
        shutil.rmtree(temporary)


def installer_verify_effects(
    commit: str, *, diagnostic_product: bool = False,
) -> None:
    temporary = Path(tempfile.mkdtemp(prefix="h039-installer-", dir="/private/tmp"))
    temporary_fd = os.open(
        temporary, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    temporary_identity = retained_directory_identity(os.fstat(temporary_fd))
    installer = temporary / "controller/runtime-cleanup/install"
    mediator = temporary / "verify/h039/runtime-cleanup-mediator"
    installer.parent.mkdir(parents=True)
    mediator.parent.mkdir(parents=True)
    installer.write_bytes(product_bytes("controller/runtime-cleanup/install", commit))
    mediator.write_bytes(product_bytes("verify/h039/runtime-cleanup-mediator", commit))
    installer.chmod(0o755)
    mediator.chmod(0o555)
    before_install = INSTALLED.exists() or INSTALLED.is_symlink()
    try:
        namespace_before = stable_identity(os.lstat(NAMESPACE))
    except OSError as exc:
        raise Rig("product review requires the preserved PRE_EFFECTS namespace") from exc
    if before_install:
        raise Rig("retained-product review requires the installed helper absent")

    def exact_tree() -> dict[str, tuple[tuple[int, ...], str | None]]:
        try:
            root_stat = os.lstat(temporary)
        except OSError as exc:
            raise Rig("installer review root disappeared") from exc
        if retained_directory_identity(root_stat) != temporary_identity \
                or retained_directory_identity(os.fstat(temporary_fd)) != temporary_identity:
            raise Rig("installer review root identity changed")
        observed: dict[str, tuple[tuple[int, ...], str | None]] = {}
        pending = [temporary]
        while pending:
            parent = pending.pop()
            for entry in os.scandir(parent):
                path = Path(entry.path)
                value = os.lstat(path)
                relative = str(path.relative_to(temporary))
                target = os.readlink(path) if stat.S_ISLNK(value.st_mode) else None
                observed[relative] = (stable_identity(value), target)
                if stat.S_ISDIR(value.st_mode):
                    pending.append(path)
        return observed

    def require_fixed_tool(path: Path, digest: str, label: str) -> tuple[int, ...]:
        try:
            value = os.lstat(path)
        except OSError as exc:
            raise Undecidable(f"pinned {label} unavailable") from exc
        if (
            not stat.S_ISREG(value.st_mode) or value.st_uid != 0 or value.st_gid != 0
            or stat.S_IMODE(value.st_mode) != 0o755 or value.st_nlink != 1
            or path_sha(path) != digest
        ):
            raise Undecidable(f"pinned {label} identity drift")
        return stable_identity(value)

    sandbox_identity: tuple[int, ...] = ()
    probe_identity: tuple[int, ...] = ()

    def sandbox_argv(executable: Path) -> list[str]:
        return [
            str(SANDBOX_EXEC),
            "-D", f"H039_EXECUTABLE={executable}",
            "-D", f"H039_MEDIATOR={mediator}",
            "-D", f"H039_TEST_ROOT={temporary}",
            "-p", INSTALLER_REVIEW_PROFILE,
            str(executable),
        ]

    def nested_seatbelt_refused(result: subprocess.CompletedProcess[bytes]) -> bool:
        return (
            result.returncode == 71
            and b"sandbox_apply: Operation not permitted" in result.stderr
        )

    def run_sandboxed(
        executable: Path, arguments: list[str], environment: dict[str, str],
    ) -> subprocess.CompletedProcess[bytes]:
        before = exact_tree()
        result = bounded_run(
            [*sandbox_argv(executable), *arguments], cwd="/",
            env=environment, timeout=10,
        )
        if nested_seatbelt_refused(result):
            raise Undecidable("outer Seatbelt denied nested installer-review sandbox")
        if exact_tree() != before:
            raise Rig("sandboxed installer-review process changed its identity-bound tree")
        if (
            stable_identity(os.lstat(SANDBOX_EXEC)) != sandbox_identity
            or stable_identity(os.lstat(SEATBELT_WRITE_PROBE)) != probe_identity
        ):
            raise Undecidable("installer-review Seatbelt tool identity changed")
        return result

    environment = {
        "HOME": "/private/tmp/H039-INSTALLER-HOSTILE-HOME",
        "PATH": "/private/tmp/H039-INSTALLER-HOSTILE-PATH",
        "DYLD_INSERT_LIBRARIES": "/private/tmp/H039-INSTALLER-HOSTILE-DYLD",
        "NORTROPIC_MEDIATOR_PATH": "/private/tmp/H039-HOSTILE-MEDIATOR",
        "NORTROPIC_MEDIATOR_SHA256": "00" * 32,
    }

    def invoke(arguments: list[str]) -> subprocess.CompletedProcess[bytes]:
        return run_sandboxed(installer, arguments, environment)

    try:
        sandbox_identity = require_fixed_tool(
            SANDBOX_EXEC, SANDBOX_EXEC_SHA256, "/usr/bin/sandbox-exec",
        )
        probe_identity = require_fixed_tool(
            SEATBELT_WRITE_PROBE, SEATBELT_WRITE_PROBE_SHA256, "/usr/bin/touch",
        )
        write_canary = temporary / "seatbelt-write-canary"
        boundary = run_sandboxed(
            SEATBELT_WRITE_PROBE, [str(write_canary)],
            {"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
        )
        if (
            boundary.returncode != 1 or write_canary.exists()
            or b"Operation not permitted" not in boundary.stderr
        ):
            raise Rig(
                "installer-review deny-default Seatbelt boundary was not effective "
                f"rc={boundary.returncode} stderr={boundary.stderr!r}"
            )
        other_process = bounded_run(
            [*sandbox_argv(installer)[:-1], "/usr/bin/true"], cwd="/",
            env={"LANG": "C", "LC_ALL": "C"}, timeout=10,
        )
        if nested_seatbelt_refused(other_process):
            raise Undecidable("outer Seatbelt denied nested installer-review sandbox")
        if other_process.returncode == 0:
            raise Rig("installer-review Seatbelt admitted another executable")

        positive = invoke(["verify"])
        if diagnostic_product:
            if positive.returncode == 0 or positive.stdout or positive.stderr:
                raise Rig("diagnostic installer exposed a non-bootstrap operation")
        elif positive.returncode != 0 or positive.stdout or positive.stderr:
            raise Rig("uninstalled self-relative installer verify failed")
        for arguments in (
            [], ["verify", "extra"], ["hostile"], ["apply", "extra"],
            ["bootstrap", "extra"],
        ):
            rejected = invoke(arguments)
            if rejected.returncode == 0:
                raise Rig(f"installer accepted invalid argv: {arguments!r}")
        installer_alias = temporary / "installer-alias"
        os.link(installer, installer_alias)
        try:
            self_hardlink = run_sandboxed(installer_alias, ["verify"], environment)
            alias_value = os.lstat(installer_alias)
            installer_value = os.lstat(installer)
            if (
                (alias_value.st_dev, alias_value.st_ino)
                != (installer_value.st_dev, installer_value.st_ino)
                or alias_value.st_nlink != 2 or installer_value.st_nlink != 2
            ):
                raise Rig("installer self-hardlink control identity changed")
        finally:
            installer_alias.unlink()
        if self_hardlink.returncode == 0:
            raise Rig("installer accepted hardlinked self executable")
        installer_link = temporary / "installer-link"
        installer_link.symlink_to(installer)
        try:
            self_symlink = run_sandboxed(installer_link, ["verify"], environment)
            if not installer_link.is_symlink() \
                    or os.readlink(installer_link) != str(installer):
                raise Rig("installer self-symlink control identity changed")
        finally:
            installer_link.unlink()
        if self_symlink.returncode == 0:
            raise Rig("installer accepted symlinked self executable")
        alias = temporary / "mediator-alias"
        os.link(mediator, alias)
        try:
            hardlink = invoke(["verify"])
        finally:
            alias_value = os.lstat(alias)
            mediator_value = os.lstat(mediator)
            if (
                not stat.S_ISREG(alias_value.st_mode)
                or (alias_value.st_dev, alias_value.st_ino)
                != (mediator_value.st_dev, mediator_value.st_ino)
                or alias_value.st_nlink != 2 or mediator_value.st_nlink != 2
            ):
                raise Rig("installer hardlink control identity changed")
            alias.unlink()
        if hardlink.returncode == 0:
            raise Rig("installer accepted non-unique mediator artifact")
        retained = mediator.with_name("retained")
        mediator.rename(retained)
        mediator.symlink_to(retained)
        try:
            symlink = invoke(["verify"])
        finally:
            link_value = os.lstat(mediator)
            retained_value = os.lstat(retained)
            if (
                not stat.S_ISLNK(link_value.st_mode)
                or os.readlink(mediator) != str(retained)
                or not stat.S_ISREG(retained_value.st_mode)
                or retained_value.st_nlink != 1
            ):
                raise Rig("installer symlink control identity changed")
            mediator.unlink()
            retained.rename(mediator)
        if symlink.returncode == 0:
            raise Rig("installer accepted symlink mediator artifact")
        unprivileged_apply = invoke(["apply"])
        if unprivileged_apply.returncode == 0:
            raise Rig("unprivileged installer apply unexpectedly succeeded")
        unprivileged_bootstrap = invoke(["bootstrap"])
        if unprivileged_bootstrap.returncode == 0:
            raise Rig("unprivileged installer bootstrap unexpectedly succeeded")
        canary = b"H039-R13-INHERITED-FD0-MUST-REMAIN-UNCONSUMED"
        read_fd, write_fd = os.pipe()
        try:
            if os.write(write_fd, canary) != len(canary):
                raise Rig("fd0 canary write was partial")
            os.close(write_fd)
            write_fd = -1
            before_canary = exact_tree()
            process = subprocess.Popen(
                [*sandbox_argv(installer), "bootstrap"], stdin=read_fd,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, close_fds=True,
                cwd="/", env=environment, start_new_session=True,
            )
            try:
                stdout, stderr = process.communicate(timeout=10)
            except subprocess.TimeoutExpired as exc:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait(timeout=5)
                raise Rig("fd0 non-consumption control timed out") from exc
            if process.returncode == 71 \
                    and b"sandbox_apply: Operation not permitted" in stderr:
                raise Undecidable("outer Seatbelt denied fd0 non-consumption control")
            retained = os.read(read_fd, len(canary) + 1)
            clean_eof = os.read(read_fd, 1)
            if process.returncode == 0 or stdout or stderr \
                    or retained != canary or clean_eof != b"" \
                    or exact_tree() != before_canary:
                raise Rig("bootstrap consumed or changed the inherited fd0 canary")
        finally:
            if write_fd >= 0:
                os.close(write_fd)
            os.close(read_fd)
        if (
            before_install != (INSTALLED.exists() or INSTALLED.is_symlink())
            or stable_identity(os.lstat(NAMESPACE)) != namespace_before
        ):
            raise Rig("installer product review changed fixed PRE_EFFECTS state")
    finally:
        expected = {
            "controller", "controller/runtime-cleanup",
            "controller/runtime-cleanup/install", "verify", "verify/h039",
            "verify/h039/runtime-cleanup-mediator",
        }
        cleanup_error = None
        try:
            observed = exact_tree()
            if set(observed) != expected:
                cleanup_error = Rig("installer review tree changed; refusing pathname cleanup")
            else:
                installer_value = os.lstat(installer)
                mediator_value = os.lstat(mediator)
                if (
                    not stat.S_ISREG(installer_value.st_mode)
                    or stat.S_IMODE(installer_value.st_mode) != 0o755
                    or installer_value.st_nlink != 1
                    or sha(installer.read_bytes())
                    != sha(product_bytes("controller/runtime-cleanup/install", commit))
                    or not stat.S_ISREG(mediator_value.st_mode)
                    or stat.S_IMODE(mediator_value.st_mode) != 0o555
                    or mediator_value.st_nlink != 1
                    or sha(mediator.read_bytes())
                    != sha(product_bytes("verify/h039/runtime-cleanup-mediator", commit))
                ):
                    cleanup_error = Rig(
                        "installer review artifact identity changed; refusing pathname cleanup"
                    )
        except (OSError, Rig) as exc:
            cleanup_error = exc
        os.close(temporary_fd)
        if cleanup_error is None:
            shutil.rmtree(temporary)
        else:
            raise cleanup_error


def c_semantic_source(source: str) -> str:
    """Remove C comments without treating comment markers in literals as syntax."""
    if "\r" in source or "\\\n" in source \
            or re.search(r"\?\?[=/'()!<>-]", source):
        raise Rig("ambiguous C preprocessing sequence")
    out: list[str] = []
    state = "code"
    index = 0
    while index < len(source):
        value = source[index]
        following = source[index + 1] if index + 1 < len(source) else ""
        if state == "code":
            if value == "/" and following == "/":
                out.extend((" ", " "))
                index += 2
                state = "line"
                continue
            if value == "/" and following == "*":
                out.extend((" ", " "))
                index += 2
                state = "block"
                continue
            out.append(value)
            if value == '"':
                state = "string"
            elif value == "'":
                state = "character"
            index += 1
            continue
        if state == "line":
            if value == "\n":
                out.append(value)
                state = "code"
            else:
                out.append(" ")
            index += 1
            continue
        if state == "block":
            if value == "*" and following == "/":
                out.extend((" ", " "))
                index += 2
                state = "code"
                continue
            out.append("\n" if value == "\n" else " ")
            index += 1
            continue
        if value in {"\n", "\r"}:
            raise Rig("newline in C literal")
        out.append(value)
        if value == "\\":
            if index + 1 >= len(source):
                raise Rig("unterminated C literal escape")
            out.append(source[index + 1])
            index += 2
            continue
        if (state == "string" and value == '"') \
                or (state == "character" and value == "'"):
            state = "code"
        index += 1
    if state not in {"code", "line"}:
        raise Rig("unterminated C lexical state")
    normalized = "".join(out)
    if re.search(
        r"\\(?:x[0-9A-Fa-f]+|[0-7]{1,3}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
        normalized,
    ):
        raise Rig("numeric or universal C literal escape is forbidden")
    if re.search(
        r'(?:u8|u|U|L)?"(?:\\.|[^"\\])*"\s*'
        r'(?:u8|u|U|L)?"(?:\\.|[^"\\])*"',
        normalized,
    ):
        raise Rig("adjacent C string literal construction is forbidden")
    return normalized


def c_structure_mask(semantic_source: str) -> str:
    """Mask literal contents while preserving offsets for balanced delimiters."""
    out = list(semantic_source)
    state = "code"
    index = 0
    while index < len(semantic_source):
        value = semantic_source[index]
        if state == "code":
            if value == '"':
                out[index] = " "
                state = "string"
            elif value == "'":
                out[index] = " "
                state = "character"
            index += 1
            continue
        if value == "\\":
            out[index] = " "
            if index + 1 >= len(semantic_source):
                raise Rig("unterminated C structure escape")
            out[index + 1] = " "
            index += 2
            continue
        if (state == "string" and value == '"') \
                or (state == "character" and value == "'"):
            out[index] = " "
            state = "code"
        elif value != "\n":
            out[index] = " "
        index += 1
    if state != "code":
        raise Rig("unterminated C structure literal")
    return "".join(out)


def c_function_body(semantic_source: str, name: str) -> str:
    mask = c_structure_mask(semantic_source)
    matches = list(re.finditer(rf"\bstatic\s+int\s+{re.escape(name)}\s*\(", mask))
    if len(matches) != 1:
        raise Rig(f"exact installer function absent or duplicated: {name}")
    opening_parenthesis = mask.find("(", matches[0].start())
    depth = 0
    closing_parenthesis = -1
    for index in range(opening_parenthesis, len(mask)):
        if mask[index] == "(":
            depth += 1
        elif mask[index] == ")":
            depth -= 1
            if depth == 0:
                closing_parenthesis = index
                break
    if closing_parenthesis < 0:
        raise Rig(f"unterminated installer function declaration: {name}")
    opening_brace = closing_parenthesis + 1
    while opening_brace < len(mask) and mask[opening_brace].isspace():
        opening_brace += 1
    if opening_brace >= len(mask) or mask[opening_brace] != "{":
        raise Rig(f"installer function is not a definition: {name}")
    depth = 0
    for index in range(opening_brace, len(mask)):
        if mask[index] == "{":
            depth += 1
        elif mask[index] == "}":
            depth -= 1
            if depth == 0:
                return semantic_source[opening_brace + 1:index]
    raise Rig(f"unterminated installer function body: {name}")


def native_absolute_strings(source: str) -> set[str]:
    return set(re.findall(
        r'(?:u8|u|U|L)?"(/[^"\\]*)"', c_semantic_source(source),
    ))


def r14_diagnostic_fragment() -> bytes:
    assignments = ",\n".join(
        f"  H039_DIAG_{name} = {code}" for code, name in R14_EXIT_CODES
    )
    return f"""#if defined(H039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC)
enum h039_diagnostic_exit {{
{assignments}
}};

static int diagnostic_close_bootstrap_descriptors(void){{
  const int byte_cap=1048576;
  pid_t self=getpid();
  errno=0;
  int sizing=proc_pidinfo(self,PROC_PIDLISTFDS,0,NULL,0);
  if(sizing<=0)return H039_DIAG_FD_INITIAL_SIZING;
  if(errno!=0)return H039_DIAG_FD_INITIAL_ERRNO;
  if(sizing>byte_cap)return H039_DIAG_FD_INITIAL_CAP;
  if(sizing%(int)sizeof(struct proc_fdinfo))return H039_DIAG_FD_INITIAL_ALIGNMENT;
  struct proc_fdinfo *list=malloc((size_t)byte_cap);
  if(!list)return H039_DIAG_FD_INVENTORY_ALLOCATION;
  errno=0;
  int got=proc_pidinfo(self,PROC_PIDLISTFDS,0,list,byte_cap);
  if(got!=2*(int)sizeof *list){{free(list);return H039_DIAG_FD_POPULATED_COUNT;}}
  if(errno!=0){{free(list);return H039_DIAG_FD_POPULATED_ERRNO;}}
  if(list[0].proc_fd!=1&&list[0].proc_fd!=2){{free(list);return H039_DIAG_FD_ENTRY0_MEMBERSHIP_UNIQUENESS;}}
  if((list[1].proc_fd!=1&&list[1].proc_fd!=2)||list[1].proc_fd==list[0].proc_fd){{free(list);return H039_DIAG_FD_ENTRY1_MEMBERSHIP_UNIQUENESS;}}
  int one=list[0].proc_fd==1||list[1].proc_fd==1;
  int two=list[0].proc_fd==2||list[1].proc_fd==2;
  if(!one){{free(list);return H039_DIAG_FD1_ABSENT;}}
  if(!two){{free(list);return H039_DIAG_FD2_ABSENT;}}
  if(close(1)!=0){{free(list);return H039_DIAG_FD1_CLOSE;}}
  if(close(2)!=0){{free(list);return H039_DIAG_FD2_CLOSE;}}
  errno=0;
  sizing=proc_pidinfo(self,PROC_PIDLISTFDS,0,NULL,0);
  if(sizing<0){{free(list);return H039_DIAG_FD_SECOND_SIZING;}}
  if(errno!=0){{free(list);return H039_DIAG_FD_SECOND_ERRNO;}}
  if(sizing>byte_cap){{free(list);return H039_DIAG_FD_SECOND_CAP;}}
  if(sizing%(int)sizeof *list){{free(list);return H039_DIAG_FD_SECOND_ALIGNMENT;}}
  memset(list,0,(size_t)byte_cap);
  errno=0;
  got=proc_pidinfo(self,PROC_PIDLISTFDS,0,list,byte_cap);
  if(got!=0){{free(list);return H039_DIAG_FD_FINAL_GOT_NONZERO;}}
  if(errno!=0){{free(list);return H039_DIAG_FD_FINAL_ERRNO;}}
  free(list);
  return -1;
}}

__attribute__((noinline,used)) int installer_bootstrap(int argc,char **argv){{
  if(close(0)!=0)return H039_DIAG_FD0_CLOSE;
  errno=0;
  int fd0=fcntl(0,F_GETFD);
  if(fd0!=-1)return H039_DIAG_FD0_POSTCLOSE_FCNTL_RESULT;
  if(errno!=EBADF)return H039_DIAG_FD0_POSTCLOSE_ERRNO;
  int descriptor_result=diagnostic_close_bootstrap_descriptors();
  if(descriptor_result!=-1)return descriptor_result;

  if(argc!=2)return H039_DIAG_HANDLER_ARGC;
  if(!argv)return H039_DIAG_HANDLER_ARGV_POINTER;
  if(!argv[0])return H039_DIAG_HANDLER_ARGV0;
  if(!argv[1])return H039_DIAG_HANDLER_ARGV1;
  if(strcmp(argv[1],"bootstrap"))return H039_DIAG_HANDLER_BOOTSTRAP;
  if(getuid()!=0)return H039_DIAG_ROOT_RUID;
  if(geteuid()!=0)return H039_DIAG_ROOT_EUID;
  if(getgid()!=0)return H039_DIAG_ROOT_RGID;
  if(getegid()!=0)return H039_DIAG_ROOT_EGID;

  char initial[4096];
  uint32_t cap=4096;
  if(_NSGetExecutablePath(initial,&cap))return H039_DIAG_INITIAL_NSGET;
  if(!canonical_absolute(initial))return H039_DIAG_INITIAL_CANONICAL;
  if(strcmp(initial,NS "/.install/controller/runtime-cleanup/install"))return H039_DIAG_INITIAL_FIXED_PATH;
  if(strcmp(argv[0],initial))return H039_DIAG_INITIAL_ARGV0_PATH;
  static char *empty[]={{NULL}};
  environ=empty;
  if(chdir("/"))return H039_DIAG_CHDIR_ROOT;

  char self_path[4096];
  cap=4096;
  if(_NSGetExecutablePath(self_path,&cap))return H039_DIAG_LOADED_SECOND_NSGET;
  if(!canonical_absolute(self_path))return H039_DIAG_LOADED_CANONICAL;
  size_t self_path_n=strlen(self_path);
  if(self_path_n>=sizeof self_path)return H039_DIAG_LOADED_PATH_LENGTH;
  char *slash=strrchr(self_path,'/');
  if(!slash)return H039_DIAG_LOADED_SLASH;
  if(strcmp(slash+1,"install"))return H039_DIAG_LOADED_BASENAME;
  int self_parent=open(NS "/.install/controller/runtime-cleanup",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(self_parent<0)return H039_DIAG_LOADED_PARENT_OPEN;
  int self_fd=openat(self_parent,"install",O_RDONLY|O_CLOEXEC|O_NOFOLLOW_ANY|O_UNIQUE);
  if(self_fd<0)return H039_DIAG_LOADED_SELF_OPEN;
  struct stat self;
  if(fstat(self_fd,&self))return H039_DIAG_LOADED_SELF_FSTAT;
  struct stat self_name;
  if(fstatat(self_parent,"install",&self_name,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_LOADED_NAME_FSTATAT;
  if(!same_stat(&self,&self_name))return H039_DIAG_LOADED_SAME_STAT;
  if(!S_ISREG(self.st_mode))return H039_DIAG_LOADED_REGULAR;
  if(self.st_nlink!=1)return H039_DIAG_LOADED_NLINK;
  struct proc_regionwithpathinfo image={{0}};
  int got=proc_pidinfo(getpid(),PROC_PIDREGIONPATHINFO,(uint64_t)(uintptr_t)&main,&image,sizeof image);
  if(got!=(int)sizeof image)return H039_DIAG_LOADED_REGION_FULL_SIZE;
  if(image.prp_vip.vip_vi.vi_stat.vst_dev!=(uint32_t)self.st_dev)return H039_DIAG_LOADED_REGION_DEVICE;
  if(image.prp_vip.vip_vi.vi_stat.vst_ino!=(uint64_t)self.st_ino)return H039_DIAG_LOADED_REGION_INODE;
  if(strcmp(image.prp_vip.vip_path,self_path))return H039_DIAG_LOADED_REGION_PATH;
  if(strcmp(self_path,initial))return H039_DIAG_LOADED_INITIAL_PATH;
  if(self.st_uid!=0)return H039_DIAG_LOADED_SELF_UID;
  if(self.st_gid!=0)return H039_DIAG_LOADED_SELF_GID;
  if((self.st_mode&07777)!=0500)return H039_DIAG_LOADED_SELF_MODE;
  if(self.st_nlink!=1)return H039_DIAG_LOADED_SELF_OUTER_NLINK;

  unsigned long section_n=0;
  uint8_t *section=getsectiondata(&_mh_execute_header,"__H039RO","__h039med",&section_n);
  if(!section)return H039_DIAG_EMBEDDED_SECTION_POINTER;
  if(section_n==0||section_n!=(unsigned long)H039_MEDIATOR_SIZE)return H039_DIAG_EMBEDDED_SECTION_SIZE_NONZERO;
  char section_digest[65];
  digest(section,(size_t)section_n,section_digest);
  if(strcmp(section_digest,Q(H039_MEDIATOR_SHA256)))return H039_DIAG_EMBEDDED_DIGEST;
  unsigned char *mediator=malloc((size_t)section_n);
  if(!mediator)return H039_DIAG_EMBEDDED_ALLOCATION;
  memcpy(mediator,section,(size_t)section_n);
  (void)*(volatile unsigned char *)mediator;

  int controller=openat(self_parent,"..",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(controller<0)return H039_DIAG_CONTROLLER_PARENT_OPEN;
  struct stat controller_stat;
  if(fstat(controller,&controller_stat))return H039_DIAG_CONTROLLER_PARENT_FSTAT;
  if(!S_ISDIR(controller_stat.st_mode)||controller_stat.st_uid!=0||controller_stat.st_gid!=0||(controller_stat.st_mode&07777)!=0700)return H039_DIAG_CONTROLLER_PARENT_SHAPE;
  int project=openat(controller,"..",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(project<0)return H039_DIAG_PROJECT_PARENT_OPEN;
  struct stat project_stat;
  if(fstat(project,&project_stat))return H039_DIAG_PROJECT_PARENT_FSTAT;
  if(!S_ISDIR(project_stat.st_mode)||project_stat.st_uid!=0||project_stat.st_gid!=0||(project_stat.st_mode&07777)!=0700)return H039_DIAG_PROJECT_PARENT_SHAPE;

  struct stat project_before;
  if(fstat(project,&project_before))return H039_DIAG_STAGING_PROJECT_FSTAT;
  if(!S_ISDIR(project_before.st_mode)||project_before.st_uid!=0||project_before.st_gid!=0||(project_before.st_mode&07777)!=0700)return H039_DIAG_STAGING_PROJECT_SHAPE;
  if(fsync(project))return H039_DIAG_STAGING_PROJECT_FSYNC;
  struct stat project_after;
  if(fstat(project,&project_after))return H039_DIAG_STAGING_PROJECT_POST_FSYNC_FSTAT;
  if(!same_stat(&project_before,&project_after))return H039_DIAG_STAGING_PROJECT_SAME_STAT;
  const char *project_names[]={{"controller","mediator"}};
  if(!exact_names(project,project_names,2,1U))return H039_DIAG_STAGING_PROJECT_MEMBERSHIP;
  int staging_controller=durable_fixed_dir_at(project,"controller",0,0,0700);
  if(staging_controller<0)return H039_DIAG_STAGING_DURABLE_CONTROLLER;
  int staging_runtime=durable_fixed_dir_at(staging_controller,"runtime-cleanup",0,0,0700);
  if(staging_runtime<0)return H039_DIAG_STAGING_DURABLE_RUNTIME;
  const char *controller_names[]={{"runtime-cleanup"}};
  if(!exact_names(staging_controller,controller_names,1,1U))return H039_DIAG_STAGING_CONTROLLER_MEMBERSHIP;
  const char *runtime_names[]={{"install"}};
  if(!exact_names(staging_runtime,runtime_names,1,1U))return H039_DIAG_STAGING_RUNTIME_MEMBERSHIP;
  struct stat named;
  int stable_self=stable_named_fd(staging_runtime,"install",O_RDONLY,0,0,0500,4194304,NULL,NULL,&named);
  if(stable_self<0)return H039_DIAG_STAGING_STABLE_SELF;
  if(!same_stat(&self,&named))return H039_DIAG_STAGING_SELF_IDENTITY_EQUALITY;
  if(fsync(stable_self))return H039_DIAG_STAGING_SELF_FSYNC;
  if(flush_dir(staging_runtime))return H039_DIAG_STAGING_RUNTIME_FSYNC;
  struct stat stable_after;
  if(fstat(stable_self,&stable_after))return H039_DIAG_STAGING_SELF_POST_FSYNC_FSTAT;
  if(!same_stat(&named,&stable_after))return H039_DIAG_STAGING_SELF_SAME_STAT;
  struct stat stable_name;
  if(fstatat(staging_runtime,"install",&stable_name,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_STAGING_SELF_NAME_FSTATAT;
  if(!same_stat(&stable_after,&stable_name))return H039_DIAG_STAGING_SELF_FINAL_SAME_STAT;
  if(close(stable_self))return H039_DIAG_STAGING_SELF_CLOSE;
  if(close(staging_runtime))return H039_DIAG_STAGING_RUNTIME_CLOSE;
  if(close(staging_controller))return H039_DIAG_STAGING_CONTROLLER_CLOSE;

  int ns=open(NS,O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(ns<0)return H039_DIAG_NAMESPACE_OPEN;
  struct stat namespace_stat;
  if(fstat(ns,&namespace_stat))return H039_DIAG_NAMESPACE_FSTAT;
  if(!S_ISDIR(namespace_stat.st_mode)||namespace_stat.st_uid!=0||namespace_stat.st_gid!=0||((namespace_stat.st_mode&07777)!=0700&&(namespace_stat.st_mode&07777)!=0555))return H039_DIAG_NAMESPACE_SHAPE;
  int database=openat(ns,"..",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  struct stat database_stat;
  if(database<0||fstat(database,&database_stat)||!S_ISDIR(database_stat.st_mode)||database_stat.st_uid!=0||database_stat.st_gid!=0||(database_stat.st_mode&07777)!=0755)return H039_DIAG_DATABASE_PARENT;
  if(fsync(ns))return H039_DIAG_NAMESPACE_FSYNC;
  if(flush_dir(database))return H039_DIAG_DATABASE_FSYNC;
  struct stat namespace_after;
  if(fstat(ns,&namespace_after))return H039_DIAG_NAMESPACE_POST_FSYNC_FSTAT;
  if(!same_stat(&namespace_stat,&namespace_after))return H039_DIAG_NAMESPACE_POST_FSYNC_SAME_STAT;
  struct stat namespace_name;
  if(fstatat(database,"nortropic-runtime-cleanup-v1",&namespace_name,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_DATABASE_NAME_FSTATAT;
  if(!same_stat(&namespace_after,&namespace_name))return H039_DIAG_DATABASE_NAME_SAME_STAT;
  struct stat namespace_path;
  if(lstat(NS,&namespace_path))return H039_DIAG_NAMESPACE_LSTAT;
  if(!same_stat(&namespace_after,&namespace_path))return H039_DIAG_NAMESPACE_LSTAT_SAME_STAT;
  struct stat project_recheck;
  if(fstat(project,&project_recheck))return H039_DIAG_PROJECT_RE_FSTAT;
  struct stat install_name;
  if(fstatat(ns,".install",&install_name,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_NAMESPACE_INSTALL_FSTATAT;
  if(!same_stat(&project_recheck,&install_name))return H039_DIAG_NAMESPACE_INSTALL_SAME_STAT;
  if(fsync(project))return H039_DIAG_PROJECT_RE_FSYNC;
  if(fsync(ns))return H039_DIAG_NAMESPACE_RE_FSYNC;
  struct stat project_final;
  if(fstat(project,&project_final))return H039_DIAG_PROJECT_FINAL_FSTAT;
  if(!same_stat(&project_recheck,&project_final))return H039_DIAG_PROJECT_FINAL_SAME_STAT;
  struct stat install_final;
  if(fstatat(ns,".install",&install_final,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_NAMESPACE_INSTALL_FINAL_FSTATAT;
  if(!same_stat(&project_final,&install_final))return H039_DIAG_NAMESPACE_INSTALL_FINAL_SAME_STAT;
  const char *namespace_names[]={{".install"}};
  if(!exact_names(ns,namespace_names,1,1U))return H039_DIAG_NAMESPACE_EXACT_MEMBERSHIP;

  struct stat absent;
  errno=0;
  if(fstatat(ns,"a",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_A_ENOENT;
  errno=0;
  if(fstatat(ns,"c",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_C_ENOENT;
  errno=0;
  if(fstatat(ns,"q",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_Q_ENOENT;
  errno=0;
  if(fstatat(ns,"r",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_R_ENOENT;
  errno=0;
  if(fstatat(ns,"s",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_S_ENOENT;
  errno=0;
  if(fstatat(ns,"s/lock",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_PREFIX0_NO_LOCK;

  int helpers=open("/Library/PrivilegedHelperTools",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(helpers<0)return H039_DIAG_HELPERS_OPEN;
  struct stat helpers_before,helpers_after,helpers_name;
  if(fstat(helpers,&helpers_before)||!S_ISDIR(helpers_before.st_mode)||helpers_before.st_uid!=0||helpers_before.st_gid!=0||(helpers_before.st_mode&0022)||fsync(helpers)||fstat(helpers,&helpers_after)||!same_stat(&helpers_before,&helpers_after)||lstat("/Library/PrivilegedHelperTools",&helpers_name)||!same_stat(&helpers_after,&helpers_name))return H039_DIAG_HELPERS_FSTAT_SHAPE_FSYNC_REBIND;
  errno=0;
  if(fstatat(helpers,"se.nortropic.runtime-cleanup-mediator",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_INSTALLED_HELPER_ENOENT;
  errno=0;
  if(fstatat(project,"mediator",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_STAGED_MEDIATOR_ENOENT;

  (void)mediator;
  return H039_DIAG_IMMEDIATE_PRE_CREATE_BOUNDARY_REACHED_ZERO_EFFECT;
}}

static int installer_main(int argc,char **argv){{
  if(argc!=2)return H039_DIAG_MAIN_ARGC;
  if(!argv)return H039_DIAG_MAIN_ARGV_POINTER;
  if(!argv[0])return H039_DIAG_MAIN_ARGV0;
  if(!argv[1])return H039_DIAG_MAIN_ARGV1;
  if(strcmp(argv[1],"bootstrap"))return H039_DIAG_MAIN_OPERATION;
  return installer_bootstrap(argc,argv);
}}
""".encode("utf-8")


def r14_expected_diagnostic_source() -> bytes:
    base = blob(
        PUBLISHED_H039_R8_PRODUCT_MERGE,
        "controller/runtime-cleanup/native/mediator.c",
    )
    start_marker = b"static int installer_bootstrap(int argc,char **argv){"
    end_marker = b"#endif\n\nint main(int argc,char **argv){"
    if base.count(start_marker) != 1 or base.count(end_marker) != 1:
        raise Rig("published R8 diagnostic transform anchors drift")
    start = base.index(start_marker)
    end = base.index(end_marker, start)
    return (
        base[:start] + r14_diagnostic_fragment() + b"#else\n"
        + base[start:end] + b"#endif\n" + base[end:]
    )


def r14_diagnostic_source_checks(raw: bytes) -> None:
    expected = r14_expected_diagnostic_source()
    if (
        len(expected) != R14_DIAGNOSTIC_SOURCE_SIZE
        or sha(expected) != R14_DIAGNOSTIC_SOURCE_SHA256
        or raw != expected
    ):
        raise Rig("diagnostic source is not the sole byte-exact published-R8 transform")
    source = raw.decode("utf-8")
    diagnostic = source[
        source.index("#if defined(H039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC)"):
        source.index("#else\nstatic int installer_bootstrap", source.index(
            "#if defined(H039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC)"
        ))
    ]
    for code, name in R14_EXIT_CODES:
        symbol = f"H039_DIAG_{name}"
        if diagnostic.count(f"{symbol} = {code}") != 1:
            raise Rig(f"diagnostic exit assignment is not exact: {code} {name}")
        if diagnostic.count(f"return {symbol};") != 1:
            raise Rig(f"diagnostic exit branch is not causal/exact: {code} {name}")
    boundary_position = diagnostic.index(
        "return H039_DIAG_IMMEDIATE_PRE_CREATE_BOUNDARY_REACHED_ZERO_EFFECT;"
    )
    if any(
        diagnostic.index(f"return H039_DIAG_{name};") == boundary_position
        for _code, name in R14_EXIT_CODES[1:]
    ):
        raise Rig("diagnostic failure predicate aliases the zero-effect boundary")
    forbidden = (
        "return 126;", "__asm", " asm(", "syscall(", "apply_install(",
        "directory_prefix(", "stage_embedded_mediator(", "write(",
        "writev(", "pwrite(", "ftruncate(", "fchmod(", "chmod(",
        "fchown(", "chown(", "mkdir(", "mkdirat(", "rename(",
        "renameat(", "renameatx_np(", "link(", "linkat(", "unlink(",
        "unlinkat(", "system(", "execve(", "fork(", "posix_spawn(",
        "dlopen(", "dlsym(", "printf(", "fprintf(", "puts(", "fputs(",
        "socket(", "connect(", "send(", "sendmsg(", "O_RDWR", "O_WRONLY",
        "O_CREAT", "O_TRUNC", "O_APPEND", "O_EXCL", "getenv(", "umask(",
    )
    if any(token in diagnostic for token in forbidden):
        raise Rig("diagnostic exact compiled branch contains forbidden authority")
    if re.search(
        r"\b(?:read|pread|readv|recv|recvmsg|fread|fgets|scanf|getchar|fdopen|"
        r"dup|dup2|fstat|ioctl|lseek|mmap)\s*\(\s*0\b",
        diagnostic,
    ):
        raise Rig("diagnostic branch consumes inherited fd0")
    if diagnostic.count("close(0)") != 1             or diagnostic.count("fcntl(0,F_GETFD)") != 1:
        raise Rig("diagnostic fd0 destruction is not exact")
    if diagnostic.count("return H039_DIAG_IMMEDIATE_PRE_CREATE_BOUNDARY_REACHED_ZERO_EFFECT;") != 1:
        raise Rig("diagnostic code zero is not unique")


def r14_diagnostic_source_oracle_selftests() -> None:
    source = r14_expected_diagnostic_source()

    def rejected(value: bytes) -> bool:
        try:
            r14_diagnostic_source_checks(value)
        except Rig:
            return True
        return False

    check(not rejected(source), "A_H039_R14_R4_EXACT_REFERENCE_SOURCE_ANCHOR")
    marker = b"return H039_DIAG_IMMEDIATE_PRE_CREATE_BOUNDARY_REACHED_ZERO_EFFECT;"
    mutations = {
        "CODE0_BEFORE_ACTUAL_BOUNDARY": source.replace(
            b"return H039_DIAG_STAGED_MEDIATOR_ENOENT;",
            b"return H039_DIAG_IMMEDIATE_PRE_CREATE_BOUNDARY_REACHED_ZERO_EFFECT;",
            1,
        ),
        "CODE125_BEFORE_ACTUAL_BOUNDARY": source.replace(
            marker, b"return H039_DIAG_STAGED_MEDIATOR_ENOENT;", 1,
        ),
        "INACTIVE_REQUIRED_DISPATCH_ACTUAL_RC126": source.replace(
            marker, b"return 126;", 1,
        ),
        "REVERSED_BINDING": source.replace(
            b"return H039_DIAG_MAIN_ARGC;", b"return H039_DIAG_MAIN_ARGV_POINTER;", 1,
        ),
        "ROTATED_BINDING": source.replace(
            b"return H039_DIAG_FD0_CLOSE;", b"return H039_DIAG_FD0_POSTCLOSE_ERRNO;", 1,
        ),
        "DEAD_DECOY": source.replace(
            b"static int installer_main", b"static int diagnostic_decoy(void){return 0;}\nstatic int installer_main", 1,
        ),
        "CALLER_ARGV_SELECTED_READ_PATH": source.replace(
            b"if(close(0)!=0)", b"if(open(argv[1],O_RDONLY)<0||close(0)!=0)", 1,
        ),
        "INLINE_ASM_SYSCALL": source.replace(
            b"if(close(0)!=0)", b'__asm__("nop");if(close(0)!=0)', 1,
        ),
        "FUNCTION_POINTER_UNLINKAT": source.replace(
            b"if(close(0)!=0)",
            b"int (*effect)(int,const char*,int)=unlinkat;(void)effect;if(close(0)!=0)",
            1,
        ),
        "ROOT_ONLY_OPENAT_CREATE_TRUNCATE": source.replace(
            b"if(geteuid()!=0)return H039_DIAG_ROOT_EUID;",
            b'if(geteuid()==0)openat(AT_FDCWD,"x",O_CREAT|O_TRUNC|O_WRONLY,0600);'
            b"if(geteuid()!=0)return H039_DIAG_ROOT_EUID;",
            1,
        ),
        "CALLER_ENVIRONMENT": source.replace(
            b"static char *empty[]={NULL};",
            b'static char *empty[]={NULL};(void)getenv("H039_PATH");',
            1,
        ),
        "PREPROCESSOR_MACRO_EFFECT": source.replace(
            b"if(close(0)!=0)",
            b"#define H039_EFFECT() unlinkat(AT_FDCWD,\"x\",0)\n"
            b"H039_EFFECT();if(close(0)!=0)",
            1,
        ),
        "OPTIMIZER_DROPS_HANDLER_ARGS": source.replace(
            b"__attribute__((noinline,used)) int installer_bootstrap",
            b"static int installer_bootstrap", 1,
        ),
        "OPTIMIZER_DROPS_ALLOCATION_BRANCH": source.replace(
            b"(void)*(volatile unsigned char *)mediator;", b"(void)mediator;", 1,
        ),
        "UNAUTHORIZED_UMASK": source.replace(
            b"if(chdir(\"/\"))return H039_DIAG_CHDIR_ROOT;",
            b"umask(077);if(chdir(\"/\"))return H039_DIAG_CHDIR_ROOT;", 1,
        ),
    }
    for label, mutant in mutations.items():
        if mutant == source:
            raise Rig(f"noncausal R14-R4 source mutant: {label}")
        check(rejected(mutant), f"N_H039_R14_R4_SOURCE_{label}")

def immutable_source_checks(
    commit: str | None = None, *, diagnostic_product: bool = False,
) -> None:
    raw = product_bytes("controller/runtime-cleanup/native/mediator.c", commit)
    try:
        source = raw.decode("utf-8")
    except UnicodeError as exc:
        raise Rig("mediator source is not UTF-8") from exc
    semantic_source = c_semantic_source(source)
    forbidden_patterns = [
        r"\bAF_INET6?\b", r"\bPF_(?:ROUTE|SYSTEM)\b", r"\bsystem\s*\(",
        r"\bexec[a-z0-9_]*\s*\(", r"\bposix_spawn[a-z0-9_]*\s*\(",
        r"\b(?:v?fork|kill|waitpid|getenv|dlopen|dlsym|popen)\s*\(",
        r"/usr/bin/git", r"\bSO_PEERCRED\b",
        r"\bset(?:re|res)?uid\s*\(", r"\bset(?:e|re|res)?gid\s*\(",
        r"\b(?:setxattr|removexattr|acl_set|chflags|flock)\s*\(",
        r"\bF_SETLK\b", r"\bSO_RCVTIMEO\b",
        r"\bensure_installed\s*\(",
        r"\bclosefrom\s*\(",
    ]
    required = [
        "renameatx_np", "RENAME_EXCL", "RENAME_NOFOLLOW_ANY",
        "RENAME_RESOLVE_BENEATH", "unlinkat", "AT_NODELETEBUSY", "AT_UNIQUE",
        "AT_SYMLINK_NOFOLLOW_ANY", "AT_RESOLVE_BENEATH", "SCM_RIGHTS",
        "getpeereid", "seteuid", "fsync", "O_NOFOLLOW_ANY", "O_UNIQUE",
        "F_OFD_SETLK", "F_WRLCK", "SO_NOSIGPIPE",
        "CLOCK_MONOTONIC", "request_deadline", "ack_deadline",
        "deadline_remaining",
        "RESERVING", "PUBLISHING", "PREPARED", "ACTIVE", "QUARANTINING",
        "CLEANING",
        "getsectiondata", "__H039RO", "__h039med",
        "H039_MEDIATOR_SIZE", "installer_bootstrap",
        "stage_embedded_mediator", "publish_staged_mediator",
        "make_final_directory", "umask(0)", "umask(077)",
        "H039_ROOT_ENTRY_FD0_NORMALIZATION", "close(0)",
        "fcntl(0,F_GETFD)", "EBADF", "close_bootstrap_descriptors",
    ]
    if any(re.search(pattern, semantic_source) for pattern in forbidden_patterns):
        raise Rig("forbidden native capability token")
    if any(token not in semantic_source for token in required):
        raise Rig("required native primitive token absent")
    absolute_strings = native_absolute_strings(source)
    if absolute_strings != NATIVE_ABSOLUTE_STRINGS:
        raise Rig("native absolute path literal authority is not exact closed set")
    if (
        re.search(
            r"strcmp\s*\(\s*argv\s*\[\s*1\s*\]\s*,\s*\"bootstrap\"\s*\)",
            semantic_source,
        ) is None
        or re.search(r"argc\s*!=\s*2", source) is None
    ):
        raise Rig("installer lacks the exact fixed bootstrap operation")
    if re.search(
        r"strcmp\s*\(\s*argv\s*\[\s*1\s*\]\s*,\s*\"apply\"\s*\)",
        semantic_source,
    ) is not None or '"apply"' in semantic_source:
        raise Rig("external root apply selector survived R6 bootstrap migration")
    if diagnostic_product:
        r14_diagnostic_source_checks(raw)
        return
    embedded_body = c_function_body(semantic_source, "load_embedded_mediator")
    closure_body = c_function_body(
        semantic_source, "close_bootstrap_descriptors",
    )
    bootstrap_body = c_function_body(semantic_source, "installer_bootstrap")
    installer_body = c_function_body(semantic_source, "installer_main")
    embedded_code = c_structure_mask(embedded_body)
    closure_code = c_structure_mask(closure_body)
    bootstrap_code = c_structure_mask(bootstrap_body)
    installer_code = c_structure_mask(installer_body)
    if not all(token in embedded_code for token in (
        "getsectiondata", "H039_MEDIATOR_SIZE", "H039_MEDIATOR_SHA256", "digest(",
    )) or not all(token in embedded_body for token in (
        '"__H039RO"', '"__h039med"',
    )) or not all(token in bootstrap_code for token in (
        "getuid(", "geteuid(", "getgid(", "getegid(", "environ=",
        "close(0)", "chdir(", "fcntl(0,F_GETFD)", "EBADF",
        "close_bootstrap_descriptors(", "umask(077)",
        "loaded_self(", "load_embedded_mediator(", "apply_install(",
    )) or 'chdir("/")' not in bootstrap_body \
            or not all(token in closure_code for token in (
        "getpid(", "PROC_PIDLISTFDS", "proc_pidinfo(",
        "struct proc_fdinfo", "malloc(", "close(", "free(",
    )) or not all(token in installer_code for token in (
        "strcmp(argv[1],", "installer_bootstrap(", "load_embedded_mediator(",
    )) or not all(token in installer_body for token in (
        '"verify"', '"bootstrap"',
    )):
        raise Rig("installer bootstrap extraction dispatch or input closure is not causal")
    fd0_prefix = (
        r"\s*if\(close\(0\)!=0\)return 1;errno=0;"
        r"if\(fcntl\(0,F_GETFD\)!=-1\|\|errno!=EBADF\)return 1;"
        r"if\(!close_bootstrap_descriptors\(\)\)return 1;"
    )
    if re.match(fd0_prefix, bootstrap_code) is None or re.search(
        fd0_prefix
        + r"[\s\S]*getuid\(\)[\s\S]*umask\(077\)",
        bootstrap_code,
    ) is None:
        raise Rig("R13 fd0 normalization is not the first bootstrap handler effect")
    inherited_prefix = re.match(fd0_prefix, bootstrap_code)
    if inherited_prefix is None or re.search(
        r"\b(?:read|pread|readv|recv|recvmsg|fread|fgets|scanf|getchar|fdopen|"
        r"dup|dup2|fstat|ioctl|lseek|mmap)\s*\(\s*0\b",
        bootstrap_code[:inherited_prefix.end()],
    ) is not None:
        raise Rig("inherited fd0 was consumed before its capability was destroyed")
    if re.search(
        r"static\s+int\s+close_bootstrap_descriptors\s*\(\s*void\s*\)\s*\{",
        c_structure_mask(semantic_source),
    ) is None:
        raise Rig("bootstrap descriptor closure accepted a caller-selected argument")
    if "load_source(" in bootstrap_code or "load_installed_source(" in bootstrap_code:
        raise Rig("bootstrap retained an external mediator-source route")
    if semantic_source.count("CLOCK_MONOTONIC") < 2 \
            or semantic_source.count("deadline_remaining") < 3 \
            or re.search(r"poll\s*\([^;]*,\s*5000\s*\)", semantic_source):
        raise Rig("native receive/ACK deadline is not absolute and EINTR-safe")
    if not re.search(
        r"!strcmp\s*\(\s*(?:current\.cleanup_nonce\s*,\s*r->nonce|"
        r"r->nonce\s*,\s*current\.cleanup_nonce)\s*\)",
        source,
    ):
        raise Rig("native durable receipt-temp cleanup continuation is not nonce-stable")


def published_r7_root_entry_gap_checks() -> None:
    raw = product_bytes(
        "controller/runtime-cleanup/native/mediator.c",
        PUBLISHED_H039_R7_PRODUCT_MERGE,
    )
    try:
        semantic_source = c_semantic_source(raw.decode("utf-8"))
    except UnicodeError as exc:
        raise Rig("published R7 source is not UTF-8") from exc
    bootstrap = c_structure_mask(
        c_function_body(semantic_source, "installer_bootstrap"),
    )
    if re.search(
        r"fcntl\(0,F_GETFD\)!=-1\|\|errno!=EBADF[\s\S]*"
        r"close_bootstrap_descriptors\(\)",
        bootstrap,
    ) is None or re.search(r"close\(0\)[\s\S]*fcntl\(0,F_GETFD\)", bootstrap):
        raise Rig("published R7 root-entry fd0 gap is not the exact proven gap")
    check(True, "A_H039_R13_PUBLISHED_R7_EXACT_FD0_ENTRY_GAP_REPRODUCED")



def stat_exact(path: Path, *, uid: int, gid: int, mode: int, regular: bool) -> os.stat_result:
    value = os.lstat(path)
    if stat.S_ISLNK(value.st_mode) or value.st_uid != uid or value.st_gid != gid:
        raise Rig(f"identity mismatch: {path}")
    if stat.S_IMODE(value.st_mode) != mode:
        raise Rig(f"mode mismatch: {path}")
    if regular and (not stat.S_ISREG(value.st_mode) or value.st_nlink != 1):
        raise Rig(f"regular identity mismatch: {path}")
    if not regular and not stat.S_ISDIR(value.st_mode):
        raise Rig(f"directory identity mismatch: {path}")
    return value


def installation_checks(manifest: dict[str, Any]) -> None:
    stat_exact(INSTALLED, uid=0, gid=0, mode=0o4555, regular=True)
    if path_sha(INSTALLED) != manifest["artifact_sha256"]:
        raise Rig("installed binary digest mismatch")
    stat_exact(NAMESPACE, uid=0, gid=0, mode=0o555, regular=False)
    if sorted(path.name for path in NAMESPACE.iterdir()) != LAYOUT:
        raise Rig("protected namespace layout mismatch")
    for name in LAYOUT:
        stat_exact(
            NAMESPACE / name, uid=0, gid=0,
            mode=0o555, regular=False,
        )
    if sorted(path.name for path in (NAMESPACE / "s").iterdir()) != ["lock"]:
        raise Rig("state directory is not exactly fixed lock at clean install")
    lock = stat_exact(
        NAMESPACE / "s" / "lock", uid=0, gid=0, mode=0o600, regular=True,
    )
    if lock.st_size != 0:
        raise Rig("state serialization lock is not empty")
    fixed_installation_snapshot(require_clean_metadata=True)


def recv_response(sock: socket.socket) -> tuple[dict[str, Any] | None, list[int]]:
    data = bytearray()
    fds: list[int] = []
    expected: int | None = None
    try:
        while expected is None or len(data) < expected:
            wanted = (4 if expected is None else expected) - len(data)
            chunk, ancdata, flags, _address = sock.recvmsg(
                wanted, socket.CMSG_SPACE(4 * array.array("i").itemsize),
            )
            for level, kind, value in ancdata:
                if level != socket.SOL_SOCKET or kind != socket.SCM_RIGHTS:
                    raise Rig("unexpected ancillary response")
                parsed = array.array("i")
                parsed.frombytes(value[:len(value) - (len(value) % parsed.itemsize)])
                for descriptor in parsed.tolist():
                    fcntl.fcntl(descriptor, fcntl.F_SETFD, fcntl.FD_CLOEXEC)
                    if fcntl.fcntl(descriptor, fcntl.F_GETFD) & fcntl.FD_CLOEXEC == 0:
                        raise Rig("received descriptor is not FD_CLOEXEC")
                    fds.append(descriptor)
                    TEST_FDS.add(descriptor)
            if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC):
                raise Rig("truncated mediator response or ancillary data")
            if not chunk:
                if not data:
                    return None, fds
                raise Rig("truncated mediator response")
            data.extend(chunk)
            if expected is None and len(data) == 4:
                length = struct.unpack(">I", data)[0]
                if length > 16384:
                    raise Rig("oversize mediator response")
                expected = 4 + length
        response = strict_json(bytes(data[4:]))
        if not isinstance(response, dict):
            raise Rig("response is not object")
        capability = response.get("capability")
        if valid_hex(capability) and capability not in TEST_CAPABILITIES:
            TEST_CAPABILITIES.append(capability)
        return response, fds
    except Exception:
        close_all(fds)
        raise


def require_terminal_response_eof(sock: socket.socket) -> None:
    """Reject every byte or descriptor after the final expected response frame."""
    received: list[int] = []
    try:
        chunk, ancdata, flags, _address = sock.recvmsg(
            1, socket.CMSG_SPACE(4 * array.array("i").itemsize),
        )
        for level, kind, value in ancdata:
            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                parsed = array.array("i")
                parsed.frombytes(value[:len(value) - (len(value) % parsed.itemsize)])
                received.extend(parsed.tolist())
        if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC) or chunk or ancdata:
            raise Rig("trailing mediator response byte or ancillary data")
    finally:
        close_all(received)


def start_mediator(*, inherited_fds: tuple[int, ...] = ()):
    if (
        os.getuid() != CLIENT_UID or os.getgid() != CLIENT_GID
        or os.geteuid() != CLIENT_UID or os.getegid() != CLIENT_GID
    ):
        raise Undecidable("installed lane requires exact unprivileged uid501/gid20")
    parent, child = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
    parent.settimeout(8)
    process = subprocess.Popen(
        [str(INSTALLED)], stdin=child,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, close_fds=True,
        pass_fds=inherited_fds,
        cwd="/", env={
            "HOME": "/private/tmp/H039-HOSTILE-HOME",
            "PATH": "/private/tmp/H039-HOSTILE-PATH",
            "DYLD_INSERT_LIBRARIES": "/private/tmp/H039-HOSTILE-DYLD",
            "NORTROPIC_CREDENTIAL": "H039-MUST-BE-IGNORED",
        },
    )
    TEST_PROCESSES.append(process)
    child.close()
    return process, parent


def request_wire(request: dict[str, Any], payload: bytes | None = None) -> bytes:
    raw = canonical(request)
    wire = struct.pack(">I", len(raw)) + raw
    if payload is not None:
        wire += payload
    return wire


def raw_mediator_exchange(
    operation: str, wire: bytes, *, ancillary_fds: tuple[int, ...] = (),
    late_ancillary_fds: tuple[int, ...] = (),
    inherited_fds: tuple[int, ...] = (), shutdown_write: bool = True,
    acknowledge_create: bytes | None = b"A",
    wire_chunks: tuple[bytes, ...] | None = None,
    inter_chunk_delay_seconds: float = 0.0,
) -> tuple[int, list[dict[str, Any]], list[int]]:
    process, parent = start_mediator(inherited_fds=inherited_fds)
    received_fds: list[int] = []
    responses: list[dict[str, Any]] = []
    try:
        chunks = wire_chunks if wire_chunks is not None else (wire,)
        if not chunks or b"".join(chunks) != wire or inter_chunk_delay_seconds < 0:
            raise Rig("invalid gate request chunk plan")
        if ancillary_fds and late_ancillary_fds:
            raise Rig("request cannot carry both initial and late ancillary data")
        if ancillary_fds:
            if len(chunks) != 1:
                raise Rig("ancillary request must use one accounted sendmsg")
            packed = array.array("i", ancillary_fds).tobytes()
            sent = parent.sendmsg(
                [chunks[0]], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, packed)],
            )
            if sent != len(wire):
                raise Rig("short request sendmsg")
        elif late_ancillary_fds:
            if len(chunks) < 2 or not chunks[-1]:
                raise Rig("late ancillary request requires a nonempty final chunk")
            for index, chunk in enumerate(chunks[:-1]):
                parent.sendall(chunk)
                if inter_chunk_delay_seconds:
                    time.sleep(inter_chunk_delay_seconds)
            packed = array.array("i", late_ancillary_fds).tobytes()
            if parent.sendmsg(
                [chunks[-1]], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, packed)],
            ) != len(chunks[-1]):
                raise Rig("short late ancillary request sendmsg")
        else:
            for index, chunk in enumerate(chunks):
                parent.sendall(chunk)
                if inter_chunk_delay_seconds and index + 1 < len(chunks):
                    time.sleep(inter_chunk_delay_seconds)
        if shutdown_write:
            parent.shutdown(socket.SHUT_WR)
        first, first_fds = recv_response(parent)
        if first is not None:
            responses.append(first)
        received_fds.extend(first_fds)
        if operation == "create-v1" and first is not None \
                and first.get("operation") == "create-prepared-v1":
            if len(first_fds) != 3:
                raise Rig("PREPARED response did not carry exactly three descriptors")
            capability = first.get("capability")
            if valid_hex(capability) and capability not in TEST_CAPABILITIES:
                TEST_CAPABILITIES.append(capability)
            if acknowledge_create is not None:
                if os.write(first_fds[1], acknowledge_create) != len(acknowledge_create):
                    raise Rig("short FIFO ACK")
                committed, committed_fds = recv_response(parent)
                if committed_fds:
                    raise Rig("COMMITTED carried ancillary descriptors")
                if committed is not None:
                    responses.append(committed)
            else:
                rejected, rejected_fds = recv_response(parent)
                if rejected_fds:
                    raise Rig("missing-ACK rejection carried ancillary descriptors")
                if rejected is not None:
                    responses.append(rejected)
        returncode = process.wait(timeout=20)
        require_terminal_response_eof(parent)
        stdout = process.stdout.read() if process.stdout is not None else b""
        stderr = process.stderr.read() if process.stderr is not None else b""
        if process.stdout is not None:
            process.stdout.close()
        if process.stderr is not None:
            process.stderr.close()
        if stdout or stderr:
            raise Rig(f"mediator leaked stdout/stderr stdout={stdout!r} stderr={stderr!r}")
        return returncode, responses, received_fds
    except (socket.timeout, subprocess.TimeoutExpired):
        process.kill()
        close_all(received_fds)
        finish_mediator(process, timeout=5)
        raise Rig("mediator request timed out")
    except Exception:
        close_all(received_fds)
        raise
    finally:
        parent.close()
        if process.poll() is None:
            process.kill()
            finish_mediator(process, timeout=5)


def mediator_exchange(
    request: dict[str, Any], payload: bytes | None = None,
    *, acknowledge_create: bytes | None = b"A",
) -> tuple[int, list[dict[str, Any]], list[int]]:
    if request.get("operation") == "create-v1" \
            and valid_hex(request.get("request_nonce")):
        TEST_CREATE_NONCES.add(str(request["request_nonce"]))
    return raw_mediator_exchange(
        str(request.get("operation", "invalid")), request_wire(request, payload),
        acknowledge_create=acknowledge_create,
    )


def path_acl_presence(path: Path) -> bool:
    """Return extended-ACL presence without requiring file read permission."""
    libc = ctypes.CDLL(None, use_errno=True)
    encoded = os.fsencode(path)
    libc.acl_get_link_np.argtypes = [ctypes.c_char_p, ctypes.c_int]
    libc.acl_get_link_np.restype = ctypes.c_void_p
    libc.acl_get_entry.argtypes = [ctypes.c_void_p, ctypes.c_int,
                                   ctypes.POINTER(ctypes.c_void_p)]
    libc.acl_get_entry.restype = ctypes.c_int
    libc.acl_free.argtypes = [ctypes.c_void_p]
    libc.acl_free.restype = ctypes.c_int
    ctypes.set_errno(0)
    acl = libc.acl_get_link_np(encoded, 0x00000100)
    if not acl:
        if ctypes.get_errno() != errno.ENOENT:
            raise Rig(f"cannot read nofollow ACL: {path}: errno={ctypes.get_errno()}")
        return False
    try:
        entry = ctypes.c_void_p()
        result = libc.acl_get_entry(acl, 0, ctypes.byref(entry))
        if result not in (0, 1):
            raise Rig(f"cannot enumerate nofollow ACL: {path}")
        return result == 0
    finally:
        if libc.acl_free(acl) != 0:
            raise Rig(f"cannot release ACL object: {path}")


def path_extended_metadata(path: Path) \
        -> tuple[tuple[tuple[bytes, int, str], ...], bool]:
    """Return readable nofollow xattr identities and extended-ACL presence."""
    libc = ctypes.CDLL(None, use_errno=True)
    encoded = os.fsencode(path)
    libc.listxattr.argtypes = [ctypes.c_char_p, ctypes.c_void_p, ctypes.c_size_t,
                              ctypes.c_int]
    libc.listxattr.restype = ctypes.c_ssize_t
    ctypes.set_errno(0)
    size = libc.listxattr(encoded, None, 0, 0x0001)
    if size < 0:
        raise Rig(f"cannot list nofollow xattrs: {path}: errno={ctypes.get_errno()}")
    names: tuple[bytes, ...] = ()
    if size:
        buffer = ctypes.create_string_buffer(size)
        ctypes.set_errno(0)
        actual = libc.listxattr(encoded, buffer, size, 0x0001)
        if actual != size:
            raise Rig(f"unstable nofollow xattr list: {path}")
        raw = bytes(buffer.raw[:actual])
        split = tuple(item for item in raw.split(b"\0") if item)
        if b"\0".join(split) + b"\0" != raw or len(set(split)) != len(split):
            raise Rig(f"invalid nofollow xattr list: {path}")
        names = tuple(sorted(split))

    libc.getxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p,
                              ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
    libc.getxattr.restype = ctypes.c_ssize_t
    xattrs: list[tuple[bytes, int, str]] = []
    for name in names:
        ctypes.set_errno(0)
        value_size = libc.getxattr(encoded, name, None, 0, 0, 0x0001)
        if value_size < 0:
            raise Rig(f"cannot size nofollow xattr: {path}: {name!r}")
        value_buffer = ctypes.create_string_buffer(value_size)
        ctypes.set_errno(0)
        actual_size = libc.getxattr(
            encoded, name, value_buffer, value_size, 0, 0x0001,
        )
        if actual_size != value_size:
            raise Rig(f"unstable nofollow xattr: {path}: {name!r}")
        xattrs.append((name, value_size, sha(bytes(value_buffer.raw[:actual_size]))))

    return tuple(xattrs), path_acl_presence(path)


def fd_extended_metadata(descriptor: int) \
        -> tuple[tuple[tuple[bytes, int, str], ...], bool]:
    """Return xattr identities and extended-ACL presence from one retained vnode FD."""
    libc = ctypes.CDLL(None, use_errno=True)
    libc.flistxattr.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_size_t,
                               ctypes.c_int]
    libc.flistxattr.restype = ctypes.c_ssize_t
    ctypes.set_errno(0)
    size = libc.flistxattr(descriptor, None, 0, 0)
    if size < 0:
        raise Rig(f"cannot list retained-fd xattrs: fd={descriptor} errno={ctypes.get_errno()}")
    names: tuple[bytes, ...] = ()
    if size:
        buffer = ctypes.create_string_buffer(size)
        if libc.flistxattr(descriptor, buffer, size, 0) != size:
            raise Rig(f"unstable retained-fd xattr list: fd={descriptor}")
        raw = bytes(buffer.raw[:size])
        split = tuple(item for item in raw.split(b"\0") if item)
        if b"\0".join(split) + b"\0" != raw or len(set(split)) != len(split):
            raise Rig(f"invalid retained-fd xattr list: fd={descriptor}")
        names = tuple(sorted(split))

    libc.fgetxattr.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_void_p,
                               ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
    libc.fgetxattr.restype = ctypes.c_ssize_t
    xattrs: list[tuple[bytes, int, str]] = []
    for name in names:
        value_size = libc.fgetxattr(descriptor, name, None, 0, 0, 0)
        if value_size < 0:
            raise Rig(f"cannot size retained-fd xattr: fd={descriptor} {name!r}")
        value_buffer = ctypes.create_string_buffer(value_size)
        actual_size = libc.fgetxattr(
            descriptor, name, value_buffer, value_size, 0, 0,
        )
        if actual_size != value_size:
            raise Rig(f"unstable retained-fd xattr: fd={descriptor} {name!r}")
        xattrs.append((name, value_size, sha(bytes(value_buffer.raw[:actual_size]))))

    libc.acl_get_fd_np.argtypes = [ctypes.c_int, ctypes.c_int]
    libc.acl_get_fd_np.restype = ctypes.c_void_p
    libc.acl_get_entry.argtypes = [ctypes.c_void_p, ctypes.c_int,
                                   ctypes.POINTER(ctypes.c_void_p)]
    libc.acl_get_entry.restype = ctypes.c_int
    libc.acl_free.argtypes = [ctypes.c_void_p]
    libc.acl_free.restype = ctypes.c_int
    ctypes.set_errno(0)
    acl = libc.acl_get_fd_np(descriptor, 0x00000100)
    if not acl:
        if ctypes.get_errno() != errno.ENOENT:
            raise Rig(f"cannot read retained-fd ACL: fd={descriptor} errno={ctypes.get_errno()}")
        return tuple(xattrs), False
    try:
        entry = ctypes.c_void_p()
        result = libc.acl_get_entry(acl, 0, ctypes.byref(entry))
        if result not in (0, 1):
            raise Rig(f"cannot enumerate retained-fd ACL: fd={descriptor}")
        return tuple(xattrs), result == 0
    finally:
        if libc.acl_free(acl) != 0:
            raise Rig(f"cannot release retained-fd ACL: fd={descriptor}")


def path_security_snapshot(path: Path, payload_digest: str = "") -> tuple[Any, ...]:
    value = os.lstat(path)
    xattrs, has_acl = path_extended_metadata(path)
    return stat_snapshot(value, payload_digest) + (xattrs, has_acl)


def exact_live_created_xattrs(value: Any) -> bool:
    """Close live readable metadata to empty or one exact provenance tuple."""
    if type(value) is not tuple:
        return False
    if len(value) == 0:
        return True
    if len(value) != 1 or type(value[0]) is not tuple or len(value[0]) != 3:
        return False
    name, size, digest = value[0]
    return (
        type(name) is bytes and name == b"com.apple.provenance"
        and type(size) is int and size == 11
        and type(digest) is str
        and re.fullmatch(r"[0-9a-f]{64}", digest) is not None
    )


def require_no_extended_authority(snapshot: tuple[Any, ...], label: str) -> None:
    xattrs, has_acl = snapshot[-2:]
    if not exact_live_created_xattrs(xattrs) \
            or type(has_acl) is not bool or has_acl is not False \
            or type(snapshot[8]) is not int or snapshot[8] != 0:
        raise Rig(f"object has extended authority metadata: {label}")


def clean_path_security_snapshot(path: Path, payload_digest: str = "") \
        -> tuple[Any, ...]:
    snapshot = path_security_snapshot(path, payload_digest)
    require_no_extended_authority(snapshot, str(path))
    return snapshot


def restricted_path_security_snapshot(path: Path, payload_digest: str = "") \
        -> tuple[Any, ...]:
    """Bind stat/flags/ACL for a root-owned entry unreadable by uid501.

    Xattr creation and mutation are a separately mandatory immutable-source
    rejection because macOS denies listxattr(2) on these exact 0700/0620
    objects to the installed unprivileged reviewer.
    """
    snapshot = stat_snapshot(os.lstat(path), payload_digest) \
        + (None, path_acl_presence(path))
    if snapshot[-1] or snapshot[8] != 0:
        raise Rig(f"restricted object has extended authority metadata: {path}")
    return snapshot


def clean_fd_security_snapshot(descriptor: int, payload_digest: str = "") \
        -> tuple[Any, ...]:
    snapshot = stat_snapshot(os.fstat(descriptor), payload_digest) \
        + fd_extended_metadata(descriptor)
    require_no_extended_authority(snapshot, f"fd={descriptor}")
    return snapshot


def fixed_installation_snapshot(*, require_clean_metadata: bool = False) \
        -> dict[str, tuple[Any, ...]]:
    paths = [INSTALLED, NAMESPACE] + [NAMESPACE / name for name in LAYOUT] \
        + [NAMESPACE / "s" / "lock"]
    result: dict[str, tuple[Any, ...]] = {}
    for path in paths:
        digest = path_sha(path) if path == INSTALLED else ""
        if path == NAMESPACE / "s" / "lock":
            snapshot = restricted_path_security_snapshot(path, digest)
        else:
            snapshot = path_security_snapshot(path, digest)
        if require_clean_metadata and path != NAMESPACE / "s" / "lock":
            require_no_extended_authority(snapshot, str(path))
        result[str(path)] = snapshot
    return result


def tree_snapshot(root: Path) -> dict[str, tuple[Any, ...]]:
    out: dict[str, tuple[Any, ...]] = {}

    def visit(path: Path, rel: str) -> None:
        value = os.lstat(path)
        payload_digest = ""
        symlink_target = b""
        if stat.S_ISREG(value.st_mode):
            try:
                payload_digest = sha(path.read_bytes())
            except PermissionError:
                payload_digest = "UNREADABLE"
        elif stat.S_ISLNK(value.st_mode):
            symlink_target = os.fsencode(os.readlink(path))
        read_bit = (
            stat.S_IRUSR if value.st_uid == os.geteuid()
            else stat.S_IRGRP if value.st_gid in {os.getegid(), *os.getgroups()}
            else stat.S_IROTH
        )
        if os.geteuid() == 0 or value.st_mode & read_bit:
            xattrs, has_acl = path_extended_metadata(path)
            out[rel] = stat_snapshot(value, payload_digest, symlink_target) \
                + (xattrs, has_acl)
            require_no_extended_authority(out[rel], str(path))
        else:
            out[rel] = restricted_path_security_snapshot(path, payload_digest)
        if stat.S_ISDIR(value.st_mode):
            try:
                children = sorted(Path(entry.path) for entry in os.scandir(path))
            except PermissionError:
                out[rel + "/<NONLISTABLE>"] = ()
                return
            for child in children:
                visit(child, child.relative_to(root).as_posix())

    visit(root, ".")
    return out


def stat_snapshot(value: os.stat_result, payload_digest: str = "",
                  symlink_target: bytes = b"") -> tuple[Any, ...]:
    return (
        stat.S_IFMT(value.st_mode), stat.S_IMODE(value.st_mode), value.st_uid,
        value.st_gid, value.st_dev, value.st_ino, value.st_nlink, value.st_size,
        getattr(value, "st_flags", 0), payload_digest, symlink_target,
    )


def fd_tree_snapshot(root_fd: int) -> dict[str, tuple[Any, ...]]:
    out: dict[str, tuple[Any, ...]] = {".": clean_fd_security_snapshot(root_fd)}
    opened: list[int] = []

    def visit(parent_fd: int, relative: str, depth: int) -> None:
        if depth > 64:
            raise Rig("runtime descriptor snapshot depth exceeded")
        names = sorted(os.listdir(parent_fd))
        if len(out) + len(names) > 4097:
            raise Rig("runtime descriptor snapshot member budget exceeded")
        for name in names:
            if not isinstance(name, str) or name in {"", ".", ".."} or "/" in name:
                raise Rig("runtime descriptor snapshot name rejected")
            child_relative = name if relative == "." else f"{relative}/{name}"
            value = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
            digest = ""
            target = b""
            if stat.S_ISREG(value.st_mode):
                descriptor = os.open(
                    name, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
                    | getattr(os, "O_NOFOLLOW_ANY"), dir_fd=parent_fd,
                )
                opened.append(descriptor)
                before = os.fstat(descriptor)
                chunks: list[bytes] = []
                total = 0
                while total <= 67108864:
                    chunk = os.read(descriptor, min(65536, 67108865 - total))
                    if not chunk:
                        break
                    chunks.append(chunk)
                    total += len(chunk)
                after = os.fstat(descriptor)
                rebound = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
                if stable_identity(before) != stable_identity(after) \
                        or stable_identity(after) != stable_identity(rebound) \
                        or total != after.st_size or total > 67108864:
                    raise Rig("runtime descriptor snapshot regular leaf changed")
                digest = sha(b"".join(chunks))
                out[child_relative] = clean_fd_security_snapshot(descriptor, digest)
            elif stat.S_ISLNK(value.st_mode):
                target = os.fsencode(os.readlink(name, dir_fd=parent_fd))
            if child_relative not in out:
                out[child_relative] = stat_snapshot(value, digest, target)
            if stat.S_ISDIR(value.st_mode):
                descriptor = os.open(
                    name, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
                    | getattr(os, "O_NOFOLLOW_ANY"), dir_fd=parent_fd,
                )
                opened.append(descriptor)
                out[child_relative] = clean_fd_security_snapshot(descriptor)
                visit(descriptor, child_relative, depth + 1)

    try:
        visit(root_fd, ".", 0)
        return out
    finally:
        close_all(opened)


def active_effect_snapshot(
    runtime_fd: int, lease_fd: int, listener_fd: int, portal: Path,
) -> dict[str, Any]:
    object_path = portal.parent
    hidden_path = object_path / "h"
    python_path = portal / "python"
    socket_path = portal / "c"
    python_value = os.lstat(python_path)
    return {
        "fixed_installation": fixed_installation_snapshot(
            require_clean_metadata=True,
        ),
        "namespace": tree_snapshot(NAMESPACE),
        "state": current_state("ACTIVE"),
        "runtime": fd_tree_snapshot(runtime_fd),
        "runtime_fd": clean_fd_security_snapshot(runtime_fd),
        "lease_fd": clean_fd_security_snapshot(lease_fd),
        "listener_fd": stat_snapshot(os.fstat(listener_fd)),
        "object": clean_path_security_snapshot(object_path),
        "hidden": restricted_path_security_snapshot(hidden_path),
        "portal": clean_path_security_snapshot(portal),
        "python": clean_path_security_snapshot(
            python_path, sha(python_path.read_bytes()),
        ),
        "socket": restricted_path_security_snapshot(socket_path),
    }


def namespace_empty_runtime() -> bool:
    if sorted(path.name for path in NAMESPACE.iterdir()) != LAYOUT:
        return False
    receipt_names = sorted(path.name for path in (NAMESPACE / "r").iterdir())
    return (
        all(not any((NAMESPACE / name).iterdir()) for name in ("a", "c", "q"))
        and sorted(path.name for path in (NAMESPACE / "s").iterdir()) == ["lock"]
        and receipt_names in ([], ["last"])
    )


def current_state(
    expected_phase: str | None = None, descriptors: list[int] | None = None,
) -> dict[str, Any]:
    path = NAMESPACE / "s" / "current"
    value = stat_exact(path, uid=0, gid=0, mode=0o444, regular=True)
    raw = path.read_bytes()
    clean_path_security_snapshot(path, sha(raw))
    rebound = os.lstat(path)
    if stable_identity(value) != stable_identity(rebound):
        raise Rig("current state changed or rebound during security read")
    record = strict_json(raw)
    keys = {
        "schema_version", "phase", "runtime_id", "capability_sha256",
        "create_request_nonce", "cleanup_request_nonce", "object_dev", "object_ino",
        "runtime_dev", "runtime_ino", "fifo_dev", "fifo_ino", "portal_dev",
        "portal_ino", "socket_dev", "socket_ino", "sequence", "record_sha256",
    }
    if not isinstance(record, dict) or set(record) != keys:
        raise Rig("current state schema mismatch")
    phase = record.get("phase")
    if phase not in {
        "RESERVING", "CREATING", "PUBLISHING", "PREPARING", "PREPARED", "ACTIVE",
        "QUARANTINING", "CLEANING",
    } \
            or (expected_phase is not None and phase != expected_phase):
        raise Rig("current state phase mismatch")
    if (
        type(record.get("schema_version")) is not int
        or record.get("schema_version") != 1
        or not valid_hex(record.get("runtime_id"), 32)
        or not valid_hex(record.get("capability_sha256"))
        or not valid_hex(record.get("create_request_nonce"))
        or (
            record.get("cleanup_request_nonce") != ""
            if phase in {
                "RESERVING", "CREATING", "PUBLISHING", "PREPARING", "PREPARED", "ACTIVE",
            }
            else not valid_hex(record.get("cleanup_request_nonce"))
        )
        or type(record.get("sequence")) is not int or record["sequence"] < 1
        or any(type(record.get(key)) is not int or record[key] < 0 for key in (
            "object_dev", "object_ino", "runtime_dev", "runtime_ino",
            "fifo_dev", "fifo_ino", "portal_dev", "portal_ino",
            "socket_dev", "socket_ino",
        ))
    ):
        raise Rig("current state value mismatch")
    digest_record = {key: record[key] for key in record if key != "record_sha256"}
    if record.get("record_sha256") != sha(canonical(digest_record)):
        raise Rig("current state checksum mismatch")
    object_name = "o-" + record["runtime_id"]
    locations = {
        "RESERVING": (),
        "CREATING": ("c",), "PUBLISHING": ("c", "a"),
        "PREPARING": ("a",), "PREPARED": ("a",), "ACTIVE": ("a",),
        "QUARANTINING": ("a", "q"), "CLEANING": ("q",),
    }[phase]
    if phase == "RESERVING":
        identity_keys = (
            "object_dev", "object_ino", "runtime_dev", "runtime_ino", "fifo_dev",
            "fifo_ino", "portal_dev", "portal_ino", "socket_dev", "socket_ino",
        )
        a_names = sorted(path.name for path in (NAMESPACE / "a").iterdir())
        c_names = sorted(path.name for path in (NAMESPACE / "c").iterdir())
        q_names = sorted(path.name for path in (NAMESPACE / "q").iterdir())
        if any(record[key] != 0 for key in identity_keys) or a_names or q_names \
                or c_names not in ([], [object_name]):
            raise Rig("RESERVING state has an invalid orientation or nonzero identity")
        if c_names:
            pending = os.lstat(NAMESPACE / "c" / object_name)
            if (
                not stat.S_ISDIR(pending.st_mode) or pending.st_uid != 0
                or pending.st_gid != 0 or stat.S_IMODE(pending.st_mode) != 0o700
                or pending.st_nlink != 2
            ):
                raise Rig("RESERVING derived object identity mismatch")
        return record
    found: list[Path] = []
    for location in locations:
        candidate = NAMESPACE / location / object_name
        try:
            observed = os.lstat(candidate)
        except FileNotFoundError:
            continue
        if (observed.st_dev, observed.st_ino) != (
            record["object_dev"], record["object_ino"],
        ):
            raise Rig("current state object identity mismatch")
        found.append(candidate)
    if len(found) != 1:
        if phase != "CLEANING" or found:
            raise Rig("current state phase/location orientation mismatch")
        pending = parse_receipt(NAMESPACE / "r" / ".last.tmp", ".last.tmp")
        if (
            pending["runtime_id"] != record["runtime_id"]
            or pending["capability_sha256"] != record["capability_sha256"]
            or pending["create_request_nonce"] != record["create_request_nonce"]
            or pending["cleanup_request_nonce"] != record["cleanup_request_nonce"]
            or pending["sequence"] != record["sequence"]
        ):
            raise Rig("terminal CLEANING receipt temp is not state-bound")
        object_path = None
    else:
        object_path = found[0]
    if phase in {"PREPARED", "ACTIVE"}:
        assert object_path is not None
        for relative, dev_key, ino_key in (
            ("p", "portal_dev", "portal_ino"),
            ("p/c", "socket_dev", "socket_ino"),
        ):
            observed = os.lstat(object_path / relative)
            if (observed.st_dev, observed.st_ino) != (record[dev_key], record[ino_key]):
                raise Rig(f"current state registered identity mismatch: {relative}")
        if descriptors is not None:
            if len(descriptors) != 3:
                raise Rig("state descriptor identity count mismatch")
            for descriptor, dev_key, ino_key, relative in (
                (descriptors[0], "runtime_dev", "runtime_ino", "h/r"),
                (descriptors[1], "fifo_dev", "fifo_ino", "h/l"),
            ):
                observed = os.fstat(descriptor)
                if (observed.st_dev, observed.st_ino) != (record[dev_key], record[ino_key]) \
                        or descriptor_path(descriptor) != object_path / relative:
                    raise Rig("state returned descriptor identity mismatch")
            listener = os.fstat(descriptors[2])
            named_listener = os.lstat(object_path / "p" / "c")
            if not stat.S_ISSOCK(listener.st_mode) or (
                listener.st_dev, listener.st_ino,
            ) != (record["socket_dev"], record["socket_ino"]) or (
                named_listener.st_dev, named_listener.st_ino,
            ) != (record["socket_dev"], record["socket_ino"]):
                raise Rig("state returned listener identity mismatch")
        if (object_path / "p" / "session-top").exists() \
                or (object_path / "p" / "session-top").is_symlink():
            raise Rig("forbidden public session-top exists")
    return record


def parse_receipt(path: Path, label: str) -> dict[str, Any]:
    value = stat_exact(path, uid=0, gid=0, mode=0o444, regular=True)
    receipt_bytes = path.read_bytes()
    clean_path_security_snapshot(path, sha(receipt_bytes))
    rebound = os.lstat(path)
    if stable_identity(value) != stable_identity(rebound):
        raise Rig(f"receipts/{label} changed or rebound")
    raw = strict_json(receipt_bytes)
    if not isinstance(raw, dict) or set(raw) != {
        "capability_sha256", "create_request_nonce", "cleanup_request_nonce",
        "effect_sha256", "runtime_id", "schema_version", "sequence",
    } or type(raw.get("schema_version")) is not int \
            or raw.get("schema_version") != 1 \
            or type(raw.get("sequence")) is not int or raw["sequence"] < 1:
        raise Rig(f"receipts/{label} payload mismatch")
    for key in (
        "capability_sha256", "create_request_nonce", "cleanup_request_nonce",
        "effect_sha256",
    ):
        if not valid_hex(raw.get(key)):
            raise Rig(f"receipts/{label} digest/nonce mismatch")
    if not valid_hex(raw.get("runtime_id"), 32):
        raise Rig(f"receipts/{label} runtime id mismatch")
    effect = {
        "capability_sha256": raw["capability_sha256"],
        "cleanup_request_nonce": raw["cleanup_request_nonce"],
        "create_request_nonce": raw["create_request_nonce"],
        "runtime_id": raw["runtime_id"], "schema_version": 1,
        "sequence": raw["sequence"], "zero_runtime_residue": True,
    }
    if raw["effect_sha256"] != sha(canonical(effect)):
        raise Rig(f"receipts/{label} effect checksum mismatch")
    return raw


def receipt_state() -> tuple[int, tuple[Any, ...] | None]:
    children = sorted((NAMESPACE / "r").iterdir())
    if not children:
        return 0, None
    if [path.name for path in children] != ["last"]:
        raise Rig("receipt directory is not exactly empty or last")
    value = os.lstat(children[0])
    receipt_bytes = children[0].read_bytes()
    raw = parse_receipt(children[0], "last")
    return int(raw["sequence"]), (
        value.st_dev, value.st_ino, value.st_mode, value.st_uid, value.st_gid,
        value.st_nlink, sha(receipt_bytes),
    )


def error_reason(
    rc: int, responses: list[dict[str, Any]], fds: list[int],
    expected_nonce: str,
) -> str | None:
    if rc == 0 or fds or len(responses) != 1:
        return None
    response = responses[0]
    if set(response) != {
        "operation", "reason", "request_nonce", "schema_version",
    } or response.get("operation") != "error-v1" \
            or type(response.get("schema_version")) is not int \
            or response.get("schema_version") != 1:
        return None
    if not valid_hex(expected_nonce) or response.get("request_nonce") != expected_nonce:
        return None
    return response.get("reason") if isinstance(response.get("reason"), str) else None


def descriptor_path(descriptor: int) -> Path:
    """Resolve one retained Darwin vnode descriptor without reopening its name."""
    command = getattr(fcntl, "F_GETPATH", 50)
    try:
        raw = fcntl.fcntl(descriptor, command, b"\0" * 1024)
        encoded = raw.split(b"\0", 1)[0]
        decoded = os.fsdecode(encoded)
    except (OSError, UnicodeError, ValueError) as exc:
        raise Rig(f"cannot resolve retained descriptor path: fd={descriptor}") from exc
    if not decoded or not os.path.isabs(decoded) or os.path.normpath(decoded) != decoded:
        raise Rig(f"retained descriptor path is not absolute canonical: fd={descriptor}")
    return Path(decoded)


def prepared_response_valid(response: Any, nonce: str) -> bool:
    return (
        isinstance(response, dict)
        and set(response) == {
            "capability", "operation", "portal_identity", "request_nonce",
            "runtime_id", "schema_version",
        }
        and response.get("operation") == "create-prepared-v1"
        and response.get("request_nonce") == nonce
        and type(response.get("schema_version")) is int
        and response.get("schema_version") == 1
        and valid_hex(response.get("capability"))
        and valid_hex(response.get("runtime_id"), 32)
        and isinstance(response.get("portal_identity"), str)
    )


def create_runtime() -> tuple[dict[str, Any], int, int, int]:
    nonce = os.urandom(32).hex()
    rc, responses, fds = mediator_exchange({
        "operation": "create-v1", "request_nonce": nonce, "schema_version": 1,
    })
    if rc != 0 or len(responses) != 2 or len(fds) != 3:
        raise Rig(f"create failed rc={rc} responses={responses!r} fds={len(fds)}")
    prepared, committed = responses
    if not prepared_response_valid(prepared, nonce):
        raise Rig("PREPARED response mismatch")
    if type(committed.get("schema_version")) is not int or committed != {
        "operation": "create-committed-v1", "request_nonce": nonce,
        "runtime_id": prepared["runtime_id"], "schema_version": 1,
    }:
        raise Rig("COMMITTED response mismatch")
    runtime_fd, lease_fd, listener_fd = fds
    runtime_stat = os.fstat(runtime_fd)
    lease_stat = os.fstat(lease_fd)
    listener_stat = os.fstat(listener_fd)
    if (
        not stat.S_ISDIR(runtime_stat.st_mode)
        or (runtime_stat.st_uid, runtime_stat.st_gid, stat.S_IMODE(runtime_stat.st_mode))
        != (CLIENT_UID, CLIENT_GID, 0o700)
        or runtime_stat.st_nlink != 2
        or not stat.S_ISFIFO(lease_stat.st_mode)
        or (lease_stat.st_uid, lease_stat.st_gid, stat.S_IMODE(lease_stat.st_mode),
            lease_stat.st_nlink) != (0, 0, 0o600, 1)
        or not stat.S_ISSOCK(listener_stat.st_mode)
        or (listener_stat.st_uid, listener_stat.st_gid,
            stat.S_IMODE(listener_stat.st_mode), listener_stat.st_nlink) \
            != (0, CLIENT_GID, 0o620, 1)
        or any(fcntl.fcntl(descriptor, fcntl.F_GETFD) & fcntl.FD_CLOEXEC == 0
               for descriptor in fds)
        or fcntl.fcntl(lease_fd, fcntl.F_GETFL) & os.O_ACCMODE != os.O_WRONLY
    ):
        raise Rig("ordered create descriptor identities mismatch")
    clean_fd_security_snapshot(runtime_fd)
    clean_fd_security_snapshot(lease_fd)
    listener = socket.fromfd(listener_fd, socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        if listener.getsockopt(socket.SOL_SOCKET, socket.SO_ACCEPTCONN) != 1:
            raise Rig("third descriptor is not a listener")
        if listener.getsockname() != str(Path(prepared["portal_identity"]) / "c"):
            raise Rig("listener final active path mismatch")
    finally:
        listener.close()
    expected_portal = (
        NAMESPACE / "a" / ("o-" + prepared["runtime_id"]) / "p"
    )
    if Path(prepared["portal_identity"]) != expected_portal:
        raise Rig("server portal identity mismatch")
    object_path = expected_portal.parent
    hidden_path = object_path / "h"
    object_stat = stat_exact(object_path, uid=0, gid=0, mode=0o555, regular=False)
    hidden_stat = stat_exact(hidden_path, uid=0, gid=0, mode=0o700, regular=False)
    if sorted(path.name for path in object_path.iterdir()) != ["h", "p"] \
            or object_stat.st_nlink != 4 or hidden_stat.st_nlink != 3 \
            or fd_tree_snapshot(runtime_fd) != {".": clean_fd_security_snapshot(runtime_fd)}:
        raise Rig("compound/hidden/runtime closed identity mismatch")
    if descriptor_path(runtime_fd) != hidden_path / "r" \
            or descriptor_path(lease_fd) != hidden_path / "l":
        raise Rig("returned runtime/FIFO descriptors are not bound to exact hidden names")
    stat_exact(expected_portal, uid=0, gid=CLIENT_GID, mode=0o550, regular=False)
    if sorted(path.name for path in expected_portal.iterdir()) != ["c", "python"]:
        raise Rig("portal membership is not exactly c/python")
    stat_exact(expected_portal / "python", uid=0, gid=0, mode=0o555, regular=True)
    if path_sha(expected_portal / "python") != (
        "9ea12d11e0573548d6d8b0added1740b2d6377366081dbca05c19746ce7c616e"
    ):
        raise Rig("portal private Python digest mismatch")
    socket_stat = os.lstat(expected_portal / "c")
    if (
        not stat.S_ISSOCK(socket_stat.st_mode) or socket_stat.st_uid != 0
        or socket_stat.st_gid != CLIENT_GID
        or stat.S_IMODE(socket_stat.st_mode) != 0o620
    ):
        raise Rig("portal socket identity mismatch")
    clean_path_security_snapshot(object_path)
    restricted_path_security_snapshot(hidden_path)
    clean_path_security_snapshot(expected_portal)
    clean_path_security_snapshot(
        expected_portal / "python", path_sha(expected_portal / "python"),
    )
    restricted_path_security_snapshot(expected_portal / "c")
    active = current_state("ACTIVE", fds)
    if (
        active["runtime_id"] != prepared["runtime_id"]
        or active["create_request_nonce"] != nonce
        or active["capability_sha256"] != sha(bytes.fromhex(prepared["capability"]))
        or (active["runtime_dev"], active["runtime_ino"])
        != (runtime_stat.st_dev, runtime_stat.st_ino)
        or (active["fifo_dev"], active["fifo_ino"])
        != (lease_stat.st_dev, lease_stat.st_ino)
        or (active["socket_dev"], active["socket_ino"])
        != (listener_stat.st_dev, listener_stat.st_ino)
    ):
        raise Rig("ACTIVE state does not bind prepared response/descriptors")
    return prepared, runtime_fd, lease_fd, listener_fd


def cleanup_runtime(
    capability: str, request_nonce: str,
) -> tuple[int, list[dict[str, Any]], list[int]]:
    return mediator_exchange({
        "capability": capability, "operation": "cleanup-v1",
        "request_nonce": request_nonce, "schema_version": 1,
    })


def require_cleanup_success(
    rc: int, responses: list[dict[str, Any]], fds: list[int], *,
    runtime_id: str, capability_sha256: str, create_request_nonce: str,
    cleanup_request_nonce: str, expected_sequence: int, label: str,
) -> dict[str, Any]:
    close_all(fds)
    if rc != 0 or fds or len(responses) != 1:
        raise Rig(f"{label} did not return one descriptor-free success")
    response = responses[0]
    if set(response) != {
        "operation", "receipt_sha256", "request_nonce", "runtime_id",
        "schema_version",
    } or response.get("operation") != "cleanup-result-v1" \
            or type(response.get("schema_version")) is not int \
            or response.get("schema_version") != 1 \
            or response.get("request_nonce") != cleanup_request_nonce \
            or response.get("runtime_id") != runtime_id \
            or not valid_hex(response.get("receipt_sha256")):
        raise Rig(f"{label} cleanup response schema/binding mismatch")
    if not namespace_empty_runtime():
        raise Rig(f"{label} left non-terminal namespace residue")
    sequence, receipt_identity = receipt_state()
    receipt_path = NAMESPACE / "r" / "last"
    receipt_raw = receipt_path.read_bytes()
    receipt = parse_receipt(receipt_path, "last")
    if sequence != expected_sequence or receipt_identity is None \
            or response["receipt_sha256"] != sha(receipt_raw) \
            or receipt["runtime_id"] != runtime_id \
            or receipt["capability_sha256"] != capability_sha256 \
            or receipt["create_request_nonce"] != create_request_nonce \
            or receipt["cleanup_request_nonce"] != cleanup_request_nonce:
        raise Rig(f"{label} response is not bound to exact next durable receipt")
    return response


def require_current_cleanup_nonce_replay(
    capability: str, cleanup_nonce: str, label: str,
) -> None:
    baseline = tree_snapshot(NAMESPACE)
    rc, responses, fds = cleanup_runtime(capability, cleanup_nonce)
    close_all(fds)
    if error_reason(rc, responses, fds, cleanup_nonce) != "REPLAY" \
            or tree_snapshot(NAMESPACE) != baseline:
        raise Rig(f"{label} current cleanup nonce replay was not zero-effect")
    request = {
        "operation": "create-v1", "request_nonce": cleanup_nonce,
        "schema_version": 1,
    }
    rc, responses, fds = mediator_exchange(request)
    close_all(fds)
    if error_reason(rc, responses, fds, cleanup_nonce) != "REPLAY" \
            or tree_snapshot(NAMESPACE) != baseline:
        raise Rig(f"{label} current cleanup nonce cross-operation replay was not zero-effect")


def close_all(fds: tuple[int, ...] | list[int]) -> None:
    for descriptor in fds:
        if descriptor >= 0:
            try:
                os.close(descriptor)
            except OSError:
                pass
            TEST_FDS.discard(descriptor)


def absolute_request_deadline_effect(
    label: str, schedule: tuple[tuple[float, bytes], ...], baseline: dict[str, Any],
    *, minimum_sent_chunks: int,
) -> None:
    """Prove one five-second budget spans prefix, body, and missing EOF."""
    process, parent = start_mediator()
    received_fds: list[int] = []
    response: dict[str, Any] | None = None
    sent_chunks = 0
    started = time.monotonic()
    try:
        if not schedule or schedule[0][0] != 0.0 \
                or any(not chunk for _offset, chunk in schedule) \
                or any(left[0] >= right[0] for left, right in zip(schedule, schedule[1:])):
            raise Rig(f"invalid {label} slow-drip schedule")
        for offset, chunk in schedule:
            target = started + offset
            remaining = target - time.monotonic()
            if remaining > 0:
                time.sleep(remaining)
            try:
                parent.sendall(chunk)
            except (BrokenPipeError, ConnectionResetError):
                break
            sent_chunks += 1
        remaining = 6.25 - (time.monotonic() - started)
        if remaining <= 0:
            raise Rig("slow-drip request exceeded gate deadline before mediator exit")
        try:
            returncode = process.wait(timeout=remaining)
        except subprocess.TimeoutExpired as exc:
            raise Rig("slow-drip request restarted the five-second deadline") from exc
        elapsed = time.monotonic() - started
        response, received_fds = recv_response(parent)
        require_terminal_response_eof(parent)
        stdout = process.stdout.read() if process.stdout is not None else b""
        stderr = process.stderr.read() if process.stderr is not None else b""
        if (
            returncode == 0 or response is not None or received_fds
            or stdout or stderr or sent_chunks < minimum_sent_chunks
            or not 4.0 <= elapsed <= 6.25
            or tree_snapshot(NAMESPACE) != baseline
        ):
            raise Rig(
                f"{label} slow-drip did not enforce one absolute five-second "
                f"zero-effect deadline: rc={returncode} sent={sent_chunks} "
                f"elapsed={elapsed:.3f} response={response!r}"
            )
    finally:
        close_all(received_fds)
        parent.close()
        if process.poll() is None:
            process.kill()
            finish_mediator(process, timeout=5)
        if process.stdout is not None:
            process.stdout.close()
        if process.stderr is not None:
            process.stderr.close()


def malformed_stream_effects() -> None:
    baseline = tree_snapshot(NAMESPACE)
    nonce = os.urandom(32).hex()
    valid = request_wire({
        "operation": "create-v1", "request_nonce": nonce, "schema_version": 1,
    })
    malformed = [
        ("EMPTY", b"", True),
        ("TRUNCATED_PREFIX", b"\x00\x00", True),
        ("TRUNCATED_BODY", struct.pack(">I", 10) + b"{}", True),
        ("OVERSIZE", struct.pack(">I", 16385), True),
        ("INVALID_UTF8", struct.pack(">I", 3) + b"{\xff}", True),
        ("DUPLICATE_KEY", (lambda body: struct.pack(">I", len(body)) + body)(
            b'{"operation":"create-v1","operation":"cleanup-v1",'
            b'"request_nonce":"' + os.urandom(32).hex().encode() +
            b'","schema_version":1}'
        ), True),
        ("MISSING_NONCE", request_wire({
            "operation": "create-v1", "schema_version": 1,
        }), True),
        ("INVALID_NONCE", request_wire({
            "operation": "create-v1", "request_nonce": "0", "schema_version": 1,
        }), True),
        ("NONFINITE", (lambda body: struct.pack(">I", len(body)) + body)(
            b'{"operation":"create-v1","request_nonce":"' +
            os.urandom(32).hex().encode() + b'","schema_version":NaN}'
        ), True),
        ("TRAILING_BYTE", valid + b"X", True),
        ("SECOND_FRAME", valid + struct.pack(">I", 2) + b"{}", True),
    ]
    for label, wire, shutdown_write in malformed:
        rc, responses, fds = raw_mediator_exchange(
            "create-v1", wire, shutdown_write=shutdown_write,
        )
        close_all(fds)
        if rc == 0 or responses or fds or tree_snapshot(NAMESPACE) != baseline:
            raise Rig(f"malformed request was not zero-response/effect: {label}")

    for label, version in (("INT", 2), ("BOOL", True), ("FLOAT", 1.0)):
        nonce = os.urandom(32).hex()
        rc, responses, fds = mediator_exchange({
            "operation": "create-v1", "request_nonce": nonce,
            "schema_version": version,
        })
        close_all(fds)
        if error_reason(rc, responses, fds, nonce) != "INVALID_KEYS" \
                or tree_snapshot(NAMESPACE) != baseline:
            raise Rig(f"semantic schema version did not reject exactly: {label}")

    deadline_cases = (
        ("PREFIX", b""),
        ("BODY", struct.pack(">I", 10) + b"{}"),
        ("EOF", valid),
    )
    for label, wire in deadline_cases:
        started = time.monotonic()
        rc, responses, fds = raw_mediator_exchange(
            "create-v1", wire, shutdown_write=False,
        )
        elapsed = time.monotonic() - started
        close_all(fds)
        if rc == 0 or responses or fds or not 4.0 <= elapsed <= 6.25 \
                or tree_snapshot(NAMESPACE) != baseline:
            raise Rig(
                f"missing {label} did not enforce five-second zero-effect deadline: "
                f"elapsed={elapsed:.3f}"
            )

    absolute_request_deadline_effect(
        "PREFIX",
        tuple((index * 1.8, valid[index:index + 1]) for index in range(4)),
        baseline, minimum_sent_chunks=3,
    )
    absolute_request_deadline_effect(
        "BODY",
        ((0.0, valid[:4]),) + tuple(
            (index * 0.9, valid[3 + index:4 + index]) for index in range(1, 7)
        ),
        baseline, minimum_sent_chunks=6,
    )
    absolute_request_deadline_effect(
        "EOF", ((0.0, valid[:1]), (4.5, valid[1:])),
        baseline, minimum_sent_chunks=2,
    )

    delayed_trailing = valid + b"X"
    rc, responses, fds = raw_mediator_exchange(
        "create-v1", delayed_trailing,
        wire_chunks=(valid, b"X"), inter_chunk_delay_seconds=0.05,
    )
    close_all(fds)
    if rc == 0 or responses or fds or tree_snapshot(NAMESPACE) != baseline:
        raise Rig("delayed trailing request byte was not zero-response/effect")

    fragmented_request = {
        "operation": "unlink-v1", "request_nonce": os.urandom(32).hex(),
        "schema_version": 1,
    }
    fragmented = request_wire(fragmented_request)
    rc, responses, fds = raw_mediator_exchange(
        "unlink-v1", fragmented,
        wire_chunks=(fragmented[:1], fragmented[1:3], fragmented[3:11], fragmented[11:]),
        inter_chunk_delay_seconds=0.01,
    )
    close_all(fds)
    if error_reason(rc, responses, fds, fragmented_request["request_nonce"]) \
            != "INVALID_OPERATION" \
            or tree_snapshot(NAMESPACE) != baseline:
        raise Rig("fragmented complete request was not parsed exactly")

    read_fd, write_fd = os.pipe()
    try:
        rc, responses, fds = raw_mediator_exchange(
            "create-v1", valid, ancillary_fds=(read_fd,),
        )
        close_all(fds)
        if rc == 0 or responses or fds or tree_snapshot(NAMESPACE) != baseline:
            raise Rig("SCM_RIGHTS request was not zero-response/effect")
    finally:
        close_all((read_fd, write_fd))

    late_read_fd, late_write_fd = os.pipe()
    try:
        rc, responses, fds = raw_mediator_exchange(
            "create-v1", valid, late_ancillary_fds=(late_read_fd,),
            wire_chunks=(valid[:-1], valid[-1:]),
            inter_chunk_delay_seconds=0.05,
        )
        close_all(fds)
        if rc == 0 or responses or fds or tree_snapshot(NAMESPACE) != baseline:
            raise Rig("late SCM_RIGHTS request was not zero-response/effect")
    finally:
        close_all((late_read_fd, late_write_fd))


def finish_mediator(process: subprocess.Popen[bytes], timeout: float = 20) -> int:
    returncode = process.wait(timeout=timeout)
    stdout = process.stdout.read() if process.stdout is not None else b""
    stderr = process.stderr.read() if process.stderr is not None else b""
    if process.stdout is not None:
        process.stdout.close()
    if process.stderr is not None:
        process.stderr.close()
    if stdout or stderr:
        raise Rig(f"mediator leaked stdout/stderr stdout={stdout!r} stderr={stderr!r}")
    return returncode


def create_request() -> dict[str, Any]:
    request = {
        "operation": "create-v1", "request_nonce": os.urandom(32).hex(),
        "schema_version": 1,
    }
    TEST_CREATE_NONCES.add(request["request_nonce"])
    return request


def pipe_closed_without_output(stream: Any) -> bool:
    descriptor = stream.fileno()
    os.set_blocking(descriptor, False)
    try:
        return os.read(descriptor, 1) == b""
    except BlockingIOError:
        return False


def recovery_create(expected_reason: str = "RECOVERED_RETRY") -> None:
    abandoned = current_state()
    before_sequence, _before_receipt = receipt_state()
    request = create_request()
    rc, responses, fds = mediator_exchange(request)
    close_all(fds)
    if error_reason(rc, responses, fds, request["request_nonce"]) != expected_reason \
            or fds or not namespace_empty_runtime():
        raise Rig("valid create did not perform exact singleton recovery")
    if abandoned["phase"] in {"RESERVING", "CREATING"}:
        after_sequence, _after_receipt = receipt_state()
        if after_sequence != before_sequence:
            raise Rig("pre-publication recovery unexpectedly emitted a receipt")
        return
    receipt = parse_receipt(NAMESPACE / "r" / "last", "last")
    if receipt["sequence"] != before_sequence + 1 \
            or receipt["runtime_id"] != abandoned["runtime_id"] \
            or receipt["capability_sha256"] != abandoned["capability_sha256"] \
            or receipt["create_request_nonce"] != abandoned["create_request_nonce"] \
            or receipt["cleanup_request_nonce"] != request["request_nonce"]:
        raise Rig("recovery response is not bound to exact next durable receipt")


def lock_and_inherited_fd_effects() -> None:
    read_fd, write_fd = os.pipe()
    os.set_blocking(read_fd, False)
    process, control = start_mediator(inherited_fds=(write_fd,))
    request = create_request()
    descriptors: list[int] = []
    try:
        os.close(write_fd)
        write_fd = -1
        control.sendall(request_wire(request))
        control.shutdown(socket.SHUT_WR)
        prepared, descriptors = recv_response(control)
        if prepared is None or prepared.get("operation") != "create-prepared-v1" \
                or len(descriptors) != 3:
            raise Rig("lock-holder create did not reach PREPARED")
        current_state("PREPARED", descriptors)
        try:
            inherited_closed = os.read(read_fd, 1) == b""
        except BlockingIOError:
            inherited_closed = False
        standard_streams_closed = (
            process.stdout is not None and process.stderr is not None
            and pipe_closed_without_output(process.stdout)
            and pipe_closed_without_output(process.stderr)
        )
        before_contention = tree_snapshot(NAMESPACE)
        contender = create_request()
        rc2, responses2, fds2 = mediator_exchange(contender)
        close_all(fds2)
        if error_reason(rc2, responses2, fds2, contender["request_nonce"]) \
                != "LOCK_BUSY" \
                or tree_snapshot(NAMESPACE) != before_contention:
            raise Rig("cross-process OFD contention was not zero-effect LOCK_BUSY")
        if not inherited_closed or not standard_streams_closed:
            raise Rig("inherited/stdout/stderr descriptor remained open at PREPARED effect")
        if os.write(descriptors[1], b"A") != 1:
            raise Rig("lock-holder ACK failed")
        committed, committed_fds = recv_response(control)
        close_all(committed_fds)
        if committed != {
            "operation": "create-committed-v1",
            "request_nonce": request["request_nonce"],
            "runtime_id": prepared.get("runtime_id"), "schema_version": 1,
        } or committed_fds or finish_mediator(process) != 0:
            raise Rig("lock-holder did not commit exactly")
        current_state("ACTIVE", descriptors)
    finally:
        close_all(descriptors)
        close_all((read_fd, write_fd))
        control.close()
        if process.poll() is None:
            process.kill()
            finish_mediator(process, timeout=5)
    if prepared is None:
        raise Rig("missing prepared response")
    before_sequence, _before_receipt = receipt_state()
    cleanup_nonce = os.urandom(32).hex()
    cleanup_rc, cleanup_responses, cleanup_fds = cleanup_runtime(
        prepared["capability"], cleanup_nonce,
    )
    require_cleanup_success(
        cleanup_rc, cleanup_responses, cleanup_fds,
        runtime_id=prepared["runtime_id"],
        capability_sha256=sha(bytes.fromhex(prepared["capability"])),
        create_request_nonce=prepared["request_nonce"],
        cleanup_request_nonce=cleanup_nonce,
        expected_sequence=before_sequence + 1,
        label="lock reference cleanup",
    )


def prepared_and_active_recovery_effects() -> None:
    # Exact PREPARED process crash: kill only the gate-started mediator PID.
    process, control = start_mediator()
    request = create_request()
    descriptors: list[int] = []
    try:
        control.sendall(request_wire(request))
        control.shutdown(socket.SHUT_WR)
        prepared, descriptors = recv_response(control)
        if prepared is None or prepared.get("operation") != "create-prepared-v1" \
                or len(descriptors) != 3:
            raise Rig("crash fixture did not reach PREPARED")
        current_state("PREPARED", descriptors)
        process.kill()
        finish_mediator(process, timeout=5)
    finally:
        close_all(descriptors)
        control.close()
        if process.poll() is None:
            process.kill()
            finish_mediator(process, timeout=5)
    recovery_create()

    # Wrong ACK remains PREPARED and recovers only after returned FDs close.
    wrong_ack_request = create_request()
    rc, responses, descriptors = raw_mediator_exchange(
        "create-v1", request_wire(wrong_ack_request), acknowledge_create=b"X",
    )
    descriptor_count = len(descriptors)
    close_all(descriptors)
    if rc == 0 or descriptor_count != 3 or len(responses) != 2 \
            or not prepared_response_valid(responses[0], wrong_ack_request["request_nonce"]) \
            or error_reason(
                rc, [responses[1]], [], wrong_ack_request["request_nonce"],
            ) != "INVALID_ACK":
        raise Rig("wrong ACK did not reject exactly")
    recovery_create()

    # A valid ACK prefix with one queued extra byte is still INVALID_ACK.
    extra_ack_request = create_request()
    extra_rc, extra_responses, extra_descriptors = raw_mediator_exchange(
        "create-v1", request_wire(extra_ack_request), acknowledge_create=b"AA",
    )
    extra_descriptor_count = len(extra_descriptors)
    close_all(extra_descriptors)
    if extra_rc == 0 or extra_descriptor_count != 3 or len(extra_responses) != 2 \
            or not prepared_response_valid(
                extra_responses[0], extra_ack_request["request_nonce"],
            ) \
            or error_reason(
                extra_rc, [extra_responses[1]], [], extra_ack_request["request_nonce"],
            ) != "INVALID_ACK":
        raise Rig("extra ACK byte did not reject exactly")
    recovery_create()

    # No ACK must hit the exact five-second deadline and reject with a bound error.
    missing_ack_request = create_request()
    started = time.monotonic()
    missing_rc, missing_responses, missing_descriptors = raw_mediator_exchange(
        "create-v1", request_wire(missing_ack_request), acknowledge_create=None,
    )
    elapsed = time.monotonic() - started
    missing_descriptor_count = len(missing_descriptors)
    close_all(missing_descriptors)
    if missing_rc == 0 or missing_descriptor_count != 3 \
            or len(missing_responses) != 2 \
            or not prepared_response_valid(
                missing_responses[0], missing_ack_request["request_nonce"],
            ) \
            or error_reason(
                missing_rc, [missing_responses[1]], [],
                missing_ack_request["request_nonce"],
            ) != "INVALID_ACK" or not 4.0 <= elapsed <= 6.25:
        raise Rig(f"missing ACK did not reject on five-second deadline: {elapsed:.3f}")
    recovery_create()

    # ACTIVE controller loss: co-lifetime FDs close, next valid create recovers
    # the exact singleton, advances one receipt, and asks the caller to retry.
    before_sequence, _before_receipt = receipt_state()
    abandoned, runtime_fd, lease_fd, listener_fd = create_runtime()
    close_all((runtime_fd, lease_fd, listener_fd))
    recovery_create()
    after_sequence, _after_receipt = receipt_state()
    if after_sequence != before_sequence + 1 \
            or (NAMESPACE / "a" / ("o-" + abandoned["runtime_id"])).exists():
        raise Rig("abandoned ACTIVE recovery receipt/residue mismatch")


def cleaning_crash_recovery_effect() -> None:
    prepared, runtime_fd, lease_fd, listener_fd = create_runtime()
    for index in range(3000):
        descriptor = os.open(
            f"crash-{index:04d}", os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600, dir_fd=runtime_fd,
        )
        os.close(descriptor)
    close_all((runtime_fd, lease_fd, listener_fd))
    before_sequence, _before_receipt = receipt_state()
    queue = select.kqueue()
    qfd = os.open(NAMESPACE / "q", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    queue.control([
        select.kevent(
            qfd, filter=select.KQ_FILTER_VNODE,
            flags=select.KQ_EV_ADD | select.KQ_EV_ENABLE | select.KQ_EV_CLEAR,
            fflags=select.KQ_NOTE_WRITE | select.KQ_NOTE_RENAME,
        )
    ], 0, 0)
    process, control = start_mediator()
    cleanup = {
        "capability": prepared["capability"], "operation": "cleanup-v1",
        "request_nonce": os.urandom(32).hex(), "schema_version": 1,
    }
    try:
        control.sendall(request_wire(cleanup))
        control.shutdown(socket.SHUT_WR)
        captured = False
        deadline = time.monotonic() + 8
        while time.monotonic() < deadline and not captured:
            events = queue.control(None, 1, max(0.01, deadline - time.monotonic()))
            if not events or process.poll() is not None:
                break
            try:
                os.kill(process.pid, signal.SIGSTOP)
                stopped_pid, stopped_status = os.waitpid(process.pid, os.WUNTRACED)
            except (ChildProcessError, ProcessLookupError):
                break
            if stopped_pid != process.pid or not os.WIFSTOPPED(stopped_status):
                raise Rig("gate-owned cleanup did not enter confirmed SIGSTOP")
            try:
                current_state("CLEANING")
                captured = True
            except (OSError, Rig):
                os.kill(process.pid, signal.SIGCONT)
        if not captured:
            raise Undecidable("could not deterministically capture live CLEANING lock holder")
        before_contention = tree_snapshot(NAMESPACE)
        create_contender = create_request()
        create_rc, create_responses, create_fds = mediator_exchange(create_contender)
        close_all(create_fds)
        if error_reason(
            create_rc, create_responses, create_fds,
            create_contender["request_nonce"],
        ) != "LOCK_BUSY" \
                or tree_snapshot(NAMESPACE) != before_contention:
            raise Rig("create/cleanup OFD contention was not zero-effect LOCK_BUSY")
        cleanup_contender_nonce = os.urandom(32).hex()
        cleanup_rc, cleanup_responses, cleanup_fds = cleanup_runtime(
            prepared["capability"], cleanup_contender_nonce,
        )
        close_all(cleanup_fds)
        if error_reason(
            cleanup_rc, cleanup_responses, cleanup_fds, cleanup_contender_nonce,
        ) != "LOCK_BUSY" \
                or tree_snapshot(NAMESPACE) != before_contention:
            raise Rig("cleanup/cleanup OFD contention was not zero-effect LOCK_BUSY")
        process.kill()
        finish_mediator(process, timeout=5)
        current_state("CLEANING")
        if (NAMESPACE / "r" / ".last.tmp").exists():
            raise Undecidable("early CLEANING crash capture reached durable receipt temp")
    finally:
        control.close()
        queue.close()
        os.close(qfd)
        if process.poll() is None:
            process.kill()
            finish_mediator(process, timeout=5)
    require_current_cleanup_nonce_replay(
        prepared["capability"], cleanup["request_nonce"], "killed CLEANING",
    )
    resume_nonce = os.urandom(32).hex()
    rc, responses, fds = cleanup_runtime(prepared["capability"], resume_nonce)
    require_cleanup_success(
        rc, responses, fds,
        runtime_id=prepared["runtime_id"],
        capability_sha256=sha(bytes.fromhex(prepared["capability"])),
        create_request_nonce=prepared["request_nonce"],
        cleanup_request_nonce=resume_nonce,
        expected_sequence=before_sequence + 1,
        label="killed CLEANING recovery",
    )


def busy_leaf_effects() -> None:
    # A deliberately decoupled live listener is still caught atomically by
    # NODELETEBUSY; this does not substitute for the directory-FD lease invariant.
    prepared, runtime_fd, lease_fd, listener_fd = create_runtime()
    listener_before = os.fstat(listener_fd)
    close_all((runtime_fd, lease_fd))
    listener_busy_nonce = os.urandom(32).hex()
    rc, responses, fds = cleanup_runtime(
        prepared["capability"], listener_busy_nonce,
    )
    close_all(fds)
    if error_reason(rc, responses, fds, listener_busy_nonce) != "INCOMPLETE_BUSY":
        close_all((listener_fd,))
        raise Rig("live listener was not caught by NODELETEBUSY")
    listener_state = current_state("CLEANING")
    listener_name = (
        NAMESPACE / "q" / ("o-" + prepared["runtime_id"]) / "p" / "c"
    )
    listener_after_fd = os.fstat(listener_fd)
    listener_after_name = os.lstat(listener_name)
    if stat_snapshot(listener_after_fd) != stat_snapshot(listener_before) \
            or stat_snapshot(listener_after_name) != stat_snapshot(listener_before) \
            or listener_state["socket_dev"] != listener_before.st_dev \
            or listener_state["socket_ino"] != listener_before.st_ino \
            or listener_after_fd.st_nlink != 1:
        close_all((listener_fd,))
        raise Rig("busy listener name/inode was changed before INCOMPLETE_BUSY")
    close_all((listener_fd,))
    require_current_cleanup_nonce_replay(
        prepared["capability"], listener_busy_nonce, "busy listener",
    )
    before_sequence, _before_receipt = receipt_state()
    listener_retry_nonce = os.urandom(32).hex()
    rc, responses, fds = cleanup_runtime(
        prepared["capability"], listener_retry_nonce,
    )
    require_cleanup_success(
        rc, responses, fds,
        runtime_id=prepared["runtime_id"],
        capability_sha256=sha(bytes.fromhex(prepared["capability"])),
        create_request_nonce=prepared["request_nonce"],
        cleanup_request_nonce=listener_retry_nonce,
        expected_sequence=before_sequence + 1,
        label="listener-busy CLEANING retry",
    )

    prepared2, runtime2, lease2, listener2 = create_runtime()
    busy = os.open(
        "busy-regular", os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600,
        dir_fd=runtime2,
    )
    os.write(busy, b"H039-BUSY")
    busy_before = os.fstat(busy)
    close_all((runtime2, lease2, listener2))
    regular_busy_nonce = os.urandom(32).hex()
    rc2, responses2, fds2 = cleanup_runtime(
        prepared2["capability"], regular_busy_nonce,
    )
    close_all(fds2)
    if error_reason(rc2, responses2, fds2, regular_busy_nonce) != "INCOMPLETE_BUSY":
        close_all((busy,))
        raise Rig("live regular leaf was not caught by NODELETEBUSY")
    current_state("CLEANING")
    busy_after = os.fstat(busy)
    os.lseek(busy, 0, os.SEEK_SET)
    if stat_snapshot(busy_after) != stat_snapshot(busy_before) \
            or busy_after.st_nlink != 1 or os.read(busy, 11) != b"H039-BUSY":
        close_all((busy,))
        raise Rig("busy regular name/inode/content changed before INCOMPLETE_BUSY")
    close_all((busy,))
    require_current_cleanup_nonce_replay(
        prepared2["capability"], regular_busy_nonce, "busy regular leaf",
    )
    before_sequence, _before_receipt = receipt_state()
    retry_nonce = os.urandom(32).hex()
    retry_rc, retry_responses, retry_fds = cleanup_runtime(
        prepared2["capability"], retry_nonce,
    )
    require_cleanup_success(
        retry_rc, retry_responses, retry_fds,
        runtime_id=prepared2["runtime_id"],
        capability_sha256=sha(bytes.fromhex(prepared2["capability"])),
        create_request_nonce=prepared2["request_nonce"],
        cleanup_request_nonce=retry_nonce,
        expected_sequence=before_sequence + 1,
        label="regular-busy CLEANING retry",
    )


def product_effects() -> dict[str, Any]:
    if os.geteuid() != CLIENT_UID or os.getegid() != CLIENT_GID:
        raise Undecidable("--installed requires exact uid501/gid20")
    before_sequence, _before_receipt = receipt_state()
    if not namespace_empty_runtime():
        raise Rig("installed effect review did not start from zero runtime residue")
    fixed_baseline = fixed_installation_snapshot(require_clean_metadata=True)

    def require_fixed_unchanged(label: str) -> None:
        if fixed_installation_snapshot(require_clean_metadata=True) != fixed_baseline:
            raise Rig(f"fixed installed identity changed: {label}")

    malformed_stream_effects()
    require_fixed_unchanged("malformed stream rejection")
    lock_and_inherited_fd_effects()
    require_fixed_unchanged("serialization rejection and success")
    prepared_and_active_recovery_effects()
    require_fixed_unchanged("prepared/active recovery")
    cleaning_crash_recovery_effect()
    require_fixed_unchanged("cleaning recovery")
    busy_leaf_effects()
    require_fixed_unchanged("busy-leaf rejection and recovery")

    # Fully parsed semantic rejections emit one nonce-bound exact error and no effect.
    baseline = tree_snapshot(NAMESPACE)
    invalid_requests = [
        ({"operation": "create-v1", "path": "/private/tmp",
          "request_nonce": os.urandom(32).hex(), "schema_version": 1}, "INVALID_KEYS"),
        ({"operation": "create-v1", "command": ["/bin/rm"],
          "request_nonce": os.urandom(32).hex(), "schema_version": 1}, "INVALID_KEYS"),
        ({"operation": "create-v1", "pid": 1,
          "request_nonce": os.urandom(32).hex(), "schema_version": 1}, "INVALID_KEYS"),
        ({"operation": "unlink-v1", "request_nonce": os.urandom(32).hex(),
          "schema_version": 1}, "INVALID_OPERATION"),
        ({"capability": "00" * 32, "operation": "cleanup-v1",
          "request_nonce": os.urandom(32).hex(), "schema_version": 1},
         "INVALID_CAPABILITY"),
    ]
    for request, reason in invalid_requests:
        rc, responses, fds = mediator_exchange(request)
        if error_reason(rc, responses, fds, request["request_nonce"]) != reason \
                or tree_snapshot(NAMESPACE) != baseline:
            raise Rig("caller-selected authority request was not zero-effect")
        require_fixed_unchanged("semantic request rejection")

    prepared, runtime_fd, lease_fd, listener_fd = create_runtime()
    portal = Path(prepared["portal_identity"])
    active_snapshot = active_effect_snapshot(
        runtime_fd, lease_fd, listener_fd, portal,
    )

    # Same-euid cannot mutate, link, rename, or replace portal identities.
    attack_root = Path(tempfile.mkdtemp(prefix="h039-portal-attack-", dir="/private/tmp"))
    track_temp_root(attack_root)
    socket_path = portal / "c"
    socket_before = os.lstat(socket_path)
    attack_failures = 0
    for attack in (
        lambda: os.chmod(socket_path, 0o777),
        lambda: os.unlink(socket_path),
        lambda: os.rename(socket_path, attack_root / "moved"),
        lambda: os.link(socket_path, attack_root / "linked"),
    ):
        try:
            attack()
        except OSError:
            attack_failures += 1
    socket_after = os.lstat(socket_path)
    if attack_failures != 4 or (
        socket_before.st_dev, socket_before.st_ino, socket_before.st_mode,
        socket_before.st_uid, socket_before.st_gid, socket_before.st_nlink,
    ) != (
        socket_after.st_dev, socket_after.st_ino, socket_after.st_mode,
        socket_after.st_uid, socket_after.st_gid, socket_after.st_nlink,
    ):
        raise Rig("same-euid portal mutation succeeded")

    # Live writer and fixed one-object capacity both reject with zero effect.
    lease_nonce = os.urandom(32).hex()
    cleanup_rc, cleanup_responses, cleanup_fds = cleanup_runtime(
        prepared["capability"], lease_nonce,
    )
    if error_reason(cleanup_rc, cleanup_responses, cleanup_fds, lease_nonce) \
            != "LEASE_LIVE" \
            or active_effect_snapshot(runtime_fd, lease_fd, listener_fd, portal) \
            != active_snapshot:
        raise Rig("live FIFO writer did not reject zero-effect")
    wrong_request = {
        "capability": "00" * 32, "operation": "cleanup-v1",
        "request_nonce": os.urandom(32).hex(), "schema_version": 1,
    }
    wrong_rc, wrong_responses, wrong_fds = mediator_exchange(wrong_request)
    close_all(wrong_fds)
    if error_reason(
        wrong_rc, wrong_responses, wrong_fds, wrong_request["request_nonce"],
    ) != "INVALID_CAPABILITY" \
            or active_effect_snapshot(runtime_fd, lease_fd, listener_fd, portal) \
            != active_snapshot:
        raise Rig("wrong capability did not reject zero-effect")
    second_request = {
        "operation": "create-v1", "request_nonce": os.urandom(32).hex(),
        "schema_version": 1,
    }
    second_rc, second_responses, second_fds = mediator_exchange(second_request)
    close_all(second_fds)
    if error_reason(
        second_rc, second_responses, second_fds, second_request["request_nonce"],
    ) != "CAPACITY" \
            or active_effect_snapshot(runtime_fd, lease_fd, listener_fd, portal) \
            != active_snapshot:
        raise Rig("second outstanding create did not reject zero-effect")
    replay_create_request = {
        "operation": "create-v1", "request_nonce": prepared["request_nonce"],
        "schema_version": 1,
    }
    replay_nonce_rc, replay_nonce_responses, replay_nonce_fds = mediator_exchange(
        replay_create_request,
    )
    close_all(replay_nonce_fds)
    if error_reason(
        replay_nonce_rc, replay_nonce_responses, replay_nonce_fds,
        replay_create_request["request_nonce"],
    ) != "REPLAY" or active_effect_snapshot(
        runtime_fd, lease_fd, listener_fd, portal,
    ) != active_snapshot:
        raise Rig("used request nonce did not reject zero-effect replay")
    cross_rc, cross_responses, cross_fds = cleanup_runtime(
        prepared["capability"], prepared["request_nonce"],
    )
    close_all(cross_fds)
    if error_reason(
        cross_rc, cross_responses, cross_fds, prepared["request_nonce"],
    ) != "REPLAY" or active_effect_snapshot(
        runtime_fd, lease_fd, listener_fd, portal,
    ) != active_snapshot:
        raise Rig("current create nonce did not reject across cleanup operation")

    clean_fd = os.open(
        "clean-runtime", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600,
        dir_fd=runtime_fd,
    )
    os.write(clean_fd, b"H039-CLEAN")
    os.close(clean_fd)
    close_all((runtime_fd, listener_fd, lease_fd))
    ordinary_before_sequence, _ordinary_before_receipt = receipt_state()
    cleanup_nonce = os.urandom(32).hex()
    success_rc, success_responses, success_fds = cleanup_runtime(
        prepared["capability"], cleanup_nonce,
    )
    require_cleanup_success(
        success_rc, success_responses, success_fds,
        runtime_id=prepared["runtime_id"],
        capability_sha256=sha(bytes.fromhex(prepared["capability"])),
        create_request_nonce=prepared["request_nonce"],
        cleanup_request_nonce=cleanup_nonce,
        expected_sequence=ordinary_before_sequence + 1,
        label="ordinary cleanup",
    )
    require_fixed_unchanged("ordinary cleanup success")
    last_snapshot = tree_snapshot(NAMESPACE)
    replay_rc, replay_responses, replay_fds = cleanup_runtime(
        prepared["capability"], cleanup_nonce,
    )
    close_all(replay_fds)
    if error_reason(replay_rc, replay_responses, replay_fds, cleanup_nonce) != "REPLAY" \
            or tree_snapshot(NAMESPACE) != last_snapshot:
        raise Rig("cleanup replay did not reject")
    require_fixed_unchanged("cleanup replay rejection")
    last_create_as_cleanup_rc, last_create_as_cleanup_responses, last_create_as_cleanup_fds = \
        cleanup_runtime(prepared["capability"], prepared["request_nonce"])
    close_all(last_create_as_cleanup_fds)
    if error_reason(
        last_create_as_cleanup_rc, last_create_as_cleanup_responses,
        last_create_as_cleanup_fds, prepared["request_nonce"],
    ) != "REPLAY" or tree_snapshot(NAMESPACE) != last_snapshot:
        raise Rig("last create nonce did not reject across cleanup operation")
    cleanup_as_create = {
        "operation": "create-v1", "request_nonce": cleanup_nonce,
        "schema_version": 1,
    }
    cleanup_as_create_rc, cleanup_as_create_responses, cleanup_as_create_fds = \
        mediator_exchange(cleanup_as_create)
    close_all(cleanup_as_create_fds)
    if error_reason(
        cleanup_as_create_rc, cleanup_as_create_responses,
        cleanup_as_create_fds, cleanup_nonce,
    ) != "REPLAY" or tree_snapshot(NAMESPACE) != last_snapshot:
        raise Rig("last cleanup nonce did not reject across create operation")
    last_create_as_create = {
        "operation": "create-v1", "request_nonce": prepared["request_nonce"],
        "schema_version": 1,
    }
    last_create_as_create_rc, last_create_as_create_responses, \
        last_create_as_create_fds = mediator_exchange(last_create_as_create)
    close_all(last_create_as_create_fds)
    if error_reason(
        last_create_as_create_rc, last_create_as_create_responses,
        last_create_as_create_fds, prepared["request_nonce"],
    ) != "REPLAY" or tree_snapshot(NAMESPACE) != last_snapshot:
        raise Rig("last create nonce did not reject across create operation")
    cleaned_cap_nonce = os.urandom(32).hex()
    cleaned_cap_rc, cleaned_cap_responses, cleaned_cap_fds = cleanup_runtime(
        prepared["capability"], cleaned_cap_nonce,
    )
    close_all(cleaned_cap_fds)
    if error_reason(
        cleaned_cap_rc, cleaned_cap_responses, cleaned_cap_fds,
        cleaned_cap_nonce,
    ) != "INVALID_CAPABILITY" or tree_snapshot(NAMESPACE) != last_snapshot:
        raise Rig("cleaned capability with fresh nonce did not reject zero-effect")
    shutil.rmtree(attack_root)


    # Runtime symlink is removed as a link; its foreign target is exact.
    canary_root = Path(tempfile.mkdtemp(prefix="h039-canary-", dir="/private/tmp"))
    track_temp_root(canary_root)
    canary = canary_root / "foreign"
    canary.write_bytes(b"H039-FOREIGN")
    canary_before = os.lstat(canary)
    canary_identity = stat_snapshot(canary_before, sha(canary.read_bytes()))
    prepared2, runtime2, lease2, listener2 = create_runtime()
    os.symlink(str(canary), "runtime-symlink", dir_fd=runtime2)
    close_all((runtime2, lease2, listener2))
    symlink_before_sequence, _symlink_before_receipt = receipt_state()
    symlink_cleanup_nonce = os.urandom(32).hex()
    rc2, responses2, fds2 = cleanup_runtime(
        prepared2["capability"], symlink_cleanup_nonce,
    )
    require_cleanup_success(
        rc2, responses2, fds2,
        runtime_id=prepared2["runtime_id"],
        capability_sha256=sha(bytes.fromhex(prepared2["capability"])),
        create_request_nonce=prepared2["request_nonce"],
        cleanup_request_nonce=symlink_cleanup_nonce,
        expected_sequence=symlink_before_sequence + 1,
        label="symlink cleanup",
    )
    canary_after = os.lstat(canary)
    if canary.name != "foreign" \
            or stat_snapshot(canary_after, sha(canary.read_bytes())) != canary_identity \
            or canary.read_bytes() != b"H039-FOREIGN":
        raise Rig("symlink cleanup followed or changed foreign target")
    require_fixed_unchanged("symlink cleanup success")

    # Multi-link inode rejects; after the gate removes its own outside link, retry succeeds.
    prepared3, runtime3, lease3, listener3 = create_runtime()
    internal = os.open(
        "hardlink-source", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600,
        dir_fd=runtime3,
    )
    os.write(internal, b"H039-HARDLINK")
    os.close(internal)
    outside_link = canary_root / "test-owned-link"
    os.link("hardlink-source", outside_link, src_dir_fd=runtime3)
    outside_before = os.lstat(outside_link)
    close_all((runtime3, lease3, listener3))
    hard_nonce = os.urandom(32).hex()
    hard_rc, hard_responses, hard_fds = cleanup_runtime(
        prepared3["capability"], hard_nonce,
    )
    close_all(hard_fds)
    outside_after = os.lstat(outside_link)
    if error_reason(hard_rc, hard_responses, hard_fds, hard_nonce) \
            != "INCOMPLETE_UNIQUE" \
            or outside_link.read_bytes() != b"H039-HARDLINK" \
            or stat_snapshot(outside_after, sha(outside_link.read_bytes())) \
            != stat_snapshot(outside_before, sha(b"H039-HARDLINK")) \
            or outside_after.st_nlink != 2:
        raise Rig("hardlink did not fail incomplete and preserve outside name")
    outside_link.unlink()
    require_current_cleanup_nonce_replay(
        prepared3["capability"], hard_nonce, "hardlink reconciliation",
    )
    hard_before_sequence, _hard_before_receipt = receipt_state()
    hard_retry_nonce = os.urandom(32).hex()
    retry_rc, retry_responses, retry_fds = cleanup_runtime(
        prepared3["capability"], hard_retry_nonce,
    )
    require_cleanup_success(
        retry_rc, retry_responses, retry_fds,
        runtime_id=prepared3["runtime_id"],
        capability_sha256=sha(bytes.fromhex(prepared3["capability"])),
        create_request_nonce=prepared3["request_nonce"],
        cleanup_request_nonce=hard_retry_nonce,
        expected_sequence=hard_before_sequence + 1,
        label="hardlink reconciliation retry",
    )
    require_fixed_unchanged("hardlink rejection and recovery")

    # AT_UNIQUE also guards a hardlinked symlink while never following its target.
    prepared4, runtime4, lease4, listener4 = create_runtime()
    os.symlink(str(canary), "symlink-source", dir_fd=runtime4)
    outside_symlink = canary_root / "test-owned-symlink-link"
    os.link(
        "symlink-source", outside_symlink, src_dir_fd=runtime4,
        follow_symlinks=False,
    )
    target_before = tree_snapshot(canary_root)
    close_all((runtime4, lease4, listener4))
    hard_symlink_nonce = os.urandom(32).hex()
    symlink_rc, symlink_responses, symlink_fds = cleanup_runtime(
        prepared4["capability"], hard_symlink_nonce,
    )
    close_all(symlink_fds)
    if error_reason(
        symlink_rc, symlink_responses, symlink_fds, hard_symlink_nonce,
    ) != "INCOMPLETE_UNIQUE" \
            or tree_snapshot(canary_root) != target_before:
        raise Rig("hardlinked symlink did not reject and preserve target/links")
    outside_symlink.unlink()
    require_current_cleanup_nonce_replay(
        prepared4["capability"], hard_symlink_nonce,
        "hardlinked-symlink reconciliation",
    )
    hard_symlink_before_sequence, _hard_symlink_before_receipt = receipt_state()
    hard_symlink_retry_nonce = os.urandom(32).hex()
    symlink_retry_rc, symlink_retry_responses, symlink_retry_fds = cleanup_runtime(
        prepared4["capability"], hard_symlink_retry_nonce,
    )
    require_cleanup_success(
        symlink_retry_rc, symlink_retry_responses, symlink_retry_fds,
        runtime_id=prepared4["runtime_id"],
        capability_sha256=sha(bytes.fromhex(prepared4["capability"])),
        create_request_nonce=prepared4["request_nonce"],
        cleanup_request_nonce=hard_symlink_retry_nonce,
        expected_sequence=hard_symlink_before_sequence + 1,
        label="hardlinked-symlink reconciliation retry",
    )
    require_fixed_unchanged("hardlinked-symlink rejection and recovery")
    shutil.rmtree(canary_root)

    if not namespace_empty_runtime():
        raise Rig("installed effect matrix left runtime residue")
    require_fixed_unchanged("complete installed effect matrix")
    live_gate_processes = [process.pid for process in TEST_PROCESSES if process.poll() is None]
    if TEST_FDS or live_gate_processes:
        raise Rig(
            f"installed effect matrix left owned descriptors/processes "
            f"fds={sorted(TEST_FDS)} pids={live_gate_processes}"
        )
    final_sequence, _final_receipt = receipt_state()
    return {
        "two_phase_create": True, "three_ordered_fds": True,
        "request_eof": True, "live_lease_zero_effect": True,
        "capacity_zero_effect": True, "portal_same_euid_safe": True,
        "no_envelope_file_authority": True,
        "symlink_target_preserved": True, "hardlink_incomplete_recovered": True,
        "hardlinked_symlink_incomplete_recovered": True,
        "zero_runtime_residue": True,
        "bounded_receipt_sequence": final_sequence == before_sequence + 13,
        "replay_rejected": True,
        "malformed_zero_response_effect": True,
        "create_create_ofd_contention_and_inherited_fd_closed": True,
        "create_cleanup_ofd_contention": True,
        "cleanup_cleanup_ofd_contention": True,
        "prepared_and_active_recovery": True,
        "killed_cleaning_recovery": True,
        "busy_listener_and_regular_leaf": True,
        "zero_owned_process_or_descriptor_residue": True,
    }


def cleanup_gate_owned_effects() -> None:
    close_all(list(TEST_FDS))
    for process in TEST_PROCESSES:
        if process.poll() is None:
            process.kill()
            process.wait(timeout=5)
        for stream in (process.stdout, process.stderr):
            if stream is not None and not stream.closed:
                stream.close()

    def recover_tracked_runtime() -> None:
        if not NAMESPACE.is_dir() or namespace_empty_runtime():
            return
        for _attempt in range(3):
            if namespace_empty_runtime():
                break
            current_path = NAMESPACE / "s" / "current"
            if not current_path.is_file():
                receipt_temp = NAMESPACE / "r" / ".last.tmp"
                if receipt_temp.is_file():
                    pending = strict_json(receipt_temp.read_bytes())
                    tracked_terminal = isinstance(pending, dict) and (
                        pending.get("create_request_nonce") in TEST_CREATE_NONCES
                    )
                    if tracked_terminal:
                        request = create_request()
                        rc, responses, fds = mediator_exchange(request)
                        close_all(fds)
                        if error_reason(
                            rc, responses, fds, request["request_nonce"],
                        ) == "RECOVERED_RETRY":
                            continue
                break
            state = strict_json(current_path.read_bytes())
            if not isinstance(state, dict) or not valid_hex(state.get("capability_sha256")):
                break
            matching = next(
                (capability for capability in reversed(TEST_CAPABILITIES)
                 if sha(bytes.fromhex(capability)) == state["capability_sha256"]),
                None,
            )
            phase = state.get("phase")
            tracked_create = state.get("create_request_nonce") in TEST_CREATE_NONCES
            if phase in {
                "RESERVING", "CREATING", "PUBLISHING", "PREPARING", "PREPARED",
            } and tracked_create:
                request = create_request()
                rc, responses, fds = mediator_exchange(request)
                close_all(fds)
                if error_reason(
                    rc, responses, fds, request["request_nonce"],
                ) != "RECOVERED_RETRY":
                    break
            elif phase in {
                "ACTIVE", "QUARANTINING", "CLEANING",
            } and matching is None and tracked_create:
                request = create_request()
                rc, responses, fds = mediator_exchange(request)
                close_all(fds)
                if error_reason(
                    rc, responses, fds, request["request_nonce"],
                ) != "RECOVERED_RETRY":
                    break
            elif phase in {
                "ACTIVE", "QUARANTINING", "CLEANING",
            } and matching is not None:
                rc, _responses, fds = cleanup_runtime(
                    matching, os.urandom(32).hex(),
                )
                close_all(fds)
                if rc != 0:
                    break
            else:
                break

    recover_tracked_runtime()

    temp_error = False
    for path, expected_dev, expected_ino in TEST_TEMP_ROOTS:
        if not path.exists() and not path.is_symlink():
            continue
        value = os.lstat(path)
        if not stat.S_ISDIR(value.st_mode) or (value.st_dev, value.st_ino) != (
            expected_dev, expected_ino,
        ):
            temp_error = True
            continue
        shutil.rmtree(path)
    # An outside gate-owned hardlink can legitimately keep the registered
    # quarantine non-unique until its identity-checked temp root is removed.
    # Retry the same capability-bound recovery only after those exact roots
    # are gone, then compute the final residue verdict.
    recover_tracked_runtime()
    residue = NAMESPACE.is_dir() and not namespace_empty_runtime()
    if residue or temp_error:
        raise Rig(
            f"gate-owned cleanup incomplete runtime_residue={residue} "
            f"temp_identity_error={temp_error}"
        )


def guarded_product_effects() -> dict[str, Any]:
    try:
        return product_effects()
    except Exception as original:
        try:
            cleanup_gate_owned_effects()
        except Exception as cleanup_error:
            raise Rig(f"{original}; additionally {cleanup_error}") from original
        raise



def published_r7_product_preeffects_baseline(
    *, require_repo_r7: bool = True,
) -> tuple[bool, dict[str, Any]]:
    repo: dict[str, dict[str, Any]] = {}
    for path in PRODUCT_PATHS:
        target = ROOT / path
        try:
            value = os.lstat(target)
            observed = {
                "regular": stat.S_ISREG(value.st_mode) and not target.is_symlink(),
                "mode": f"100{stat.S_IMODE(value.st_mode):03o}",
                "nlink": value.st_nlink,
                "sha256": path_sha(target),
            }
        except OSError as exc:
            observed = {"error": str(exc)}
        repo[path] = observed
    repo_ok = all(
        value == {
            "regular": True, "mode": PRODUCT_MODES[path], "nlink": 1,
            "sha256": PUBLISHED_H039_R7_PRODUCT_BLOBS[path],
        }
        for path, value in repo.items()
    )
    installed = INSTALLED.exists() or INSTALLED.is_symlink()
    try:
        evidence_raw = PREFIX1_EVIDENCE.read_bytes()
        evidence = strict_json(evidence_raw)
        namespace_value = os.lstat(NAMESPACE)
        namespace_stat = (
            namespace_value.st_dev, namespace_value.st_ino,
            stat.S_IMODE(namespace_value.st_mode), namespace_value.st_uid,
            namespace_value.st_gid, namespace_value.st_nlink,
            namespace_value.st_size, namespace_value.st_flags,
        )
        evidence_ok = (
            sha(evidence_raw) == PREFIX1_EVIDENCE_SHA256
            and isinstance(evidence, dict)
            and evidence.get("published_product_merge")
            == PUBLISHED_H039_R7_PRODUCT_MERGE
            and evidence.get("first_root_prefix_index") == 1
            and evidence.get("exact_child_argv") == FIRST_ROOT_ARGV[0]
            and evidence.get("owner_terminal_result") == {
                "exit_code": 0, "stdout": "", "stderr": "",
                "credential_disclosed_to_agent": False,
            }
            and evidence.get("root_read_only_rebind", {}).get("before_stat")
            == "16777232:126958092:40700:0:0:2:64:0"
            and evidence.get("root_read_only_rebind", {}).get("after_stat")
            == "16777232:126958092:40700:0:0:2:64:0"
            and evidence.get("root_read_only_rebind", {}).get("stat_exit_codes")
            == [0, 0]
            and evidence.get("root_read_only_rebind", {}).get("ls_exit_code") == 0
            and evidence.get("root_read_only_rebind", {}).get("acl") == []
            and evidence.get("root_read_only_rebind", {}).get("xattrs") == []
            and evidence.get("fixed_descendants") == {
                str(NAMESPACE / ".install"): "ABSENT",
                str(INSTALLED): "ABSENT",
            }
            and evidence.get("continued_root_effect") is False
            and evidence.get("rollback_effect") is False
            and evidence.get("supervisor_resume") is False
        )
        current_namespace_ok = (
            stat.S_ISDIR(namespace_value.st_mode) and not NAMESPACE.is_symlink()
            and namespace_stat == (
                16777232, 126958092, 0o700, 0, 0, 3, 96, 0,
            )
        )
        try:
            os.lstat(PROTECTED_INSTALLER)
            protected_descendant_observation = "UNEXPECTEDLY_TRAVERSABLE"
        except PermissionError:
            protected_descendant_observation = "EACCES_AS_UID501"
        except OSError as exc:
            protected_descendant_observation = f"UNEXPECTED:{exc.errno}"
    except (OSError, Rig, ValueError) as exc:
        evidence_ok = False
        evidence = {"error": str(exc)}
        namespace_stat = "UNAVAILABLE"
        current_namespace_ok = False
        protected_descendant_observation = "UNAVAILABLE"
    return (
        (repo_ok or not require_repo_r7) and not installed and evidence_ok and current_namespace_ok
        and protected_descendant_observation == "EACCES_AS_UID501"
    ), {
        "repo": repo, "repo_r7_required": require_repo_r7,
        "installed": installed, "prefix1_evidence": evidence,
        "namespace_stat": namespace_stat, "historical_prefix1_evidence_ok": evidence_ok,
        "current_namespace_ok": current_namespace_ok,
        "protected_descendant_observation": protected_descendant_observation,
        "owner_recorded_preeffects": R13_PRESERVED_R7_PRE_EFFECTS,
        "live_descendant_claim": "DEFERRED_TO_MANDATORY_ROOT_REAUTH_BEFORE_CHMOD0400",
    }


def published_r8_zero_effect_baseline(
    *, require_repo_r8: bool = True,
) -> tuple[bool, dict[str, Any]]:
    repo: dict[str, dict[str, Any]] = {}
    for path in PRODUCT_PATHS:
        target = ROOT / path
        try:
            value = os.lstat(target)
            observed = {
                "regular": stat.S_ISREG(value.st_mode) and not target.is_symlink(),
                "mode": f"100{stat.S_IMODE(value.st_mode):03o}",
                "nlink": value.st_nlink,
                "sha256": path_sha(target),
            }
        except OSError as exc:
            observed = {"error": str(exc)}
        repo[path] = observed
    repo_ok = all(
        value == {
            "regular": True, "mode": PRODUCT_MODES[path], "nlink": 1,
            "sha256": PUBLISHED_H039_R8_PRODUCT_BLOBS[path],
        }
        for path, value in repo.items()
    )
    try:
        record_raw = ZERO_EFFECT_EVIDENCE.read_bytes()
        record = strict_json(record_raw)
        pre = record["pre_bootstrap_transcript"]
        post = record["post_bootstrap_transcript"]
        evidence_root = Path("/Users/elinhaggstrom/nortropic")
        pre_raw = (evidence_root / pre["path"]).read_bytes()
        post_raw = (evidence_root / post["path"]).read_bytes()
        record_ok = (
            sha(record_raw) == ZERO_EFFECT_EVIDENCE_SHA256
            and type(record) is dict
            and record.get("schema_version") == 1
            and record.get("record_type")
            == "nortropic_h039_r13_r4_r8_bootstrap_zero_effect_owner_stop"
            and record.get("contract_merge_sha") == PUBLISHED_H039_R8_CONTRACT_MERGE
            and record.get("product_candidate_sha")
            == PUBLISHED_H039_R8_PRODUCT_CANDIDATE
            and record.get("product_merge_sha") == PUBLISHED_H039_R8_PRODUCT_MERGE
            and record.get("installer_sha256")
            == PUBLISHED_H039_R8_PRODUCT_BLOBS["controller/runtime-cleanup/install"]
            and type(record.get("installer_size")) is int
            and record.get("installer_size") == 169264
            and type(record.get("bootstrap_exit")) is int
            and record.get("bootstrap_exit") == 1
            and record.get("transcripts_cmp_equal") is True
            and record.get("root_tree_effect") is False
            and record.get("current_phase")
            == "R8_READY_0500_AFTER_FAILED_BOOTSTRAP_RC1"
            and type(pre) is dict and type(post) is dict
            and pre.get("sha256") == ZERO_EFFECT_TRANSCRIPT_SHA256
            and post.get("sha256") == ZERO_EFFECT_TRANSCRIPT_SHA256
            and type(pre.get("size")) is int and pre.get("size") == ZERO_EFFECT_TRANSCRIPT_SIZE
            and type(post.get("size")) is int and post.get("size") == ZERO_EFFECT_TRANSCRIPT_SIZE
            and len(pre_raw) == ZERO_EFFECT_TRANSCRIPT_SIZE
            and len(post_raw) == ZERO_EFFECT_TRANSCRIPT_SIZE
            and sha(pre_raw) == ZERO_EFFECT_TRANSCRIPT_SHA256
            and sha(post_raw) == ZERO_EFFECT_TRANSCRIPT_SHA256
            and pre_raw == post_raw
            and record.get("disposition", {}).get("product_change_authorized") is False
            and record.get("disposition", {}).get("supervisor_resume_authorized") is False
        )
        namespace_value = os.lstat(NAMESPACE)
        namespace_stat = (
            namespace_value.st_dev, namespace_value.st_ino,
            stat.S_IMODE(namespace_value.st_mode), namespace_value.st_uid,
            namespace_value.st_gid, namespace_value.st_nlink,
            namespace_value.st_size, namespace_value.st_flags,
        )
        namespace_ok = (
            stat.S_ISDIR(namespace_value.st_mode) and not NAMESPACE.is_symlink()
            and namespace_stat == (16777232, 126958092, 0o700, 0, 0, 3, 96, 0)
        )
        try:
            os.lstat(PROTECTED_INSTALLER)
            descendant = "UNEXPECTEDLY_TRAVERSABLE"
        except PermissionError:
            descendant = "EACCES_AS_UID501"
        except OSError as exc:
            descendant = f"UNEXPECTED:{exc.errno}"
    except (KeyError, OSError, Rig, TypeError, ValueError) as exc:
        record_ok = False
        record = {"error": str(exc)}
        namespace_stat = "UNAVAILABLE"
        namespace_ok = False
        descendant = "UNAVAILABLE"
    installed = INSTALLED.exists() or INSTALLED.is_symlink()
    return (
        (repo_ok or not require_repo_r8) and record_ok and namespace_ok
        and descendant == "EACCES_AS_UID501" and not installed
    ), {
        "repo": repo, "repo_r8_required": require_repo_r8,
        "zero_effect_record": record, "zero_effect_record_ok": record_ok,
        "namespace_stat": namespace_stat, "namespace_ok": namespace_ok,
        "protected_descendant_observation": descendant, "installed": installed,
    }


def finish(phase: str) -> int:
    print(f"MATERIAL_PROPERTIES_JUDGE_ONLY={MATERIAL_PROPERTIES_JUDGE_ONLY}")
    print(f"R6_MATERIAL_REVIEW_EXTENSION={R6_MATERIAL_REVIEW_EXTENSION}")
    print(f"R7_MATERIAL_REVIEW_EXTENSION={R7_MATERIAL_REVIEW_EXTENSION}")
    print(f"R8_MATERIAL_REVIEW_EXTENSION={R8_MATERIAL_REVIEW_EXTENSION}")
    print(f"R9_MATERIAL_REVIEW_EXTENSION={R9_MATERIAL_REVIEW_EXTENSION}")
    print(f"R10_MATERIAL_REVIEW_EXTENSION={R10_MATERIAL_REVIEW_EXTENSION}")
    print(f"R11_MATERIAL_REVIEW_EXTENSION={R11_MATERIAL_REVIEW_EXTENSION}")
    print(f"R12_MATERIAL_REVIEW_EXTENSION={R12_MATERIAL_REVIEW_EXTENSION}")
    print(f"R13_MATERIAL_REVIEW_EXTENSION={R13_MATERIAL_REVIEW_EXTENSION}")
    print(f"R13_TYPED_RECOVERY_REVIEW_EXTENSION={R13_TYPED_RECOVERY_REVIEW_EXTENSION}")
    print(f"R13_FULL_FIRST_ROOT_TYPED_REVIEW_EXTENSION={R13_FULL_FIRST_ROOT_TYPED_REVIEW_EXTENSION}")
    print(f"R13_PRECOMPARISON_EXACT_TYPED_REVIEW_EXTENSION={R13_PRECOMPARISON_EXACT_TYPED_REVIEW_EXTENSION}")
    print(f"R14_MATERIAL_REVIEW_EXTENSION={R14_MATERIAL_REVIEW_EXTENSION}")
    print(f"H039_GATE_SUMMARY={passed} PASS {failed} FAIL")
    if failed == 0:
        if phase == "published":
            print("H039_GATE_RESULT=PASS_PRE_ROOT_PRODUCT_PUBLICATION_ONLY")
        else:
            print("H039_GATE_RESULT=PASS")
        return 0
    expected = canonical({
        "failure_signature": FAILURE_SIGNATURE, "reason": REASON,
    }).decode()
    if phase == "preproduct" and failed_labels == [(LABEL, expected)]:
        print(f"H039_GATE_RESULT=RED_EXPECTED label={LABEL} reason={REASON}")
        return 1
    print("H039_GATE_RESULT=FAIL")
    return 1


def main(argv: list[str]) -> int:
    if sys.version_info[:2] != (3, 12):
        print(
            f"ODÖMBART H039_HOST_ENVIRONMENT — pinned Python 3.12 required, "
            f"got {sys.version.split()[0]}"
        )
        print(f"MATERIAL_PROPERTIES_JUDGE_ONLY={MATERIAL_PROPERTIES_JUDGE_ONLY}")
        print(f"R6_MATERIAL_REVIEW_EXTENSION={R6_MATERIAL_REVIEW_EXTENSION}")
        print(f"R7_MATERIAL_REVIEW_EXTENSION={R7_MATERIAL_REVIEW_EXTENSION}")
        print(f"R8_MATERIAL_REVIEW_EXTENSION={R8_MATERIAL_REVIEW_EXTENSION}")
        print(f"R9_MATERIAL_REVIEW_EXTENSION={R9_MATERIAL_REVIEW_EXTENSION}")
        print(f"R10_MATERIAL_REVIEW_EXTENSION={R10_MATERIAL_REVIEW_EXTENSION}")
        print(f"R11_MATERIAL_REVIEW_EXTENSION={R11_MATERIAL_REVIEW_EXTENSION}")
        print(f"R12_MATERIAL_REVIEW_EXTENSION={R12_MATERIAL_REVIEW_EXTENSION}")
        print(f"R13_MATERIAL_REVIEW_EXTENSION={R13_MATERIAL_REVIEW_EXTENSION}")
        print(f"R13_TYPED_RECOVERY_REVIEW_EXTENSION={R13_TYPED_RECOVERY_REVIEW_EXTENSION}")
        print(f"R13_FULL_FIRST_ROOT_TYPED_REVIEW_EXTENSION={R13_FULL_FIRST_ROOT_TYPED_REVIEW_EXTENSION}")
        print(f"R13_PRECOMPARISON_EXACT_TYPED_REVIEW_EXTENSION={R13_PRECOMPARISON_EXACT_TYPED_REVIEW_EXTENSION}")
        print(f"R14_MATERIAL_REVIEW_EXTENSION={R14_MATERIAL_REVIEW_EXTENSION}")
        return 2
    if os.geteuid() == 0:
        print("ODÖMBART H039_HOST_ENVIRONMENT — Python gate must never run as root")
        print(f"MATERIAL_PROPERTIES_JUDGE_ONLY={MATERIAL_PROPERTIES_JUDGE_ONLY}")
        print(f"R6_MATERIAL_REVIEW_EXTENSION={R6_MATERIAL_REVIEW_EXTENSION}")
        print(f"R7_MATERIAL_REVIEW_EXTENSION={R7_MATERIAL_REVIEW_EXTENSION}")
        print(f"R8_MATERIAL_REVIEW_EXTENSION={R8_MATERIAL_REVIEW_EXTENSION}")
        print(f"R9_MATERIAL_REVIEW_EXTENSION={R9_MATERIAL_REVIEW_EXTENSION}")
        print(f"R10_MATERIAL_REVIEW_EXTENSION={R10_MATERIAL_REVIEW_EXTENSION}")
        print(f"R11_MATERIAL_REVIEW_EXTENSION={R11_MATERIAL_REVIEW_EXTENSION}")
        print(f"R12_MATERIAL_REVIEW_EXTENSION={R12_MATERIAL_REVIEW_EXTENSION}")
        print(f"R13_MATERIAL_REVIEW_EXTENSION={R13_MATERIAL_REVIEW_EXTENSION}")
        print(f"R13_TYPED_RECOVERY_REVIEW_EXTENSION={R13_TYPED_RECOVERY_REVIEW_EXTENSION}")
        print(f"R13_FULL_FIRST_ROOT_TYPED_REVIEW_EXTENSION={R13_FULL_FIRST_ROOT_TYPED_REVIEW_EXTENSION}")
        print(f"R13_PRECOMPARISON_EXACT_TYPED_REVIEW_EXTENSION={R13_PRECOMPARISON_EXACT_TYPED_REVIEW_EXTENSION}")
        print(f"R14_MATERIAL_REVIEW_EXTENSION={R14_MATERIAL_REVIEW_EXTENSION}")
        return 2
    preproduct = not argv
    product = len(argv) == 3 and argv[0] == "--product"
    published = len(argv) == 2 and argv[0] == "--published"
    if not (preproduct or product or published):
        print(
            "RIG_ERROR: usage: h-039-exit [--product PUBLISHED_R14_CONTRACT_MERGE "
            "R9_DIAGNOSTIC_CANDIDATE | --published PUBLISHED_R9_PRODUCT_MERGE]",
            file=sys.stderr,
        )
        return 2
    supplied_commits = argv[1:] if product or published else []
    if any(not valid_hex(value, 40) for value in supplied_commits):
        print("RIG_ERROR: every commit argument must be exact lowercase 40-hex", file=sys.stderr)
        return 2
    phase = (
        "preproduct" if preproduct else "product" if product else "published"
    )
    try:
        if any(object_type(value) != "commit" for value in supplied_commits):
            raise Rig("every supplied identity must name a literal commit object")
        row = static_contract_checks()
        contract_selftests(row)
        r14_registry_selftests(row)
        r14_diagnostic_source_oracle_selftests()
        causal_oracle_selftests()
        seatbelt_profile_selftests()
        ofd_lock_reference()
        connected_stream_unlink_reference()
        managed_option_a_reference()
        fd_relative_integration_reference()
        if preproduct:
            baseline, detail = published_r8_zero_effect_baseline()
            check(
                baseline,
                "A_H039_R14_PUBLISHED_R8_ZERO_EFFECT_BASELINE",
                detail,
            )
            if not baseline:
                raise Rig("R14 baseline is not the exact published R8 zero-effect state")
            recipe, manifest = manifest_checks(
                PUBLISHED_H039_R8_PRODUCT_MERGE,
            )
            immutable_source_checks(PUBLISHED_H039_R8_PRODUCT_MERGE)
            reproducible_rebuild(recipe, PUBLISHED_H039_R8_PRODUCT_MERGE)
            r14_reference_rebuild()
            macho_checks(manifest, PUBLISHED_H039_R8_PRODUCT_MERGE)
            installer_verify_effects(PUBLISHED_H039_R8_PRODUCT_MERGE)
            check(True, "A_H039_R14_RETAINED_R8_PRODUCT_REVIEWED_ZERO_EFFECT")
            check(False, LABEL, {
                "failure_signature": FAILURE_SIGNATURE, "reason": REASON,
            })
            return finish(phase)

        if product:
            root_before, root_before_detail = \
                published_r8_zero_effect_baseline(require_repo_r8=False)
            check(
                root_before, "A_H039_R14_DIAGNOSTIC_REVIEW_ZERO_EFFECT_BEFORE",
                root_before_detail,
            )
            if not root_before:
                return finish(phase)
            identity_ok, identity_detail = product_identity(argv[1], argv[2])
            check(
                identity_ok, "A_H039_R14_EXACT_DIRECT_CHILD_FOUR_FILE_R9_IDENTITY",
                identity_detail,
            )
            if not identity_ok:
                return finish(phase)
            recipe, manifest = manifest_checks(argv[2], diagnostic_product=True)
            immutable_source_checks(argv[2], diagnostic_product=True)
            reproducible_rebuild(recipe, argv[2])
            macho_checks(manifest, argv[2], diagnostic_product=True)
            installer_verify_effects(argv[2], diagnostic_product=True)
            root_after, root_after_detail = \
                published_r8_zero_effect_baseline(require_repo_r8=False)
            check(
                root_after and root_after_detail == root_before_detail,
                "A_H039_R14_DIAGNOSTIC_PRODUCT_REVIEW_ZERO_ROOT_EFFECT",
                {"before": root_before_detail, "after": root_after_detail},
            )
            return finish(phase)

        root_before, root_before_detail = \
            published_r8_zero_effect_baseline(require_repo_r8=False)
        check(
            root_before, "A_H039_R14_PUBLISHED_DIAGNOSTIC_ZERO_EFFECT_BEFORE",
            root_before_detail,
        )
        if not root_before:
            return finish(phase)
        publication_ok, publication_detail = product_publication_identity(argv[1])
        check(
            publication_ok, "A_H039_R14_GUARDED_DIAGNOSTIC_PUBLICATION_IDENTITY",
            publication_detail,
        )
        if not publication_ok:
            return finish(phase)
        recipe, manifest = manifest_checks(argv[1], diagnostic_product=True)
        immutable_source_checks(argv[1], diagnostic_product=True)
        reproducible_rebuild(recipe, argv[1])
        macho_checks(manifest, argv[1], diagnostic_product=True)
        installer_verify_effects(argv[1], diagnostic_product=True)
        root_after, root_after_detail = \
            published_r8_zero_effect_baseline(require_repo_r8=False)
        check(
            root_after and root_after_detail == root_before_detail,
            "A_H039_R14_PUBLISHED_DIAGNOSTIC_ZERO_ROOT_EFFECT",
            {"before": root_before_detail, "after": root_after_detail},
        )
        return finish(phase)
    except Undecidable as exc:
        print(f"ODÖMBART H039_HOST_ENVIRONMENT — {exc}")
        print(f"MATERIAL_PROPERTIES_JUDGE_ONLY={MATERIAL_PROPERTIES_JUDGE_ONLY}")
        print(f"R6_MATERIAL_REVIEW_EXTENSION={R6_MATERIAL_REVIEW_EXTENSION}")
        print(f"R7_MATERIAL_REVIEW_EXTENSION={R7_MATERIAL_REVIEW_EXTENSION}")
        print(f"R8_MATERIAL_REVIEW_EXTENSION={R8_MATERIAL_REVIEW_EXTENSION}")
        print(f"R9_MATERIAL_REVIEW_EXTENSION={R9_MATERIAL_REVIEW_EXTENSION}")
        print(f"R10_MATERIAL_REVIEW_EXTENSION={R10_MATERIAL_REVIEW_EXTENSION}")
        print(f"R11_MATERIAL_REVIEW_EXTENSION={R11_MATERIAL_REVIEW_EXTENSION}")
        print(f"R12_MATERIAL_REVIEW_EXTENSION={R12_MATERIAL_REVIEW_EXTENSION}")
        print(f"R13_MATERIAL_REVIEW_EXTENSION={R13_MATERIAL_REVIEW_EXTENSION}")
        print(f"R13_TYPED_RECOVERY_REVIEW_EXTENSION={R13_TYPED_RECOVERY_REVIEW_EXTENSION}")
        print(f"R13_FULL_FIRST_ROOT_TYPED_REVIEW_EXTENSION={R13_FULL_FIRST_ROOT_TYPED_REVIEW_EXTENSION}")
        print(f"R13_PRECOMPARISON_EXACT_TYPED_REVIEW_EXTENSION={R13_PRECOMPARISON_EXACT_TYPED_REVIEW_EXTENSION}")
        print(f"R14_MATERIAL_REVIEW_EXTENSION={R14_MATERIAL_REVIEW_EXTENSION}")
        return 2
    except (OSError, ValueError, subprocess.SubprocessError, Rig) as exc:
        print(f"RIG_ERROR: {exc}", file=sys.stderr)
        return 2



if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
