    r13_r8_bytes = b"H039-R13-R8-INSTALLER-BYTES"
    r13_r8_cdhash = "c7" * 20
    r13_migration_fixtures: dict[str, dict[str, Any]] = {}

    def r13_nodes(value: Any, path: tuple[Any, ...] = ()):  # type: ignore[no-untyped-def]
        yield path, value
        if type(value) is dict:
            for key in value:
                yield from r13_nodes(value[key], (*path, key))
        elif type(value) is list:
            for index, item in enumerate(value):
                yield from r13_nodes(item, (*path, index))

    def r13_replace(
        reference: dict[str, Any], path: tuple[Any, ...], replacement: Any,
    ) -> Any:
        if not path:
            return replacement
        mutant = copy.deepcopy(reference)
        parent: Any = mutant
        for component in path[:-1]:
            parent = parent[component]
        parent[path[-1]] = replacement
        return mutant

    def r13_key_replace(
        reference: dict[str, Any], path: tuple[Any, ...], key: str,
    ) -> dict[str, Any]:
        mutant = copy.deepcopy(reference)
        parent: Any = mutant
        for component in path:
            parent = parent[component]
        value = parent.pop(key)
        parent[generic_str_subclass(key)] = value
        return mutant

    def r13_equality_aliases(value: Any) -> list[tuple[str, Any]]:
        aliases: list[tuple[str, Any]] = [("EQUALITY_OBJECT", equality_alias(value))]
        if type(value) is dict:
            aliases.extend((
                ("DICT_SUBCLASS", record_dict_subclass(copy.deepcopy(value))),
                ("EQUALITY_DICT_SUBCLASS", equality_record(value)),
            ))
        elif type(value) is list:
            aliases.append((
                "LIST_SUBCLASS",
                type("H039R13ListSubclass", (list,), {})(copy.deepcopy(value)),
            ))
        elif type(value) is str:
            aliases.append(("STRING_SUBCLASS", generic_str_subclass(value)))
        elif type(value) is bool:
            aliases.extend((
                ("BOOL_TO_INT", int(value)),
                ("BOOL_TO_FLOAT", float(value)),
                ("BOOL_TO_COMPLEX", complex(value, 0)),
            ))
        elif type(value) is int:
            aliases.extend((
                ("INT_TO_FLOAT", float(value)),
                ("INT_TO_COMPLEX", complex(value, 0)),
                ("INT_SUBCLASS", type(structured_int_subclass)(value)),
            ))
            if value in {0, 1}:
                aliases.append(("INT_TO_BOOL", bool(value)))
        return aliases

    class MutatingEqualityAlias:
        """A value-equal proxy that repairs its own record if compared."""

        def __init__(
            self, record: dict[str, Any], path: tuple[Any, ...], expected: Any,
        ) -> None:
            self.record = record
            self.path = path
            self.expected = copy.deepcopy(expected)
            self.comparisons = 0

        def __eq__(self, other: Any) -> bool:
            self.comparisons += 1
            parent: Any = self.record
            for component in self.path[:-1]:
                parent = parent[component]
            parent[self.path[-1]] = copy.deepcopy(self.expected)
            return other == self.expected

    for prefix in range(len(FIRST_ROOT_ARGV) + 1):
        fixture = prestage_prefix_fixture(
            prefix, installer_size=123456,
            installer_sha256=prestage_sha,
            installer_cdhash=prestage_cdhash,
        )
        check(
            prestage_prefix_oracle(
                prefix, fixture, installer_size=123456,
                installer_sha256=prestage_sha,
                installer_cdhash=prestage_cdhash,
            ),
            f"A_H039_R13_R3_FIRST_ROOT_TYPED_TREE_PREFIX_{prefix:02d}",
        )
        alias_index = 0
        for path, value in r13_nodes(fixture):
            for alias_kind, replacement in r13_equality_aliases(value):
                mutant = r13_replace(fixture, path, replacement)
                if not mutant == fixture or type(replacement) is type(value):
                    raise Rig(
                        "noncausal first-root typed-tree alias "
                        f"at prefix {prefix} path {path!r}: {alias_kind}"
                    )
                check(
                    not prestage_prefix_oracle(
                        prefix, mutant, installer_size=123456,
                        installer_sha256=prestage_sha,
                        installer_cdhash=prestage_cdhash,
                    ),
                    f"N_H039_R13_R3_FIRST_ROOT_TYPED_TREE_"
                    f"{prefix:02d}_{alias_index:04d}",
                )
                alias_index += 1
            if type(value) is dict:
                for key in value:
                    key_mutant = r13_key_replace(fixture, path, key)
                    if not key_mutant == fixture:
                        raise Rig(
                            "noncausal first-root typed-tree key alias "
                            f"at prefix {prefix} path {path!r}: {key}"
                        )
                    check(
                        not prestage_prefix_oracle(
                            prefix, key_mutant, installer_size=123456,
                            installer_sha256=prestage_sha,
                            installer_cdhash=prestage_cdhash,
                        ),
                        f"N_H039_R13_R3_FIRST_ROOT_TYPED_KEY_"
                        f"{prefix:02d}_{alias_index:04d}",
                    )
                    alias_index += 1
        mutating_index = 0
        for path, value in r13_nodes(fixture):
            if not path:
                continue
            mutant = copy.deepcopy(fixture)
            parent: Any = mutant
            for component in path[:-1]:
                parent = parent[component]
            proxy = MutatingEqualityAlias(mutant, path, value)
            parent[path[-1]] = proxy
            check(
                not prestage_prefix_oracle(
                    prefix, mutant, installer_size=123456,
                    installer_sha256=prestage_sha,
                    installer_cdhash=prestage_cdhash,
                ) and proxy.comparisons == 0,
                f"N_H039_R13_R4_FIRST_ROOT_PRECOMPARISON_TYPE_CLOSURE_"
                f"{prefix:02d}_{mutating_index:04d}",
            )
            mutating_index += 1

    for phase in R13_RESTAGE_PHASES:
        fixture = r13_preeffects_migration_fixture(
            phase, r8_bytes=r13_r8_bytes, r8_cdhash=r13_r8_cdhash,
