static int h039_all_closed(void){for(int i=10;i<64;i++)if(g_fd_open[i])return 0;return 1;}
static void h039_reset(int installed,int stage,int crash,int fail_fsync){g_installed=installed;g_stage=stage;g_stage_bytes=stage==STAGE_PARTIAL?1:(stage>=STAGE_FULL?H039_MEDIATOR_SIZE:0);g_cleanup=0;g_crash=crash;g_lock=g_violation=g_stage_calls=g_rename_calls=g_helper_reads=g_write_calls=g_fsync_calls=g_after_fail=0;g_fail_fsync=fail_fsync;memset(g_fd_open,0,sizeof g_fd_open);memset(g_new_bytes,'N',sizeof g_new_bytes);}
static int h039_run(int installed,int stage,int crash,int want_result,int want_phase,int want_stage_calls,int want_rename_calls){
  h039_reset(installed,stage,crash,0);
  int result=upgrade_installed_mediator(1,2,3,4,g_new_bytes,sizeof g_new_bytes);
