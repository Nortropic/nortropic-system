def exact_created_xattrs(value: Any) -> bool:
    """Root-created objects carry no xattr or one exact nonauthority marker."""
    if type(value) is not list:
        return False
    if len(value) == 0:
        return True
    if len(value) != 1 or type(value[0]) is not dict:
        return False
    item = value[0]
    keys = list(item)
    return (
        len(keys) == 2
        and all(type(key) is str for key in keys)
        and set(keys) == {"name", "size"}
        and type(item["name"]) is str
        and item["name"] == "com.apple.provenance"
        and type(item["size"]) is int
        and item["size"] == 11
    )


def normalize_created_xattrs(value: dict[str, Any]) -> dict[str, Any]:
    normalized = copy.deepcopy(value)
    if exact_created_xattrs(normalized.get("xattrs")):
        normalized["xattrs"] = []
    return normalized
