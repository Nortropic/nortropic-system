        mutate(mutant)
        check(not valid(mutant), f"N_H039_R16_REGISTRY_{label}")


def exact_r17_installed_argv(argv: Any) -> bool:
    return (
        type(argv) is list and len(argv) == 3
        and all(type(value) is str for value in argv)
        and argv[0] == "--installed"
        and valid_hex(argv[1], 40)
        and argv[2] == PUBLISHED_H039_R8_PRODUCT_MERGE
    )


def r17_registry_selftests(row: dict[str, Any]) -> None:
    completion = row["h039_os_exclusive_runtime_cleanup"][
        "r17_installed_effect_completion"
    ]
    expected = r17_registry_expected()
    check(
        exact_typed_tree(completion, expected),
        "A_H039_R17_COMPLETION_REGISTRY_SELFTEST_ANCHOR",
    )
    for label, mutate in (
        ("KEY_REMOVED", lambda value: value.pop("identity_before_effect")),
        ("KEY_ADDED", lambda value: value.__setitem__("alternate", False)),
        ("BASE_CHANGED", lambda value: value.__setitem__("authority_base", "00" * 20)),
        ("PARENTS_SWAPPED", lambda value: value["authority_ordered_parents"].reverse()),
        ("PATH_REMOVED", lambda value: value["test_author_paths"].pop()),
        ("PATH_PREFIX", lambda value: value["test_author_paths"].__setitem__(0, "docs/**")),
        ("CLI_R8_REMOVED", lambda value: value["installed_cli"].pop()),
        ("R8_REPLACED_R9", lambda value: value.__setitem__(
            "published_r8_product_merge", PUBLISHED_H039_R9_PRODUCT_MERGE)),
        ("R8_PARENT_SWAPPED", lambda value: value[
            "published_r8_product_ordered_parents"].reverse()),
        ("R8_PATH_ADDED", lambda value: value[
            "published_r8_product_change_paths"].append("controller/runtime-cleanup/neighbor")),
        ("R8_BLOB_CHANGED", lambda value: value[
            "published_r8_product_blobs"].__setitem__(
                "controller/runtime-cleanup/install", "00" * 32)),
        ("IDENTITY_AFTER_EFFECT", lambda value: value.__setitem__(
            "identity_before_effect", False)),
        ("UID_WIDENED", lambda value: value.__setitem__("required_uid", True)),
        ("SEQUENCE_STALE", lambda value: value.__setitem__("initial_receipt_sequence", 1)),
        ("R10_RETRY", lambda value: value.__setitem__(
            "r10_diagnostic_reexecution_or_restage", True)),
        ("PRODUCT_BYTES", lambda value: value.__setitem__("new_product_bytes", True)),
        ("AUTHORITY_WIDENED", lambda value: value.__setitem__("broader_authority", True)),
    ):
        mutant = copy.deepcopy(completion)
        mutate(mutant)
        check(
            not exact_typed_tree(mutant, expected),
            f"N_H039_R17_COMPLETION_REGISTRY_{label}",
        )

    sample_merge = "ab" * 20
    check(
        exact_r17_installed_argv([
            "--installed", sample_merge, PUBLISHED_H039_R8_PRODUCT_MERGE,
        ]),
        "A_H039_R17_EXACT_INSTALLED_CLI_SHAPE",
    )
    cli_mutants = [
        [], ["--installed"], ["--installed", sample_merge],
        ["--installed", sample_merge, PUBLISHED_H039_R9_PRODUCT_MERGE],
        ["--installed", sample_merge, R17_AUTHORITY_BASE],
        ["--installed", sample_merge.upper(), PUBLISHED_H039_R8_PRODUCT_MERGE],
        ["--installed", sample_merge[:-1], PUBLISHED_H039_R8_PRODUCT_MERGE],
        ["--installed", sample_merge, PUBLISHED_H039_R8_PRODUCT_MERGE, "extra"],
        ["--published", sample_merge, PUBLISHED_H039_R8_PRODUCT_MERGE],
    ]
    for index, mutant in enumerate(cli_mutants):
        check(
            not exact_r17_installed_argv(mutant),
            f"N_H039_R17_INSTALLED_CLI_MUTANT_{index:02d}",
        )

    expected_red = {
        "label": LABEL,
        "reason": REASON,
        "failure_signature": FAILURE_SIGNATURE,
    }
    preproduct_red = row["h039_os_exclusive_runtime_cleanup"]["preproduct_red"]
    check(
        exact_typed_tree(preproduct_red, expected_red),
        "A_H039_R17_PREPRODUCT_RED_SELFTEST_ANCHOR",
    )
    for label, mutate in (
        ("REASON", lambda value: value.__setitem__(
            "reason", "H039_R16_R10_POLARITY_CORRECTED_DIAGNOSTIC_PRODUCT_ABSENT",
        )),
        ("SIGNATURE_REMOVED", lambda value: value["failure_signature"].pop()),
        ("SIGNATURE_REORDERED", lambda value: value["failure_signature"].reverse()),
        ("SIGNATURE_SUBSTITUTED", lambda value: value["failure_signature"].__setitem__(
            0, "EXACT_PUBLISHED_R9_DIAGNOSTIC_AND_RUNTIME_MEDIATOR_BYTES_PRESENT",
        )),
    ):
        mutant = copy.deepcopy(preproduct_red)
        mutate(mutant)
        check(
            not exact_typed_tree(mutant, expected_red),
            f"N_H039_R17_PREPRODUCT_RED_{label}",
        )


