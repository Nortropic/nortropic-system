        return False, {"error": str(exc), "merge": merge}


def product_bytes(path: str, commit: str | None) -> bytes:
    limit = PRODUCT_BYTE_LIMITS[path]
    if commit is not None:
        size = blob_size(commit, path)
        if size > limit:
            raise Rig(f"product blob exceeds frozen byte limit: {path}")
        raw = blob(commit, path)
    else:
        value = os.lstat(ROOT / path)
        if not stat.S_ISREG(value.st_mode) or value.st_size > limit:
            raise Rig(f"checkout product exceeds frozen byte limit: {path}")
        raw = (ROOT / path).read_bytes()
    if len(raw) > limit:
        raise Rig(f"product read exceeds frozen byte limit: {path}")
    return raw


def manifest_checks(
    commit: str | None = None, *, r13_product: bool = True,
    diagnostic_product: bool = False, r23_product: bool = False,
) -> tuple[dict[str, Any], dict[str, Any]]:
    recipe_raw = product_bytes("verify/h039/build-recipe.json", commit)
    manifest_raw = product_bytes("verify/h039/identity-manifest.json", commit)
    source_raw = product_bytes("controller/runtime-cleanup/native/mediator.c", commit)
    mediator_raw = product_bytes("verify/h039/runtime-cleanup-mediator", commit)
    installer_raw = product_bytes("controller/runtime-cleanup/install", commit)
    recipe = strict_json(recipe_raw)
    manifest = strict_json(manifest_raw)
    mediator_digest = sha(mediator_raw)
    mediator_size = len(mediator_raw)
    compiler = "/Library/Developer/CommandLineTools/usr/bin/clang"
    sdk = "/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk"
    common_compile = [
        compiler, "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
        "-fstack-protector-strong", "-D_FORTIFY_SOURCE=2", "-arch", "arm64",
        "-isysroot", sdk, "-mmacosx-version-min=15.0", "-Wl,-pie",
        "-Wl,-dead_strip",
    ]
    expected_recipe = {
        "codesign_path": "/usr/bin/codesign",
        "codesign_sha256": "9755ad3afc25a3ce6f8c281425ff732a5819f0b973846b7641a11892a2081abc",
        "compiler_path": compiler,
        "compiler_sha256": "f30550eab15fdf5ab8c0dc54c52679711241e5d4b636b027e18c09fef531775d",
        "compiler_version": "Apple clang version 21.0.0 (clang-2100.1.1.101)",
        "installer_compile_argv": [
            *common_compile,
            *(["-Wno-unused-function"] if diagnostic_product else []),
            "-DH039_INSTALLER=1",
            *(["-DH039_ROOT_ENTRY_FD0_NORMALIZATION=1"] if r13_product else []),
            *(["-DH039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC=1"]
              if diagnostic_product else []),
            f"-DH039_MEDIATOR_SHA256={mediator_digest}",
            f"-DH039_MEDIATOR_SIZE={mediator_size}",
            *(
                [
                    f"-DH039_OLD_MEDIATOR_SHA256={R23_OLD_R12_MEDIATOR_SHA256}",
                    f"-DH039_OLD_MEDIATOR_SIZE={R23_OLD_R12_MEDIATOR_SIZE}",
                ]
                if r23_product else []
            ),
            "-Wl,-segprot,__H039RO,r,r",
            "-Wl,-sectcreate,__H039RO,__h039med,verify/h039/runtime-cleanup-mediator",
            "controller/runtime-cleanup/native/mediator.c",
            "-o", "controller/runtime-cleanup/install",
        ],
        "installer_sign_argv": [
            "/usr/bin/codesign", "--force", "--options", "runtime", "--sign", "-",
            "--identifier", "se.nortropic.runtime-cleanup-installer", "--timestamp=none",
            "controller/runtime-cleanup/install",
        ],
        "language": "C", "schema_version": 1,
        "mediator_compile_argv": [
            *common_compile,
            "controller/runtime-cleanup/native/mediator.c",
            "-o", "verify/h039/runtime-cleanup-mediator",
        ],
        "mediator_sign_argv": [
            "/usr/bin/codesign", "--force", "--options", "runtime", "--sign", "-",
            "--identifier", "se.nortropic.runtime-cleanup-mediator", "--timestamp=none",
            "verify/h039/runtime-cleanup-mediator",
        ],
        "sdk_path": sdk,
        "sdk_settings_sha256": "f8d005f09381389167f9e0aeaa169bc9e7dff162ef22ca2fd8e98df7ff1acafe",
        "sdk_version": "26.5",
        "source_mode": "100644",
    }
    if not isinstance(recipe, dict) \
            or type(recipe.get("schema_version")) is not int \
            or recipe != expected_recipe:
        raise Rig("build recipe mismatch")
    if r23_product and recipe_raw != r23_expected_production_recipe(mediator_raw):
        raise Rig("R23 production recipe raw bytes are not exact R12 transform")
    required = {
        "schema_version", "artifact_path", "artifact_sha256", "source_sha256",
        "installer_path", "installer_sha256", "recipe_sha256",
        "installer_size", "embedded_mediator_section",
        "embedded_mediator_sha256", "embedded_mediator_size",
        "bootstrap_installer_path", "bootstrap_operation",
        "mediator_codesign_cdhash", "installer_codesign_cdhash",
        "mediator_lc_uuid", "installer_lc_uuid", "platform", "minos", "sdk",
        "mediator_dependencies", "installer_dependencies", "installed_path",
        "installed_uid", "installed_gid", "installed_mode", "namespace_path",
        "namespace_uid", "namespace_gid", "namespace_mode", "authorized_client_uid",
        "authorized_client_gid", "private_python_source",
        "private_python_source_sha256", "namespace_children",
        "state_fixed_entries", "compiler_version", "sdk_version",
        "sdk_settings_sha256", "source_mode", "zero_entitlements",
    }
    if not isinstance(manifest, dict) or set(manifest) != required:
        raise Rig("identity manifest key mismatch")
    integer_manifest_keys = {
        "schema_version", "installed_uid", "installed_gid", "namespace_uid",
        "namespace_gid", "authorized_client_uid", "authorized_client_gid",
        "installer_size", "embedded_mediator_size",
    }
    if any(type(manifest.get(key)) is not int for key in integer_manifest_keys) \
            or manifest.get("zero_entitlements") is not True:
        raise Rig("identity manifest integer/boolean type mismatch")
    exact = {
        "schema_version": 1,
        "artifact_path": "verify/h039/runtime-cleanup-mediator",
        "artifact_sha256": mediator_digest,
        "source_sha256": sha(source_raw),
        "installer_path": "controller/runtime-cleanup/install",
        "installer_sha256": sha(installer_raw),
        "installer_size": len(installer_raw),
        "embedded_mediator_section": "__H039RO,__h039med",
        "embedded_mediator_sha256": mediator_digest,
        "embedded_mediator_size": mediator_size,
        "bootstrap_installer_path": str(PROTECTED_INSTALLER),
        "bootstrap_operation": "bootstrap",
        "recipe_sha256": sha(recipe_raw),
        "installed_path": str(INSTALLED), "installed_uid": 0, "installed_gid": 0,
        "installed_mode": "04555", "namespace_path": str(NAMESPACE),
        "namespace_uid": 0, "namespace_gid": 0, "namespace_mode": "0555",
        "authorized_client_uid": CLIENT_UID, "authorized_client_gid": CLIENT_GID,
        "private_python_source": (
            "/opt/homebrew/Cellar/python@3.12/3.12.13_4/Frameworks/Python.framework/"
            "Versions/3.12/Resources/Python.app/Contents/MacOS/Python"
        ),
        "private_python_source_sha256": (
            "9ea12d11e0573548d6d8b0added1740b2d6377366081dbca05c19746ce7c616e"
        ),
        "namespace_children": LAYOUT,
        "state_fixed_entries": ["lock"],
        "compiler_version": expected_recipe["compiler_version"],
        "sdk_version": expected_recipe["sdk_version"],
        "sdk_settings_sha256": expected_recipe["sdk_settings_sha256"],
        "source_mode": "100644", "zero_entitlements": True,
    }
    if any(manifest.get(key) != value for key, value in exact.items()):
        raise Rig("identity manifest exact value mismatch")
    for key in (
        "artifact_sha256", "source_sha256", "installer_sha256", "recipe_sha256",
        "embedded_mediator_sha256",
    ):
        if not valid_hex(manifest.get(key)):
            raise Rig(f"manifest digest malformed: {key}")
    if installer_raw.count(mediator_raw) != 1:
        raise Rig("installer does not contain exactly one byte-exact mediator image")
    for key in ("mediator_codesign_cdhash", "installer_codesign_cdhash"):
        if not valid_hex(manifest.get(key), 40):
            raise Rig(f"manifest CDHash malformed: {key}")
    for key in ("mediator_lc_uuid", "installer_lc_uuid"):
        if not isinstance(manifest.get(key), str) or re.fullmatch(
            r"[0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12}", manifest[key],
        ) is None:
            raise Rig(f"manifest UUID malformed: {key}")
    for key in ("mediator_dependencies", "installer_dependencies"):
        dependencies = manifest.get(key)
        if not isinstance(dependencies, list) or not dependencies or any(
            not isinstance(value, str)
            or not value.startswith(("/usr/lib/", "/System/Library/Frameworks/"))
            for value in dependencies
        ):
            raise Rig(f"non-Apple dependency: {key}")
    compiler_path = Path(expected_recipe["compiler_path"])
    sdk_path = Path(expected_recipe["sdk_path"])
    codesign_path = Path(expected_recipe["codesign_path"])
    try:
        observed_compiler = tool(["/usr/bin/xcrun", "--find", "clang"]).decode().strip()
        observed_sdk = Path(
            tool(["/usr/bin/xcrun", "--sdk", "macosx", "--show-sdk-path"])
            .decode().strip()
        ).resolve()
        observed_version = tool([str(compiler_path), "--version"]).decode().splitlines()[0]
    except (OSError, Rig, IndexError) as exc:
        raise Undecidable(f"pinned Apple build toolchain unavailable: {exc}") from exc
    if (
        observed_compiler != str(compiler_path) or observed_sdk != sdk_path
        or observed_version != expected_recipe["compiler_version"]
        or path_sha(compiler_path) != expected_recipe["compiler_sha256"]
        or path_sha(sdk_path / "SDKSettings.json")
        != expected_recipe["sdk_settings_sha256"]
        or path_sha(codesign_path) != expected_recipe["codesign_sha256"]
    ):
        raise Undecidable("pinned Apple build toolchain identity drift")
    return recipe, manifest


def bounded_run(
    argv: list[str], *, cwd: str | Path, env: dict[str, str], timeout: float,
) -> subprocess.CompletedProcess[bytes]:
    process = subprocess.Popen(
        argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, close_fds=True, cwd=cwd, env=env,
        start_new_session=True,
    )
    assert process.stdout is not None and process.stderr is not None
    selector = selectors.DefaultSelector()
    buffers = {process.stdout.fileno(): bytearray(), process.stderr.fileno(): bytearray()}
    streams = {process.stdout.fileno(): process.stdout, process.stderr.fileno(): process.stderr}
    for descriptor in streams:
        os.set_blocking(descriptor, False)
        selector.register(descriptor, selectors.EVENT_READ)
    deadline = time.monotonic() + timeout
    failure: str | None = None
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                failure = "timeout"
                break
            for key, _mask in selector.select(min(0.1, remaining)):
                descriptor = int(key.fd)
                try:
                    chunk = os.read(descriptor, 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(descriptor)
                    continue
                buffers[descriptor].extend(chunk)
                if sum(len(value) for value in buffers.values()) > MAX_CHILD_OUTPUT_BYTES:
                    failure = "output limit"
                    break
            if failure is not None:
                break
        if failure is None:
            remaining = deadline - time.monotonic()
            try:
                returncode = process.wait(timeout=max(0.0, remaining))
            except subprocess.TimeoutExpired:
                failure = "timeout"
        if failure is not None:
            try:
                if os.getpgid(process.pid) != process.pid:
                    raise Rig("candidate child is not its registered process-group leader")
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired as exc:
                raise Rig("candidate process group could not be reaped") from exc
            raise Rig(f"candidate process exceeded {failure}")
        return subprocess.CompletedProcess(
            argv, returncode,
            bytes(buffers[process.stdout.fileno()]),
            bytes(buffers[process.stderr.fileno()]),
        )
    finally:
        selector.close()
        process.stdout.close()
        process.stderr.close()


def seatbelt_profile_selftests() -> None:
    """Causally bind the two deny-default host-runtime profiles."""
    expected_host_files = (
        (SANDBOX_EXEC, SANDBOX_EXEC_SHA256, 0o755, "sandbox-exec"),
        (SEATBELT_WRITE_PROBE, SEATBELT_WRITE_PROBE_SHA256, 0o755, "touch"),
        (SEATBELT_EXEC_DENY_PROBE, SEATBELT_EXEC_DENY_PROBE_SHA256, 0o755, "echo"),
        (SEATBELT_READ_PROBE, SEATBELT_READ_PROBE_SHA256, 0o755, "ls"),
        (SEATBELT_NETWORK_PROBE, SEATBELT_NETWORK_PROBE_SHA256, 0o555, "nc"),
        (BUILD_COMPILER, BUILD_COMPILER_SHA256, 0o755, "clang"),
        (BUILD_CODESIGN, BUILD_CODESIGN_SHA256, 0o755, "codesign"),
        (
            BUILD_SDK / "SDKSettings.json", BUILD_SDK_SETTINGS_SHA256,
            0o644, "SDKSettings.json",
        ),
    )
    for path, digest, mode, label in expected_host_files:
        try:
            value = os.lstat(path)
        except OSError as exc:
            raise Undecidable(f"pinned build-review {label} unavailable") from exc
        if (
            not stat.S_ISREG(value.st_mode) or value.st_uid != 0
            or value.st_gid != 0 or stat.S_IMODE(value.st_mode) != mode
            or value.st_nlink != 1 or path.is_symlink() or path_sha(path) != digest
        ):
            raise Undecidable(f"pinned build-review {label} identity drift")
    check(True, "A_H039_SEATBELT_PROFILE_PINNED_HOST_IDENTITIES")

    temporary = Path(tempfile.mkdtemp(prefix="h039-seatbelt-selftest-", dir="/private/tmp"))
    project = temporary / "project"
    project.mkdir(mode=0o700)
    installer_test_root = temporary / "installer-review-root"
    installer_test_root.mkdir(mode=0o700)
    installer_enumeration = installer_test_root / "enumeration"
    installer_enumeration.mkdir(mode=0o700)
    (installer_enumeration / "alpha").write_bytes(b"H039-ALPHA\n")
    (installer_enumeration / "beta").write_bytes(b"H039-BETA\n")
    installer_outside = temporary / "outside-review-root"
    installer_outside.mkdir(mode=0o700)
    installer_outside_secret = installer_outside / "outside-secret"
    installer_outside_secret.write_bytes(b"H039-OUTSIDE-SECRET\n")
    installer_fixture = temporary / "mediator-fixture"
    installer_fixture.write_bytes(b"H039-INSTALLER-MEDIATOR-FIXTURE\n")
    installer_fixture.chmod(0o600)
    listener: socket.socket | None = None

    def no_sigabrt(result: subprocess.CompletedProcess[bytes]) -> bool:
        return result.returncode not in {-signal.SIGABRT, 128 + signal.SIGABRT}

    def nested_refusal(result: subprocess.CompletedProcess[bytes], label: str) -> None:
        if result.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in result.stderr:
            raise Undecidable(f"outer Seatbelt denied nested {label} sandbox")

    def build_argv(executable: Path, arguments: list[str]) -> list[str]:
        return [
            str(SANDBOX_EXEC),
            "-D", f"H039_BUILD_EXECUTABLE={executable}",
            "-D", f"H039_BUILD_ROOT={project}",
            "-p", BUILD_REVIEW_PROFILE,
            *arguments,
        ]

    def installer_argv(executable: Path, arguments: list[str]) -> list[str]:
        return [
            str(SANDBOX_EXEC),
            "-D", f"H039_EXECUTABLE={executable}",
            "-D", f"H039_MEDIATOR={installer_fixture}",
            "-D", f"H039_TEST_ROOT={installer_test_root}",
            "-p", INSTALLER_REVIEW_PROFILE,
            *arguments,
        ]

    environment = {
        "HOME": "/var/empty", "TMPDIR": str(project),
        "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin",
    }
    try:
        inside = project / "inside-write"
        inside_result = bounded_run(
            build_argv(
                SEATBELT_WRITE_PROBE,
                [str(SEATBELT_WRITE_PROBE), str(inside)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(inside_result, "build-review")
        inside_value = os.lstat(inside) if inside.exists() else None
        check(
            no_sigabrt(inside_result) and inside_result.returncode == 0
            and inside_result.stdout == b"" and inside_result.stderr == b""
            and inside_value is not None and stat.S_ISREG(inside_value.st_mode)
            and inside_value.st_uid == os.getuid()
            and inside_value.st_nlink == 1 and inside_value.st_size == 0,
            "A_H039_BUILD_SEATBELT_INSIDE_WRITE_SUCCEEDS",
            {
                "rc": inside_result.returncode,
                "stdout": inside_result.stdout.decode("utf-8", "replace"),
                "stderr": inside_result.stderr.decode("utf-8", "replace"),
            },
        )

        outside = temporary / "outside-write"
        outside_result = bounded_run(
            build_argv(
                SEATBELT_WRITE_PROBE,
                [str(SEATBELT_WRITE_PROBE), str(outside)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(outside_result, "build-review")
        check(
            no_sigabrt(outside_result) and outside_result.returncode == 1
            and outside_result.stdout == b""
            and b"Operation not permitted" in outside_result.stderr
            and not outside.exists() and not outside.is_symlink(),
            "N_H039_BUILD_SEATBELT_OUTSIDE_WRITE_DENIED",
            {
                "rc": outside_result.returncode,
                "stdout": outside_result.stdout.decode("utf-8", "replace"),
                "stderr": outside_result.stderr.decode("utf-8", "replace"),
            },
        )

        wrong_exec_result = bounded_run(
            build_argv(
                SEATBELT_WRITE_PROBE,
                [str(SEATBELT_EXEC_DENY_PROBE), "H039-FORBIDDEN-EXEC"],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(wrong_exec_result, "build-review")
        check(
            no_sigabrt(wrong_exec_result) and wrong_exec_result.returncode == 71
            and wrong_exec_result.stdout == b""
            and b"Operation not permitted" in wrong_exec_result.stderr,
            "N_H039_BUILD_SEATBELT_ARBITRARY_EXEC_DENIED",
            {
                "rc": wrong_exec_result.returncode,
                "stdout": wrong_exec_result.stdout.decode("utf-8", "replace"),
                "stderr": wrong_exec_result.stderr.decode("utf-8", "replace"),
            },
        )

        listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            listener.bind(("127.0.0.1", 0))
            listener.listen(1)
            listener.setblocking(False)
        except OSError as exc:
            if exc.errno in {errno.EPERM, errno.EACCES}:
                raise Undecidable("outer sandbox denied build-review network canary") from exc
            raise
        port = listener.getsockname()[1]
        network_result = bounded_run(
            build_argv(
                SEATBELT_NETWORK_PROBE,
                [str(SEATBELT_NETWORK_PROBE), "-z", "-w", "1", "127.0.0.1", str(port)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(network_result, "build-review")
        connected = False
        try:
            connection, _address = listener.accept()
        except BlockingIOError:
            pass
        else:
            connected = True
            connection.close()
        check(
            no_sigabrt(network_result) and network_result.returncode == 1
            and network_result.stdout == b"" and network_result.stderr == b""
            and not connected and "(allow network" not in BUILD_REVIEW_PROFILE,
            "N_H039_BUILD_SEATBELT_NETWORK_DENIED",
            {
                "rc": network_result.returncode,
                "stdout": network_result.stdout.decode("utf-8", "replace"),
                "stderr": network_result.stderr.decode("utf-8", "replace"),
                "connected": connected,
            },
        )
        listener.close()
        listener = None

        source = project / "profile-probe.c"
        binary = project / "profile-probe"
        source.write_bytes(b"int main(void) { return 0; }\n")
        compile_argv = [
            str(BUILD_COMPILER), "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
            "-fstack-protector-strong", "-D_FORTIFY_SOURCE=2", "-arch", "arm64",
            "-isysroot", str(BUILD_SDK), "-mmacosx-version-min=15.0", "-Wl,-pie",
            "-Wl,-dead_strip", source.name, "-o", binary.name,
        ]
        compile_result = bounded_run(
            build_argv(BUILD_COMPILER, compile_argv),
            cwd=project, env=environment, timeout=60,
        )
        nested_refusal(compile_result, "build-review")
        binary_before_sign = os.lstat(binary) if binary.exists() else None
        check(
            no_sigabrt(compile_result) and compile_result.returncode == 0
            and compile_result.stdout == b"" and compile_result.stderr == b""
            and binary_before_sign is not None
            and stat.S_ISREG(binary_before_sign.st_mode)
            and binary_before_sign.st_uid == os.getuid()
            and binary_before_sign.st_nlink == 1
            and binary_before_sign.st_size > 0,
            "A_H039_BUILD_SEATBELT_EXACT_CLANG_COMPILE",
            {
                "rc": compile_result.returncode,
                "stdout": compile_result.stdout.decode("utf-8", "replace"),
                "stderr": compile_result.stderr.decode("utf-8", "replace"),
            },
        )

        sign_argv = [
            str(BUILD_CODESIGN), "--force", "--options", "runtime", "--sign", "-",
            "--identifier", "se.nortropic.runtime-cleanup-profile-probe",
            "--timestamp=none", binary.name,
        ]
        sign_result = bounded_run(
            build_argv(BUILD_CODESIGN, sign_argv),
            cwd=project, env=environment, timeout=60,
        )
        nested_refusal(sign_result, "build-review")
        verify_argv = [str(BUILD_CODESIGN), "--verify", "--strict", binary.name]
        verify_result = bounded_run(
            build_argv(BUILD_CODESIGN, verify_argv),
            cwd=project, env=environment, timeout=60,
        )
        nested_refusal(verify_result, "build-review")
        check(
            no_sigabrt(sign_result) and no_sigabrt(verify_result)
            and sign_result.returncode == 0 and verify_result.returncode == 0
            and verify_result.stdout == b"" and verify_result.stderr == b""
            and binary.exists() and stat.S_ISREG(os.lstat(binary).st_mode)
            and os.lstat(binary).st_nlink == 1,
            "A_H039_BUILD_SEATBELT_EXACT_CODESIGN_SIGN_AND_VERIFY",
            {
                "sign_rc": sign_result.returncode,
                "sign_stdout": sign_result.stdout.decode("utf-8", "replace"),
                "sign_stderr": sign_result.stderr.decode("utf-8", "replace"),
                "verify_rc": verify_result.returncode,
                "verify_stdout": verify_result.stdout.decode("utf-8", "replace"),
                "verify_stderr": verify_result.stderr.decode("utf-8", "replace"),
            },
        )

        installer_started = bounded_run(
            installer_argv(
                SEATBELT_EXEC_DENY_PROBE,
                [str(SEATBELT_EXEC_DENY_PROBE), "H039-INSTALLER-PROFILE-STARTED"],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_started, "installer-review")
        check(
            no_sigabrt(installer_started) and installer_started.returncode == 0
            and installer_started.stdout == b"H039-INSTALLER-PROFILE-STARTED\n"
            and installer_started.stderr == b"",
            "A_H039_INSTALLER_SEATBELT_EXACT_EXEC_STARTS",
            {
                "rc": installer_started.returncode,
                "stdout": installer_started.stdout.decode("utf-8", "replace"),
                "stderr": installer_started.stderr.decode("utf-8", "replace"),
            },
        )

        installer_inside_read = bounded_run(
            installer_argv(
                SEATBELT_READ_PROBE,
                [str(SEATBELT_READ_PROBE), "-1", str(installer_enumeration)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_inside_read, "installer-review")
        check(
            no_sigabrt(installer_inside_read)
            and installer_inside_read.returncode == 0
            and installer_inside_read.stdout == b"alpha\nbeta\n"
            and installer_inside_read.stderr == b"",
            "A_H039_INSTALLER_SEATBELT_PRIVATE_ROOT_ENUMERATION",
            {
                "rc": installer_inside_read.returncode,
                "stdout": installer_inside_read.stdout.decode("utf-8", "replace"),
                "stderr": installer_inside_read.stderr.decode("utf-8", "replace"),
            },
        )

        installer_outside_read = bounded_run(
            installer_argv(
                SEATBELT_READ_PROBE,
                [str(SEATBELT_READ_PROBE), "-1", str(installer_outside)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_outside_read, "installer-review")
        check(
            no_sigabrt(installer_outside_read)
            and installer_outside_read.returncode == 1
            and installer_outside_read.stdout == b""
            and b"Operation not permitted" in installer_outside_read.stderr
            and installer_outside_secret.read_bytes() == b"H039-OUTSIDE-SECRET\n",
            "N_H039_INSTALLER_SEATBELT_OUTSIDE_ROOT_READ_DENIED",
            {
                "rc": installer_outside_read.returncode,
                "stdout": installer_outside_read.stdout.decode("utf-8", "replace"),
                "stderr": installer_outside_read.stderr.decode("utf-8", "replace"),
            },
        )

        installer_write = temporary / "installer-write"
        installer_write_result = bounded_run(
            installer_argv(
                SEATBELT_WRITE_PROBE,
                [str(SEATBELT_WRITE_PROBE), str(installer_write)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_write_result, "installer-review")
        check(
            no_sigabrt(installer_write_result)
            and installer_write_result.returncode == 1
            and installer_write_result.stdout == b""
            and b"Operation not permitted" in installer_write_result.stderr
            and not installer_write.exists() and not installer_write.is_symlink(),
            "N_H039_INSTALLER_SEATBELT_WRITE_DENIED",
            {
                "rc": installer_write_result.returncode,
                "stdout": installer_write_result.stdout.decode("utf-8", "replace"),
                "stderr": installer_write_result.stderr.decode("utf-8", "replace"),
            },
        )

        installer_wrong_exec = bounded_run(
            installer_argv(
                SEATBELT_EXEC_DENY_PROBE,
                [str(SEATBELT_WRITE_PROBE), str(installer_write)],
            ),
            cwd="/", env=environment, timeout=10,
        )
        nested_refusal(installer_wrong_exec, "installer-review")
        check(
            no_sigabrt(installer_wrong_exec)
            and installer_wrong_exec.returncode == 71
            and installer_wrong_exec.stdout == b""
            and b"Operation not permitted" in installer_wrong_exec.stderr
            and not installer_write.exists() and not installer_write.is_symlink(),
            "N_H039_INSTALLER_SEATBELT_ALTERNATE_EXEC_DENIED",
            {
                "rc": installer_wrong_exec.returncode,
                "stdout": installer_wrong_exec.stdout.decode("utf-8", "replace"),
                "stderr": installer_wrong_exec.stderr.decode("utf-8", "replace"),
            },
        )
    finally:
        if listener is not None:
            listener.close()
        shutil.rmtree(temporary)


def tool(argv: list[str]) -> bytes:
    result = bounded_run(
        argv, cwd="/", env={"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
        timeout=20,
    )
    if result.returncode != 0:
        raise Rig(f"tool failed {argv!r}: {result.stderr!r}")
    return result.stdout + result.stderr


def parse_vtool_build(build: str) -> tuple[str, str, str]:
    matches = [
        re.search(r"^ *platform +(\S+)$", build, re.MULTILINE),
        re.search(r"^ *minos +(\S+)$", build, re.MULTILINE),
        re.search(r"^ *sdk +(\S+)$", build, re.MULTILINE),
    ]
    if not all(matches):
        raise Rig("incomplete Mach-O build-version identity")
    return tuple(match.group(1) for match in matches if match is not None)


def macho_identity(path: Path, identifier: str) -> dict[str, Any]:
    file_text = tool(["/usr/bin/file", "-b", str(path)]).decode("utf-8", "replace")
    if "Mach-O 64-bit executable arm64" not in file_text:
        raise Rig(f"not exact arm64 Mach-O: {path}")
    codesign = tool(["/usr/bin/codesign", "-d", "--verbose=4", str(path)]).decode()
    if (
        f"Identifier={identifier}" not in codesign
        or "Signature=adhoc" not in codesign
        or re.search(r"flags=0x[0-9a-f]+\([^\n)]*runtime[^\n)]*\)", codesign) is None
        or "TeamIdentifier=not set" not in codesign
        or "Timestamp=" in codesign
    ):
        raise Rig("Mach-O signing/hardened-runtime identity mismatch")
    entitlement_text = tool(
        ["/usr/bin/codesign", "-d", "--entitlements", ":-", str(path)],
    ).decode("utf-8", "replace")
    if "<?xml" in entitlement_text or "<plist" in entitlement_text:
        raise Rig("Mach-O carries forbidden entitlements")
    match_cd = re.search(r"^CDHash=([0-9a-f]{40})$", codesign, re.MULTILINE)
    uuid_text = tool(["/usr/bin/dwarfdump", "--uuid", str(path)]).decode()
    match_uuid = re.search(
        r"UUID: ([0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12}) \(arm64\)",
        uuid_text,
    )
    headers = tool(["/usr/bin/otool", "-hv", str(path)]).decode()
    if "PIE" not in headers:
        raise Rig("Mach-O is not PIE")
    load_commands = tool(["/usr/bin/otool", "-l", str(path)]).decode()
    if "LC_RPATH" in load_commands:
        raise Rig("Mach-O contains forbidden LC_RPATH")
    if "@rpath" in load_commands or "@loader_path" in load_commands:
        raise Rig("Mach-O contains forbidden dynamic-loader path")
    load = tool(["/usr/bin/otool", "-L", str(path)]).decode().splitlines()[1:]
    dependencies = sorted(line.strip().split(" ", 1)[0] for line in load if line.strip())
    if not dependencies or any(
        not (item.startswith("/usr/lib/") or item.startswith("/System/Library/Frameworks/"))
        for item in dependencies
    ):
        raise Rig("Mach-O has non-Apple dependency")
    build = tool(["/usr/bin/vtool", "-show-build", str(path)]).decode()
    platform, minos, sdk = parse_vtool_build(build)
    undefined_symbols = sorted({
        line.strip() for line in
        tool(["/usr/bin/nm", "-u", str(path)]).decode().splitlines()
        if line.strip()
    })
    if not all((match_cd, match_uuid)):
        raise Rig("incomplete Mach-O identity")
    return {
        "cdhash": match_cd.group(1), "uuid": match_uuid.group(1),
        "dependencies": dependencies, "platform": platform,
        "minos": minos, "sdk": sdk, "undefined_symbols": undefined_symbols,
    }


def macho_checks(
    manifest: dict[str, Any], commit: str | None = None, *,
    diagnostic_product: bool = False,
) -> None:
    temporary = Path(tempfile.mkdtemp(prefix="h039-macho-", dir="/private/tmp"))
    try:
        identities: dict[str, dict[str, Any]] = {}
        for name, product_path in (
            ("mediator", "verify/h039/runtime-cleanup-mediator"),
            ("installer", "controller/runtime-cleanup/install"),
        ):
            target = temporary / name
            target.write_bytes(product_bytes(product_path, commit))
            target.chmod(0o755)
            identities[name] = macho_identity(
                target, f"se.nortropic.runtime-cleanup-{name}",
            )
        for name in ("mediator", "installer"):
            actual = identities[name]
            if actual["cdhash"] != manifest[f"{name}_codesign_cdhash"] \
                    or actual["uuid"] != manifest[f"{name}_lc_uuid"] \
                    or actual["dependencies"] != manifest[f"{name}_dependencies"]:
                raise Rig(f"{name} Mach-O manifest drift")
        installer_allowed_symbols = {
            "__NSGetExecutablePath", "___chkstk_darwin", "___error",
            "___stack_chk_fail", "___stack_chk_guard", "___strcpy_chk",
            "_bzero", "_chdir", "_close", "_closedir",
            "_dup", "_environ", "_fchmod", "_fchown", "_fcntl", "_fdopendir",
            "_free", "_fstat", "_fstatat", "_fsync", "_getegid",
            "_geteuid", "_getgid", "_getpid", "_getsectiondata",
            "_getuid", "_lstat", "_malloc", "_memcmp", "_memcpy",
            "_mkdirat", "_open", "_openat", "_pread", "_proc_pidinfo",
            "_readdir", "_renameatx_np", "_snprintf", "_strcmp",
            "_strlen", "_strrchr", "_strstr", "_umask", "_unlinkat",
            "_write",
        }
        installer_required_symbols = {
            "_chdir", "_close", "_environ", "_free", "_getegid", "_geteuid",
            "_fcntl", "_getgid", "_getpid", "_getsectiondata", "_getuid",
            "_malloc", "_proc_pidinfo", "_renameatx_np", "_umask",
        }
        installer_symbols = set(identities["installer"]["undefined_symbols"])
        if diagnostic_product:
            if installer_symbols != R14_DIAGNOSTIC_UNDEFINED_SYMBOLS:
                raise Rig(
                    "diagnostic installer imports are not the exact frozen set"
                )
        elif not installer_required_symbols <= installer_symbols \
                or not installer_symbols <= installer_allowed_symbols:
            raise Rig("installer imported symbol authority is not exact closed bootstrap set")
        installer_path = temporary / "installer"
        installer_load = tool(["/usr/bin/otool", "-l", str(installer_path)]).decode()
        section_matches = re.findall(
            r"sectname __h039med\n\s+segname __H039RO\n"
            r"\s+addr 0x[0-9a-f]+\n\s+size (0x[0-9a-f]+)\n"
            r"\s+offset ([0-9]+)",
            installer_load,
        )
        read_only_segments = re.findall(
            r"cmd LC_SEGMENT_64\n\s+cmdsize [0-9]+\n\s+segname __H039RO\n"
            r"[\s\S]*?\n\s+maxprot (0x[0-9a-f]+)\n"
            r"\s+initprot (0x[0-9a-f]+)",
            installer_load,
        )
        installer_raw = installer_path.read_bytes()
        section_ok = False
        if len(section_matches) == 1:
            size_raw, offset_raw = section_matches[0]
            section_size = int(size_raw, 16)
            section_offset = int(offset_raw, 10)
            section_ok = (
                section_size == manifest["embedded_mediator_size"]
                and 0 <= section_offset <= len(installer_raw) - section_size
                and sha(installer_raw[section_offset:section_offset + section_size])
                == manifest["embedded_mediator_sha256"]
                and installer_raw[section_offset:section_offset + section_size]
                == product_bytes("verify/h039/runtime-cleanup-mediator", commit)
            )
        if (
            manifest.get("embedded_mediator_section") != "__H039RO,__h039med"
            or not section_ok or read_only_segments != [("0x00000001", "0x00000001")]
        ):
            raise Rig("installer embedded mediator section bytes or read-only mapping mismatch")
        if any(
            identities[name][field] != manifest[field]
            for name in ("mediator", "installer")
            for field in ("platform", "minos", "sdk")
        ):
            raise Rig("Mach-O platform/minos/sdk drift")
    finally:
        shutil.rmtree(temporary)


def reproducible_rebuild(recipe: dict[str, Any], commit: str | None = None) -> None:
    temporary = Path(tempfile.mkdtemp(prefix="h039-rebuild-", dir="/private/tmp"))
    project = temporary / "project"
    project.mkdir(mode=0o700)
    try:
        for directory in (
            "controller/runtime-cleanup/native", "verify/h039",
        ):
            (project / directory).mkdir(parents=True, exist_ok=True)
        (project / "controller/runtime-cleanup/native/mediator.c").write_bytes(
            product_bytes("controller/runtime-cleanup/native/mediator.c", commit)
        )
        for path, digest, label in (
            (SANDBOX_EXEC, SANDBOX_EXEC_SHA256, "sandbox-exec"),
            (SEATBELT_WRITE_PROBE, SEATBELT_WRITE_PROBE_SHA256, "touch"),
        ):
            value = os.lstat(path)
            if (
                not stat.S_ISREG(value.st_mode) or value.st_uid != 0
                or value.st_gid != 0 or stat.S_IMODE(value.st_mode) != 0o755
                or value.st_nlink != 1 or path.is_symlink() or path_sha(path) != digest
            ):
                raise Undecidable(f"pinned build-review {label} identity drift")

        def build_argv(executable: str, arguments: list[str]) -> list[str]:
            return [
                str(SANDBOX_EXEC),
                "-D", f"H039_BUILD_EXECUTABLE={executable}",
                "-D", f"H039_BUILD_ROOT={project}",
                "-p", BUILD_REVIEW_PROFILE,
                *arguments,
            ]

        outside = temporary / "seatbelt-write-canary"
        probe = bounded_run(
            build_argv(str(SEATBELT_WRITE_PROBE), [str(SEATBELT_WRITE_PROBE), str(outside)]),
            cwd="/", env={"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
            timeout=10,
        )
        if probe.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in probe.stderr:
            raise Undecidable("outer Seatbelt denied nested build-review sandbox")
        if probe.returncode == 0 or outside.exists() or outside.is_symlink() \
                or b"Operation not permitted" not in probe.stderr:
            raise Rig("build-review deny-default Seatbelt boundary was not effective")
        for key in (
            "mediator_compile_argv", "mediator_sign_argv",
            "installer_compile_argv", "installer_sign_argv",
        ):
            result = bounded_run(
                build_argv(recipe[key][0], recipe[key]), cwd=project,
                env={
                    "HOME": "/var/empty", "TMPDIR": str(project),
                    "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin",
                },
                timeout=60,
            )
            if result.returncode == 71 \
                    and b"sandbox_apply: Operation not permitted" in result.stderr:
                raise Undecidable("outer Seatbelt denied nested build-review sandbox")
            if result.returncode != 0:
                raise Rig(f"rebuild {key} failed: {result.stderr!r}")
            if key == "mediator_sign_argv" and sha(
                (project / "verify/h039/runtime-cleanup-mediator").read_bytes()
            ) != sha(product_bytes("verify/h039/runtime-cleanup-mediator", commit)):
                raise Rig("reproducible mediator mismatch before installer build")
        for product_path in (
            "verify/h039/runtime-cleanup-mediator",
            "controller/runtime-cleanup/install",
        ):
            if (project / product_path).read_bytes() != product_bytes(product_path, commit):
                raise Rig(f"reproducible product mismatch: {product_path}")
    finally:
        shutil.rmtree(temporary)


def r14_ir_control_flow_valid(ir: bytes, *, exact_image: bool) -> bool:
    if exact_image and (
        len(ir) != R16_DIAGNOSTIC_IR_SIZE or sha(ir) != R16_DIAGNOSTIC_IR_SHA256
    ):
        return False
    try:
        ir_text = ir.decode("utf-8")
    except UnicodeError:
        return False
    bootstrap_match = re.search(
        r"define range\(i32 0, 126\) i32 @installer_bootstrap\(i32[^\n]*\) #[0-9]+ \{"
        r"([\s\S]*?)\n\}", ir_text,
    )
    main_match = re.search(
        r"define range\(i32 0, 126\) i32 @main\(i32[^\n]*\) #[0-9]+ \{"
        r"([\s\S]*?)\n\}", ir_text,
    )
    if bootstrap_match is None or main_match is None:
        return False
    bootstrap = bootstrap_match.group(1)
    main = main_match.group(1)
    bootstrap_codes = {
        int(value) for value in re.findall(
            r"\[\s*(-?[0-9]+),\s*%[0-9]+\s*\]", bootstrap
        )
    }
    main_codes = {
        int(value) for value in re.findall(
            r"\[\s*(-?[0-9]+),\s*%[0-9]+\s*\]", main
        )
    }
    exact_call = (
        "tail call i32 @installer_bootstrap(i32 noundef 2, "
        "ptr noundef nonnull readonly %1)"
    )
    return (
        set(range(6, 126)).issubset(bootstrap_codes)
        and set(range(1, 6)).issubset(main_codes)
        and ir_text.count("call i32 @installer_bootstrap(") == 1
        and exact_call in main
        and "call i32 %" not in main
        and "select i1" in bootstrap
        and "i32 0, i32 125" in bootstrap
        and "ret i32" in bootstrap and "ret i32" in main
        and "i32 126" not in bootstrap
    )


def r14_ir_control_flow_selftests(ir: bytes) -> None:
    check(r14_ir_control_flow_valid(ir, exact_image=True),
          "A_H039_R14_R4_EXACT_OWNING_CFG_AND_SOLE_DOMINATING_CALL")
    mutants = {
        "LOCAL18_REMOVED": ir.replace(b"[ 18, %90 ],", b"[ 17, %90 ],", 1),
        "LOCAL19_REMOVED": ir.replace(b"[ 19, %91 ],", b"[ 17, %91 ],", 1),
        "LOCAL28_REMOVED": ir.replace(b"[ 28, %126 ],", b"[ 27, %126 ],", 1),
        "LOCAL29_REMOVED": ir.replace(b"[ 29, %128 ],", b"[ 27, %128 ],", 1),
        "LOCAL62_REMOVED": ir.replace(b"[ 62, %241 ]", b"[ 61, %241 ]", 1),
        "KNOWN_ARGC_RELOADED": ir.replace(b"i32 noundef 2, ptr noundef nonnull readonly %1", b"i32 noundef %0, ptr noundef nonnull readonly %1", 1),
        "ARG_CHANGED": ir.replace(b"ptr noundef nonnull readonly %1)", b"ptr noundef nonnull readonly %7)", 1),
        "INDIRECT_CALL": ir.replace(b"call i32 @installer_bootstrap(", b"call i32 %17(", 1),
        "ADDED_CALLER": ir + b"\ndefine i32 @decoy(){ %1 = call i32 @installer_bootstrap(i32 2, ptr null)\n ret i32 %1\n}\n",
    }
    for label, mutant in mutants.items():
        if mutant == ir:
            raise Rig(f"R14-R4 IR selftest mutant was inert: {label}")
        check(not r14_ir_control_flow_valid(mutant, exact_image=False),
              f"N_H039_R14_R4_IR_{label}")


def r16_ir_polarity_valid(ir: bytes, *, exact_image: bool) -> bool:
    if exact_image and (
        len(ir) != R16_DIAGNOSTIC_IR_SIZE
        or sha(ir) != R16_DIAGNOSTIC_IR_SHA256
    ):
        return False
    try:
        text = ir.decode("utf-8")
    except UnicodeError:
        return False
    function = re.search(
        r"define range\(i32 0, 126\) i32 @installer_bootstrap\(i32[^\n]*\) #[0-9]+ \{"
        r"([\s\S]*?)\n\}",
        text,
    )
    if function is None:
        return False
    body = function.group(1)
    sites: dict[int, tuple[int, int]] = {}
    for phi in re.finditer(
        r"(?m)^(?P<merge>[0-9]+):[^\n]*\n\s+%[0-9]+ = phi i32 (?P<pairs>[^\n]+)",
        body,
    ):
        merge = int(phi.group("merge"))
        for status, predecessor in re.findall(
            r"\[\s*([0-9]+),\s*%([0-9]+)\s*\]", phi.group("pairs"),
        ):
            code = int(status)
            if code in (86, 99):
                if code in sites:
                    return False
                sites[code] = (int(predecessor), merge)
    if set(sites) != {86, 99}:
        return False
    success_blocks: dict[int, int] = {}
    for code, (predecessor, merge) in sites.items():
        block = re.search(
            rf"(?m)^{predecessor}:[^\n]*\n(?P<body>[\s\S]*?)(?=^[0-9]+:)",
            body,
        )
        if block is None:
            return False
        edge = re.fullmatch(
            r"\s*%(?P<call>[0-9]+) = call i32 @\"\\01_fsync\"\([^\n]+\) #[0-9]+\n"
            r"\s*%(?P<cmp>[0-9]+) = icmp eq i32 %(?P=call), 0\n"
            r"\s*br i1 %(?P=cmp), label %(?P<success>[0-9]+), label %(?P<failure>[0-9]+)\s*",
            block.group("body"),
        )
        if edge is None or int(edge.group("failure")) != merge:
            return False
        success = int(edge.group("success"))
        if success == merge or success <= predecessor:
            return False
        success_blocks[code] = success
    return sites[86][0] < success_blocks[86] < sites[99][0] < success_blocks[99]


def r16_ir_polarity_selftests(ir: bytes) -> None:
    check(
        r16_ir_polarity_valid(ir, exact_image=True),
        "A_H039_R16_O2_FSYNC_SUCCESS_CONTINUES_FAILURE_RETURNS_86_99",
    )
    mutants = {
        "STATUS86_EDGE_INVERTED": ir.replace(
            b"br i1 %350, label %351, label %598",
            b"br i1 %350, label %598, label %351", 1,
        ),
        "STATUS99_EDGE_INVERTED": ir.replace(
            b"br i1 %419, label %420, label %590",
            b"br i1 %419, label %590, label %420", 1,
        ),
        "STATUS86_PHI_CHANGED": ir.replace(
            b"[ 86, %348 ]", b"[ 87, %348 ]", 1,
        ),
        "STATUS99_PHI_CHANGED": ir.replace(
            b"[ 99, %417 ]", b"[ 100, %417 ]", 1,
        ),
    }
    for label, mutant in mutants.items():
        if mutant == ir:
            raise Rig(f"noncausal R16 IR polarity mutant: {label}")
        check(
            not r16_ir_polarity_valid(mutant, exact_image=False),
            f"N_H039_R16_IR_POLARITY_{label}",
        )


def r14_reference_rebuild() -> None:
    """Compile the sole R10 source before freeze; no product bytes are adopted."""
    temporary = Path(tempfile.mkdtemp(prefix="h039-r14-reference-", dir="/private/tmp"))
    project = temporary / "project"
    source_path = project / "controller/runtime-cleanup/native/mediator.c"
    mediator_path = project / "verify/h039/runtime-cleanup-mediator"
    output_path = project / "controller/runtime-cleanup/install"
    ir_path = project / "verify/h039/r14-diagnostic.ll"
    try:
        source_path.parent.mkdir(parents=True)
        mediator_path.parent.mkdir(parents=True)
        source = r16_expected_diagnostic_source()
        r14_diagnostic_source_checks(source)
        source_path.write_bytes(source)
        mediator = blob(
            PUBLISHED_H039_R9_PRODUCT_MERGE,
            "verify/h039/runtime-cleanup-mediator",
        )
        mediator_path.write_bytes(mediator)
        compiler = "/Library/Developer/CommandLineTools/usr/bin/clang"
        sdk = "/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk"
        compile_argv = [
            compiler, "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
            "-fstack-protector-strong", "-D_FORTIFY_SOURCE=2", "-arch", "arm64",
            "-isysroot", sdk, "-mmacosx-version-min=15.0", "-Wl,-pie",
            "-Wl,-dead_strip", "-Wno-unused-function", "-DH039_INSTALLER=1",
            "-DH039_ROOT_ENTRY_FD0_NORMALIZATION=1",
            "-DH039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC=1",
            f"-DH039_MEDIATOR_SHA256={sha(mediator)}",
            f"-DH039_MEDIATOR_SIZE={len(mediator)}",
            "-Wl,-segprot,__H039RO,r,r",
            "-Wl,-sectcreate,__H039RO,__h039med,verify/h039/runtime-cleanup-mediator",
            "controller/runtime-cleanup/native/mediator.c", "-o",
            "controller/runtime-cleanup/install",
        ]
        result = bounded_run(
            [
                str(SANDBOX_EXEC), "-D", f"H039_BUILD_EXECUTABLE={compiler}",
                "-D", f"H039_BUILD_ROOT={project}", "-p", BUILD_REVIEW_PROFILE,
                *compile_argv,
            ],
            cwd=project,
            env={
                "HOME": "/var/empty", "TMPDIR": str(project), "LANG": "C",
                "LC_ALL": "C", "PATH": "/usr/bin:/bin",
            },
            timeout=60,
        )
        if result.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in result.stderr:
            raise Undecidable("outer Seatbelt denied R14 reference build sandbox")
        if result.returncode != 0 or result.stdout or result.stderr:
            raise Rig(
                "sole R14 diagnostic reference does not compile exactly: "
                f"rc={result.returncode} stdout={result.stdout!r} stderr={result.stderr!r}"
            )
        value = os.lstat(output_path)
        if (
            not stat.S_ISREG(value.st_mode) or value.st_nlink != 1
            or value.st_size <= 0
            or value.st_size > PRODUCT_BYTE_LIMITS["controller/runtime-cleanup/install"]
        ):
            raise Rig("R14 reference build output identity or size rejected")
        symbols = {
            line.strip() for line in
            tool(["/usr/bin/nm", "-u", str(output_path)]).decode().splitlines()
            if line.strip()
        }
        if symbols != R14_DIAGNOSTIC_UNDEFINED_SYMBOLS:
            raise Rig("R16 reference build undefined-import set drift")
        ir_argv = [
            compiler, "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
            "-fstack-protector-strong", "-D_FORTIFY_SOURCE=2", "-arch", "arm64",
            "-isysroot", sdk, "-mmacosx-version-min=15.0", "-Wno-unused-function",
            "-DH039_INSTALLER=1", "-DH039_ROOT_ENTRY_FD0_NORMALIZATION=1",
            "-DH039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC=1",
            f"-DH039_MEDIATOR_SHA256={sha(mediator)}",
            f"-DH039_MEDIATOR_SIZE={len(mediator)}", "-S", "-emit-llvm",
            "controller/runtime-cleanup/native/mediator.c", "-o",
            "verify/h039/r14-diagnostic.ll",
        ]
        ir_result = bounded_run(
            [
                str(SANDBOX_EXEC), "-D", f"H039_BUILD_EXECUTABLE={compiler}",
                "-D", f"H039_BUILD_ROOT={project}", "-p", BUILD_REVIEW_PROFILE,
                *ir_argv,
            ], cwd=project,
            env={
                "HOME": "/var/empty", "TMPDIR": str(project), "LANG": "C",
                "LC_ALL": "C", "PATH": "/usr/bin:/bin",
            }, timeout=60,
        )
        if ir_result.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in ir_result.stderr:
            raise Undecidable("outer Seatbelt denied R16 IR reference build sandbox")
        if ir_result.returncode != 0 or ir_result.stdout or ir_result.stderr:
            raise Rig("exact optimized LLVM IR build failed or emitted output")
        ir = ir_path.read_bytes()
        if (
            len(ir) != R16_DIAGNOSTIC_IR_SIZE
            or sha(ir) != R16_DIAGNOSTIC_IR_SHA256
            or not r14_ir_control_flow_valid(ir, exact_image=False)
            or not r16_ir_polarity_valid(ir, exact_image=True)
        ):
            raise Rig(
                "optimized diagnostic IR is not the frozen exact control-flow image: "
                f"size={len(ir)} sha256={sha(ir)}"
            )
        r14_ir_control_flow_selftests(ir)
        r16_ir_polarity_selftests(ir)
    finally:
        shutil.rmtree(temporary)


def installer_verify_effects(
    commit: str, *, diagnostic_product: bool = False,
    retained_partial_state: bool = False,
) -> None:
    temporary = Path(tempfile.mkdtemp(prefix="h039-installer-", dir="/private/tmp"))
    temporary_fd = os.open(
        temporary, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    temporary_identity = retained_directory_identity(os.fstat(temporary_fd))
    installer = temporary / "controller/runtime-cleanup/install"
    mediator = temporary / "verify/h039/runtime-cleanup-mediator"
    installer.parent.mkdir(parents=True)
    mediator.parent.mkdir(parents=True)
    installer.write_bytes(product_bytes("controller/runtime-cleanup/install", commit))
    mediator.write_bytes(product_bytes("verify/h039/runtime-cleanup-mediator", commit))
    installer.chmod(0o755)
    mediator.chmod(0o555)
    before_install = INSTALLED.exists() or INSTALLED.is_symlink()
    installed_before: tuple[int, ...] | None = None
    installed_digest_before: str | None = None
    try:
        namespace_before = stable_identity(os.lstat(NAMESPACE))
    except OSError as exc:
        raise Rig("product review requires the preserved PRE_EFFECTS namespace") from exc
    if before_install and not retained_partial_state:
        raise Rig("retained-product review requires the installed helper absent")
    if retained_partial_state:
        if not before_install:
            raise Rig("R19 review requires the exact installed partial-state helper")
        try:
            installed_value = os.lstat(INSTALLED)
            installed_before = stable_identity(installed_value)
            installed_digest_before = path_sha(INSTALLED)
        except OSError as exc:
            raise Rig("R19 installed partial-state helper is unreadable") from exc
        if (
            not stat.S_ISREG(installed_value.st_mode)
            or installed_value.st_uid != 0 or installed_value.st_gid != 0
            or stat.S_IMODE(installed_value.st_mode) != 0o4555
            or installed_value.st_nlink != 1
            or installed_digest_before
            != PUBLISHED_H039_R8_PRODUCT_BLOBS[
                "verify/h039/runtime-cleanup-mediator"
            ]
        ):
            raise Rig("R19 installed partial-state helper identity mismatch")

    def exact_tree() -> dict[str, tuple[tuple[int, ...], str | None]]:
        try:
            root_stat = os.lstat(temporary)
        except OSError as exc:
            raise Rig("installer review root disappeared") from exc
        if retained_directory_identity(root_stat) != temporary_identity \
                or retained_directory_identity(os.fstat(temporary_fd)) != temporary_identity:
            raise Rig("installer review root identity changed")
        observed: dict[str, tuple[tuple[int, ...], str | None]] = {}
        pending = [temporary]
        while pending:
            parent = pending.pop()
            for entry in os.scandir(parent):
                path = Path(entry.path)
                value = os.lstat(path)
                relative = str(path.relative_to(temporary))
                target = os.readlink(path) if stat.S_ISLNK(value.st_mode) else None
                observed[relative] = (stable_identity(value), target)
                if stat.S_ISDIR(value.st_mode):
                    pending.append(path)
        return observed

    def require_fixed_tool(path: Path, digest: str, label: str) -> tuple[int, ...]:
        try:
            value = os.lstat(path)
        except OSError as exc:
            raise Undecidable(f"pinned {label} unavailable") from exc
        if (
            not stat.S_ISREG(value.st_mode) or value.st_uid != 0 or value.st_gid != 0
            or stat.S_IMODE(value.st_mode) != 0o755 or value.st_nlink != 1
            or path_sha(path) != digest
        ):
            raise Undecidable(f"pinned {label} identity drift")
        return stable_identity(value)

    sandbox_identity: tuple[int, ...] = ()
    probe_identity: tuple[int, ...] = ()

    def sandbox_argv(executable: Path) -> list[str]:
        return [
            str(SANDBOX_EXEC),
            "-D", f"H039_EXECUTABLE={executable}",
            "-D", f"H039_MEDIATOR={mediator}",
            "-D", f"H039_TEST_ROOT={temporary}",
            "-p", INSTALLER_REVIEW_PROFILE,
            str(executable),
        ]

    def nested_seatbelt_refused(result: subprocess.CompletedProcess[bytes]) -> bool:
        return (
            result.returncode == 71
            and b"sandbox_apply: Operation not permitted" in result.stderr
        )

    def run_sandboxed(
        executable: Path, arguments: list[str], environment: dict[str, str],
    ) -> subprocess.CompletedProcess[bytes]:
        before = exact_tree()
        result = bounded_run(
            [*sandbox_argv(executable), *arguments], cwd="/",
            env=environment, timeout=10,
        )
        if nested_seatbelt_refused(result):
            raise Undecidable("outer Seatbelt denied nested installer-review sandbox")
        if exact_tree() != before:
            raise Rig("sandboxed installer-review process changed its identity-bound tree")
        if (
            stable_identity(os.lstat(SANDBOX_EXEC)) != sandbox_identity
            or stable_identity(os.lstat(SEATBELT_WRITE_PROBE)) != probe_identity
        ):
            raise Undecidable("installer-review Seatbelt tool identity changed")
        return result

    environment = {
        "HOME": "/private/tmp/H039-INSTALLER-HOSTILE-HOME",
        "PATH": "/private/tmp/H039-INSTALLER-HOSTILE-PATH",
        "DYLD_INSERT_LIBRARIES": "/private/tmp/H039-INSTALLER-HOSTILE-DYLD",
        "NORTROPIC_MEDIATOR_PATH": "/private/tmp/H039-HOSTILE-MEDIATOR",
        "NORTROPIC_MEDIATOR_SHA256": "00" * 32,
    }

    def invoke(arguments: list[str]) -> subprocess.CompletedProcess[bytes]:
        return run_sandboxed(installer, arguments, environment)

    try:
        sandbox_identity = require_fixed_tool(
            SANDBOX_EXEC, SANDBOX_EXEC_SHA256, "/usr/bin/sandbox-exec",
        )
        probe_identity = require_fixed_tool(
            SEATBELT_WRITE_PROBE, SEATBELT_WRITE_PROBE_SHA256, "/usr/bin/touch",
        )
        write_canary = temporary / "seatbelt-write-canary"
        boundary = run_sandboxed(
            SEATBELT_WRITE_PROBE, [str(write_canary)],
            {"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
        )
        if (
            boundary.returncode != 1 or write_canary.exists()
            or b"Operation not permitted" not in boundary.stderr
        ):
            raise Rig(
                "installer-review deny-default Seatbelt boundary was not effective "
                f"rc={boundary.returncode} stderr={boundary.stderr!r}"
            )
        other_process = bounded_run(
            [*sandbox_argv(installer)[:-1], "/usr/bin/true"], cwd="/",
            env={"LANG": "C", "LC_ALL": "C"}, timeout=10,
        )
        if nested_seatbelt_refused(other_process):
            raise Undecidable("outer Seatbelt denied nested installer-review sandbox")
        if other_process.returncode == 0:
            raise Rig("installer-review Seatbelt admitted another executable")

        positive = invoke(["verify"])
        if diagnostic_product:
            if positive.returncode == 0 or positive.stdout or positive.stderr:
                raise Rig("diagnostic installer exposed a non-bootstrap operation")
        elif positive.returncode != 0 or positive.stdout or positive.stderr:
            raise Rig("uninstalled self-relative installer verify failed")
        for arguments in (
            [], ["verify", "extra"], ["hostile"], ["apply", "extra"],
            ["bootstrap", "extra"],
        ):
            rejected = invoke(arguments)
            if rejected.returncode == 0:
                raise Rig(f"installer accepted invalid argv: {arguments!r}")
        installer_alias = temporary / "installer-alias"
        os.link(installer, installer_alias)
        try:
            self_hardlink = run_sandboxed(installer_alias, ["verify"], environment)
            alias_value = os.lstat(installer_alias)
            installer_value = os.lstat(installer)
            if (
                (alias_value.st_dev, alias_value.st_ino)
                != (installer_value.st_dev, installer_value.st_ino)
                or alias_value.st_nlink != 2 or installer_value.st_nlink != 2
            ):
                raise Rig("installer self-hardlink control identity changed")
        finally:
            installer_alias.unlink()
        if self_hardlink.returncode == 0:
            raise Rig("installer accepted hardlinked self executable")
        installer_link = temporary / "installer-link"
        installer_link.symlink_to(installer)
        try:
            self_symlink = run_sandboxed(installer_link, ["verify"], environment)
            if not installer_link.is_symlink() \
                    or os.readlink(installer_link) != str(installer):
                raise Rig("installer self-symlink control identity changed")
        finally:
            installer_link.unlink()
        if self_symlink.returncode == 0:
            raise Rig("installer accepted symlinked self executable")
        alias = temporary / "mediator-alias"
        os.link(mediator, alias)
        try:
            hardlink = invoke(["verify"])
        finally:
            alias_value = os.lstat(alias)
            mediator_value = os.lstat(mediator)
            if (
                not stat.S_ISREG(alias_value.st_mode)
                or (alias_value.st_dev, alias_value.st_ino)
                != (mediator_value.st_dev, mediator_value.st_ino)
                or alias_value.st_nlink != 2 or mediator_value.st_nlink != 2
            ):
                raise Rig("installer hardlink control identity changed")
            alias.unlink()
        if hardlink.returncode == 0:
            raise Rig("installer accepted non-unique mediator artifact")
        retained = mediator.with_name("retained")
        mediator.rename(retained)
        mediator.symlink_to(retained)
        try:
            symlink = invoke(["verify"])
        finally:
            link_value = os.lstat(mediator)
            retained_value = os.lstat(retained)
            if (
                not stat.S_ISLNK(link_value.st_mode)
                or os.readlink(mediator) != str(retained)
                or not stat.S_ISREG(retained_value.st_mode)
                or retained_value.st_nlink != 1
            ):
                raise Rig("installer symlink control identity changed")
            mediator.unlink()
            retained.rename(mediator)
        if symlink.returncode == 0:
            raise Rig("installer accepted symlink mediator artifact")
        unprivileged_apply = invoke(["apply"])
        if unprivileged_apply.returncode == 0:
            raise Rig("unprivileged installer apply unexpectedly succeeded")
        unprivileged_bootstrap = invoke(["bootstrap"])
        if unprivileged_bootstrap.returncode == 0:
            raise Rig("unprivileged installer bootstrap unexpectedly succeeded")
        canary = b"H039-R13-INHERITED-FD0-MUST-REMAIN-UNCONSUMED"
        read_fd, write_fd = os.pipe()
        try:
            if os.write(write_fd, canary) != len(canary):
                raise Rig("fd0 canary write was partial")
            os.close(write_fd)
            write_fd = -1
            before_canary = exact_tree()
            process = subprocess.Popen(
                [*sandbox_argv(installer), "bootstrap"], stdin=read_fd,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, close_fds=True,
                cwd="/", env=environment, start_new_session=True,
            )
            try:
                stdout, stderr = process.communicate(timeout=10)
            except subprocess.TimeoutExpired as exc:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait(timeout=5)
                raise Rig("fd0 non-consumption control timed out") from exc
            if process.returncode == 71 \
                    and b"sandbox_apply: Operation not permitted" in stderr:
                raise Undecidable("outer Seatbelt denied fd0 non-consumption control")
            retained = os.read(read_fd, len(canary) + 1)
            clean_eof = os.read(read_fd, 1)
            if process.returncode == 0 or stdout or stderr \
                    or retained != canary or clean_eof != b"" \
                    or exact_tree() != before_canary:
                raise Rig("bootstrap consumed or changed the inherited fd0 canary")
        finally:
            if write_fd >= 0:
                os.close(write_fd)
            os.close(read_fd)
        installed_after = INSTALLED.exists() or INSTALLED.is_symlink()
        retained_installed_unchanged = True
        if retained_partial_state:
            try:
                retained_installed_unchanged = (
                    installed_before == stable_identity(os.lstat(INSTALLED))
                    and installed_digest_before == path_sha(INSTALLED)
                )
            except OSError:
                retained_installed_unchanged = False
        if (
            before_install != installed_after
            or not retained_installed_unchanged
            or stable_identity(os.lstat(NAMESPACE)) != namespace_before
        ):
            raise Rig("installer product review changed fixed PRE_EFFECTS state")
    finally:
        expected = {
            "controller", "controller/runtime-cleanup",
            "controller/runtime-cleanup/install", "verify", "verify/h039",
            "verify/h039/runtime-cleanup-mediator",
        }
        cleanup_error = None
        try:
            observed = exact_tree()
            if set(observed) != expected:
                cleanup_error = Rig("installer review tree changed; refusing pathname cleanup")
            else:
                installer_value = os.lstat(installer)
                mediator_value = os.lstat(mediator)
                if (
                    not stat.S_ISREG(installer_value.st_mode)
                    or stat.S_IMODE(installer_value.st_mode) != 0o755
                    or installer_value.st_nlink != 1
                    or sha(installer.read_bytes())
                    != sha(product_bytes("controller/runtime-cleanup/install", commit))
                    or not stat.S_ISREG(mediator_value.st_mode)
                    or stat.S_IMODE(mediator_value.st_mode) != 0o555
                    or mediator_value.st_nlink != 1
                    or sha(mediator.read_bytes())
                    != sha(product_bytes("verify/h039/runtime-cleanup-mediator", commit))
                ):
                    cleanup_error = Rig(
                        "installer review artifact identity changed; refusing pathname cleanup"
                    )
        except (OSError, Rig) as exc:
            cleanup_error = exc
        os.close(temporary_fd)
        if cleanup_error is None:
            shutil.rmtree(temporary)
        else:
            raise cleanup_error


def c_semantic_source(source: str) -> str:
    """Remove C comments without treating comment markers in literals as syntax."""
    if "\r" in source or "\\\n" in source \
            or re.search(r"\?\?[=/'()!<>-]", source):
        raise Rig("ambiguous C preprocessing sequence")
    out: list[str] = []
    state = "code"
    index = 0
    while index < len(source):
        value = source[index]
        following = source[index + 1] if index + 1 < len(source) else ""
        if state == "code":
            if value == "/" and following == "/":
                out.extend((" ", " "))
                index += 2
                state = "line"
                continue
            if value == "/" and following == "*":
                out.extend((" ", " "))
                index += 2
                state = "block"
                continue
            out.append(value)
            if value == '"':
                state = "string"
            elif value == "'":
                state = "character"
            index += 1
            continue
        if state == "line":
            if value == "\n":
                out.append(value)
                state = "code"
            else:
                out.append(" ")
            index += 1
            continue
        if state == "block":
            if value == "*" and following == "/":
                out.extend((" ", " "))
                index += 2
                state = "code"
                continue
            out.append("\n" if value == "\n" else " ")
            index += 1
            continue
        if value in {"\n", "\r"}:
            raise Rig("newline in C literal")
        out.append(value)
        if value == "\\":
            if index + 1 >= len(source):
                raise Rig("unterminated C literal escape")
            out.append(source[index + 1])
            index += 2
            continue
        if (state == "string" and value == '"') \
                or (state == "character" and value == "'"):
            state = "code"
        index += 1
    if state not in {"code", "line"}:
        raise Rig("unterminated C lexical state")
    normalized = "".join(out)
    if re.search(
        r"\\(?:x[0-9A-Fa-f]+|[0-7]{1,3}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
        normalized,
    ):
        raise Rig("numeric or universal C literal escape is forbidden")
    if re.search(
        r'(?:u8|u|U|L)?"(?:\\.|[^"\\])*"\s*'
        r'(?:u8|u|U|L)?"(?:\\.|[^"\\])*"',
        normalized,
    ):
        raise Rig("adjacent C string literal construction is forbidden")
    return normalized


def c_structure_mask(semantic_source: str) -> str:
    """Mask literal contents while preserving offsets for balanced delimiters."""
    out = list(semantic_source)
    state = "code"
    index = 0
    while index < len(semantic_source):
        value = semantic_source[index]
        if state == "code":
            if value == '"':
                out[index] = " "
                state = "string"
            elif value == "'":
                out[index] = " "
                state = "character"
            index += 1
            continue
        if value == "\\":
            out[index] = " "
            if index + 1 >= len(semantic_source):
                raise Rig("unterminated C structure escape")
            out[index + 1] = " "
            index += 2
            continue
        if (state == "string" and value == '"') \
                or (state == "character" and value == "'"):
            out[index] = " "
            state = "code"
        elif value != "\n":
            out[index] = " "
        index += 1
    if state != "code":
        raise Rig("unterminated C structure literal")
    return "".join(out)


def c_function_body(semantic_source: str, name: str) -> str:
    mask = c_structure_mask(semantic_source)
    matches = list(re.finditer(rf"\bstatic\s+int\s+{re.escape(name)}\s*\(", mask))
    if len(matches) != 1:
        raise Rig(f"exact installer function absent or duplicated: {name}")
    opening_parenthesis = mask.find("(", matches[0].start())
    depth = 0
    closing_parenthesis = -1
    for index in range(opening_parenthesis, len(mask)):
        if mask[index] == "(":
            depth += 1
        elif mask[index] == ")":
            depth -= 1
            if depth == 0:
                closing_parenthesis = index
                break
    if closing_parenthesis < 0:
        raise Rig(f"unterminated installer function declaration: {name}")
    opening_brace = closing_parenthesis + 1
    while opening_brace < len(mask) and mask[opening_brace].isspace():
        opening_brace += 1
    if opening_brace >= len(mask) or mask[opening_brace] != "{":
        raise Rig(f"installer function is not a definition: {name}")
    depth = 0
    for index in range(opening_brace, len(mask)):
        if mask[index] == "{":
            depth += 1
        elif mask[index] == "}":
            depth -= 1
            if depth == 0:
                return semantic_source[opening_brace + 1:index]
    raise Rig(f"unterminated installer function body: {name}")


def native_absolute_strings(source: str) -> set[str]:
    return set(re.findall(
        r'(?:u8|u|U|L)?"(/[^"\\]*)"', c_semantic_source(source),
    ))


def exact_native_absolute_literal_authority(
    source: str, *, diagnostic_product: bool,
) -> bool:
    expected = (
        R14_DIAGNOSTIC_NATIVE_ABSOLUTE_STRINGS
        if diagnostic_product else NATIVE_ABSOLUTE_STRINGS
    )
    return native_absolute_strings(source) == expected


def r15_native_absolute_literal_oracle_selftests() -> None:
    def fixture(values: set[str]) -> str:
        return "\n".join(
            f'static const char *h039_path_{index}="{value}";'
            for index, value in enumerate(sorted(values))
        )

    diagnostic_fixture = fixture(R14_DIAGNOSTIC_NATIVE_ABSOLUTE_STRINGS)
    r8_fixture = fixture(NATIVE_ABSOLUTE_STRINGS)
    check(
        exact_native_absolute_literal_authority(
            diagnostic_fixture, diagnostic_product=True,
        )
        and exact_native_absolute_literal_authority(
            r8_fixture, diagnostic_product=False,
        ),
        "A_H039_R15_CAUSAL_EXACT_15_AND_16_LITERAL_SETS",
    )
    required = "/.install/controller/runtime-cleanup"
    mutants = {
        "REMOVED": R14_DIAGNOSTIC_NATIVE_ABSOLUTE_STRINGS - {required},
        "SUBSTITUTED": (
            R14_DIAGNOSTIC_NATIVE_ABSOLUTE_STRINGS - {required}
        ) | {"/.install/controller/runtime-cleanup-substitute"},
        "ADDED": R14_DIAGNOSTIC_NATIVE_ABSOLUTE_STRINGS | {"/tmp/h039-added"},
        "BROADER_PREFIX": (
            R14_DIAGNOSTIC_NATIVE_ABSOLUTE_STRINGS - {required}
        ) | {"/.install/controller"},
    }
    for label, values in mutants.items():
        check(
            not exact_native_absolute_literal_authority(
                fixture(values), diagnostic_product=True,
            ),
            f"N_H039_R15_CAUSAL_LITERAL_MEMBERSHIP_{label}",
        )

    source = r16_expected_diagnostic_source()
    caller_selected = source.replace(
        b"if(close(0)!=0)",
        b"if(open(argv[1],O_RDONLY)<0||close(0)!=0)", 1,
    )
    literal_set_unchanged = exact_native_absolute_literal_authority(
        caller_selected.decode("utf-8"), diagnostic_product=True,
    )
    rejected = False
    try:
        r14_diagnostic_source_checks(caller_selected)
    except Rig:
        rejected = True
    check(
        literal_set_unchanged and rejected,
        "N_H039_R15_CALLER_SELECTED_PATH_REJECTED_BY_EXACT_SOURCE",
    )


def r14_diagnostic_fragment() -> bytes:
    assignments = ",\n".join(
        f"  H039_DIAG_{name} = {code}" for code, name in R14_EXIT_CODES
    )
    return f"""#if defined(H039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC)
enum h039_diagnostic_exit {{
{assignments}
}};

static int diagnostic_close_bootstrap_descriptors(void){{
  const int byte_cap=1048576;
  pid_t self=getpid();
  errno=0;
  int sizing=proc_pidinfo(self,PROC_PIDLISTFDS,0,NULL,0);
  if(sizing<=0)return H039_DIAG_FD_INITIAL_SIZING;
  if(errno!=0)return H039_DIAG_FD_INITIAL_ERRNO;
  if(sizing>byte_cap)return H039_DIAG_FD_INITIAL_CAP;
  if(sizing%(int)sizeof(struct proc_fdinfo))return H039_DIAG_FD_INITIAL_ALIGNMENT;
  struct proc_fdinfo *list=malloc((size_t)byte_cap);
  if(!list)return H039_DIAG_FD_INVENTORY_ALLOCATION;
  errno=0;
  int got=proc_pidinfo(self,PROC_PIDLISTFDS,0,list,byte_cap);
  if(got!=2*(int)sizeof *list){{free(list);return H039_DIAG_FD_POPULATED_COUNT;}}
  if(errno!=0){{free(list);return H039_DIAG_FD_POPULATED_ERRNO;}}
  if(list[0].proc_fd!=1&&list[0].proc_fd!=2){{free(list);return H039_DIAG_FD_ENTRY0_MEMBERSHIP_UNIQUENESS;}}
  if((list[1].proc_fd!=1&&list[1].proc_fd!=2)||list[1].proc_fd==list[0].proc_fd){{free(list);return H039_DIAG_FD_ENTRY1_MEMBERSHIP_UNIQUENESS;}}
  int one=list[0].proc_fd==1||list[1].proc_fd==1;
  int two=list[0].proc_fd==2||list[1].proc_fd==2;
  if(!one){{free(list);return H039_DIAG_FD1_ABSENT;}}
  if(!two){{free(list);return H039_DIAG_FD2_ABSENT;}}
  if(close(1)!=0){{free(list);return H039_DIAG_FD1_CLOSE;}}
  if(close(2)!=0){{free(list);return H039_DIAG_FD2_CLOSE;}}
  errno=0;
  sizing=proc_pidinfo(self,PROC_PIDLISTFDS,0,NULL,0);
  if(sizing<0){{free(list);return H039_DIAG_FD_SECOND_SIZING;}}
  if(errno!=0){{free(list);return H039_DIAG_FD_SECOND_ERRNO;}}
  if(sizing>byte_cap){{free(list);return H039_DIAG_FD_SECOND_CAP;}}
  if(sizing%(int)sizeof *list){{free(list);return H039_DIAG_FD_SECOND_ALIGNMENT;}}
  memset(list,0,(size_t)byte_cap);
  errno=0;
  got=proc_pidinfo(self,PROC_PIDLISTFDS,0,list,byte_cap);
  if(got!=0){{free(list);return H039_DIAG_FD_FINAL_GOT_NONZERO;}}
  if(errno!=0){{free(list);return H039_DIAG_FD_FINAL_ERRNO;}}
  free(list);
  return -1;
}}

__attribute__((noinline,used)) int installer_bootstrap(int argc,char **argv){{
  if(close(0)!=0)return H039_DIAG_FD0_CLOSE;
  errno=0;
  int fd0=fcntl(0,F_GETFD);
  if(fd0!=-1)return H039_DIAG_FD0_POSTCLOSE_FCNTL_RESULT;
  if(errno!=EBADF)return H039_DIAG_FD0_POSTCLOSE_ERRNO;
  int descriptor_result=diagnostic_close_bootstrap_descriptors();
  if(descriptor_result!=-1)return descriptor_result;

  if(argc!=2)return H039_DIAG_HANDLER_ARGC;
  if(!argv)return H039_DIAG_HANDLER_ARGV_POINTER;
  if(!argv[0])return H039_DIAG_HANDLER_ARGV0;
  if(!argv[1])return H039_DIAG_HANDLER_ARGV1;
  if(strcmp(argv[1],"bootstrap"))return H039_DIAG_HANDLER_BOOTSTRAP;
  if(getuid()!=0)return H039_DIAG_ROOT_RUID;
  if(geteuid()!=0)return H039_DIAG_ROOT_EUID;
  if(getgid()!=0)return H039_DIAG_ROOT_RGID;
  if(getegid()!=0)return H039_DIAG_ROOT_EGID;

  char initial[4096];
  uint32_t cap=4096;
  if(_NSGetExecutablePath(initial,&cap))return H039_DIAG_INITIAL_NSGET;
  if(!canonical_absolute(initial))return H039_DIAG_INITIAL_CANONICAL;
  if(strcmp(initial,NS "/.install/controller/runtime-cleanup/install"))return H039_DIAG_INITIAL_FIXED_PATH;
  if(strcmp(argv[0],initial))return H039_DIAG_INITIAL_ARGV0_PATH;
  static char *empty[]={{NULL}};
  environ=empty;
  if(chdir("/"))return H039_DIAG_CHDIR_ROOT;

  char self_path[4096];
  cap=4096;
  if(_NSGetExecutablePath(self_path,&cap))return H039_DIAG_LOADED_SECOND_NSGET;
  if(!canonical_absolute(self_path))return H039_DIAG_LOADED_CANONICAL;
  size_t self_path_n=strlen(self_path);
  if(self_path_n>=sizeof self_path)return H039_DIAG_LOADED_PATH_LENGTH;
  char *slash=strrchr(self_path,'/');
  if(!slash)return H039_DIAG_LOADED_SLASH;
  if(strcmp(slash+1,"install"))return H039_DIAG_LOADED_BASENAME;
  int self_parent=open(NS "/.install/controller/runtime-cleanup",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(self_parent<0)return H039_DIAG_LOADED_PARENT_OPEN;
  int self_fd=openat(self_parent,"install",O_RDONLY|O_CLOEXEC|O_NOFOLLOW_ANY|O_UNIQUE);
  if(self_fd<0)return H039_DIAG_LOADED_SELF_OPEN;
  struct stat self;
  if(fstat(self_fd,&self))return H039_DIAG_LOADED_SELF_FSTAT;
  struct stat self_name;
  if(fstatat(self_parent,"install",&self_name,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_LOADED_NAME_FSTATAT;
  if(!same_stat(&self,&self_name))return H039_DIAG_LOADED_SAME_STAT;
  if(!S_ISREG(self.st_mode))return H039_DIAG_LOADED_REGULAR;
  if(self.st_nlink!=1)return H039_DIAG_LOADED_NLINK;
  struct proc_regionwithpathinfo image={{0}};
  int got=proc_pidinfo(getpid(),PROC_PIDREGIONPATHINFO,(uint64_t)(uintptr_t)&main,&image,sizeof image);
  if(got!=(int)sizeof image)return H039_DIAG_LOADED_REGION_FULL_SIZE;
  if(image.prp_vip.vip_vi.vi_stat.vst_dev!=(uint32_t)self.st_dev)return H039_DIAG_LOADED_REGION_DEVICE;
  if(image.prp_vip.vip_vi.vi_stat.vst_ino!=(uint64_t)self.st_ino)return H039_DIAG_LOADED_REGION_INODE;
  if(strcmp(image.prp_vip.vip_path,self_path))return H039_DIAG_LOADED_REGION_PATH;
  if(strcmp(self_path,initial))return H039_DIAG_LOADED_INITIAL_PATH;
  if(self.st_uid!=0)return H039_DIAG_LOADED_SELF_UID;
  if(self.st_gid!=0)return H039_DIAG_LOADED_SELF_GID;
  if((self.st_mode&07777)!=0500)return H039_DIAG_LOADED_SELF_MODE;
  if(self.st_nlink!=1)return H039_DIAG_LOADED_SELF_OUTER_NLINK;

  unsigned long section_n=0;
  uint8_t *section=getsectiondata(&_mh_execute_header,"__H039RO","__h039med",&section_n);
  if(!section)return H039_DIAG_EMBEDDED_SECTION_POINTER;
  if(section_n==0||section_n!=(unsigned long)H039_MEDIATOR_SIZE)return H039_DIAG_EMBEDDED_SECTION_SIZE_NONZERO;
  char section_digest[65];
  digest(section,(size_t)section_n,section_digest);
  if(strcmp(section_digest,Q(H039_MEDIATOR_SHA256)))return H039_DIAG_EMBEDDED_DIGEST;
  unsigned char *mediator=malloc((size_t)section_n);
  if(!mediator)return H039_DIAG_EMBEDDED_ALLOCATION;
  memcpy(mediator,section,(size_t)section_n);
  (void)*(volatile unsigned char *)mediator;

  int controller=openat(self_parent,"..",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(controller<0)return H039_DIAG_CONTROLLER_PARENT_OPEN;
  struct stat controller_stat;
  if(fstat(controller,&controller_stat))return H039_DIAG_CONTROLLER_PARENT_FSTAT;
  if(!S_ISDIR(controller_stat.st_mode)||controller_stat.st_uid!=0||controller_stat.st_gid!=0||(controller_stat.st_mode&07777)!=0700)return H039_DIAG_CONTROLLER_PARENT_SHAPE;
  int project=openat(controller,"..",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(project<0)return H039_DIAG_PROJECT_PARENT_OPEN;
  struct stat project_stat;
  if(fstat(project,&project_stat))return H039_DIAG_PROJECT_PARENT_FSTAT;
  if(!S_ISDIR(project_stat.st_mode)||project_stat.st_uid!=0||project_stat.st_gid!=0||(project_stat.st_mode&07777)!=0700)return H039_DIAG_PROJECT_PARENT_SHAPE;

  struct stat project_before;
  if(fstat(project,&project_before))return H039_DIAG_STAGING_PROJECT_FSTAT;
  if(!S_ISDIR(project_before.st_mode)||project_before.st_uid!=0||project_before.st_gid!=0||(project_before.st_mode&07777)!=0700)return H039_DIAG_STAGING_PROJECT_SHAPE;
  if(fsync(project))return H039_DIAG_STAGING_PROJECT_FSYNC;
  struct stat project_after;
  if(fstat(project,&project_after))return H039_DIAG_STAGING_PROJECT_POST_FSYNC_FSTAT;
  if(!same_stat(&project_before,&project_after))return H039_DIAG_STAGING_PROJECT_SAME_STAT;
  const char *project_names[]={{"controller","mediator"}};
  if(!exact_names(project,project_names,2,1U))return H039_DIAG_STAGING_PROJECT_MEMBERSHIP;
  int staging_controller=durable_fixed_dir_at(project,"controller",0,0,0700);
  if(staging_controller<0)return H039_DIAG_STAGING_DURABLE_CONTROLLER;
  int staging_runtime=durable_fixed_dir_at(staging_controller,"runtime-cleanup",0,0,0700);
  if(staging_runtime<0)return H039_DIAG_STAGING_DURABLE_RUNTIME;
  const char *controller_names[]={{"runtime-cleanup"}};
  if(!exact_names(staging_controller,controller_names,1,1U))return H039_DIAG_STAGING_CONTROLLER_MEMBERSHIP;
  const char *runtime_names[]={{"install"}};
  if(!exact_names(staging_runtime,runtime_names,1,1U))return H039_DIAG_STAGING_RUNTIME_MEMBERSHIP;
  struct stat named;
  int stable_self=stable_named_fd(staging_runtime,"install",O_RDONLY,0,0,0500,4194304,NULL,NULL,&named);
  if(stable_self<0)return H039_DIAG_STAGING_STABLE_SELF;
  if(!same_stat(&self,&named))return H039_DIAG_STAGING_SELF_IDENTITY_EQUALITY;
  if(fsync(stable_self))return H039_DIAG_STAGING_SELF_FSYNC;
  if(flush_dir(staging_runtime))return H039_DIAG_STAGING_RUNTIME_FSYNC;
  struct stat stable_after;
  if(fstat(stable_self,&stable_after))return H039_DIAG_STAGING_SELF_POST_FSYNC_FSTAT;
  if(!same_stat(&named,&stable_after))return H039_DIAG_STAGING_SELF_SAME_STAT;
  struct stat stable_name;
  if(fstatat(staging_runtime,"install",&stable_name,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_STAGING_SELF_NAME_FSTATAT;
  if(!same_stat(&stable_after,&stable_name))return H039_DIAG_STAGING_SELF_FINAL_SAME_STAT;
  if(close(stable_self))return H039_DIAG_STAGING_SELF_CLOSE;
  if(close(staging_runtime))return H039_DIAG_STAGING_RUNTIME_CLOSE;
  if(close(staging_controller))return H039_DIAG_STAGING_CONTROLLER_CLOSE;

  int ns=open(NS,O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(ns<0)return H039_DIAG_NAMESPACE_OPEN;
  struct stat namespace_stat;
  if(fstat(ns,&namespace_stat))return H039_DIAG_NAMESPACE_FSTAT;
  if(!S_ISDIR(namespace_stat.st_mode)||namespace_stat.st_uid!=0||namespace_stat.st_gid!=0||((namespace_stat.st_mode&07777)!=0700&&(namespace_stat.st_mode&07777)!=0555))return H039_DIAG_NAMESPACE_SHAPE;
  int database=openat(ns,"..",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  struct stat database_stat;
  if(database<0||fstat(database,&database_stat)||!S_ISDIR(database_stat.st_mode)||database_stat.st_uid!=0||database_stat.st_gid!=0||(database_stat.st_mode&07777)!=0755)return H039_DIAG_DATABASE_PARENT;
  if(fsync(ns))return H039_DIAG_NAMESPACE_FSYNC;
  if(flush_dir(database))return H039_DIAG_DATABASE_FSYNC;
  struct stat namespace_after;
  if(fstat(ns,&namespace_after))return H039_DIAG_NAMESPACE_POST_FSYNC_FSTAT;
  if(!same_stat(&namespace_stat,&namespace_after))return H039_DIAG_NAMESPACE_POST_FSYNC_SAME_STAT;
  struct stat namespace_name;
  if(fstatat(database,"nortropic-runtime-cleanup-v1",&namespace_name,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_DATABASE_NAME_FSTATAT;
  if(!same_stat(&namespace_after,&namespace_name))return H039_DIAG_DATABASE_NAME_SAME_STAT;
  struct stat namespace_path;
  if(lstat(NS,&namespace_path))return H039_DIAG_NAMESPACE_LSTAT;
  if(!same_stat(&namespace_after,&namespace_path))return H039_DIAG_NAMESPACE_LSTAT_SAME_STAT;
  struct stat project_recheck;
  if(fstat(project,&project_recheck))return H039_DIAG_PROJECT_RE_FSTAT;
  struct stat install_name;
  if(fstatat(ns,".install",&install_name,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_NAMESPACE_INSTALL_FSTATAT;
  if(!same_stat(&project_recheck,&install_name))return H039_DIAG_NAMESPACE_INSTALL_SAME_STAT;
  if(fsync(project))return H039_DIAG_PROJECT_RE_FSYNC;
  if(fsync(ns))return H039_DIAG_NAMESPACE_RE_FSYNC;
  struct stat project_final;
  if(fstat(project,&project_final))return H039_DIAG_PROJECT_FINAL_FSTAT;
  if(!same_stat(&project_recheck,&project_final))return H039_DIAG_PROJECT_FINAL_SAME_STAT;
  struct stat install_final;
  if(fstatat(ns,".install",&install_final,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH))return H039_DIAG_NAMESPACE_INSTALL_FINAL_FSTATAT;
  if(!same_stat(&project_final,&install_final))return H039_DIAG_NAMESPACE_INSTALL_FINAL_SAME_STAT;
  const char *namespace_names[]={{".install"}};
  if(!exact_names(ns,namespace_names,1,1U))return H039_DIAG_NAMESPACE_EXACT_MEMBERSHIP;

  struct stat absent;
  errno=0;
  if(fstatat(ns,"a",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_A_ENOENT;
  errno=0;
  if(fstatat(ns,"c",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_C_ENOENT;
  errno=0;
  if(fstatat(ns,"q",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_Q_ENOENT;
  errno=0;
  if(fstatat(ns,"r",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_R_ENOENT;
  errno=0;
  if(fstatat(ns,"s",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_S_ENOENT;
  errno=0;
  if(fstatat(ns,"s/lock",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_NAMESPACE_PREFIX0_NO_LOCK;

  int helpers=open("/Library/PrivilegedHelperTools",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);
  if(helpers<0)return H039_DIAG_HELPERS_OPEN;
  struct stat helpers_before,helpers_after,helpers_name;
  if(fstat(helpers,&helpers_before)||!S_ISDIR(helpers_before.st_mode)||helpers_before.st_uid!=0||helpers_before.st_gid!=0||(helpers_before.st_mode&0022)||fsync(helpers)||fstat(helpers,&helpers_after)||!same_stat(&helpers_before,&helpers_after)||lstat("/Library/PrivilegedHelperTools",&helpers_name)||!same_stat(&helpers_after,&helpers_name))return H039_DIAG_HELPERS_FSTAT_SHAPE_FSYNC_REBIND;
  errno=0;
  if(fstatat(helpers,"se.nortropic.runtime-cleanup-mediator",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_INSTALLED_HELPER_ENOENT;
  errno=0;
  if(fstatat(project,"mediator",&absent,AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH)!=-1||errno!=ENOENT)return H039_DIAG_STAGED_MEDIATOR_ENOENT;

  (void)mediator;
  return H039_DIAG_IMMEDIATE_PRE_CREATE_BOUNDARY_REACHED_ZERO_EFFECT;
}}

static int installer_main(int argc,char **argv){{
  if(argc!=2)return H039_DIAG_MAIN_ARGC;
  if(!argv)return H039_DIAG_MAIN_ARGV_POINTER;
  if(!argv[0])return H039_DIAG_MAIN_ARGV0;
  if(!argv[1])return H039_DIAG_MAIN_ARGV1;
  if(strcmp(argv[1],"bootstrap"))return H039_DIAG_MAIN_OPERATION;
  return installer_bootstrap(argc,argv);
}}
""".encode("utf-8")


def r14_expected_diagnostic_source() -> bytes:
    base = blob(
        PUBLISHED_H039_R8_PRODUCT_MERGE,
        "controller/runtime-cleanup/native/mediator.c",
    )
    start_marker = b"static int installer_bootstrap(int argc,char **argv){"
    end_marker = b"#endif\n\nint main(int argc,char **argv){"
    if base.count(start_marker) != 1 or base.count(end_marker) != 1:
        raise Rig("published R8 diagnostic transform anchors drift")
    start = base.index(start_marker)
    end = base.index(end_marker, start)
    return (
        base[:start] + r14_diagnostic_fragment() + b"#else\n"
        + base[start:end] + b"#endif\n" + base[end:]
    )


def r16_expected_diagnostic_source() -> bytes:
    base = blob(
        PUBLISHED_H039_R9_PRODUCT_MERGE,
        "controller/runtime-cleanup/native/mediator.c",
    )
    if (
        len(base) != R14_DIAGNOSTIC_SOURCE_SIZE
        or sha(base) != R14_DIAGNOSTIC_SOURCE_SHA256
        or base != r14_expected_diagnostic_source()
    ):
        raise Rig("published R9 source is not the frozen R14/R15 diagnostic")
    old_new = (
        (
            b"if(flush_dir(staging_runtime))return H039_DIAG_STAGING_RUNTIME_FSYNC;",
            b"if(!flush_dir(staging_runtime))return H039_DIAG_STAGING_RUNTIME_FSYNC;",
        ),
        (
            b"if(flush_dir(database))return H039_DIAG_DATABASE_FSYNC;",
            b"if(!flush_dir(database))return H039_DIAG_DATABASE_FSYNC;",
        ),
    )
    corrected = base
    for old, new in old_new:
        if corrected.count(old) != 1 or corrected.count(new) != 0:
            raise Rig("published R9 polarity transform anchor drift")
        corrected = corrected.replace(old, new, 1)
    if len(corrected) != len(base) + 2:
        raise Rig("R16 transform is not exactly two inserted negations")
    return corrected


def r18_expected_production_recipe() -> bytes:
    current = blob(R18_AUTHORITY_BASE, "verify/h039/build-recipe.json")
    target = blob(PUBLISHED_H039_R8_PRODUCT_MERGE, "verify/h039/build-recipe.json")
    if sha(current) != R18_CURRENT_DIAGNOSTIC_RECIPE_SHA256:
        raise Rig("R18 current diagnostic recipe identity drift")
    if sha(target) != R18_PRODUCTION_RECIPE_SHA256:
        raise Rig("R18 published R8 production recipe identity drift")
    current_value = strict_json(current)
    target_value = strict_json(target)
    if type(current_value) is not dict or type(target_value) is not dict:
        raise Rig("R18 recipe is not an exact object")
    current_argv = current_value.get("installer_compile_argv")
    target_argv = target_value.get("installer_compile_argv")
    if type(current_argv) is not list or type(target_argv) is not list:
        raise Rig("R18 recipe installer argv is not exact")
    reduced = list(current_argv)
    for item in R18_RECIPE_REMOVED_ARGV:
        if reduced.count(item) != 1:
            raise Rig("R18 diagnostic recipe removal anchor drift")
        reduced.remove(item)
    expected_value = copy.deepcopy(current_value)
    expected_value["installer_compile_argv"] = reduced
    if expected_value != target_value:
        raise Rig("R18 recipe delta is broader than two diagnostic argv deletions")
    return target


def r18_expected_production_source() -> bytes:
    base = blob(
        R18_AUTHORITY_BASE,
        "controller/runtime-cleanup/native/mediator.c",
    )
    if (
        len(base) != R18_CURRENT_WRAPPER_SOURCE_SIZE
        or sha(base) != R18_CURRENT_WRAPPER_SOURCE_SHA256
    ):
        raise Rig("R18 current R10-wrapper source identity drift")
    corrected = base
    for old_text, corrected_text in zip(
        R18_OLD_PREDICATES, R18_CORRECTED_PREDICATES, strict=True,
    ):
        old = old_text.encode("utf-8")
        new = corrected_text.encode("utf-8")
        if corrected.count(old) != 1 or corrected.count(new) != 0:
            raise Rig("R18 production polarity transform anchor drift")
        corrected = corrected.replace(old, new, 1)
    if (
        len(corrected) != R18_CORRECTED_WRAPPER_SOURCE_SIZE
        or sha(corrected) != R18_CORRECTED_WRAPPER_SOURCE_SHA256
    ):
        raise Rig("R18 transform is not exactly four inserted negations")
    return corrected


def r19_expected_production_source() -> bytes:
    base = blob(
        R19_AUTHORITY_BASE,
        "controller/runtime-cleanup/native/mediator.c",
    )
    if (
        len(base) != R19_BASE_SOURCE_SIZE
        or sha(base) != R19_BASE_SOURCE_SHA256
        or base != r18_expected_production_source()
    ):
        raise Rig("R19 published R11 source identity drift")
    old = R19_OLD_EXACT_NAMES.encode("utf-8")
    new = R19_CORRECTED_EXACT_NAMES.encode("utf-8")
    scoped = R19_SCOPED_EXACT_NAMES.encode("utf-8")
    if base.count(old) != 1 or base.count(new) != 0 or base.count(scoped) != 0:
        raise Rig("R19 exact_names transform anchor drift")
    corrected = base.replace(old, scoped, 1)
    if (
        len(corrected) != R19_CORRECTED_SOURCE_SIZE
        or sha(corrected) != R19_CORRECTED_SOURCE_SHA256
    ):
        raise Rig("R19 transform is not the frozen installer-scoped selection")
    return corrected


def r19_selected_production_source(raw: bytes, *, installer: bool) -> bytes:
    scoped = R19_SCOPED_EXACT_NAMES.encode("utf-8")
    selected = (
        R19_CORRECTED_EXACT_NAMES if installer else R19_OLD_EXACT_NAMES
    ).encode("utf-8")
    if raw.count(scoped) != 1:
        raise Rig("R19 conditional source selection anchor drift")
    return raw.replace(scoped, selected, 1)


def r19_production_source_valid(raw: bytes) -> bool:
    try:
        expected = r19_expected_production_source()
        old = R19_OLD_EXACT_NAMES.encode("utf-8")
        new = R19_CORRECTED_EXACT_NAMES.encode("utf-8")
        scoped = R19_SCOPED_EXACT_NAMES.encode("utf-8")
        base = blob(
            R19_AUTHORITY_BASE,
            "controller/runtime-cleanup/native/mediator.c",
        )
        return (
            raw == expected
            and len(raw) == R19_CORRECTED_SOURCE_SIZE
            and sha(raw) == R19_CORRECTED_SOURCE_SHA256
            and raw.count(scoped) == 1
            and raw.count(old) == 1 and raw.count(new) == 1
            and raw.replace(scoped, old, 1) == base
            and r19_selected_production_source(raw, installer=False) == base
            and sha(r19_selected_production_source(raw, installer=False))
            == R19_R11_SOURCE_SHA256
            and sha(r19_selected_production_source(raw, installer=True))
            == "f79f7eb95e9b89350d2ddc7580b11b455ead09ea0e498a19267be3a22168edda"
        )
    except (OSError, Rig, subprocess.SubprocessError, ValueError):
        return False


def r19_source_selftests() -> None:
    expected = r19_expected_production_source()
    check(
        r19_production_source_valid(expected),
        "A_H039_R19_EXACT_INSTALLER_SCOPED_SOURCE_TRANSFORM",
    )
    new = R19_CORRECTED_EXACT_NAMES.encode("utf-8")
    old = R19_OLD_EXACT_NAMES.encode("utf-8")
    scoped = R19_SCOPED_EXACT_NAMES.encode("utf-8")
    base = blob(
        R19_AUTHORITY_BASE,
        "controller/runtime-cleanup/native/mediator.c",
    )
    branch_mutants = (
        ("GLOBAL_CORRECTION", base.replace(old, new, 1)),
        ("BOTH_BRANCHES_OLD", expected.replace(scoped, old, 1)),
        (
            "BOTH_BRANCHES_CORRECTED",
            expected.replace(scoped, new, 1),
        ),
        (
            "BRANCHES_SWAPPED",
            expected.replace(
                scoped,
                b"#if defined(H039_INSTALLER)\n" + old
                + b"\n#else\n" + new + b"\n#endif",
                1,
            ),
        ),
        ("MISSING_GUARD", expected.replace(scoped, new + b"\n" + old, 1)),
    )
    for label, candidate in branch_mutants:
        check(
            candidate != expected and not r19_production_source_valid(candidate),
            f"N_H039_R19_SOURCE_{label}",
        )
    function_mutants = (
        ("OLD_DUP_SHARED_CURSOR", old),
        (
            "MISSING_PRE_IDENTITY",
            new.replace(
                b"if(fstat(directory,&original_before)||"
                b"!S_ISDIR(original_before.st_mode))return 0;",
                b"memset(&original_before,0,sizeof(original_before));",
                1,
            ),
        ),
        (
            "MISSING_SCAN_IDENTITY",
            new.replace(
                b"if(fstat(scan,&scan_identity)||"
                b"!same_stat(&original_before,&scan_identity))",
                b"if(fstat(scan,&scan_identity))",
                1,
            ),
        ),
        (
            "MISSING_POST_IDENTITY",
            new.replace(
                b"if(fstat(directory,&original_after)||"
                b"!same_stat(&original_before,&original_after))ok=0;",
                b"(void)original_after;",
                1,
            ),
        ),
        (
            "WRONG_DOT_NAME",
            new.replace(b'openat(directory,"."', b'openat(directory,".."', 1),
        ),
        ("DEAD_DECOY", new + b"\nstatic int exact_names_decoy(void){return 1;}"),
        (
            "CALLER_CURSOR_CONSUMED",
            new.replace(
                b'int scan=openat(directory,".",O_RDONLY|O_DIRECTORY|'
                b'O_CLOEXEC|O_NOFOLLOW_ANY);',
                b"int scan=dup(directory);",
                1,
            ),
        ),
    )
    for label, mutant in function_mutants:
        if mutant == new:
            raise Rig(f"R19 source mutant construction failed: {label}")
        candidate = expected.replace(new, mutant, 1)
        check(
            not r19_production_source_valid(candidate),
            f"N_H039_R19_SOURCE_{label}",
        )


def r19_scoped_build_satisfiability_checks() -> None:
    recipe_raw = blob(R19_AUTHORITY_BASE, "verify/h039/build-recipe.json")
    recipe = strict_json(recipe_raw)
    expected_mediator = blob(
        R19_PRIOR_CONTRACT_BASE, "verify/h039/runtime-cleanup-mediator",
    )
    if (
        sha(recipe_raw) != R18_PRODUCTION_RECIPE_SHA256
        or sha(expected_mediator)
        != PUBLISHED_H039_R8_PRODUCT_BLOBS[
            "verify/h039/runtime-cleanup-mediator"
        ]
    ):
        raise Rig("R19 scoped build authority identity drift")
    temporary = Path(tempfile.mkdtemp(prefix="h039-r19-scoped-", dir="/private/tmp"))
    project = temporary / "project"
    try:
        for directory in (
            "controller/runtime-cleanup/native", "verify/h039",
        ):
            (project / directory).mkdir(parents=True, exist_ok=True)
        source = project / "controller/runtime-cleanup/native/mediator.c"
        source.write_bytes(r19_expected_production_source())
        source.chmod(0o644)
        environment = {
            "HOME": "/var/empty", "TMPDIR": str(project),
            "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin",
        }

        def run_build(key: str) -> None:
            arguments = recipe.get(key)
            if not isinstance(arguments, list) or not arguments \
                    or not all(isinstance(value, str) for value in arguments):
                raise Rig(f"R19 scoped build argv drift: {key}")
            result = bounded_run([
                str(SANDBOX_EXEC),
                "-D", f"H039_BUILD_EXECUTABLE={arguments[0]}",
                "-D", f"H039_BUILD_ROOT={project}",
                "-p", BUILD_REVIEW_PROFILE, *arguments,
            ], cwd=project, env=environment, timeout=60)
            if result.returncode == 71 \
                    and b"sandbox_apply: Operation not permitted" in result.stderr:
                raise Undecidable("outer Seatbelt denied R19 scoped build")
            if result.returncode != 0:
                raise Rig(
                    f"R19 scoped build failed {key} rc={result.returncode} "
                    f"stderr={result.stderr!r}"
                )

        run_build("mediator_compile_argv")
        run_build("mediator_sign_argv")
        rebuilt_mediator = (
            project / "verify/h039/runtime-cleanup-mediator"
        ).read_bytes()
        if rebuilt_mediator != expected_mediator:
            raise Rig(
                "R19 runtime branch does not reproduce the byte-exact mediator"
            )
        run_build("installer_compile_argv")
        run_build("installer_sign_argv")
        rebuilt_installer = (
            project / "controller/runtime-cleanup/install"
        ).read_bytes()
        check(
            len(rebuilt_installer) == R19_EXPECTED_INSTALLER_SIZE
            and sha(rebuilt_installer) == R19_EXPECTED_INSTALLER_SHA256,
            "A_H039_R19_SCOPED_RUNTIME_AND_INSTALLER_REPRODUCIBLE_BUILD",
            {
                "runtime_mediator_sha256": sha(rebuilt_mediator),
                "installer_sha256": sha(rebuilt_installer),
                "installer_size": len(rebuilt_installer),
            },
        )
    finally:
        shutil.rmtree(temporary)


def r19_parse_partial_transcript(raw: bytes) -> list[tuple[int, bytes]]:
    blocks: list[tuple[int, bytes]] = []
    cursor = 0
    for index in range(96):
        begin = f"BEGIN C{index:03d}\n".encode("ascii")
        end = f"END C{index:03d} RC=".encode("ascii")
        if not raw.startswith(begin, cursor):
            raise Rig(f"R19 partial transcript begin C{index:03d} drift")
        start = cursor + len(begin)
        stop = raw.find(end, start)
        if stop < start or stop - start > 65536:
            raise Rig(f"R19 partial transcript end C{index:03d} drift")
        rc_end = raw.find(b"\n", stop + len(end))
        if rc_end < 0:
            raise Rig(f"R19 partial transcript status C{index:03d} drift")
        rc_raw = raw[stop + len(end):rc_end]
        if re.fullmatch(rb"(?:0|[1-9][0-9]{0,2})", rc_raw) is None:
            raise Rig(f"R19 partial transcript rc C{index:03d} drift")
        blocks.append((int(rc_raw), raw[start:stop]))
        cursor = rc_end + 1
    if cursor != len(raw):
        raise Rig("R19 partial transcript trailing bytes")
    return blocks


def r19_partial_state_evidence_checks() -> None:
    try:
        value = os.lstat(R19_PARTIAL_TRANSCRIPT)
        descriptor = os.open(
            R19_PARTIAL_TRANSCRIPT,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
            | getattr(os, "O_NOFOLLOW_ANY") | 0x00002000,
        )
    except OSError as exc:
        raise Undecidable("R19 owner-witnessed partial transcript unavailable") from exc
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != CLIENT_UID or opened.st_gid != CLIENT_GID
            or stat.S_IMODE(opened.st_mode) != 0o600 or opened.st_nlink != 1
            or opened.st_size != R19_PARTIAL_TRANSCRIPT_SIZE
            or stable_identity(value) != stable_identity(opened)
        ):
            raise Rig("R19 partial transcript identity mismatch")
        chunks: list[bytes] = []; remaining = opened.st_size
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                raise Rig("R19 partial transcript short read")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise Rig("R19 partial transcript trailing byte")
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        rebound = os.lstat(R19_PARTIAL_TRANSCRIPT)
        if (
            stable_identity(opened) != stable_identity(after)
            or stable_identity(after) != stable_identity(rebound)
            or sha(raw) != R19_PARTIAL_TRANSCRIPT_SHA256
        ):
            raise Rig("R19 partial transcript changed or rebound")
    finally:
        os.close(descriptor)
    blocks = r19_parse_partial_transcript(raw)
    rc_digest = sha(bytes(rc for rc, _payload in blocks))
    exact_payloads = {
        15: b"16777232:126988174:100500:0:0:1:169264:0\n",
        18: (
            b"stat: /private/var/db/nortropic-runtime-cleanup-v1/.install/"
            b"mediator: stat: No such file or directory\n"
        ),
        21: b"16777232:128098564:40555:0:0:2:64:0\n",
        24: b"16777232:128098565:40555:0:0:2:64:0\n",
        27: b"16777232:128098566:40555:0:0:2:64:0\n",
        30: b"16777232:128098567:40555:0:0:2:64:0\n",
        33: b"16777232:128098568:40555:0:0:3:96:0\n",
        36: b"16777232:128098569:100600:0:0:1:0:0\n",
        42: b"16777232:128098563:104555:0:0:1:89392:0\n",
        46: (R19_R11_INSTALLER_SHA256 + " */private/var/db/nortropic-runtime-cleanup-v1/.install/controller/runtime-cleanup/install\n").encode("ascii"),
        52: b"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 */private/var/db/nortropic-runtime-cleanup-v1/s/lock\n",
        55: b"6c2f2dbe6f564224686d53acf9cbc782074ff554508b51031cf6b076fbb0d68a */Library/PrivilegedHelperTools/se.nortropic.runtime-cleanup-mediator\n",
    }
    exact_ok = all(
        blocks[index][1] == payload for index, payload in exact_payloads.items()
    )
    check(
        rc_digest == R19_PARTIAL_RC_VECTOR_SHA256 and exact_ok
        and blocks[18][0] == 1 and blocks[42][0] == 0,
        "A_H039_R19_OWNER_WITNESSED_PARTIAL_STATE_EXACT_EVIDENCE",
        {"transcript_sha256": sha(raw), "rc_vector_sha256": rc_digest},
    )


def r21_stable_evidence_bytes(
    path: Path, digest: str, *, mode: int, size: int | None = None,
) -> bytes:
    exact_paths = {
        R21_RECOVERY_SOURCE_BINDING, R21_RECOVERY_DUAL_REVIEW,
        R21_FROZEN_WORKFLOW_VALIDATOR, R21_POST_INSTALL_TRANSCRIPT,
    }
    if path not in exact_paths or not valid_hex(digest):
        raise Rig("R21 evidence request is not fixed and digest-bound")
    try:
        named = os.lstat(path)
        descriptor = os.open(
            path, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
            | getattr(os, "O_NOFOLLOW_ANY") | 0x00002000,
        )
    except OSError as exc:
        raise Undecidable(f"R21 fixed workflow evidence unavailable: {path}") from exc
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != CLIENT_UID or opened.st_gid != CLIENT_GID
            or stat.S_IMODE(opened.st_mode) != mode or opened.st_nlink != 1
            or (size is not None and opened.st_size != size)
            or opened.st_size > 12582912
            or stable_identity(named) != stable_identity(opened)
        ):
            raise Rig(f"R21 fixed workflow evidence identity mismatch: {path}")
        chunks: list[bytes] = []
        remaining = opened.st_size
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                raise Rig(f"R21 fixed workflow evidence short read: {path}")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise Rig(f"R21 fixed workflow evidence trailing byte: {path}")
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        rebound = os.lstat(path)
        if stable_identity(opened) != stable_identity(after) \
                or stable_identity(after) != stable_identity(rebound) \
                or len(raw) != after.st_size or sha(raw) != digest:
            raise Rig(f"R21 fixed workflow evidence changed or rebound: {path}")
        return raw
    finally:
        os.close(descriptor)


def r21_post_install_evidence_checks() -> None:
    source_binding = r21_stable_evidence_bytes(
        R21_RECOVERY_SOURCE_BINDING, R21_RECOVERY_SOURCE_BINDING_SHA256,
        mode=0o644,
    )
    dual_review = r21_stable_evidence_bytes(
        R21_RECOVERY_DUAL_REVIEW, R21_RECOVERY_DUAL_REVIEW_SHA256,
        mode=0o644,
    )
    validator = r21_stable_evidence_bytes(
        R21_FROZEN_WORKFLOW_VALIDATOR, R21_FROZEN_WORKFLOW_VALIDATOR_SHA256,
        mode=0o644,
    )
    transcript = r21_stable_evidence_bytes(
        R21_POST_INSTALL_TRANSCRIPT, R21_POST_INSTALL_TRANSCRIPT_SHA256,
        mode=0o600, size=R21_POST_INSTALL_TRANSCRIPT_SIZE,
    )
    for label, raw in (("SOURCE_BINDING", source_binding), ("DUAL_REVIEW", dual_review)):
        parsed = strict_json(raw)
        if type(parsed) is not dict:
            raise Rig(f"R21 {label} is not an exact JSON object")
    validator_literals = (
        b'"a": 21, "c": 24, "q": 27, "r": 30, "s": 33',
        b'b"dr-xr-xr-x", nlink=2,',
        b'blocks, 36, LOCK, stat.S_IFREG | 0o600, b"-rw-------", nlink=1, size=0',
        b'require_membership(blocks, 93, dirs["s"], [LOCK])',
    )
    if not all(validator.count(literal) == 1 for literal in validator_literals):
        raise Rig("R21 frozen workflow validator contradiction identity drift")
    blocks = r19_parse_partial_transcript(transcript)
    rc_digest = sha(bytes(rc for rc, _payload in blocks))

    def observed_stat(index: int) -> tuple[int, ...]:
        rc, payload = blocks[index]
        match = re.fullmatch(
            rb"([0-9]+):([0-9]+):([0-9]+):([0-9]+):([0-9]+):"
            rb"([0-9]+):([0-9]+):([0-9]+)\n",
            payload,
        )
        if rc != 0 or match is None:
            raise Rig(f"R21 post-install stat block C{index + 1:03d} drift")
        return tuple(int(value) for value in match.groups())

    namespace = observed_stat(3)
    directories = {name: observed_stat(index) for name, index in {
        "a": 21, "c": 24, "q": 27, "r": 30, "s": 33,
    }.items()}
    lock = observed_stat(36)
    installed = observed_stat(42)
    root_members = b"".join(
        f"{NAMESPACE}/{name}".encode("ascii") + b"\0" for name in LAYOUT
    )
    exact_state = (
        len(blocks) == 96 and rc_digest == R21_POST_INSTALL_RC_VECTOR_SHA256
        and namespace[2:] == (40555, 0, 0, 7, 224, 0)
        and all(directories[name][2:] == (40555, 0, 0, 2, 64, 0)
                for name in ("a", "c", "q", "r"))
        and directories["s"][2:] == (40555, 0, 0, 3, 96, 0)
        and lock[2:] == (100600, 0, 0, 1, 0, 0)
        and installed[2:] == (104555, 0, 0, 1, 89392, 0)
        and blocks[70] == (0, root_members)
        and blocks[91] == (0, b"")
        and blocks[94] == (0, f"{NAMESPACE}/s/lock\0".encode("ascii"))
    )
    check(
        exact_state,
        "A_H039_R21_OWNER_ADJUDICATED_R12_POST_INSTALL_WORKFLOW_EVIDENCE",
        {
            "transcript_sha256": sha(transcript), "rc_vector_sha256": rc_digest,
            "namespace": namespace, "directories": directories,
            "lock": lock, "installed": installed,
        },
    )


def r22_installed_snapshot_from_int2(record: Any) -> tuple[Any, ...]:
    if type(record) is not dict:
        raise Rig("R22 INT2 installed snapshot record type mismatch")
    installed = record.get("installed_after")
    if type(installed) is not dict or set(installed) != {
        "acl", "identity", "sha256", "xattrs",
    }:
        raise Rig("R22 INT2 installed snapshot schema mismatch")
    identity = installed.get("identity")
    xattrs = installed.get("xattrs")
    if type(identity) is not list or len(identity) != 10 \
            or any(type(value) is not int for value in identity) \
            or type(xattrs) is not dict or set(xattrs) != {"status", "values"} \
            or xattrs.get("status") != "READ" or xattrs.get("values") != [] \
            or installed.get("acl") is not False \
            or installed.get("sha256") != R20_R12_PRODUCT_BLOBS[
                "verify/h039/runtime-cleanup-mediator"
            ]:
        raise Rig("R22 INT2 installed snapshot value mismatch")
    dev, ino, full_mode, uid, gid, nlink, size, flags, mtime_ns, ctime_ns = identity
    if (
        full_mode != (stat.S_IFREG | 0o4555) or uid != 0 or gid != 0
        or nlink != 1 or size != 89392 or flags != 0
        or mtime_ns < 0 or ctime_ns < 0
    ):
        raise Rig("R22 INT2 installed identity is not exact published R12")
    return (
        stat.S_IFMT(full_mode), stat.S_IMODE(full_mode), uid, gid, dev, ino,
        nlink, size, flags, installed["sha256"], b"", (), False,
    )


def r22_installed_stable_identity_from_int2(record: Any) -> tuple[int, ...]:
    installed = record.get("installed_after") if type(record) is dict else None
    identity = installed.get("identity") if type(installed) is dict else None
    if type(identity) is not list or len(identity) != 10 \
            or any(type(value) is not int for value in identity):
        raise Rig("R22 INT2 full stable identity unavailable")
    dev, ino, full_mode, uid, gid, nlink, size, _flags, mtime_ns, ctime_ns = identity
    expected = (
        dev, ino, stat.S_IFMT(full_mode), uid, gid, stat.S_IMODE(full_mode),
        nlink, size, mtime_ns, ctime_ns,
    )
    if any(value < 0 for value in expected):
        raise Rig("R22 INT2 full stable identity value mismatch")
    return expected


def r22_exact_installed_transition(
    before: Any, after: Any, expected: Any,
) -> bool:
    return (
        type(before) is tuple and type(after) is tuple and type(expected) is tuple
        and len(before) == 13 and len(after) == 13 and len(expected) == 13
        and all(type(value) is int for value in expected[:9])
        and type(expected[9]) is str and type(expected[10]) is bytes
        and type(expected[11]) is tuple and type(expected[12]) is bool
        and before == expected and after == expected
    )


def r22_installed_transition_selftests(expected: tuple[Any, ...]) -> None:
    check(
        r22_exact_installed_transition(expected, expected, expected),
        "A_H039_R22_INSTALLED_R12_EXACT_EVIDENCE_SNAPSHOT_SELFTEST_ANCHOR",
    )
    for label, index, value in (
        ("SAME_BYTES_REPLACED_INODE", 5, expected[5] + 1),
        ("SYMLINK_SUBSTITUTION", 0, stat.S_IFLNK),
        ("MODE_SUBSTITUTION", 1, 0o555),
        ("OWNER_SUBSTITUTION", 2, CLIENT_UID),
        ("HARDLINK_SUBSTITUTION", 6, 2),
        ("SIZE_SUBSTITUTION", 7, expected[7] + 1),
        ("FLAG_SUBSTITUTION", 8, 1),
        ("DIGEST_SUBSTITUTION", 9, "00" * 32),
        ("TARGET_SUBSTITUTION", 10, b"neighbor"),
        ("XATTR_SUBSTITUTION", 11, ((b"user.escape", 1, "00" * 32),)),
        ("ACL_SUBSTITUTION", 12, True),
    ):
        mutant = list(expected)
        mutant[index] = value
        changed = tuple(mutant)
        check(
            not r22_exact_installed_transition(changed, expected, expected)
            and not r22_exact_installed_transition(expected, changed, expected),
            f"N_H039_R22_INSTALLED_{label}",
        )


def r22_open_installed_retained() -> int:
    try:
        return os.open(
            INSTALLED,
            os.O_RDONLY | os.O_CLOEXEC
            | getattr(os, "O_NOFOLLOW_ANY") | 0x00002000,
        )
    except OSError as exc:
        raise Undecidable(f"R22 installed R12 retained open unavailable: {exc}") from exc


def r22_retained_installed_snapshot(
    descriptor: int, expected: tuple[Any, ...], expected_identity: tuple[int, ...],
) -> tuple[Any, ...]:
    try:
        if type(descriptor) is not int or descriptor < 3 \
                or type(expected_identity) is not tuple \
                or len(expected_identity) != 10 \
                or any(type(value) is not int for value in expected_identity):
            raise Rig("R22 installed R12 retained descriptor type mismatch")
        named = os.lstat(INSTALLED)
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode) or opened.st_uid != 0
            or opened.st_gid != 0 or stat.S_IMODE(opened.st_mode) != 0o4555
            or opened.st_nlink != 1 or opened.st_size != expected[7]
            or stable_identity(named) != stable_identity(opened)
            or stable_identity(opened) != expected_identity
        ):
            raise Rig("R22 installed R12 retained identity mismatch")
        if os.lseek(descriptor, 0, os.SEEK_SET) != 0:
            raise Rig("R22 installed R12 retained rewind mismatch")
        chunks: list[bytes] = []
        remaining = opened.st_size
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                raise Rig("R22 installed R12 retained read truncated")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise Rig("R22 installed R12 retained read has trailing byte")
        after = os.fstat(descriptor)
        rebound = os.lstat(INSTALLED)
        if stable_identity(opened) != stable_identity(after) \
                or stable_identity(after) != stable_identity(rebound):
            raise Rig("R22 installed R12 changed or name rebound")
        metadata_before = os.fstat(descriptor); xattrs, has_acl = fd_extended_metadata(descriptor)
        metadata_after = os.fstat(descriptor)
        if stable_identity(metadata_before) != stable_identity(metadata_after):
            raise Rig("R22 installed R12 changed across retained metadata read")
        snapshot = stat_snapshot(metadata_before, sha(b"".join(chunks))) \
            + (xattrs, has_acl)
        require_no_extended_authority(snapshot, f"fd={descriptor}")
        final_fd = os.fstat(descriptor); final_name = os.lstat(INSTALLED)
        if stable_identity(after) != stable_identity(final_fd) \
                or stable_identity(final_fd) != stable_identity(final_name) \
                or stable_identity(final_fd) != expected_identity \
                or not r22_exact_installed_transition(snapshot, snapshot, expected):
            raise Rig("R22 installed R12 evidence-bound snapshot mismatch")
        return snapshot
    except OSError as exc:
        raise Undecidable(f"R22 installed R12 snapshot unavailable: {exc}") from exc


def r22_product_material_with_retained_installed(
    commit: str, expected: tuple[tuple[Any, ...], tuple[int, ...]],
) -> None:
    descriptor = -1
    try:
        expected_snapshot, expected_identity = expected
        descriptor = r22_open_installed_retained()
        if type(descriptor) is not int or descriptor < 3 \
                or fcntl.fcntl(descriptor, fcntl.F_GETFL) & os.O_ACCMODE \
                != os.O_RDONLY \
                or fcntl.fcntl(descriptor, fcntl.F_GETFD) \
                & fcntl.FD_CLOEXEC == 0:
            raise Rig("R22 retained installed descriptor flags mismatch")
        before = r22_retained_installed_snapshot(
            descriptor, expected_snapshot, expected_identity,
        )
        r22_product_material_checks(commit)
        if os.lseek(descriptor, 0, os.SEEK_CUR) != expected_snapshot[7]:
            raise Rig("R22 retained installed offset changed across material review")
        if fcntl.fcntl(descriptor, fcntl.F_GETFL) & os.O_ACCMODE \
                != os.O_RDONLY \
                or fcntl.fcntl(descriptor, fcntl.F_GETFD) \
                & fcntl.FD_CLOEXEC == 0:
            raise Rig("R22 retained installed descriptor changed across material review")
        after = r22_retained_installed_snapshot(
            descriptor, expected_snapshot, expected_identity,
        )
        check(
            r22_exact_installed_transition(before, after, expected_snapshot),
            "A_H039_R22_ONE_RETAINED_INSTALLED_R12_FD_ENCLOSES_MATERIAL_REVIEW",
        )
    finally:
        if descriptor >= 0:
            os.close(descriptor)
            try:
                fcntl.fcntl(descriptor, fcntl.F_GETFD)
            except OSError as exc:
                if exc.errno != errno.EBADF:
                    raise Rig("R22 retained installed post-close errno mismatch") from exc
            else:
                raise Rig("R22 retained installed descriptor remained open")


def r23_product_material_with_retained_installed(
    commit: str, expected: tuple[tuple[Any, ...], tuple[int, ...]],
) -> None:
    descriptor = -1
    try:
        expected_snapshot, expected_identity = expected
        namespace_before = fixed_installation_snapshot(require_clean_metadata=True)
        descriptor = r22_open_installed_retained()
        if type(descriptor) is not int or descriptor < 3 \
                or fcntl.fcntl(descriptor, fcntl.F_GETFL) & os.O_ACCMODE \
                != os.O_RDONLY \
                or fcntl.fcntl(descriptor, fcntl.F_GETFD) \
                & fcntl.FD_CLOEXEC == 0:
            raise Rig("R23 retained old R12 descriptor flags mismatch")
        before = r22_retained_installed_snapshot(
            descriptor, expected_snapshot, expected_identity,
        )
        r23_product_material_checks(commit)
        if os.lseek(descriptor, 0, os.SEEK_CUR) != expected_snapshot[7]:
            raise Rig("R23 retained old R12 offset changed across material review")
        if fcntl.fcntl(descriptor, fcntl.F_GETFL) & os.O_ACCMODE \
                != os.O_RDONLY \
                or fcntl.fcntl(descriptor, fcntl.F_GETFD) \
                & fcntl.FD_CLOEXEC == 0:
            raise Rig("R23 retained old R12 descriptor changed across material review")
        after = r22_retained_installed_snapshot(
            descriptor, expected_snapshot, expected_identity,
        )
        namespace_after = fixed_installation_snapshot(require_clean_metadata=True)
        check(
            r22_exact_installed_transition(before, after, expected_snapshot)
            and exact_typed_tree(namespace_after, namespace_before),
            "A_H039_R23_ONE_RETAINED_OLD_R12_FD_AND_NAMESPACE_ENCLOSE_MATERIAL_REVIEW",
        )
    finally:
        if descriptor >= 0:
            os.close(descriptor)
            try:
                fcntl.fcntl(descriptor, fcntl.F_GETFD)
            except OSError as exc:
                if exc.errno != errno.EBADF:
                    raise Rig("R23 retained old R12 post-close errno mismatch") from exc
            else:
                raise Rig("R23 retained old R12 descriptor remained open")


def r22_int2_evidence_checks() \
        -> tuple[tuple[Any, ...], tuple[int, ...]]:
    raw = b""
    try:
            named = os.lstat(R22_INT2_EVIDENCE)
            descriptor = os.open(
                R22_INT2_EVIDENCE,
                os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
                | getattr(os, "O_NOFOLLOW_ANY") | 0x00002000,
            )
    except OSError as exc:
        raise Undecidable(f"R22 fixed INT2 evidence unavailable: {exc}") from exc
    try:
            opened = os.fstat(descriptor)
            if not (
                stat.S_ISREG(opened.st_mode) and opened.st_uid == CLIENT_UID
                and opened.st_gid == CLIENT_GID
                and stat.S_IMODE(opened.st_mode) == 0o600
                and opened.st_nlink == 1 and opened.st_size == R22_INT2_EVIDENCE_SIZE
                and stable_identity(named) == stable_identity(opened)
            ):
                raise Rig("R22 fixed INT2 evidence identity mismatch")
            chunks: list[bytes] = []
            remaining = opened.st_size
            while remaining:
                chunk = os.read(descriptor, min(65536, remaining))
                if not chunk:
                    raise Rig("R22 fixed INT2 evidence short read")
                chunks.append(chunk)
                remaining -= len(chunk)
            if os.read(descriptor, 1):
                raise Rig("R22 fixed INT2 evidence trailing byte")
            raw = b"".join(chunks)
            after = os.fstat(descriptor)
            rebound = os.lstat(R22_INT2_EVIDENCE)
            if stable_identity(opened) != stable_identity(after) \
                    or stable_identity(after) != stable_identity(rebound) \
                    or sha(raw) != R22_INT2_EVIDENCE_SHA256:
                raise Rig("R22 fixed INT2 evidence changed or rebound")
    finally:
        os.close(descriptor)
    record = strict_json(raw)
    installed_snapshot = r22_installed_snapshot_from_int2(record)
    installed_identity = r22_installed_stable_identity_from_int2(record)
    r22_installed_transition_selftests(installed_snapshot)
    request = record.get("request", {}) if type(record) is dict else {}
    protocol = record.get("protocol", {}) if type(record) is dict else {}
    empty_sha = sha(b"")
    ok = (
        type(record) is dict and record.get("schema_version") == 1
        and record.get("record_type")
        == "h039_r21_int2_zero_effect_protocol_observation"
        and record.get("authority")
        == "OWNER_AUTHORIZED_WORKFLOW_ONLY_ONE_SHOT_ZERO_EFFECT"
        and record.get("published_r21_contract_merge") == R22_AUTHORITY_BASE
        and record.get("published_r12_product_merge") == R20_AUTHORITY_BASE
        and record.get("classification") == "NO_RESPONSE_EXIT_1_ZERO_EFFECT"
        and record.get("uid") == CLIENT_UID and record.get("gid") == CLIENT_GID
        and record.get("installed_path") == str(INSTALLED)
        and record.get("installed_before") == record.get("installed_after")
        and record.get("namespace_before") == record.get("namespace_after")
        and record.get("retry_permitted") is False
        and record.get("cleanup_permitted") is False
        and record.get("downstream_progress_permitted") is False
        and record.get("workflow_report_only") is True
        and record.get("task_credit") is False
        and record.get("mandatory_next_state") == "OWNER_ADJUDICATION_STOP"
        and type(request) is dict and request.get("fixed_nonce") == R22_INT2_NONCE
        and request.get("body_size") == 127
        and request.get("body_sha256") == R22_INT2_REQUEST_SHA256
        and request.get("wire_size") == 131
        and request.get("wire_sha256") == R22_INT2_WIRE_SHA256
        and type(protocol) is dict and protocol.get("returncode") == 1
        and protocol.get("exit_status") == 1 and protocol.get("signal") is None
        and protocol.get("wait_timeout") is False
        and protocol.get("response_wire_size") == 0
        and protocol.get("response_wire_sha256") == empty_sha
        and protocol.get("stdout_size") == 0 and protocol.get("stdout_sha256") == empty_sha
        and protocol.get("stderr_size") == 0 and protocol.get("stderr_sha256") == empty_sha
        and protocol.get("ancillary_fd_count") == 0
        and protocol.get("ancillary_fds") == []
        and protocol.get("ancillary_messages") == []
    )
    check(ok, "A_H039_R22_CONSUMED_INT2_EXIT1_NO_RESPONSE_ZERO_EFFECT_NO_RETRY", {
        "sha256": sha(raw), "size": len(raw),
        "classification": record.get("classification") if type(record) is dict else None,
    })
    if not ok:
        raise Rig("R22 consumed INT2 evidence drift")
    return installed_snapshot, installed_identity


def r23_open_lifecycle_retained(label: str) -> tuple[int, bytes, tuple[int, ...]]:
    if label not in R23_R22_EVIDENCE:
        raise Rig("R23 lifecycle evidence request is not frozen")
    path, expected_digest = R23_R22_EVIDENCE[label]
    descriptor = -1
    try:
        named = os.lstat(path)
        descriptor = os.open(
            path,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
            | getattr(os, "O_NOFOLLOW_ANY") | 0x00002000,
        )
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != CLIENT_UID or opened.st_gid != CLIENT_GID
            or stat.S_IMODE(opened.st_mode) not in {0o600, 0o644}
            or opened.st_nlink != 1 or opened.st_size > 16777216
            or stable_identity(named) != stable_identity(opened)
        ):
            raise Rig(f"R23 {label} evidence identity mismatch")
        chunks: list[bytes] = []
        remaining = opened.st_size
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                raise Rig(f"R23 {label} evidence short read")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise Rig(f"R23 {label} evidence trailing byte")
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        rebound = os.lstat(path)
        if (
            stable_identity(opened) != stable_identity(after)
            or stable_identity(after) != stable_identity(rebound)
            or len(raw) != after.st_size or sha(raw) != expected_digest
        ):
            raise Rig(f"R23 {label} evidence changed or rebound")
        retained = stable_identity(after)
        result = descriptor, raw, retained
        descriptor = -1
        return result
    except OSError as exc:
        raise Undecidable(f"R23 fixed lifecycle evidence unavailable: {path}") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def r23_stable_lifecycle_bytes(label: str) -> bytes:
    descriptor, raw, _identity = r23_open_lifecycle_retained(label)
    try:
        return raw
    finally:
        os.close(descriptor)


def r23_r22_dynamic_chain_accepts(
    source_binding: Any, identities: dict[str, str],
    stdout_lines: set[str], expected_lines: set[str],
) -> bool:
    tools = source_binding.get("workflow_tools", {}) \
        if type(source_binding) is dict else {}
    compatibility = source_binding.get("compatibility_refreeze", {}) \
        if type(source_binding) is dict else {}
    return (
        type(source_binding) is dict
        and source_binding.get("schema_version") == 1
        and source_binding.get("record_type")
        == "h039_r22_r13_workflow_diagnostic_compat_source_binding_r2"
        and source_binding.get("published_product", {}).get("merge")
        == R23_AUTHORITY_BASE
        and compatibility.get("outcome")
        == "h039-r22-r13-diagnostic-run-result.json"
        and compatibility.get("final_validator")
        == "h039-r22-r13-diagnostic-final-validate-r2.py"
        and tools.get("h039-r22-r13-diagnostic-final-validate-r2.py")
        == R23_R22_FINAL_VALIDATOR_SHA256
        and tools.get("h039-r22-r13-diagnostic-cleanup.py")
        == "e6f5137b62f51220f237dc2abb8fa0b1687307d318b2f2a9b517b164bdbd2eff"
        and identities == {
            "source_binding": R23_R22_SOURCE_BINDING_SHA256,
            "validator": R23_R22_FINAL_VALIDATOR_SHA256,
            "outcome": R23_R22_OUTCOME_SHA256,
            "cleanup": R23_R22_CLEANUP_SHA256,
        }
        and expected_lines <= stdout_lines
    )


def r23_r22_lifecycle_evidence_checks() -> None:
    raw = {
        label: r23_stable_lifecycle_bytes(label)
        for label in R23_R22_EVIDENCE
        if label != "final_validator"
    }
    outcome = strict_json(raw["outcome"])
    post_run = strict_json(raw["post_run"])
    cleanup = strict_json(raw["cleanup"])
    final_absent = strict_json(raw["final_absent"])
    source_binding = strict_json(raw["source_binding"])
    empty_digest = sha(b"")
    protocol = outcome.get("protocol", {}) if type(outcome) is dict else {}
    check(
        type(outcome) is dict
        and outcome.get("schema_version") == 1
        and type(outcome.get("schema_version")) is int
        and outcome.get("record_type")
        == "h039_r22_r13_one_shot_prestore_diagnostic_observation"
        and outcome.get("published_r13_merge") == R23_AUTHORITY_BASE
        and outcome.get("classification") == "STATUS_28_ZERO_EFFECT_OWNER_STOP"
        and outcome.get("diagnostic_spawn_count") == 1
        and type(outcome.get("diagnostic_spawn_count")) is int
        and outcome.get("zero_effect") is True
        and outcome.get("retry_permitted") is False
        and outcome.get("downstream_progress_permitted") is False
        and outcome.get("workflow_report_only") is True
        and outcome.get("task_credit") is False
        and outcome.get("namespace_before") == outcome.get("namespace_after")
        and outcome.get("production_before") == outcome.get("production_after")
        and outcome.get("diagnostic_before") == outcome.get("diagnostic_after")
        and type(protocol) is dict
        and protocol.get("wait_status_raw") == 7168
        and protocol.get("exit_status") == 28
        and protocol.get("signal") is None
        and protocol.get("spawn_error") is None
        and protocol.get("send_error") is None
        and protocol.get("receive_error") is None
        and protocol.get("response_wire_size") == 0
        and protocol.get("response_wire_sha256") == empty_digest
        and protocol.get("stdout_size") == 0
        and protocol.get("stdout_sha256") == empty_digest
        and protocol.get("stderr_size") == 0
        and protocol.get("stderr_sha256") == empty_digest
        and protocol.get("ancillary_fd_count") == 0
        and protocol.get("ancillary_fds") == []
        and protocol.get("ancillary_messages") == [],
        "A_H039_R23_OWNER_ADJUDICATED_R22_STATUS28_ZERO_EFFECT_OUTCOME",
        {"sha256": sha(raw["outcome"]), "status": protocol.get("exit_status")},
    )
    check(
        all(
            type(value) is dict
            and value.get("schema_version") == 1
            and value.get("published_r13_merge") == R23_AUTHORITY_BASE
            and value.get("workflow_report_only") is True
            and value.get("task_credit") is False
            for value in (post_run, final_absent)
        )
        and post_run.get("record_type")
        == "h039_r22_r13_fixed_root_read_only_observation"
        and post_run.get("phase") == "post-run-04555"
        and post_run.get("classification") == "EXPECTED_PHASE_SHAPE"
        and post_run.get("command_count") == 109
        and post_run.get("read_only") is True
        and final_absent.get("record_type")
        == "h039_r22_r13_fixed_root_read_only_observation"
        and final_absent.get("phase") == "final-absent"
        and final_absent.get("classification") == "EXPECTED_PHASE_SHAPE"
        and final_absent.get("command_count") == 109
        and final_absent.get("read_only") is True,
        "A_H039_R23_R22_POST_RUN_AND_FINAL_ABSENT_ROOT_OBSERVATIONS",
    )
    production = cleanup.get("production_after", {}) \
        if type(cleanup) is dict else {}
    check(
        type(cleanup) is dict and cleanup.get("schema_version") == 1
        and cleanup.get("record_type")
        == "h039_r22_r13_fixed_diagnostic_cleanup_result"
        and cleanup.get("published_r13_merge") == R23_AUTHORITY_BASE
        and cleanup.get("observed_diagnostic_status") == 28
        and cleanup.get("observed_wait_status_raw") == 7168
        and cleanup.get("outcome_classification")
        == "STATUS_28_ZERO_EFFECT_OWNER_STOP"
        and cleanup.get("run_outcome_sha256") == R23_R22_OUTCOME_SHA256
        and cleanup.get("post_run_observation_sha256") == R23_R22_POST_RUN_SHA256
        and cleanup.get("production_before") == cleanup.get("production_after")
        and type(production) is dict
        and production.get("sha256") == R23_OLD_R12_MEDIATOR_SHA256
        and type(production.get("identity")) is list
        and len(production["identity"]) >= 7
        and production["identity"][5:7]
        == [1, R23_OLD_R12_MEDIATOR_SIZE]
        and cleanup.get("fixed_name_absent") is True
        and cleanup.get("retained_nlink_after_remove") == 0
        and cleanup.get("retry_permitted") is False
        and cleanup.get("rollback_permitted") is False
        and cleanup.get("workflow_report_only") is True
        and cleanup.get("task_credit") is False,
        "A_H039_R23_R22_EXACT_FIXED_DIAGNOSTIC_CLEANUP_AND_R12_CONTINUITY",
    )
    expected_lines = {
        "LIFECYCLE_EVIDENCE_VALIDATION=PASS",
        f"PUBLISHED_R13_MERGE={R23_AUTHORITY_BASE}",
        f"SOURCE_BINDING_SHA256={R23_R22_SOURCE_BINDING_SHA256}",
        f"RUN_OUTCOME_SHA256={R23_R22_OUTCOME_SHA256}",
        "OBSERVED_DIAGNOSTIC_STATUS=28",
        f"ROOT_OBSERVATION_POST_RUN_04555_SHA256={R23_R22_POST_RUN_SHA256}",
        f"ROOT_OBSERVATION_FINAL_ABSENT_SHA256={R23_R22_FINAL_ABSENT_SHA256}",
        f"CLEANUP_REPORT_SHA256={R23_R22_CLEANUP_SHA256}",
        "DIAGNOSTIC_NAME_ABSENT=YES",
        "PRODUCTION_MEDIATOR_UNCHANGED=YES",
        "WORKFLOW_REPORT_ONLY=YES",
        "TASK_CREDIT=NONE",
        "STOP_FOR_OWNER_ADJUDICATION=YES",
    }
    validator_fd, validator_raw, validator_identity = \
        r23_open_lifecycle_retained("final_validator")
    run: subprocess.CompletedProcess[bytes] | None = None
    try:
        identities = {
            "source_binding": sha(raw["source_binding"]),
            "validator": sha(validator_raw),
            "outcome": sha(raw["outcome"]),
            "cleanup": sha(raw["cleanup"]),
        }
        source_ok = (
            validator_raw.count(b"LIFECYCLE_EVIDENCE_VALIDATION=PASS") == 1
            and r23_r22_dynamic_chain_accepts(
                source_binding, identities, expected_lines, expected_lines,
            )
        )
        check(
            source_ok,
            "A_H039_R23_R22_FROZEN_LIFECYCLE_VALIDATOR_AND_SOURCE_BINDING",
        )
        mutations: list[tuple[Any, dict[str, str], set[str]]] = []
        for label in identities:
            wrong = dict(identities); wrong[label] = "00" * 32
            missing = dict(identities); del missing[label]
            other = next(item for item in identities if item != label)
            crossed = dict(identities); crossed[label] = identities[other]
            mutations.extend(((source_binding, wrong, expected_lines),
                              (source_binding, missing, expected_lines),
                              (source_binding, crossed, expected_lines)))
        binding_wrong = copy.deepcopy(source_binding)
        binding_wrong["workflow_tools"][
            "h039-r22-r13-diagnostic-final-validate-r2.py"
        ] = "00" * 32
        mutations.append((binding_wrong, identities, expected_lines))
        mutations.extend(
            (source_binding, identities, expected_lines - {line})
            for line in expected_lines
        )
        if any(r23_r22_dynamic_chain_accepts(binding, identity, lines,
                                              expected_lines)
               for binding, identity, lines in mutations):
            raise Rig("R23 dynamic lifecycle mutant accepted")
        command = [
            "/Library/Developer/CommandLineTools/usr/bin/python3", "-I", "-S",
            "-",
        ]
        run = subprocess.run(
            command, cwd="/", input=validator_raw,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
            timeout=30, env={},
        )
        stdout_lines = set(run.stdout.decode("utf-8", "strict").splitlines())
        after = os.fstat(validator_fd)
        rebound = os.lstat(R23_R22_EVIDENCE["final_validator"][0])
        check(
            run.returncode == 0 and run.stderr == b""
            and stable_identity(after) == validator_identity
            and stable_identity(rebound) == validator_identity
            and r23_r22_dynamic_chain_accepts(
                source_binding, identities, stdout_lines, expected_lines,
            ),
            "A_H039_R23_R22_FROZEN_FINAL_VALIDATOR_EXECUTION_PASS",
            {"returncode": run.returncode, "stdout_sha256": sha(run.stdout)},
        )
    finally:
        os.close(validator_fd)
        try:
            fcntl.fcntl(validator_fd, fcntl.F_GETFD)
        except OSError as exc:
            if exc.errno != errno.EBADF:
                raise
        else:
            raise Rig("R23 retained lifecycle validator descriptor remained open")


def r19_cursor_harness_source(
    function: bytes, *, substitution: bool = False, post_race: bool = False,
) -> bytes:
    if substitution and post_race:
        raise Rig("R19 harness mode conflict")
    prefix = r'''#define _DARWIN_C_SOURCE 1
#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>

static int same_stat(const struct stat*a,const struct stat*b){return a->st_dev==b->st_dev&&a->st_ino==b->st_ino&&a->st_mode==b->st_mode&&a->st_uid==b->st_uid&&a->st_gid==b->st_gid&&a->st_nlink==b->st_nlink&&a->st_size==b->st_size&&a->st_mtimespec.tv_sec==b->st_mtimespec.tv_sec&&a->st_mtimespec.tv_nsec==b->st_mtimespec.tv_nsec&&a->st_ctimespec.tv_sec==b->st_ctimespec.tv_sec&&a->st_ctimespec.tv_nsec==b->st_ctimespec.tv_nsec;}
static int decoy_fd=-1,race_fd=-1,fstat_calls=0;
static int intercepted_openat(int directory,const char*name,int flags,...){(void)directory;(void)flags;if(strcmp(name,".")){errno=EINVAL;return -1;}return fcntl(decoy_fd,F_DUPFD_CLOEXEC,3);}
static int intercepted_fstat(int fd,struct stat*out){int result=fstat(fd,out);fstat_calls++;if(!result&&fstat_calls==2&&race_fd>=0&&fchmod(race_fd,0701))return -1;return result;}
'''.encode("utf-8")
    if substitution:
        prefix += b"#define openat intercepted_openat\n"
    if post_race:
        prefix += b"#define fstat intercepted_fstat\n"
    suffix = b"\n"
    if substitution:
        suffix += b"#undef openat\n"
    if post_race:
        suffix += b"#undef fstat\n"
    suffix += r'''
static int make_dir(int parent,const char*name){if(mkdirat(parent,name,0700))return -1;return openat(parent,name,O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);}
static int normal_case(int root){
  int base=make_dir(root,"base");if(base<0)return 10;
  const char*all[]={".install","a","c","q","r","s"};
  if(mkdirat(base,".install",0700)||!exact_names(base,all,6,1U))return 11;
  for(size_t i=1;i<6;i++)if(mkdirat(base,all[i],0700))return 12;
  if(!exact_names(base,all,6,63U))return 13;
  if(!exact_names(base,all,6,63U))return 14;
  int shared=dup(base);if(shared<0)return 15;DIR*stream=fdopendir(shared);if(!stream){close(shared);return 16;}int count=0;struct dirent*entry;errno=0;while((entry=readdir(stream))!=NULL)if(strcmp(entry->d_name,".")&&strcmp(entry->d_name,".."))count++;if(errno||closedir(stream)||count!=6)return 17;
  int missing=make_dir(root,"missing");if(missing<0||mkdirat(missing,"a",0700))return 18;const char*five[]={"a","c","q","r","s"};if(exact_names(missing,five,5,31U))return 19;
  int unexpected=make_dir(root,"unexpected");if(unexpected<0||mkdirat(unexpected,"a",0700)||mkdirat(unexpected,"x",0700))return 20;if(exact_names(unexpected,five,5,1U))return 21;
  close(unexpected);close(missing);close(base);return 0;
}
static int substitution_case(int root){
  int base=make_dir(root,"subject"),decoy=make_dir(root,"decoy");if(base<0||decoy<0)return 30;if(mkdirat(base,".install",0700)||mkdirat(decoy,".install",0700))return 31;decoy_fd=decoy;const char*names[]={".install"};int accepted=exact_names(base,names,1,1U);close(decoy);close(base);return accepted?32:0;
}
static int post_race_case(int root){
  int base=make_dir(root,"race");if(base<0||mkdirat(base,".install",0700))return 40;race_fd=base;fstat_calls=0;const char*names[]={".install"};int accepted=exact_names(base,names,1,1U);close(base);return accepted?42:0;
}
int main(int argc,char**argv){if(argc!=3)return 50;int root=open(argv[1],O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY);if(root<0)return 51;int result=!strcmp(argv[2],"normal")?normal_case(root):!strcmp(argv[2],"substitution")?substitution_case(root):!strcmp(argv[2],"post-race")?post_race_case(root):52;close(root);return result;}
'''.encode("utf-8")
    return prefix + function + suffix


def r19_run_cursor_harness(
    function: bytes, mode: str, *, substitution: bool = False,
    post_race: bool = False,
) -> tuple[int, bytes, bytes]:
    recipe = strict_json(r18_expected_production_recipe())
    compiler = Path(recipe.get("compiler_path", ""))
    if (
        not compiler.is_absolute()
        or path_sha(compiler) != recipe.get("compiler_sha256")
    ):
        raise Undecidable("R19 pinned compiler identity drift")
    temporary = Path(tempfile.mkdtemp(prefix="h039-r19-cursor-", dir="/private/tmp"))
    project = temporary / "project"
    test_root = project / "test-root"
    try:
        project.mkdir(mode=0o700)
        test_root.mkdir(mode=0o700)
        source = project / "cursor.c"
        executable = project / "cursor"
        source.write_bytes(r19_cursor_harness_source(
            function, substitution=substitution, post_race=post_race,
        ))
        environment = {
            "HOME": "/var/empty", "TMPDIR": str(project),
            "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin",
        }
        compile_result = bounded_run([
            str(SANDBOX_EXEC),
            "-D", f"H039_BUILD_EXECUTABLE={compiler}",
            "-D", f"H039_BUILD_ROOT={project}",
            "-p", BUILD_REVIEW_PROFILE,
            str(compiler), "-std=c11", "-O2", "-fstack-protector-strong",
            "-D_FORTIFY_SOURCE=2", "-arch", "arm64", "-isysroot",
            str(recipe.get("sdk_path", "")), "-mmacosx-version-min=15.0",
            "-Wl,-pie", "-Wl,-dead_strip", str(source), "-o", str(executable),
        ], cwd=project, env=environment, timeout=60)
        if compile_result.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in compile_result.stderr:
            raise Undecidable("outer Seatbelt denied R19 cursor harness")
        if compile_result.returncode != 0:
            raise Rig(
                f"R19 cursor harness compile failed rc={compile_result.returncode} "
                f"stderr={compile_result.stderr!r}"
            )
        run_result = bounded_run([
            str(SANDBOX_EXEC),
            "-D", f"H039_EXECUTABLE={executable}",
            "-D", f"H039_TEST_ROOT={test_root}",
            "-p", R19_CURSOR_REVIEW_PROFILE,
            str(executable), str(test_root), mode,
        ], cwd=project, env=environment, timeout=20)
        return run_result.returncode, run_result.stdout, run_result.stderr
    finally:
        shutil.rmtree(temporary)


def r19_cursor_causal_checks(raw: bytes) -> None:
    if not r19_production_source_valid(raw):
        raise Rig("R19 causal source is not exact")
    corrected = R19_CORRECTED_EXACT_NAMES.encode("utf-8")
    old = R19_OLD_EXACT_NAMES.encode("utf-8")
    missing_scan = corrected.replace(
        b"if(fstat(scan,&scan_identity)||"
        b"!same_stat(&original_before,&scan_identity))",
        b"if(fstat(scan,&scan_identity))", 1,
    )
    missing_post = corrected.replace(
        b"if(fstat(directory,&original_after)||"
        b"!same_stat(&original_before,&original_after))ok=0;",
        b"(void)original_after;", 1,
    )
    wrong_dot = corrected.replace(
        b'openat(directory,"."', b'openat(directory,".."', 1,
    )
    cases = (
        ("CORRECTED_REPEAT_AND_CURSOR", corrected, "normal", False, False, 0),
        ("OLD_DUP_SHARED_CURSOR", old, "normal", False, False, 13),
        ("CORRECTED_FOREIGN_SUBSTITUTION", corrected, "substitution", True, False, 0),
        ("MISSING_SCAN_ACCEPTS_FOREIGN", missing_scan, "substitution", True, False, 32),
        ("CORRECTED_POST_CHANGE", corrected, "post-race", False, True, 0),
        ("MISSING_POST_ACCEPTS_CHANGE", missing_post, "post-race", False, True, 42),
        ("WRONG_DOT_REJECTS_SUBJECT", wrong_dot, "normal", False, False, 11),
    )
    detail: dict[str, Any] = {}
    for label, function, mode, substitution, post_race, expected_rc in cases:
        rc, stdout, stderr = r19_run_cursor_harness(
            function, mode, substitution=substitution, post_race=post_race,
        )
        detail[label] = {"rc": rc, "stdout": len(stdout), "stderr": len(stderr)}
        if rc != expected_rc or stdout or stderr:
            raise Rig(f"R19 cursor causal case failed: {label} {detail[label]}")
    check(
        True,
        "A_H039_R19_EXECUTED_CURSOR_INDEPENDENCE_AND_IDENTITY_CAUSAL_MATRIX",
        detail,
    )


def r18_selected_production_source(raw: bytes) -> bytes:
    start_marker = b"#if defined(H039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC)\n"
    production_marker = b"#else\nstatic int installer_bootstrap(int argc,char **argv){"
    end_marker = b"#endif\n#endif\n\nint main(int argc,char **argv){"
    if (
        raw.count(start_marker) != 1
        or raw.count(production_marker) != 1
        or raw.count(end_marker) != 1
    ):
        raise Rig("R18 diagnostic-wrapper production-selection anchors drift")
    start = raw.index(start_marker)
    production = raw.index(production_marker, start)
    end = raw.index(end_marker, production)
    effective = (
        raw[:start]
        + raw[production + len(b"#else\n"):end]
        + raw[end + len(b"#endif\n"):]
    )
    return effective


def r18_effective_production_source(raw: bytes) -> bytes:
    effective = r18_selected_production_source(raw)
    historical = blob(
        PUBLISHED_H039_R8_PRODUCT_MERGE,
        "controller/runtime-cleanup/native/mediator.c",
    )
    expected = historical
    for old_text, corrected_text in zip(
        R18_OLD_PREDICATES, R18_CORRECTED_PREDICATES, strict=True,
    ):
        old = old_text.encode("utf-8")
        new = corrected_text.encode("utf-8")
        if expected.count(old) != 1 or expected.count(new) != 0:
            raise Rig("R18 effective R8 production anchor drift")
        expected = expected.replace(old, new, 1)
    if (
        len(expected) != 98750
        or sha(expected)
        != "ace7910829a9f6c5a6793822fa504c8ef841ce78bf9b36168dd2323b67eba2ce"
        or effective != expected
    ):
        raise Rig("R18 selected production source is not exact R8 plus four negations")
    return effective


def r18_target_negation_shape(raw: bytes) -> bytes:
    effective = r18_selected_production_source(raw)
    shaped = effective.decode("utf-8")
    for index, corrected in enumerate(R18_CORRECTED_PREDICATES):
        prefix, suffix = corrected.split("!flush_dir", 1)
        pattern = re.escape(prefix) + r"!*flush_dir" + re.escape(suffix)
        matches = list(re.finditer(pattern, shaped))
        if len(matches) != 1:
            raise Rig("R18 target-negation shape anchor absent or duplicated")
        shaped = re.sub(
            pattern,
            prefix + f"R18_TARGET_NEGATION_{index}_flush_dir" + suffix,
            shaped,
            count=1,
        )
    return shaped.encode("utf-8")


def r18_observed_flush_site_registry(
    raw: bytes,
) -> list[tuple[str, str, bool]]:
    source = c_semantic_source(
        r18_selected_production_source(raw).decode("utf-8")
    )
    function_order: list[str] = []
    for row in R18_FLUSH_SITE_REGISTRY:
        function = row[1]
        if not function_order or function_order[-1] != function:
            function_order.append(function)
    observed: list[tuple[str, str, bool]] = []
    for function in function_order:
        body = c_function_body(source, function)
        for match in re.finditer(
            r"(?P<negation>!?)flush_dir\((?P<argument>[A-Za-z_][A-Za-z0-9_]*)\)",
            body,
        ):
            observed.append((
                function, match.group("argument"), match.group("negation") == "!",
            ))
    return observed


def r18_production_flush_valid(raw: bytes, *, exact_image: bool) -> bool:
    try:
        expected = r18_expected_production_source()
        if exact_image and raw != expected:
            return False
        if not exact_image and (
            r18_target_negation_shape(raw)
            != r18_target_negation_shape(expected)
        ):
            return False
        effective_raw = (
            r18_effective_production_source(raw) if exact_image
            else r18_selected_production_source(raw)
        )
        source = c_semantic_source(effective_raw.decode("utf-8"))
        if source.count("static int flush_dir(int fd){return fsync(fd)==0;}") != 1:
            return False
        names = [
            "durable_fixed_dir_at", "validate_bootstrap_staging",
            "exact_regular_bytes", "ensure_lock", "stage_embedded_mediator",
            "publish_staged_mediator", "directory_prefix",
            "remove_fixed_staging", "apply_install",
        ]
        bodies = "\n".join(c_function_body(source, name) for name in names)
        if bodies.count("flush_dir(") != 21:
            return False
        if any(bodies.count(old) != 0 for old in R18_OLD_PREDICATES):
            return False
        if any(bodies.count(new) != 1 for new in R18_CORRECTED_PREDICATES):
            return False
        observed_sites = r18_observed_flush_site_registry(raw)
        if len(observed_sites) != len(R18_FLUSH_SITE_REGISTRY):
            return False
        for row, expected_argument, observed in zip(
            R18_FLUSH_SITE_REGISTRY, R18_FLUSH_SITE_ARGUMENTS,
            observed_sites, strict=True,
        ):
            if (
                observed[0] != row[1]
                or observed[1] != expected_argument
                or observed[2] != (row[3] == "FAILURE_OR_NEGATED")
            ):
                return False
        if "H039_DIAG_" in source or "ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC" in source:
            return False
        bootstrap = c_structure_mask(c_function_body(source, "installer_bootstrap"))
        installer_raw = c_function_body(source, "installer_main")
        installer = c_structure_mask(installer_raw)
        if "apply_install(project,mediator,mediator_n)" not in bootstrap:
            return False
        if (
            installer_raw.count('"verify"') != 1
            or installer_raw.count('"bootstrap"') != 1
            or "installer_bootstrap(argc,argv)" not in installer
        ):
            return False
        recipe = r18_expected_production_recipe()
        recipe_value = strict_json(recipe)
        compile_argv = recipe_value.get("installer_compile_argv")
        if (
            type(compile_argv) is not list
            or "-DH039_ROOT_BOOTSTRAP_EXIT_DIAGNOSTIC=1" in compile_argv
            or "-Wno-unused-function" in compile_argv
            or "-DH039_INSTALLER=1" not in compile_argv
        ):
            return False
        return True
    except (Rig, UnicodeError, ValueError, TypeError):
        return False


def r18_causal_expressions(raw: bytes) -> list[str]:
    source = c_semantic_source(
        r18_selected_production_source(raw).decode("utf-8")
    )
    targets = (
        ("apply_install", "database-pre-effect", 3),
        ("stage_embedded_mediator", "project-full-0400", 0),
        ("directory_prefix", "state-existing-lock", 1),
        ("remove_fixed_staging", "runtime-pre-unlink", 2),
    )
    if [
        (fixture[1], fixture[2]) for fixture in R18_CAUSAL_FIXTURES
    ] != [(function, site) for function, site, _index in targets]:
        raise Rig("R18 causal fixture registry is disconnected from target map")
    expressions: list[str] = []
    for function, _site, predicate_index in targets:
        body = c_function_body(source, function)
        corrected = R18_CORRECTED_PREDICATES[predicate_index]
        prefix, suffix = corrected.split("!flush_dir", 1)
        pattern = (
            re.escape(prefix) + r"(?P<negations>!*)flush_dir" + re.escape(suffix)
        )
        matches = list(re.finditer(pattern, body))
        if len(matches) != 1:
            raise Rig(f"R18 causal predicate absent or duplicated in {function}")
        expressions.append(matches[0].group(0))
    return expressions


def r18_causal_harness_source(expressions: list[str]) -> bytes:
    if not expressions or any(
        type(expression) is not str
        or not expression
        or "\n" in expression
        or "\r" in expression
        for expression in expressions
    ):
        raise Rig("R18 causal harness expression type drift")
    declarations = (
        "int db=3,ns=4,after=0;",
        "int fd=3,project=4,ready=0;",
        "int lock_fd=3,fd=4,after=0;",
        "int self=3,runtime=4,after=0;",
    )
    if len(expressions) != len(declarations) * 3:
        raise Rig("R18 causal harness target cardinality drift")
    evaluators = []
    cases = []
    for index, expression in enumerate(expressions):
        target_index = index if index < len(declarations) \
            else (index - len(declarations)) // 2
        declaration = declarations[target_index]
        evaluators.append(
            f"static int eval_{index}(void){{{declaration}return ({expression});}}"
        )
        cases.append(f"case {index}: result=eval_{index}(); break;")
    return (
        "#define fchmod(a,b) ((void)(a),(void)(b),0)\n"
        "#define fsync(a) ((void)(a),0)\n"
        "#define fstat(a,b) ((void)(a),(void)(b),next_calls++,0)\n"
        "static int flush_rc;\n"
        "static int next_calls;\n"
        "static int flush_dir(int fd){(void)fd;return flush_rc==0;}\n"
        + "\n".join(evaluators)
        + "\nstatic int decimal(const char *value){int out=0;if(!value||!*value)return -1;"
          "for(;*value;value++){if(*value<'0'||*value>'9')return -1;"
          "out=out*10+(*value-'0');if(out>999)return -1;}return out;}\n"
          "int main(int argc,char **argv){int fixture,result=-1,success;"
          "if(argc!=3)return 121;fixture=decimal(argv[1]);"
          "if(fixture<0)return 122;"
          "if(argv[2][0]=='0'&&argv[2][1]=='\\0')flush_rc=0;"
          "else if(argv[2][0]=='1'&&argv[2][1]=='\\0')flush_rc=-1;"
          "else return 123;next_calls=0;switch(fixture){"
        + "".join(cases)
        + "default:return 124;}success=flush_rc==0;"
          "return ((success&&result==0&&next_calls==1)||"
          "(!success&&result!=0&&next_calls==0))?0:120;}\n"
    ).encode("utf-8")


def r18_full_path_harness_source(raw: bytes, expressions: list[str]) -> bytes:
    source = c_semantic_source(
        r18_selected_production_source(raw).decode("utf-8")
    )
    targets = (
        ("apply_install", "int project,const unsigned char *mediator,size_t mediator_n"),
        ("stage_embedded_mediator", "int project,const unsigned char*raw,size_t n"),
        ("directory_prefix", "int ns,int *prefix,int *has_lock"),
        ("remove_fixed_staging", "int project"),
    )
    if len(expressions) != len(targets):
        raise Rig("R18 full-path target cardinality drift")
    bodies = [c_function_body(source, name) for name, _signature in targets]
    variants: list[tuple[int, str]] = []
    for target_index, (body, expression) in enumerate(zip(
        bodies, expressions, strict=True,
    )):
        if body.count(expression) != 1 or expression.count("!flush_dir") != 1:
            raise Rig("R18 full-path predicate is not unique in owning function")
        variants.append((target_index, body))
    for target_index, (body, expression) in enumerate(zip(
        bodies, expressions, strict=True,
    )):
        variants.extend((
            (target_index, body.replace(
                expression, expression.replace("!flush_dir", "flush_dir", 1), 1,
            )),
            (target_index, body.replace(
                expression, expression.replace("!flush_dir", "!!flush_dir", 1), 1,
            )),
        ))
    definitions: list[str] = []
    cases: list[str] = []
    for variant_index, (target_index, body) in enumerate(variants):
        signature = targets[target_index][1]
        definitions.append(
            f"static int r18_path_{variant_index}({signature}){{{body}}}"
        )
        if target_index == 0:
            call = f"r18_path_{variant_index}(4,bytes,1)"
        elif target_index == 1:
            call = f"r18_path_{variant_index}(4,bytes,1)"
        elif target_index == 2:
            call = (
                f"r18_path_{variant_index}(3,&observed_prefix,&observed_lock)"
            )
        else:
            call = f"r18_path_{variant_index}(4)"
        cases.append(f"case {variant_index}: result={call}; break;")
    prefix = r'''#include <sys/types.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#define NS "/private/var/db/nortropic-runtime-cleanup-v1"
static int fixture_id;
static int controlled_fd;
static int controlled_ordinal;
static int controlled_seen;
static int raw_fsync_rc;
static int control_evaluated;
static int next_rebind_count;
static int mutation_count;
static int observed_prefix;
static int observed_lock;
static int fresh_names_seen;
static int fresh_state_seen;
static int fresh_effect_boundary_seen;
static void fill_stat(struct stat *value,mode_t mode){
  memset(value,0,sizeof *value);value->st_dev=1;value->st_ino=2;
  value->st_mode=mode;value->st_uid=0;value->st_gid=0;
  value->st_nlink=1;value->st_size=fixture_id==1?1:0;
}
static int h039_open(const char *path,int flags,...){(void)path;(void)flags;return 10;}
static int h039_openat(int parent,const char *name,int flags,...){
  (void)parent;(void)name;(void)flags;return 21;
}
static int h039_fsync(int fd){
  if(fd==controlled_fd){controlled_seen++;
    if(controlled_seen==controlled_ordinal){control_evaluated=1;return raw_fsync_rc;}}
  return 0;
}
static int h039_fstat(int fd,struct stat *value){
  (void)fd;
  if(fixture_id==0)fill_stat(value,S_IFDIR|0700);
  else if(fixture_id==1)fill_stat(value,S_IFREG|04555);
  else if(fixture_id==2)fill_stat(value,S_IFREG|0600);
  else fill_stat(value,S_IFREG|0500);
  if(control_evaluated&&next_rebind_count==0)next_rebind_count++;
  return 0;
}
static int h039_fstatat(int parent,const char *name,struct stat *value,int flags){
  (void)parent;(void)name;(void)flags;
  if(fixture_id==0&&strcmp(name,"mediator")==0){errno=ENOENT;return -1;}
  if(fixture_id==1)fill_stat(value,S_IFREG|(control_evaluated?04555:0400));
  else if(fixture_id==2)fill_stat(value,S_IFREG|0600);
  else if(fixture_id==3)fill_stat(value,S_IFREG|0500);
  else fill_stat(value,S_IFDIR|0700);
  return 0;
}
static int h039_lstat(const char *path,struct stat *value){
  (void)path;fill_stat(value,S_IFDIR|0700);return 0;
}
static int h039_fchmod(int fd,mode_t mode){(void)fd;(void)mode;return 0;}
static int h039_fchown(int fd,uid_t uid,gid_t gid){
  (void)fd;(void)uid;(void)gid;return 0;
}
static int h039_close(int fd){(void)fd;return 0;}
static int h039_unlinkat(int parent,const char *name,int flags){
  (void)parent;(void)name;(void)flags;
  if(control_evaluated)mutation_count++;return 0;
}
#define open h039_open
#define openat h039_openat
#define fsync h039_fsync
#define fstat h039_fstat
#define fstatat h039_fstatat
#define lstat h039_lstat
#define fchmod h039_fchmod
#define fchown h039_fchown
#define close h039_close
#define unlinkat h039_unlinkat
static int flush_dir(int fd){return fsync(fd)==0;}
static int same_stat(const struct stat *a,const struct stat *b){(void)a;(void)b;return 1;}
static int exact_names(int fd,const char **names,size_t n,unsigned mask){
  (void)fd;(void)names;(void)n;(void)mask;
  if(fixture_id==0)fresh_names_seen++;
  return 1;
}
static int exact_empty(int fd){(void)fd;return 1;}
static int stable_named_fd(int parent,const char *name,int flags,uid_t uid,
  gid_t gid,mode_t mode,size_t cap,unsigned char **raw,size_t *length,
  struct stat *identity){
  (void)parent;(void)name;(void)flags;(void)uid;(void)gid;(void)cap;
  if(identity)fill_stat(identity,S_IFREG|mode);
  if(raw){*raw=malloc(1);if(!*raw)return -1;(*raw)[0]=0x41;}
  if(length)*length=1;
  if(fixture_id==1)return 20;if(fixture_id==2)return 200;return 33;
}
static int stable_read_fd(int fd,size_t cap,unsigned char **raw,size_t *length,
  struct stat *identity){
  (void)fd;(void)cap;*raw=malloc(1);if(!*raw)return 0;(*raw)[0]=0x41;
  *length=1;fill_stat(identity,S_IFREG|0400);return 1;
}
static int durable_fixed_dir_at(int parent,const char *name,uid_t uid,gid_t gid,
  mode_t mode){
  (void)parent;(void)uid;(void)gid;(void)mode;
  if(fixture_id==2){const char *dirs="acqrs";const char *found=strchr(dirs,name[0]);
    return found?100+(int)(found-dirs):-1;}
  if(fixture_id==3)return strcmp(name,"controller")==0?31:32;
  return 50;
}
static int parent_dir(int child,uid_t uid,gid_t gid,mode_t mode){
  (void)child;(void)uid;(void)gid;(void)mode;return 12;
}
static int write_all(int fd,const unsigned char *raw,size_t n){
  (void)fd;(void)raw;(void)n;return 1;
}
static int installed_mediator_status(int helpers,const unsigned char *raw,size_t n){
  (void)helpers;(void)raw;(void)n;return 0;
}
static int publish_staged_mediator(int project,int helpers,
  const unsigned char *raw,size_t n){
  (void)project;(void)helpers;(void)raw;(void)n;return 1;
}
static int make_final_directory(int parent,const char *name){
  (void)parent;(void)name;return 1;
}
static int ensure_lock(int state){(void)state;return 1;}
static int stage_embedded_mediator(int project,const unsigned char *raw,size_t n){
  (void)project;(void)raw;(void)n;
  if(fixture_id==0){fresh_effect_boundary_seen++;return 0;}
  return 1;
}
static int directory_prefix(int ns,int *prefix,int *has_lock){
  (void)ns;*prefix=0;*has_lock=0;
  if(fixture_id==0){
    observed_prefix=*prefix;observed_lock=*has_lock;fresh_state_seen++;
  }
  return 1;
}
static int remove_fixed_staging(int project){(void)project;return 1;}
'''
    suffix = (
        "\nstatic int decimal(const char *value){int out=0;if(!value||!*value)return -1;"
        "for(;*value;value++){if(*value<'0'||*value>'9')return -1;"
        "out=out*10+(*value-'0');if(out>999)return -1;}return out;}\n"
        "int main(int argc,char **argv){static const unsigned char bytes[1]={0x41};"
        "int variant,result=-1,valid=0;if(argc!=3)return 121;"
        "variant=decimal(argv[1]);if(variant<0)return 122;"
        "if(argv[2][0]=='0'&&argv[2][1]=='\\0')raw_fsync_rc=0;"
        "else if(argv[2][0]=='1'&&argv[2][1]=='\\0')raw_fsync_rc=-1;"
        "else return 123;fixture_id=variant<4?variant:(variant-4)/2;"
        "if(fixture_id<0||fixture_id>3)return 124;"
        "controlled_fd=fixture_id==0?12:fixture_id==1?4:fixture_id==2?104:32;"
        "controlled_ordinal=fixture_id==1?2:1;controlled_seen=0;"
        "control_evaluated=0;next_rebind_count=0;mutation_count=0;"
        "fresh_names_seen=0;fresh_state_seen=0;fresh_effect_boundary_seen=0;"
        "observed_prefix=-1;observed_lock=-1;switch(variant){"
        + "".join(cases)
        + "default:return 124;}"
        "if(control_evaluated){if(raw_fsync_rc==0){"
        "if(fixture_id==0)valid=result==0&&next_rebind_count==1&&mutation_count==0&&"
        "fresh_names_seen==1&&fresh_state_seen==1&&observed_prefix==0&&"
        "observed_lock==0&&fresh_effect_boundary_seen==1;"
        "else if(fixture_id==1)valid=result==1&&next_rebind_count==1&&mutation_count==0;"
        "else if(fixture_id==2)valid=result==1&&next_rebind_count==1&&"
        "mutation_count==0&&observed_prefix==5&&observed_lock==1;"
        "else valid=result==1&&next_rebind_count==1&&mutation_count==3;"
        "}else valid=result==0&&next_rebind_count==0&&mutation_count==0&&"
        "fresh_names_seen==0&&fresh_state_seen==0&&observed_prefix==-1&&"
        "observed_lock==-1&&fresh_effect_boundary_seen==0;}"
        "return variant<4?(valid?0:120):(valid?119:120);}\n"
    )
    return (prefix + "\n".join(definitions) + suffix).encode("utf-8")


def r18_causal_fixture_checks(raw: bytes) -> None:
    exact = r18_causal_expressions(raw)
    mutants: list[str] = []
    for expression in exact:
        if expression.count("!flush_dir") != 1:
            raise Rig("R18 causal fixture target is not singly negated")
        mutants.extend((
            expression.replace("!flush_dir", "flush_dir", 1),
            expression.replace("!flush_dir", "!!flush_dir", 1),
        ))
    all_expressions = [*exact, *mutants]
    harness = r18_causal_harness_source(all_expressions)
    if path_sha(BUILD_COMPILER) != BUILD_COMPILER_SHA256:
        raise Undecidable("R18 causal fixture compiler identity drift")
    temporary = Path(tempfile.mkdtemp(prefix="h039-r18-causal-", dir="/private/tmp"))
    project = temporary / "project"
    test_root = temporary / "installer-review-root"
    source = project / "r18-causal.c"
    executable = project / "r18-causal"
    mediator = temporary / "mediator-fixture"
    try:
        project.mkdir(mode=0o700)
        test_root.mkdir(mode=0o700)
        source.write_bytes(harness)
        mediator.write_bytes(b"H039-R18-CAUSAL-FIXTURE\n")
        mediator.chmod(0o600)
        environment = {
            "HOME": "/var/empty", "TMPDIR": str(project),
            "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin",
        }
        compile_result = bounded_run(
            [
                str(SANDBOX_EXEC),
                "-D", f"H039_BUILD_EXECUTABLE={BUILD_COMPILER}",
                "-D", f"H039_BUILD_ROOT={project}",
                "-p", BUILD_REVIEW_PROFILE,
                str(BUILD_COMPILER), "-x", "c", "-std=c11", "-O2",
                "-Wall", "-Wextra", "-Werror", "-arch", "arm64",
                "-isysroot", str(BUILD_SDK), "-mmacosx-version-min=15.0",
                str(source), "-o", str(executable),
            ],
            cwd=project, env=environment, timeout=60,
        )
        if compile_result.returncode == 71 \
                and b"sandbox_apply: Operation not permitted" in compile_result.stderr:
            raise Undecidable("outer Seatbelt denied R18 causal build sandbox")
        if (
            compile_result.returncode != 0
            or compile_result.stdout != b""
            or compile_result.stderr != b""
        ):
            raise Rig(
                f"R18 causal harness build failed rc={compile_result.returncode} "
                f"stdout={compile_result.stdout!r} stderr={compile_result.stderr!r}"
            )
        executable_value = os.lstat(executable)
        if (
            not stat.S_ISREG(executable_value.st_mode)
            or executable_value.st_uid != os.getuid()
            or executable_value.st_nlink != 1
            or stat.S_IMODE(executable_value.st_mode) != 0o755
        ):
            raise Rig("R18 causal executable identity drift")

        def tree_snapshot() -> dict[str, tuple[tuple[int, ...], str | None]]:
            observed: dict[str, tuple[tuple[int, ...], str | None]] = {}
            for candidate in sorted(temporary.rglob("*")):
                value = os.lstat(candidate)
                digest = path_sha(candidate) if stat.S_ISREG(value.st_mode) else None
                observed[str(candidate.relative_to(temporary))] = (
                    stable_identity(value), digest,
                )
            return observed

        before = tree_snapshot()
        for fixture_index, fixture in enumerate(R18_CAUSAL_FIXTURES):
            for raw_rc in (0, -1):
                result = bounded_run(
                    [
                        str(SANDBOX_EXEC),
                        "-D", f"H039_EXECUTABLE={executable}",
                        "-D", f"H039_MEDIATOR={mediator}",
                        "-D", f"H039_TEST_ROOT={test_root}",
                        "-p", INSTALLER_REVIEW_PROFILE,
                        str(executable), str(fixture_index),
                        "0" if raw_rc == 0 else "1",
                    ],
                    cwd="/", env=environment, timeout=10,
                )
                if result.returncode == 71 \
                        and b"sandbox_apply: Operation not permitted" in result.stderr:
                    raise Undecidable("outer Seatbelt denied R18 causal execution sandbox")
                check(
                    result.returncode == 0
                    and result.stdout == b"" and result.stderr == b"",
                    f"A_H039_R18_CAUSAL_{fixture[0]}_FSYNC_"
                    f"{'ZERO_CONTINUES' if raw_rc == 0 else 'MINUS1_STOPS'}",
                    {"returncode": result.returncode},
                )
        for mutant_index in range(len(mutants)):
            for raw_rc in (0, -1):
                result = bounded_run(
                    [
                        str(SANDBOX_EXEC),
                        "-D", f"H039_EXECUTABLE={executable}",
                        "-D", f"H039_MEDIATOR={mediator}",
                        "-D", f"H039_TEST_ROOT={test_root}",
                        "-p", INSTALLER_REVIEW_PROFILE,
                        str(executable), str(len(exact) + mutant_index),
                        "0" if raw_rc == 0 else "1",
                    ],
                    cwd="/", env=environment, timeout=10,
                )
                if result.returncode == 71 \
                        and b"sandbox_apply: Operation not permitted" in result.stderr:
                    raise Undecidable("outer Seatbelt denied R18 causal mutant sandbox")
                check(
                    result.returncode == 120
                    and result.stdout == b"" and result.stderr == b"",
                    f"N_H039_R18_CAUSAL_MUTANT_{mutant_index + 1:02d}_"
                    f"{'FSYNC0' if raw_rc == 0 else 'FSYNC_MINUS1'}",
                    {"returncode": result.returncode},
                )
        if tree_snapshot() != before:
            raise Rig("R18 causal fixture changed its identity-bound review tree")
        check(
            True,
            "A_H039_R18_FOUR_SOURCE_CONNECTED_CAUSAL_FIXTURES_EXECUTED",
            {
                "fixture_count": len(exact),
                "mutant_count": len(mutants),
                "harness_sha256": sha(harness),
            },
        )
    finally:
        shutil.rmtree(temporary)


def r18_full_path_fixture_checks(raw: bytes) -> None:
