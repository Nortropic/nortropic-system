    for label, mutate in (
        ("ADDED", lambda value: value.__setitem__(0, (value[0][0], "000000", value[0][2], "A"))),
        ("SUBSTITUTED", lambda value: value.__setitem__(0, ("controller/runtime-cleanup/neighbor", *value[0][1:]))),
        ("OLD_MODE", lambda value: value.__setitem__(0, (value[0][0], "100644", value[0][2], value[0][3]))),
        ("NEW_MODE", lambda value: value.__setitem__(0, (value[0][0], value[0][1], "100644", value[0][3]))),
        ("STATUS", lambda value: value.__setitem__(0, (*value[0][:3], "A"))),
        ("MISSING", lambda value: value.pop()),
        ("EXTRA", lambda value: value.append(("verify/h039/runtime-cleanup-mediator", "100755", "100755", "M"))),
        ("REORDERED", lambda value: value.reverse()),
    ):
        mutant = copy.deepcopy(expected_product_changes)
        mutate(mutant)
