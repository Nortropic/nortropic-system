        ("RETRY_ENABLED", lambda value: value.__setitem__("diagnostic_retry", True)),
        ("INSTALL_ENABLED", lambda value: value.__setitem__("production_installation", True)),
        ("OWNER_STOP_REMOVED", lambda value: value.__setitem__("owner_adjudication_required", False)),
        ("AUTHORITY_WIDENED", lambda value: value.__setitem__("broader_authority", True)),
