        check(
            not historical_ok and not graph_ok and not candidate_ok,
            f"N_H039_R20_STALE_SUBSTITUTED_OR_PRODUCT_IDENTITY_{index:02d}",
        )
    changes = [
        (path, PRODUCT_MODES[path], PRODUCT_MODES[path], "M")
        for path in R19_PRODUCT_GIT_ORDER
    ]
    check(
        exact_r19_product_change_shape(changes),
        "A_H039_R20_EXACT_R12_THREE_FILE_CHANGE_SHAPE",
    )
    for label, mutate in (
        ("MISSING", lambda value: value.pop()),
        ("EXTRA", lambda value: value.append(
            ("verify/h039/build-recipe.json", "100644", "100644", "M"))),
        ("REORDERED", lambda value: value.reverse()),
        ("SUBSTITUTED", lambda value: value.__setitem__(
            0, ("controller/runtime-cleanup/neighbor", *value[0][1:]))),
        ("MODE", lambda value: value.__setitem__(
            0, (value[0][0], "100644", value[0][2], value[0][3]))),
        ("ADDED", lambda value: value.__setitem__(
            0, (value[0][0], "000000", value[0][2], "A"))),
    ):
        mutant = copy.deepcopy(changes)
        mutate(mutant)
        check(
            not exact_r19_product_change_shape(mutant),
            f"N_H039_R20_R12_CHANGE_SHAPE_{label}",
        )


def r21_git_identity_selftests() -> None:
    product_ok, product_detail = historical_r12_product_identity(
        R20_AUTHORITY_BASE,
    )
    check(
        product_ok,
        "A_H039_R21_EXACT_FIXED_HISTORICAL_R12_PRODUCT_IDENTITY",
        product_detail,
    )
    for index, commit in enumerate((
        R21_AUTHORITY_BASE, R21_R20_CONTRACT_CANDIDATE,
        R20_AUTHORITY_BASE, R20_R12_CONTRACT_MERGE,
        R20_R12_PRODUCT_CANDIDATE, REJECTED_R20_R1_CANDIDATE,
        REJECTED_R20_R2_CANDIDATE, REJECTED_R20_R3_CANDIDATE,
        REJECTED_R21_R1_CANDIDATE,
        R19_AUTHORITY_BASE, PUBLISHED_H039_R8_PRODUCT_MERGE,
        PUBLISHED_H039_R9_PRODUCT_MERGE,
    )):
        graph_ok, _graph = r21_contract_publication_graph(commit)
        candidate_ok, _candidate = r21_contract_candidate_graph(commit)
        if commit == R20_AUTHORITY_BASE:
            product_identity_ok = product_ok
        else:
            product_identity_ok, _detail = historical_r12_product_identity(commit)
        check(
            not graph_ok and not candidate_ok
            and (product_identity_ok if commit == R20_AUTHORITY_BASE else not product_identity_ok),
            f"N_H039_R21_STALE_SUBSTITUTED_CONTRACT_OR_PRODUCT_IDENTITY_{index:02d}",
        )
    changes = [
        (path, "100755" if path == "verify/bin/h-039-exit" else "100644",
         "100755" if path == "verify/bin/h-039-exit" else "100644", "M")
        for path in TEST_AUTHOR_GIT_ORDER
    ]
    check(
        exact_contract_change_shape(changes),
        "A_H039_R21_EXACT_FIVE_FILE_TEST_AUTHOR_CHANGE_SHAPE",
    )
    for label, mutate in (
        ("MISSING", lambda value: value.pop()),
        ("EXTRA", lambda value: value.append(
            ("verify/h039/identity-manifest.json", "100644", "100644", "M"))),
        ("REORDERED", lambda value: value.reverse()),
        ("SUBSTITUTED", lambda value: value.__setitem__(
            0, ("docs/neighbor.md", *value[0][1:]))),
        ("MODE", lambda value: value.__setitem__(
            0, (value[0][0], "100755", value[0][2], value[0][3]))),
        ("ADDED", lambda value: value.__setitem__(
            0, (value[0][0], "000000", value[0][2], "A"))),
        ("DELETED", lambda value: value.__setitem__(
            0, (value[0][0], value[0][1], "000000", "D"))),
    ):
        mutant = copy.deepcopy(changes)
        mutate(mutant)
        check(
            not exact_contract_change_shape(mutant),
            f"N_H039_R21_CONTRACT_CHANGE_SHAPE_{label}",
        )


def exact_contract_merge(base: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(base)
        if len(parents) != 2:
            return False, {"parents": parents}
        authority, candidate = parents
        candidate_parents = commit_parents(candidate)
        changes = raw_changes(authority, candidate)
        ok = (
            authority == CONTRACT_AUTHORITY_BASE
            and candidate_parents == [CONTRACT_AUTHORITY_BASE]
            and commit_tree(base) == commit_tree(candidate)
            and exact_contract_change_shape(changes)
        )
        return ok, {"parents": parents, "candidate_parents": candidate_parents,
                    "changes": changes, "tree": commit_tree(base)}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc)}


def product_identity(
    base: str, candidate: str, *, require_checkout: bool = True,
    require_contract_publication: bool = True,
) -> tuple[bool, dict[str, Any]]:
    merge_ok, merge_detail = exact_contract_merge(base)
    try:
        parents = commit_parents(candidate)
        changes = raw_changes(base, candidate)
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status = git(["status", "--porcelain=v1", "--untracked-files=all"])
        frozen_equal = all(
            blob(candidate, path) == blob(base, path)
            for path in ("specs/tasks.spec.json", "verify/bin/h-039-exit",
                         "specs/owner-production-paths.v1.json",
                         "verify/h039/build-recipe.json",
                         "verify/h039/runtime-cleanup-mediator")
        )
        product_sizes = {
            path: blob_size(candidate, path) for path in PRODUCT_PATHS
        }
        added_lines, deleted_lines = line_delta(base, candidate)
        bounded_product = (
            all(product_sizes[path] <= PRODUCT_BYTE_LIMITS[path]
                for path in PRODUCT_PATHS)
            and sum(product_sizes.values()) <= MAX_AGGREGATE_PRODUCT_BYTES
        )
        remote_main = observed_production_main() \
            if require_contract_publication else None
        ok = (
            merge_ok and parents == [base]
            and exact_product_change_shape(changes)
            and added_lines <= MAX_ADDED_LINES
            and deleted_lines <= MAX_DELETED_LINES
            and frozen_equal and bounded_product
            and (not require_contract_publication or remote_main == base)
            and (not require_checkout or (head == candidate and status == b""))
        )
        return ok, {"merge": merge_detail, "parents": parents,
                    "changes": changes, "head": head, "status": status.decode(),
                    "frozen_equal": frozen_equal, "product_sizes": product_sizes,
                    "bounded_product": bounded_product, "added_lines": added_lines,
                    "deleted_lines": deleted_lines, "remote_main": remote_main}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "merge": merge_detail}


def product_publication_identity(merge: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(merge)
        if len(parents) != 2:
            return False, {"parents": parents}
        contract_merge, candidate = parents
        product_ok, product_detail = product_identity(
            contract_merge, candidate, require_checkout=False,
            require_contract_publication=False,
        )
        remote_main = observed_production_main()
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status = git(["status", "--porcelain=v1", "--untracked-files=all"])
        executing_bytes_equal = (
            SPEC.read_bytes() == blob(merge, "specs/tasks.spec.json")
            and GATE.read_bytes() == blob(merge, "verify/bin/h-039-exit")
        )
        ok = (
            product_ok and commit_tree(merge) == commit_tree(candidate)
            and remote_main == merge and head == merge and status == b""
            and executing_bytes_equal
        )
        return ok, {
            "parents": parents, "tree": commit_tree(merge),
            "candidate_tree": commit_tree(candidate), "remote_main": remote_main,
            "head": head, "status": status.decode(),
            "executing_bytes_equal": executing_bytes_equal, "product": product_detail,
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc)}


def r18_product_identity(
    contract_merge: str, candidate: str, *, require_checkout: bool = True,
    require_contract_publication: bool = True,
) -> tuple[bool, dict[str, Any]]:
    contract_ok, contract_detail = r18_contract_publication_graph(contract_merge)
    try:
        parents = commit_parents(candidate)
        changes = raw_changes(contract_merge, candidate)
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        frozen_paths = [
            "specs/tasks.spec.json", "verify/bin/h-039-exit",
            "specs/owner-production-paths.v1.json",
            "verify/h039/runtime-cleanup-mediator",
        ]
        frozen_equal = all(
            blob(candidate, path) == blob(contract_merge, path)
            for path in frozen_paths
        )
        source_exact = (
            blob(candidate, "controller/runtime-cleanup/native/mediator.c")
            == r18_expected_production_source()
        )
        recipe_raw = blob(candidate, "verify/h039/build-recipe.json")
        recipe_exact = (
            recipe_raw == r18_expected_production_recipe()
            and sha(recipe_raw) == R18_PRODUCTION_RECIPE_SHA256
        )
        mediator_exact = (
            sha(blob(candidate, "verify/h039/runtime-cleanup-mediator"))
            == PUBLISHED_H039_R8_PRODUCT_BLOBS[
                "verify/h039/runtime-cleanup-mediator"
            ]
        )
        product_sizes = {
            path: blob_size(candidate, path) for path in PRODUCT_PATHS
        }
        additions, deletions = line_delta(contract_merge, candidate)
        bounded = (
            all(product_sizes[path] <= PRODUCT_BYTE_LIMITS[path]
                for path in PRODUCT_PATHS)
            and sum(product_sizes.values()) <= MAX_AGGREGATE_PRODUCT_BYTES
        )
        remote_main = observed_production_main() \
            if require_contract_publication else None
        ok = (
            contract_ok and object_type(candidate) == "commit"
            and parents == [contract_merge]
            and exact_r18_product_change_shape(changes)
            and additions <= MAX_ADDED_LINES and deletions <= MAX_DELETED_LINES
            and frozen_equal and source_exact and recipe_exact
            and mediator_exact and bounded
            and (not require_contract_publication or remote_main == contract_merge)
            and (not require_checkout or (head == candidate and status_raw == b""))
        )
        return ok, {
            "contract": contract_detail, "parents": parents,
            "changes": changes, "head": head,
            "status": status_raw.decode("utf-8", "replace"),
            "frozen_equal": frozen_equal, "source_exact": source_exact,
            "recipe_exact": recipe_exact, "mediator_exact": mediator_exact,
            "product_sizes": product_sizes, "bounded": bounded,
            "additions": additions, "deletions": deletions,
            "remote_main": remote_main,
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "contract": contract_detail}


def r18_product_publication_identity(merge: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(merge)
        if len(parents) != 2:
            return False, {"parents": parents}
        contract_merge, candidate = parents
        product_ok, product_detail = r18_product_identity(
            contract_merge, candidate, require_checkout=False,
            require_contract_publication=False,
        )
        remote_main = observed_production_main()
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        executing_bytes_equal = (
            SPEC.read_bytes() == blob(merge, "specs/tasks.spec.json")
            and GATE.read_bytes() == blob(merge, "verify/bin/h-039-exit")
        )
        product_blob_equal = all(
            stable_product_checkout_blob(path, blob(merge, path))
            for path in R18_PRODUCT_GIT_ORDER
        )
        ok = (
            product_ok and commit_tree(merge) == commit_tree(candidate)
            and remote_main == merge and head == merge and status_raw == b""
            and executing_bytes_equal and product_blob_equal
        )
        return ok, {
            "parents": parents, "tree": commit_tree(merge),
            "candidate_tree": commit_tree(candidate),
            "remote_main": remote_main, "head": head,
            "status": status_raw.decode("utf-8", "replace"),
            "executing_bytes_equal": executing_bytes_equal,
            "product_blob_equal": product_blob_equal,
            "product": product_detail,
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "merge": merge}


def r19_product_identity(
    contract_merge: str, candidate: str, *, require_checkout: bool = True,
    require_contract_publication: bool = True,
) -> tuple[bool, dict[str, Any]]:
    contract_ok, contract_detail = r19_contract_publication_graph(contract_merge)
    try:
        parents = commit_parents(candidate)
        changes = raw_changes(contract_merge, candidate)
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        frozen_paths = [
            "specs/tasks.spec.json", "verify/bin/h-039-exit",
            "specs/owner-production-paths.v1.json",
            "verify/h039/build-recipe.json",
            "verify/h039/runtime-cleanup-mediator",
        ]
        frozen_equal = all(
            blob(candidate, path) == blob(contract_merge, path)
            for path in frozen_paths
        )
        source_exact = (
            blob(candidate, "controller/runtime-cleanup/native/mediator.c")
            == r19_expected_production_source()
        )
        recipe_exact = (
            sha(blob(candidate, "verify/h039/build-recipe.json"))
            == R18_PRODUCTION_RECIPE_SHA256
        )
        mediator_exact = (
            sha(blob(candidate, "verify/h039/runtime-cleanup-mediator"))
            == PUBLISHED_H039_R8_PRODUCT_BLOBS[
                "verify/h039/runtime-cleanup-mediator"
            ]
        )
        installer_exact = (
            blob_size(candidate, "controller/runtime-cleanup/install")
            == R19_EXPECTED_INSTALLER_SIZE
            and sha(blob(candidate, "controller/runtime-cleanup/install"))
            == R19_EXPECTED_INSTALLER_SHA256
        )
        product_sizes = {
            path: blob_size(candidate, path) for path in PRODUCT_PATHS
