            r19_partial_state_evidence_checks()
            return finish(phase)

        if r19_published:
            r19_partial_state_evidence_checks()
            publication_ok, publication_detail = \
                r19_product_publication_identity(argv[1])
            check(
                publication_ok,
                "A_H039_R19_GUARDED_R12_PRODUCT_PUBLICATION_IDENTITY",
