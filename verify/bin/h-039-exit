def r23_contract_candidate_graph(candidate: str) -> tuple[bool, dict[str, Any]]:
    try:
        changes = raw_changes(R23_AUTHORITY_BASE, candidate)
        additions, deletions = line_delta(R23_AUTHORITY_BASE, candidate)
        detail = {
            "authority_tree": commit_tree(R23_AUTHORITY_BASE),
            "authority_parents": commit_parents(R23_AUTHORITY_BASE),
            "candidate": candidate, "candidate_parents": commit_parents(candidate),
            "changes": changes, "additions": additions, "deletions": deletions,
        }
        rejected = {
            R23_AUTHORITY_BASE, R22_AUTHORITY_BASE, R21_AUTHORITY_BASE,
            REJECTED_R22_R1_CANDIDATE, REJECTED_R22_R2_CANDIDATE,
            REJECTED_R22_R3_CANDIDATE,
        }
        ok = (
            object_type(R23_AUTHORITY_BASE) == "commit"
            and detail["authority_tree"] == R23_AUTHORITY_TREE
            and detail["authority_parents"] == R23_AUTHORITY_PARENTS
            and sha(blob(R23_AUTHORITY_BASE, "verify/bin/h-039-exit"))
            == R23_BASE_GATE_SHA256
            and sha(blob(R23_AUTHORITY_BASE, "specs/tasks.spec.json"))
            == R23_BASE_SPEC_SHA256
            and object_type(candidate) == "commit" and candidate not in rejected
            and detail["candidate_parents"] == [R23_AUTHORITY_BASE]
            and exact_contract_change_shape(changes)
            and type(additions) is int and additions <= MAX_ADDED_LINES
            and type(deletions) is int and deletions <= MAX_DELETED_LINES
        )
        return ok, detail
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "candidate": candidate}


def r23_contract_candidate_identity(candidate: str) -> tuple[bool, dict[str, Any]]:
    graph_ok, graph = r23_contract_candidate_graph(candidate)
    try:
        remote_main = observed_production_main()
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        checkout_equal = all(
            stable_checkout_blob(path, blob(candidate, path))
            for path in TEST_AUTHOR_GIT_ORDER
        )
        ok = (
            graph_ok and remote_main == R23_AUTHORITY_BASE and head == candidate
            and status_raw == b"" and checkout_equal
        )
        return ok, {"graph": graph, "remote_main": remote_main, "head": head,
                    "status": status_raw.decode("utf-8", "replace"),
                    "checkout_equal": checkout_equal}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "graph": graph}


def r23_contract_publication_graph(merge: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(merge)
        if len(parents) != 2:
            return False, {"parents": parents}
        authority, candidate = parents
        candidate_ok, candidate_detail = r23_contract_candidate_graph(candidate)
        changes = raw_changes(R23_AUTHORITY_BASE, merge)
        ok = (
            object_type(merge) == "commit" and authority == R23_AUTHORITY_BASE
            and candidate_ok and commit_tree(merge) == commit_tree(candidate)
            and exact_contract_change_shape(changes)
        )
        return ok, {"parents": parents, "candidate": candidate_detail,
                    "changes": changes, "tree": commit_tree(merge)}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "merge": merge}


def r23_contract_publication_identity(merge: str) -> tuple[bool, dict[str, Any]]:
    graph_ok, graph = r23_contract_publication_graph(merge)
    try:
        remote_main = observed_production_main()
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        checkout_equal = all(
            stable_checkout_blob(path, blob(merge, path))
            for path in TEST_AUTHOR_GIT_ORDER
        )
        ok = (
            graph_ok and remote_main == merge and head == merge
            and status_raw == b"" and checkout_equal
            and SPEC.read_bytes() == blob(merge, "specs/tasks.spec.json")
            and GATE.read_bytes() == blob(merge, "verify/bin/h-039-exit")
        )
        return ok, {"graph": graph, "remote_main": remote_main, "head": head,
                    "status": status_raw.decode("utf-8", "replace"),
                    "checkout_equal": checkout_equal}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "graph": graph}


def exact_r22_product_change_shape(
    changes: list[tuple[str, str, str, str]],
) -> bool:
    return changes == [
        (path, PRODUCT_MODES[path], PRODUCT_MODES[path], "M")
        for path in R22_PRODUCT_PATHS
    ]


def exact_r23_product_change_shape(
    changes: list[tuple[str, str, str, str]],
) -> bool:
    return changes == [
        (path, PRODUCT_MODES[path], PRODUCT_MODES[path], "M")
        for path in R23_PRODUCT_GIT_ORDER
    ]


def r22_product_identity(
    contract_merge: str, candidate: str, *, require_checkout: bool = True,
    require_contract_publication: bool = True,
) -> tuple[bool, dict[str, Any]]:
    try:
        contract_ok, contract = r22_contract_publication_graph(contract_merge)
        changes = raw_changes(contract_merge, candidate)
        additions, deletions = line_delta(contract_merge, candidate)
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        checkout_equal = all(
            stable_product_checkout_blob(path, blob(candidate, path))
            for path in R22_PRODUCT_PATHS
        ) if require_checkout else True
        contract_checkout_equal = all(
            stable_checkout_blob(path, blob(contract_merge, path))
            for path in TEST_AUTHOR_GIT_ORDER
        ) if require_checkout else True
        executing_contract_bytes_equal = (
            SPEC.read_bytes() == blob(contract_merge, "specs/tasks.spec.json")
            and GATE.read_bytes() == blob(contract_merge, "verify/bin/h-039-exit")
        ) if require_checkout else True
        remote_main = observed_production_main() \
            if require_contract_publication else None
        source_exact = (
            blob(candidate, "controller/runtime-cleanup/native/mediator.c")
            == r22_expected_diagnostic_source()
        )
        recipe_exact = (
            blob(candidate, "verify/h039/build-recipe.json")
            == r22_expected_diagnostic_recipe()
        )
        ok = (
            contract_ok
            and (not require_contract_publication or remote_main == contract_merge)
            and object_type(candidate) == "commit"
            and commit_parents(candidate) == [contract_merge]
            and exact_r22_product_change_shape(changes)
            and additions <= MAX_ADDED_LINES and deletions <= MAX_DELETED_LINES
            and (not require_checkout or (
                head == candidate and status_raw == b"" and checkout_equal
                and contract_checkout_equal and executing_contract_bytes_equal
            ))
            and source_exact and recipe_exact
            and blob(candidate, "verify/h039/runtime-cleanup-mediator")
            == blob(R20_AUTHORITY_BASE, "verify/h039/runtime-cleanup-mediator")
        )
        return ok, {"contract": contract, "candidate": candidate,
                    "parents": commit_parents(candidate), "changes": changes,
                    "remote_main": remote_main, "head": head,
                    "status": status_raw.decode("utf-8", "replace"),
                    "checkout_equal": checkout_equal,
                    "contract_checkout_equal": contract_checkout_equal,
                    "executing_contract_bytes_equal": executing_contract_bytes_equal,
                    "source_exact": source_exact, "recipe_exact": recipe_exact}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "candidate": candidate}


def r22_product_publication_identity(merge: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(merge)
        if len(parents) != 2:
            return False, {"parents": parents}
        contract_merge, candidate = parents
        product_ok, product = r22_product_identity(
            contract_merge, candidate, require_checkout=False,
            require_contract_publication=False,
        )
        changes = raw_changes(contract_merge, merge)
        remote_main = observed_production_main()
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        checkout_equal = all(
            stable_product_checkout_blob(path, blob(merge, path))
            for path in R22_PRODUCT_PATHS
        )
        contract_checkout_equal = all(
            stable_checkout_blob(path, blob(merge, path))
            for path in TEST_AUTHOR_GIT_ORDER
        )
        executing_bytes_equal = (
            SPEC.read_bytes() == blob(merge, "specs/tasks.spec.json")
            and GATE.read_bytes() == blob(merge, "verify/bin/h-039-exit")
        )
        ok = (
            product_ok and object_type(merge) == "commit"
            and commit_tree(merge) == commit_tree(candidate)
            and exact_r22_product_change_shape(changes)
            and remote_main == merge and head == merge and status_raw == b""
            and checkout_equal and contract_checkout_equal and executing_bytes_equal
            and blob(merge, "verify/h039/runtime-cleanup-mediator")
            == blob(R20_AUTHORITY_BASE, "verify/h039/runtime-cleanup-mediator")
        )
        return ok, {"parents": parents, "product": product, "changes": changes,
                    "remote_main": remote_main, "head": head,
                    "status": status_raw.decode("utf-8", "replace"),
                    "checkout_equal": checkout_equal,
                    "contract_checkout_equal": contract_checkout_equal,
                    "executing_bytes_equal": executing_bytes_equal}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "merge": merge}


def r23_product_identity(
    contract_merge: str, candidate: str, *, require_checkout: bool = True,
    require_contract_publication: bool = True,
) -> tuple[bool, dict[str, Any]]:
    try:
        contract_ok, contract = r23_contract_publication_graph(contract_merge)
        changes = raw_changes(contract_merge, candidate)
        additions, deletions = line_delta(contract_merge, candidate)
        remote_main = observed_production_main() \
            if require_contract_publication else None
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        checkout_equal = all(
            stable_product_checkout_blob(path, blob(candidate, path))
            for path in R23_PRODUCT_GIT_ORDER
        ) if require_checkout else True
        contract_checkout_equal = all(
            stable_checkout_blob(path, blob(contract_merge, path))
            for path in TEST_AUTHOR_GIT_ORDER
        ) if require_checkout else True
        executing_contract_bytes_equal = (
            SPEC.read_bytes() == blob(contract_merge, "specs/tasks.spec.json")
            and GATE.read_bytes() == blob(contract_merge, "verify/bin/h-039-exit")
        ) if require_checkout else True
        source = blob(candidate, "controller/runtime-cleanup/native/mediator.c")
        r23_source_contract_checks(source)
        source_exact = source == r23_expected_production_source()
        recipe_raw = blob(candidate, "verify/h039/build-recipe.json")
        recipe = strict_json(recipe_raw)
        r12_recipe = strict_json(
            blob(R20_AUTHORITY_BASE, "verify/h039/build-recipe.json")
        )
        mediator = blob(candidate, "verify/h039/runtime-cleanup-mediator")
        argv = recipe.get("installer_compile_argv", []) \
            if type(recipe) is dict else []
        r12_argv = r12_recipe.get("installer_compile_argv", []) \
            if type(r12_recipe) is dict else []
        expected_argv = list(r12_argv)
        digest_index = expected_argv.index(
            f"-DH039_MEDIATOR_SHA256={R23_OLD_R12_MEDIATOR_SHA256}"
        )
        expected_argv[digest_index:digest_index + 2] = [
            f"-DH039_MEDIATOR_SHA256={sha(mediator)}",
            f"-DH039_MEDIATOR_SIZE={len(mediator)}",
            f"-DH039_OLD_MEDIATOR_SHA256={R23_OLD_R12_MEDIATOR_SHA256}",
            f"-DH039_OLD_MEDIATOR_SIZE={R23_OLD_R12_MEDIATOR_SIZE}",
        ]
        expected_recipe = copy.deepcopy(r12_recipe)
        expected_recipe["installer_compile_argv"] = expected_argv
        expected_recipe_raw = r23_expected_production_recipe(mediator)
        recipe_exact = (
            recipe_raw == expected_recipe_raw
            and recipe == expected_recipe
            and sha(blob(R20_AUTHORITY_BASE, "verify/h039/build-recipe.json"))
            == R18_PRODUCTION_RECIPE_SHA256
            and f"-D{R22_DIAGNOSTIC_DEFINE}" not in argv
            and "-Wno-unused-function" not in argv
        )
        ok = (
            contract_ok
            and (not require_contract_publication or remote_main == contract_merge)
            and object_type(candidate) == "commit"
            and commit_parents(candidate) == [contract_merge]
            and exact_r23_product_change_shape(changes)
            and additions <= MAX_ADDED_LINES and deletions <= MAX_DELETED_LINES
            and source_exact and recipe_exact
            and sha(blob(R23_AUTHORITY_BASE, "verify/h039/runtime-cleanup-mediator"))
            == R23_OLD_R12_MEDIATOR_SHA256
            and mediator != blob(
                R23_AUTHORITY_BASE, "verify/h039/runtime-cleanup-mediator",
            )
            and (not require_checkout or (
                head == candidate and status_raw == b"" and checkout_equal
                and contract_checkout_equal and executing_contract_bytes_equal
            ))
        )
        return ok, {
            "contract": contract, "candidate": candidate,
            "parents": commit_parents(candidate), "changes": changes,
            "remote_main": remote_main, "head": head,
            "status": status_raw.decode("utf-8", "replace"),
            "checkout_equal": checkout_equal,
            "contract_checkout_equal": contract_checkout_equal,
            "executing_contract_bytes_equal": executing_contract_bytes_equal,
            "source_sha256": sha(source), "source_exact": source_exact,
            "recipe_exact": recipe_exact,
            "new_mediator_sha256": sha(mediator), "new_mediator_size": len(mediator),
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "candidate": candidate}


def r23_product_publication_identity(merge: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(merge)
        if len(parents) != 2:
            return False, {"parents": parents}
        contract_merge, candidate = parents
        product_ok, product = r23_product_identity(
            contract_merge, candidate, require_checkout=False,
            require_contract_publication=False,
        )
        changes = raw_changes(contract_merge, merge)
        remote_main = observed_production_main()
        head = git(["rev-parse", "HEAD^{commit}"]).decode().strip()
        status_raw = git(["status", "--porcelain=v1", "--untracked-files=all"])
        checkout_equal = all(
            stable_product_checkout_blob(path, blob(merge, path))
            for path in R23_PRODUCT_GIT_ORDER
        )
        contract_checkout_equal = all(
            stable_checkout_blob(path, blob(merge, path))
            for path in TEST_AUTHOR_GIT_ORDER
        )
        executing_bytes_equal = (
            SPEC.read_bytes() == blob(merge, "specs/tasks.spec.json")
            and GATE.read_bytes() == blob(merge, "verify/bin/h-039-exit")
        )
        ok = (
            product_ok and object_type(merge) == "commit"
            and commit_tree(merge) == commit_tree(candidate)
            and exact_r23_product_change_shape(changes)
            and remote_main == merge and head == merge and status_raw == b""
            and checkout_equal and contract_checkout_equal and executing_bytes_equal
        )
        return ok, {"parents": parents, "product": product, "changes": changes,
                    "remote_main": remote_main, "head": head,
                    "status": status_raw.decode("utf-8", "replace"),
                    "checkout_equal": checkout_equal,
                    "contract_checkout_equal": contract_checkout_equal,
                    "executing_bytes_equal": executing_bytes_equal}
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "merge": merge}


def historical_r12_product_identity(commit: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(commit)
        contract_merge, candidate = parents if len(parents) == 2 else ("", "")
        product_ok, product_detail = r19_product_identity(
            contract_merge, candidate, require_checkout=False,
            require_contract_publication=False,
        ) if len(parents) == 2 else (False, {"parents": parents})
        blob_digests = {
            path: sha(blob(commit, path)) for path in PRODUCT_PATHS
        }
        ok = (
            commit == R20_AUTHORITY_BASE
            and object_type(commit) == "commit"
            and parents == R20_AUTHORITY_PARENTS
            and contract_merge == R20_R12_CONTRACT_MERGE
            and candidate == R20_R12_PRODUCT_CANDIDATE
            and commit_parents(candidate) == [contract_merge]
            and commit_tree(commit) == R20_AUTHORITY_TREE
            and commit_tree(candidate) == R20_AUTHORITY_TREE
            and product_ok and blob_digests == R20_R12_PRODUCT_BLOBS
        )
        return ok, {
            "commit": commit, "parents": parents,
            "tree": commit_tree(commit), "blob_digests": blob_digests,
            "product": product_detail,
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "commit": commit}


def historical_r8_product_identity(commit: str) -> tuple[bool, dict[str, Any]]:
    try:
        parents = commit_parents(commit)
        candidate_parents = commit_parents(PUBLISHED_H039_R8_PRODUCT_CANDIDATE)
        candidate_changes = raw_changes(
            PUBLISHED_H039_R8_CONTRACT_MERGE,
            PUBLISHED_H039_R8_PRODUCT_CANDIDATE,
        )
        merge_changes = raw_changes(PUBLISHED_H039_R8_CONTRACT_MERGE, commit)
        tree = commit_tree(commit)
        candidate_tree = commit_tree(PUBLISHED_H039_R8_PRODUCT_CANDIDATE)
        blob_digests = {
            path: sha(blob(commit, path)) for path in PRODUCT_PATHS
        }
        ancestry = PUBLISHED_H039_R8_PRODUCT_MERGE in git(
            ["rev-list", R17_AUTHORITY_BASE],
        ).decode("ascii").splitlines()
        ok = (
            commit == PUBLISHED_H039_R8_PRODUCT_MERGE
            and object_type(commit) == "commit"
            and parents == PUBLISHED_H039_R8_PRODUCT_PARENTS
            and candidate_parents == [PUBLISHED_H039_R8_CONTRACT_MERGE]
            and tree == PUBLISHED_H039_R8_PRODUCT_TREE
            and candidate_tree == PUBLISHED_H039_R8_PRODUCT_TREE
            and exact_r8_product_change_shape(candidate_changes)
            and exact_r8_product_change_shape(merge_changes)
            and blob_digests == PUBLISHED_H039_R8_PRODUCT_BLOBS
            and ancestry
        )
        return ok, {
            "commit": commit, "parents": parents,
            "candidate_parents": candidate_parents,
            "tree": tree, "candidate_tree": candidate_tree,
            "candidate_changes": candidate_changes,
            "merge_changes": merge_changes, "blob_digests": blob_digests,
            "ancestor_of_r17_base": ancestry,
        }
    except (Rig, subprocess.SubprocessError, OSError, ValueError) as exc:
        return False, {"error": str(exc), "commit": commit}


def r17_git_identity_selftests() -> None:
    r8_ok, r8_detail = historical_r8_product_identity(
        PUBLISHED_H039_R8_PRODUCT_MERGE,
    )
    check(r8_ok, "A_H039_R17_EXACT_HISTORICAL_R8_PRODUCT_IDENTITY", r8_detail)
    rejected = [
        PUBLISHED_H039_R8_CONTRACT_MERGE,
        PUBLISHED_H039_R8_PRODUCT_CANDIDATE,
        PUBLISHED_H039_R9_PRODUCT_MERGE,
        R17_AUTHORITY_BASE,
    ]
    for index, commit in enumerate(rejected):
        historical_ok, _detail = historical_r8_product_identity(commit)
        graph_ok, _graph = r17_contract_publication_graph(commit)
        candidate_ok, _candidate = r17_contract_candidate_graph(commit)
        check(
            not historical_ok and not graph_ok and not candidate_ok,
            f"N_H039_R17_R9_R10_R8_OR_ARBITRARY_IDENTITY_{index:02d}",
        )

    changes = [
        (path, PRODUCT_MODES[path], PRODUCT_MODES[path], "M")
        for path in R8_PRODUCT_GIT_ORDER
    ]
    check(
        exact_r8_product_change_shape(changes),
        "A_H039_R17_EXACT_R8_FOUR_FILE_CHANGE_SHAPE",
    )
    for label, mutate in (
        ("MISSING", lambda value: value.pop()),
        ("EXTRA", lambda value: value.append(
            ("verify/h039/runtime-cleanup-mediator", "100755", "100755", "M"))),
        ("REORDERED", lambda value: value.reverse()),
        ("SUBSTITUTED", lambda value: value.__setitem__(
            0, ("controller/runtime-cleanup/neighbor", *value[0][1:]))),
        ("MODE", lambda value: value.__setitem__(
            0, (value[0][0], "100644", value[0][2], value[0][3]))),
        ("ADDED", lambda value: value.__setitem__(
            0, (value[0][0], "000000", value[0][2], "A"))),
    ):
        mutant = copy.deepcopy(changes)
        mutate(mutant)
        check(
            not exact_r8_product_change_shape(mutant),
            f"N_H039_R17_R8_CHANGE_SHAPE_{label}",
        )


def r20_git_identity_selftests() -> None:
    product_ok, product_detail = historical_r12_product_identity(
        R20_AUTHORITY_BASE,
    )
    check(
