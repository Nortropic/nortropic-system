    verification_steps = [
        (7, "STAT_0400"), (8, "SHA256_0400"),
        (9, "CODESIGN_VERIFY_0400"), (10, "CDHASH_0400"),
        (11, "NAME_REBIND_0400"), (12, "ACL_XATTR_0400"),
        (14, "STAT_0500"), (15, "SHA256_0500"),
        (16, "CODESIGN_VERIFY_0500"), (17, "CDHASH_0500"),
        (18, "FINAL_NAME_REBIND_0500"), (19, "FINAL_ACL_XATTR_0500"),
    ]
    observed["verification"] = [
        name for threshold, name in verification_steps if prefix >= threshold
    ]
    if prefix == len(FIRST_ROOT_ARGV):
        observed["directories"] = []
        observed["leaf"] = None
        observed["product_exec_count"] = 1
        observed["product_environment"] = []
        observed["product_inherited_fds"] = [1, 2]
        observed["product_descriptor_inventory"] = {
            "pre_exec_open_fds": [1, 2], "fd0_closed": True,
            "all_fd_ge_3_closed": True,
            "bootstrap_first_probe": "FD0_F_GETFD_EBADF",
            "bootstrap_first_inventory": [1, 2],
            "bootstrap_closed_fds": [1, 2],
            "bootstrap_close_results": [0, 0],
            "bootstrap_second_inventory": [],
            "bootstrap_inventory_pid": "SELF_GETPID_ONLY",
            "bootstrap_inventory_flavor": "PROC_PIDLISTFDS",
            "bootstrap_inventory_byte_cap": 1048576,
            "bootstrap_inventory_aligned": True,
            "bootstrap_closure_before_open": True,
        }
        observed["product_stdin"] = "CLOSED"
        observed["source_fd_state"] = "CLOSED_BEFORE_EXEC"
        observed["tool_processes"] = {
            "launched": len(FIRST_ROOT_ARGV),
            "reaped": len(FIRST_ROOT_ARGV), "active": [],
            "process_scan": False, "signal": False,
        }
        observed["bootstrap_state"] = "COMPLETE"
        observed["final_layout"] = LAYOUT
        observed["recovery_action_argv"] = []
    return observed


BOOTSTRAP_CRASH_PHASES = [
    "PRE_EFFECTS", "MEDIATOR_PARTIAL", "MEDIATOR_DURABLE", "MEDIATOR_READY",
    "A_DURABLE", "C_DURABLE", "Q_DURABLE", "R_DURABLE",
    "S_DURABLE", "LOCK_DURABLE", "HELPER_PUBLISHED",
    "NAMESPACE_PUBLISHED", "INSTALLER_UNLINKED",
    "RUNTIME_DIR_REMOVED", "CONTROLLER_DIR_REMOVED",
    "RESTAGE_INSTALLER_PARTIAL", "RESTAGE_INSTALLER_READY", "COMPLETE",
]


def bootstrap_object(
    kind: str, mode: int, ino: int, *, size: int | None = None,
    digest: str | None = None, nlink: int = 1,
) -> dict[str, Any]:
    value: dict[str, Any] = {
        "type": kind, "uid": 0, "gid": 0, "mode": mode,
        "nlink": nlink, "flags": 0, "acl": [],
        "xattrs": [dict(PROVENANCE_XATTR)],
        "dev": 31, "ino": ino, "rebind_dev": 31, "rebind_ino": ino,
    }
    if kind == "regular":
        value.update({"size": size, "sha256": digest})
    return value


def recovery_stat_bytes(record: dict[str, Any]) -> bytes:
    kind_bits = 0o040000 if record["type"] == "directory" else 0o100000
    return (
        f'{record["dev"]}:{record["ino"]}:{kind_bits | record["mode"]:o}:'
        f'{record["uid"]}:{record["gid"]}:{record["nlink"]}:'
        f'{record.get("size", 0)}:{record["flags"]}\n'
    ).encode("ascii")


def parse_recovery_stat(raw: bytes) -> dict[str, Any] | None:
    if type(raw) is not bytes or not 0 < len(raw) <= RECOVERY_OUTPUT_CAP:
        return None
    match = re.fullmatch(
        rb"([0-9]+):([0-9]+):([0-7]+):([0-9]+):([0-9]+):"
        rb"([0-9]+):([0-9]+):([0-9]+)\n",
        raw,
    )
    if match is None:
        return None
    dev, ino, raw_mode, uid, gid, nlink, size, flags = (
        int(value, 8 if index == 2 else 10)
        for index, value in enumerate(match.groups())
    )
    if stat.S_ISDIR(raw_mode):
        kind = "directory"
    elif stat.S_ISREG(raw_mode):
        kind = "regular"
    else:
        return None
    return {
        "type": kind, "uid": uid, "gid": gid,
        "mode": stat.S_IMODE(raw_mode), "nlink": nlink,
        "size": size, "flags": flags, "dev": dev, "ino": ino,
    }


def parse_closed_acl_xattr_ls(raw: bytes, path: str, xattrs: Any) -> bool:
    if type(raw) is not bytes or not 0 < len(raw) <= RECOVERY_OUTPUT_CAP \
            or not raw.endswith(b"\n") or b"\0" in raw:
        return False
    try:
        decoded = raw.decode("utf-8")
    except UnicodeError:
        return False
    lines = decoded.splitlines()
    if not lines or not lines[0].endswith(" " + path):
        return False
    mode_token = lines[0].split(None, 1)[0]
    if xattrs == []:
        return (
            len(lines) == 1
            and re.fullmatch(r"[bcdlps-][rwxStTs-]{9}", mode_token) is not None
        )
    return (
        xattrs == [PROVENANCE_XATTR] and len(lines) == 2
        and re.fullmatch(r"[bcdlps-][rwxStTs-]{9}@", mode_token) is not None
        and lines[1] == "\tcom.apple.provenance\t11 "
    )


def parse_recovery_membership(raw: bytes, start: str) -> list[str] | None:
    if type(raw) is not bytes or len(raw) > RECOVERY_OUTPUT_CAP:
        return None
    if raw == b"":
        return []
    if not raw.endswith(b"\0"):
        return None
    try:
        paths = [item.decode("utf-8") for item in raw[:-1].split(b"\0")]
    except UnicodeError:
        return None
    if not paths or paths != sorted(paths) or len(paths) != len(set(paths)):
        return None
    start_path = Path(start)
    if any(
        not path or Path(path).parent != start_path or Path(path).name in {".", ".."}
        for path in paths
    ):
        return None
    return paths


def recovery_absent_stderr(tool: str, path: str) -> bytes:
    if tool == "stat":
        return f"stat: {path}: stat: No such file or directory\n".encode()
    if tool in {"ls", "find"}:
        return f"{tool}: {path}: No such file or directory\n".encode()
    if tool in {"openssl", "codesign"}:
        return f"{path}: No such file or directory\n".encode()
    raise Rig("unknown recovery observation tool")


def recovery_expected_bindings(
    namespace: dict[str, Any], objects: dict[str, dict[str, Any]],
    helper: dict[str, Any] | None,
) -> tuple[dict[str, dict[str, Any] | None], dict[str, list[str] | None]]:
    parent = bootstrap_object("directory", 0o755, 29, nlink=136)
    parent["flags"] = 1048576
    parent["xattrs"] = []
    helper_parent = bootstrap_object("directory", 0o1755, 28, nlink=8)
    helper_parent["xattrs"] = []
    identities: dict[str, dict[str, Any] | None] = {
        path: None for path in RECOVERY_IDENTITY_PATHS
    }
    identities["/private/var/db"] = parent
    identities[str(NAMESPACE)] = namespace
    identities["/Library/PrivilegedHelperTools"] = helper_parent
    identities[str(INSTALLED)] = helper
    for relative, record in objects.items():
        absolute = str(NAMESPACE / relative)
        if absolute in identities:
            identities[absolute] = record
    memberships: dict[str, list[str] | None] = {}
    for path in RECOVERY_MEMBERSHIP_PATHS:
        record = identities[path]
        if record is None or record["type"] != "directory":
            memberships[path] = None
            continue
        memberships[path] = sorted(
            child for child, child_record in identities.items()
            if child_record is not None and Path(child).parent == Path(path)
        )
    return identities, memberships


def recovery_observation_fixture(
    identities: dict[str, dict[str, Any] | None],
    memberships: dict[str, list[str] | None],
) -> dict[str, Any]:
    identity_results: dict[str, dict[str, Any]] = {}
    for path in RECOVERY_IDENTITY_PATHS:
        record = identities[path]
        if record is None:
            identity_results[path] = {
                "before_stat_rc": 1, "before_stat_stdout": b"",
                "before_stat_stderr": recovery_absent_stderr("stat", path),
                "before_stat_complete_eof": True,
                "ls_rc": 1, "ls_stdout": b"", "ls_stderr": b"absent\n",
                "ls_complete_eof": True,
                "after_stat_rc": 1, "after_stat_stdout": b"",
                "after_stat_stderr": recovery_absent_stderr("stat", path),
                "after_stat_complete_eof": True,
            }
            identity_results[path]["ls_stderr"] = recovery_absent_stderr("ls", path)
        else:
            kind = "d" if record["type"] == "directory" else "-"
            xattr_marker = "@" if record["xattrs"] else ""
            xattr_line = "\tcom.apple.provenance\t11 \n" if record["xattrs"] else ""
            identity_results[path] = {
                "before_stat_rc": 0, "before_stat_stdout": recovery_stat_bytes(record),
                "before_stat_stderr": b"", "before_stat_complete_eof": True,
                "ls_rc": 0,
                "ls_stdout": (
                    f"{kind}r--------{xattr_marker} 1 root wheel - 0 Jan 1 00:00 "
                    f"{path}\n{xattr_line}"
                ).encode(),
                "ls_stderr": b"", "ls_complete_eof": True,
                "after_stat_rc": 0, "after_stat_stdout": recovery_stat_bytes(record),
                "after_stat_stderr": b"", "after_stat_complete_eof": True,
            }
    digest_results: dict[str, dict[str, Any]] = {}
    for path in RECOVERY_REGULAR_PATHS:
        record = identities[path]
        if record is None:
            digest_results[path] = {
                "before_stat": b"", "openssl_rc": 1, "openssl_stdout": b"",
                "openssl_stderr": recovery_absent_stderr("openssl", path),
                "complete_eof": True, "after_stat": b"",
            }
        else:
            digest_results[path] = {
                "before_stat": recovery_stat_bytes(record), "openssl_rc": 0,
                "openssl_stdout": f"{record['sha256']} *{path}\n".encode(),
                "openssl_stderr": b"", "complete_eof": True,
                "after_stat": recovery_stat_bytes(record),
            }
    executable_results: dict[str, dict[str, Any]] = {}
    for path in RECOVERY_EXECUTABLE_PATHS:
        record = identities[path]
        if record is None:
            executable_results[path] = {
                "before_stat": b"", "verify_rc": 1, "verify_stdout": b"",
                "verify_stderr": recovery_absent_stderr("codesign", path),
                "display_rc": 1, "display_stdout": b"",
                "display_stderr": recovery_absent_stderr("codesign", path),
                "complete_eof": True, "after_stat": b"",
            }
        elif record["cdhash"] is None:
            executable_results[path] = {
                "before_stat": recovery_stat_bytes(record),
                "verify_rc": 1, "verify_stdout": b"",
                "verify_stderr": b"invalid partial code\n",
                "display_rc": 1, "display_stdout": b"",
                "display_stderr": b"invalid partial code\n",
                "complete_eof": True, "after_stat": recovery_stat_bytes(record),
            }
        else:
            identifier = (
                "se.nortropic.runtime-cleanup-installer"
                if path == str(PROTECTED_INSTALLER)
                else "se.nortropic.runtime-cleanup-mediator"
            )
            executable_results[path] = {
                "before_stat": recovery_stat_bytes(record),
                "verify_rc": 0, "verify_stdout": b"", "verify_stderr": b"",
                "display_rc": 0, "display_stdout": b"",
                "display_stderr": (
                    f"Identifier={identifier}\nCDHash={record['cdhash']}\n"
                ).encode(),
                "complete_eof": True, "after_stat": recovery_stat_bytes(record),
            }
    membership_results: dict[str, dict[str, Any]] = {}
    for path in RECOVERY_MEMBERSHIP_PATHS:
        children = memberships[path]
        if children is None:
            membership_results[path] = {
                "before_stat": b"", "find_rc": 1, "find_stdout": b"",
                "find_stderr": recovery_absent_stderr("find", path),
                "complete_eof": True,
                "after_stat": b"",
            }
        else:
            record = identities[path]
            assert record is not None
            encoded = b"".join(child.encode() + b"\0" for child in children)
            membership_results[path] = {
                "before_stat": recovery_stat_bytes(record), "find_rc": 0,
                "find_stdout": encoded, "find_stderr": b"",
                "complete_eof": True, "after_stat": recovery_stat_bytes(record),
            }
    return {
        "argv": FIRST_ROOT_RECOVERY_ARGV, "identity": identity_results,
        "digest": digest_results, "executable": executable_results,
        "membership": membership_results,
    }


def exact_recovery_observation(
    observed: Any, identities: dict[str, dict[str, Any] | None],
    memberships: dict[str, list[str] | None],
) -> bool:
    if not isinstance(observed, dict) \
            or set(observed) != {"argv", "identity", "digest", "executable", "membership"} \
            or observed.get("argv") != FIRST_ROOT_RECOVERY_ARGV \
            or not isinstance(observed["identity"], dict) \
            or not isinstance(observed["digest"], dict) \
            or not isinstance(observed["executable"], dict) \
            or not isinstance(observed["membership"], dict) \
            or list(observed["identity"]) != RECOVERY_IDENTITY_PATHS \
            or list(observed["digest"]) != RECOVERY_REGULAR_PATHS \
            or list(observed["executable"]) != RECOVERY_EXECUTABLE_PATHS \
            or list(observed["membership"]) != RECOVERY_MEMBERSHIP_PATHS:
        return False
    for path in RECOVERY_IDENTITY_PATHS:
        result = observed["identity"][path]
        record = identities[path]
        if not isinstance(result, dict) or set(result) != {
            "before_stat_rc", "before_stat_stdout", "before_stat_stderr",
            "before_stat_complete_eof",
            "ls_rc", "ls_stdout", "ls_stderr", "ls_complete_eof",
            "after_stat_rc", "after_stat_stdout", "after_stat_stderr",
            "after_stat_complete_eof",
        } or any(type(result[key]) is not int for key in (
            "before_stat_rc", "ls_rc", "after_stat_rc",
        )) \
                or any(type(result[key]) is not bool for key in (
                    "before_stat_complete_eof", "ls_complete_eof",
                    "after_stat_complete_eof",
                )) \
                or any(type(result[key]) is not bytes for key in (
                    "before_stat_stdout", "before_stat_stderr", "ls_stdout",
                    "ls_stderr", "after_stat_stdout", "after_stat_stderr",
                )) \
                or any(len(result[key]) > RECOVERY_OUTPUT_CAP for key in (
                    "before_stat_stdout", "before_stat_stderr", "ls_stdout",
                    "ls_stderr", "after_stat_stdout", "after_stat_stderr",
                )):
            return False
        if record is None:
            if not (
                result["before_stat_rc"] == result["ls_rc"]
                == result["after_stat_rc"] == 1
                and result["before_stat_stdout"] == result["ls_stdout"]
                == result["after_stat_stdout"] == b""
                and result["before_stat_stderr"]
                == result["after_stat_stderr"] == recovery_absent_stderr("stat", path)
                and result["ls_stderr"] == recovery_absent_stderr("ls", path)
                and result["before_stat_complete_eof"] is True
                and result["ls_complete_eof"] is True
                and result["after_stat_complete_eof"] is True
            ):
                return False
            continue
        before = parse_recovery_stat(result["before_stat_stdout"])
        after = parse_recovery_stat(result["after_stat_stdout"])
        if before is None or before != after \
                or not result["before_stat_complete_eof"] \
                or not result["ls_complete_eof"] \
                or not result["after_stat_complete_eof"] \
                or result["before_stat_rc"] != 0 or result["ls_rc"] != 0 \
                or result["after_stat_rc"] != 0 \
                or result["before_stat_stderr"] != b"" \
                or result["ls_stderr"] != b"" or result["after_stat_stderr"] != b"" \
                or not parse_closed_acl_xattr_ls(
                    result["ls_stdout"], path, record.get("xattrs"),
                ) \
                or any(before[key] != record[key] for key in (
                    "type", "uid", "gid", "mode", "nlink", "flags", "dev", "ino",
                )) \
                or (record["type"] == "regular" and before["size"] != record["size"]) \
                or record.get("acl") != [] \
                or record.get("xattrs") not in ([], [PROVENANCE_XATTR]):
            return False
    for path in RECOVERY_REGULAR_PATHS:
        result = observed["digest"][path]
        record = identities[path]
        if not isinstance(result, dict) or set(result) != {
            "before_stat", "openssl_rc", "openssl_stdout", "openssl_stderr",
            "complete_eof", "after_stat",
        } or type(result["openssl_rc"]) is not int \
                or type(result["complete_eof"]) is not bool \
                or any(type(result[key]) is not bytes for key in (
                    "before_stat", "openssl_stdout", "openssl_stderr", "after_stat",
                )) \
                or any(len(result[key]) > RECOVERY_OUTPUT_CAP for key in (
                    "before_stat", "openssl_stdout", "openssl_stderr", "after_stat",
                )):
            return False
        if record is None:
            if not (
                result["before_stat"] == result["openssl_stdout"]
                == result["after_stat"] == b"" and result["openssl_rc"] == 1
                and result["openssl_stderr"] == recovery_absent_stderr("openssl", path)
                and result["complete_eof"] is True
            ):
                return False
            continue
        before = parse_recovery_stat(result["before_stat"])
        after = parse_recovery_stat(result["after_stat"])
        digest_match = re.fullmatch(
            rf"([0-9a-f]{{64}}) \*{re.escape(path)}\n".encode(),
            result["openssl_stdout"],
        )
        if before is None or before != after or before["type"] != "regular" \
                or result["openssl_rc"] != 0 or result["openssl_stderr"] != b"" \
                or result["complete_eof"] is not True \
                or digest_match is None \
                or (
                    record["sha256"] is not None
                    and digest_match.group(1).decode() != record["sha256"]
                ):
            return False
    for path in RECOVERY_EXECUTABLE_PATHS:
        result = observed["executable"][path]
        record = identities[path]
        byte_keys = (
            "before_stat", "verify_stdout", "verify_stderr", "display_stdout",
            "display_stderr", "after_stat",
        )
        if not isinstance(result, dict) or set(result) != {
            *byte_keys, "verify_rc", "display_rc", "complete_eof",
        } or any(type(result[key]) is not int for key in ("verify_rc", "display_rc")) \
                or type(result["complete_eof"]) is not bool \
                or any(type(result[key]) is not bytes for key in byte_keys) \
                or any(len(result[key]) > RECOVERY_OUTPUT_CAP for key in byte_keys):
            return False
        if record is None:
            if not (
                result["before_stat"] == result["verify_stdout"]
                == result["display_stdout"] == result["after_stat"] == b""
                and result["verify_rc"] == result["display_rc"] == 1
                and result["verify_stderr"] == result["display_stderr"]
                == recovery_absent_stderr("codesign", path)
                and result["complete_eof"] is True
            ):
                return False
            continue
        before = parse_recovery_stat(result["before_stat"])
        after = parse_recovery_stat(result["after_stat"])
        if before is None or before != after or result["complete_eof"] is not True:
            return False
        if record["cdhash"] is None:
            if not (
                result["verify_rc"] != 0 and result["display_rc"] != 0
                and result["verify_stdout"] == result["display_stdout"] == b""
                and 0 < len(result["verify_stderr"]) <= RECOVERY_OUTPUT_CAP
                and 0 < len(result["display_stderr"]) <= RECOVERY_OUTPUT_CAP
                and result["verify_stderr"].endswith(b"\n")
                and result["display_stderr"].endswith(b"\n")
            ):
                return False
            continue
        identifier = (
            "se.nortropic.runtime-cleanup-installer"
            if path == str(PROTECTED_INSTALLER)
            else "se.nortropic.runtime-cleanup-mediator"
        )
        try:
            display = result["display_stderr"].decode("utf-8")
        except UnicodeError:
            return False
        if not (
            result["verify_rc"] == result["display_rc"] == 0
            and result["verify_stdout"] == result["verify_stderr"]
            == result["display_stdout"] == b""
            and len(re.findall(r"^Identifier=", display, re.MULTILINE)) == 1
            and len(re.findall(r"^CDHash=", display, re.MULTILINE)) == 1
            and f"Identifier={identifier}\n" in display
            and f"CDHash={record['cdhash']}\n" in display
        ):
            return False
    for path in RECOVERY_MEMBERSHIP_PATHS:
        result = observed["membership"][path]
        children = memberships[path]
        if not isinstance(result, dict) or set(result) != {
            "before_stat", "find_rc", "find_stdout", "find_stderr",
            "complete_eof", "after_stat",
        } or type(result["find_rc"]) is not int \
                or type(result["complete_eof"]) is not bool \
                or any(type(result[key]) is not bytes for key in (
                    "before_stat", "find_stdout", "find_stderr", "after_stat",
                )) \
                or any(len(result[key]) > RECOVERY_OUTPUT_CAP for key in (
                    "before_stat", "find_stdout", "find_stderr", "after_stat",
                )):
            return False
        if children is None:
            if not (
                result["before_stat"] == result["after_stat"] == result["find_stdout"] == b""
                and result["find_rc"] == 1 and result["complete_eof"] is True
                and result["find_stderr"] == recovery_absent_stderr("find", path)
            ):
                return False
            continue
        before = parse_recovery_stat(result["before_stat"])
        after = parse_recovery_stat(result["after_stat"])
        if before is None or before != after or before["type"] != "directory" \
                or result["find_rc"] != 0 or result["find_stderr"] != b"" \
                or result["complete_eof"] is not True \
                or parse_recovery_membership(result["find_stdout"], path) != children:
            return False
    return True


def bootstrap_recovery_fixture(
    phase: str, *, mediator_size: int, mediator_sha256: str,
    mediator_cdhash: str, installer_size: int, installer_sha256: str,
    installer_cdhash: str,
) -> dict[str, Any]:
    index = BOOTSTRAP_CRASH_PHASES.index(phase)
    restaging = phase in {"RESTAGE_INSTALLER_PARTIAL", "RESTAGE_INSTALLER_READY"}
    objects: dict[str, dict[str, Any]] = {}
    if phase != "COMPLETE":
        objects[".install"] = bootstrap_object(
            "directory", 0o700, 60,
            nlink=2 if phase == "CONTROLLER_DIR_REMOVED" else 3,
        )
    if index <= BOOTSTRAP_CRASH_PHASES.index("RUNTIME_DIR_REMOVED") or restaging:
        objects[".install/controller"] = bootstrap_object(
            "directory", 0o700, 61,
            nlink=3 if index <= BOOTSTRAP_CRASH_PHASES.index("INSTALLER_UNLINKED") or restaging else 2,
        )
    if index <= BOOTSTRAP_CRASH_PHASES.index("INSTALLER_UNLINKED") or restaging:
        objects[".install/controller/runtime-cleanup"] = bootstrap_object(
            "directory", 0o700, 62,
        )
    if index < BOOTSTRAP_CRASH_PHASES.index("INSTALLER_UNLINKED") or restaging:
        partial_installer = phase == "RESTAGE_INSTALLER_PARTIAL"
        objects[".install/controller/runtime-cleanup/install"] = bootstrap_object(
            "regular", 0o644 if partial_installer else 0o500,
            42 if restaging else 41,
            size=installer_size // 2 if partial_installer else installer_size,
            digest=("02" * 32) if partial_installer else installer_sha256,
        )
        objects[".install/controller/runtime-cleanup/install"]["cdhash"] = (
            None if partial_installer else installer_cdhash
        )
        objects[".install/controller/runtime-cleanup/install"]["durable"] = not partial_installer
    if BOOTSTRAP_CRASH_PHASES.index("MEDIATOR_PARTIAL") <= index \
            < BOOTSTRAP_CRASH_PHASES.index("HELPER_PUBLISHED"):
        partial = phase == "MEDIATOR_PARTIAL"
        objects[".install/mediator"] = bootstrap_object(
            "regular",
            0o4555 if index >= BOOTSTRAP_CRASH_PHASES.index("MEDIATOR_READY") else 0o400,
            63,
            size=mediator_size // 2 if partial else mediator_size,
            digest=("01" * 32) if partial else mediator_sha256,
        )
        objects[".install/mediator"]["cdhash"] = None if partial else mediator_cdhash
        objects[".install/mediator"]["durable"] = not partial
    for offset, name in enumerate(LAYOUT):
        threshold = BOOTSTRAP_CRASH_PHASES.index(f"{name.upper()}_DURABLE")
        if index >= threshold:
            objects[name] = bootstrap_object(
                "directory", 0o555, 70 + offset,
                nlink=3 if name == "s" and index >= BOOTSTRAP_CRASH_PHASES.index("LOCK_DURABLE") else 2,
            )
    if index >= BOOTSTRAP_CRASH_PHASES.index("LOCK_DURABLE"):
        objects["s/lock"] = bootstrap_object(
            "regular", 0o600, 80, size=0, digest=sha(b""),
        )
    namespace = bootstrap_object(
        "directory",
        0o555 if index >= BOOTSTRAP_CRASH_PHASES.index("NAMESPACE_PUBLISHED") else 0o700,
        59,
        nlink=2 + sum(
            1 for path, value in objects.items()
            if "/" not in path and value["type"] == "directory"
        ),
    )
    helper = None
    if index >= BOOTSTRAP_CRASH_PHASES.index("HELPER_PUBLISHED"):
        helper = bootstrap_object(
            "regular", 0o4555, 63, size=mediator_size,
            digest=mediator_sha256,
        )
        helper["cdhash"] = mediator_cdhash
    if phase == "COMPLETE":
        objects = {
            path: value for path, value in objects.items()
            if path in {*LAYOUT, "s/lock"}
        }
        namespace["nlink"] = 7
    if phase == "COMPLETE":
        recovery_action = "NONE"
        recovery_argv: list[list[str]] = []
    elif phase == "CONTROLLER_DIR_REMOVED":
        recovery_action = "RESTAGE_EXACT_INSTALLER_THEN_BOOTSTRAP"
        recovery_argv = [FIRST_ROOT_ARGV[2], FIRST_ROOT_ARGV[3], *FIRST_ROOT_ARGV[4:]]
    elif phase == "RUNTIME_DIR_REMOVED":
        recovery_action = "RESTAGE_EXACT_INSTALLER_THEN_BOOTSTRAP"
        recovery_argv = [FIRST_ROOT_ARGV[3], *FIRST_ROOT_ARGV[4:]]
    elif phase in {"INSTALLER_UNLINKED", "RESTAGE_INSTALLER_PARTIAL"}:
        recovery_action = "RESTAGE_EXACT_INSTALLER_THEN_BOOTSTRAP"
        recovery_argv = FIRST_ROOT_ARGV[4:]
    elif phase == "RESTAGE_INSTALLER_READY":
        recovery_action = "EXEC_PROTECTED_BOOTSTRAP"
        recovery_argv = FIRST_ROOT_ARGV[-1:]
    else:
        recovery_action = "EXEC_PROTECTED_BOOTSTRAP"
        recovery_argv = FIRST_ROOT_ARGV[-1:]
    restage_binding = None
    if phase in {
        "INSTALLER_UNLINKED", "RUNTIME_DIR_REMOVED", "CONTROLLER_DIR_REMOVED",
        "RESTAGE_INSTALLER_PARTIAL", "RESTAGE_INSTALLER_READY",
    }:
        if phase == "RESTAGE_INSTALLER_PARTIAL":
            observed_stream: dict[str, Any] | None = {
                "fd": 0, "stream_count": 1, "length": installer_size // 2,
                "sha256": "02" * 32, "eof": False,
            }
            attempt_state = "PARTIAL_REAPED"
            observed_source = prestage_source_identity(installer_size, installer_sha256)
            source_closed: bool | None = True
            dd_reaped: bool | None = True
            dd_result: dict[str, Any] | None = prestage_dd_result(False)
        elif phase == "RESTAGE_INSTALLER_READY":
            observed_stream = {
                "fd": 0, "stream_count": 1, "length": installer_size,
                "sha256": installer_sha256, "eof": True,
            }
            attempt_state = "READY"
            observed_source = prestage_source_identity(installer_size, installer_sha256)
            source_closed = True
            dd_reaped = True
            dd_result = prestage_dd_result(True)
        else:
            observed_stream = None
            attempt_state = "REQUIRED_NOT_STARTED"
            observed_source = None
            source_closed = None
            dd_reaped = None
            dd_result = None
        restage_binding = {
            "attempt_state": attempt_state,
            "required_fresh_source_identity": prestage_source_identity(
                installer_size, installer_sha256,
            ),
            "required_stream": {
                "fd": 0, "stream_count": 1, "length": installer_size,
                "sha256": installer_sha256, "eof": True,
            },
            "observed_source_identity": observed_source,
            "observed_stream": observed_stream,
            "source_fd_closed": source_closed, "dd_direct_child_reaped": dd_reaped,
            "dd_result": dd_result,
            "second_stream": False, "descriptor_inventory_after_dd": [1, 2],
        }
    identities, memberships = recovery_expected_bindings(namespace, objects, helper)
    return {
        "phase": phase, "operation": "bootstrap", "caller_inputs": [],
        "environment": [], "stdin": "CLOSED", "inherited_fds": [1, 2],
        "embedded_section": "__H039RO,__h039med",
        "embedded_size": mediator_size, "embedded_sha256": mediator_sha256,
        "namespace": namespace, "namespace_objects": objects,
        "installed_helper": helper, "recovery_action": recovery_action,
        "recovery_argv": recovery_argv,
        "recovery_observation": recovery_observation_fixture(identities, memberships),
        "restage_binding": restage_binding,
        "process_lifecycle": {
            "active": [], "descendants": [], "root_tool_reaped": True,
            "process_scan": False, "signal": False,
        },
    }


def bootstrap_recovery_oracle(
    state: dict[str, Any], *, mediator_size: int, mediator_sha256: str,
    mediator_cdhash: str, installer_size: int, installer_sha256: str,
    installer_cdhash: str,
) -> bool:
    if type(mediator_size) is not int or not 0 < mediator_size <= 4194304 \
            or type(installer_size) is not int or not 0 < installer_size <= 4194304 \
            or not valid_hex(mediator_sha256) or not valid_hex(installer_sha256) \
            or not valid_hex(mediator_cdhash, 40) or not valid_hex(installer_cdhash, 40):
        return False
    if not isinstance(state, dict) or set(state) != {
        "phase", "operation", "caller_inputs", "environment", "stdin",
        "inherited_fds", "embedded_section", "embedded_size",
        "embedded_sha256", "namespace", "namespace_objects",
        "installed_helper", "recovery_action", "recovery_argv",
        "recovery_observation", "restage_binding", "process_lifecycle",
    }:
        return False
    if type(state.get("embedded_size")) is not int \
            or not isinstance(state.get("inherited_fds"), list) \
            or any(type(item) is not int for item in state["inherited_fds"]) \
            or not exact_identity_integer_types(state.get("namespace")) \
            or not isinstance(state.get("namespace_objects"), dict) \
            or any(
                not exact_identity_integer_types(value)
                for value in state["namespace_objects"].values()
            ) \
            or any(
                "durable" in value and type(value["durable"]) is not bool
                for value in state["namespace_objects"].values()
            ) \
            or (
                state.get("installed_helper") is not None
                and not exact_identity_integer_types(state["installed_helper"])
            ):
        return False
    lifecycle = state.get("process_lifecycle")
    if not isinstance(lifecycle, dict) \
            or any(
                not isinstance(lifecycle.get(key), list)
                or any(type(item) is not int for item in lifecycle[key])
                for key in ("active", "descendants")
            ) \
            or any(type(lifecycle.get(key)) is not bool for key in (
                "root_tool_reaped", "process_scan", "signal",
            )):
        return False
    phase = state.get("phase")
    if phase not in BOOTSTRAP_CRASH_PHASES:
        return False
    restage_binding = state.get("restage_binding")
    if restage_binding is not None:
        if not isinstance(restage_binding, dict) or set(restage_binding) != {
            "attempt_state", "required_fresh_source_identity", "required_stream",
            "observed_source_identity", "observed_stream", "source_fd_closed",
            "dd_direct_child_reaped", "dd_result", "second_stream",
            "descriptor_inventory_after_dd",
        } or not exact_identity_integer_types(
            restage_binding.get("required_fresh_source_identity"),
        ) or any(type(restage_binding.get(key)) is not bool for key in ("second_stream",)) \
                or not isinstance(restage_binding.get("descriptor_inventory_after_dd"), list) \
                or any(
                    type(item) is not int
                    for item in restage_binding["descriptor_inventory_after_dd"]
                ):
            return False
        for key in ("required_stream", "observed_stream"):
            stream = restage_binding.get(key)
            if stream is not None and (
                not isinstance(stream, dict)
                or any(type(stream.get(item)) is not int for item in (
                    "fd", "stream_count", "length",
                ))
                or type(stream.get("eof")) is not bool
            ):
                return False
        observed_source = restage_binding.get("observed_source_identity")
        if observed_source is not None and (
            not exact_identity_integer_types(observed_source)
            or any(type(observed_source.get(key)) is not bool for key in (
                "full_read", "eof", "closed",
            ))
        ):
            return False
        for key in ("source_fd_closed", "dd_direct_child_reaped"):
            if restage_binding.get(key) is not None \
                    and type(restage_binding[key]) is not bool:
                return False
        dd_result = restage_binding.get("dd_result")
        if dd_result is not None and dd_result not in (
            prestage_dd_result(False), prestage_dd_result(True),
        ):
            return False
    identities, memberships = recovery_expected_bindings(
        state["namespace"], state["namespace_objects"], state["installed_helper"],
    )
    if not exact_recovery_observation(
        state.get("recovery_observation"), identities, memberships,
    ):
        return False
    if phase == "MEDIATOR_PARTIAL":
        partial = state.get("namespace_objects", {}).get(".install/mediator", {})
        size = partial.get("size")
        if type(size) is not int or not 0 <= size <= mediator_size \
                or not valid_hex(partial.get("sha256")) \
                or partial.get("cdhash") != (
                    mediator_cdhash
                    if size == mediator_size and partial.get("sha256") == mediator_sha256
                    else None
                ) \
                or partial.get("durable") is not False:
            return False
    if phase == "RESTAGE_INSTALLER_PARTIAL":
        partial = state.get("namespace_objects", {}).get(
            ".install/controller/runtime-cleanup/install", {},
        )
        size = partial.get("size")
        partial_mode = partial.get("mode")
        observed_stream = (
            restage_binding.get("observed_stream")
            if isinstance(restage_binding, dict) else None
        )
        if type(size) is not int or not 0 <= size <= 4194305 \
                or type(partial_mode) is not int \
                or partial_mode & ~0o666 or not valid_hex(partial.get("sha256")) \
                or partial.get("cdhash") != (
                    installer_cdhash
                    if size == installer_size and partial.get("sha256") == installer_sha256
                    else None
                ) \
                or not isinstance(restage_binding, dict) \
                or restage_binding.get("dd_result") not in (
                    prestage_dd_result(False), prestage_dd_result(True),
                ) \
                or partial.get("durable") is not restage_binding["dd_result"]["durable"]:
            return False
        if not isinstance(observed_stream, dict) \
                or observed_stream.get("fd") != 0 \
                or observed_stream.get("stream_count") != 1 \
                or observed_stream.get("length") != size \
                or partial.get("sha256") != observed_stream.get("sha256") \
                or not valid_hex(observed_stream.get("sha256")) \
                or (
                    size == installer_size
                    and observed_stream["sha256"] == installer_sha256
                    and observed_stream.get("eof") is True
                    and restage_binding["dd_result"] == prestage_dd_result(True)
                ):
            return False
    expected = bootstrap_recovery_fixture(
        phase, mediator_size=mediator_size, mediator_sha256=mediator_sha256,
        mediator_cdhash=mediator_cdhash, installer_size=installer_size,
        installer_sha256=installer_sha256, installer_cdhash=installer_cdhash,
    )
    if phase == "MEDIATOR_PARTIAL":
        expected["namespace_objects"][".install/mediator"]["size"] = size
        expected["namespace_objects"][".install/mediator"]["sha256"] = partial["sha256"]
        expected["namespace_objects"][".install/mediator"]["cdhash"] = partial["cdhash"]
    if phase == "RESTAGE_INSTALLER_PARTIAL":
        expected["namespace_objects"][
            ".install/controller/runtime-cleanup/install"
        ]["size"] = size
        expected["namespace_objects"][
            ".install/controller/runtime-cleanup/install"
        ]["mode"] = partial_mode
        expected["namespace_objects"][
            ".install/controller/runtime-cleanup/install"
        ]["sha256"] = partial["sha256"]
        expected["namespace_objects"][
            ".install/controller/runtime-cleanup/install"
        ]["cdhash"] = partial["cdhash"]
        expected["namespace_objects"][
            ".install/controller/runtime-cleanup/install"
        ]["durable"] = partial["durable"]
        expected["restage_binding"]["observed_stream"] = copy.deepcopy(observed_stream)
        expected["restage_binding"]["dd_result"] = copy.deepcopy(
            restage_binding["dd_result"],
        )
    if phase in {"MEDIATOR_PARTIAL", "RESTAGE_INSTALLER_PARTIAL"}:
        expected_identities, expected_memberships = recovery_expected_bindings(
            expected["namespace"], expected["namespace_objects"],
            expected["installed_helper"],
        )
        expected["recovery_observation"] = recovery_observation_fixture(
            expected_identities, expected_memberships,
        )
    return state == expected



def valid_hex(value: Any, length: int = 64) -> bool:
    return isinstance(value, str) and re.fullmatch(rf"[0-9a-f]{{{length}}}", value) is not None


def request_oracle(raw: bytes, *, used_nonces: set[str]) -> tuple[bool, str]:
    try:
        value = strict_json(raw)
    except Rig:
        return False, "INVALID_JSON"
    if not isinstance(value, dict) or len(raw) > 16384:
        return False, "INVALID_FRAME"
    operation = value.get("operation")
    keys = sorted(value)
    if operation == "create-v1":
        expected = sorted(["operation", "request_nonce", "schema_version"])
    elif operation == "cleanup-v1":
        expected = sorted(["capability", "operation", "request_nonce", "schema_version"])
    else:
        return False, "INVALID_OPERATION"
    if keys != expected or type(value.get("schema_version")) is not int \
            or value.get("schema_version") != 1:
        return False, "INVALID_KEYS"
    nonce = value.get("request_nonce")
    if not valid_hex(nonce) or nonce in used_nonces:
        return False, "INVALID_NONCE"
    if operation == "cleanup-v1" and not valid_hex(value.get("capability")):
        return False, "INVALID_CAPABILITY"
    return True, operation


def request_stream_oracle(
    value: dict[str, Any], trailing: bytes, *, clean_eof: bool,
    ancillary_count: int, used_nonces: set[str],
) -> tuple[bool, str]:
    json_raw = canonical(value)
    stream = struct.pack(">I", len(json_raw)) + json_raw + trailing
    if not clean_eof or ancillary_count != 0 or trailing:
        return False, "STREAM_NOT_CLOSED"
    if len(stream) < 4 or struct.unpack(">I", stream[:4])[0] != len(json_raw):
        return False, "INVALID_FRAME"
    ok, reason = request_oracle(json_raw, used_nonces=used_nonces)
    if not ok:
        return False, reason
    return True, str(value.get("operation"))


def modeled_receipt_temp(state: dict[str, Any]) -> dict[str, Any]:
    effect = {
        "schema_version": 1,
        "sequence": state.get("sequence"),
        "runtime_id": state.get("runtime_id"),
        "capability_sha256": state.get("capability_sha256"),
        "create_request_nonce": state.get("create_request_nonce"),
        "cleanup_request_nonce": state.get("cleanup_request_nonce"),
        "zero_runtime_residue": True,
    }
    return {
        "schema_version": 1,
        "sequence": state.get("sequence"),
        "runtime_id": state.get("runtime_id"),
        "capability_sha256": state.get("capability_sha256"),
        "create_request_nonce": state.get("create_request_nonce"),
        "cleanup_request_nonce": state.get("cleanup_request_nonce"),
        "effect_sha256": sha(canonical(effect)),
    }


def cleanup_state_orientation_valid(state: dict[str, Any]) -> bool:
    phase = state.get("phase")
    location = state.get("location")
    present = state.get("state_present", True)
    temp = state.get("receipt_temp", False)
    residue = state.get("residue")
    if phase == "ACTIVE":
        return present and not temp and location == "active"
    if phase == "QUARANTINING":
        return present and not temp and location in {"active", "quarantine"}
    if phase != "CLEANING":
        return False
    if not temp:
        return present and location == "quarantine"
    return (
        residue == []
        and location in {"quarantine", None}
        and (present or location is None)
        and state.get("receipt_temp_record") == modeled_receipt_temp(state)
    )


MODEL_CURRENT_FIELDS = {
    "schema_version", "phase", "runtime_id", "capability_sha256",
    "create_request_nonce", "cleanup_request_nonce", "sequence",
    "object_dev", "object_ino", "runtime_dev", "runtime_ino",
    "fifo_dev", "fifo_ino", "portal_dev", "portal_ino",
    "socket_dev", "socket_ino", "record_sha256",
}
MODEL_PYTHON_DIGEST = "ab" * 32


def modeled_fixed_q_members(record: dict[str, Any], progress: int) -> tuple[Any, ...]:
    full = (
        ("h", "directory", 0, 0, 0o700, None, None, None),
        ("h/r", "directory", 501, 20, 0o700,
         record["runtime_dev"], record["runtime_ino"], None),
        ("h/l", "fifo", 0, 0, 0o600,
         record["fifo_dev"], record["fifo_ino"], None),
        ("p", "directory", 0, 20, 0o550,
         record["portal_dev"], record["portal_ino"], None),
        ("p/c", "socket", 0, 20, 0o620,
         record["socket_dev"], record["socket_ino"], None),
        ("p/python", "regular", 0, 0, 0o555, None, None, MODEL_PYTHON_DIGEST),
    )
    names_by_progress = {
        0: ("h", "h/r", "h/l", "p", "p/c", "p/python"),
        1: ("h", "h/l", "p", "p/c", "p/python"),
        2: ("h", "p", "p/c", "p/python"),
        3: ("p", "p/c", "p/python"),
        4: ("p", "p/python"),
        5: ("p",),
        6: (),
    }
    names = names_by_progress.get(progress)
    return () if names is None else tuple(item for item in full if item[0] in names)


def valid_runtime_tree(members: Any, runtime_dev: int) -> bool:
    if not isinstance(members, tuple) or len(members) > 4096:
        return False
    paths: list[str] = []
    total = 0
    for item in members:
        if not isinstance(item, tuple) or len(item) != 5:
            return False
        path, kind, dev, ino, size = item
        components = path.split("/") if isinstance(path, str) else []
        if not isinstance(path, str) or not path or path.startswith("/") \
                or any(part in {"", ".", ".."} or len(part.encode("utf-8")) > 255
                       for part in components) \
                or len(components) > 64 \
                or kind not in {"directory", "regular", "symlink", "fifo", "socket"} \
                or any(type(value) is not int for value in (dev, ino, size)) \
                or dev != runtime_dev or ino <= 0 or size < 0:
            return False
        paths.append(path)
        total += size if kind == "regular" else 0
    if paths != sorted(paths) or len(paths) != len(set(paths)) \
            or len({(item[2], item[3]) for item in members}) != len(members) \
            or total > 67108864:
        return False
    directories = {
        item[0] for item in members if item[1] == "directory"
    }
    for path in paths:
        components = path.split("/")
        for index in range(1, len(components)):
            parent = "/".join(components[:index])
            if parent not in directories:
                return False
    return True


def modeled_current_record(state: dict[str, Any], phase: str, nonce: str) -> dict[str, Any]:
    record = {
        "schema_version": 1, "phase": phase,
        "runtime_id": state["runtime_id"],
        "capability_sha256": state["capability_sha256"],
        "create_request_nonce": state["create_request_nonce"],
        "cleanup_request_nonce": nonce, "sequence": state["sequence"],
        **state["identity_fields"],
    }
    return {**record, "record_sha256": sha(canonical(record))}


def valid_modeled_current_record(record: dict[str, Any]) -> bool:
    if not isinstance(record, dict) or set(record) != MODEL_CURRENT_FIELDS:
        return False
    body = {key: value for key, value in record.items() if key != "record_sha256"}
    identity_keys = {
        "object_dev", "object_ino", "runtime_dev", "runtime_ino",
        "fifo_dev", "fifo_ino", "portal_dev", "portal_ino",
        "socket_dev", "socket_ino",
    }
    return (
        type(record["schema_version"]) is int and record["schema_version"] == 1
        and isinstance(record["phase"], str)
        and record["phase"] in {"QUARANTINING", "CLEANING"}
        and isinstance(record["runtime_id"], str)
        and re.fullmatch(r"[0-9a-f]{32}", record["runtime_id"]) is not None
        and valid_hex(record["capability_sha256"])
        and valid_hex(record["create_request_nonce"])
        and valid_hex(record["cleanup_request_nonce"])
        and type(record["sequence"]) is int and record["sequence"] > 0
        and all(type(record[key]) is int and record[key] > 0 for key in identity_keys)
        and record["record_sha256"] == sha(canonical(body))
    )


def modeled_predecessor_receipt(state: dict[str, Any]) -> dict[str, Any] | None:
    if state["sequence"] == 1:
        return None
    receipt = {
        "schema_version": 1, "sequence": state["sequence"] - 1,
        "runtime_id": "77" * 16,
        "capability_sha256": "55" * 32,
        "create_request_nonce": state["last_create_request_nonce"],
        "cleanup_request_nonce": state["last_cleanup_request_nonce"],
    }
    effect = {**receipt, "zero_runtime_residue": True}
    return {**receipt, "effect_sha256": sha(canonical(effect))}


def valid_modeled_predecessor(current: dict[str, Any], predecessor: Any) -> bool:
    if not isinstance(current, dict) or type(current.get("sequence")) is not int:
        return False
    if current["sequence"] == 1:
        return predecessor is None
    keys = {
        "schema_version", "sequence", "runtime_id", "capability_sha256",
        "create_request_nonce", "cleanup_request_nonce", "effect_sha256",
    }
    if not isinstance(predecessor, dict) or set(predecessor) != keys:
        return False
    effect = {key: predecessor[key] for key in keys if key != "effect_sha256"}
    effect["zero_runtime_residue"] = True
    return (
        type(predecessor["schema_version"]) is int
        and predecessor["schema_version"] == 1
        and type(predecessor["sequence"]) is int
        and predecessor["sequence"] == current["sequence"] - 1
        and isinstance(predecessor["runtime_id"], str)
        and re.fullmatch(r"[0-9a-f]{32}", predecessor["runtime_id"]) is not None
        and all(valid_hex(predecessor[key]) for key in (
            "capability_sha256", "create_request_nonce", "cleanup_request_nonce",
        ))
        and predecessor["create_request_nonce"]
        != predecessor["cleanup_request_nonce"]
        and predecessor["effect_sha256"] == sha(canonical(effect))
    )


def reconcile_current_tmp_model(
    current: dict[str, Any], temporary: dict[str, Any], *, location: str,
    receipt_temp: bool, predecessor: dict[str, Any] | None,
    q_object: dict[str, Any] | None, active_present: bool, q_count: int,
    current_tmp_fsynced: bool, current_raw: bytes, temporary_raw: bytes,
    current_meta: dict[str, Any], temporary_meta: dict[str, Any],
) -> tuple[bool, dict[str, Any]]:
    before = copy.deepcopy(current)
    if not valid_modeled_current_record(current) \
            or not valid_modeled_current_record(temporary) \
            or not valid_modeled_predecessor(current, predecessor):
        return False, before
    def valid_state_file_meta(meta: Any) -> bool:
        return (
            isinstance(meta, dict)
            and set(meta) == {"type", "uid", "gid", "mode", "nlink", "fsynced"}
            and meta["type"] == "regular"
            and all(type(meta[key]) is int for key in ("uid", "gid", "mode", "nlink"))
            and meta["uid"] == 0 and meta["gid"] == 0
            and meta["mode"] == 0o444 and meta["nlink"] == 1
            and meta["fsynced"] is True
        )
    if not isinstance(current_raw, bytes) or not isinstance(temporary_raw, bytes) \
            or current_raw != canonical(current) \
            or temporary_raw != canonical(temporary) \
            or not valid_state_file_meta(current_meta) \
            or not valid_state_file_meta(temporary_meta):
        return False, before
    if receipt_temp or current_tmp_fsynced is not True or location != "quarantine" \
            or type(active_present) is not bool or active_present \
            or type(q_count) is not int or q_count != 1 \
            or not isinstance(q_object, dict) \
            or temporary["phase"] != "CLEANING":
        return False, before
    if set(q_object) != {
        "name", "uid", "gid", "mode", "dev", "ino", "progress",
        "fixed_members", "runtime_members",
    } \
            or q_object["name"] != "o-" + current["runtime_id"] \
            or type(q_object["uid"]) is not int or q_object["uid"] != 0 \
            or type(q_object["gid"]) is not int or q_object["gid"] != 0 \
            or type(q_object["mode"]) is not int or q_object["mode"] != 0o555 \
            or type(q_object["dev"]) is not int or q_object["dev"] <= 0 \
            or q_object["dev"] != current["object_dev"] \
            or type(q_object["ino"]) is not int or q_object["ino"] <= 0 \
            or q_object["ino"] != current["object_ino"] \
            or type(q_object["progress"]) is not int \
            or q_object["progress"] not in range(7):
        return False, before
    if current["phase"] == "QUARANTINING":
        if q_object["progress"] != 0:
            return False, before
    if q_object["fixed_members"] != modeled_fixed_q_members(
        current, q_object["progress"],
    ):
        return False, before
    if q_object["progress"] > 0 and q_object["runtime_members"] != ():
        return False, before
    if not valid_runtime_tree(q_object["runtime_members"], current["runtime_dev"]):
        return False, before
    varying = {"phase", "cleanup_request_nonce", "record_sha256"}
    if any(current[key] != temporary[key] for key in MODEL_CURRENT_FIELDS - varying):
        return False, before
    old_nonce = current["cleanup_request_nonce"]
    new_nonce = temporary["cleanup_request_nonce"]
    if not valid_hex(old_nonce) or not valid_hex(new_nonce):
        return False, before
    ordinary = current["phase"] == "QUARANTINING" and new_nonce == old_nonce
    predecessor_nonces = set() if predecessor is None else {
        predecessor["create_request_nonce"], predecessor["cleanup_request_nonce"],
    }
    if old_nonce == current["create_request_nonce"] \
            or current["create_request_nonce"] in predecessor_nonces \
            or old_nonce in predecessor_nonces:
        return False, before
    collisions = {old_nonce, current["create_request_nonce"], *predecessor_nonces}
    fresh_resume = new_nonce not in collisions
    if not (ordinary or fresh_resume):
        return False, before
    temporary_bytes = temporary_raw
    return True, {
        "current_record": copy.deepcopy(temporary),
        "current_bytes": temporary_bytes,
        "current_sha256": sha(temporary_bytes),
        "current_tmp_present": False,
        "state_directory_fsynced": True,
        "recovery_continuation": {
            "operation": "cleanup-v1",
            "request_nonce": temporary["cleanup_request_nonce"],
            "capability_sha256": temporary["capability_sha256"],
            "current_sha256": sha(temporary_bytes),
        },
    }


def complete_promoted_cleanup_model(
    promoted: dict[str, Any], capability: str, request_nonce: str,
) -> tuple[bool, dict[str, Any]]:
    if not isinstance(promoted, dict) or set(promoted) != {
        "current_record", "current_bytes", "current_sha256", "current_tmp_present",
        "state_directory_fsynced", "recovery_continuation",
    } or promoted["current_tmp_present"] is not False:
        return False, copy.deepcopy(promoted)
    current = promoted["current_record"]
    if not valid_modeled_current_record(current) \
            or not isinstance(promoted["current_bytes"], bytes) \
            or not valid_hex(capability) or not valid_hex(request_nonce):
        return False, copy.deepcopy(promoted)
    expected_continuation = {
        "operation": "cleanup-v1", "request_nonce": request_nonce,
        "capability_sha256": current.get("capability_sha256"),
        "current_sha256": promoted.get("current_sha256"),
    }
    if promoted["current_bytes"] != canonical(current) \
            or promoted["current_sha256"] != sha(promoted["current_bytes"]) \
            or promoted["state_directory_fsynced"] is not True \
            or promoted["recovery_continuation"] != expected_continuation \
            or request_nonce != current["cleanup_request_nonce"] \
            or sha(bytes.fromhex(capability)) != current["capability_sha256"]:
        return False, copy.deepcopy(promoted)
    receipt_state = {
        "sequence": current["sequence"], "runtime_id": current["runtime_id"],
        "capability_sha256": current["capability_sha256"],
        "create_request_nonce": current["create_request_nonce"],
        "cleanup_request_nonce": current["cleanup_request_nonce"],
    }
    receipt = modeled_receipt_temp(receipt_state)
    return True, {
        "current_present": False, "current_tmp_present": False,
        "receipt_temp_present": False, "q_present": False, "residue": [],
        "receipt_record": receipt, "receipt_sha256": sha(canonical(receipt)),
    }


def promoted_pending_disposition(
    current: dict[str, Any], operation: str, request_nonce: str,
) -> str:
    if request_nonce == current["cleanup_request_nonce"]:
        return "REPLAY"
    if operation == "cleanup-v1":
        return "RESUME"
    return "CAPACITY"


def cleanup_model(
    *, request: dict[str, Any], state: dict[str, Any], lease_live: bool,
    attempt_identity: tuple[int, int], observed_identity: tuple[int, int],
    same_device: bool, crash_barrier: int | None = None,
) -> tuple[bool, dict[str, Any]]:
    before = copy.deepcopy(state)
    cap = request.get("capability")
    if set(request) != {"capability", "operation", "request_nonce", "schema_version"}:
        return False, before
    if request.get("operation") != "cleanup-v1" \
            or type(request.get("schema_version")) is not int \
            or request.get("schema_version") != 1:
        return False, before
    if not valid_hex(request.get("request_nonce")) or not valid_hex(cap):
        return False, before
    if state.get("capability_sha256") != sha(bytes.fromhex(cap)):
        return False, before
    if not cleanup_state_orientation_valid(state) or lease_live:
        return False, before
    accepted_nonce = state.get("cleanup_request_nonce", "")
    receipt_temp = state.get("receipt_temp", False)
    disposition = cleanup_nonce_disposition(state, request["request_nonce"])
    if state["phase"] == "ACTIVE":
        if accepted_nonce != "" or receipt_temp or disposition != "INITIAL":
            return False, before
    elif not valid_hex(accepted_nonce):
        return False, before
    elif disposition not in {"FRESH_RESUME", "TEMP_CONTINUATION"}:
        return False, before
    if attempt_identity != observed_identity or not same_device:
        return False, before
    out = copy.deepcopy(state)
    if out["phase"] == "ACTIVE":
        out["cleanup_request_nonce"] = request["request_nonce"]
        out["phase"] = "QUARANTINING"
    elif not receipt_temp:
        out["cleanup_request_nonce"] = request["request_nonce"]
    if crash_barrier == 1:
        return False, out
    if out["phase"] == "QUARANTINING":
        out["location"] = "quarantine"
    if crash_barrier == 2:
        return False, out
    out["phase"] = "CLEANING"
    if crash_barrier == 3:
        return False, out
    out["residue"] = []
    if not receipt_temp:
        out["receipt_temp"] = True
        out["receipt_temp_cleanup_request_nonce"] = out["cleanup_request_nonce"]
        out["receipt_temp_record"] = modeled_receipt_temp(out)
        out["receipt_temp_write_count"] = out.get("receipt_temp_write_count", 0) + 1
    if crash_barrier == 4:
        return False, out
    out["location"] = None
    if crash_barrier == 5:
        return False, out
    out["state_present"] = False
    if crash_barrier == 6:
        return False, out
    published_receipt = copy.deepcopy(out["receipt_temp_record"])
    out["phase"] = None
    out["receipt_temp"] = False
    out["receipt_temp_cleanup_request_nonce"] = None
    out["receipt_temp_record"] = None
    out["receipt_record"] = published_receipt
    out["receipt"] = sha(canonical(published_receipt))
    out["receipt_cleanup_request_nonce"] = out["cleanup_request_nonce"]
    return True, out


def cleanup_nonce_disposition(state: dict[str, Any], request_nonce: str) -> str:
    """Classify nonce authority without granting any state transition."""
    accepted = state.get("cleanup_request_nonce", "")
    collisions = {
        state.get("create_request_nonce"),
        state.get("last_create_request_nonce"),
        state.get("last_cleanup_request_nonce"),
    }
    if request_nonce in collisions:
        return "REPLAY"
    if state.get("phase") == "ACTIVE":
        return "INITIAL"
    if state.get("receipt_temp", False):
        if request_nonce == accepted \
                and state.get("receipt_temp_cleanup_request_nonce") == accepted \
                and accepted not in collisions:
            return "TEMP_CONTINUATION"
        if request_nonce == accepted:
            return "REPLAY"
        return "CAPACITY"
    if request_nonce == accepted:
        return "REPLAY"
    return "FRESH_RESUME"


def create_handoff_model(
    *, phase: str, ack: bytes | None, fifo_eof: bool, members_busy: bool,
) -> tuple[str, bool, bool]:
    """Return phase, descriptor-use authority, and recoverability."""
    if phase == "RESERVING":
        return "CREATING", False, True
    if phase == "CREATING":
        return "PUBLISHING", False, True
    if phase == "PUBLISHING":
        return "PREPARING", False, True
    if phase == "PREPARING":
        return "PREPARED", False, True
    if phase == "PREPARED":
        if ack == b"A":
            return "ACTIVE", True, False
        return "PREPARED", False, fifo_eof and not members_busy
    if phase == "ACTIVE":
        if fifo_eof and not members_busy:
            return "CLEANING", False, True
        return "ACTIVE", True, False
    raise Rig("invalid create handoff phase")


def causal_oracle_selftests() -> None:
    dd_bounded_stream_selftests()
    lexical_fixture = (
        'const char *a="//"; const char *b="/*literal*/"; '
        'const char *c="\\\"quoted\\\"";\n'
        '// closefrom(0) "/tmp/comment-path"\n'
        '/* system("/tmp/block-path"); */ int live = 1;\n'
    )
    normalized_fixture = c_semantic_source(lexical_fixture)
    check(
        '"//"' in normalized_fixture
        and '"/*literal*/"' in normalized_fixture
        and '"\\\"quoted\\\""' in normalized_fixture
        and "closefrom(0)" not in normalized_fixture
        and "system(" not in normalized_fixture
        and native_absolute_strings(lexical_fixture) == {"//", "/*literal*/"},
        "A_H039_R7_STRING_AWARE_C_COMMENT_NORMALIZATION",
    )
    absolute_fixture = "\n".join(
        f'const char *p{index}="{value}";'
        for index, value in enumerate(sorted(NATIVE_ABSOLUTE_STRINGS))
    )
    check(
        native_absolute_strings(absolute_fixture) == NATIVE_ABSOLUTE_STRINGS,
        "A_H039_R7_EXACT_CLOSED_NATIVE_ABSOLUTE_LITERAL_SET",
    )
    for label, mutant in (
        ("ADDED", absolute_fixture + '\nconst char *extra="/tmp/extra";'),
        ("REMOVED", absolute_fixture.split("\n", 1)[1]),
        ("SUBSTITUTED", absolute_fixture.replace('="/";', '="/tmp";', 1)),
    ):
        check(
            native_absolute_strings(mutant) != NATIVE_ABSOLUTE_STRINGS,
            f"N_H039_R7_NATIVE_ABSOLUTE_LITERAL_{label}",
        )
    check(
        native_absolute_strings(
            absolute_fixture + '\n// const char *commented="/tmp/decoy";\n',
        ) == NATIVE_ABSOLUTE_STRINGS,
        "N_H039_R7_COMMENTED_ABSOLUTE_LITERAL_NO_CREDIT",
    )
    function_fixture = c_semantic_source(
        'static int nested(void){\nif(1){return 2;}\nreturn 0;\n}\n',
    )
    nested_body = c_function_body(function_fixture, "nested")
    check(
        "if(1){return 2;}" in nested_body and "return 0;" in nested_body,
        "A_H039_R7_BALANCED_FUNCTION_BODY_EXTRACTION",
    )
    closure_tokens = (
        "getpid(", "PROC_PIDLISTFDS", "proc_pidinfo(",
        "struct proc_fdinfo", "malloc(", "close(", "free(",
    )
    decoy_body = c_function_body(
        c_semantic_source(
            'static int close_bootstrap_descriptors(void){'
            'const char *decoy="getpid( PROC_PIDLISTFDS proc_pidinfo( '
