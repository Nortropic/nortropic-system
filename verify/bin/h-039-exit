    live_digest = "ab" * 32
    live_snapshot_prefix = (0, 0, 0, 0, 0, 0, 1, 0, 0, "", b"")

    def live_metadata_admitted(
        xattrs: Any, *, has_acl: Any = False, flags: Any = 0,
    ) -> bool:
        snapshot = live_snapshot_prefix[:8] + (flags,) \
            + live_snapshot_prefix[9:] + (xattrs, has_acl)
        try:
            require_no_extended_authority(snapshot, "R9_CAUSAL_FIXTURE")
            return True
        except Rig:
            return False

