                    lambda candidate=mutant: bootstrap_recovery_oracle(
                        candidate, mediator_size=89392,
                        mediator_sha256=mediator_sha,
                        mediator_cdhash=mediator_cdhash,
                        installer_size=191712,
                        installer_sha256=installer_sha,
                        installer_cdhash=installer_cdhash,
                    ),
                ),
                f"N_H039_R12_RESTAGE_{consumer.upper()}_{label}",
            )
    complete = bootstrap_recovery_fixture(
        "COMPLETE", mediator_size=89392, mediator_sha256=mediator_sha,
        mediator_cdhash=mediator_cdhash, installer_size=191712,
