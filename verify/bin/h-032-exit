    fresh_effect_counter=[0]
    def fresh_kernel_effect(module_path,raw,mode="valid"):
        fresh_effect_counter[0]+=1
        arena=work/f"r48-effect-{fresh_effect_counter[0]}";arena.mkdir(mode=0o700)
        raw_path=arena/"input.bin";raw_path.write_bytes(raw)
        proc=system_popen(["/usr/bin/python3","-I","-S",str(effect_runner),
            str(module_path),str(arena),str(raw_path),mode],stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,text=True)
        stdout,stderr=proc.communicate(timeout=20)
        try: result=strict_json(stdout.strip().splitlines()[-1])
        except Exception: result={"parse_error":stdout,"stderr":stderr,"rc":proc.returncode}
        result["rc"]=proc.returncode;result["stderr"]=stderr
        # Judge cleanup happens only after the complete residue observation.
        shutil.rmtree(arena,ignore_errors=True)
        return result

    expected_binding_keys=["invocation_id","report","result_sha256","role","run_id","schema_version"]
    def fresh_success(case,raw):
        canonical=case.get("canonical") or {}
        return (case.get("rc")==0 and case.get("accepted") is True
            and case.get("fd_aliases")==[] and case.get("transition_ok") is True
            and case.get("publication_ok") is True
            and len(case.get("canonical_epochs",[]))==1
            and not case.get("canonical_direct_writes")
            and case.get("visibility_ok") is True and not case.get("temps")
            and not case.get("outside") and not case.get("post_events")
            and not case.get("env_events") and case.get("env_changed") is False
            and not case.get("security_events")
            and case.get("trap_unchanged") is True
            and case.get("ticket_selftest") and all(case["ticket_selftest"].values())
            and canonical.get("keys")==expected_binding_keys
            and canonical.get("schema_version_type")=="int"
            and canonical.get("schema_version")==1
            and canonical.get("invocation")=="1"*32 and canonical.get("run")=="2"*32
            and canonical.get("role")==canonical.get("report_role")=="TEST_AUTHOR"
            and canonical.get("result_sha256")==hashlib.sha256(raw).hexdigest())
    def fresh_reject(case,preseed=False):
        canonical=case.get("canonical")
        preseed_ok=(preseed and case.get("preseed") is not None and canonical is not None
            and canonical.get("dev")==case["preseed"][0]
            and canonical.get("ino")==case["preseed"][1]
            and canonical.get("digest")==hashlib.sha256(bytes.fromhex(case["preseed"][2])).hexdigest())
        return (case.get("rc")==0 and case.get("accepted") is False
            and case.get("fd_aliases")==[] and not case.get("temps")
            and not case.get("outside") and case.get("trap_unchanged") is True
            and not case.get("env_events") and case.get("env_changed") is False
            and not case.get("security_events")
            and case.get("ticket_selftest") and all(case["ticket_selftest"].values())
            and (canonical is None or preseed_ok))
    def cleanup_transient_ok(case,raw):
        # R117 control 1: transient temp-cleanup fault.  For a no-overwrite
        # (os.link) kernel the publish SUCCEEDS and only the temp-unlink faults
        # transiently, so an exactly-valid canonical with NO temp residue is the
        # correct outcome; for an os.replace kernel the publish itself faults, so
        # it must reject with no canonical.  Temp residue, a partial/invalid
        # canonical, an fd alias or any out-of-scope effect is never acceptable.
        canonical=case.get("canonical")
        if (case.get("rc")!=0 or case.get("temps") or case.get("outside")
                or case.get("fd_aliases")!=[]
                or case.get("env_events") or case.get("env_changed") is not False
                or case.get("security_events") or case.get("trap_unchanged") is not True
                or not (case.get("ticket_selftest")
                        and all(case["ticket_selftest"].values()))):
            return False
        if canonical is None:
            return case.get("accepted") is False
        return (canonical.get("keys")==expected_binding_keys
            and canonical.get("schema_version_type")=="int"
            and canonical.get("schema_version")==1
            and canonical.get("invocation")=="1"*32 and canonical.get("run")=="2"*32
            and canonical.get("role")==canonical.get("report_role")=="TEST_AUTHOR"
            and canonical.get("result_sha256")==hashlib.sha256(raw).hexdigest()
            and canonical.get("stable") is True)
    def outside_blocked(case,canonical_absent=False):
        return (case.get("rc")==0 and case.get("accepted") is False
            and bool(case.get("outside")) and case.get("trap_unchanged") is True
            and not case.get("env_events") and case.get("env_changed") is False
            and not case.get("security_events")
            and case.get("ticket_selftest") and all(case["ticket_selftest"].values())
            and (not canonical_absent or case.get("canonical") is None))

