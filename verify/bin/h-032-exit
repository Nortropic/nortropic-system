    r55_complete_residue_oracle_ok = (r55_clean_oracle_positive
        and r55_parent_residue_caught and r55_helper_residue_caught)

    # R12 boundary: a fresh interpreter imports the exact candidate source and
    # retains the genuine stdlib subprocess.Popen object.  Each behavior is
    # intrinsic to a separately hashed provider authority; neither environment
    # modes nor monkeypatch state crosses into the subject process.
    r12_runner = work / "r12-real-popen-runner.py"
    _r125_r12_dependency_digests = {
        str(Path(path).relative_to(repo)): value[1]
        for path, value in _r125_dependency_texts.items()}
    _r125_r12_dependency_names = ({
        "controller/authority/core.py": "controller.authority.core",
        "controller/result/consumer.py": "controller.result.consumer",
        "controller/result/materialize.py": "controller.result.materialize"}
        if _r125_uses_result_materialize
        else {"controller/authority/core.py": "core"})
    r12_runner.write_text("import __future__,argparse,base64,datetime,fcntl,fnmatch,hashlib,importlib.util,json,os,pathlib,re,shutil,stat,subprocess,sys,tempfile,time,types,typing,unicodedata,dataclasses\n"
"source,repo,wt=map(pathlib.Path,sys.argv[1:4])\n"
f"expected_digest={_r125_controller_digest!r}\n"
f"expected_dependencies={_r125_r12_dependency_digests!r}\n"
