            def r122_product_rejects(delta_obj, mutate_rediff=False):
                control_before_case = r123_git_control_snapshot(_product_git)
                objects_before_case = r123_object_ids(_product_git)
                odb_before_case = r123_odb_binding(_product_git)
                layout_before_case = r123_odb_layout(_product_git)
                rejected = False
                case_events = []
                rediff_mutations = {"n": 0}
                real_product_run = subprocess.run
                def mutating_product_run(*args, **kwargs):
                    completed = real_product_run(*args, **kwargs)
                    argv = args[0] if args else kwargs.get("args")
                    if (mutate_rediff and isinstance(argv, (list, tuple))
                            and len(argv) == 8
                            and list(argv[:6]) == [
                                "/usr/bin/git", "diff", "--cached", "--binary",
                                "--full-index", "--no-renames"]
                            and completed.returncode == 0
                            and isinstance(completed.stdout, bytes)
                            and completed.stdout):
                        changed = bytearray(completed.stdout)
                        changed[-1] ^= 1
                        rediff_mutations["n"] += 1
                        return subprocess.CompletedProcess(
                            completed.args, completed.returncode,
                            bytes(changed), completed.stderr)
                    return completed
                _r123_observer["events"] = case_events
                _r123_observer["invalid"] = False
                try:
                    if mutate_rediff:
                        subprocess.run = mutating_product_run
                    r123_call_materialize(_pmat, (
                        _product_git, r122_base_sha, delta_obj, R122_ALLOWED,
                        R122_MAXF, R122_MAXL, R122_OPS, str(_product_protected)))
                except Exception:
                    rejected = True
                finally:
                    subprocess.run = real_product_run
                    _r123_observer["events"] = None
                return (rejected
                        and (not mutate_rediff or rediff_mutations["n"] == 1)
                        and not _r123_observer["invalid"]
                        and r123_materializer_effects_ok(
                            case_events, _product_git, _product_protected,
                            r122_base, require_complete=False)
                        and r123_git_control_snapshot(_product_git) == control_before_case
                        and r123_object_ids(_product_git) == objects_before_case
                        and r123_odb_binding(_product_git) == odb_before_case
                        and r123_odb_layout(_product_git) == layout_before_case
                        and not any(_product_protected.iterdir()))

