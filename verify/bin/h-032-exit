    def r89_clock_value(value: object):
        if not isinstance(value,str) or len(value)!=15:
            return None
        try:
            parsed=datetime.strptime(value,"%Y%m%d-%H%M%S")
        except ValueError:
            return None
        return parsed if parsed.strftime("%Y%m%d-%H%M%S")==value else None
    def r89_run_identity(path: Path, runs_root: Path=physical_runs_root):
        suffix="-test_author"
        if path.parent!=runs_root or not path.name.endswith(suffix):
            return None
        value=path.name[:-len(suffix)]
        return value if r89_clock_value(value) is not None else None
    def r89_clock_barrier(anchor: str, runs_root: Path=physical_runs_root,
                          bound_seconds: float=3.0):
        anchor_value=r89_clock_value(anchor)
        if anchor_value is None:
            raise RuntimeError("R89 clock barrier anchor invalid")
        deadline=time.monotonic()+bound_seconds
        while time.monotonic()<deadline:
            current=physical_module.now_id()
            current_value=r89_clock_value(current)
            if current_value is None:
                raise RuntimeError("R89 clock barrier observation invalid")
            if current_value<anchor_value:
                raise RuntimeError("R89 clock rollback")
            eligible=runs_root/f"{current}-test_author"
            if current_value>anchor_value:
                if eligible.exists():
                    raise RuntimeError("R89 clock barrier eligible slot preseeded")
                return current,eligible
            time.sleep(.01)
        raise RuntimeError("R89 clock barrier stalled")
