                or observation.get("provider_output_count")!=1
                or type(observation.get("provider_worktree_count")) is not int
                or observation.get("provider_worktree_count")!=1
                or observation.get("timeout")!="86400"
                or type(observation.get("separator")) is not int
                or observation.get("separator")!=8
