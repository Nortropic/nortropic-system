def inject_concurrent_canonical():
 # R116 concurrent-canonical (E167-REV-05): an audit-hook adversary publishes a
 # FOREIGN canonical using the un-audited genuine primitives, in the exact
 # pre-syscall window before the subject's own publish syscall runs.  A kernel
 # that publishes with os.replace overwrites this foreign object; a kernel that
 # publishes with os.link (no-overwrite) hits FileExistsError, rejects, and
 # leaves the foreign object intact.
 if mode!="concurrent_canonical" or concurrent_injected[0]: return
 concurrent_injected[0]=True
 data=b'{"foreign":"concurrent-canonical-preserve"}'
 flags=os.O_WRONLY|os.O_CREAT|os.O_EXCL|getattr(os,"O_CLOEXEC",0)|getattr(os,"O_NOFOLLOW",0)
 fd=original_os_open(canonical,flags,0o600)
 try:
  view=memoryview(data)
  while view:
   written=original_write(fd,view)
   if written<=0: raise OSError("short concurrent canonical write")
   view=view[written:]
  original_fsync(fd);st=original_fstat(fd)
  concurrent_state.update({"dev":st.st_dev,"ino":st.st_ino,"digest":hashlib.sha256(data).hexdigest()})
 finally: os.close(fd)
def audit(event,args):
 if not call_active[0]: return
 if consume_ticket(event,args): return
 if event=="open" and args:
  path=args[0];flags=args[2] if len(args)>2 and isinstance(args[2],int) else 0
  allowed=inside_allowed(path);label=path_label(path)
  events.append(("open",label,flags,allowed))
  if not allowed: raise PermissionError("audit path outside scoped result authority")
  if lexical_path(path)==lexical_path(canonical) and flags&(os.O_WRONLY|os.O_RDWR|os.O_CREAT|os.O_TRUNC):
   canonical_direct_writes.append((label,flags,safe_existing(canonical)))
  if transition_done[0] and lexical_path(path)==lexical_path(canonical) and flags&(os.O_WRONLY|os.O_RDWR|os.O_CREAT|os.O_TRUNC): events.append(("post_write",label,flags,False))
 elif event in {"os.remove","os.unlink"} and args:
