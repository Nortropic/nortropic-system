    check("J_GR01_PATH_REOPEN_MUTANT", reopened != b"A", f"mutant_snapshot={reopened!r}")

    authority_digest = hashlib.sha256(b"A").hexdigest()
    jc_snapshot = jc / "snapshot"; jc_snapshot.write_bytes(b"A")
    jc_snapshot.write_bytes(b"B")
    safe_rehash_admits = hashlib.sha256(jc_snapshot.read_bytes()).hexdigest() == authority_digest
    no_rehash_mutant_admits = True
