    # R4 judge anchors bind the same ordered oracle used at actual Popen.
    def adjacent_trace_admits(transitions_at: list[int], provider_reads_at: list[int],
                              host_reads_at: list[int], protected: bool) -> bool:
        last = max(transitions_at, default=-1)
        return (protected and bool(provider_reads_at) and bool(host_reads_at)
                and provider_reads_at[-1] > last and host_reads_at[-1] > last)
    early_decoy_admits = adjacent_trace_admits([1, 3, 5], [2], [2], True)
    final_reads_admit = adjacent_trace_admits([1, 3, 5], [6], [7], True)
    fchmod_final_admits = adjacent_trace_admits([1, 4], [5], [6], True)
    check("J_R4_GR05_EARLY_DECOY_PROTECTION_REJECT",
          not early_decoy_admits and final_reads_admit,
          "protect/read/unprotect/reprotect requires new reads after final transition")
    check("J_R4_GR05_FCHMOD_EQUIVALENT_POSITIVE", fchmod_final_admits,
          "fchmod transition shares the ordered protection oracle")
    retained_snapshot = jc / "retained-writable-provider"
    retained_snapshot.write_bytes(b"trusted")
    retained_fd = os.open(retained_snapshot, os.O_RDWR)
    try:
        retained_snapshot.chmod(0o500)
        before_retained = hashlib.sha256(retained_snapshot.read_bytes()).hexdigest()
        os.lseek(retained_fd, 0, os.SEEK_SET); os.write(retained_fd, b"changed")
        os.ftruncate(retained_fd, len(b"changed")); os.fsync(retained_fd)
        after_retained = hashlib.sha256(retained_snapshot.read_bytes()).hexdigest()
        check("J_R5_GR05_RETAINED_WRITABLE_FD_MUTANT_REJECT",
              before_retained != after_retained,
              "protected pathname changed through retained writable fd after early hash")
    finally:
        os.close(retained_fd); retained_snapshot.chmod(0o700); retained_snapshot.unlink()
    fd_fixture = jc / "fd-inventory"; fd_fixture.write_bytes(b"trusted"); fd_fixture.chmod(0o700)
    writer = os.open(fd_fixture, os.O_RDWR); duplicate_writer = os.dup(writer); os.close(writer)
    reader = os.open(fd_fixture, os.O_RDONLY); duplicate_reader = os.dup(reader); os.close(reader)
    try:
        identity_fd = fd_fixture.stat()
        def access(fd): return fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE
        check("J_R6_GR05_DUPLICATE_WRITER_ENUMERATED",
              (os.fstat(duplicate_writer).st_dev, os.fstat(duplicate_writer).st_ino)
              == (identity_fd.st_dev, identity_fd.st_ino) and access(duplicate_writer) == os.O_RDWR,
              f"fd={duplicate_writer} mode={access(duplicate_writer)}")
        check("J_R6_GR05_PREOPENED_RO_DUP_POSITIVE", access(duplicate_reader) == os.O_RDONLY,
              f"fd={duplicate_reader} mode={access(duplicate_reader)}")
    finally:
        os.close(duplicate_writer); os.close(duplicate_reader); fd_fixture.unlink()

    direct_parent, provider_parent = 100, 200
    check("J_R3_GR06_CONTROLLER_DIRECT_HOST_REJECT",
          direct_parent != provider_parent,
          f"observed_parent={direct_parent} required_parent={provider_parent}")
    check("J_R3_GR06_PROVIDER_CHILD_POSITIVE", provider_parent == provider_parent,
          "exactly one same-root child carries provider ancestry")

    semantic_cleanup = jc / "semantic-cleanup"; semantic_cleanup.mkdir()
    (semantic_cleanup / "provider").write_bytes(b"partial")
    helper_specific_inventory: list[Path] = []
    tree_inventory = list(semantic_cleanup.rglob("*"))
    check("J_R4_GR07_HELPER_NEUTRAL_RESIDUE_REJECT",
          not helper_specific_inventory and bool(tree_inventory),
          f"helper={helper_specific_inventory} tree={[str(p) for p in tree_inventory]}")
    shutil.rmtree(semantic_cleanup)
    # Outside every attempt arena but still beneath the shell trap-owned WORK.
    fixed_outside = work / "fixed-root-outside-attempt-arena"
    outside_was_absent = not fixed_outside.exists()
    outside_residue_seen = False
    try:
        os.mkdir(fixed_outside); (fixed_outside / "provider").write_bytes(b"partial")
        outside_residue_seen = outside_was_absent and fixed_outside.exists()
        check("J_R5_GR07_FIXED_ROOT_RESIDUE_REJECT", outside_residue_seen,
              f"path={fixed_outside} observed={outside_residue_seen}")
    finally:
        if fixed_outside.exists(): shutil.rmtree(fixed_outside)
    check("J_R5_GR07_FIXED_ROOT_SELF_CLEANUP", not fixed_outside.exists(),
          f"residue={fixed_outside.exists()}")
    journal_mutant = work / "judge-runs/run-1/leaked-family/provider"
    journal_mutant.parent.mkdir(parents=True); journal_mutant.write_bytes(b"partial")
    exact_names = {"provider-envelope.json", "events.jsonl", "result.json"}
    journal_mutant_allowed = (journal_mutant.name in exact_names
                              and journal_mutant.parent.parent.name == "judge-runs")
    check("J_R6_GR07_FAMILY_UNDER_RUNS_REJECT", not journal_mutant_allowed,
          f"path={journal_mutant} allowed={journal_mutant_allowed}")
    empty_sibling = work / "judge-runs/arbitrary-empty-root"; empty_sibling.mkdir()
    wrong_leaf = empty_sibling / "result.json"; wrong_leaf.write_text("{}")
    check("J_R7_GR07_EMPTY_SIBLING_RUN_REJECT", empty_sibling.name != "run-1",
          f"path={empty_sibling}")
    check("J_R7_GR07_RIGHT_LEAF_WRONG_RUN_REJECT", wrong_leaf.parent.name != "run-1",
          f"path={wrong_leaf}")
    shutil.rmtree(work / "judge-runs")
    journal_root_control = work / "judge-journal-root"
    journal_root_control.mkdir()
    exact_root_journal = journal_root_control / "events.jsonl"
    exact_root_journal.write_text("{}\n")
    root_sibling = journal_root_control / "unexpected.jsonl"
    root_sibling.write_text("{}\n")
    check("J_POSTPUB_EXACT_ROOT_JOURNAL_POSITIVE",
          exact_root_journal == journal_root_control / "events.jsonl",
          f"path={exact_root_journal}")
    check("J_POSTPUB_ROOT_JOURNAL_SIBLING_REJECT",
          root_sibling != journal_root_control / "events.jsonl",
          f"path={root_sibling}")
    shutil.rmtree(journal_root_control)

    check("J_R4_GR08_UNBOUNDED_PROVIDER_EFFECT", provider_fixture_effect,
          "digest-coherent oversized provider executes and captures without the bound")
    check("J_R4_GR08_UNBOUNDED_HOST_EFFECT", host_fixture_effect,
          "digest-coherent oversized host executes and captures without the bound")

    # GR-07 judge controls: the verdict is attached to the exact opened
    # object's identity. Path metadata alone and omission are insufficient.
    regular_mode = stat.S_IFREG | 0o700; fifo_mode = stat.S_IFIFO | 0o600
    def identity(st): return st.st_dev, st.st_ino
    def opened_regular_oracle(opened_st, inspected_st):
        return (inspected_st is not None and identity(opened_st) == identity(inspected_st)
                and stat.S_ISREG(inspected_st.st_mode))
    gr07_a = jc / "gr07-a"; gr07_b = jc / "gr07-b"
    gr07_a.write_bytes(b"trusted"); gr07_b.write_bytes(b"trusted")
    stale_path_st = gr07_a.stat()
    with gr07_b.open("rb") as opened:
        opened_st = original_fstat(opened.fileno())
        # Disposable unsafe implementation: digest/read succeeds but it omits
        # all metadata inspection of the opened object.
        no_check_bytes, no_check_st = opened.read(), None
    no_opened_check_admits = (no_check_bytes == b"trusted"
                              and opened_regular_oracle(opened_st, no_check_st))
    stale_path_stat_admits = opened_regular_oracle(opened_st, stale_path_st)
    with gr07_b.open("rb") as opened:
        same_opened_st = original_fstat(opened.fileno())
        same_opened_bytes = opened.read()
    same_opened_admits = (same_opened_bytes == b"trusted"
                          and opened_regular_oracle(same_opened_st, same_opened_st))
    nonregular_st = os.stat_result((fifo_mode, *same_opened_st[1:]))
    nonregular_opened_admits = opened_regular_oracle(nonregular_st, nonregular_st)
    check("J_GR07_NO_OPENED_OBJECT_TYPE_CHECK", not no_opened_check_admits,
          "NO_OPENED_OBJECT_TYPE_CHECK=REJECTED")
    check("J_GR07_STALE_PATH_STAT", not stale_path_stat_admits,
          "STALE_PATH_STAT=REJECTED")
    check("J_GR07_SAME_OPENED_OBJECT", same_opened_admits,
          "SAME_OPENED_OBJECT_REGULAR_CHECK=ADMITTED")
    check("J_GR07_NONREGULAR_OPENED_OBJECT", not nonregular_opened_admits,
          "NONREGULAR_OPENED_OBJECT=REJECTED")

    # Fresh upstream provenance is an executed prerequisite, not a copied
    # historical claim. It is intentionally last because an owner environment
    # may create one-time protected H-033 evidence while a nested sandbox is
    # expected to report ODÖMBART.
    h033_odom = False
    h033_env = without_caller_git_controls(dict(os.environ))
    h033_env["PYTHONDONTWRITEBYTECODE"] = "1"
    try:
        h033_result = subprocess.run(
            [str(h033_gate)], cwd=repo, env=h033_env, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=180)
        h033_ok = (h033_result.returncode == 0
                   and "H033_GATE_SUMMARY=55 PASS 0 FAIL" in h033_result.stdout
                   and "H033_GATE_RESULT=PASS" in h033_result.stdout)
        h033_odom = (h033_result.returncode == 2 or (
            h033_result.returncode == 1
            and "H033_GATE_SUMMARY=42 PASS 13 FAIL" in h033_result.stdout
            and "FAIL K_OWNER_FRESH_REQUEST_PASS: (2, '', '')" in h033_result.stdout
            and "FAIL K_OWNER_FRESH_REQUEST_FAIL: (2, '', '')" in h033_result.stdout
            and "FAIL K_OWNER_FRESH_REQUEST_ODÖMBART: (2, '', '')" in h033_result.stdout
        ))
        check("K_H033_FRESH_UPSTREAM_PROVENANCE", h033_ok,
              f"rc={h033_result.returncode} tail={h033_result.stdout[-500:].replace(chr(10), '|')}")
    except subprocess.TimeoutExpired:
        h033_odom = True
        check("K_H033_FRESH_UPSTREAM_PROVENANCE", False, "timeout/cleanup authority unavailable")

    authoritative_control_after = exact_tree_snapshot(authoritative_control_root)
    check("J_AUTHORITATIVE_LIVE_GIT_UNCHANGED",
          authoritative_control_after == authoritative_control_before,
          f"root={authoritative_control_root} before_entries="
          f"{len(authoritative_control_before)} after_entries={len(authoritative_control_after)}")

    passed = sum(ok for _, ok, _ in checks)
    failed = {key for key, ok, _detail in checks if not ok}
    for key, ok, detail in checks:
        print(("PASS " if ok else "FAIL ") + key + " — " + detail)
    print(f"SAMMANFATTNING {passed} PASS / {len(checks)-passed} FAIL")
    material_failed = failed - ({"K_G20_NAMESPACE"} if g20_odom else set()) \
                             - ({"K_H033_FRESH_UPSTREAM_PROVENANCE"} if h033_odom else set())
    owner_live_skip_expected = (owner_live_mode == "skip"
        and deterministic_result_ok
        and material_failed == {"K_STRUCTURED_RESULT_DELIVERY_BOUNDARY"})
    if owner_live_mode == "skip":
        print("OWNER_LIVE_EXECUTION=SKIPPED")
        print("OWNER_LIVE_START_DELTA=0")
    if owner_live_skip_expected:
        print("CURRENT_RED_REASON=OWNER_LIVE_PHASE_NOT_RUN")
    elif material_failed == {"K_STRUCTURED_RESULT_DELIVERY_BOUNDARY"}:
        print("CURRENT_RED_REASON=STRUCTURED_RESULT_DELIVERY_BOUNDARY_ABSENT")
    elif material_failed == {"K_CODE_MODE_HOST_IDENTITY_BOUNDARY"}:
        print("CURRENT_RED_REASON=CODE_MODE_HOST_IDENTITY_BOUNDARY_ABSENT")
    elif material_failed:
        print("CURRENT_RED_REASON=UNEXPECTED_CONTRACT_FAILURES:" + ",".join(sorted(material_failed)))
    if g20_odom or h033_odom or owner_live_skip_expected:
        if g20_odom:
            print("ODÖMBART K_G20_NAMESPACE — nested sandbox-exec förbjuden; candidate-bound owner-runner evidence required")
        if h033_odom:
            print("ODÖMBART K_H033_FRESH_UPSTREAM_PROVENANCE — protected owner runner unavailable")
        if owner_live_skip_expected:
            print("ODÖMBART K_OWNER_LIVE_PHASE_NOT_RUN — explicit owner TEST_AUTHOR no-live mode; deterministic product controls passed")
        raise SystemExit(2)
    raise SystemExit(0 if passed == len(checks) else 1)
except SystemExit:
    raise
except Exception as exc:
    print(f"ODÖMBART K-RIGG — {type(exc).__name__}: {exc}")
    raise SystemExit(2)
PY
}

if [[ "$OWNER_LIVE_MODE" == "run" ]]; then
  run_gate_python &
  GATE_PID=$!
  PLAN_DEADLINE=$((SECONDS+300))
  while [[ ! -e "$OWNER_LIVE_PLAN" ]]; do
    if ! /bin/kill -0 "$GATE_PID" 2>/dev/null; then wait "$GATE_PID"; exit $?; fi
    if (( SECONDS >= PLAN_DEADLINE )); then quiesce_protocol; echo "ODÖMBART K_OWNER_LIVE_PROTOCOL — plan readiness timeout"; exit 2; fi
    /bin/sleep 0.05
  done
  "$OWNER_LIVE_HELPER" "$OWNER_LIVE_PLAN" "$OWNER_LIVE_RESULT" &
  HELPER_PID=$!
  wait "$HELPER_PID"
  HELPER_RC=$?
  HELPER_PID=""
  if [[ $HELPER_RC -ne 0 ]]; then
    quiesce_protocol; echo "ODÖMBART K_OWNER_LIVE_HELPER — helper failed rc=$HELPER_RC"; exit 2
  fi
  POST_DEADLINE=$((SECONDS+300))
  while /bin/kill -0 "$GATE_PID" 2>/dev/null; do
    if (( SECONDS >= POST_DEADLINE )); then quiesce_protocol; echo "ODÖMBART K_OWNER_LIVE_PROTOCOL — postprocess timeout"; exit 2; fi
    /bin/sleep 0.05
  done
  wait "$GATE_PID"; GATE_RC=$?;GATE_PID="";exit "$GATE_RC"
fi

run_gate_python
