        injected = [False]; sink_paths: list[Path] = []
        journal_mutation_identity: list[tuple[int, int, int, int]] = []

        def observe_mkdtemp(*args, **kwargs):
            value = Path(original_mkdtemp(*args, **kwargs)); allocations.append(value)
            if len(allocations) == ordinal: target_root.append(value)
            return str(value)

        def observe_open(path, flags, *args, **kwargs):
            fd = original_open(path, flags, *args, **kwargs)
            candidate = Path(path) if type(path) is str or type(path) is type(Path()) else None
            if target_root and candidate is not None and candidate.parent == target_root[0]:
                active = audit_active[0]
                if isinstance(active, dict):
                    if candidate not in sink_paths: sink_paths.append(candidate)
                    outputs = active["provider_outputs"]; assert isinstance(outputs, list)
                    if str(candidate) not in outputs: outputs.append(str(candidate))
                    opened = original_fstat(fd); identity = (opened.st_dev, opened.st_ino)
                    identities = active["sink_identities"]; assert isinstance(identities, list)
                    if identity not in identities: identities.append(identity)
            return fd

        def corrupt_journal(*args, **kwargs):
            event = args[1] if len(args) > 1 else kwargs.get("event")
            if event != "AGENT_START": return original_journal(*args, **kwargs)
            injected[0] = True
            if mode == "malformed_unrelated":
                append_gate_journal_bytes(case_repo, b'{"event":"OTHER",}\n')
            elif mode == "non_dict":
                append_gate_journal_bytes(case_repo, b'[]\n')
            elif mode == "truncated_start":
                append_gate_journal_bytes(case_repo, b'{"event":"AGENT_START"')
            elif mode == "valid_plus_truncated":
                original_journal(*args, **kwargs)
                append_gate_journal_bytes(case_repo, b'{"event":"AGENT_START"')
            elif mode == "duplicate_valid":
                original_journal(*args, **kwargs); original_journal(*args, **kwargs)
            elif mode == "chmod_same_inode":
                original_journal(*args, **kwargs)
                journal_path = module.journal_root(case_repo) / "events.jsonl"
                before_fd = journal_open(journal_path, os.O_RDONLY)
                try: before = journal_fstat(before_fd)
                finally: journal_close(before_fd)
                journal_path.chmod(0o666)
                after_fd = journal_open(journal_path, os.O_RDONLY)
                try: after = journal_fstat(after_fd)
                finally: journal_close(after_fd)
                if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
                    raise AssertionError("chmod mutant replaced journal object")
                journal_mutation_identity.append(
                    (before.st_dev, before.st_ino, stat.S_IMODE(before.st_mode),
                     stat.S_IMODE(after.st_mode)))
                append_gate_journal_bytes(case_repo, b'{"event":"OTHER","phase":"chmod"}\n')
            else: raise AssertionError(mode)
            raise OSError(f"H032 injected journal append corruption:{mode}")

        module.tempfile.mkdtemp = observe_mkdtemp
        module.os.open = observe_open; module.journal = corrupt_journal
        try: outcome = attempt(case_repo)
        finally:
            module.tempfile.mkdtemp = original_mkdtemp
            module.os.open = original_open; module.journal = original_journal
