    def r123_under(path_value, root_value):
        try:
            path_text = os.path.realpath(os.fspath(path_value))
            root_text = os.path.realpath(os.fspath(root_value))
            return os.path.commonpath([path_text, root_text]) == root_text
        except Exception:
            return False

    def r123_materializer_git_argv_ok(argv, authoritative_git, protected_root):
        if (not isinstance(argv, (list, tuple)) or len(argv) < 2
                or argv[0] != "/usr/bin/git"
                or any(not isinstance(item, str) for item in argv)):
            return False
        command = argv[1]
        tail = list(argv[2:])
        hex40 = lambda value: re.fullmatch(r"[0-9a-f]{40}", value) is not None
        commitish = lambda value, suffix: (
            isinstance(value, str) and value.endswith(suffix)
            and hex40(value[:-len(suffix)]))
        if command == "init":
            return (len(tail) == 3 and tail[:2] == ["-q", "--bare"]
                    and r123_under(tail[2], protected_root))
        if command == "rev-list":
            return (len(tail) == 3 and tail[:2] == ["--objects", "--no-walk"]
                    and (hex40(tail[2]) or commitish(tail[2], "^{commit}")))
        if command == "pack-objects":
            return tail == ["--stdout"]
        if command == "index-pack":
            return tail == ["--stdin", "--fix-thin"]
        if command == "cat-file":
            return (len(tail) == 2
                    and ((tail[0] == "-e" and commitish(tail[1], "^{commit}"))
                         or (tail[0] in {"-s", "-t"} and hex40(tail[1]))))
        if command == "rev-parse":
            return (len(tail) == 2 and tail[0] == "--verify"
                    and commitish(tail[1], "^{tree}"))
        if command == "read-tree":
            return len(tail) == 1 and hex40(tail[0])
        if command == "apply":
            return tail in [
                ["--cached", "--binary", "--whitespace=nowarn",
                 "--unsafe-paths", "--check", "-"],
                ["--cached", "--binary", "--whitespace=nowarn",
                 "--unsafe-paths", "-"]]
        if command == "write-tree":
            return not tail
        if command == "ls-tree":
            return (len(tail) == 4 and tail[:3] == ["-r", "-z", "--name-only"]
                    and hex40(tail[3]))
        if command == "diff-tree":
            return ((len(tail) == 5
                     and tail[:3] == ["-r", "--no-commit-id", "-z"]
                     and hex40(tail[3]) and hex40(tail[4]))
                    or (len(tail) == 6
                        and tail[:4] == ["-r", "--no-commit-id", "--raw",
                                         "--no-renames"]
                        and hex40(tail[4]) and hex40(tail[5])))
        if command == "diff":
            return ((len(tail) == 6 and tail[:2] == ["--numstat", "-z"]
                     and hex40(tail[2]) and hex40(tail[3]) and tail[4] == "--"
                     and tail[5] and not tail[5].startswith("-")
                     and "/../" not in "/" + tail[5] + "/"
                     and not tail[5].startswith("/"))
                    or (len(tail) == 6
                        and tail[:4] == ["--cached", "--binary", "--full-index",
                                         "--no-renames"]
                        and hex40(tail[4]) and tail[5] == "--"))
        if command == "commit-tree":
            return (len(tail) == 5 and hex40(tail[0]) and tail[1] == "-p"
                    and hex40(tail[2]) and tail[3] == "-m"
                    and tail[4:] == [
                        "nortropic candidate (materialized from protected artifact)"])
        return False

    def r123_materializer_effects_ok(events, authoritative_git, protected_root,
                                     forbidden_scratch, require_complete=True):
        authoritative = Path(authoritative_git).resolve()
        protected = Path(protected_root).resolve()
        objects = authoritative / "objects"
        scratch_text = os.path.realpath(os.fspath(forbidden_scratch))
        saw_private = False; saw_authoritative_commit = False
        saw_protected_create = False
        git_trace = []
        pending_pipe_fdopens = []
        read_pipe_flags = os.O_RDONLY | os.O_CLOEXEC
        write_pipe_flags = (os.O_WRONLY | os.O_CREAT | os.O_TRUNC
                            | os.O_CLOEXEC)
        for event, args in events:
            if pending_pipe_fdopens and event not in {"open", "subprocess.Popen"}:
                return False
            if event == "open":
                path, mode, flags = args[:3]
                if type(path) is int:
                    if (path < 0 or type(mode) is not str or type(flags) is not int
                            or (mode, flags) not in {
                                ("r", read_pipe_flags), ("w", write_pipe_flags)}):
                        return False
                    pending_pipe_fdopens.append((mode, flags))
                    continue
                if (not isinstance(path, (str, bytes))
                        or r123_under(path, scratch_text)
                        or not (r123_under(path, protected)
                                or r123_under(path, authoritative))):
                    return False
                writing = ((isinstance(mode, str) and any(c in mode for c in "wax+"))
                           or (isinstance(flags, int) and bool(flags & (
                               os.O_WRONLY | os.O_RDWR | os.O_CREAT |
                               os.O_TRUNC | os.O_APPEND))))
                if writing and not (r123_under(path, protected)
                                    or r123_under(path, objects)):
                    return False
            elif event in {"os.mkdir", "os.remove", "os.rmdir",
                           "os.listdir", "os.scandir"}:
                path = args[0]
                if (r123_under(path, scratch_text)
                        or not (r123_under(path, protected)
                                or r123_under(path, authoritative))):
                    return False
                saw_protected_create |= event == "os.mkdir" and r123_under(path, protected)
            elif event in {"r123.path.exists", "r123.path.is_dir"}:
                if (len(args) != 1 or r123_under(args[0], scratch_text) or not (
                        r123_under(args[0], protected)
                        or r123_under(args[0], authoritative))):
                    return False
            elif event in {"os.rename", "os.replace", "os.link", "os.symlink"}:
                for path in args[:2]:
                    if (r123_under(path, scratch_text)
                            or not (r123_under(path, protected)
                                    or r123_under(path, objects))):
                        return False
            elif event == "subprocess.Popen":
                if len(args) < 4:
                    return False
                executable, argv, cwd, environment = args[:4]
                if (os.path.realpath(os.fspath(executable)) != "/usr/bin/git"
                        or not r123_materializer_git_argv_ok(
                            argv, authoritative, protected)
                        or not isinstance(environment, dict)
                        or cwd not in (None, "")):
                    return False
                command = argv[1]
                indexed_diff = (
                    command == "diff" and len(argv) == 8
                    and list(argv[2:6]) == [
                        "--cached", "--binary", "--full-index", "--no-renames"])
                expected_pipe_fdopens = (
                    [ ("w", write_pipe_flags),
                      ("r", read_pipe_flags), ("r", read_pipe_flags) ]
                    if command in {"pack-objects", "index-pack", "apply"}
                    else [ ("r", read_pipe_flags), ("r", read_pipe_flags) ])
                if pending_pipe_fdopens != expected_pipe_fdopens:
                    return False
                pending_pipe_fdopens.clear()
                identity = {
                    "GIT_AUTHOR_NAME": "nortropic-controller",
                    "GIT_AUTHOR_EMAIL": "controller@nortropic.invalid",
                    "GIT_COMMITTER_NAME": "nortropic-controller",
                    "GIT_COMMITTER_EMAIL": "controller@nortropic.invalid",
                    "GIT_AUTHOR_DATE": "2026-01-01T00:00:00 +0000",
                    "GIT_COMMITTER_DATE": "2026-01-01T00:00:00 +0000"}
                expected_keys = {
                    "PATH", "HOME", "TMPDIR", "LANG", "LC_ALL", "GIT_DIR",
                    "GIT_CONFIG_NOSYSTEM", "GIT_CONFIG_GLOBAL",
                    "GIT_TERMINAL_PROMPT", "GIT_NO_REPLACE_OBJECTS",
                    "GIT_ALTERNATE_OBJECT_DIRECTORIES"}
                if command in {"read-tree", "apply", "write-tree"} or indexed_diff:
                    expected_keys.add("GIT_INDEX_FILE")
                if command == "commit-tree":
                    expected_keys.update(identity)
                if (set(environment) != expected_keys
                        or environment.get("PATH") != "/usr/bin:/bin"
                        or environment.get("HOME") != "/var/empty"
                        or environment.get("LANG") != "C"
                        or environment.get("LC_ALL") != "C"
                        or environment.get("GIT_TERMINAL_PROMPT") != "0"
                        or environment.get("GIT_NO_REPLACE_OBJECTS") != "1"
                        or environment.get("GIT_ALTERNATE_OBJECT_DIRECTORIES") != ""
                        or environment.get("GIT_CONFIG_NOSYSTEM") != "1"
                        or environment.get("GIT_CONFIG_GLOBAL") != "/dev/null"
                        or not r123_under(environment.get("TMPDIR", ""), protected)):
                    return False
                if command == "commit-tree" and any(
                        environment.get(name) != value
                        for name, value in identity.items()):
                    return False
                git_dir = Path(environment.get("GIT_DIR", "")).resolve()
                if git_dir == authoritative:
                    if command not in {
                            "rev-list", "pack-objects", "read-tree", "apply",
                            "write-tree", "commit-tree", "cat-file", "rev-parse",
                            "ls-tree", "diff", "diff-tree"}:
                        return False
                    if (command in {"read-tree", "apply", "write-tree"}
                            or indexed_diff) and not r123_under(
                            environment.get("GIT_INDEX_FILE", ""), protected):
                        return False
                    saw_authoritative_commit |= command == "commit-tree"
                elif r123_under(git_dir, protected):
                    saw_private = True
                    if command == "init" and not r123_under(argv[-1], protected):
                        return False
                    if ("GIT_INDEX_FILE" in environment and not r123_under(
                            environment["GIT_INDEX_FILE"], protected)):
                        return False
                else:
                    return False
                git_trace.append((
                    command, tuple(argv[2:]), git_dir,
                    environment.get("GIT_INDEX_FILE")))
            else:
                return False
        if pending_pipe_fdopens:
            return False
        if not require_complete:
            return True
        canonical = [
            (ordinal, row) for ordinal, row in enumerate(git_trace)
            if row[0] == "diff" and len(row[1]) == 6
            and row[1][:4] == (
                "--cached", "--binary", "--full-index", "--no-renames")]
        if len(canonical) != 1:
            return False
        canonical_ordinal, canonical_row = canonical[0]
        _command, canonical_tail, canonical_git, canonical_index = canonical_row
        if (not r123_under(canonical_git, protected)
                or canonical_git == authoritative
                or not r123_under(canonical_index, protected)):
            return False
        prior_same_index = [row for row in git_trace[:canonical_ordinal]
                            if row[2] == canonical_git
                            and row[3] == canonical_index]
        required_suffix = [
            ("read-tree", (canonical_tail[4],)),
            ("apply", ("--cached", "--binary", "--whitespace=nowarn",
                       "--unsafe-paths", "--check", "-")),
            ("apply", ("--cached", "--binary", "--whitespace=nowarn",
                       "--unsafe-paths", "-")),
        ]
        ordered_prior = [(row[0], row[1]) for row in prior_same_index]
        if len(ordered_prior) < len(required_suffix) or (
                ordered_prior[-len(required_suffix):] != required_suffix):
            return False
        if any(row[2] == canonical_git and row[3] == canonical_index
               and row[0] in {"read-tree", "apply"}
               for row in git_trace[canonical_ordinal + 1:]):
            return False
        authoritative_writes = {
            "index-pack", "apply", "write-tree", "commit-tree"}
        if any(row[2] == authoritative and row[0] in authoritative_writes
               for row in git_trace[:canonical_ordinal]):
            return False
        return (saw_private and saw_authoritative_commit
                and saw_protected_create)

    def r123_controller_prelude_effects_ok(events, task_root, protected_root):
        """Bind the legitimate controller work immediately before materialize.

        The real builder must derive task authority from the frozen task file;
        those exact reads are not materializer effects.  The only write is the
        exact already-empty protected-root mkdir.  Keeping this small explicit
        surface preserves the controller-wide observer: a process, another
        scratch read, any scratch write, or any other filesystem effect rejects.
        """
        spec_path = os.path.realpath(os.fspath(
            Path(task_root) / "specs" / "tasks.spec.json"))
        protected = os.path.realpath(os.fspath(protected_root))
        if len(events) != 6:
            return False
        for (event, args), expected_mode in zip(
                events[:4], ("r", None, "r", None)):
            if event != "open" or len(args) < 3:
                return False
            path, mode, flags = args[:3]
            if (not isinstance(path, (str, bytes))
                    or os.path.realpath(os.fsdecode(path)) != spec_path
                    or mode != expected_mode
                    or type(flags) is not int or flags != os.O_CLOEXEC):
                return False
        event, args = events[4]
        mkdir_ok = (event == "os.mkdir" and len(args) == 3
                and isinstance(args[0], (str, bytes))
                and os.path.realpath(os.fsdecode(args[0])) == protected
                and args[1] == 0o700 and args[2] == -1)
        event, args = events[5]
        return (mkdir_ok and event == "r123.path.is_dir"
                and args == (protected,))

    def r123_connected_materializer_effects_ok(
            events, span, authoritative_git, protected_root, task_root,
            scratch_root):
        if (not isinstance(span, tuple) or len(span) != 2
                or any(type(value) is not int for value in span)):
            return False
        start, end = span
        if not (0 <= start <= end <= len(events)):
            return False
        task_spec = os.path.realpath(os.fspath(
            Path(task_root) / "specs" / "tasks.spec.json"))
        if r123_under(task_spec, scratch_root):
            return False
        return (
            r123_controller_prelude_effects_ok(
                events[:start], task_root, protected_root)
            and r123_materializer_effects_ok(
                events[start:end], authoritative_git, protected_root,
                scratch_root)
            and not events[end:])

    _r123_prelude_scratch = _r123_clean_root / "prelude-scratch"
    _r123_prelude_protected = _r123_clean_root / "prelude-protected"
    _r123_prelude_spec = _r123_prelude_scratch / "specs/tasks.spec.json"
    _r123_prelude_positive = [
        ("open", (str(_r123_prelude_spec), "r", os.O_RDONLY | os.O_CLOEXEC)),
        ("open", (str(_r123_prelude_spec), None, os.O_RDONLY | os.O_CLOEXEC)),
        ("open", (str(_r123_prelude_spec), "r", os.O_RDONLY | os.O_CLOEXEC)),
        ("open", (str(_r123_prelude_spec), None, os.O_RDONLY | os.O_CLOEXEC)),
        ("os.mkdir", (str(_r123_prelude_protected), 0o700, -1)),
        ("r123.path.is_dir", (str(_r123_prelude_protected),)),
    ]
    r123_controller_prelude_rig = (
        r123_controller_prelude_effects_ok(
            _r123_prelude_positive, _r123_prelude_scratch,
            _r123_prelude_protected)
        and not r123_controller_prelude_effects_ok(
            _r123_prelude_positive + [("subprocess.Popen", ())],
            _r123_prelude_scratch, _r123_prelude_protected)
        and not r123_controller_prelude_effects_ok([
            *_r123_prelude_positive[:2],
            ("open", (str(_r123_prelude_scratch / "other"), "r",
                      os.O_RDONLY | os.O_CLOEXEC)),
            *_r123_prelude_positive[3:]], _r123_prelude_scratch,
            _r123_prelude_protected)
        and not r123_controller_prelude_effects_ok([
            ("open", (str(_r123_prelude_spec), "w",
                      os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC)),
            *_r123_prelude_positive[1:]], _r123_prelude_scratch,
            _r123_prelude_protected)
        and not r123_controller_prelude_effects_ok([
            *_r123_prelude_positive[:4],
            ("os.mkdir", (str(_r123_prelude_protected), 0o777, -1)),
            _r123_prelude_positive[5]],
            _r123_prelude_scratch, _r123_prelude_protected)
        and not r123_controller_prelude_effects_ok([
            *_r123_prelude_positive[:4],
            ("os.mkdir", (str(_r123_prelude_protected), 0o700, 123)),
            _r123_prelude_positive[5]],
            _r123_prelude_scratch, _r123_prelude_protected)
        and not r123_controller_prelude_effects_ok([
            *_r123_prelude_positive[:5],
            ("r123.path.is_dir", (str(_r123_prelude_scratch),))],
            _r123_prelude_scratch, _r123_prelude_protected)
        and not r123_controller_prelude_effects_ok([
            *_r123_prelude_positive,
            ("os.chmod", (str(_r123_prelude_scratch / ".git/HEAD"),
                           0o777, -1))],
            _r123_prelude_scratch, _r123_prelude_protected))

    _r123_effect_private = _r123_clean_root / "private.git"
    _r123_effect_env = {
        "PATH": "/usr/bin:/bin", "HOME": "/var/empty",
        "LANG": "C", "LC_ALL": "C", "GIT_TERMINAL_PROMPT": "0",
        "GIT_DIR": str(_r123_effect_private), "TMPDIR": str(_r123_clean_root),
        "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_NO_REPLACE_OBJECTS": "1", "GIT_ALTERNATE_OBJECT_DIRECTORIES": "",
    }
    _r123_effect_index = _r123_clean_root / "effect-index"
    _r123_effect_index_env = dict(
        _r123_effect_env, GIT_INDEX_FILE=str(_r123_effect_index))
    _r123_effect_auth_env = dict(
        _r123_effect_env, GIT_DIR=r122_base_git,
        GIT_AUTHOR_NAME="nortropic-controller",
        GIT_AUTHOR_EMAIL="controller@nortropic.invalid",
        GIT_COMMITTER_NAME="nortropic-controller",
        GIT_COMMITTER_EMAIL="controller@nortropic.invalid",
        GIT_AUTHOR_DATE="2026-01-01T00:00:00 +0000",
        GIT_COMMITTER_DATE="2026-01-01T00:00:00 +0000")
    def r123_pipe_fdopens(first_fd, with_input=False):
        values = []
        if with_input:
            values.append(("open", (
                first_fd, "w", os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC)))
            first_fd += 1
        values.extend([
            ("open", (first_fd, "r", os.O_RDONLY | os.O_CLOEXEC)),
            ("open", (first_fd + 1, "r", os.O_RDONLY | os.O_CLOEXEC)),
        ])
        return values
    _r123_effect_positive = [
        ("os.mkdir", (str(_r123_effect_private), 0o700, -1)),
        *r123_pipe_fdopens(10),
        ("subprocess.Popen", ("/usr/bin/git", ["/usr/bin/git", "init", "-q", "--bare",
                                                   str(_r123_effect_private)], None,
                              _r123_effect_env)),
        *r123_pipe_fdopens(14),
        ("subprocess.Popen", ("/usr/bin/git", ["/usr/bin/git", "read-tree",
                                                   "b" * 40], None,
                              _r123_effect_index_env)),
        *r123_pipe_fdopens(16, with_input=True),
        ("subprocess.Popen", ("/usr/bin/git", ["/usr/bin/git", "apply", "--cached",
                                                   "--binary", "--whitespace=nowarn",
                                                   "--unsafe-paths", "--check", "-"], None,
                              _r123_effect_index_env)),
        *r123_pipe_fdopens(19, with_input=True),
        ("subprocess.Popen", ("/usr/bin/git", ["/usr/bin/git", "apply", "--cached",
                                                   "--binary", "--whitespace=nowarn",
                                                   "--unsafe-paths", "-"], None,
                              _r123_effect_index_env)),
        *r123_pipe_fdopens(22),
        ("subprocess.Popen", ("/usr/bin/git", ["/usr/bin/git", "diff", "--cached",
                                                   "--binary", "--full-index", "--no-renames",
                                                   "b" * 40, "--"], None,
                              _r123_effect_index_env)),
        *r123_pipe_fdopens(20),
        ("subprocess.Popen", ("/usr/bin/git", ["/usr/bin/git", "commit-tree", "a" * 40,
                                                   "-p", "b" * 40, "-m",
                                                   "nortropic candidate (materialized from protected artifact)"], None,
                              _r123_effect_auth_env)),
    ]
    _r123_effect_private_popen = next(
        i for i, value in enumerate(_r123_effect_positive)
        if value[0] == "subprocess.Popen")
    _r125_effect_diff_popen = next(
        i for i, value in enumerate(_r123_effect_positive)
        if (value[0] == "subprocess.Popen"
            and value[1][1][1:6] == [
                "diff", "--cached", "--binary", "--full-index", "--no-renames"]))
    _r125_effect_missing_rediff = (
        _r123_effect_positive[:_r125_effect_diff_popen - 2]
        + _r123_effect_positive[_r125_effect_diff_popen + 1:])
    _r125_effect_wrong_index = list(_r123_effect_positive)
    _r125_diff_event = _r125_effect_wrong_index[_r125_effect_diff_popen]
    _r125_effect_wrong_index[_r125_effect_diff_popen] = (
        "subprocess.Popen", (*_r125_diff_event[1][:3],
         dict(_r125_diff_event[1][3],
              GIT_INDEX_FILE=str(_r123_clean_root / "other-index"))))
    _r125_effect_rediff_retry = list(_r123_effect_positive)
    _r125_effect_rediff_retry[_r125_effect_diff_popen + 1:_r125_effect_diff_popen + 1] = [
        *r123_pipe_fdopens(90), _r125_diff_event]
    _r125_effect_post_rediff_apply = list(_r123_effect_positive)
    _r125_effect_post_rediff_apply[_r125_effect_diff_popen + 1:_r125_effect_diff_popen + 1] = [
        *r123_pipe_fdopens(93, with_input=True),
        ("subprocess.Popen", ("/usr/bin/git", ["/usr/bin/git", "apply", "--cached",
             "--binary", "--whitespace=nowarn", "--unsafe-paths", "-"], None,
         _r123_effect_index_env))]
    _r123_effect_tmp_mutant = list(_r123_effect_positive)
    _r123_effect_tmp_mutant[_r123_effect_private_popen] = (
        "subprocess.Popen",
        ("/usr/bin/git", ["/usr/bin/git", "init"], None,
         dict(_r123_effect_env, TMPDIR=str(r122))))
    _r123_effect_scratch = r122 / "effect-live-scratch"
    _r123_effect_scratch_mutant = list(_r123_effect_positive) + [
        ("open", (str(_r123_effect_scratch / "candidate"), "w", os.O_WRONLY | os.O_CREAT))]
    _r123_effect_system_mutant = list(_r123_effect_positive) + [
        ("os.system", (b"/usr/bin/true",))]
    _r123_effect_spawn_mutant = list(_r123_effect_positive) + [
        ("os.posix_spawn", ("/usr/bin/true", ["/usr/bin/true"], {}))]
    _r123_effect_override_mutant = list(_r123_effect_positive)
    _r123_effect_override_mutant[_r123_effect_private_popen] = (
        "subprocess.Popen",
        ("/usr/bin/git", ["/usr/bin/git", "--git-dir=" + str(r122), "init"],
         None, _r123_effect_env))
    _r123_effect_output_mutant = list(_r123_effect_positive)
    _r123_effect_output_mutant[_r123_effect_private_popen] = (
        "subprocess.Popen",
        ("/usr/bin/git", ["/usr/bin/git", "diff",
                           "--output=" + str(_r123_effect_scratch / "hidden")],
         None, _r123_effect_env))
    _r123_effect_env_mutant = list(_r123_effect_positive)
    _r123_effect_env_mutant[_r123_effect_private_popen] = (
        "subprocess.Popen",
        ("/usr/bin/git", _r123_effect_positive[_r123_effect_private_popen][1][1], None,
         dict(_r123_effect_env, GIT_WORK_TREE=str(r122))))
    _r123_effect_missing_pipe_mutant = list(_r123_effect_positive)
    del _r123_effect_missing_pipe_mutant[_r123_effect_private_popen - 1]
    _r123_effect_extra_pipe_mutant = list(_r123_effect_positive)
    _r123_effect_extra_pipe_mutant.insert(
        _r123_effect_private_popen,
        ("open", (99, "r", os.O_RDONLY | os.O_CLOEXEC)))
    _r123_effect_wrong_pipe_mutant = list(_r123_effect_positive)
    _r123_effect_wrong_pipe_mutant[_r123_effect_private_popen - 1] = (
        "open", (11, "r", os.O_RDONLY))
    r123_effect_oracle_rig = (
        r123_materializer_effects_ok(
            _r123_effect_positive, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_tmp_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_scratch_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_system_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_spawn_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_override_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_output_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_env_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_missing_pipe_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_extra_pipe_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r123_effect_wrong_pipe_mutant, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r125_effect_missing_rediff, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r125_effect_wrong_index, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r125_effect_rediff_retry, r122_base_git, _r123_clean_root,
            _r123_effect_scratch)
        and not r123_materializer_effects_ok(
            _r125_effect_post_rediff_apply, r122_base_git, _r123_clean_root,
            _r123_effect_scratch))
    _r123_connected_task_root = r122 / "effect-controller-repo"
    _r123_connected_prelude = [
        ("open", (str(_r123_connected_task_root / "specs/tasks.spec.json"),
                  "r", os.O_RDONLY | os.O_CLOEXEC)),
        ("open", (str(_r123_connected_task_root / "specs/tasks.spec.json"),
                  None, os.O_RDONLY | os.O_CLOEXEC)),
        ("open", (str(_r123_connected_task_root / "specs/tasks.spec.json"),
                  "r", os.O_RDONLY | os.O_CLOEXEC)),
        ("open", (str(_r123_connected_task_root / "specs/tasks.spec.json"),
                  None, os.O_RDONLY | os.O_CLOEXEC)),
        ("os.mkdir", (str(_r123_clean_root), 0o700, -1)),
        ("r123.path.is_dir", (str(_r123_clean_root),)),
    ]
    _r123_connected_positive = _r123_connected_prelude + _r123_effect_positive
    _r123_connected_span = (
        len(_r123_connected_prelude), len(_r123_connected_positive))
    _r123_nested_task_root = _r123_effect_scratch / "authority-child"
    _r123_nested_task_prelude = [
        (event, ((str(_r123_nested_task_root / "specs/tasks.spec.json"),
                  *args[1:]) if event == "open" else args))
        for event, args in _r123_connected_prelude]
    _r123_nested_task_positive = (
        _r123_nested_task_prelude + _r123_effect_positive)
    _r123_nested_task_span = (
        len(_r123_nested_task_prelude), len(_r123_nested_task_positive))
    r123_connected_effect_oracle_rig = (
        r123_connected_materializer_effects_ok(
            _r123_connected_positive, _r123_connected_span, r122_base_git,
            _r123_clean_root, _r123_connected_task_root,
            _r123_effect_scratch)
        and not r123_connected_materializer_effects_ok(
            _r123_effect_positive + _r123_connected_prelude,
            (0, len(_r123_effect_positive)), r122_base_git,
            _r123_clean_root, _r123_connected_task_root,
            _r123_effect_scratch)
        and not r123_connected_materializer_effects_ok(
            _r123_connected_positive + [_r123_connected_prelude[0]],
            _r123_connected_span, r122_base_git, _r123_clean_root,
            _r123_connected_task_root, _r123_effect_scratch)
        and not r123_connected_materializer_effects_ok(
            _r123_connected_positive, _r123_connected_span, r122_base_git,
            _r123_clean_root, _r123_effect_scratch, _r123_effect_scratch)
        and not r123_connected_materializer_effects_ok(
            _r123_nested_task_positive, _r123_nested_task_span,
            r122_base_git, _r123_clean_root, _r123_nested_task_root,
            _r123_effect_scratch))

    # Python audit events do not expose raw native/FFI syscalls.  The product
    # materializer is therefore admitted only through a bounded capability
    # inventory before its module code is executed.  This is not an exact source
    # template: local structure, helper names and positional/keyword call forms
    # remain free.  It only closes native extension, reflection/dynamic-code and
    # alternate process capabilities while admitting the finite stdlib surface
    # whose concrete effects are independently checked above.
    _R123_MATERIALIZER_IMPORTS = {
        "base64", "fnmatch", "hashlib", "json", "os", "pathlib", "re",
        "secrets", "stat", "subprocess", "tempfile", "unicodedata"}
    _R123_MATERIALIZER_FROM = {
        ("__future__", "annotations"), ("pathlib", "Path")}
    _R123_MATERIALIZER_ATTRS = {
        "base64": {"b64decode"},
        "fnmatch": {"fnmatch"},
        "hashlib": {"sha256"},
        "json": {"dumps", "loads"},
        "os": {"fspath", "rmdir", "scandir", "unlink"},
        "re": {"findall", "finditer", "fullmatch"},
        "secrets": {"token_hex"},
        "stat": {"S_ISDIR", "S_ISREG"},
        "subprocess": {"PIPE", "run"},
        "tempfile": {"mkdtemp"},
        "unicodedata": {"normalize"},
    }
    _R123_DYNAMIC_NAMES = {
        "__builtins__", "__cached__", "__file__", "__import__", "__loader__",
        "__package__", "__spec__", "breakpoint", "compile", "delattr", "eval", "exec",
        "getattr", "globals", "help", "input", "locals", "memoryview",
        "open", "setattr", "vars"}
    _R123_SENSITIVE_MODULE_ATTRIBUTES = {
        "builtins", "cffi", "ctypes", "importlib", "marshal", "mmap",
        "modules", "multiprocessing", "os", "pickle", "posix", "pty",
        "socket", "subprocess", "sys", "threading"}
    _R123_UNOBSERVED_ATTRIBUTES = {
        "absolute", "chmod", "cwd", "expanduser", "glob", "group", "home",
        "ag_code", "ag_frame", "cr_code", "cr_frame", "f_back",
        "f_builtins", "f_code", "f_globals", "f_locals", "gi_code", "gi_frame",
        "hardlink_to", "is_block_device", "is_char_device", "is_fifo",
        "is_file", "is_mount", "is_socket", "is_symlink", "iterdir",
        "lchmod", "link_to", "lstat", "mkdir", "open", "owner",
        "read_bytes", "read_text", "readlink", "rename", "replace", "resolve",
        "rglob", "rmdir", "samefile", "stat", "symlink_to", "touch", "unlink",
        "walk", "write_bytes", "write_text"}

    def r123_module_constant_ok(node):
        if isinstance(node, ast.Constant):
            return isinstance(node.value, (str, bytes, int, float, bool, type(None)))
        if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
            return all(r123_module_constant_ok(item) for item in node.elts)
        if isinstance(node, ast.Dict):
            return (all(key is not None and r123_module_constant_ok(key)
                        for key in node.keys)
                    and all(r123_module_constant_ok(value)
                            for value in node.values))
        return (isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
                and node.func.id == "set" and len(node.args) == 1
                and not node.keywords and r123_module_constant_ok(node.args[0]))

    def r123_module_body_ok(tree):
        future_annotations = any(
            isinstance(node, ast.ImportFrom) and node.module == "__future__"
            and any(alias.name == "annotations" for alias in node.names)
            for node in tree.body)
        for node in tree.body:
            if isinstance(node, (ast.Import, ast.ImportFrom)):
                continue
            if (isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)
                    and isinstance(node.value.value, str)):
                continue
            if isinstance(node, ast.Assign):
                if (not node.targets
                        or any(not isinstance(target, ast.Name)
                               for target in node.targets)
                        or any(target.id == "set" for target in node.targets)
                        or not r123_module_constant_ok(node.value)):
                    return False
                continue
            if isinstance(node, ast.AnnAssign):
                if (not isinstance(node.target, ast.Name) or node.value is None
                        or node.target.id == "set"
                        or (not future_annotations
                            and not r123_module_constant_ok(node.annotation))
                        or not r123_module_constant_ok(node.value)):
                    return False
                continue
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                annotations = [node.returns]
                annotations.extend(arg.annotation for arg in (
                    *node.args.posonlyargs, *node.args.args,
                    *node.args.kwonlyargs))
                if (node.name == "set" or node.decorator_list
                        or (not future_annotations
                            and any(value is not None for value in annotations))
                        or any(not r123_module_constant_ok(value)
                               for value in (*node.args.defaults,
                                             *(item for item in node.args.kw_defaults
                                               if item is not None)))):
                    return False
                continue
            if isinstance(node, ast.ClassDef):
                if (node.name == "set" or node.decorator_list
                        or node.keywords or len(node.bases) != 1
                        or not isinstance(node.bases[0], ast.Name)
                        or node.bases[0].id != "Exception"
                        or any(not (isinstance(item, ast.Pass)
                                   or (isinstance(item, ast.Expr)
                                       and isinstance(item.value, ast.Constant)
                                       and isinstance(item.value.value, str)))
                               for item in node.body)):
                    return False
                continue
            return False
        return True

    def r123_materializer_source_ok(source_text):
        if not isinstance(source_text, str):
            return False
        try:
            tree = ast.parse(source_text)
        except (SyntaxError, ValueError, TypeError):
            return False
        if not r123_module_body_ok(tree):
            return False
        source_future_annotations = any(
            isinstance(node, ast.ImportFrom) and node.module == "__future__"
            and any(alias.name == "annotations" for alias in node.names)
            for node in tree.body)
        parents = {}
        for parent in ast.walk(tree):
            for child in ast.iter_child_nodes(parent):
                parents[id(child)] = parent
        imported_modules = {}
        imported_values = {}
        for node in ast.walk(tree):
            if isinstance(node, (ast.Global, ast.Nonlocal, ast.Lambda,
                                 ast.Yield, ast.YieldFrom, ast.AsyncFunctionDef)):
                return False
            if (isinstance(node, ast.ClassDef)
                    and not isinstance(parents.get(id(node)), ast.Module)):
                return False
            if (isinstance(node, ast.FunctionDef)
                    and not isinstance(parents.get(id(node)), ast.Module)):
                # Nested defaults/kw-defaults are evaluated in the enclosing
                # scope, before the nested function's parameters exist.  Admit
                # only inert literal defaults so a parameter cannot falsely
                # shadow __builtins__ or an imported capability in its own RHS.
                if (node.decorator_list
                        or (not source_future_annotations
                            and any(value is not None for value in (
                                node.returns,
                                *(arg.annotation for arg in (
                                    *node.args.posonlyargs, *node.args.args,
                                    *node.args.kwonlyargs)))))
                        or any(not r123_module_constant_ok(value)
                               for value in (*node.args.defaults,
                                             *(item for item in node.args.kw_defaults
                                               if item is not None)))):
                    return False
            if isinstance(node, ast.Import):
                if not isinstance(parents.get(id(node)), ast.Module):
                    return False
                for alias in node.names:
                    if alias.name not in _R123_MATERIALIZER_IMPORTS:
                        return False
                    local = alias.asname or alias.name
                    if local in imported_modules or local in imported_values:
                        return False
                    imported_modules[local] = alias.name
            elif isinstance(node, ast.ImportFrom):
                if (not isinstance(parents.get(id(node)), ast.Module)
                        or node.level != 0):
                    return False
                for alias in node.names:
                    if ((node.module, alias.name)
                            not in _R123_MATERIALIZER_FROM):
                        return False
                    if node.module != "__future__":
                        local = alias.asname or alias.name
                        if local in imported_modules or local in imported_values:
                            return False
                        imported_values[local] = (node.module, alias.name)
            elif isinstance(node, ast.Attribute) and node.attr.startswith("_"):
                return False
            elif (isinstance(node, ast.Attribute)
                  and node.attr in _R123_SENSITIVE_MODULE_ATTRIBUTES):
                return False
            elif (isinstance(node, ast.Attribute)
                  and node.attr in {"exists", "is_dir"}):
                parent = parents.get(id(node))
                if not (isinstance(parent, ast.Call) and parent.func is node):
                    return False
        function_types = (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)
        function_scopes = [node for node in ast.walk(tree)
                           if isinstance(node, function_types)]
        scope_locals = {id(node): {
            arg.arg for arg in (*node.args.posonlyargs, *node.args.args,
                                *node.args.kwonlyargs,
                                *((node.args.vararg,) if node.args.vararg else ()),
                                *((node.args.kwarg,) if node.args.kwarg else ()))}
                        for node in function_scopes}
        comprehension_types = (
            ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp)
        def inside_comprehension(node):
            cursor = parents.get(id(node))
            while cursor is not None and not isinstance(cursor, ast.FunctionDef):
                if isinstance(cursor, comprehension_types):
                    return True
                cursor = parents.get(id(cursor))
            return False
        def is_descendant(node, ancestor):
            cursor = node
            while cursor is not None:
                if cursor is ancestor:
                    return True
                cursor = parents.get(id(cursor))
            return False
        def comprehension_shadows(node, name):
            cursor = parents.get(id(node))
            while cursor is not None:
                if isinstance(cursor, comprehension_types):
                    bound = False
                    for generator in cursor.generators:
                        if is_descendant(node, generator.iter):
                            break
                        target_names = {
                            target.id for target in ast.walk(generator.target)
                            if isinstance(target, ast.Name)
                            and isinstance(target.ctx, ast.Store)}
                        bound |= name in target_names
                        if any(is_descendant(node, guard)
                               for guard in generator.ifs):
                            break
                    if bound:
                        return True
                    # A nested comprehension that does not bind this name must
                    # not hide an outer comprehension target.  In particular,
                    # the inner element of ``[[sys for _ in xs] for sys in
                    # ys]`` is evaluated with the outer ``sys`` binding.
                    cursor = parents.get(id(cursor))
                    continue
                if isinstance(cursor, function_types):
                    return False
                cursor = parents.get(id(cursor))
            return False
        def definition_time_roots(function):
            roots = [*function.args.defaults,
                     *(value for value in function.args.kw_defaults
                       if value is not None)]
            if isinstance(function, (ast.FunctionDef, ast.AsyncFunctionDef)):
                roots.extend(function.decorator_list)
            return tuple(roots)
        def direct_child_under(node, ancestor):
            child = node
            parent = parents.get(id(child))
            while parent is not None and parent is not ancestor:
                child = parent
                parent = parents.get(id(child))
            return child if parent is ancestor else None
        def nearest_function(node):
            cursor = parents.get(id(node))
            while cursor is not None:
                if isinstance(cursor, function_types):
                    # Decorators, defaults/kw-defaults and runtime annotations
                    # are evaluated in the enclosing lexical scope, before the
                    # declared function's parameters or locals exist.  Only the
                    # function/lambda body is governed by its new local scope.
                    if any(is_descendant(node, root)
                           for root in definition_time_roots(cursor)):
                        cursor = parents.get(id(cursor))
                        continue
                    return cursor
                cursor = parents.get(id(cursor))
            return None
        for node in ast.walk(tree):
            if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store):
                scope = nearest_function(node)
                if inside_comprehension(node):
                    # Comprehension targets live in their own implicit scope;
                    # they never shadow a later enclosing-function load.  Ban
                    # sensitive/imported spellings as targets so loads inside
                    # that implicit scope cannot borrow capability credit.
                    if (node.id in _R123_DYNAMIC_NAMES
                            or node.id in imported_modules
                            or node.id in imported_values):
                        return False
                    continue
                if scope is None:
                    if node.id in imported_modules or node.id in imported_values:
                        return False
                else:
                    scope_locals[id(scope)].add(node.id)
            elif isinstance(node, ast.FunctionDef):
                outer = nearest_function(node)
                if outer is not None:
                    scope_locals[id(outer)].add(node.name)
        def is_shadowed(node, name):
            cursor = nearest_function(node)
            while cursor is not None:
                if name in scope_locals[id(cursor)]:
                    return True
                cursor = nearest_function(cursor)
            return False
        for node in ast.walk(tree):
            if (isinstance(node, ast.Name) and node.id in _R123_DYNAMIC_NAMES
                    and not is_shadowed(node, node.id)):
                return False
            if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load):
                parent = parents.get(id(node))
                if node.id in imported_modules and not is_shadowed(node, node.id):
                    if not (isinstance(parent, ast.Attribute)
                            and parent.value is node):
                        return False
                elif (node.id in imported_values
                      and not is_shadowed(node, node.id)):
                    if imported_values[node.id] == ("pathlib", "Path"):
                        if not (isinstance(parent, ast.Call)
                                and parent.func is node):
                            return False
            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
                root = node.func.value
                if (isinstance(root, ast.Name)
                        and not is_shadowed(root, root.id)
                        and imported_modules.get(root.id) == "subprocess"
                        and node.func.attr == "run"):
                    if (len(node.args) != 1 or isinstance(node.args[0], ast.Starred)
                            or any(keyword.arg is None for keyword in node.keywords)
                            or len({keyword.arg for keyword in node.keywords})
                                != len(node.keywords)
                            or {keyword.arg for keyword in node.keywords}
                                - {"check", "env", "input", "stdout", "stderr",
                                   "timeout"}):
                        return False
                    keyword_values = {keyword.arg: keyword.value
                                      for keyword in node.keywords}
                    check_value = keyword_values.get("check")
                    timeout_value = keyword_values.get("timeout")
                    for stream_name in ("stdout", "stderr"):
                        stream_value = keyword_values.get(stream_name)
                        if not (isinstance(stream_value, ast.Attribute)
                                and stream_value.attr == "PIPE"
                                and isinstance(stream_value.value, ast.Name)
                                and not is_shadowed(
                                    stream_value.value, stream_value.value.id)
                                and imported_modules.get(stream_value.value.id)
                                    == "subprocess"):
                            return False
                    if (check_value is not None
                            and not (isinstance(check_value, ast.Constant)
                                     and type(check_value.value) is bool)):
                        return False
                    if (timeout_value is not None
                            and not (isinstance(timeout_value, ast.Constant)
                                     and type(timeout_value.value) in {int, float}
                                     and 0 < timeout_value.value <= 300)):
                        return False
            if not isinstance(node, ast.Attribute):
                continue
            parts = []
            cursor = node
            while isinstance(cursor, ast.Attribute):
                parts.append(cursor.attr)
                cursor = cursor.value
            if (isinstance(cursor, ast.Name) and cursor.id in imported_modules
                    and not is_shadowed(cursor, cursor.id)):
                chain = ".".join(reversed(parts))
                module = imported_modules[cursor.id]
                if chain not in _R123_MATERIALIZER_ATTRS.get(module, set()):
                    return False
                parent = parents.get(id(node))
                if (chain != "PIPE"
                        and not (isinstance(parent, ast.Call)
                                 and parent.func is node)):
                    return False
            elif node.attr in _R123_UNOBSERVED_ATTRIBUTES:
                # Object/Path proxy methods can perform or observe effects that
                # the selected audit surface cannot bind.  Exact allowlisted
                # module calls such as os.unlink/os.rmdir are handled by the
                # branch above and remain admitted; arbitrary receiver methods
                # do not inherit that authority merely by sharing a spelling.
                return False
        return True

    # The accepted materializer is invoked by the product autopilot.  Python's
    # audit stream does not expose raw libc/FFI effects, so the caller itself
    # must also be closed against native-capability recovery.  H031 continues
    # to own its broader process/source-form authority; this narrower,
    # controller-wide predicate only denies ways to hide effects around the
    # otherwise genuine materialize call.
    _R123_CONTROLLER_FORBIDDEN_IMPORT_ROOTS = {
        "_ctypes", "_cffi_backend", "_posixsubprocess", "builtins", "cffi",
        "code", "codeop", "ctypes", "gc", "importlib", "marshal", "mmap",
        "pickle", "pkgutil", "posix", "runpy", "site", "types", "zipimport"}
    _R123_CONTROLLER_AMBIENT_NAMES = {
        "__builtins__", "__cached__", "__import__", "__loader__", "__package__",
        "__spec__", "breakpoint", "compile", "delattr", "eval", "exec", "help",
        "locals", "setattr", "vars"}
    _R123_CONTROLLER_PROXY_ATTRIBUTES = {
        "CDLL", "PyDLL", "ag_frame", "builtins", "cffi", "cr_frame", "ctypes",
        "exec_module", "f_back", "f_builtins", "f_globals", "f_locals",
        "find_spec", "gi_frame", "importlib", "load_module", "loader", "modules",
        "meta_path", "module_from_spec", "os", "path_hooks", "path_importer_cache",
        "posix", "sys"}
    _R123_CONTROLLER_FRAME_ATTRIBUTES = {
        "ag_frame", "cr_frame", "f_back", "f_builtins", "f_globals", "f_locals",
        "gi_frame"}
    _R123_CONTROLLER_MODULE_FIRST_HOPS = {
        "argparse": {"ArgumentParser", "Namespace"},
        "dt": {"datetime", "timezone"},
        "fcntl": {"F_GETPATH", "LOCK_EX", "LOCK_NB", "fcntl", "flock"},
        "hashlib": {"sha256"},
        "json": {"dumps", "loads"},
        "os": {"O_CREAT", "O_EXCL", "O_RDONLY", "O_WRONLY", "X_OK", "access",
               "chmod", "close", "environ", "fdopen", "fstat", "fsync", "getpid",
               "getuid", "open", "read", "sep", "system", "unlink", "urandom",
               "write"},
        "re": {"fullmatch"},
        "shutil": {"rmtree", "which"},
        "stat": {"S_IMODE", "S_ISDIR", "S_ISREG"},
        "subprocess": {"PIPE", "Popen", "STDOUT", "run"},
        "sys": {"dont_write_bytecode", "path", "stderr", "stdout", "version",
                "version_info"},
        "tempfile": {"mkdtemp"},
        "time": {"sleep"},
    }
    _R123_CONTROLLER_GETATTR_FLAGS = {"O_CLOEXEC", "O_NOFOLLOW"}
    _R123_CONTROLLER_BOUND_CAPABILITY_ATTRIBUTES = {
        "absolute", "chmod", "cwd", "expanduser", "glob", "group", "home",
        "hardlink_to", "exists", "is_block_device", "is_char_device",
        "is_dir", "is_fifo", "is_file", "is_mount", "is_socket",
        "is_symlink", "iterdir",
        "lchmod", "link_to", "lstat", "mkdir", "open", "owner",
        "read_bytes", "read_text", "readlink", "rename", "replace",
        "resolve", "rglob", "rmdir", "samefile", "stat", "symlink_to",
        "touch", "unlink", "walk", "write_bytes", "write_text"}
    _R123_CONTROLLER_IMPORTED_VALUE_PATHS = {
        ("fcntl", "F_GETPATH"), ("fcntl", "LOCK_EX"),
        ("fcntl", "LOCK_NB"),
        ("os", "O_CREAT"), ("os", "O_EXCL"), ("os", "O_RDONLY"),
        ("os", "O_WRONLY"), ("os", "X_OK"), ("os", "sep"),
        ("subprocess", "PIPE"), ("subprocess", "STDOUT"),
        ("sys", "dont_write_bytecode"),
        ("sys", "version_info"), ("dt", "timezone", "utc"),
    }
    _R123_CONTROLLER_COMMON_IMPORTS = {
        "F:0:__future__:annotations",
        "I:argparse", "I:datetime", "I:fcntl", "I:hashlib",
        "I:json", "I:os", "I:re", "I:shutil", "I:stat",
        "I:subprocess", "I:sys", "I:tempfile", "I:time",
        "F:0:dataclasses:dataclass", "F:0:pathlib:Path",
        "F:0:typing:Any", "F:0:typing:Iterable"}
    _R123_CONTROLLER_LEGACY_IMPORTS = _R123_CONTROLLER_COMMON_IMPORTS | {
        "F:0:core:AuthorityError", "F:0:core:canonical_path",
        "F:0:core:permits", "F:0:core:strict_json_bytes"}
    _R123_CONTROLLER_RESULT_IMPORTS = _R123_CONTROLLER_COMMON_IMPORTS | {
        "F:0:controller.authority.core:AuthorityError",
        "F:0:controller.authority.core:canonical_path",
        "F:0:controller.authority.core:permits",
        "F:0:controller.authority.core:strict_json_bytes",
        "F:0:controller.result.consumer:consume_private_result",
        "F:0:controller.result.materialize:materialize"}

    def r123_controller_native_source_ok(source_text):
        if not isinstance(source_text, str):
            return False
        try:
            tree = ast.parse(source_text)
        except (SyntaxError, ValueError, TypeError):
            return False
        import_inventory = []
        module_bindings = {}
        from_bindings = {}
        for node in tree.body:
            if isinstance(node, ast.Import):
                for alias in node.names:
                    import_inventory.append(f"I:{alias.name}")
                    local = alias.asname or alias.name.split(".", 1)[0]
                    capability = "dt" if alias.name == "datetime" else alias.name
                    if local in module_bindings:
                        return False
                    module_bindings[local] = capability
            elif isinstance(node, ast.ImportFrom):
                import_inventory.extend(
                    f"F:{node.level}:{node.module or ''}:{alias.name}"
                    for alias in node.names)
                for alias in node.names:
                    local = alias.asname or alias.name
                    if local in from_bindings:
                        return False
                    from_bindings[local] = (
                        node.level, node.module or "", alias.name)
        if frozenset(import_inventory) not in {
                frozenset(_R123_CONTROLLER_LEGACY_IMPORTS),
                frozenset(_R123_CONTROLLER_RESULT_IMPORTS)}:
            return False
        if len(import_inventory) != len(set(import_inventory)):
            return False
        parents = {id(child): parent for parent in ast.walk(tree)
                   for child in ast.iter_child_nodes(parent)}
        function_types = (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)
        function_scopes = [node for node in ast.walk(tree)
                           if isinstance(node, function_types)]
        scope_locals = {id(node): {
            arg.arg for arg in (*node.args.posonlyargs, *node.args.args,
                                *node.args.kwonlyargs,
                                *((node.args.vararg,) if node.args.vararg else ()),
                                *((node.args.kwarg,) if node.args.kwarg else ()))}
                        for node in function_scopes}
        scope_globals = {id(node): set() for node in function_scopes}
        comprehension_types = (
            ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp)
        def definition_time_roots(function):
            roots = [*function.args.defaults,
                     *(value for value in function.args.kw_defaults
                       if value is not None)]
            if isinstance(function, (ast.FunctionDef, ast.AsyncFunctionDef)):
                roots.extend(function.decorator_list)
            return tuple(roots)
        def direct_child_under(node, ancestor):
            child = node
            parent = parents.get(id(child))
            while parent is not None and parent is not ancestor:
                child = parent
                parent = parents.get(id(child))
            return child if parent is ancestor else None
        def nearest_function(node):
            cursor = parents.get(id(node))
            while cursor is not None:
                if isinstance(cursor, function_types):
                    if any(is_descendant(node, root)
                           for root in definition_time_roots(cursor)):
                        cursor = parents.get(id(cursor))
                        continue
                    return cursor
                cursor = parents.get(id(cursor))
            return None
        def inside_comprehension(node):
            cursor = parents.get(id(node))
            while cursor is not None and not isinstance(cursor, function_types):
                if isinstance(cursor, comprehension_types):
                    return True
                cursor = parents.get(id(cursor))
            return False
        def is_descendant(node, ancestor):
            cursor = node
            while cursor is not None:
                if cursor is ancestor:
                    return True
                cursor = parents.get(id(cursor))
            return False
        def comprehension_shadows(node, name):
            cursor = parents.get(id(node))
            while cursor is not None:
                if isinstance(cursor, comprehension_types):
                    bound = False
                    for generator in cursor.generators:
                        if is_descendant(node, generator.iter):
                            break
                        target_names = {
                            target.id for target in ast.walk(generator.target)
                            if isinstance(target, ast.Name)
                            and isinstance(target.ctx, ast.Store)}
                        bound |= name in target_names
                        if any(is_descendant(node, guard)
                               for guard in generator.ifs):
                            break
                    if bound:
                        return True
                    cursor = parents.get(id(cursor))
                    continue
                if isinstance(cursor, function_types):
                    return False
                cursor = parents.get(id(cursor))
            return False
        def inside_nested_class_body(node, function_scope):
            cursor = parents.get(id(node))
            while cursor is not None and cursor is not function_scope:
                if isinstance(cursor, ast.ClassDef):
                    definition_roots = (
                        *cursor.decorator_list, *cursor.bases,
                        *(keyword.value for keyword in cursor.keywords))
                    if any(is_descendant(node, root)
                           for root in definition_roots):
                        cursor = parents.get(id(cursor))
                        continue
                    return True
                cursor = parents.get(id(cursor))
            return False
        def r125_class_statement_effect(statement, name):
            if isinstance(statement, (ast.FunctionDef, ast.AsyncFunctionDef,
                                      ast.ClassDef)):
                return "bind" if statement.name == name else None
            if isinstance(statement, (ast.Assign, ast.AnnAssign)):
                if isinstance(statement, ast.AnnAssign) \
                        and statement.value is None:
                    return None
                targets = (statement.targets if isinstance(statement, ast.Assign)
                           else (statement.target,))
                if any(name in {target.id for target in ast.walk(item)
                                if isinstance(target, ast.Name)
                                and isinstance(target.ctx, ast.Store)}
                       for item in targets):
                    return "bind"
                return None
            if isinstance(statement, ast.Delete):
                if any(name in {target.id for target in ast.walk(item)
                                if isinstance(target, ast.Name)
                                and isinstance(target.ctx, ast.Del)}
                       for item in statement.targets):
                    return "delete"
                return None
            if isinstance(statement, ast.Import):
                return ("bind" if any(
                    (alias.asname or alias.name.split(".", 1)[0]) == name
                    for alias in statement.names) else None)
            if isinstance(statement, ast.ImportFrom):
                return ("bind" if any((alias.asname or alias.name) == name
                                      for alias in statement.names) else None)
            if isinstance(statement, ast.Try):
                handlers = [handler for handler in statement.handlers
                            if handler.name == name]
                if handlers:
                    deterministic_cleanup = (
                        len(statement.body) == 1
                        and isinstance(statement.body[0], ast.Raise)
                        and isinstance(statement.body[0].exc, ast.Call)
                        and isinstance(statement.body[0].exc.func, ast.Name)
                        and len(handlers) == 1
                        and isinstance(handlers[0].type, ast.Name)
                        and handlers[0].type.id
                            == statement.body[0].exc.func.id
                        and not statement.orelse and not statement.finalbody)
                    return "delete" if deterministic_cleanup else "ambiguous"
            # Conditional/loop/try/match bindings are path-dependent.  A
            # possible prior bind is fail-closed; comprehension targets and
            # nested function/class bodies do not leak into the class mapping.
            for candidate in ast.walk(statement):
                if candidate is statement:
                    continue
                cursor = parents.get(id(candidate))
                nested = False
                while cursor is not None and cursor is not statement:
                    if isinstance(cursor, (*function_types, ast.ClassDef,
                                           *comprehension_types)):
                        nested = True
                        break
                    cursor = parents.get(id(cursor))
                if nested:
                    continue
                if (isinstance(candidate, ast.Name)
                        and candidate.id == name
                        and isinstance(candidate.ctx, (ast.Store, ast.Del))):
                    return "ambiguous"
                if (isinstance(candidate, ast.ExceptHandler)
                        and candidate.name == name):
                    return "ambiguous"
                if (isinstance(candidate, (ast.FunctionDef,
                                           ast.AsyncFunctionDef,
                                           ast.ClassDef))
                        and candidate.name == name):
                    return "ambiguous"
            return None
        def r125_active_class_binding(node, name, class_statement):
            cursor = parents.get(id(node))
            while cursor is not None:
                if (isinstance(cursor, ast.ExceptHandler)
                        and cursor.name == name
                        and any(is_descendant(node, statement)
                                for statement in cursor.body)):
                    return True
                if isinstance(cursor, (ast.For, ast.AsyncFor)):
                    targets = {target.id for target in ast.walk(cursor.target)
                               if isinstance(target, ast.Name)
                               and isinstance(target.ctx, ast.Store)}
                    if (name in targets and any(is_descendant(node, statement)
                                                for statement in cursor.body)):
                        return True
                if isinstance(cursor, (ast.With, ast.AsyncWith)):
                    targets = {
                        target.id for item in cursor.items
                        if item.optional_vars is not None
                        for target in ast.walk(item.optional_vars)
                        if isinstance(target, ast.Name)
                        and isinstance(target.ctx, ast.Store)}
                    if (name in targets and any(is_descendant(node, statement)
                                                for statement in cursor.body)):
                        return True
                if type(cursor).__name__ == "match_case":
                    targets = {target.id for target in ast.walk(cursor.pattern)
                               if isinstance(target, ast.Name)
                               and isinstance(target.ctx, ast.Store)}
                    # Match capture names are represented by strings on
                    # MatchAs/MatchStar rather than Name(Store).
                    targets |= {target.name for target in ast.walk(cursor.pattern)
                                if isinstance(target,
                                              (ast.MatchAs, ast.MatchStar))
                                and isinstance(target.name, str)}
                    if name in targets:
                        return True
                if cursor is class_statement:
                    break
                cursor = parents.get(id(cursor))
            return False
        def r125_class_scope_state(node, name):
            cursor = parents.get(id(node))
            while cursor is not None:
                if isinstance(cursor, comprehension_types):
                    # CPython evaluates only the outermost iterable in the
                    # enclosing namespace.  The element, filters and later
                    # iterables execute in the comprehension's implicit
                    # function and cannot see class locals.
                    if (cursor.generators
                            and is_descendant(node,
                                              cursor.generators[0].iter)):
                        cursor = parents.get(id(cursor))
                        continue
                    return "absent"
                if isinstance(cursor, function_types):
                    if any(is_descendant(node, root)
                           for root in definition_time_roots(cursor)):
                        cursor = parents.get(id(cursor))
                        continue
                    return "absent"
                if isinstance(cursor, ast.ClassDef):
                    definition_roots = (
                        *cursor.decorator_list, *cursor.bases,
                        *(keyword.value for keyword in cursor.keywords))
                    if any(is_descendant(node, root)
                           for root in definition_roots):
                        cursor = parents.get(id(cursor))
                        continue
                    child = direct_child_under(node, cursor)
                    if child not in cursor.body:
                        return "absent"
                    bound = False
                    ambiguous = False
                    for statement in cursor.body:
                        if statement is child:
                            break
                        effect = r125_class_statement_effect(statement, name)
                        if effect == "bind":
                            bound = True
                            ambiguous = False
                        elif effect == "ambiguous":
                            bound = False
                            ambiguous = True
                        elif effect == "delete":
                            bound = False
                            ambiguous = False
                    if r125_active_class_binding(node, name, child):
                        return "bound"
                    if ambiguous:
                        return "ambiguous"
                    return "bound" if bound else "absent"
                cursor = parents.get(id(cursor))
            return "absent"
        def r125_class_scope_shadows(node, name):
            return r125_class_scope_state(node, name) == "bound"
        for candidate in ast.walk(tree):
            scope = nearest_function(candidate)
            if isinstance(candidate, ast.Nonlocal):
                return False
            if isinstance(candidate, ast.Global) and scope is not None:
                if any(name in module_bindings or name in from_bindings
                       or name in {"getattr", "globals", "input", "open",
                                   "print"}
                       for name in candidate.names):
                    return False
                if not inside_nested_class_body(candidate, scope):
                    scope_globals[id(scope)].update(candidate.names)
            elif (isinstance(candidate, ast.Name)
                  and isinstance(candidate.ctx, ast.Store)
                  and scope is not None
                  and not inside_nested_class_body(candidate, scope)
                  and (not inside_comprehension(candidate)
                       or (isinstance(parents.get(id(candidate)), ast.NamedExpr)
                           and parents[id(candidate)].target is candidate))):
                scope_locals[id(scope)].add(candidate.id)
            elif (isinstance(candidate, ast.ExceptHandler)
                  and isinstance(candidate.name, str) and scope is not None
                  and not inside_nested_class_body(candidate, scope)):
                scope_locals[id(scope)].add(candidate.name)
            elif (isinstance(candidate,
                             (ast.FunctionDef, ast.AsyncFunctionDef,
                              ast.ClassDef))
                  and scope is not None):
                # A nested definition binds its name in the containing
                # function, just like an ordinary assignment.  Its own body
                # remains a distinct scope and is not flattened here.
                if not inside_nested_class_body(candidate, scope):
                    scope_locals[id(scope)].add(candidate.name)
        r125_scope_binding_counts = {}
        for scope in function_scopes:
            for argument in (*scope.args.posonlyargs, *scope.args.args,
                             *scope.args.kwonlyargs,
                             *((scope.args.vararg,) if scope.args.vararg else ()),
                             *((scope.args.kwarg,) if scope.args.kwarg else ())):
                key = (id(scope), argument.arg)
                r125_scope_binding_counts[key] = (
                    r125_scope_binding_counts.get(key, 0) + 1)
        for candidate in ast.walk(tree):
            scope = nearest_function(candidate)
            if scope is None or inside_nested_class_body(candidate, scope):
                continue
            name = None
            if (isinstance(candidate, ast.Name)
                    and isinstance(candidate.ctx, (ast.Store, ast.Del))
                    and (not inside_comprehension(candidate)
                         or (isinstance(parents.get(id(candidate)),
                                        ast.NamedExpr)
                             and parents[id(candidate)].target is candidate))):
                name = candidate.id
            elif (isinstance(candidate, ast.ExceptHandler)
                  and isinstance(candidate.name, str)):
                name = candidate.name
            elif isinstance(candidate, (ast.FunctionDef,
                                        ast.AsyncFunctionDef,
                                        ast.ClassDef)):
                name = candidate.name
            if name is not None:
                key = (id(scope), name)
                r125_scope_binding_counts[key] = (
                    r125_scope_binding_counts.get(key, 0) + 1)
        def is_shadowed(node, name):
            if comprehension_shadows(node, name):
                return True
            if r125_class_scope_shadows(node, name):
                return True
            scope = nearest_function(node)
            while scope is not None:
                if name in scope_globals[id(scope)]:
                    return False
                if name in scope_locals[id(scope)]:
                    return True
                scope = nearest_function(scope)
            return False
        annotation_roots = []
        for candidate in ast.walk(tree):
            if isinstance(candidate, (ast.FunctionDef, ast.AsyncFunctionDef)):
                annotation_roots.extend(arg.annotation for arg in (
                    *candidate.args.posonlyargs, *candidate.args.args,
                    *candidate.args.kwonlyargs)
                    if arg.annotation is not None)
                if (candidate.args.vararg is not None
                        and candidate.args.vararg.annotation is not None):
                    annotation_roots.append(candidate.args.vararg.annotation)
                if (candidate.args.kwarg is not None
                        and candidate.args.kwarg.annotation is not None):
                    annotation_roots.append(candidate.args.kwarg.annotation)
                if candidate.returns is not None:
                    annotation_roots.append(candidate.returns)
            elif isinstance(candidate, ast.AnnAssign):
                annotation_roots.append(candidate.annotation)
        inert_annotation_ids = {
            id(descendant) for root in annotation_roots
            for descendant in ast.walk(root)}
        def in_inert_annotation(node):
            return id(node) in inert_annotation_ids
        def r125_literal_data(node):
            if isinstance(node, ast.Constant):
                return True
            if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
                return all(r125_literal_data(item) for item in node.elts)
            if isinstance(node, ast.Dict):
                return all(key is not None and r125_literal_data(key)
                           and r125_literal_data(value)
                           for key, value in zip(node.keys, node.values))
            return False
        # Definition-time helper calls are admitted by bounded purity and
        # provenance, never by their spelling.  This keeps ordinary identity
        # factories/decorators/class selectors legitimate without allowing a
        # helper to relay an imported module, fd, path or other ambient
        # capability into the pre-observer window.
        r125_module_definitions = {}
        r125_module_values = {}
        r125_module_binding_counts = {}
        def r125_record_module_binding(name):
            if isinstance(name, str):
                r125_module_binding_counts[name] = (
                    r125_module_binding_counts.get(name, 0) + 1)
        def r125_target_names(target):
            if isinstance(target, ast.Name):
                return (target.id,)
            if isinstance(target, (ast.Tuple, ast.List)):
                return tuple(name for item in target.elts
                             for name in r125_target_names(item))
            return ()
        def r125_module_scope_binding(node):
            cursor = parents.get(id(node))
            while cursor is not None:
                if isinstance(cursor, function_types):
                    if any(is_descendant(node, root)
                           for root in definition_time_roots(cursor)):
                        cursor = parents.get(id(cursor))
                        continue
                    return False
                if isinstance(cursor, ast.ClassDef):
                    definition_roots = (
                        *cursor.decorator_list, *cursor.bases,
                        *(keyword.value for keyword in cursor.keywords))
                    if any(is_descendant(node, root)
                           for root in definition_roots):
                        cursor = parents.get(id(cursor))
                        continue
                    return False
                if isinstance(cursor, comprehension_types):
                    named_expression = parents.get(id(node))
                    while (named_expression is not None
                           and named_expression is not cursor
                           and not isinstance(named_expression, ast.NamedExpr)):
                        named_expression = parents.get(id(named_expression))
                    if (not isinstance(named_expression, ast.NamedExpr)
                            or not is_descendant(
                                node, named_expression.target)):
                        return False
                cursor = parents.get(id(cursor))
            return True
        for statement in ast.walk(tree):
            if (isinstance(statement, (ast.FunctionDef, ast.AsyncFunctionDef,
                                       ast.ClassDef))
                    and r125_module_scope_binding(statement)):
                r125_record_module_binding(statement.name)
                r125_module_definitions.setdefault(statement.name, statement)
            elif (isinstance(statement, ast.Import)
                  and r125_module_scope_binding(statement)):
                for alias in statement.names:
                    r125_record_module_binding(
                        alias.asname or alias.name.split(".", 1)[0])
            elif (isinstance(statement, ast.ImportFrom)
                  and r125_module_scope_binding(statement)):
                for alias in statement.names:
                    r125_record_module_binding(alias.asname or alias.name)
            elif (isinstance(statement, ast.Name)
                  and isinstance(statement.ctx, (ast.Store, ast.Del))):
                scope = nearest_function(statement)
                if (r125_module_scope_binding(statement)
                        or (scope is not None
                            and statement.id in scope_globals[id(scope)])):
                    r125_record_module_binding(statement.id)
            elif (isinstance(statement, ast.ExceptHandler)
                  and isinstance(statement.name, str)
                  and r125_module_scope_binding(statement)):
                r125_record_module_binding(statement.name)
        for statement in tree.body:
            if (isinstance(statement, ast.Assign)
                    and len(statement.targets) == 1
                    and isinstance(statement.targets[0], ast.Name)
                    and r125_module_binding_counts.get(
                        statement.targets[0].id) == 1):
                r125_module_values[statement.targets[0].id] = statement.value
            elif (type(statement).__name__ in {"MatchAs", "MatchStar"}
                  and isinstance(statement.name, str)
                  and r125_module_scope_binding(statement)):
                r125_record_module_binding(statement.name)
        def r125_inert_local_class(node, visiting):
            if not isinstance(node, ast.ClassDef) or node.decorator_list \
                    or node.keywords:
                return False
            if any(not r125_pure_definition_value(base, frozenset(), visiting)
                   for base in node.bases):
                return False
            for statement in node.body:
                if isinstance(statement, ast.Pass):
                    continue
                if (isinstance(statement, ast.Expr)
                        and isinstance(statement.value, ast.Constant)
                        and isinstance(statement.value.value, str)):
                    continue
                if (isinstance(statement, ast.Assign)
                        and all(isinstance(target, ast.Name)
                                for target in statement.targets)
                        and r125_pure_definition_value(
                            statement.value, frozenset(), visiting)):
                    continue
                if (isinstance(statement, ast.AnnAssign)
                        and isinstance(statement.target, ast.Name)
                        and (statement.value is None
                             or r125_pure_definition_value(
                                 statement.value, frozenset(), visiting))):
                    continue
                return False
            return True
        def r125_pure_local_function(node, visiting):
            if (not isinstance(node, ast.FunctionDef) or node.decorator_list
                    or node.name in visiting):
                return False
            statements = list(node.body)
            if (statements and isinstance(statements[0], ast.Expr)
                    and isinstance(statements[0].value, ast.Constant)
                    and isinstance(statements[0].value.value, str)):
                statements = statements[1:]
            if len(statements) != 1 or not isinstance(statements[0], ast.Return):
                return False
            parameters = frozenset(arg.arg for arg in (
                *node.args.posonlyargs, *node.args.args,
                *node.args.kwonlyargs,
                *((node.args.vararg,) if node.args.vararg else ()),
                *((node.args.kwarg,) if node.args.kwarg else ())))
            return r125_pure_definition_value(
                statements[0].value, parameters, visiting | {node.name})
        def r125_pure_local_call(node, visiting=frozenset()):
            if (not isinstance(node.func, ast.Name)
                    or any(keyword.arg is None for keyword in node.keywords)):
                return False
            name = node.func.id
            function = r125_module_definitions.get(name)
            if r125_module_binding_counts.get(name) != 1:
                return False
            local_value = r125_module_values.get(name)
            if isinstance(local_value, ast.Lambda):
                if (any(isinstance(argument, ast.Starred)
                        for argument in node.args)
                        or any(keyword.arg is None for keyword in node.keywords)
                        or not r125_pure_definition_value(
                            local_value, frozenset(), visiting | {name})
                        or any(not r125_pure_definition_value(
                            value, frozenset(), visiting | {name})
                               for value in (*node.args,
                                   *(keyword.value for keyword in node.keywords)))):
                    return False
                regular = [*local_value.args.posonlyargs,
                           *local_value.args.args]
                if (len(node.args) > len(regular)
                        and local_value.args.vararg is None):
                    return False
                allowed_keywords = {arg.arg for arg in (
                    *regular, *local_value.args.kwonlyargs)}
                if (local_value.args.kwarg is None
                        and any(keyword.arg not in allowed_keywords
                                for keyword in node.keywords)):
                    return False
                return True
            if isinstance(function, ast.ClassDef):
                return (not node.args and not node.keywords
                        and r125_inert_local_class(function, visiting | {name}))
            if not r125_pure_local_function(function, visiting):
                return False
            parameters = [*function.args.posonlyargs, *function.args.args]
            positional = len(node.args)
            if positional > len(parameters) and function.args.vararg is None:
                return False
            parameter_names = {arg.arg for arg in (
                *parameters, *function.args.kwonlyargs)}
            if (function.args.kwarg is None
                    and any(keyword.arg not in parameter_names
                            for keyword in node.keywords)):
                return False
            supplied = {arg.arg for arg in parameters[:positional]} | {
                keyword.arg for keyword in node.keywords}
            defaults = {
                arg.arg: value for arg, value in zip(
                    parameters[len(parameters) - len(function.args.defaults):],
                    function.args.defaults)}
            defaults.update({
                arg.arg: value for arg, value in zip(
                    function.args.kwonlyargs, function.args.kw_defaults)
                if value is not None})
            if any(arg.arg not in supplied and arg.arg not in defaults
                   for arg in (*parameters, *function.args.kwonlyargs)):
                return False
            values = [*node.args, *(keyword.value for keyword in node.keywords),
                      *(value for key, value in defaults.items()
                        if key not in supplied)]
            return all(r125_pure_definition_value(
                       value, frozenset(), visiting | {name})
                       for value in values)
        def r125_pure_definition_value(node, parameters=frozenset(),
                                       visiting=frozenset()):
            if node is None or isinstance(node, ast.Constant):
                return True
            if isinstance(node, ast.Name):
                if node.id in parameters:
                    return True
                if node.id in {"object", "Exception", "RuntimeError",
                               "ValueError"} and r125_module_binding_counts.get(
                                   node.id, 0) == 0:
                    return True
                definition = r125_module_definitions.get(node.id)
                return (r125_module_binding_counts.get(node.id) == 1
                        and r125_inert_local_class(definition, visiting))
            if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
                return all(r125_pure_definition_value(
                           item, parameters, visiting) for item in node.elts)
            if isinstance(node, ast.Dict):
                return all(key is not None
                           and r125_pure_definition_value(
                               key, parameters, visiting)
                           and r125_pure_definition_value(
                               value, parameters, visiting)
                           for key, value in zip(node.keys, node.values))
            if isinstance(node, ast.Lambda):
                if node.args.vararg is not None or node.args.kwarg is not None:
                    return False
                lambda_parameters = parameters | frozenset(arg.arg for arg in (
                    *node.args.posonlyargs, *node.args.args,
                    *node.args.kwonlyargs))
                return (all(r125_pure_definition_value(
                            value, parameters, visiting)
                            for value in (*node.args.defaults,
                                *(value for value in node.args.kw_defaults
                                  if value is not None)))
                        and r125_pure_definition_value(
                            node.body, lambda_parameters, visiting))
            if isinstance(node, ast.UnaryOp):
                return r125_pure_definition_value(
                    node.operand, parameters, visiting)
            if isinstance(node, ast.BinOp):
                return (r125_pure_definition_value(
                            node.left, parameters, visiting)
                        and r125_pure_definition_value(
                            node.right, parameters, visiting))
            if isinstance(node, ast.BoolOp):
                return all(r125_pure_definition_value(
                           value, parameters, visiting)
                           for value in node.values)
            if isinstance(node, ast.Compare):
                return (r125_pure_definition_value(
                            node.left, parameters, visiting)
                        and all(r125_pure_definition_value(
                                value, parameters, visiting)
                                for value in node.comparators))
            if isinstance(node, ast.IfExp):
                return all(r125_pure_definition_value(
                           value, parameters, visiting)
                           for value in (node.test, node.body, node.orelse))
            if isinstance(node, ast.Call):
                return r125_pure_local_call(node, visiting)
            return False
        def r125_allowed_definition_call(node):
            if (isinstance(node.func, ast.Name)
                    and node.func.id == "RoadmapSlice"
                    and r125_module_binding_counts.get("RoadmapSlice") == 1
                    and isinstance(r125_module_definitions.get("RoadmapSlice"),
                                   ast.ClassDef)
                    and not r125_module_definitions["RoadmapSlice"].bases
                    and not r125_module_definitions["RoadmapSlice"].keywords
                    and len(r125_module_definitions[
                        "RoadmapSlice"].decorator_list) == 1
                    and isinstance(r125_module_definitions[
                        "RoadmapSlice"].decorator_list[0], ast.Call)
                    and isinstance(r125_module_definitions[
                        "RoadmapSlice"].decorator_list[0].func, ast.Name)
                    and from_bindings.get(r125_module_definitions[
                        "RoadmapSlice"].decorator_list[0].func.id)
                        == (0, "dataclasses", "dataclass")
                    and r125_module_binding_counts.get(
                        r125_module_definitions["RoadmapSlice"]
                            .decorator_list[0].func.id) == 1
                    and all(isinstance(statement, (ast.AnnAssign, ast.Expr))
                            and (not isinstance(statement, ast.Expr)
                                 or (isinstance(statement.value, ast.Constant)
                                     and isinstance(statement.value.value, str)))
                            for statement in r125_module_definitions[
                                "RoadmapSlice"].body)
                    and not node.keywords
                    and all(r125_literal_data(value) for value in node.args)):
                return True
            if (isinstance(node.func, ast.Name)
                    and r125_module_binding_counts.get(node.func.id) == 1
                    and from_bindings.get(node.func.id)
                        == (0, "dataclasses", "dataclass")
                    and not node.args and len(node.keywords) == 1
                    and node.keywords[0].arg == "frozen"
                    and isinstance(node.keywords[0].value, ast.Constant)
                    and node.keywords[0].value.value is True):
                return True
            if (isinstance(node.func, ast.Name)
                    and r125_module_binding_counts.get(node.func.id) == 1
                    and from_bindings.get(node.func.id)
                        == (0, "pathlib", "Path")
                    and len(node.args) == 1 and not node.keywords
                    and isinstance(node.args[0], ast.Name)
                    and node.args[0].id == "__file__"):
                return True
            if (isinstance(node.func, ast.Attribute)
                    and node.func.attr == "resolve" and not node.args
                    and not node.keywords and isinstance(node.func.value, ast.Call)
                    and r125_allowed_definition_call(node.func.value)):
                return True
            if (isinstance(node.func, ast.Name) and node.func.id == "str"
                    and r125_module_binding_counts.get("str", 0) == 0
                    and len(node.args) == 1 and not node.keywords
                    and isinstance(node.args[0], ast.Name)
                    and node.args[0].id in {"AUTHORITY_LIB", "REPOSITORY_ROOT"}):
                return True
            if r125_pure_local_call(node):
                return True
            return (isinstance(node.func, ast.Attribute)
                    and node.func.attr == "insert"
                    and isinstance(node.func.value, ast.Attribute)
                    and node.func.value.attr == "path"
                    and isinstance(node.func.value.value, ast.Name)
                    and module_bindings.get(node.func.value.value.id) == "sys"
                    and r125_module_binding_counts.get(
                        node.func.value.value.id) == 1
                    and len(node.args) == 2 and not node.keywords
                    and isinstance(node.args[0], ast.Constant)
                    and node.args[0].value == 0
                    and isinstance(node.args[1], ast.Call)
                    and r125_allowed_definition_call(node.args[1]))
        def r125_definition_time_call(node):
            cursor = parents.get(id(node))
            while cursor is not None:
                if (isinstance(cursor, ast.If)
                        and isinstance(cursor.test, ast.Compare)
                        and isinstance(cursor.test.left, ast.Name)
                        and cursor.test.left.id == "__name__"
                        and len(cursor.test.ops) == len(cursor.test.comparators) == 1
                        and isinstance(cursor.test.ops[0], ast.Eq)
                        and isinstance(cursor.test.comparators[0], ast.Constant)
                        and cursor.test.comparators[0].value == "__main__"
                        and any(is_descendant(node, statement)
                                for statement in cursor.body)):
                    return False
                if isinstance(cursor, function_types):
                    if any(is_descendant(node, root)
                           for root in definition_time_roots(cursor)):
                        cursor = parents.get(id(cursor))
                        continue
                    return False
                cursor = parents.get(id(cursor))
            return True
        def r125_definition_statement_executes(node):
            cursor = parents.get(id(node))
            while cursor is not None:
                if (isinstance(cursor, ast.If)
                        and isinstance(cursor.test, ast.Compare)
                        and isinstance(cursor.test.left, ast.Name)
                        and cursor.test.left.id == "__name__"
                        and len(cursor.test.ops) == len(cursor.test.comparators) == 1
                        and isinstance(cursor.test.ops[0], ast.Eq)
                        and isinstance(cursor.test.comparators[0], ast.Constant)
                        and cursor.test.comparators[0].value == "__main__"
                        and any(is_descendant(node, statement)
                                for statement in cursor.body)):
                    return False
                if isinstance(cursor, function_types):
                    return False
                cursor = parents.get(id(cursor))
            return True
        def r125_inside_allowed_definition_call(node):
            cursor = parents.get(id(node))
            while cursor is not None:
                if (isinstance(cursor, ast.Call)
                        and r125_definition_time_call(cursor)
                        and r125_allowed_definition_call(cursor)):
                    return True
                if isinstance(cursor, function_types):
                    if any(is_descendant(node, root)
                           for root in definition_time_roots(cursor)):
                        cursor = parents.get(id(cursor))
                        continue
                    return False
                cursor = parents.get(id(cursor))
            return False
        def r125_imported_capability_root(node):
            root = node
            while isinstance(root, (ast.Attribute, ast.Subscript)):
                root = root.value
            if not isinstance(root, ast.Name) or is_shadowed(root, root.id):
                return None
            if root.id in module_bindings or root.id in from_bindings:
                return root.id
            return None
        def r125_path_constructor(node):
            return (isinstance(node, ast.Call)
                    and isinstance(node.func, ast.Name)
                    and not is_shadowed(node.func, node.func.id)
                    and from_bindings.get(node.func.id)
                        == (0, "pathlib", "Path")
                    and r125_module_binding_counts.get(node.func.id) == 1)
        def r125_path_annotation(node):
            return any(isinstance(candidate, ast.Name)
                       and from_bindings.get(candidate.id)
                           == (0, "pathlib", "Path")
                       for candidate in ast.walk(node))
        r125_path_names = set()
        for function in function_scopes:
            for argument in (*function.args.posonlyargs, *function.args.args,
                             *function.args.kwonlyargs,
                             *((function.args.vararg,)
                               if function.args.vararg else ()),
                             *((function.args.kwarg,)
                               if function.args.kwarg else ())):
                if (argument.annotation is not None
                        and r125_path_annotation(argument.annotation)):
                    r125_path_names.add((id(function), argument.arg))
        def r125_path_name(node):
            if comprehension_shadows(node, node.id):
                cursor = parents.get(id(node))
                while cursor is not None:
                    if isinstance(cursor, comprehension_types):
                        for generator in cursor.generators:
                            targets = {
                                target.id for target in ast.walk(generator.target)
                                if isinstance(target, ast.Name)
                                and isinstance(target.ctx, ast.Store)}
                            if (node.id in targets
                                    and r125_path_collection(generator.iter)):
                                return True
                    cursor = parents.get(id(cursor))
                return False
            scope = nearest_function(node)
            while scope is not None:
                if (id(scope), node.id) in r125_path_names:
                    return True
                if node.id in scope_locals[id(scope)]:
                    return False
                scope = nearest_function(scope)
            return (None, node.id) in r125_path_names
        def r125_path_expression(node):
            if r125_path_constructor(node):
                return True
            if isinstance(node, ast.Name):
                return r125_path_name(node)
            if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):
                return r125_path_expression(node.left)
            if isinstance(node, ast.Attribute):
                return (node.attr == "parent"
                        and r125_path_expression(node.value))
            if (isinstance(node, ast.Subscript)
                    and isinstance(node.value, ast.Attribute)
                    and node.value.attr == "parents"):
                return r125_path_expression(node.value.value)
            if isinstance(node, ast.IfExp):
                return (r125_path_expression(node.body)
                        and r125_path_expression(node.orelse))
            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
                if (isinstance(node.func.value, ast.Name)
                        and from_bindings.get(node.func.value.id)
                            == (0, "pathlib", "Path")
                        and not is_shadowed(node.func.value,
                                            node.func.value.id)
                        and node.func.attr in {"cwd", "home"}):
                    return True
                return (node.func.attr in {
                            "absolute", "expanduser", "resolve", "with_name",
                            "with_stem", "with_suffix"}
                        and r125_path_expression(node.func.value))
            if (isinstance(node, ast.Subscript)
                    and isinstance(node.value, (ast.Tuple, ast.List))
                    and isinstance(node.slice, ast.Constant)
                    and type(node.slice.value) is int):
                index = node.slice.value
                values = node.value.elts
                return (-len(values) <= index < len(values)
                        and r125_path_expression(values[index]))
            return False
        def r125_path_collection(node):
            return (isinstance(node, ast.Call)
                    and isinstance(node.func, ast.Attribute)
                    and node.func.attr in {"glob", "iterdir", "rglob"}
                    and r125_path_expression(node.func.value))
        changed = True
        while changed:
            changed = False
            for candidate in ast.walk(tree):
                value = None
                targets = ()
                if isinstance(candidate, ast.Assign):
                    value, targets = candidate.value, candidate.targets
                elif isinstance(candidate, ast.AnnAssign):
                    value, targets = candidate.value, (candidate.target,)
                if value is None or not r125_path_expression(value):
                    continue
                for target in targets:
                    for name_node in ast.walk(target):
                        if (isinstance(name_node, ast.Name)
                                and isinstance(name_node.ctx, ast.Store)):
                            scope = nearest_function(name_node)
                            if (scope is not None
                                    and inside_nested_class_body(
                                        name_node, scope)):
                                continue
                            key = (id(scope) if scope is not None else None,
                                   name_node.id)
                            if key not in r125_path_names:
                                r125_path_names.add(key)
                                changed = True
        r125_inert_names = set()
        def r125_inert_name(node):
            scope = nearest_function(node)
            while scope is not None:
                if node.id in scope_globals[id(scope)]:
                    scope = nearest_function(scope)
                    continue
                key = (id(scope), node.id)
                if key in r125_inert_names:
                    return r125_scope_binding_counts.get(key) == 1
                if node.id in scope_locals[id(scope)]:
                    return False
                scope = nearest_function(scope)
            return ((None, node.id) in r125_inert_names
                    and r125_module_binding_counts.get(node.id) == 1)
        def r125_inert_receiver(node):
            if isinstance(node, ast.Constant):
                return True
            if isinstance(node, ast.Name):
                if r125_inert_name(node):
                    return True
                return (r125_module_binding_counts.get(node.id) == 1
                        and r125_inert_local_class(
                            r125_module_definitions.get(node.id), frozenset()))
            if (isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
                    and not node.args and not node.keywords
                    and r125_module_binding_counts.get(node.func.id) == 1):
                return r125_inert_local_class(
                    r125_module_definitions.get(node.func.id), frozenset())
            if isinstance(node, ast.NamedExpr):
                return r125_inert_receiver(node.value)
            return False
        changed = True
        while changed:
            changed = False
            for candidate in ast.walk(tree):
                value = None
                targets = ()
                if isinstance(candidate, ast.Assign):
                    value, targets = candidate.value, candidate.targets
                elif isinstance(candidate, ast.AnnAssign):
                    value, targets = candidate.value, (candidate.target,)
                elif isinstance(candidate, ast.NamedExpr):
                    value, targets = candidate.value, (candidate.target,)
                if value is None or not r125_inert_receiver(value):
                    continue
                for target in targets:
                    for name_node in ast.walk(target):
                        if (isinstance(name_node, ast.Name)
                                and isinstance(name_node.ctx, ast.Store)):
                            scope = nearest_function(name_node)
                            if (scope is not None
                                    and inside_nested_class_body(
                                        name_node, scope)):
                                continue
                            key = (id(scope) if scope is not None else None,
                                   name_node.id)
                            if key not in r125_inert_names:
                                r125_inert_names.add(key)
                                changed = True
        for definition in ast.walk(tree):
            if (not isinstance(definition, (ast.FunctionDef,
                                            ast.AsyncFunctionDef,
                                            ast.ClassDef))
                    or not r125_definition_statement_executes(definition)):
                continue
            for decorator in definition.decorator_list:
                if isinstance(decorator, ast.Call):
                    continue
                if (isinstance(decorator, ast.Name)
                        and r125_module_binding_counts.get(decorator.id) == 1
                        and from_bindings.get(decorator.id)
                            == (0, "dataclasses", "dataclass")):
                    continue
                if (not isinstance(decorator, ast.Name)
                        or r125_module_binding_counts.get(decorator.id) != 1
                        or not r125_pure_local_function(
                            r125_module_definitions.get(decorator.id),
                            frozenset())):
                    return False
            if isinstance(definition, ast.ClassDef):
                for base in definition.bases:
                    if isinstance(base, ast.Call):
                        continue
                    if (isinstance(base, ast.Name)
                            and base.id in {"object", "Exception",
                                            "RuntimeError", "ValueError"}
                            and r125_module_binding_counts.get(base.id, 0) == 0):
                        continue
                    if (not isinstance(base, ast.Name)
                            or r125_module_binding_counts.get(base.id) != 1
                            or not r125_inert_local_class(
                                r125_module_definitions.get(base.id),
                                frozenset())):
                        return False
                if definition.keywords:
                    return False
        for node in ast.walk(tree):
            # The exact controller import set requires postponed annotations;
            # these ASTs are stored as strings and grant no runtime capability.
            if in_inert_annotation(node):
                continue
            if (isinstance(node, ast.Call) and r125_definition_time_call(node)
                    and not r125_allowed_definition_call(node)):
                return False
            if (isinstance(node, ast.Subscript)
                    and isinstance(node.ctx, (ast.Store, ast.Del))
                    and r125_definition_time_call(node)):
                return False
            if (isinstance(node, ast.Attribute)
                    and isinstance(node.ctx, (ast.Store, ast.Del))
                    and r125_definition_time_call(node)):
                parent = parents.get(id(node))
                exact_bytecode_guard = (
                    isinstance(node.ctx, ast.Store)
                    and isinstance(node.value, ast.Name)
                    and module_bindings.get(node.value.id) == "sys"
                    and r125_module_binding_counts.get(node.value.id) == 1
                    and node.attr == "dont_write_bytecode"
                    and isinstance(parent, ast.Assign)
                    and len(parent.targets) == 1 and parent.targets[0] is node
                    and isinstance(parent.value, ast.Constant)
                    and parent.value.value is True)
                if not exact_bytecode_guard:
                    return False
            if isinstance(node, ast.Import):
                if (not isinstance(parents.get(id(node)), ast.Module)
                        or any(alias.name.split(".", 1)[0]
                       in _R123_CONTROLLER_FORBIDDEN_IMPORT_ROOTS
                       for alias in node.names)):
                    return False
            elif isinstance(node, ast.ImportFrom):
                if (not isinstance(parents.get(id(node)), ast.Module)
                        or (node.module or "").split(".", 1)[0]
                        in _R123_CONTROLLER_FORBIDDEN_IMPORT_ROOTS):
                    return False
            if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load):
                if r125_class_scope_state(node, node.id) == "ambiguous":
                    return False
                shadowed = is_shadowed(node, node.id)
                exact_bare_dataclass = (
                    from_bindings.get(node.id)
                        == (0, "dataclasses", "dataclass")
                    and r125_module_binding_counts.get(node.id) == 1
                    and isinstance(parents.get(id(node)), ast.ClassDef)
                    and node in parents[id(node)].decorator_list)
                if (r125_definition_time_call(node) and not shadowed
                        and ((node.id in from_bindings
                              and not exact_bare_dataclass)
                             or node.id in {"open", "input"})
                        and not r125_inside_allowed_definition_call(node)):
                    return False
                if node.id in {"open", "input"} and not shadowed:
                    parent = parents.get(id(node))
                    if not (isinstance(parent, ast.Call)
                            and parent.func is node):
                        return False
                if node.id in _R123_CONTROLLER_AMBIENT_NAMES and not shadowed:
                    return False
                if node.id == "globals" and not shadowed:
                    call = parents.get(id(node))
                    attr = parents.get(id(call)) if isinstance(call, ast.Call) else None
                    outer = parents.get(id(attr)) if isinstance(attr, ast.Attribute) else None
                    if not (isinstance(call, ast.Call) and call.func is node
                            and not call.args and not call.keywords
                            and isinstance(attr, ast.Attribute) and attr.value is call
                            and attr.attr == "get"
                            and isinstance(outer, ast.Call) and outer.func is attr
                            and len(outer.args) == 2 and not outer.keywords
                            and isinstance(outer.args[0], ast.Constant)
                            and outer.args[0].value == "__file__"
                            and isinstance(outer.args[1], ast.Constant)
                            and outer.args[1].value == ""):
                        return False
                if node.id == "getattr" and not shadowed:
                    call = parents.get(id(node))
                    if not (isinstance(call, ast.Call) and call.func is node
                            and len(call.args) == 3 and not call.keywords
                            and isinstance(call.args[0], ast.Name)
                            and module_bindings.get(call.args[0].id) == "os"
                            and not is_shadowed(call.args[0], call.args[0].id)
                            and isinstance(call.args[1], ast.Constant)
                            and call.args[1].value
                                in _R123_CONTROLLER_GETATTR_FLAGS
                            and isinstance(call.args[2], ast.Constant)
                            and type(call.args[2].value) is int
                            and call.args[2].value == 0):
                        return False
                if node.id in module_bindings and not shadowed:
                    parent = parents.get(id(node))
                    safe_getattr_os_arg = (
                        module_bindings[node.id] == "os"
                        and isinstance(parent, ast.Call)
                        and isinstance(parent.func, ast.Name)
                        and parent.func.id == "getattr"
                        and len(parent.args) == 3 and parent.args[0] is node
                        and not parent.keywords
                        and isinstance(parent.args[1], ast.Constant)
                        and parent.args[1].value
                            in _R123_CONTROLLER_GETATTR_FLAGS
                        and isinstance(parent.args[2], ast.Constant)
                        and type(parent.args[2].value) is int
                        and parent.args[2].value == 0)
                    if not ((isinstance(parent, ast.Attribute)
                             and parent.value is node)
                            or safe_getattr_os_arg):
                        return False
                if node.id in from_bindings and not shadowed:
                    parent = parents.get(id(node))
                    exception_type = False
                    cursor = parent
                    while cursor is not None:
                        if (isinstance(cursor, ast.ExceptHandler)
                                and cursor.type is not None
                                and is_descendant(node, cursor.type)):
                            exception_type = True
                            break
                        if isinstance(cursor, (ast.stmt, function_types)):
                            break
                        cursor = parents.get(id(cursor))
                    direct_call = (isinstance(parent, ast.Call)
                                   and parent.func is node)
                    attribute_root = (isinstance(parent, ast.Attribute)
                                      and parent.value is node)
                    exact_dataclass = (
                        from_bindings.get(node.id)
                            == (0, "dataclasses", "dataclass")
                        and r125_module_binding_counts.get(node.id) == 1
                        and isinstance(parent, ast.ClassDef)
                        and node in parent.decorator_list)
                    if not (direct_call or attribute_root or exception_type
                            or exact_dataclass):
                        return False
            if not isinstance(node, ast.Attribute):
                if (isinstance(node, ast.Subscript)
                        and isinstance(node.ctx, ast.Load)
                        and r125_definition_time_call(node)
                        and r125_imported_capability_root(node) is not None
                        and not r125_inside_allowed_definition_call(node)):
                    return False
                continue
            if (node.attr in _R123_CONTROLLER_BOUND_CAPABILITY_ATTRIBUTES
                    and not r125_inert_receiver(node.value)):
                parent = parents.get(id(node))
                if not (isinstance(parent, ast.Call) and parent.func is node):
                    return False
            if (node.attr == "open" and r125_path_constructor(node.value)):
                parent = parents.get(id(node))
                if not (isinstance(parent, ast.Call) and parent.func is node):
                    return False
            if (isinstance(node.ctx, ast.Load)
                    and r125_definition_time_call(node)
                    and r125_imported_capability_root(node) is not None
                    and not r125_inside_allowed_definition_call(node)):
                return False
            root = node
            parts = []
            while isinstance(root, ast.Attribute):
                parts.append(root.attr)
                root = root.value
            imported_root = (isinstance(root, ast.Name)
                             and root.id in module_bindings
                             and not is_shadowed(root, root.id))
            from_imported_root = (
                isinstance(root, ast.Name) and root.id in from_bindings
                and not is_shadowed(root, root.id))
            if (imported_root
                    and parts[-1] not in _R123_CONTROLLER_MODULE_FIRST_HOPS[
                        module_bindings[root.id]]):
                return False
            parent = parents.get(id(node))
            if imported_root or from_imported_root:
                direct_call = (isinstance(parent, ast.Call)
                               and parent.func is node)
                intermediate = (isinstance(parent, ast.Attribute)
                                and parent.value is node)
                value_path = ((module_bindings[root.id], *reversed(parts))
                              if imported_root else None)
                exact_stderr_sink = (
                    value_path == ("sys", "stderr")
                    and isinstance(parent, ast.keyword)
                    and parent.arg == "file"
                    and isinstance(parents.get(id(parent)), ast.Call)
                    and isinstance(parents[id(parent)].func, ast.Name)
                    and parents[id(parent)].func.id == "print"
                    and not is_shadowed(parents[id(parent)].func, "print")
                    and r125_module_binding_counts.get("print", 0) == 0)
                if (not direct_call and not intermediate
                        and value_path not in
                            _R123_CONTROLLER_IMPORTED_VALUE_PATHS
                        and not exact_stderr_sink):
                    return False
            if node.attr in _R123_CONTROLLER_FRAME_ATTRIBUTES:
                return False
            if (imported_root
                    and (node.attr.startswith("_")
                         or node.attr in _R123_CONTROLLER_PROXY_ATTRIBUTES)):
                return False
            # Path's private backend objects transfer raw filesystem/module
            # authority even though Path itself is an admitted value import.
            # Deny those capability-bearing objects independent of local-name
            # spelling while retaining harmless private attributes on ordinary
            # locally bound values.
            if node.attr in {"_accessor", "_flavour"}:
                return False
            # Double-private object attributes are capability-transfer surfaces
            # whose native effects need not emit a selected Python audit event.
            # The sole product-positive form is ordinary exception construction
            # through super().__init__.
            if node.attr.startswith("__"):
                parent = parents.get(id(node))
                value = node.value
                safe_super_init = (
                    node.attr == "__init__" and isinstance(parent, ast.Call)
                    and parent.func is node and isinstance(value, ast.Call)
                    and isinstance(value.func, ast.Name) and value.func.id == "super"
                    and not value.args and not value.keywords)
                if not safe_super_init:
                    return False
        return True

