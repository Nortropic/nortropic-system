GIT_CONTROL_PREFIX = "GIT_"

def without_caller_git_controls(environment: dict[str, str]) -> dict[str, str]:
    """Return a fresh environment with no caller-selected Git controls."""
    return {key: value for key, value in environment.items()
            if not key.startswith(GIT_CONTROL_PREFIX)}

def owner_call_environment(environment: dict[str,str]) -> dict[str,str]:
    return {key:value for key,value in environment.items()
            if not key.startswith(("GIT_","DYLD_","H032_","GH_","GITHUB_","SLACK_"))
            and key not in {"LD_PRELOAD","LD_LIBRARY_PATH","__PYVENV_LAUNCHER__"}}

# The owner gate itself is a composed execution boundary: imported product,
# disposable helpers and the nested H-033 gate must not inherit a caller's
# repository selector.  Preserve only judge evidence about the original names,
# then close the real process environment before any product import or Git use.
CALLER_GIT_CONTROL_NAMES = tuple(sorted(
    key for key in os.environ if key.startswith(GIT_CONTROL_PREFIX)))
_gate_environment = without_caller_git_controls(dict(os.environ))
os.environ.clear()
os.environ.update(_gate_environment)
del _gate_environment

def check(key: str, ok: bool, detail: str) -> None:
    checks.append((key, ok, detail))

def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

class DuplicateKey(ValueError):
    pass

def strict_json(raw: str):
    def pairs(items):
        out = {}
        for key, value in items:
            if key in out:
                raise DuplicateKey(key)
            out[key] = value
        return out
    return json.loads(raw, object_pairs_hook=pairs)

OWNER_CALL_RESULT_KEYS = {
    "schema_version", "nonce", "purpose", "mode", "plan_sha256",
    "plan_dev", "plan_ino", "helper_sha256", "argv", "cwd",
    "returncode", "timed_out", "stdout_b64", "stderr_b64",
    "stdout_sha256", "stderr_sha256", "environment_sha256", "tracked_processes",
    "executable_dev", "executable_ino", "tracker_backend", "family_quiescent",
}

def owner_executable_binding(path: Path):
    observed=path.stat()
    return {"executable_dev":observed.st_dev,"executable_ino":observed.st_ino}

def atomic_owner_json(path: Path, value) -> bytes:
    raw=json.dumps(value,sort_keys=True,separators=(",", ":")).encode("utf-8")
    temporary=path.with_name(path.name+".tmp-"+os.urandom(16).hex())
    fd=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL
               |getattr(os,"O_NOFOLLOW",0),0o600)
    try:
        offset=0
        while offset<len(raw): offset+=os.write(fd,raw[offset:])
        os.fsync(fd)
    finally: os.close(fd)
    try: os.link(temporary,path,follow_symlinks=False)
    finally: os.unlink(temporary)
    parent_fd=os.open(path.parent,os.O_RDONLY|getattr(os,"O_DIRECTORY",0))
    try: os.fsync(parent_fd)
    finally: os.close(parent_fd)
    return raw

def stable_owner_json(path: Path, maximum: int=20*1024*1024):
    fd=os.open(path,os.O_RDONLY|getattr(os,"O_NOFOLLOW",0))
    try:
        before=os.fstat(fd);raw=b""
        if not stat.S_ISREG(before.st_mode) or before.st_nlink!=1:
            raise RuntimeError("owner-call object is not private regular nlink-one")
        while len(raw)<=maximum:
            chunk=os.read(fd,min(65536,maximum+1-len(raw)))
            if not chunk: break
            raw+=chunk
        after=os.fstat(fd)
        identity=lambda item:(item.st_dev,item.st_ino,item.st_mode,item.st_nlink,
                              item.st_size,item.st_mtime_ns,item.st_ctime_ns)
        if len(raw)>maximum or len(raw)!=before.st_size or identity(before)!=identity(after):
            raise RuntimeError("owner-call object unstable or oversized")
        return raw,before,strict_json(raw.decode("utf-8",errors="strict"))
    finally: os.close(fd)

def owner_call_result_valid(value, plan, plan_raw: bytes, plan_stat) -> bool:
    if not isinstance(value,dict) or set(value)!=OWNER_CALL_RESULT_KEYS:
        return False
    try:
        stdout=base64.b64decode(value.get("stdout_b64",""),validate=True)
        stderr=base64.b64decode(value.get("stderr_b64",""),validate=True)
    except Exception:
        return False
    return (value.get("schema_version")==1
        and value.get("nonce")==plan.get("nonce")
        and value.get("purpose")==plan.get("purpose")
        and value.get("mode")==plan.get("mode")
        and value.get("plan_sha256")==hashlib.sha256(plan_raw).hexdigest()
        and value.get("plan_dev")==plan_stat.st_dev
        and value.get("plan_ino")==plan_stat.st_ino
        and value.get("helper_sha256")==owner_live_helper_sha256
        and value.get("executable_dev")==plan.get("executable_dev")
        and value.get("executable_ino")==plan.get("executable_ino")
        and value.get("argv")==plan.get("argv")
        and value.get("cwd")==plan.get("cwd")
        and type(value.get("returncode")) is int
        and type(value.get("timed_out")) is bool
        and value.get("stdout_sha256")==hashlib.sha256(stdout).hexdigest()
        and value.get("stderr_sha256")==hashlib.sha256(stderr).hexdigest()
        and value.get("environment_sha256")==hashlib.sha256(json.dumps(
            plan.get("environment"),sort_keys=True,separators=(",", ":")).encode()).hexdigest()
        and value.get("tracked_processes") is None
        and value.get("tracker_backend")=="product-owned"
        and value.get("family_quiescent") is None
        and value.get("timed_out") is False)

def canonical_result_valid(value, schema, accepted_digest=None, role="TEST_AUTHOR"):
    if not isinstance(value, dict) or set(value) != {
            "schema_version", "invocation_id", "run_id", "role",
            "result_sha256", "report"}:
        return False
    invocation_id=value.get("invocation_id");run_id=value.get("run_id")
    digest=value.get("result_sha256");report=value.get("report")
    lower_hex=set("0123456789abcdef")
    return (value.get("schema_version")==1 and value.get("role")==role
        and isinstance(invocation_id,str) and len(invocation_id)==32
        and set(invocation_id)<=lower_hex
        and isinstance(run_id,str) and len(run_id)==32 and set(run_id)<=lower_hex
        and invocation_id!=run_id and isinstance(digest,str) and len(digest)==64
        and set(digest)<=lower_hex
        and (accepted_digest is None or digest==accepted_digest)
        and complete_schema_valid(report,schema) and report.get("role")==role)

def complete_schema_valid(value, schema_node) -> bool:
    """Independent complete validator for every keyword used by the frozen report schema."""
    if not isinstance(schema_node, dict):
        return False
    allowed_keywords = {"$schema", "type", "properties", "required",
                        "additionalProperties", "items", "enum"}
    if not set(schema_node).issubset(allowed_keywords):
        return False
    types = schema_node.get("type")
    if types is not None:
        names = [types] if isinstance(types, str) else types
        if not isinstance(names, list) or not names or not all(isinstance(x, str) for x in names):
            return False
        matches = {
            "object": isinstance(value, dict),
            "array": isinstance(value, list),
            "string": isinstance(value, str),
            "integer": type(value) is int,
            "boolean": type(value) is bool,
            "null": value is None,
        }
        if any(name not in matches for name in names) or not any(matches[name] for name in names):
            return False
    if "enum" in schema_node and value not in schema_node["enum"]:
        return False
    if isinstance(value, dict):
        props = schema_node.get("properties", {})
        required = schema_node.get("required", [])
        if not isinstance(props, dict) or not isinstance(required, list):
            return False
        if not all(isinstance(key, str) for key in required) or not set(required).issubset(value):
            return False
        if schema_node.get("additionalProperties") is False and not set(value).issubset(props):
            return False
        for key, child in value.items():
            if key in props and not complete_schema_valid(child, props[key]):
                return False
    if isinstance(value, list) and "items" in schema_node:
        return all(complete_schema_valid(item, schema_node["items"]) for item in value)
    return True

MAX_RESULT_BYTES = 4 * 1024 * 1024
MAX_CANONICAL_BYTES = MAX_RESULT_BYTES + 1024 * 1024
def bounded_stable_result(path: Path, limit: int = MAX_RESULT_BYTES) -> bytes:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    try:
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode): raise ValueError("result is nonregular")
        chunks: list[bytes] = []; total = 0
        while total <= limit:
            chunk = os.read(fd, min(65536, limit + 1 - total))
            if not chunk: break
            chunks.append(chunk); total += len(chunk)
        after = os.fstat(fd)
        if total > limit: raise ValueError("result exceeds exact bound")
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
                after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
            raise ValueError("result changed during read")
        if total != before.st_size: raise ValueError("short result read")
        return b"".join(chunks)
    finally:
        os.close(fd)

def authority_shape(raw: str) -> tuple[bool, str]:
    try:
        value = strict_json(raw)
    except Exception as exc:
        return False, f"{type(exc).__name__}:{exc}"
    keys = {"schema_version", "provider", "executable_path", "executable_sha256",
            "code_mode_host_path", "code_mode_host_sha256"}
    if not isinstance(value, dict) or set(value) != keys:
        return False, "top-level/keys"
    path = value["executable_path"]
    digest = value["executable_sha256"]
    host_path = value["code_mode_host_path"]
    host_digest = value["code_mode_host_sha256"]
    ok = (
        type(value["schema_version"]) is int and value["schema_version"] == 2
        and type(value["provider"]) is str and value["provider"] == "openai-codex"
        and type(path) is str and bool(path) and Path(path).is_absolute()
        and type(digest) is str and len(digest) == 64
        and digest == digest.lower() and all(c in "0123456789abcdef" for c in digest)
        and type(host_path) is str and bool(host_path) and Path(host_path).is_absolute()
        and type(host_digest) is str and len(host_digest) == 64
        and host_digest == host_digest.lower()
        and all(c in "0123456789abcdef" for c in host_digest)
    )
    return ok, "exact" if ok else "value/type"

def sh(*argv: str, cwd: Path | None = None) -> str:
    if not argv or argv[0] != GIT:
        raise RuntimeError("judge helper permits only exact system Git")
    p = subprocess.run(argv, cwd=cwd, env=dict(GIT_CLOSED_ENV), text=True,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if p.returncode:
        raise RuntimeError(
            f"rc={p.returncode}: {' '.join(argv)}\nstdout={p.stdout}\nstderr={p.stderr}")
    return p.stdout

def strict_git_commit_output(stdout: str, stderr: str) -> str:
    line = stdout[:-1] if stdout.endswith("\n") else ""
    if (stderr or stdout != line + "\n" or len(line) != 40
            or any(char not in "0123456789abcdef" for char in line)):
        raise RuntimeError("Git commit output is not one exact lowercase SHA-1 line")
    return line

def strict_git_root_output(stdout: str, stderr: str) -> Path:
    line = stdout[:-1] if stdout.endswith("\n") else ""
    if stderr or stdout != line + "\n" or not line or not Path(line).is_absolute():
        raise RuntimeError("Git worktree output is not one exact absolute line")
    return Path(line)

def git_repository_head(cwd: Path) -> str:
    root = subprocess.run(
        [GIT, "rev-parse", "--show-toplevel"], cwd=cwd,
        env=dict(GIT_CLOSED_ENV), text=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if root.returncode:
        raise RuntimeError(f"Git worktree identity failed: {root.stderr}")
    observed_root = strict_git_root_output(root.stdout, root.stderr)
    if observed_root.resolve() != cwd.resolve():
        raise RuntimeError("Git worktree identity does not match requested repository")
    head = subprocess.run(
        [GIT, "rev-parse", "--verify", "HEAD"], cwd=cwd,
        env=dict(GIT_CLOSED_ENV), text=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if head.returncode:
        raise RuntimeError(f"Git HEAD identity failed: {head.stderr}")
    return strict_git_commit_output(head.stdout, head.stderr)

def git_repository_common_dir(cwd: Path) -> Path:
    common = subprocess.run(
        [GIT, "rev-parse", "--path-format=absolute", "--git-common-dir"],
        cwd=cwd, env=dict(GIT_CLOSED_ENV), text=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if common.returncode:
        raise RuntimeError(f"Git common-dir identity failed: {common.stderr}")
    return strict_git_root_output(common.stdout, common.stderr).resolve()

OWNER_LIVE_BINDING_KEYS = {
    "candidate_repo", "candidate_head", "candidate_tree", "candidate_source", "source_sha256",
    "candidate_spec", "spec_sha256", "candidate_gate", "gate_sha256",
    "owner_live_helper", "owner_live_helper_sha256",
    "provider_path", "provider_sha256", "host_path", "host_sha256",
}

def owner_live_binding_valid(binding) -> bool:
    """Validate every input consumed by the late owner-live identity check."""
    try:
        if not isinstance(binding, dict) or set(binding) != OWNER_LIVE_BINDING_KEYS:
            return False
        candidate_repo = binding["candidate_repo"]
        candidate_source = binding["candidate_source"]
        candidate_spec = binding["candidate_spec"]
        candidate_gate = binding["candidate_gate"]
        bound_helper = binding["owner_live_helper"]
        provider_path = binding["provider_path"]
        host_path = binding["host_path"]
        if not all(isinstance(path, Path) for path in (
                candidate_repo, candidate_source, candidate_spec, candidate_gate,
                bound_helper, provider_path, host_path)):
            return False
        if (candidate_source != candidate_repo/"scripts/nortropic-codex-autopilot.py"
                or candidate_spec != candidate_repo/"specs/tasks.spec.json"
                or candidate_gate != candidate_repo/"verify/bin/h-032-exit"
                or bound_helper != candidate_repo/"verify/bin/h-032-owner-live-call"):
            return False
        if (not all(path.is_file() and not path.is_symlink()
                    for path in (candidate_source, candidate_spec, candidate_gate,
                                 bound_helper, provider_path, host_path))
                or not os.access(provider_path, os.X_OK)
                or not os.access(host_path, os.X_OK)):
            return False
        head = binding["candidate_head"]
        tree = binding["candidate_tree"]
        digests = [binding[key] for key in (
            "source_sha256", "spec_sha256", "gate_sha256",
            "owner_live_helper_sha256",
            "provider_sha256", "host_sha256")]
        if (not isinstance(head, str) or len(head) != 40
                or any(char not in "0123456789abcdef" for char in head)
                or not isinstance(tree, str) or len(tree) != 40
                or any(char not in "0123456789abcdef" for char in tree)
                or not all(isinstance(value, str) and len(value) == 64
                           and not any(char not in "0123456789abcdef" for char in value)
                           for value in digests)):
            return False
        return (git_repository_head(candidate_repo) == head
            and strict_git_commit_output(
                sh(GIT,"rev-parse","HEAD^{tree}",cwd=candidate_repo),"") == tree
            and sha256(candidate_source) == binding["source_sha256"]
            and sha256(candidate_spec) == binding["spec_sha256"]
            and sha256(candidate_gate) == binding["gate_sha256"]
            and sha256(bound_helper) == binding["owner_live_helper_sha256"]
            and sha256(provider_path) == binding["provider_sha256"]
            and sha256(host_path) == binding["host_sha256"])
    except (KeyError, OSError, RuntimeError, TypeError, ValueError):
        return False

def exact_tree_snapshot(root: Path) -> tuple[tuple[object, ...], ...]:
    """Snapshot an exact tree without following links or interpreting contents."""
    if not root.exists() and not root.is_symlink():
        return ((".", "absent"),)
    records: list[tuple[object, ...]] = []
    def visit(path: Path, relative: str) -> None:
        observed = path.lstat()
        mode = stat.S_IMODE(observed.st_mode)
        if stat.S_ISLNK(observed.st_mode):
            records.append((relative, "symlink", mode, os.readlink(path)))
            return
        if stat.S_ISREG(observed.st_mode):
            records.append((relative, "file", mode, observed.st_size, sha256(path)))
            return
        if stat.S_ISDIR(observed.st_mode):
            records.append((relative, "dir", mode))
            with os.scandir(path) as entries:
                children = sorted(entries, key=lambda entry: entry.name)
            for entry in children:
                child_relative = entry.name if relative == "." else relative + "/" + entry.name
                visit(Path(entry.path), child_relative)
            return
        records.append((relative, "other", mode, stat.S_IFMT(observed.st_mode)))
    visit(root, ".")
    return tuple(records)

repo_head = git_repository_head(repo)
authoritative_control_root = (
    git_repository_common_dir(repo) / "nortropic-codex-autopilot")
authoritative_control_before = exact_tree_snapshot(authoritative_control_root)

