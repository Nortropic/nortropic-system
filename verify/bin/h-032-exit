        '                 "TMPDIR": protected_root, "LANG": "C", "LC_ALL": "C",\n'
        '                 "GIT_DIR": authoritative_git_dir, "GIT_CONFIG_NOSYSTEM": "1",\n'
        '                 "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_TERMINAL_PROMPT": "0",\n'
        '                 "GIT_NO_REPLACE_OBJECTS": "1",\n'
        '                 "GIT_ALTERNATE_OBJECT_DIRECTORIES": ""},\n'
        '            input=revlist.stdout, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n')
    if (REFERENCE_MATERIALIZE_SOURCE.count(_r123_revlist_old) != 1
            or REFERENCE_MATERIALIZE_SOURCE.count(_r123_pack_old) != 1):
        raise RuntimeError("R123 reference authoritative Git seam drift")
    REFERENCE_MATERIALIZE_SOURCE = REFERENCE_MATERIALIZE_SOURCE.replace(
        _r123_revlist_old, _r123_revlist_new, 1).replace(
            _r123_pack_old, _r123_pack_new, 1)
    if REFERENCE_MATERIALIZE_SOURCE.count('["git",') != 2:
        raise RuntimeError("R123 reference Git executable seam drift")
    REFERENCE_MATERIALIZE_SOURCE = REFERENCE_MATERIALIZE_SOURCE.replace(
        '["git",', '["/usr/bin/git",')
    _mat_ns = {}
    exec(compile(REFERENCE_MATERIALIZE_SOURCE, "<r122-reference-materialize>", "exec"), _mat_ns)
    ref_materialize = _mat_ns["materialize"]
    MatReject = _mat_ns["Reject"]

    r122 = work / "r122"; r122.mkdir()
    r122_prot = r122 / "protected"; r122_prot.mkdir()   # stands for the trust-root region
    R122_ALLOWED = ["controller/result/**", "docs/loop/drift.md"]
    R122_MAXF, R122_MAXL, R122_OPS = 12, 2200, 12

    # Synthetic authoritative base repo (has an existing controller/result/consumer.py
    # so changed-vs-unchanged collisions are exercisable).
    r122_base = r122 / "base"; r122_base.mkdir()
    def _rg(*args, cwd=r122_base, input_bytes=None, env=None):
        return subprocess.run(["git", *args], cwd=str(cwd), input=input_bytes,
                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    _rg("init", "-q")
    _rg("config", "user.name", "h032-r122"); _rg("config", "user.email", "r122@nortropic.invalid")
    # Preserve the exact UTF-8 path bytes in this synthetic repository.  The
    # Unicode-collision controls must exercise NFC/NFD aliasing themselves;
    # macOS Git's optional precomposition must not silently collapse the two
    # native fixtures before the materializer sees them.
    _rg("config", "core.precomposeUnicode", "false")
    (r122_base / "controller/result").mkdir(parents=True)
    (r122_base / "controller/result/consumer.py").write_text("# base consumer\n", encoding="utf-8")
    (r122_base / "controller/result/empty-base.py").write_bytes(b"")
    (r122_base / "controller/result/empty-exec-base.py").write_bytes(b"")
    (r122_base / "controller/result/empty-exec-base.py").chmod(0o755)
    (r122_base / "controller/result/base-dir").mkdir()
    (r122_base / "controller/result/base-dir/child.py").write_text(
        "BASE_DIR_CHILD = True\n", encoding="utf-8")
    (r122_base / "controller/result/@@ mode path.py").write_text(
        "MODE_PATH = True\n", encoding="utf-8")
    os.symlink("consumer.py", r122_base / "controller/result/base-link")
    (r122_base / "specs").mkdir()
    (r122_base / "specs/tasks.spec.json").write_text(json.dumps({
        "defaults": {"max_changed_files": 12, "max_added_lines": 2200},
        "tasks": [{"id": "h-032", "allowed_write": R122_ALLOWED,
                   "max_changed_files": R122_MAXF, "max_added_lines": R122_MAXL,
                   "exit_test": "verify/bin/h-032-exit", "depends_on": []}],
    }, sort_keys=True), encoding="utf-8")
    (r122_base / "anchor").write_text("r122\n", encoding="utf-8")
    _rg("add", "."); _rg("commit", "-qm", "r122-base")
    # A second base commit carries a real gitlink whose object is the first base
    # commit.  Both non-regular modes are legitimate unchanged base entries but
    # R122 forbids a provider delta from adding, modifying OR deleting either.
    _r122_first_base = _rg("rev-parse", "HEAD").stdout.decode().strip()
    _rg("update-index", "--add", "--cacheinfo",
        f"160000,{_r122_first_base},controller/result/base-submodule")
    _rg("commit", "-qm", "r122-base-nonregular-modes")
    r122_base_git = str(r122_base / ".git")
    r122_base_sha = _rg("rev-parse", "HEAD").stdout.decode().strip()

    def r122_blob(content):
        return _rg("hash-object", "--stdin", input_bytes=content).stdout.decode().strip()
    def r122_newfiles(entries):
        if (not isinstance(entries, list) or not entries
                or any(not isinstance(item, tuple) or len(item) != 2
                       or not isinstance(item[0], str)
                       or not isinstance(item[1], bytes)
                       for item in entries)):
            raise RuntimeError("invalid R122 native fixture entries")
        fixture_index = r122_prot / ("native-fixture-" + secrets.token_hex(8))
        fixture_env = {
            "PATH": "/usr/bin:/bin", "HOME": str(r122), "TMPDIR": str(r122_prot),
            "LANG": "C", "LC_ALL": "C", "GIT_DIR": r122_base_git,
            "GIT_INDEX_FILE": str(fixture_index), "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_TERMINAL_PROMPT": "0",
            "GIT_NO_REPLACE_OBJECTS": "1", "GIT_ALTERNATE_OBJECT_DIRECTORIES": "",
            # Command-scoped configuration is deliberate: on macOS the
            # synthetic repo's local setting is not sufficient when Git is
            # invoked with this closed GIT_DIR/GIT_INDEX_FILE environment.
            "GIT_CONFIG_COUNT": "1",
            "GIT_CONFIG_KEY_0": "core.precomposeUnicode",
            "GIT_CONFIG_VALUE_0": "false"}
        try:
            native_ok = _rg("read-tree", r122_base_sha, env=fixture_env).returncode == 0
            for path, content in entries:
                blob = _rg("hash-object", "-w", "--stdin", input_bytes=content,
                           env=fixture_env).stdout.decode().strip()
                native_ok = (native_ok and bool(re.fullmatch(r"[0-9a-f]{40}", blob))
                             and _rg("update-index", "--add", "--cacheinfo",
                                     f"100644,{blob},{path}",
                                     env=fixture_env).returncode == 0)
            indexed_paths = _rg("ls-files", "-z", env=fixture_env).stdout.split(b"\0")
            exact_paths = [path.encode("utf-8") for path, _content in entries]
            native_ok = (native_ok and len(set(exact_paths)) == len(exact_paths)
                         and all(indexed_paths.count(path) == 1
                                 for path in exact_paths))
            if native_ok:
                patch = _rg(
                    "diff", "--cached", "--binary", "--full-index", "--no-renames",
                    r122_base_sha, "--", env=fixture_env).stdout
                if patch:
                    return patch
            # Git cannot represent some deliberately forbidden names (notably a
            # .git component).  Keep a syntactically bounded fallback solely for
            # those reject controls; it can never earn canonical-positive credit.
            if len(entries) != 1:
                raise RuntimeError("multi-entry R122 fixture was not Git-representable")
            path, content = entries[0]
            h = r122_blob(content)
            lines = content.split(b"\n")[:-1]
            body = b"".join(b"+" + ln + b"\n" for ln in lines)
            p = path.encode("utf-8")
            count = str(len(lines)).encode()
            range_text = b"+1" if len(lines) == 1 else b"+1," + count
            return (b"diff --git a/" + p + b" b/" + p
                    + b"\nnew file mode 100644\nindex " + b"0" * 40 + b".."
                    + h.encode() + b"\n--- /dev/null\n+++ b/" + p
                    + b"\n@@ -0,0 " + range_text + b" @@\n" + body)
        finally:
            try:
                fixture_index.unlink()
            except FileNotFoundError:
                pass
    def r122_newfile(path, content):
        return r122_newfiles([(path, content)])
    def r122_delta(patch, base=None, version=1, fmt="git-diff-binary-v1"):
        return {"version": version, "format": fmt,
                "base_commit": r122_base_sha if base is None else base,
                "patch_b64": base64.b64encode(patch).decode()}

    # The first reference implementation deliberately materializes in an
    # attempt-private ODB.  R122 additionally requires a durable candidate Git
    # identity after the call returns: an ephemeral SHA whose ODB was deleted is
    # not a candidate.  This controller-side reference promotion independently
    # reapplies the accepted patch through a private index into the authoritative
    # (provider-denied) object store, updates no ref, and proves the resulting tree
    # is byte-identical to the private derivation.  A product may use any
    # equivalent effect, but its returned commit must likewise resolve afterward.
    def r122_closed_git(git_dir, *args, index_file=None, input_bytes=None,
                        commit_identity=False, check=True):
        env = {
            "PATH": "/usr/bin:/bin", "HOME": str(r122), "TMPDIR": str(r122),
            "LANG": "C", "LC_ALL": "C", "GIT_DIR": str(git_dir),
            "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_TERMINAL_PROMPT": "0", "GIT_NO_REPLACE_OBJECTS": "1",
            "GIT_ALTERNATE_OBJECT_DIRECTORIES": "",
        }
        if index_file is not None:
            env["GIT_INDEX_FILE"] = str(index_file)
        if commit_identity:
            env.update({
                "GIT_AUTHOR_NAME": "nortropic-controller",
                "GIT_AUTHOR_EMAIL": "controller@nortropic.invalid",
                "GIT_COMMITTER_NAME": "nortropic-controller",
                "GIT_COMMITTER_EMAIL": "controller@nortropic.invalid",
                "GIT_AUTHOR_DATE": "2026-01-01T00:00:00 +0000",
                "GIT_COMMITTER_DATE": "2026-01-01T00:00:00 +0000",
            })
        proc = subprocess.run(["/usr/bin/git", *args], env=env,
                              input=input_bytes, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE)
        if check and proc.returncode != 0:
            raise MatReject(f"durable git {args[0]} failed rc={proc.returncode}")
        return proc

    def r123_entry_index_pairs(patch):
        """Return one exact full pre/post identity per canonical diff entry.

        R123 freezes the provider artifact as the no-rename form of
        git-diff-binary-v1.  Rename/copy effects remain supported as canonical
        delete/add entries; native similarity-only entries are rejected because
        Git emits no per-entry full-index identity for them.  Entry identities
        are parsed block-locally, while authority comes from one byte-exact
        native re-diff of the complete applied patch.  Applying blocks alone is
        intentionally forbidden as an oracle: a native file-to-directory or
        directory-to-file transition can be valid only as a whole patch.
        """
        starts = [match.start() for match in re.finditer(rb"(?m)^diff --git ", patch)]
        if not starts or patch[:starts[0]].strip():
            raise MatReject("patch preamble or missing diff entry")
        starts.append(len(patch))
        pairs = []
        for left, right in zip(starts, starts[1:]):
            block = patch[left:right]
            indexish = re.findall(rb"(?m)^index [^\n]*$", block)
            exact = re.findall(
                rb"(?m)^index ([0-9a-f]{40})\.\.([0-9a-f]{40})(?: [0-7]{6})?$",
                block)
            if len(indexish) == 1 and len(exact) == 1:
                old_id, new_id = exact[0]
                index_match = re.search(rb"(?m)^index [^\n]*\n", block)
                payload_match = re.search(
                    rb"(?m)^(?:--- |@@ |GIT binary patch$)", block)
                empty_blob = b"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391"
                add_modes = re.findall(rb"(?m)^new file mode ([0-7]{6})$", block)
                delete_modes = re.findall(
                    rb"(?m)^deleted file mode ([0-7]{6})$", block)
                empty_transition = (
                    (add_modes in [[b"100644"], [b"100755"]]
                     and not delete_modes and old_id == b"0" * 40
                     and new_id == empty_blob)
                    or (delete_modes in [[b"100644"], [b"100755"]]
                        and not add_modes and old_id == empty_blob
                        and new_id == b"0" * 40))
                if (index_match is None
                        or (payload_match is None and not empty_transition)
                        or (payload_match is not None
                            and index_match.end() > payload_match.start())):
                    raise MatReject("entry full-index identity is misplaced")
                pairs.append((old_id, new_id))
            elif not indexish and not exact:
                old_modes = re.findall(rb"(?m)^old mode ([0-7]{6})$", block)
                new_modes = re.findall(rb"(?m)^new mode ([0-7]{6})$", block)
                if (len(old_modes) != 1 or len(new_modes) != 1
                        or old_modes[0] == new_modes[0]
                        or {old_modes[0], new_modes[0]}
                            - {b"100644", b"100755"}
                        or re.search(
                            rb"(?m)^(?:--- |@@ |GIT binary patch$)",
                            block) is not None):
                    raise MatReject("noncanonical mode-only entry")
                pairs.append(None)
            else:
                raise MatReject("each content entry needs one exact full-index line")
        return pairs

    def r122_durable_reference(delta_obj, base=None):
        pinned = r122_base_sha if base is None else base
        if (not isinstance(delta_obj, dict)
                or set(delta_obj) != {"version", "format", "base_commit", "patch_b64"}
                or type(delta_obj.get("version")) is not int
                or delta_obj.get("version") != 1
                or type(R122_MAXF) is not int or R122_MAXF <= 0
                or type(R122_MAXL) is not int or R122_MAXL <= 0
                or type(R122_OPS) is not int or R122_OPS <= 0):
            raise MatReject("strict materialization inputs")
        volatile_commit, volatile_tree, changed = ref_materialize(
            r122_base_git, pinned, delta_obj, R122_ALLOWED,
            R122_MAXF, R122_MAXL, R122_OPS, str(r122_prot))
        patch = base64.b64decode(delta_obj["patch_b64"], validate=True)
        index_file = r122_prot / ("index-" + secrets.token_hex(8))
        try:
            base_tree = r122_closed_git(
                r122_base_git, "rev-parse", "--verify", f"{pinned}^{{tree}}"
            ).stdout.decode().strip()
            r122_closed_git(r122_base_git, "read-tree", base_tree,
                            index_file=index_file)
            r122_closed_git(r122_base_git, "apply", "--cached", "--binary",
                            "--whitespace=nowarn", "--unsafe-paths", "--check", "-",
                            index_file=index_file, input_bytes=patch)
            r122_closed_git(r122_base_git, "apply", "--cached", "--binary",
                            "--whitespace=nowarn", "--unsafe-paths", "-",
                            index_file=index_file, input_bytes=patch)
            durable_tree = r122_closed_git(
                r122_base_git, "write-tree", index_file=index_file
            ).stdout.decode().strip()
            if durable_tree != volatile_tree:
                raise MatReject("durable tree differs from private derivation")
            canonical_patch = r122_closed_git(
                r122_base_git, "diff", "--cached", "--binary", "--full-index",
                "--no-renames", base_tree, "--", index_file=index_file).stdout
            if patch != canonical_patch:
                raise MatReject("patch is not complete canonical native output")
            declared_pairs = r123_entry_index_pairs(patch)
            raw_effect = r122_closed_git(
                r122_base_git, "diff-tree", "-r", "--no-commit-id", "--raw",
                "--no-renames", base_tree, durable_tree).stdout
            actual_pairs = list(re.findall(
                rb"(?m)^:[0-7]{6} [0-7]{6} ([0-9a-f]{40}) ([0-9a-f]{40}) [AMDTCUXBR]",
                raw_effect))
            ordered_pairs_ok = (
                len(declared_pairs) == len(actual_pairs)
                and all(declared == actual or (
                        declared is None and actual[0] == actual[1])
                        for declared, actual
                        in zip(declared_pairs, actual_pairs)))
            if (len(declared_pairs) != len(changed) or not ordered_pairs_ok):
                raise MatReject("patch index preimage/postimage not bound to derived tree")
            durable_commit = r122_closed_git(
                r122_base_git, "commit-tree", durable_tree, "-p", pinned,
                "-m", "nortropic candidate (materialized from protected artifact)",
                commit_identity=True,
            ).stdout.decode().strip()
            resolved_tree = r122_closed_git(
                r122_base_git, "rev-parse", "--verify",
                f"{durable_commit}^{{tree}}"
            ).stdout.decode().strip()
            if resolved_tree != durable_tree:
                raise MatReject("durable candidate identity does not resolve")
            return durable_commit, durable_tree, changed
        finally:
            try:
                index_file.unlink()
            except FileNotFoundError:
                pass

    def r122_run(delta_obj, base=None):
        return r122_durable_reference(delta_obj, base=base)

    def r122_candidate_identity_ok(git_dir, candidate, expected_commit, expected_tree):
        if not isinstance(candidate, str) or re.fullmatch(r"[0-9a-f]{40}", candidate) is None:
            return False
        if candidate != expected_commit:
            return False
        object_type = r122_closed_git(
            git_dir, "cat-file", "-t", candidate, check=False)
        resolved = r122_closed_git(
            git_dir, "rev-parse", "--verify", f"{candidate}^{{tree}}",
            check=False)
        return (object_type.returncode == 0 and object_type.stdout == b"commit\n"
                and resolved.returncode == 0
                and resolved.stdout.decode().strip() == expected_tree)

    def r123_actual_args_ok(values, expected_git, expected_base, expected_delta,
                            expected_allowed, expected_maxf, expected_maxl,
                            expected_ops, expected_protected):
        if not isinstance(values, tuple) or len(values) != 8:
            return False
        (actual_git, actual_base, actual_delta, actual_allowed,
         actual_maxf, actual_maxl, actual_ops, actual_protected) = values
        try:
            actual_git_path = Path(actual_git).resolve()
            actual_protected_path = Path(actual_protected).resolve()
            allowed_value = list(actual_allowed)
        except Exception:
            return False
        return (
            actual_git_path == Path(expected_git).resolve()
            and actual_base == expected_base
            and actual_delta == expected_delta
            and allowed_value == list(expected_allowed)
            and type(actual_maxf) is int and actual_maxf == expected_maxf
            and type(actual_maxl) is int and actual_maxl == expected_maxl
            and type(actual_ops) is int and actual_ops == expected_ops
            and actual_protected_path == Path(expected_protected).resolve())

    def r123_call_materialize(function, values):
        signature = inspect.signature(function)
        parameters = tuple(signature.parameters.values())
        if (len(parameters) != 8
                or any(parameter.kind in {
                    inspect.Parameter.VAR_POSITIONAL,
                    inspect.Parameter.VAR_KEYWORD} for parameter in parameters)):
            raise TypeError("materialize must expose eight bounded capabilities")
        positional = []
        keywords = {}
        for parameter, value in zip(parameters, values):
            if parameter.kind is inspect.Parameter.POSITIONAL_ONLY:
                positional.append(value)
            else:
                keywords[parameter.name] = value
        return function(*positional, **keywords)

    # ---- J_MATERIALIZE_RIG: positive tree-exact (scratch-independent) + full
    # validation/collision/bound negative matrix all reject ----
    r122_ok_patch = r122_newfile("controller/result/materialize.py", b"# candidate\n")
    _r122_binary_path = r122_base / "controller/result/forensic.bin"
    _r122_binary_bytes = b"\x00R122\xff\nBINARY\x00"
    _r122_binary_path.write_bytes(_r122_binary_bytes)
    _rg("add", "-N", "controller/result/forensic.bin")
    r122_binary_patch = _rg(
        "diff", "--binary", "--full-index", "--", "controller/result/forensic.bin").stdout
    _rg("reset", "-q", "--", "controller/result/forensic.bin")
    _r122_binary_path.unlink()
    _c1 = _t1 = _c2 = _t2 = _bc = _bt = None
    _r128_c2 = _r128_t2 = _r128_overflow_c = _r128_overflow_t = None
    _ch1 = _ch2 = _bch = _r128_ch2 = _r128_overflow_ch = []
    try:
        _c1, _t1, _ch1 = r122_run(r122_delta(r122_ok_patch))
        _c2, _t2, _ch2 = r122_run(r122_delta(r122_ok_patch))   # independent re-derivation
        _r128_patch2 = r122_newfile(
            "controller/result/remediation.py", b"R128_REMEDIATED = True\n")
        _r128_delta2 = r122_delta(_r128_patch2, base=_c1)
        _r128_c2, _r128_t2, _r128_ch2 = r122_run(_r128_delta2, base=_c1)
        _r128_overflow_patch = r122_newfiles([
            (f"controller/result/overflow-{ordinal:02d}.py", b"X = 1\n")
            for ordinal in range(R122_MAXF)
        ])
        _r128_overflow_delta = r122_delta(_r128_overflow_patch, base=_c1)
        (_r128_overflow_c, _r128_overflow_t,
         _r128_overflow_ch) = r122_run(_r128_overflow_delta, base=_c1)
        _bc, _bt, _bch = r122_run(r122_delta(r122_binary_patch))
        _bblob = r122_closed_git(
            r122_base_git, "show", f"{_bc}:controller/result/forensic.bin"
        ).stdout
        r122_positive = (
            _c1 == _c2 and _t1 == _t2
            and _ch1 == _ch2 == ["controller/result/materialize.py"]
            and _r128_ch2 == ["controller/result/remediation.py"]
            and len(_r128_overflow_ch) == R122_MAXF
            and _bch == ["controller/result/forensic.bin"]
            and _bblob == _r122_binary_bytes
            and r122_closed_git(r122_base_git, "cat-file", "-e", f"{_c1}^{{commit}}",
                                check=False).returncode == 0
            and r122_closed_git(r122_base_git, "rev-parse", "--verify",
                                f"{_c1}^{{tree}}").stdout.decode().strip() == _t1
            and not any(r122_prot.iterdir())
        )
    except MatReject:
        r122_positive = False

    def r123_git_control_snapshot(git_dir):
        """Complete no-follow Git control-plane state, excluding object bytes.

        show-ref is intentionally insufficient: HEAD, pseudorefs, packed-refs,
        reftable state and ref logs are authority too.  The attempt-private
        materialization child is excluded because it must be absent at each
        completed-call sample and is checked separately.
        """
        root = Path(git_dir)
        excluded = {"objects", "nortropic-candidate-materialization"}
        rows = []
        stack = [(root, "")]
        while stack:
            parent, prefix = stack.pop()
            for entry in sorted(os.scandir(parent), key=lambda item: item.name):
                rel = entry.name if not prefix else prefix + "/" + entry.name
                if not prefix and entry.name in excluded:
                    continue
                st = entry.stat(follow_symlinks=False)
                if stat.S_ISLNK(st.st_mode):
                    rows.append((rel, "L", st.st_mode, st.st_uid, st.st_gid,
                                 st.st_nlink, os.readlink(entry.path)))
                elif stat.S_ISDIR(st.st_mode):
                    rows.append((rel, "D", st.st_mode, st.st_uid, st.st_gid,
                                 st.st_nlink))
                    stack.append((Path(entry.path), rel))
                elif stat.S_ISREG(st.st_mode):
                    rows.append((rel, "F", st.st_mode, st.st_uid, st.st_gid,
                                 st.st_nlink, st.st_size,
                                 hashlib.sha256(Path(entry.path).read_bytes()).hexdigest()))
                else:
                    rows.append((rel, "X", st.st_mode, st.st_uid, st.st_gid,
                                 st.st_nlink, st.st_rdev))
        return tuple(rows)

    def r123_object_ids(git_dir):
        proc = r122_closed_git(
            git_dir, "cat-file", "--batch-all-objects",
            "--batch-check=%(objectname)", check=False)
        if proc.returncode != 0:
            return None
        values = proc.stdout.splitlines()
        if any(re.fullmatch(rb"[0-9a-f]{40}", value) is None for value in values):
            return None
        return frozenset(value.decode() for value in values)

    def r123_odb_binding(git_dir):
        root = Path(git_dir) / "objects"
        try:
            st = root.lstat()
        except OSError:
            return None
        if not stat.S_ISDIR(st.st_mode):
            return None
        forbidden = [root / "info/alternates", root / "info/http-alternates"]
        if any(os.path.lexists(path) for path in forbidden):
            return None
        return (st.st_dev, st.st_ino, st.st_mode, st.st_uid, st.st_gid,
                st.st_nlink)

    def r123_odb_identity_equal(left, right):
        return (isinstance(left, tuple) and isinstance(right, tuple)
                and len(left) == len(right) == 6 and left[:5] == right[:5])

    def r123_odb_layout(git_dir):
        """Complete no-follow object-store layout including non-object residue."""
        root = Path(git_dir) / "objects"
        try:
            if r123_odb_binding(git_dir) is None:
                return None
            rows = []
            stack = [(root, "")]
            while stack:
                parent, prefix = stack.pop()
                for entry in sorted(os.scandir(parent), key=lambda item: item.name):
                    rel = entry.name if not prefix else prefix + "/" + entry.name
                    st = entry.stat(follow_symlinks=False)
                    common = (rel, st.st_mode, st.st_uid, st.st_gid, st.st_nlink)
                    if stat.S_ISDIR(st.st_mode):
                        rows.append((*common, "D"))
                        stack.append((Path(entry.path), rel))
                    elif stat.S_ISREG(st.st_mode):
                        rows.append((*common, "F", st.st_size,
                                     hashlib.sha256(Path(entry.path).read_bytes()).hexdigest()))
                    elif stat.S_ISLNK(st.st_mode):
                        rows.append((*common, "L", os.readlink(entry.path)))
                    else:
                        rows.append((*common, "X", st.st_rdev))
            return tuple(rows)
        except OSError:
            return None

    def r123_odb_delta_ok(before, after, added_ids, root_binding,
                          creation_umask=0o077):
        if (before is None or after is None
                or not isinstance(added_ids, (set, frozenset))
                or not isinstance(root_binding, tuple)
                or len(root_binding) != 6
                or not stat.S_ISDIR(root_binding[2])
                or type(creation_umask) is not int
                or creation_umask < 0 or creation_umask > 0o777):
            return False
        # Git creates new fanouts and loose objects under the process umask; it
        # does not inherit the mode of a pre-existing objects root.  The gate
        # itself fixes umask 077, while explicit 022 controls prove that this is
        # an effect relation rather than another hard-coded permission value.
        fanout_mode = 0o777 & ~creation_umask
        object_mode = 0o444 & ~creation_umask
        root_uid, root_gid = root_binding[3], root_binding[4]
        before_map = {row[0]: row[1:] for row in before}
        after_map = {row[0]: row[1:] for row in after}
        added_paths = set(after_map) - set(before_map)
        expected_files = {object_id[:2] + "/" + object_id[2:]
                          for object_id in added_ids}
        actual_files = {path for path in added_paths
                        if re.fullmatch(r"[0-9a-f]{2}/[0-9a-f]{38}", path)}
        allowed_dirs = {object_id[:2] for object_id in added_ids}
        if actual_files != expected_files:
            return False
        for path, before_value in before_map.items():
            after_value = after_map.get(path)
            # On APFS a loose-object fanout directory's st_nlink increases when
            # a new direct object child is added.  Admit only that exact,
            # reachability-bound increment; every other pre-existing metadata or
            # content change remains disqualifying.
            new_children = sum(
                candidate.startswith(path + "/")
                for candidate in actual_files)
            if new_children == 0 and after_value == before_value:
                continue
            fanout_nlink_only = (
                re.fullmatch(r"[0-9a-f]{2}", path) is not None
                and new_children > 0
                and isinstance(after_value, tuple)
                and len(before_value) == len(after_value) == 5
                and before_value[4] == after_value[4] == "D"
                and before_value[:3] == after_value[:3]
                and after_value[3] == before_value[3] + new_children)
            if not fanout_nlink_only:
                return False
        for path in added_paths:
            value = after_map[path]
            if path in expected_files:
                if (len(value) != 7 or value[4] != "F"
                        or not stat.S_ISREG(value[0])
                        or stat.S_IMODE(value[0]) != object_mode
                        or value[1] != root_uid or value[2] != root_gid
                        or value[3] != 1
                        or type(value[5]) is not int or value[5] <= 0
                        or not isinstance(value[6], str)
                        or re.fullmatch(r"[0-9a-f]{64}", value[6]) is None):
                    return False
            elif path in allowed_dirs:
                direct_children = sum(
                    candidate.startswith(path + "/")
                    for candidate in actual_files)
                if (len(value) != 5 or value[4] != "D"
                        or not stat.S_ISDIR(value[0])
                        or stat.S_IMODE(value[0]) != fanout_mode
                        or value[1] != root_uid or value[2] != root_gid
                        or value[3] != 2 + direct_children):
                    return False
            else:
                return False
        return True

