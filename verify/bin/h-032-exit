    def _r125_install_namespace(name, directory):
        if name in sys.modules:
            raise RuntimeError("candidate dependency namespace preloaded")
        package = types.ModuleType(name)
        package.__file__ = None
        package.__package__ = name
        package.__path__ = [str(directory)]
        package.__spec__ = importlib.util.spec_from_loader(
            name, loader=None, is_package=True)
        sys.modules[name] = package
        if "." in name:
            parent_name, child_name = name.rsplit(".", 1)
            setattr(sys.modules[parent_name], child_name, package)
        return package
    def _r125_install_dependency(name, path):
        if name in sys.modules:
            raise RuntimeError("candidate dependency module preloaded")
        dependency_text = _r125_dependency_texts[str(path)][0]
        dependency_module = types.ModuleType(name)
        dependency_module.__file__ = str(path)
        dependency_module.__package__ = name.rpartition(".")[0]
        dependency_module.__loader__ = None
        dependency_module.__spec__ = importlib.util.spec_from_loader(
            name, loader=None, origin=str(path))
        sys.modules[name] = dependency_module
        if "." in name:
            parent_name, child_name = name.rsplit(".", 1)
            setattr(sys.modules[parent_name], child_name, dependency_module)
        events, rejection, loader_events = r125_observed_definition_exec(
            dependency_text, dependency_module.__dict__, str(path))
        if rejection is not None or events or loader_events:
            raise RuntimeError("candidate dependency definition-time effect")
        return dependency_module

    # Import-machinery reads are judge-owned, not candidate effects.  Warm the
    # exact finite stdlib dependency set before arming a dependency definition
    # ticket; each dependency body still executes only while that ticket is
    # armed, and its source/import inventory above remains independently bound.
    import argparse as _r125_argparse  # noqa: F401
    import dataclasses as _r125_dataclasses  # noqa: F401
    import tempfile as _r125_tempfile  # noqa: F401
    import typing as _r125_typing  # noqa: F401
    if not all(_r125_name in sys.modules for _r125_name in (
            "argparse", "dataclasses", "tempfile", "typing")):
        raise RuntimeError("judge dependency prewarm incomplete")
    if _r125_uses_result_materialize:
        _r125_install_namespace("controller", repo / "controller")
        _r125_install_namespace("controller.authority", repo / "controller/authority")
        _r125_install_namespace("controller.result", repo / "controller/result")
