            _r125_dependency_text,
            hashlib.sha256(_r125_dependency_raw).hexdigest())
    _r125_dependency_files = tuple(_r125_dependency_texts)
    _r125_dependency_plain_positive = "import os\nVALUE = 1\ndef f(value):\n return value\n"
    _r125_dependency_set_positive = "import os\nHEX = set('abc')\n"
    _r125_dependency_source_rig = (
        _r125_dependency_source_ok(
            _r125_dependency_plain_positive, ["I:os"])
