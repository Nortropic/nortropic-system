            if prior_trust is None: os.environ.pop("NORTROPIC_TRUST_ROOT",None)
            else: os.environ["NORTROPIC_TRUST_ROOT"]=prior_trust
        output=str(observed.get("output_path","")) if isinstance(observed,dict) else ""
        incoming=launch_environment_inputs.pop(output,{})
        observation=launch_observations.get(output,{"valid":False})
        removed_current=None
        if remove_current_effect and isinstance(observation.get("current_run"),str):
            removed_current=Path(observation["current_run"])
            if removed_current.parent==r74_runs_root and removed_current.is_dir():
