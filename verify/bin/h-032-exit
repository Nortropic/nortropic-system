                                   expected_output_paths=1,
                                   expected_journal_starts=(0, 1)))
            r59_variant_detail = {
                "repeated_shape": repeated_shape_ok,
                "repeated_discovered": (repeated_discovery[5]
                                        if repeated_discovery is not None else None),
                "repeated_injected": r59_repeated_fstat_connected,
                "helper_shape": helper_shape_ok,
