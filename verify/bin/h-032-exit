                    bad = {"wide": {"specs/tasks.spec.json": (json.dumps(wide, ensure_ascii=False,
                        separators=(",", ":")).encode() + b"\n", True), path: b"R128=1\n" * 601},
                        "nine": {f"docs/r128-{n}": b"x\n" for n in range(9)}}.get(mode)
                    first_delta = _owner_delta(repo, base, bad or {path: b"\n# R128 C1\n"})
                    def agent(repo_arg, scratch, role, _prompt, wt_root_arg):
                        current = r128_git(scratch, "rev-parse", "HEAD").stdout.decode().strip()
                        forbidden = set(r128_object_inodes(git_dir) or ()) | ctx["scratch_inodes"]
                        inodes = r128_isolated_provider(
                            scratch, current, git_dir, wt_root_arg, forbidden)
                        if (repo_arg != repo or Path(wt_root_arg) != wt_root or inodes is None
                                or Path(scratch).resolve() in ctx["scratches"]):
                            raise AssertionError("owner provider not freshly isolated")
                        ctx["trace"] += role[0]
                        prior = [(item[0], item[1]) for item in ctx["roles"]]
                        parent = r128_git(repo, "rev-list", "--parents", "-n", "1",
                                          current).stdout.decode().split()
                        sequence = (("TEST_AUTHOR", base, None), ("GATE_REVIEWER", current, [current, base]),
                            ("TEST_AUTHOR", prior[1][1] if len(prior) > 1 else "", None),
                            ("GATE_REVIEWER", current, [current, prior[1][1]] if len(prior) > 1 else []))
                        if len(prior) > 3 or (role, current) != sequence[len(prior)][:2] or (
                                sequence[len(prior)][2] is not None and parent != sequence[len(prior)][2]):
                            raise AssertionError("owner review/remediation lineage mismatch")
                        ctx["scratch_inodes"].update(inodes); ctx["scratches"].add(Path(scratch).resolve())
                        ctx["roles"].append((role, current, Path(scratch).resolve(),
                                             r128_refs(git_dir), _prompt))
                        if role == "TEST_AUTHOR":
                            delta = first_delta if current == base else _owner_delta(repo, current,
                                {path: _owner_red(repo, current, path, kind)})
                            ctx["deltas"].append(delta)
                            report = {"role": role, "outcome": "READY", "frozen_gate_ready": True,
                                "baseline_red_for_right_reason": True, "owner_decision_required": False,
                                "blocking_findings": [], "candidate_delta": delta}
                        elif role == "GATE_REVIEWER":
                            review_count["n"] += 1
                            blocked = review_count["n"] == 1 and mode != "first-ready"
                            report = {"role": role, "outcome": "NEEDS_REMEDIATION" if blocked else "READY",
                                "owner_decision_required": False, "blocking_findings":
                                ([{"id": "R128-OWNER", "summary": ctx["blocker_token"]}] if blocked else []),
                                "candidate_delta": None}
                        else:
                            raise AssertionError("unexpected owner role")
                        subject = base if mode == "stale-final" and review_count["n"] == 2 else current
                        run = _auto.AgentRun(report, None, r122 / "owner-events",
                                             r122_result_file, subject_sha=subject)
                        if role == "GATE_REVIEWER":
                            ctx["review_run"] = run; ctx["reviews"].append(run)
                        if mode == "skip-final" and review_count["n"] == 2: ctx["roles"].pop()
                        return run
                    def closed(repo_arg, *args, **kwargs):
                        if tuple(args[:2]) == ("merge", "--ff-only"):
                            ctx["forbidden"].append("adoption"); raise _auto.Stop("R128 A2 gate dependency")
                        return _real_closed_git(repo_arg, *args, **kwargs)
                    def no_gate(label):
                        def blocked(*_args, **_kwargs):
                            ctx["forbidden"].append(label); raise _auto.Stop("R128 forbidden " + label)
                        return blocked
                    def a2_boundary(repo_arg, wt_root_arg, label_arg, task_base,
                                    candidate, review_run, sl_arg=None):
                        expected_sl = sl if kind == "roadmap" else None
                        expected_roles = 2 if mode == "first-ready" else 4
                        if mode == "candidate-ref": r128_git(repo, "update-ref", "refs/heads/r128-mutant", candidate)
                        if mode == "forbidden-adopt": return closed(branch_wt, "merge", "--ff-only", candidate)
                        if mode == "arbitrary-stop": raise _auto.Stop("R128 A2 gate dependency")
                        if (repo_arg != repo or Path(wt_root_arg) != wt_root
                                or label_arg != label or task_base != base
                                or len(ctx["roles"]) != expected_roles or candidate != ctx["roles"][-1][1]
                                or review_run is not ctx["review_run"]
                                or review_run.subject_sha != candidate or sl_arg != expected_sl
                                or review_run.report.get("role") != "GATE_REVIEWER"
                                or review_run.report.get("outcome") != "READY"
                                or _auto.report_blockers(review_run.report)
                                or review_run.report.get("candidate_delta") is not None):
                            raise _auto.Stop("R128 invalid A2 boundary")
                        ctx["boundary"].append((kind, candidate))
                        raise _R128A2Boundary("R128 A2 gate dependency")
                    def limits(repo_arg, task):
                        value = _real_task_limits(repo_arg, task)
                        if value != frozen_limits: raise AssertionError("owner canonical limits drift")
                        if mode == "dynamic-limit": value = expected_limits
                        head = r128_git(repo_arg, "rev-parse", "HEAD").stdout.decode().strip()
                        ctx["trace"] += "L"; ctx["limit_return"] = value
                        ctx["limits"].append((head, task.get("id"), value)); return value
                    _auto.origin_main = lambda _repo: base; _auto._run_codex_agent = agent
                    _auto.run_reviewed_owner_gates = a2_boundary
                    _auto.run_gate = no_gate("legacy-gate"); _auto.run_invariants = no_gate("invariants")
                    _auto.closed_worktree_git = closed; _auto.publish = no_gate("publication")
                    _auto.ensure_roadmap_plan = lambda _repo: None
                    _auto.ensure_substitution_authority = lambda _repo: None
                    _auto.assert_materialized_cumulative_scope = _real_cumulative_scope
                    _auto.assert_builder_scope = _real_assert_scope
                    _auto.task_limits = limits; _auto.stage_and_commit = no_gate("scratch-staging")
                    _flow_calls["n"] = 0; _flow_call_args.clear(); _flow_call_results.clear()
                    _flow_materializer_spans.clear(); _flow_audit_events.clear()
                    _flow_return_mode["value"] = "decoy" if mode == "wrong-result" else None
                    _auto.TEST_AUTHOR_ALLOWED = (set(_real_test_author_allowed) |
                        ({"docs/r128-*"} if mode == "nine" else set()))
                    _r123_observer["invalid"] = False
                    try:
                        (_auto.test_author_flow(repo, wt_root) if kind == "h003" else
                         _auto.roadmap_contract_flow(repo, wt_root, sl) if kind == "roadmap" else
                         _auto.empirical_gate_contract_flow(repo, wt_root))
                    except _R128A2Boundary as exc:
                        ctx["stop"] = ("A2", str(exc))
                    except _auto.Stop as exc:
                        ctx["stop"] = ("STOP", str(exc))
                    finally:
                        if mode == "extra-call" and ctx["stop"] and ctx["stop"][0] == "A2":
                            _recording_materialize(*_flow_call_args[-1])
                        ctx["final"] = _owner_state(ctx)
                        ctx["call_args"] = tuple(_flow_call_args); ctx["call_results"] = tuple(_flow_call_results)
                        ctx["calls"] = _flow_calls["n"]; ctx["spans"] = tuple(_flow_materializer_spans)
                        ctx["events"] = tuple(_flow_audit_events)
                        ctx["invalid"] = _r123_observer["invalid"]
                        _auto.TEST_AUTHOR_ALLOWED = set(_real_test_author_allowed)
                    return dict(ctx)
                def _owner_scope(repo, old, new):
                    names = r128_git(repo, "diff", "--name-only", "--no-renames", "-z",
                                     old, new, "--", check=False)
                    nums = r128_git(repo, "diff", "--numstat", "--no-renames", "-z",
                                    old, new, "--", check=False)
                    try:
                        paths = tuple(sorted(x.decode() for x in names.stdout.split(b"\0") if x))
                        added = sum(int(row.split(b"\t", 1)[0]) for row in nums.stdout.split(b"\0") if row)
                    except (UnicodeDecodeError, ValueError):
                        return None
                    return (paths, added) if names.returncode == nums.returncode == 0 else None
                def _owner_endpoint(ctx, added):
                    pre, state = ctx["pre"], ctx["final"]
                    return (not ctx["invalid"] and isinstance(added, (set, frozenset)) and state is not None
                        and state[0] == pre[0] and state[1] == pre[1]
                        and state[2] == pre[2] | added
                        and r123_odb_identity_equal(pre[3], state[3])
                        and r123_odb_delta_ok(pre[4], state[4], added, pre[3])
                        and state[5] == pre[5] and _flow_branch(ctx, ctx["base"])
                        and r123_protected_clean(Path(ctx["git"]) /
                                                 "nortropic-candidate-materialization"))
                def _owner_materialized(ctx, candidates):
                    if not (ctx["calls"] == len(ctx["call_args"]) == len(ctx["call_results"])
                            == len(ctx["spans"]) == len(ctx["deltas"]) == len(candidates)):
                        return False
                    protected = Path(ctx["git"]) / "nortropic-candidate-materialization"
                    parents = (ctx["base"],) + tuple(candidates[:-1])
                    return (not ctx["invalid"] and all(
                        r123_actual_args_ok(ctx["call_args"][n], ctx["git"], parents[n],
                            ctx["deltas"][n], ctx["surface"], *ctx["expected_limits"],
                            ctx["expected_limits"][0], protected)
                        and tuple(ctx["call_results"][n]) == (candidate,
                            r128_git(ctx["repo"], "rev-parse", f"{candidate}^{{tree}}").stdout.decode().strip(),
                            [ctx["path"]])
                        and r123_materializer_effects_ok(
                            ctx["events"][ctx["spans"][n][0]:ctx["spans"][n][1]],
                            ctx["git"], protected, ctx["roles"][n * 2][2])
                        for n, candidate in enumerate(candidates)))
                def _owner_ok(ctx, blocked=True):
                    count = 4 if blocked else 2
                    if len(ctx["roles"]) != count or ctx["pre"] is None:
                        return False
                    base = ctx["base"]; candidates = tuple(ctx["roles"][n][1] for n in range(1, count, 2))
                    c1, final = candidates[0], candidates[-1]
                    added = r123_reachable_delta(ctx["git"], final, base)
                    scope = _owner_scope(ctx["repo"], base, final)
                    expected_roles = [("TEST_AUTHOR", base), ("GATE_REVIEWER", c1)]
                    if blocked: expected_roles += [("TEST_AUTHOR", c1), ("GATE_REVIEWER", final)]
                    first = ctx["reviews"][0] if ctx["reviews"] else None
                    first_blockers = _auto.report_blockers(first.report) if first is not None else None
                    return (ctx["stop"] == ("A2", "R128 A2 gate dependency")
                        and ctx["boundary"] == [(ctx["kind"], final)] and not ctx["forbidden"]
                        and added is not None and _owner_endpoint(ctx, added)
                        and [row[:2] for row in ctx["roles"]] == expected_roles
                        and len({row[2] for row in ctx["roles"]}) == count
                        and all(row[3] == ctx["pre"][1] for row in ctx["roles"])
                        and len(ctx["reviews"]) == len(candidates) and first is not None
                        and first.report.get("role") == "GATE_REVIEWER"
                        and all(run.subject_sha == candidate and
                                run.report.get("candidate_delta") is None
                                for run, candidate in zip(ctx["reviews"], candidates))
                        and ((blocked and first.report.get("outcome") == "NEEDS_REMEDIATION"
                              and first_blockers == [{"id": "R128-OWNER",
                                  "summary": ctx["blocker_token"]}]
                              and json.dumps(first_blockers, ensure_ascii=False, indent=2) in ctx["roles"][2][4]
                              and ctx["roles"][2][4].count(ctx["blocker_token"]) == 1)
                             or (not blocked and first.report.get("outcome") == "READY"
                                 and not first_blockers))
                        and ctx["trace"] == ("LTMGTMG" if blocked else "LTMG")
                        and all(r128_git(ctx["repo"], "rev-list", "--parents", "-n", "1",
                            candidate).stdout.split() == [candidate.encode(), parent.encode()]
                            for candidate, parent in zip(candidates, (base,) + candidates[:-1]))
                        and scope is not None and scope[0] == (ctx["path"],)
                        and scope[1] <= ctx["expected_limits"][1]
                        and r128_git(ctx["repo"], "show", f"{c1}:{ctx['path']}").stdout
                            == r128_git(ctx["repo"], "show", f"{base}:{ctx['path']}", check=False).stdout + b"\n# R128 C1\n"
                        and (not blocked or r128_git(ctx["repo"], "show", f"{final}:{ctx['path']}").stdout
                            == _owner_red(ctx["repo"], c1, ctx["path"], ctx["kind"])[0])
                        and ctx["limit_return"] == ctx["expected_limits"]
                        and ctx["limits"] == [(base, None if ctx["kind"] == "L" else ctx["label"],
                                                ctx["expected_limits"])]
                        and _owner_materialized(ctx, candidates))
                _owner_cases = tuple(_owner_drive(kind) for kind in ("h003", "roadmap", "L"))
                _dynamic_limit = _owner_drive("h003", "dynamic-limit")
                _first_ready = _owner_drive("h003", "first-ready")
                _owner_composition = (all(_owner_ok(ctx) for ctx in _owner_cases)
                    and _owner_ok(_dynamic_limit) and _owner_ok(_first_ready, blocked=False))
                _limit_cases = (_owner_drive("h003", "wide"), _owner_drive("h003", "nine"))
                _owner_limits_closed = all(ctx["stop"] and ctx["stop"][0] == "STOP"
                    and not ctx["boundary"] and not ctx["forbidden"]
                    and len(ctx["roles"]) == 1 and ctx["calls"] == 1 and ctx["trace"] == "LTM"
                    and ctx["roles"][0][3] == ctx["pre"][1] and not ctx["call_results"]
                    and ctx["limits"] == [(ctx["base"], "h-003", (8, 600))]
                    and len(ctx["call_args"]) == len(ctx["spans"]) == len(ctx["deltas"]) == 1
                    and r123_actual_args_ok(ctx["call_args"][0], ctx["git"], ctx["base"],
                        ctx["deltas"][0], ctx["surface"], 8, 600, 8,
                        Path(ctx["git"]) / "nortropic-candidate-materialization")
                    and r123_materializer_effects_ok(
                        ctx["events"][ctx["spans"][0][0]:ctx["spans"][0][1]], ctx["git"],
                        Path(ctx["git"]) / "nortropic-candidate-materialization",
                        ctx["roles"][0][2], require_complete=False) and not ctx["invalid"]
                    and _owner_endpoint(ctx, frozenset())
                    for ctx in _limit_cases)
                _owner_mutants = {mode: _owner_drive("h003", mode) for mode in (
                    "arbitrary-stop", "skip-final", "stale-final", "wrong-result",
                    "extra-call", "candidate-ref", "forbidden-adopt")}
                _owner_mutants_closed = (all(not _owner_ok(ctx) for ctx in _owner_mutants.values())
                    and _owner_mutants["arbitrary-stop"]["stop"] ==
                        ("STOP", "R128 A2 gate dependency")
                    and not _owner_mutants["arbitrary-stop"]["boundary"]
                    and len(_owner_mutants["skip-final"]["roles"]) == 3
                    and _owner_mutants["stale-final"]["review_run"].subject_sha ==
                        _owner_mutants["stale-final"]["base"]
                    and not _owner_mutants["stale-final"]["boundary"]
                    and len(_owner_mutants["wrong-result"]["roles"]) == 1
                    and _owner_mutants["wrong-result"]["call_results"][0][0] ==
                        _owner_mutants["wrong-result"]["base"]
                    and _owner_mutants["extra-call"]["calls"] == 3
                    and _owner_mutants["candidate-ref"]["final"][1] !=
                        _owner_mutants["candidate-ref"]["pre"][1]
                    and _owner_mutants["forbidden-adopt"]["forbidden"] == ["adoption"])
                _actual_surface_denied = (
                    _flow_profile_ok and _flow_launcher_compat
                    and _flow_ast_ownership
                    and _owner_composition and _owner_limits_closed and _owner_mutants_closed
                    and frozenset(_auto.TEST_AUTHOR_ALLOWED) == _real_test_author_allowed
                    and _managed_unsafe_rejected
                    and all(ctx["writer_stopped"] for ctx in
                            (_positive, _decoy, _overflow, _nonzero)))
                _actual_effect_detail = {
                    "spans": _positive["spans"], "agents": _positive["agents"],
                    "gates": _positive["gates"], "scope": _positive["scope"],
                    "post_clean": _positive["post_clean"], "roots": _roots_exact,
                    "owner": _owner_composition, "ast": _flow_ast_ownership,
                    "limits": _owner_limits_closed, "mutants": _owner_mutants_closed,
                    "a1a": "endpoint-only; A1b required"}
            finally:
                _r128_restore_observers()
                if "_real_closed_git" in locals():
                    _auto.closed_worktree_git = _real_closed_git
                _product_module.materialize = _pmat
                sys.modules.pop(_auto_name, None)
                if _sys_path_added:
                    sys.path.remove(str(source.parents[1]))

            _product_final_unchanged = (
                r123_git_control_snapshot(_product_git) == _product_control_before
                and r123_odb_identity_equal(
                    _product_odb_before, r123_odb_binding(_product_git))
                and r123_object_ids(_product_git) == _product_objects_after_semantics
                and r123_odb_layout(_product_git) == _product_layout_after_semantics
                and not any(_product_protected.iterdir()))
            materialization_boundary_ok = (
                _product_source_ok and _controller_source_ok
                and _actual_import_effects_ok
                and _product_direct_positive and _product_semantic_positive
                and _product_negatives
                and managed_real_ok
                and _actual_success and _connected_decoy_rejected
                and _cumulative_rejected
                and _actual_nonzero and _actual_surface_denied
                and r122_identity_oracle_rig and _product_final_unchanged)
            r122_boundary_detail = (
                f"direct={_product_direct_positive} semantic={_product_semantic_positive} "
                f"source_inventory={_product_source_ok} "
                f"controller_source={_controller_source_ok} "
                f"definition_effects={_actual_import_effects_ok} "
                f"definition_event_names={_auto_import_events} "
                f"definition_rejection={_auto_import_rejection} "
                f"negatives={_product_negatives} "
                f"managed_real={managed_real_ok} "
                f"actual_success={_actual_success} decoy={_connected_decoy_rejected} "
                f"cumulative={_cumulative_rejected} "
                f"actual_nonzero={_actual_nonzero} "
                f"identity_rig={r122_identity_oracle_rig} final_unchanged={_product_final_unchanged} "
                f"actual_args={_actual_args} effects={_actual_effects} "
                f"effect_detail={_actual_effect_detail} "
                f"semantic_failures={_product_semantic_failures} "
                f"surface_denied={_actual_surface_denied} "
                f"calls={_flow_calls['n']} candidate={_captured}")
        except Exception as _pexc:
            if "_r128_restore_observers" in locals():
                _r128_restore_observers()
            if ("_product_module" in locals() and "_pmat" in locals()
                    and "_recording_materialize" in locals()
                    and getattr(_product_module, "materialize", None)
                        is _recording_materialize):
                _product_module.materialize = _pmat
            if ("_sys_path_added" in locals() and _sys_path_added
                    and _product_root_text in sys.path):
                sys.path.remove(_product_root_text)
            materialization_boundary_ok = False
            r122_boundary_detail = f"product kernel present but failed: {_pexc}"
    check("K_CANDIDATE_MATERIALIZATION_BOUNDARY", materialization_boundary_ok, r122_boundary_detail)
    # ==================== END R122 ====================


    # Judge self-controls: one defect per disposable effect mutant. These do
    # not replace the real subject checks above; they prove the oracles have
    # opposite outcomes for the shallow unsafe construction.
    jc = work / "judge-controls"; jc.mkdir()
    jc_source = jc / "source"; jc_b = jc / "b"
    jc_source.write_bytes(b"A"); jc_b.write_bytes(b"B")
    with jc_source.open("rb") as opened:
        os.replace(jc_b, jc_source)
        same_opened = opened.read()
        reopened = jc_source.read_bytes()
    check("J_GR01_SAME_OPENED_OBJECT", same_opened == b"A", f"snapshot={same_opened!r}")
    check("J_GR01_PATH_REOPEN_MUTANT", reopened != b"A", f"mutant_snapshot={reopened!r}")

    authority_digest = hashlib.sha256(b"A").hexdigest()
    jc_snapshot = jc / "snapshot"; jc_snapshot.write_bytes(b"A")
    jc_snapshot.write_bytes(b"B")
    safe_rehash_admits = hashlib.sha256(jc_snapshot.read_bytes()).hexdigest() == authority_digest
    no_rehash_mutant_admits = True
    check("J_GR02_FINAL_REHASH", not safe_rehash_admits, f"safe_admits={safe_rehash_admits}")
    check("J_GR02_NO_REHASH_MUTANT", no_rehash_mutant_admits and not safe_rehash_admits,
          "mutant would execute changed bytes while rehash oracle rejects")

    cached_digest = authority_digest
    drifted = b"B"
    cached_mutant_admits = cached_digest == authority_digest
    fresh_oracle_admits = hashlib.sha256(drifted).hexdigest() == authority_digest
    check("J_GR04_CACHED_SUCCESS_MUTANT", cached_mutant_admits and not fresh_oracle_admits,
          f"cached={cached_mutant_admits} fresh={fresh_oracle_admits}")

    cleanup_root = jc / "cleanup-root"; cleanup_root.mkdir(); (cleanup_root / "snapshot").write_bytes(b"bad")
    shutil.rmtree(cleanup_root)
    check("J_GR05_FAILURE_CLEANUP", not cleanup_root.exists(), f"residue={cleanup_root.exists()}")

    # R4 judge anchors bind the same ordered oracle used at actual Popen.
    def adjacent_trace_admits(transitions_at: list[int], provider_reads_at: list[int],
                              host_reads_at: list[int], protected: bool) -> bool:
        last = max(transitions_at, default=-1)
        return (protected and bool(provider_reads_at) and bool(host_reads_at)
                and provider_reads_at[-1] > last and host_reads_at[-1] > last)
    early_decoy_admits = adjacent_trace_admits([1, 3, 5], [2], [2], True)
    final_reads_admit = adjacent_trace_admits([1, 3, 5], [6], [7], True)
    fchmod_final_admits = adjacent_trace_admits([1, 4], [5], [6], True)
    check("J_R4_GR05_EARLY_DECOY_PROTECTION_REJECT",
          not early_decoy_admits and final_reads_admit,
          "protect/read/unprotect/reprotect requires new reads after final transition")
    check("J_R4_GR05_FCHMOD_EQUIVALENT_POSITIVE", fchmod_final_admits,
          "fchmod transition shares the ordered protection oracle")
    retained_snapshot = jc / "retained-writable-provider"
    retained_snapshot.write_bytes(b"trusted")
    retained_fd = os.open(retained_snapshot, os.O_RDWR)
    try:
        retained_snapshot.chmod(0o500)
        before_retained = hashlib.sha256(retained_snapshot.read_bytes()).hexdigest()
        os.lseek(retained_fd, 0, os.SEEK_SET); os.write(retained_fd, b"changed")
        os.ftruncate(retained_fd, len(b"changed")); os.fsync(retained_fd)
        after_retained = hashlib.sha256(retained_snapshot.read_bytes()).hexdigest()
        check("J_R5_GR05_RETAINED_WRITABLE_FD_MUTANT_REJECT",
              before_retained != after_retained,
              "protected pathname changed through retained writable fd after early hash")
    finally:
        os.close(retained_fd); retained_snapshot.chmod(0o700); retained_snapshot.unlink()
    fd_fixture = jc / "fd-inventory"; fd_fixture.write_bytes(b"trusted"); fd_fixture.chmod(0o700)
    writer = os.open(fd_fixture, os.O_RDWR); duplicate_writer = os.dup(writer); os.close(writer)
    reader = os.open(fd_fixture, os.O_RDONLY); duplicate_reader = os.dup(reader); os.close(reader)
    try:
        identity_fd = fd_fixture.stat()
        def access(fd): return fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE
        check("J_R6_GR05_DUPLICATE_WRITER_ENUMERATED",
              (os.fstat(duplicate_writer).st_dev, os.fstat(duplicate_writer).st_ino)
              == (identity_fd.st_dev, identity_fd.st_ino) and access(duplicate_writer) == os.O_RDWR,
              f"fd={duplicate_writer} mode={access(duplicate_writer)}")
        check("J_R6_GR05_PREOPENED_RO_DUP_POSITIVE", access(duplicate_reader) == os.O_RDONLY,
              f"fd={duplicate_reader} mode={access(duplicate_reader)}")
    finally:
        os.close(duplicate_writer); os.close(duplicate_reader); fd_fixture.unlink()

    direct_parent, provider_parent = 100, 200
    check("J_R3_GR06_CONTROLLER_DIRECT_HOST_REJECT",
          direct_parent != provider_parent,
          f"observed_parent={direct_parent} required_parent={provider_parent}")
    check("J_R3_GR06_PROVIDER_CHILD_POSITIVE", provider_parent == provider_parent,
          "exactly one same-root child carries provider ancestry")

    semantic_cleanup = jc / "semantic-cleanup"; semantic_cleanup.mkdir()
    (semantic_cleanup / "provider").write_bytes(b"partial")
    helper_specific_inventory: list[Path] = []
    tree_inventory = list(semantic_cleanup.rglob("*"))
    check("J_R4_GR07_HELPER_NEUTRAL_RESIDUE_REJECT",
          not helper_specific_inventory and bool(tree_inventory),
          f"helper={helper_specific_inventory} tree={[str(p) for p in tree_inventory]}")
    shutil.rmtree(semantic_cleanup)
    # Outside every attempt arena but still beneath the shell trap-owned WORK.
    fixed_outside = work / "fixed-root-outside-attempt-arena"
    outside_was_absent = not fixed_outside.exists()
    outside_residue_seen = False
    try:
        os.mkdir(fixed_outside); (fixed_outside / "provider").write_bytes(b"partial")
        outside_residue_seen = outside_was_absent and fixed_outside.exists()
        check("J_R5_GR07_FIXED_ROOT_RESIDUE_REJECT", outside_residue_seen,
              f"path={fixed_outside} observed={outside_residue_seen}")
    finally:
        if fixed_outside.exists(): shutil.rmtree(fixed_outside)
    check("J_R5_GR07_FIXED_ROOT_SELF_CLEANUP", not fixed_outside.exists(),
          f"residue={fixed_outside.exists()}")
    journal_mutant = work / "judge-runs/run-1/leaked-family/provider"
    journal_mutant.parent.mkdir(parents=True); journal_mutant.write_bytes(b"partial")
    exact_names = {"provider-envelope.json", "events.jsonl", "result.json"}
    journal_mutant_allowed = (journal_mutant.name in exact_names
                              and journal_mutant.parent.parent.name == "judge-runs")
    check("J_R6_GR07_FAMILY_UNDER_RUNS_REJECT", not journal_mutant_allowed,
          f"path={journal_mutant} allowed={journal_mutant_allowed}")
    empty_sibling = work / "judge-runs/arbitrary-empty-root"; empty_sibling.mkdir()
    wrong_leaf = empty_sibling / "result.json"; wrong_leaf.write_text("{}")
    check("J_R7_GR07_EMPTY_SIBLING_RUN_REJECT", empty_sibling.name != "run-1",
          f"path={empty_sibling}")
    check("J_R7_GR07_RIGHT_LEAF_WRONG_RUN_REJECT", wrong_leaf.parent.name != "run-1",
          f"path={wrong_leaf}")
    shutil.rmtree(work / "judge-runs")
    journal_root_control = work / "judge-journal-root"
    journal_root_control.mkdir()
    exact_root_journal = journal_root_control / "events.jsonl"
    exact_root_journal.write_text("{}\n")
    root_sibling = journal_root_control / "unexpected.jsonl"
    root_sibling.write_text("{}\n")
    check("J_POSTPUB_EXACT_ROOT_JOURNAL_POSITIVE",
          exact_root_journal == journal_root_control / "events.jsonl",
          f"path={exact_root_journal}")
    check("J_POSTPUB_ROOT_JOURNAL_SIBLING_REJECT",
          root_sibling != journal_root_control / "events.jsonl",
          f"path={root_sibling}")
    shutil.rmtree(journal_root_control)

    check("J_R4_GR08_UNBOUNDED_PROVIDER_EFFECT", provider_fixture_effect,
          "digest-coherent oversized provider executes and captures without the bound")
    check("J_R4_GR08_UNBOUNDED_HOST_EFFECT", host_fixture_effect,
          "digest-coherent oversized host executes and captures without the bound")

    # GR-07 judge controls: the verdict is attached to the exact opened
    # object's identity. Path metadata alone and omission are insufficient.
    regular_mode = stat.S_IFREG | 0o700; fifo_mode = stat.S_IFIFO | 0o600
    def identity(st): return st.st_dev, st.st_ino
    def opened_regular_oracle(opened_st, inspected_st):
        return (inspected_st is not None and identity(opened_st) == identity(inspected_st)
                and stat.S_ISREG(inspected_st.st_mode))
    gr07_a = jc / "gr07-a"; gr07_b = jc / "gr07-b"
    gr07_a.write_bytes(b"trusted"); gr07_b.write_bytes(b"trusted")
    stale_path_st = gr07_a.stat()
    with gr07_b.open("rb") as opened:
        opened_st = original_fstat(opened.fileno())
        # Disposable unsafe implementation: digest/read succeeds but it omits
        # all metadata inspection of the opened object.
        no_check_bytes, no_check_st = opened.read(), None
    no_opened_check_admits = (no_check_bytes == b"trusted"
                              and opened_regular_oracle(opened_st, no_check_st))
    stale_path_stat_admits = opened_regular_oracle(opened_st, stale_path_st)
    with gr07_b.open("rb") as opened:
        same_opened_st = original_fstat(opened.fileno())
        same_opened_bytes = opened.read()
    same_opened_admits = (same_opened_bytes == b"trusted"
                          and opened_regular_oracle(same_opened_st, same_opened_st))
    nonregular_st = os.stat_result((fifo_mode, *same_opened_st[1:]))
    nonregular_opened_admits = opened_regular_oracle(nonregular_st, nonregular_st)
    check("J_GR07_NO_OPENED_OBJECT_TYPE_CHECK", not no_opened_check_admits,
          "NO_OPENED_OBJECT_TYPE_CHECK=REJECTED")
    check("J_GR07_STALE_PATH_STAT", not stale_path_stat_admits,
          "STALE_PATH_STAT=REJECTED")
    check("J_GR07_SAME_OPENED_OBJECT", same_opened_admits,
          "SAME_OPENED_OBJECT_REGULAR_CHECK=ADMITTED")
    check("J_GR07_NONREGULAR_OPENED_OBJECT", not nonregular_opened_admits,
          "NONREGULAR_OPENED_OBJECT=REJECTED")

    # Fresh upstream provenance is an executed prerequisite, not a copied
    # historical claim. It is intentionally last because an owner environment
    # may create one-time protected H-033 evidence while a nested sandbox is
    # expected to report ODÖMBART.
    h033_odom = False
    h033_env = without_caller_git_controls(dict(os.environ))
    h033_env["PYTHONDONTWRITEBYTECODE"] = "1"
    try:
        h033_result = subprocess.run(
            [str(h033_gate)], cwd=repo, env=h033_env, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=180)
        h033_ok = (h033_result.returncode == 0
                   and "H033_GATE_SUMMARY=55 PASS 0 FAIL" in h033_result.stdout
                   and "H033_GATE_RESULT=PASS" in h033_result.stdout)
        h033_odom = (h033_result.returncode == 2 or (
            h033_result.returncode == 1
            and "H033_GATE_SUMMARY=42 PASS 13 FAIL" in h033_result.stdout
            and "FAIL K_OWNER_FRESH_REQUEST_PASS: (2, '', '')" in h033_result.stdout
            and "FAIL K_OWNER_FRESH_REQUEST_FAIL: (2, '', '')" in h033_result.stdout
            and "FAIL K_OWNER_FRESH_REQUEST_ODÖMBART: (2, '', '')" in h033_result.stdout
        ))
        check("K_H033_FRESH_UPSTREAM_PROVENANCE", h033_ok,
              f"rc={h033_result.returncode} tail={h033_result.stdout[-500:].replace(chr(10), '|')}")
    except subprocess.TimeoutExpired:
        h033_odom = True
        check("K_H033_FRESH_UPSTREAM_PROVENANCE", False, "timeout/cleanup authority unavailable")

    authoritative_control_after = exact_tree_snapshot(authoritative_control_root)
    check("J_AUTHORITATIVE_LIVE_GIT_UNCHANGED",
          authoritative_control_after == authoritative_control_before,
          f"root={authoritative_control_root} before_entries="
          f"{len(authoritative_control_before)} after_entries={len(authoritative_control_after)}")

    passed = sum(ok for _, ok, _ in checks)
    failed = {key for key, ok, _detail in checks if not ok}
    for key, ok, detail in checks:
        print(("PASS " if ok else "FAIL ") + key + " — " + detail)
    print(f"SAMMANFATTNING {passed} PASS / {len(checks)-passed} FAIL")
    material_failed = failed - ({"K_G20_NAMESPACE"} if g20_odom else set()) \
                             - ({"K_H033_FRESH_UPSTREAM_PROVENANCE"} if h033_odom else set()) \
                             - ({"K_PROVIDER_STAGING_CONFINEMENT"} if confinement_odom else set()) \
                             - ({"K_PROVIDER_RENAME_BEFORE_MOVE_CONFINEMENT"} if confinement04_odom else set())
    owner_live_skip_expected = (owner_live_mode == "skip"
        and deterministic_result_ok
        and material_failed == {"K_STRUCTURED_RESULT_DELIVERY_BOUNDARY"})
    if owner_live_mode == "skip":
        print("OWNER_LIVE_EXECUTION=SKIPPED")
        print("OWNER_LIVE_START_DELTA=0")
    if owner_live_skip_expected:
        print("CURRENT_RED_REASON=OWNER_LIVE_PHASE_NOT_RUN")
    elif material_failed == {"K_STRUCTURED_RESULT_DELIVERY_BOUNDARY"}:
        print("CURRENT_RED_REASON=STRUCTURED_RESULT_DELIVERY_BOUNDARY_ABSENT")
    elif material_failed == {"K_CODE_MODE_HOST_IDENTITY_BOUNDARY"}:
        print("CURRENT_RED_REASON=CODE_MODE_HOST_IDENTITY_BOUNDARY_ABSENT")
    elif material_failed == {"K_CANDIDATE_MATERIALIZATION_BOUNDARY"}:
        print("CURRENT_RED_REASON=CANDIDATE_MATERIALIZATION_BOUNDARY_ABSENT")
    elif material_failed:
        print("CURRENT_RED_REASON=UNEXPECTED_CONTRACT_FAILURES:" + ",".join(sorted(material_failed)))
    if g20_odom or h033_odom or confinement_odom or confinement04_odom or owner_live_skip_expected:
        if g20_odom:
            print("ODÖMBART K_G20_NAMESPACE — nested sandbox-exec förbjuden; candidate-bound owner-runner evidence required")
        if h033_odom:
            print("ODÖMBART K_H033_FRESH_UPSTREAM_PROVENANCE — protected owner runner unavailable")
        if confinement_odom:
            print("ODÖMBART K_PROVIDER_STAGING_CONFINEMENT — nested sandbox-exec förbjuden; owner-runner krävs")
        if confinement04_odom:
            print("ODÖMBART K_PROVIDER_RENAME_BEFORE_MOVE_CONFINEMENT — nested sandbox-exec förbjuden; owner-runner krävs")
        if owner_live_skip_expected:
            print("ODÖMBART K_OWNER_LIVE_PHASE_NOT_RUN — explicit owner TEST_AUTHOR no-live mode; deterministic product controls passed")
        raise SystemExit(2)
    raise SystemExit(0 if passed == len(checks) else 1)
except SystemExit:
    raise
except Exception as exc:
    print(f"ODÖMBART K-RIGG — {type(exc).__name__}: {exc}")
    raise SystemExit(2)
PY
}

if [[ "$OWNER_LIVE_MODE" == "run" ]]; then
  run_gate_python &
  GATE_PID=$!
  PLAN_DEADLINE=$((SECONDS+300))
  while [[ ! -e "$OWNER_LIVE_PLAN" ]]; do
    if ! /bin/kill -0 "$GATE_PID" 2>/dev/null; then wait "$GATE_PID"; exit $?; fi
    if (( SECONDS >= PLAN_DEADLINE )); then quiesce_protocol; echo "ODÖMBART K_OWNER_LIVE_PROTOCOL — plan readiness timeout"; exit 2; fi
    /bin/sleep 0.05
  done
  "$OWNER_LIVE_HELPER" "$OWNER_LIVE_PLAN" "$OWNER_LIVE_RESULT" &
  HELPER_PID=$!
  wait "$HELPER_PID"
  HELPER_RC=$?
  HELPER_PID=""
  if [[ $HELPER_RC -ne 0 ]]; then
    quiesce_protocol; echo "ODÖMBART K_OWNER_LIVE_HELPER — helper failed rc=$HELPER_RC"; exit 2
  fi
  POST_DEADLINE=$((SECONDS+300))
  while /bin/kill -0 "$GATE_PID" 2>/dev/null; do
    if (( SECONDS >= POST_DEADLINE )); then quiesce_protocol; echo "ODÖMBART K_OWNER_LIVE_PROTOCOL — postprocess timeout"; exit 2; fi
    /bin/sleep 0.05
  done
  wait "$GATE_PID"; GATE_RC=$?;GATE_PID="";exit "$GATE_RC"
fi

run_gate_python
