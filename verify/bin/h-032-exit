    kernel_direct_detail={"fresh_child_authoritative":True};kernel_direct_ok=product_fresh_ok
    kernel_case_counter=[0]
    def direct_kernel_case(raw, *, invocation_id="1"*32, run_id="2"*32,
                           role="TEST_AUTHOR", preseed=False, hardlink=False,
                           mutate=False):
        kernel_case_counter[0]+=1
        arena=work/f"kernel-direct-{kernel_case_counter[0]}";arena.mkdir(mode=0o700)
        staging=arena/"private-staging";staging.mkdir(mode=0o700)
        sink=staging/"result-sink";canonical_parent=arena/"canonical"
        canonical_parent.mkdir(mode=0o700);canonical=canonical_parent/"result.json"
        writer=os.open(sink,os.O_WRONLY|os.O_CREAT|os.O_EXCL
                       |getattr(os,"O_CLOEXEC",0)|getattr(os,"O_NOFOLLOW",0),0o600)
        view=memoryview(raw)
        while view:
            count=os.write(writer,view)
            if count<=0: raise RuntimeError("direct fixture short write")
            view=view[count:]
        os.fsync(writer);os.close(writer)
        sink_fd=os.open(sink,os.O_RDONLY|getattr(os,"O_CLOEXEC",0)
                        |getattr(os,"O_NOFOLLOW",0))
        sink_stat=os.fstat(sink_fd)
        if hardlink: os.link(sink,staging/"second-link")
        if preseed: canonical.write_bytes(b"preseed")
        visible=[];stop_observer=threading.Event()
        def observe():
            while not stop_observer.is_set():
                if canonical.exists():
                    try: visible.append(canonical.stat().st_size)
                    except OSError: pass
                time.sleep(.0005)
        observer=threading.Thread(target=observe,daemon=True);observer.start()
        stop_mutator=threading.Event();mutator=None
        if mutate:
            offset=max(1,raw.find(b"xxxx"))
            def change_same_object():
                fd=os.open(sink,os.O_WRONLY|getattr(os,"O_NOFOLLOW",0))
                flip=False
                try:
                    while not stop_mutator.is_set():
                        os.pwrite(fd,b"y" if flip else b"x",offset);flip=not flip
                finally: os.close(fd)
            mutator=threading.Thread(target=change_same_object,daemon=True);mutator.start()
            time.sleep(.005)
        accepted=False;returned=None;error="NONE"
        try:
            returned=kernel_module.consume_private_result(
                sink_fd,canonical,invocation_id,run_id,role)
            accepted=True
        except Exception as exc:
            error=f"{type(exc).__name__}:{exc}"
        finally:
            stop_mutator.set()
            if mutator is not None: mutator.join(timeout=1)
            stop_observer.set();observer.join(timeout=1)
        fd_closed=False
        try: fcntl.fcntl(sink_fd,fcntl.F_GETFD)
        except OSError: fd_closed=True
        canonical_info=None
        if canonical.is_file() and not canonical.is_symlink():
            fd=os.open(canonical,os.O_RDONLY|getattr(os,"O_NOFOLLOW",0));st=os.fstat(fd)
            canonical_raw=b""
            while True:
                chunk=os.read(fd,65536)
                if not chunk: break
                canonical_raw+=chunk
            end=os.fstat(fd);os.close(fd)
            try: canonical_doc=strict_json(canonical_raw.decode("utf-8",errors="strict"))
            except Exception: canonical_doc=None
            canonical_info=(st,end,canonical_raw,canonical_doc)
        temp_entries=sorted(path.name for path in canonical_parent.iterdir()
                            if path.name!="result.json")
        # Caller owns transport-path cleanup; the kernel owns the fd and every
        # publication temporary.  Actual run_codex cleanup is tested separately.
        if staging.exists(): shutil.rmtree(staging)
        staging_absent=not staging.exists()
        result={"accepted":accepted,"returned":returned,"error":error,
            "sink_stat":sink_stat,"fd_closed":fd_closed,"canonical":canonical_info,
            "visible":tuple(visible),"temps":tuple(temp_entries),
            "staging_absent":staging_absent,"preseed":preseed}
        shutil.rmtree(arena)
        return result
    if kernel_structure_ok and kernel_module is not None:
        valid_kernel=direct_kernel_case(rig_valid_raw)
        max_kernel=direct_kernel_case(exact_sized_report(MAX_RESULT_BYTES))
        over_kernel=direct_kernel_case(exact_sized_report(MAX_RESULT_BYTES+1))
        duplicate_kernel=direct_kernel_case(rig_duplicate_raw)
        nested_kernel=direct_kernel_case(encoded_report(rig_bad_nested))
        wrong_role_kernel=direct_kernel_case(rig_valid_raw,role="BUILDER")
        same_binding_kernel=direct_kernel_case(rig_valid_raw,invocation_id="3"*32,run_id="3"*32)
        preseed_kernel=direct_kernel_case(rig_valid_raw,preseed=True)
        hardlink_kernel=direct_kernel_case(rig_valid_raw,hardlink=True)
        mutation_kernel=direct_kernel_case(exact_sized_report(MAX_RESULT_BYTES),mutate=True)
        def accepted_kernel(case,raw,invocation="1"*32,run="2"*32):
            info=case["canonical"]
            if not (case["accepted"] and case["fd_closed"] and info is not None
                    and not case["temps"] and case["staging_absent"]): return False
            before,after,_canonical_raw,doc=info
            expected_keys={"schema_version","invocation_id","run_id","role",
                           "result_sha256","report"}
            return (stat.S_ISREG(before.st_mode) and before.st_nlink==1
