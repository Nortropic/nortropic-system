             True, False)])
    _r125_dependency_texts = {}
    for (_r125_dependency_path, _r125_expected_imports, _r125_allow_set,
         _r125_postponed_annotations) in \
            _r125_dependency_specs:
        try:
            _r125_dependency_raw = _r125_dependency_path.read_bytes()
            _r125_dependency_text = _r125_dependency_raw.decode("utf-8")
        except (OSError, UnicodeDecodeError) as _r125_dependency_error:
            raise RuntimeError("candidate dependency source unavailable") \
