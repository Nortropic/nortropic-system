        original_os_readv = getattr(os, "readv", None)
        original_os_preadv = getattr(os, "preadv", None)
        tracked_fds: set[int] = set(); moved: list[Path] = []
        def observe(argv, *args, **kwargs):
            flat = list(argv)
            if "-o" in flat: targets.append(Path(flat[flat.index("-o") + 1]))
            return original_popen(argv, *args, **kwargs)
        def mutate(path: Path):
            if fired[0]: return
            fired[0] += 1
            raw = path.read_bytes()
            document = strict_json(raw.decode("utf-8")); document["summary"] = "R6-" + kind
            replacement = json.dumps(document, separators=(",", ":")).encode()
            if kind == "path_swap":
                old = path.with_name(path.name + ".opened-object")
                path.rename(old); moved.append(old); path.write_bytes(replacement)
            elif kind == "growth":
                with original_builtin_open(path, "ab") as stream: stream.write(b" " * 4096)
            elif kind == "short":
                with original_builtin_open(path, "wb") as stream: stream.write(replacement)
            else:
                with original_builtin_open(path, "r+b") as stream:
                    stream.seek(0); stream.write(replacement); stream.truncate()
        class WrappedReader:
            def __init__(self, inner, path): self.inner, self.path = inner, path
            def __enter__(self): self.inner.__enter__(); return self
            def __exit__(self, *args): return self.inner.__exit__(*args)
            def __getattr__(self, name): return getattr(self.inner, name)
            def read(self, *args, **kwargs): mutate(self.path); return self.inner.read(*args, **kwargs)
            def readinto(self, *args, **kwargs): mutate(self.path); return self.inner.readinto(*args, **kwargs)
            def read1(self, *args, **kwargs): mutate(self.path); return self.inner.read1(*args, **kwargs)
            def readinto1(self, *args, **kwargs): mutate(self.path); return self.inner.readinto1(*args, **kwargs)
            def readline(self, *args, **kwargs): mutate(self.path); return self.inner.readline(*args, **kwargs)
            def readlines(self, *args, **kwargs): mutate(self.path); return self.inner.readlines(*args, **kwargs)
            def readall(self, *args, **kwargs): mutate(self.path); return self.inner.readall(*args, **kwargs)
            def __iter__(self): return self
            def __next__(self): mutate(self.path); return next(self.inner)
        def wrap_open(original, file, mode="r", *args, **kwargs):
            inner = original(file, mode, *args, **kwargs)
            try: path = Path(file).absolute()
            except Exception: return inner
            return WrappedReader(inner, path) if targets and path == targets[-1].absolute() and "r" in str(mode) else inner
        def io_open(file, mode="r", *args, **kwargs): return wrap_open(original_io_open, file, mode, *args, **kwargs)
        def builtin_open(file, mode="r", *args, **kwargs): return wrap_open(original_builtin_open, file, mode, *args, **kwargs)
        def os_open(path, flags, *args, **kwargs):
            fd = original_os_open(path, flags, *args, **kwargs)
            try: candidate = Path(path).absolute()
            except Exception: return fd
            if targets and candidate == targets[-1].absolute() and flags & os.O_ACCMODE == os.O_RDONLY:
                tracked_fds.add(fd)
            return fd
        def os_read(fd, count):
            if fd in tracked_fds and targets: mutate(targets[-1])
            return original_os_read(fd, count)
        def os_fdopen(fd, *args, **kwargs):
            inner = original_os_fdopen(fd, *args, **kwargs)
            return WrappedReader(inner, targets[-1]) if fd in tracked_fds and targets else inner
        def os_pread(fd, count, offset):
            if fd in tracked_fds and targets: mutate(targets[-1])
            return original_os_pread(fd, count, offset)
        def os_readv(fd, buffers):
            if fd in tracked_fds and targets: mutate(targets[-1])
            return original_os_readv(fd, buffers)
        def os_preadv(fd, buffers, offset, *args):
            if fd in tracked_fds and targets: mutate(targets[-1])
            return original_os_preadv(fd, buffers, offset, *args)
        module.subprocess.Popen = observe
        io.open = io_open; builtins.open = builtin_open
        os.open = os_open; os.read = os_read; os.fdopen = os_fdopen
        if original_os_pread is not None: os.pread = os_pread
        if original_os_readv is not None: os.readv = os_readv
        if original_os_preadv is not None: os.preadv = os_preadv
        try:
            outcome = attempt(attack_repo)
        finally:
            module.subprocess.Popen = original_popen
            io.open = original_io_open; builtins.open = original_builtin_open
            os.open = original_os_open; os.read = original_os_read; os.fdopen = original_os_fdopen
            if original_os_pread is not None: os.pread = original_os_pread
            if original_os_readv is not None: os.readv = original_os_readv
            if original_os_preadv is not None: os.preadv = original_os_preadv
        for path in moved:
            if path.exists(): path.unlink()
        return outcome, bool(targets)
    # R11 acceptance below is driven only by opened-object/value/promotion
    # effects.  The former API wrapper matrix is retained as dead adversarial
    # scaffolding for historical comparison but supplies no verdict authority.
    read_attacks = {}
    read_attacks_ok = True

    def reader_variant_effects() -> dict[str, bool]:
        fixture = work / "reader-variant-result"
        fixture.write_bytes(valid_canonical.read_bytes())
        expected = hashlib.sha256(fixture.read_bytes()).hexdigest()
        results = {}
        def accept(name, reader):
            before = fixture.stat(); raw = reader(); after = fixture.stat()
            results[name] = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) == \
                (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns) \
                and hashlib.sha256(raw).hexdigest() == expected \
                and canonical_result_valid(strict_json(raw.decode("utf-8")), schema_document)
        accept("fileio", lambda: io.FileIO(fixture, "r").read())
        accept("raw", lambda: open(fixture, "rb", buffering=0).read())
        def alias_read():
            fd = os.open(fixture, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)); alias = os.dup(fd)
            try:
                parts = []
                while True:
                    chunk = os.read(alias, 65536)
                    if not chunk: return b"".join(parts)
                    parts.append(chunk)
            finally: os.close(alias); os.close(fd)
        accept("fd_alias", alias_read)
        def mmap_read():
            with fixture.open("rb") as stream:
                with mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_READ) as view: return bytes(view)
        accept("mmap", mmap_read)
        def helper_read():
            with io.FileIO(fixture, "r") as stream: return stream.read(MAX_RESULT_BYTES + 1)
        accept("helper", helper_read)
        fixture.unlink()
        return results
    reader_variants = reader_variant_effects()
    reader_variants_ok = bool(reader_variants) and all(reader_variants.values())

    # The provider announces only the effect boundary (its sink has been
    # closed), then blocks.  At that causal point the gate opens the exact sink
    # nofollow, binds its dev+ino+digest and proves the canonical destination is
    # still absent.  Correctness never depends on parser/open/rename API names
    # or on catching a value during a polling interval.
    def causal_result_case(mode: str, second_promotion: bool = False,
                           sink_attack: str | None = None):
        effect_repo = make_repo(str(provider)); launched = threading.Event(); paths: dict[str, Path] = {}
        original = module.subprocess.Popen
        def popen(argv, *args, **kwargs):
