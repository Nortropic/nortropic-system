                def _r128_routing_topology(text):
                    try:
                        tree = ast.parse(text)
                    except (SyntaxError, TypeError, ValueError):
                        return False
                    functions = (ast.FunctionDef, ast.AsyncFunctionDef)
                    parent = {child: node for node in ast.walk(tree)
                              for child in ast.iter_child_nodes(node)}
                    defs = [node for node in ast.walk(tree) if isinstance(node, functions)]
                    def unique(name):
                        rows = [node for node in defs if node.name == name]
                        return rows[0] if len(rows) == 1 else None
                    def owner(node):
                        node = parent.get(node)
                        while node is not None and not isinstance(node, functions):
                            node = parent.get(node)
                        return node
                    def calls(name, root=tree):
                        return [node for node in ast.walk(root) if isinstance(node, ast.Call)
                                and isinstance(node.func, ast.Name) and node.func.id == name]
                    def argv(node):
                        return None if node.keywords else [ast.unparse(x) for x in node.args]
                    adapter, isolated, resolver, invoke, selftest = (
                        unique(name) for name in ("_run_codex_agent", "isolated_role_run",
                            "run_codex_resolving_architecture", "invoke", "selftest"))
                    if any(node is None or node.decorator_list for node in
                           (adapter, isolated, resolver, invoke, selftest)):
                        return False
                    names = ("run_codex", "_run_codex_agent",
                             "isolated_provider_scratch", "quarantine_provider_scratch")
                    groups = [calls(name) for name in names]
                    if any(len(group) != 1 for group in groups):
                        return False
                    direct, routed, scratch_call, quarantine = [group[0] for group in groups]
                    expected = ((direct, adapter, ["repo", "wt", "role", "prompt", "wt_root"]),
                        (routed, invoke, ["repo", "scratch", "invocation_role",
                                         "invocation_prompt", "wt_root"]),
                        (scratch_call, invoke, ["repo", "wt_root", "task_id",
                                                "scratch_role", "current"]),
                        (quarantine, invoke, ["repo", "scratch", "task_id",
                                              "scratch_role", "current"]))
                    admitted = {call.func for call, _scope, _args in expected}
                    if (owner(invoke) is not isolated
                            or any(owner(call) is not scope or argv(call) != values
                                   for call, scope, values in expected)
                            or any(node.id in names and (not isinstance(node.ctx, ast.Load)
                                   or node not in admitted) for node in ast.walk(tree)
                                   if isinstance(node, ast.Name))):
                        return False
                    scratch_assign = parent.get(scratch_call); routed_assign = parent.get(routed)
                    quarantine_expr = parent.get(quarantine)
                    scratch_stores = [node for node in ast.walk(invoke)
                        if isinstance(node, ast.Name) and node.id == "scratch"
                        and isinstance(node.ctx, ast.Store)]
                    tries = [node for node in invoke.body if isinstance(node, ast.Try)]
                    if (not isinstance(scratch_assign, ast.Assign)
                            or scratch_stores != scratch_assign.targets
                            or not isinstance(routed_assign, ast.Assign)
                            or [getattr(x, "id", None) for x in routed_assign.targets] != ["result"]
                            or not isinstance(quarantine_expr, ast.Expr)
                            or len(tries) != 1 or invoke.body[-1] is not tries[0]
                            or scratch_assign not in invoke.body
                            or invoke.body.index(scratch_assign) + 1 != invoke.body.index(tries[0])):
                        return False
                    guarded = tries[0]
                    if (guarded.handlers or guarded.orelse or guarded.body[:1] != [routed_assign]
                            or len(guarded.body) != 2 or not isinstance(guarded.body[1], ast.Return)
                            or ast.unparse(guarded.body[1].value) != "result"
                            or guarded.finalbody != [quarantine_expr]):
                        return False
                    resolver_calls = [call for call in calls("isolated_role_run")
                                      if owner(call) is resolver]
                    snapshots = calls("_python_snapshot", selftest)
                    runs = [call for call in calls("run", selftest) if call.args
                            and isinstance(call.args[0], ast.List)]
                    return (len(resolver.body) == len(resolver_calls) == 1
                        and isinstance(resolver.body[0], ast.Return)
                        and resolver.body[0].value is resolver_calls[0]
                        and argv(resolver_calls[0]) == ["repo", "wt_root", "wt", "task_id",
                            "branch(wt) or None", "role", "sha(wt)", "prompt", "stage", "context"]
                        and len(snapshots) == len(runs) == 1
                        and ast.unparse(snapshots[0]) == "_python_snapshot(audit_root)"
                        and [ast.unparse(x) for x in runs[0].args[0].elts] ==
                            ["str(python)", "'-I'", "'-S'",
                             "str(checker_root / 'controller/result/routing_ast.py')", "str(audited)"]
                        and [(x.arg, ast.unparse(x.value)) for x in runs[0].keywords]
                            == [("check", "False")])

                def _r128_helper_digest(text):
                    try:
                        tree = ast.parse(text)
                    except (SyntaxError, TypeError, ValueError):
                        return None
                    values = [node.value for node in ast.walk(tree)
                              if isinstance(node, ast.Constant) and isinstance(node.value, str)
                              and re.fullmatch(r"[0-9a-f]{64}", node.value)]
                    if len(values) != 1:
                        return None
                    digest = values[0]
                    canonical = ("import ast, hashlib, sys\n"
                        "tree = ast.parse(open(sys.argv[1], encoding=\"utf-8\").read(), mode=\"exec\")\n"
                        "actual = hashlib.sha256(ast.dump(tree, annotate_fields=True, include_attributes=False).encode(\"utf-8\")).hexdigest()\n"
                        f"if actual != \"{digest}\": raise SystemExit(\"ROUTING_AST=FAIL\")\n"
                        "print(\"ROUTING_AST=PASS\")\n")
                    return digest if ast.dump(tree, include_attributes=False) == ast.dump(
                        ast.parse(canonical), include_attributes=False) else None

                def _r128_routing_probe(controller_text, helper_text, label):
                    root = Path(_r125_tempfile.mkdtemp(prefix=f"r128-ast-{label}-", dir=_flow_root))
                    try:
                        candidate = root / "candidate.py"; helper = root / "routing_ast.py"
                        judge = root / "digest.py"
                        candidate.write_text(controller_text, encoding="utf-8")
                        helper.write_text(helper_text, encoding="utf-8")
                        judge.write_text("import ast,hashlib,sys\n"
                            "assert sys.version_info[:3]==(3,12,13)\n"
                            "t=ast.parse(open(sys.argv[1],encoding='utf-8').read(),mode='exec')\n"
                            "print(hashlib.sha256(ast.dump(t,annotate_fields=True,include_attributes=False).encode('utf-8')).hexdigest())\n",
                            encoding="utf-8")
                        python, _snapshot_digest = _auto._python_snapshot(root)
                        env = {"PATH": "/usr/bin:/bin", "HOME": "/var/empty",
                               "LANG": "C", "LC_ALL": "C"}
                        dig = subprocess.run([str(python), "-I", "-S", str(judge),
                            str(candidate)], env=env, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE)
                        run = subprocess.run([str(python), "-I", "-S", str(helper),
                            str(candidate)], env=env, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE)
                        value = dig.stdout.decode("ascii", "strict").strip()
                        return (value if dig.returncode == 0 and re.fullmatch(
                            r"[0-9a-f]{64}", value) else None,
                            run.returncode, run.stdout.decode("utf-8", "strict").strip())
                    except (OSError, UnicodeError, ValueError):
                        return (None, -1, "")
                    finally:
                        shutil.rmtree(root, ignore_errors=True)

                _routing_helper = source.parents[1] / "controller/result/routing_ast.py"
                _routing_text = _routing_helper.read_text(encoding="utf-8")
                _routing_probe = _r128_routing_probe(
                    _r125_controller_text, _routing_text, "positive")
                _auto.selftest()
                def _r128_once(text, old, new):
                    return text.replace(old, new, 1) if text.count(old) == 1 else ""
                _route = "        try:\n            result = _run_codex_agent(\n"
                _routing_mutants = (
                    _r128_once(_r125_controller_text, _route,
                        "        scratch = authority_wt\n" + _route),
                    _r128_once(_r125_controller_text, "def _run_codex_agent(repo:",
                        "@(lambda f: f)\ndef _run_codex_agent(repo:"),
                    _r128_once(_r125_controller_text, _route,
                        "        alias = _run_codex_agent\n        try:\n            result = alias(\n"),
                    _r128_once(_r125_controller_text, _route,
                        "        _run_codex_agent = run_codex\n" + _route),
                    _r128_once(_r125_controller_text, _route,
                        "        if False:\n            _run_codex_agent(repo, scratch, invocation_role, invocation_prompt, wt_root)\n" + _route),
                    _r128_once(_r125_controller_text,
                        'str(checker_root / "controller/result/routing_ast.py"), str(audited)',
                        "str(audited)"))
                _recomputed = []
                for _ordinal, _mutant in enumerate(_routing_mutants):
                    _digest = _r128_routing_probe(_mutant, _routing_text,
                        f"digest-{_ordinal}")[0] if _mutant else None
                    _helper = (_routing_text.replace(_r128_helper_digest(_routing_text), _digest)
                               if _digest and _r128_helper_digest(_routing_text) else "")
                    _probe = _r128_routing_probe(_mutant, _helper, f"mutant-{_ordinal}")
                    _recomputed.append(bool(_mutant and _probe[1:] == (0, "ROUTING_AST=PASS")
                                            and not _r128_routing_topology(_mutant)))
                _actual_digest = _r128_helper_digest(_routing_text)
                _helper_mutants = (_routing_text.replace(
                    f'actual != "{_actual_digest}"', "actual != actual"),
                    'print("ROUTING_AST=PASS")\n', "")
                _helper_results = [_r128_routing_probe(
                    _r125_controller_text, text, f"helper-{index}")[1:]
                    for index, text in enumerate(_helper_mutants)]
                _flow_ast_ownership = (
                    _r128_routing_topology(_r125_controller_text)
                    and _actual_digest == _routing_probe[0]
                    and _routing_probe[1:] == (0, "ROUTING_AST=PASS")
                    and all(_recomputed)
                    and all(_r128_helper_digest(text) is None for text in _helper_mutants)
                    and _helper_results == [(0, "ROUTING_AST=PASS"),
                                            (0, "ROUTING_AST=PASS"), (0, "")])

                _flow_profile_ok = (
                    _flow_source_closed(_launcher_text, _r125_controller_text)
                    and not _flow_source_closed(_launcher_text.replace(
                        '(require-not (subpath (param "WORKSPACE")))', '', 1),
                        _r125_controller_text)
                    and not _flow_source_closed(_launcher_text.replace(
                        'if not linked_live:', 'if linked_live:', 1),
                        _r125_controller_text)
                    and not _flow_source_closed(_launcher_text.replace(
                        'attempt_root not in staging.parents', 'False', 1),
                        _r125_controller_text)
                    and not _flow_source_closed(_launcher_text,
                        _r125_controller_text.replace(
                            'if wt_root is not None:', 'if True:', 1))
                    and not _flow_source_closed(_launcher_text,
                        _r125_controller_text.replace(
                            'run_codex(repo, wt, role, prompt, wt_root)',
                            'run_codex(repo, wt, role, prompt)', 1)))

                class _R128Capture(Exception):
                    pass

                class _R128A2Boundary(Exception):
                    pass

                def _flow_owned_root(path, parent):
                    try:
                        opened = Path(path).lstat()
                    except OSError:
                        return False
                    return (not Path(path).is_symlink()
                            and stat.S_ISDIR(opened.st_mode)
                            and stat.S_IMODE(opened.st_mode) == 0o700
                            and opened.st_uid == os.getuid()
                            and Path(path).resolve().parent == Path(parent).resolve())

                _flow_escape_source = (
                    "import os,sys,time\n"
                    "sink,workspace,attempt,branch,ref,odb,targets,stop=sys.argv[1:]\n"
                    "if os.fork()==0:\n"
                    " if os.fork()!=0: os._exit(0)\n"
                    " os.setsid();os.close(0);os.close(1);os.close(2);seen=set()\n"
                    " def note(label,path,verdict):\n"
                    "  key=(label,path,verdict)\n"
                    "  if key not in seen:\n"
                    "   seen.add(key);open(sink,'a').write(label+':'+path+'='+verdict+'\\n')\n"
                    " def attack(label,path):\n"
                    "  try: open(path,'a').write('R128\\n'); verdict='OK'\n"
                    "  except Exception: verdict='DENIED'\n"
                    "  note(label,path,verdict)\n"
                    " note('ENV','NORTROPIC_ATTEMPT_ROOT',"
                    "'LEAKED' if 'NORTROPIC_ATTEMPT_ROOT' in os.environ else 'ABSENT')\n"
                    " note('STATE','writer','ACTIVE')\n"
                    " for cycle in range(900):\n"
                    "  if os.path.exists(stop): break\n"
                    "  attack('SELF',os.path.join(workspace,'r128-self-write'))\n"
                    "  attack('ROOT',os.path.join(attempt,'r128-root-write'))\n"
                    "  attack('BRANCH',branch);attack('REF',ref);attack('ODB',odb)\n"
                    "  try:\n"
                    "   for root,dirs,_files in os.walk(attempt):\n"
                    "    for name in dirs:\n"
                    "     path=os.path.join(root,name)\n"
                    "     if path!=workspace and not path.startswith(workspace+os.sep):\n"
                    "      attack('CROSS',os.path.join(path,'r128-cross-write'))\n"
                    "  except Exception: pass\n"
                    "  try: dynamic=open(targets).read().splitlines()\n"
                    "  except Exception: dynamic=[]\n"
                    "  for path in dynamic: attack('TARGET',path)\n"
                    "  time.sleep(.02)\n"
                    " note('STATE','writer','DONE');os._exit(0)\n"
                    "os.wait();os._exit(0)\n")

                def _flow_wait(writer, token):
                    for _wait in range(160):
                        try:
                            if token in writer["sink"].read_text(encoding="utf-8"):
                                return True
                        except (FileNotFoundError, UnicodeDecodeError):
                            pass
                        time.sleep(0.025)
                    return False

                def _flow_start_writer(ctx, workspace, tag):
                    execution = ctx["execution_root"]
                    staging = execution / f"nortropic-result-rig-{tag}"
                    staging.mkdir(mode=0o700)
                    sink = staging / "result.json"; sink.write_text("", encoding="utf-8")
                    sink.chmod(0o600)
                    snapshot_root = execution / f"nortropic-provider-rig-{tag}"
                    snapshot_root.mkdir(mode=0o700)
                    snapshot = snapshot_root / "provider"
                    snapshot.write_bytes(b"R128 provider snapshot\n"); snapshot.chmod(0o500)
                    envelope = execution / f"envelope-{tag}.json"
                    envelope.write_text('{"task_id":"h-032-r128"}\n', encoding="utf-8")
                    prior = [item[key] for item in ctx["surfaces"]
                             for key in ("snapshot", "sink")]
                    targets = Path(workspace) / "r128-targets"
                    targets.write_text("".join(str(item) + "\n" for item in prior),
                                       encoding="utf-8")
                    stop = execution / f"stop-{tag}"
                    branch_target = ctx["branch_wt"] / "controller/result/consumer.py"
                    ref_target = Path(ctx["git"]) / "refs/heads" / ctx["branch"]
                    odb_target = Path(ctx["git"]) / "objects" / f"r128-{tag}-marker"
                    env = dict(os.environ, NORTROPIC_TRUST_ROOT=str(ctx["git"]),
                               NORTROPIC_ATTEMPT_ROOT=str(ctx["wt_root"]),
                               NORTROPIC_STAGING_ROOT=str(staging),
                               NORTROPIC_RESULT_SINK=str(sink))
                    leader = subprocess.run(
                        [str(launcher), "run", str(workspace), str(envelope), "30", "--",
                         sys.executable, "-c", _flow_escape_source, str(sink),
                         str(workspace), str(ctx["wt_root"]), str(branch_target),
                         str(ref_target), str(odb_target), str(targets), str(stop)],
                        cwd=source.parents[1], env=env,
                        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                    writer = {"workspace": Path(workspace).resolve(), "sink": sink,
                              "targets": targets, "stop": stop}
                    required = (
                        "ENV:NORTROPIC_ATTEMPT_ROOT=ABSENT",
                        "STATE:writer=ACTIVE",
                        f"SELF:{Path(workspace) / 'r128-self-write'}=OK",
                        f"ROOT:{ctx['wt_root'] / 'r128-root-write'}=DENIED",
                        f"BRANCH:{branch_target}=DENIED", f"REF:{ref_target}=DENIED",
                        f"ODB:{odb_target}=DENIED",
                        *(f"TARGET:{item}=DENIED" for item in prior))
                    if leader.returncode != 0 or not all(
                            _flow_wait(writer, item) for item in required):
                        raise AssertionError("R128 connected writer confinement failed")
                    ctx["writers"].append(writer)
                    for old in ctx["writers"][:-1]:
                        with old["targets"].open("a", encoding="utf-8") as stream:
                            stream.write(f"{snapshot}\n{sink}\n")
                    if not all(_flow_wait(old, f"TARGET:{item}=DENIED")
                               for old in ctx["writers"][:-1]
                               for item in (snapshot, sink)):
                        raise AssertionError("R128 future execution surface escaped")
                    ctx["surfaces"].append({"snapshot": snapshot, "sink": sink})
                    return writer

                def _flow_cross_denied(ctx, workspace):
                    marker = str(Path(workspace).resolve() / "r128-cross-write")
                    return all(writer["workspace"] == Path(workspace).resolve()
                               or _flow_wait(writer, f"CROSS:{marker}=DENIED")
                               for writer in ctx["writers"])

                def _flow_target_denied(ctx, gate_wt):
                    target = str(Path(gate_wt) / "controller/result/consumer.py")
                    for writer in ctx["writers"]:
                        with writer["targets"].open("a", encoding="utf-8") as stream:
                            stream.write(target + "\n")
                    return all(_flow_wait(writer, f"TARGET:{target}=DENIED")
                               for writer in ctx["writers"])

                def _flow_stop_writers(ctx):
                    for writer in ctx["writers"]:
                        try:
                            writer["stop"].write_text("stop\n", encoding="utf-8")
                        except OSError:
                            pass
                    return all(_flow_wait(writer, "STATE:writer=DONE")
                               for writer in ctx["writers"])

                def _flow_branch(ctx, expected):
                    rows = r128_worktree_rows(ctx["git"])
                    matches = [] if rows is None else [row for row in rows
                        if row.get("branch") == f"refs/heads/{ctx['branch']}"]
                    if len(matches) != 1:
                        return False
                    path = Path(matches[0]["worktree"]).resolve()
                    tree = r122_closed_git(
                        ctx["git"], "rev-parse", f"{expected}^{{tree}}",
                        check=False).stdout.decode().strip()
                    ctx["branch_wt"] = path
                    ctx["authority_root"] = path.parent
                    return r128_authority_worktree(
                        path, expected, tree, ctx["git"], path.parent, ctx["branch"])

                def _flow_gates_retired(ctx):
                    rows = r128_worktree_rows(ctx["git"])
                    return rows is not None and all(
                        not os.path.lexists(path) and not os.path.lexists(admin)
                        and all(Path(row.get("worktree", "")).resolve() != path
                                for row in rows)
                        for path, _head, admin in ctx["gates"][1:])

                def _flow_arm_hostile(ctx, scratch, delete=False):
                    scratch_text = os.path.abspath(os.fspath(scratch))
                    _r123_observer["forbid"] = (scratch_text,)
                    fds_clean = _r128_no_scratch_fds(scratch_text)
                    processes_clean = _r128_no_scratch_processes(scratch_text)
                    _r123_observer["forbid"] = ()
                    if delete:
                        shutil.rmtree(scratch)
                    else:
                        head = Path(scratch) / ".git/HEAD"; head.unlink(); os.mkfifo(head)
                    record = {"scratch": scratch_text, "events": [],
                              "fds_clean": fds_clean,
                              "processes_clean": processes_clean}
                    ctx["post"].append(record)
                    _r123_observer["events"] = record["events"]
                    _r123_observer["forbid"] = (record["scratch"],)

                def _flow_identity_rejects(ctx, scratch, expected, forbidden):
                    labels = ("extra-object", "objects-symlink", "config-hardlink",
                              "index-hardlink", "raw-ref-fifo", "checkout-hardlink")
                    if ctx["identity_rigs"]:
                        return
                    git_dir = Path(scratch) / ".git"
                    for index, label in enumerate(labels):
                        backup = ctx["root"] / f"identity-{index}"
                        parent_was = True
                        if label == "extra-object":
                            proc = r122_closed_git(git_dir, "hash-object", "--stdin",
                                                   input_bytes=b"R128 unreachable object\n")
                            oid = proc.stdout.decode().strip()
                            target = git_dir / "objects" / oid[:2] / oid[2:]
                            parent_was = target.parent.exists()
                            r122_closed_git(git_dir, "hash-object", "-w", "--stdin",
                                            input_bytes=b"R128 unreachable object\n")
                        elif label == "raw-ref-fifo":
                            target = git_dir / "refs/.r128-ghost"; os.mkfifo(target)
                        else:
                            target = ({"objects-symlink": git_dir / "objects",
                                       "config-hardlink": git_dir / "config",
                                       "index-hardlink": git_dir / "index",
                                       "checkout-hardlink": Path(scratch) /
                                           "controller/result/consumer.py"}[label])
                            target.rename(backup)
                            (os.symlink if label == "objects-symlink" else os.link)(backup, target)
                        rejected = r128_isolated_provider(
                            scratch, expected, ctx["git"], ctx["wt_root"], forbidden) is None
                        target.unlink()
                        if label not in {"extra-object", "raw-ref-fifo"}:
                            backup.rename(target)
                        elif label == "extra-object" and not parent_was:
                            target.parent.rmdir()
                        if not rejected:
                            return
                        ctx["identity_rigs"].append(label)
                    if r128_isolated_provider(
                            scratch, expected, ctx["git"], ctx["wt_root"], forbidden) is None:
                        ctx["identity_rigs"].clear()

                def _flow_release_observer(ctx):
                    _r123_observer["events"] = None
                    clean_post = True
                    for record in ctx["post"]:
                        _r123_observer["forbid"] = (record["scratch"],)
                        clean_post &= not any(_r128_forbidden_effect(args)
                                              for _event, args in record["events"])
                        clean_post &= (record["fds_clean"]
                                       and record["processes_clean"]
                                       and _r128_no_scratch_fds(record["scratch"])
                                       and _r128_no_scratch_processes(record["scratch"]))
                    _r123_observer["forbid"] = ()
                    return clean_post

                def _flow_agent(repo_arg, scratch, role, prompt, wt_root_arg):
                    ctx = _flow_context
                    ctx["post_clean"] &= _flow_release_observer(ctx)
                    if (repo_arg != ctx["repo"] or Path(wt_root_arg) != ctx["wt_root"]
                            or role not in {"BUILDER", "REVIEWER", "ARCHITECT"}
                            or not _flow_gates_retired(ctx)):
                        raise AssertionError("R128 provider authority mismatch")
                    expected = r128_git(
                        ctx["branch_wt"], "rev-parse", "HEAD").stdout.decode().strip()
                    if expected not in {r122_base_sha, _c1, _r128_c2}:
                        raise AssertionError("R128 provider received unknown authority")
                    attempt_root = ctx["wt_root"]
                    forbidden = set(r128_object_inodes(ctx["git"]) or ())
                    forbidden.update(ctx["scratch_inodes"])
                    inodes = r128_isolated_provider(
                        scratch, expected, ctx["git"], attempt_root, forbidden)
                    if inodes is None or Path(scratch).resolve() in ctx["scratches"]:
                        raise AssertionError("R128 provider scratch not isolated")
                    ctx["scratch_inodes"].update(inodes); ctx["scratches"].add(Path(scratch).resolve())
                    if not _flow_branch(ctx, expected) or not _flow_cross_denied(ctx, scratch):
                        raise AssertionError("R128 protected/provider sequencing mismatch")
                    ctx["agents"].append((role, expected, Path(scratch).resolve(), prompt))
                    if not ctx["refs_before"]:
                        ctx["refs_before"] = r128_refs(ctx["git"])
                        ctx["control_before"] = r128_control_state(
                            ctx["git"], ctx["authority_root"], ctx["branch_wt"], ctx["branch"])
                        ctx["objects_before"] = r123_object_ids(ctx["git"])
                        ctx["odb_before"] = r123_odb_binding(ctx["git"])
                        ctx["layout_before"] = r123_odb_layout(ctx["git"])
                    if ctx["mode"] == "positive":
                        if ctx["quarantine_rig"] is None:
                            ctx["quarantine_rig"] = _r128_quarantine_oracle_rig(scratch)
                        _flow_identity_rejects(ctx, scratch, expected, forbidden)
                        _flow_start_writer(ctx, scratch, f"role-{len(ctx['writers'])}")
                        if not all(_flow_cross_denied(ctx, item) for item in
                                   ctx["scratches"] | {ctx["linked_provider"]}):
                            raise AssertionError("isolated writer reached linked provider")
                    if ctx["mode"] == "nonzero":
                        _flow_arm_hostile(ctx, scratch)
                        raise _auto.Stop("R128 provider nonzero")
                    prior_roles = [item[0] for item in ctx["agents"][:-1]]
                    if ctx["mode"] == "positive" and not prior_roles:
                        report = {"role": "BUILDER", "outcome": "OWNER_DECISION_REQUIRED",
                                  "owner_decision_required": True,
