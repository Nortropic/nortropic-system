    r122_negatives["delete_symlink"] = r122_delta(_r122_delete_symlink)
    r122_negatives["delete_gitlink"] = r122_delta(_r122_delete_gitlink)
    _r122_base_link = r122_base / "controller/result/base-link"
    _r122_base_link.unlink(); _r122_base_link.write_bytes(b"regular replacement\n")
    _rg("add", "--", "controller/result/base-link")
    _r122_typechange_symlink = _rg(
        "diff", "--cached", "--binary", "--full-index", "--no-renames", "--",
        "controller/result/base-link").stdout
    _rg("reset", "-q", "--", "controller/result/base-link")
    _r122_base_link.unlink(); os.symlink("consumer.py", _r122_base_link)
    _r122_base_submodule = r122_base / "controller/result/base-submodule"
    _r122_base_submodule.write_bytes(b"regular replacement\n")
    _rg("add", "--", "controller/result/base-submodule")
    _r122_typechange_gitlink = _rg(
        "diff", "--cached", "--binary", "--full-index", "--no-renames", "--",
        "controller/result/base-submodule").stdout
    _rg("reset", "-q", "--", "controller/result/base-submodule")
    _r122_base_submodule.unlink()
    r122_negatives["typechange_symlink"] = r122_delta(_r122_typechange_symlink)
    r122_negatives["typechange_gitlink"] = r122_delta(_r122_typechange_gitlink)
    _bad64 = r122_delta(r122_ok_patch); _bad64["patch_b64"] = "@@notbase64@@"
    r122_negatives["bad_base64"] = _bad64
    r122_negatives_ok = all(r122_rejects(d) for d in r122_negatives.values())
    _r122_schema_report = dict(kernel_valid_report)
    _r122_schema_report["candidate_delta"] = r122_delta(r122_ok_patch)
    _r122_schema_bool = dict(_r122_schema_report)
    _r122_schema_bool["candidate_delta"] = dict(_r122_schema_report["candidate_delta"], version=True)
    _r122_schema_wrong = dict(_r122_schema_report)
    _r122_schema_wrong["candidate_delta"] = dict(_r122_schema_report["candidate_delta"], version=2)
    r122_schema_exact = (
        complete_schema_valid(_r122_schema_report, schema_document)
        and not complete_schema_valid(_r122_schema_bool, schema_document)
        and not complete_schema_valid(_r122_schema_wrong, schema_document))
    r122_symlink_reject = r122_rejects(r122_delta(
        b"diff --git a/controller/result/link b/controller/result/link\n"
        b"new file mode 120000\nindex 0000000000000000000000000000000000000000.." + r122_blob(b"target").encode() + b" 120000\n"
        b"--- /dev/null\n+++ b/controller/result/link\n@@ -0,0 +1 @@\n+target\n\\ No newline at end of file\n"))
    check("J_MATERIALIZE_RIG",
          r122_positive and r122_negatives_ok and r122_symlink_reject
          and r123_semantic_positive
          and r122_schema_exact and r122_identity_oracle_rig
          and r123_actual_args_rig and r123_clean_oracle_rig
          and r123_call_form_rig and r123_effect_oracle_rig
          and r123_controller_prelude_rig
          and r123_connected_effect_oracle_rig
          and r123_source_inventory_rig and r123_controller_source_rig
          and r125_definition_effect_rig and _r125_dependency_source_rig
          and _r123_hostile_reference_ok,
          f"positive={r122_positive} negatives_ok={r122_negatives_ok} "
          f"semantic_positive={r123_semantic_positive} "
          f"semantic_errors={_r123_semantic_errors} "
          f"symlink_reject={r122_symlink_reject} schema_exact={r122_schema_exact} "
          f"identity_oracle={r122_identity_oracle_rig} "
          f"actual_args_oracle={r123_actual_args_rig} "
          f"call_forms={r123_call_form_rig} "
          f"clean_oracle={r123_clean_oracle_rig} "
          f"effect_oracle={r123_effect_oracle_rig} "
          f"controller_prelude={r123_controller_prelude_rig} "
          f"connected_effects={r123_connected_effect_oracle_rig} "
          f"source_inventory={r123_source_inventory_rig} "
          f"controller_source={r123_controller_source_rig} "
          f"definition_effects={r125_definition_effect_rig} "
          f"dependency_source={_r125_dependency_source_rig} "
          f"closed_reference={_r123_hostile_reference_ok} "
          f"rejected={[k for k,d in r122_negatives.items() if r122_rejects(d)]}")

    # ---- K_LATE_SCRATCH_WRITE_HARMLESS_SUCCESS: a real provider subprocess
    # emits the artifact and a double-fork+setsid escapee survives its successful
    # leader, then writes live scratch LATE.  The caller consumes that exact result
    # and invokes materialization once; this is an ordered caller boundary, not a
    # disconnected integer/helper model. ----
    r122_scratch = r122 / "scratch"; (r122_scratch / "controller/result").mkdir(parents=True)
    (r122_scratch / "controller/result/materialize.py").write_text("# LEGIT-BUT-IRRELEVANT\n", encoding="utf-8")
    r122_inject = r122_scratch / "controller/result/late-injection.py"
    r122_result_file = r122 / "provider-result.json"
    r122_provider_source = (
        "import os,sys,time\n"
        "result,scratch,payload,exit_text=sys.argv[1:]\n"
        "open(result,'w').write(payload)\n"
        "if os.fork()==0:\n"
        "    if os.fork()!=0: os._exit(0)\n"
        "    os.setsid(); os.close(0); os.close(1); os.close(2); time.sleep(0.6)\n"
        "    open(scratch,'w').write('BACKDOOR = attacker()\\n'); os._exit(0)\n"
        "os.wait(); raise SystemExit(int(exit_text))\n")

    def r122_reference_caller(provider_rc, *, mutant_materialize_nonzero=False):
        calls = 0
        candidate = None
        try:
            r122_result_file.unlink()
        except FileNotFoundError:
            pass
        proc = subprocess.run(
            [sys.executable, "-c", r122_provider_source, str(r122_result_file),
             str(r122_inject), json.dumps(r122_delta(r122_ok_patch), sort_keys=True),
             str(provider_rc)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if proc.returncode == 0 or mutant_materialize_nonzero:
            calls += 1
            accepted = json.loads(r122_result_file.read_text(encoding="utf-8"))
            candidate = r122_run(accepted)
        return proc.returncode, calls, candidate

    try:
        _lrc, _lcalls, (_lc, _lt, _lch) = r122_reference_caller(0)
        _cc, _ct, _cch = r122_run(r122_delta(r122_ok_patch))       # independent scratch-free derivation
        r122_late_exact = (_lrc == 0 and _lcalls == 1 and _lt == _ct
                           and _lch == ["controller/result/materialize.py"])
    except MatReject:
        r122_late_exact = False
    for _w in range(30):
        if r122_inject.exists():
            break
        time.sleep(0.1)
    r122_escapee_wrote = r122_inject.exists()
    check("K_LATE_SCRATCH_WRITE_HARMLESS_SUCCESS",
          r122_late_exact and r122_escapee_wrote,
          f"artifact_exact_independent_tree={r122_late_exact} escapee_wrote_scratch={r122_escapee_wrote} "
          f"injected_path_present_in_scratch={r122_inject.exists()} "
          f"candidate_changed={_lch if r122_late_exact else None}")

    # ---- K_LATE_SCRATCH_WRITE_HARMLESS_NONZERO: the SAME real subprocess/result
    # caller boundary invokes materialization zero times after nonzero, creates no
    # candidate/ref/trusted residue, while a one-defect materialize-on-nonzero
    # caller is causally observed and rejected. ----
    _r122_refs_before = r123_git_control_snapshot(r122_base_git)
    _r122_objects_before = r123_object_ids(r122_base_git)
    _r122_odb_before = r123_odb_binding(r122_base_git)
    _r122_odb_layout_before = r123_odb_layout(r122_base_git)
    _nzrc, _nzcalls, _nzcandidate = r122_reference_caller(7)
    _r122_refs_after = r123_git_control_snapshot(r122_base_git)
    r122_nonzero_no_candidate = (
        _nzrc == 7 and _nzcalls == 0 and _nzcandidate is None
        and _r122_refs_after == _r122_refs_before
        and r123_object_ids(r122_base_git) == _r122_objects_before
        and r123_odb_binding(r122_base_git) == _r122_odb_before
        and r123_odb_layout(r122_base_git) == _r122_odb_layout_before
        and not any(r122_prot.iterdir()))
    _src, _scalls, _scandidate = r122_reference_caller(0)
    r122_success_candidate = (_src == 0 and _scalls == 1 and _scandidate is not None)
    _mrc, _mcalls, _mcandidate = r122_reference_caller(7, mutant_materialize_nonzero=True)
    r122_mutant_caught = (_mrc == 7 and _mcalls == 1 and _mcandidate is not None)
    check("K_LATE_SCRATCH_WRITE_HARMLESS_NONZERO",
          r122_nonzero_no_candidate and r122_success_candidate and r122_mutant_caught,
          f"nonzero_zero_invocation={r122_nonzero_no_candidate} success_one_invocation={r122_success_candidate} "
          f"materialize_on_nonzero_mutant_rejected={r122_mutant_caught}")

    # ---- K_MATERIALIZATION_AREA_PROVIDER_DENIED: the materialization surface
    # (private ODB, index, checkout, refs) is anchored beneath the trust root and
    # the REAL launcher Seatbelt DENIES a confined provider every write across it —
    # checkout bytes AND git metadata.  Disclosed paths; path secrecy gets no
    # credit.  ODÖMBART when nested sandbox-exec is refused, like K_G20. ----
    r122_area = trust / "r122-materialization"
    r122_area_odb = r122_area / "odb"; r122_area_idx = r122_area / "index"
    r122_area_wt = r122_area / "checkout"; r122_area_refs = r122_area / "odb" / "refs"
    r122_area_ws = r122 / "deny-ws"; r122_area_ws.mkdir()
    r122_area_staging = r122 / "deny-staging"; r122_area_staging.mkdir()
    r122_area_sink = r122_area_staging / "result.json"; r122_area_sink.write_text("", encoding="utf-8"); r122_area_sink.chmod(0o600)
    r122_area_env_file = r122 / "deny-envelope.json"; r122_area_env_file.write_text('{"task_id":"h-032"}\n', encoding="utf-8")
    r122_area_attack = (
        'set +e; '
        'printf x > "$1/odb/injected"; echo ODB=$?; '
        'printf x > "$1/index"; echo INDEX=$?; '
        'mkdir -p "$1/checkout" 2>/dev/null; printf x > "$1/checkout/injected.py"; echo CHECKOUT=$?; '
        'printf x > "$1/odb/refs/injected"; echo REFS=$?')
    r122_area_launch_env = dict(os.environ, NORTROPIC_TRUST_ROOT=str(trust),
                                NORTROPIC_STAGING_ROOT=str(r122_area_staging),
                                NORTROPIC_RESULT_SINK=str(r122_area_sink))
    # controller pre-creates the (empty) materialization surface under the trust root
    r122_area_odb.mkdir(parents=True); (r122_area_odb / "refs").mkdir()
    r122_area_denied_odom = False
    r122_area_run = subprocess.run(
        [str(launcher), "run", str(r122_area_ws), str(r122_area_env_file), "30", "--",
         "/bin/sh", "-c", r122_area_attack, "sh", str(r122_area)],
        cwd=source.parents[1], env=r122_area_launch_env, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    r122_area_out = r122_area_run.stdout
    if r122_area_run.returncode == 3 and "sandbox_apply: Operation not permitted" in r122_area_out:
        r122_area_denied_odom = True
        check("K_MATERIALIZATION_AREA_PROVIDER_DENIED", False,
              "ODÖMBART nested sandbox-exec förbjuden; owner-runner krävs")
    else:
        r122_area_lines = set(r122_area_out.splitlines())
        r122_area_denied = ({"ODB=1", "INDEX=1", "CHECKOUT=1", "REFS=1"}.issubset(r122_area_lines)
                            and not (r122_area_odb / "injected").exists()
                            and not r122_area_idx.exists()
                            and not (r122_area_wt / "injected.py").exists()
                            and not (r122_area_odb / "refs" / "injected").exists())
        check("K_MATERIALIZATION_AREA_PROVIDER_DENIED", r122_area_denied,
              f"rc={r122_area_run.returncode} lines={r122_area_out.strip().replace(chr(10), '|')} "
              f"surface={r122_area}")

    # ---- K_CANDIDATE_MATERIALIZATION_BOUNDARY: the PRODUCT must provide the
    # materialization kernel AND the real builder_flow must invoke it exactly once
    # after an accepted success, then use its durable candidate identity.  A
    # correct-but-dead controller/result/materialize.py is rejected.  On provider
    # nonzero the same real caller must invoke it zero times and produce no
    # candidate/ref/trusted residue.  This is the sole intended new RED while the
    # product is absent. ----
    r122_product_kernel = source.parents[1] / "controller" / "result" / "materialize.py"
    materialization_boundary_ok = False
    r122_boundary_detail = "product controller/result/materialize.py absent"

    def r123_clone_authoritative(destination):
        clone = subprocess.run(
            ["/usr/bin/git", "clone", "--no-local", "--no-hardlinks", "-q",
             str(r122_base), str(destination)],
            env={"PATH": "/usr/bin:/bin", "HOME": str(r122), "LANG": "C",
                 "LC_ALL": "C", "GIT_CONFIG_NOSYSTEM": "1",
                 "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_NO_REPLACE_OBJECTS": "1",
                 "GIT_ALTERNATE_OBJECT_DIRECTORIES": ""},
            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        git_dir = destination / ".git"
        if (clone.returncode != 0
                or r122_closed_git(git_dir, "rev-parse", "HEAD").stdout.decode().strip()
                    != r122_base_sha
                or r123_odb_binding(git_dir) is None
                or r123_odb_layout(git_dir) is None):
            raise RuntimeError("R123 fresh authoritative clone failed")
        return git_dir

    def r123_reachable_delta(git_dir, candidate, base):
        proc = r122_closed_git(
            git_dir, "rev-list", "--objects", candidate, "^" + base, check=False)
        if proc.returncode != 0:
            return None
        values = set()
        for line in proc.stdout.splitlines():
            token = line.split(b" ", 1)[0]
            if re.fullmatch(rb"[0-9a-f]{40}", token) is None:
                return None
            values.add(token.decode())
        return frozenset(values)

    def r128_git(cwd, *args, check=True):
        env = {
            "PATH": "/usr/bin:/bin", "HOME": str(r122), "TMPDIR": str(r122),
            "LANG": "C", "LC_ALL": "C", "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_TERMINAL_PROMPT": "0",
            "GIT_NO_REPLACE_OBJECTS": "1", "GIT_ALTERNATE_OBJECT_DIRECTORIES": "",
        }
        proc = subprocess.run(["/usr/bin/git", *args], cwd=str(cwd), env=env,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if check and proc.returncode != 0:
            raise MatReject(f"R128 git {args[0]} failed rc={proc.returncode}")
        return proc

    def r128_lexical_identity(path, kind=None):
        """Return a no-follow identity for one exact absolute spelling.

        realpath/Path.resolve are deliberately not an identity oracle here: a
        symlink alias must not become equivalent to the controller-owned path.
        Every existing component is lstat-bound before the leaf is credited.
        """
        try:
            raw = os.fspath(path)
            if isinstance(raw, bytes):
                raw = os.fsdecode(raw)
            if (not isinstance(raw, str) or not os.path.isabs(raw)
                    or os.path.normpath(raw) != raw):
                return None
            current = Path(raw).anchor
            identities = []
            for part in Path(raw).parts[1:]:
                current = os.path.join(current, part)
                opened = os.lstat(current)
                if stat.S_ISLNK(opened.st_mode):
                    return None
                identities.append((opened.st_dev, opened.st_ino, opened.st_mode,
                                   opened.st_uid, opened.st_gid, opened.st_nlink))
            if not identities:
                return None
            mode = identities[-1][2]
            if ((kind == "dir" and not stat.S_ISDIR(mode))
                    or (kind == "file" and not stat.S_ISREG(mode))):
                return None
            return (raw, tuple(identities))
        except (OSError, TypeError, ValueError, UnicodeError):
            return None

    def r128_exact_regular(path, expected=None):
        identity = r128_lexical_identity(path, "file")
        if identity is None:
            return None
        opened = identity[1][-1]
        try:
            raw = Path(identity[0]).read_bytes()
        except OSError:
            return None
        if (opened[3] != os.getuid() or opened[5] != 1
                or opened[2] & 0o022
                or (expected is not None and raw != expected)):
            return None
        return (identity, raw)

    def r128_strict_tree(root, allow_root=True):
        root_identity = r128_lexical_identity(root, "dir")
        if root_identity is None:
            return None
        rows = []
        try:
            stack = [(Path(root_identity[0]), "")]
            while stack:
                parent, prefix = stack.pop()
                for entry in sorted(os.scandir(parent), key=lambda item: item.name):
                    rel = entry.name if not prefix else prefix + "/" + entry.name
                    opened = entry.stat(follow_symlinks=False)
                    if (opened.st_uid != os.getuid() or opened.st_mode & 0o022
                            or stat.S_ISLNK(opened.st_mode)):
                        return None
                    if stat.S_ISDIR(opened.st_mode):
                        rows.append((rel, "D", opened.st_dev, opened.st_ino,
                                     opened.st_mode, opened.st_nlink))
                        stack.append((Path(entry.path), rel))
                    elif stat.S_ISREG(opened.st_mode) and opened.st_nlink == 1:
                        rows.append((rel, "F", opened.st_dev, opened.st_ino,
                                     opened.st_mode, opened.st_nlink,
                                     hashlib.sha256(Path(entry.path).read_bytes()).hexdigest()))
                    else:
                        return None
        except OSError:
            return None
        return (root_identity, tuple(rows)) if allow_root else tuple(rows)

    def r128_worktree_rows(git_dir):
        proc = r122_closed_git(
            git_dir, "worktree", "list", "--porcelain", check=False)
        if proc.returncode != 0:
            return None
        rows = []
        try:
            decoded = proc.stdout.decode("utf-8", "strict")
        except UnicodeDecodeError:
            return None
        for block in decoded.strip().split("\n\n"):
            if not block:
                continue
            row = {}
            for line in block.splitlines():
                key, _, value = line.partition(" ")
                if key in row:
                    return None
                row[key] = value
            keys = set(row)
            if keys not in ({"worktree", "HEAD", "branch"},
                            {"worktree", "HEAD", "detached"}):
                return None
            if (not os.path.isabs(row["worktree"])
                    or os.path.normpath(row["worktree"]) != row["worktree"]
                    or re.fullmatch(r"[0-9a-f]{40}", row["HEAD"]) is None
                    or ("detached" in row and row["detached"] != "")):
                return None
            rows.append(row)
        return tuple(rows)

    def r128_object_inodes(git_dir):
        root = Path(git_dir) / "objects"
        rows = set()
        try:
            root_opened = root.lstat()
            if (root.is_symlink() or not stat.S_ISDIR(root_opened.st_mode)
                    or root_opened.st_uid != os.getuid()
                    or root_opened.st_mode & 0o022):
                return None
            for path in root.rglob("*"):
                opened = path.lstat()
                if path.is_symlink() or opened.st_uid != os.getuid():
                    return None
                if stat.S_ISREG(opened.st_mode):
                    if opened.st_nlink != 1 or opened.st_mode & 0o022:
                        return None
                    rows.add((opened.st_dev, opened.st_ino))
                elif (not stat.S_ISDIR(opened.st_mode)
                      or opened.st_mode & 0o022):
                    return None
        except OSError:
            return None
        return frozenset(rows) if rows else None

    def r128_control_path_leak(git_dir, needle):
        root = Path(git_dir)
        try:
            root_opened = root.lstat()
            if (root.is_symlink() or not stat.S_ISDIR(root_opened.st_mode)
                    or root_opened.st_uid != os.getuid()
                    or root_opened.st_mode & 0o022):
                return True
            for path in root.rglob("*"):
                if path == root / "objects" or root / "objects" in path.parents:
                    continue
                opened = path.lstat()
                if (path.is_symlink() or opened.st_uid != os.getuid()
                        or opened.st_mode & 0o022
                        or (not stat.S_ISDIR(opened.st_mode)
                            and not stat.S_ISREG(opened.st_mode))):
                    return True
                if (stat.S_ISREG(opened.st_mode)
                        and (opened.st_nlink != 1 or opened.st_size > 1024 * 1024
                             or needle in path.read_bytes())):
                    return True
        except OSError:
            return True
        return False

    def r128_checkout_matches_tree(root, authority_git, expected):
        root = Path(root)
        actual = r128_git(root, "ls-files", "-s", "-z", check=False)
        wanted = r122_closed_git(
            authority_git, "ls-tree", "-r", "-z", "--full-tree",
            expected, check=False)
        if actual.returncode != 0 or wanted.returncode != 0:
            return False
        def parse(rows, index):
            result = []
            try:
                for raw in rows.split(b"\0"):
                    if not raw:
                        continue
                    meta, path = raw.split(b"\t", 1)
                    fields = meta.split()
                    mode, oid = fields[0], fields[1 if index else 2]
                    if index and fields[2] != b"0":
                        return None
                    result.append((mode, oid, path))
            except (IndexError, ValueError):
                return None
            return tuple(result)
        indexed = parse(actual.stdout, True); tree = parse(wanted.stdout, False)
        if indexed is None or indexed != tree:
            return False
        for mode, oid, raw_path in indexed:
            try:
                rel = raw_path.decode("utf-8", "strict")
                cursor = root
                for component in Path(rel).parts[:-1]:
                    cursor /= component; parent_opened = cursor.lstat()
                    if (not stat.S_ISDIR(parent_opened.st_mode)
                            or stat.S_ISLNK(parent_opened.st_mode)
                            or parent_opened.st_uid != os.getuid()):
                        return False
                leaf = root / rel; opened = leaf.lstat()
                if opened.st_uid != os.getuid():
                    return False
                if mode in {b"100644", b"100755"}:
                    if (not stat.S_ISREG(opened.st_mode) or opened.st_nlink != 1
                            or stat.S_IMODE(opened.st_mode)
                                != (0o755 if mode == b"100755" else 0o644)):
                        return False
                    payload = leaf.read_bytes()
                elif mode == b"120000":
                    if not stat.S_ISLNK(opened.st_mode):
                        return False
                    payload = os.fsencode(os.readlink(leaf))
                elif mode == b"160000":
                    if (not stat.S_ISDIR(opened.st_mode)
                            or any(os.scandir(leaf))):
                        return False
                    continue
                else:
                    return False
                git_oid = hashlib.sha1(
                    b"blob " + str(len(payload)).encode() + b"\0" + payload
                ).hexdigest().encode()
                if git_oid != oid:
                    return False
            except (OSError, UnicodeError):
                return False
        return True

    def r128_isolated_provider(path, expected, authority_git, attempt_root,
                               forbidden_inodes):
        raw_path = os.fspath(path); raw_attempt = os.fspath(attempt_root)
        path_identity = r128_lexical_identity(raw_path, "dir")
        attempt_identity = r128_lexical_identity(raw_attempt, "dir")
        if path_identity is None or attempt_identity is None:
            return None
        path = Path(path_identity[0]); attempt = Path(attempt_identity[0])
        opened = path_identity[1][-1]; attempt_opened = attempt_identity[1][-1]
        dotgit = path / ".git"
        git_identity = r128_lexical_identity(dotgit, "dir")
        head_file = r128_exact_regular(dotgit / "HEAD")
        config_file = r128_exact_regular(dotgit / "config")
        index_file = r128_exact_regular(dotgit / "index")
        if (git_identity is None or head_file is None or config_file is None
                or index_file is None):
            return None
        git_opened = git_identity[1][-1]
        if (path.parent.parent != attempt
                or opened.st_uid != os.getuid()
                or git_opened.st_uid != os.getuid()
                or attempt_opened.st_uid != os.getuid()
                or stat.S_IMODE(attempt_opened.st_mode) != 0o700
                or stat.S_IMODE(opened.st_mode) != 0o700
                or stat.S_IMODE(git_opened.st_mode) != 0o700):
            return None
        common = r128_git(path, "rev-parse", "--git-common-dir", check=False)
        top = r128_git(path, "rev-parse", "--show-toplevel", check=False)
        head = r128_git(path, "rev-parse", "HEAD", check=False)
        symbolic = r128_git(path, "symbolic-ref", "-q", "HEAD", check=False)
        refs = r128_git(path, "for-each-ref", "--format=%(refname)", check=False)
        remotes = r128_git(path, "remote", check=False)
        status = r128_git(path, "status", "--porcelain=v1", "--ignored=matching",
                          "--untracked-files=all", check=False)
        fsck = r128_git(path, "fsck", "--strict", "--no-reflogs", check=False)
        all_objects = r128_git(
            path, "cat-file", "--batch-all-objects", "--batch-check=%(objectname)",
            check=False)
        expected_objects = r122_closed_git(
            authority_git, "rev-list", "--objects", "--no-object-names",
            expected, check=False)
        if any(proc.returncode != 0 for proc in (
                common, top, head, refs, remotes, status, fsck,
                all_objects, expected_objects)):
            return None
        object_ids = set(expected_objects.stdout.splitlines())
        all_ids = set(all_objects.stdout.splitlines())
        if (not object_ids or len(object_ids) != len(expected_objects.stdout.splitlines())
                or any(re.fullmatch(rb"[0-9a-f]{40}", oid) is None
                       for oid in object_ids | all_ids)):
            return None
        config = r128_git(path, "config", "--local", "--null", "--list",
                          check=False).stdout.decode().split("\0")
        config_map = dict(record.split("\n", 1) for record in config if "\n" in record)
        forbidden_config = (set(config_map) - {
            "core.repositoryformatversion", "core.filemode", "core.bare",
            "core.logallrefupdates", "core.ignorecase", "core.precomposeunicode",
            "core.hookspath", "core.fsmonitor", "core.untrackedcache"})
        forbidden_metadata = [
            dotgit / "objects/info/alternates",
            dotgit / "objects/info/http-alternates", dotgit / "info/grafts",
            dotgit / "shallow",
        ]
        logs = dotgit / "logs"
        raw_refs = dotgit / "refs"
        raw_ref_tree = r128_strict_tree(raw_refs)
        inodes = r128_object_inodes(dotgit)
        auth_rows = r128_worktree_rows(authority_git)
        return inodes if (
            common.stdout == b".git\n" and top.stdout.decode().strip() == str(path)
            and head.stdout.decode().strip() == expected and symbolic.returncode != 0
            and not refs.stdout.strip() and not remotes.stdout.strip()
            and not status.stdout.strip() and object_ids == all_ids
            and not forbidden_config
            and config_map.get("core.logallrefupdates") == "false"
            and config_map.get("core.hookspath") == "/dev/null"
            and config_map.get("core.fsmonitor") == "false"
            and config_map.get("core.untrackedcache") == "false"
            and not any(os.path.lexists(item) for item in forbidden_metadata)
            and not any(dotgit.glob("objects/pack/*.promisor"))
            and not os.path.lexists(dotgit / "FETCH_HEAD")
            and not (logs.exists() and any(logs.rglob("*")))
            and not os.path.lexists(dotgit / "packed-refs")
            and raw_ref_tree is not None
            and not any(row[1] != "D" for row in raw_ref_tree[1])
            and not os.path.lexists(raw_refs / "replace")
            and not r128_control_path_leak(
                dotgit, os.fsencode(str(Path(authority_git).parent)))
            and r128_checkout_matches_tree(path, authority_git, expected)
            and inodes is not None and not (set(inodes) & set(forbidden_inodes))
            and auth_rows is not None
            and all(row.get("worktree") != str(path)
                    for row in auth_rows)) else None

    def r128_authority_worktree(path, expected, expected_tree, authority_git,
                                protected_root, branch_name):
        path_identity = r128_lexical_identity(path, "dir")
        protected_identity = r128_lexical_identity(protected_root, "dir")
        authority_identity = r128_lexical_identity(authority_git, "dir")
        if (path_identity is None or protected_identity is None
                or authority_identity is None):
            return False
        path = Path(path_identity[0]); protected = Path(protected_identity[0])
        authority_git = Path(authority_identity[0])
        marker = r128_exact_regular(path / ".git")
        if marker is None or not marker[1].startswith(b"gitdir: "):
            return False
        try:
            admin_text = marker[1][len(b"gitdir: "):].rstrip(b"\n").decode("utf-8")
        except UnicodeDecodeError:
            return False
        admin_identity = r128_lexical_identity(admin_text, "dir")
        if (admin_identity is None
                or Path(admin_text).parent != authority_git / "worktrees"):
            return False
        admin = Path(admin_text)
        admin_head = r128_exact_regular(admin / "HEAD")
        admin_gitdir = r128_exact_regular(
            admin / "gitdir", os.fsencode(str(path / ".git")) + b"\n")
        admin_common = r128_exact_regular(admin / "commondir", b"../..\n")
        admin_index = r128_exact_regular(admin / "index")
        if any(item is None for item in (
                admin_head, admin_gitdir, admin_common, admin_index)):
            return False
        common = r128_git(path, "rev-parse", "--git-common-dir", check=False)
        absolute = r128_git(path, "rev-parse", "--absolute-git-dir", check=False)
        head = r128_git(path, "rev-parse", "HEAD", check=False)
        tree = r128_git(path, "rev-parse", "HEAD^{tree}", check=False)
        symbolic = r128_git(path, "symbolic-ref", "-q", "HEAD", check=False)
        status = r128_git(path, "status", "--porcelain=v1", "--ignored=matching",
                          "--untracked-files=all", check=False)
        cached = r128_git(path, "diff-index", "--quiet", expected, "--", check=False)
        files = r128_git(path, "diff-files", "--quiet", check=False)
        rows = r128_worktree_rows(authority_git)
        matches = [] if rows is None else [row for row in rows
                    if row.get("worktree") == str(path)]
        branch_ref = None if branch_name is None else f"refs/heads/{branch_name}"
        return (path.parent == protected and common.returncode == 0
                and absolute.returncode == 0
                and common.stdout.decode().strip() == str(authority_git)
                and absolute.stdout.decode().strip() == str(admin)
                and head.returncode == tree.returncode == status.returncode == 0
                and head.stdout.decode().strip() == expected
                and tree.stdout.decode().strip() == expected_tree
                and not status.stdout.strip() and cached.returncode == files.returncode == 0
                and r128_checkout_matches_tree(path, authority_git, expected)
                and len(matches) == 1 and matches[0].get("HEAD") == expected
                and ((branch_ref is None and symbolic.returncode != 0
                      and admin_head[1] == expected.encode() + b"\n"
                      and "detached" in matches[0] and "branch" not in matches[0])
                     or (branch_ref is not None and symbolic.returncode == 0
                         and admin_head[1] == (b"ref: " + branch_ref.encode() + b"\n")
                         and symbolic.stdout.decode().strip() == branch_ref
                         and matches[0].get("branch") == branch_ref)))

    def r128_refs(git_dir):
        proc = r122_closed_git(
            git_dir, "for-each-ref", "--format=%(refname)%00%(objectname)",
            check=False)
        return (tuple(sorted(proc.stdout.splitlines()))
                if proc.returncode == 0 else None)

    def r128_cumulative_scope(git_dir, base, candidate):
        names = r122_closed_git(
            git_dir, "diff", "--name-only", "--no-renames", "-z",
            base, candidate, "--", check=False)
        nums = r122_closed_git(
            git_dir, "diff", "--numstat", "--no-renames", "-z",
            base, candidate, "--", check=False)
        paths = [value.decode() for value in names.stdout.split(b"\0") if value]
        additions = 0
        try:
            for row in (value for value in nums.stdout.split(b"\0") if value):
                added, _deleted, _path = row.split(b"\t", 2)
                additions += int(added)
        except (ValueError, UnicodeDecodeError):
            return False
        return (names.returncode == nums.returncode == 0
                and len(paths) <= R122_MAXF and additions <= R122_MAXL
                and all(any(fnmatch.fnmatchcase(path, pattern)
                            for pattern in R122_ALLOWED) for path in paths))

    def r128_regular_bytes(path, limit=8 * 1024 * 1024):
        path = Path(path)
        try:
            opened = path.lstat()
            raw = path.read_bytes()
        except OSError:
            return None
        return (raw if not path.is_symlink() and stat.S_ISREG(opened.st_mode)
                and opened.st_uid == os.getuid() and opened.st_nlink == 1
                and not opened.st_mode & 0o022 and len(raw) <= limit else None)

    def r128_control_state(git_dir, protected_root, branch_wt, branch_name):
        git_id = r128_lexical_identity(git_dir, "dir")
        branch_id = r128_lexical_identity(branch_wt, "dir")
        protected_id = r128_lexical_identity(protected_root, "dir")
        worktrees_id = r128_lexical_identity(Path(git_dir) / "worktrees", "dir")
        if any(item is None for item in (
                git_id, branch_id, protected_id, worktrees_id)):
            return None
        git_dir = Path(git_id[0]); branch_wt = Path(branch_id[0])
        protected = Path(protected_id[0])
        admin_proc = r128_git(branch_wt, "rev-parse", "--absolute-git-dir",
                              check=False)
        paths = {}
        try:
            admin = Path(admin_proc.stdout.decode().strip())
            admin_id = r128_lexical_identity(admin, "dir")
            if admin_id is None or admin.parent != git_dir / "worktrees":
                return None
            admin_rel = str(admin.relative_to(git_dir))
            protected_rel = str(protected.relative_to(git_dir))
            paths = {
                "branch_ref": git_dir / "refs/heads" / branch_name,
                "branch_log": git_dir / "logs/refs/heads" / branch_name,
                "head_log": admin / "logs/HEAD", "orig": admin / "ORIG_HEAD",
                "index": admin / "index", "admin": admin,
            }
        except (OSError, ValueError):
            return None
        raw = {name: r128_regular_bytes(path) for name, path in paths.items()
               if name not in {"admin", "index"}}
        if (admin_proc.returncode != 0
                or any(value is None for name, value in raw.items()
                       if name != "orig")):
            return None
        return {"snapshot": r123_git_control_snapshot(git_dir),
                "admin_rel": admin_rel, "protected_rel": protected_rel,
                "paths": paths, "raw": raw,
                "ids": (git_id, protected_id, branch_id, worktrees_id, admin_id),
                "rows": r128_worktree_rows(git_dir),
                "admin_tree": r128_strict_tree(admin)}

    def r128_ff_reflog(before, after, transitions):
        if not isinstance(before, bytes) or not isinstance(after, bytes) \
                or not after.startswith(before):
            return False
        lines = after[len(before):].splitlines(keepends=True)
        if len(lines) != len(transitions):
            return False
        pattern = re.compile(
            rb"^([0-9a-f]{40}) ([0-9a-f]{40}) [^\t\r\n]+\t"
            rb"merge ([0-9a-f]{40}): Fast-forward\n$")
        for line, (old, new) in zip(lines, transitions):
            match = pattern.fullmatch(line)
            if match is None or match.groups() != (
                    old.encode(), new.encode(), new.encode()):
                return False
        return True

    def r128_final_control(before, git_dir, protected_root, branch_wt,
                           branch_name, c0, c1, c2, c2_tree, gates):
        after = r128_control_state(git_dir, protected_root, branch_wt, branch_name)
        if (before is None or after is None
                or before["admin_rel"] != after["admin_rel"]
                or before["ids"] != after["ids"]):
            return False
        protected_rel = before["protected_rel"]
        mutable = {
            f"refs/heads/{branch_name}", f"logs/refs/heads/{branch_name}",
            f"{before['admin_rel']}/logs/HEAD",
            f"{before['admin_rel']}/ORIG_HEAD", f"{before['admin_rel']}/index",
        }
        def immutable(state):
            return tuple(row for row in state["snapshot"]
                if row[0] not in mutable
                and row[0] != protected_rel
                and not row[0].startswith(protected_rel + "/"))
        def admin_immutable(state):
            return tuple(row for row in state["admin_tree"][1]
                if row[0] not in {"index", "ORIG_HEAD", "logs/HEAD"})
        transitions = ((c0, c2),) if c1 is None else ((c0, c1), (c1, c2))
        paths = after["paths"]
        protected = Path(os.fspath(protected_root)); branch_wt = Path(os.fspath(branch_wt))
        try:
            entries = sorted(protected.iterdir())
        except OSError:
            return False
        dry = r128_git(branch_wt, "clean", "-nffdx", "--", ".", check=False)
        write_tree = r128_git(branch_wt, "write-tree", check=False)
        symbolic = r128_git(branch_wt, "symbolic-ref", "-q", "HEAD", check=False)
        return (
            immutable(before) == immutable(after)
            and admin_immutable(before) == admin_immutable(after)
            and before["protected_rel"] == after["protected_rel"]
            and entries == [branch_wt] and branch_wt.parent == protected
            and all(not os.path.lexists(path) and not os.path.lexists(admin)
                    for path, _head, admin in gates[1:])
            and after["raw"]["branch_ref"] == c2.encode() + b"\n"
            and after["raw"]["orig"] == (c0 if c1 is None else c1).encode() + b"\n"
            and r128_ff_reflog(before["raw"]["branch_log"],
                              after["raw"]["branch_log"], transitions)
            and r128_ff_reflog(before["raw"]["head_log"],
                              after["raw"]["head_log"], transitions)
            and write_tree.returncode == symbolic.returncode == dry.returncode == 0
            and write_tree.stdout.decode().strip() == c2_tree
            and symbolic.stdout.decode().strip() == f"refs/heads/{branch_name}"
            and not dry.stdout.strip()
            and r128_authority_worktree(
                branch_wt, c2, c2_tree, git_dir, protected, branch_name)
            and before["rows"] is not None and after["rows"] is not None
            and len(before["rows"]) == len(after["rows"])
            and all((old == new) or (
                    old.get("worktree") == new.get("worktree") == str(branch_wt)
                    and old.get("HEAD") == c0 and new.get("HEAD") == c2
                    and old.get("branch") == new.get("branch")
                        == f"refs/heads/{branch_name}")
                for old, new in zip(before["rows"], after["rows"])))

    if r122_product_kernel.exists():
        try:
            # One immutable-at-capture observer spans every product call.  Audit
            # tuples may retain caller-owned argv/env containers, so recursively
            # copy only exact built-in values at hook time.  pathlib's two
            # admitted stat predicates are wrapped before the product module is
            # imported; source validation forbids transferring either method.
            _r123_observer = {"events": None, "invalid": False, "forbid": (),
                              "processes": [], "control_roots": (), "control": []}
            _r123_path_type = type(Path("."))
            def _r123_freeze_audit(value):
                if type(value) in {str, bytes, int, float, bool, type(None)}:
                    return value
                if type(value) is tuple:
                    return tuple(_r123_freeze_audit(item) for item in value)
                if type(value) is list:
                    return [_r123_freeze_audit(item) for item in value]
                if type(value) is dict:
                    return {_r123_freeze_audit(key): _r123_freeze_audit(item)
                            for key, item in value.items()}
                if type(value) is _r123_path_type:
                    return os.path.realpath(os.fspath(value))
                raise TypeError("unfrozen audit value")
            _r123_selected_events = {
                "open", "os.chmod", "os.mkdir", "os.remove", "os.rmdir", "os.rename",
                "os.replace", "os.link", "os.symlink", "os.listdir",
                "os.scandir", "subprocess.Popen", "os.system",
                "os.posix_spawn", "os.fork", "os.forkpty", "pty.spawn"}
            def _r128_forbidden_effect(value):
                if isinstance(value, (str, bytes)):
                    decoded = os.path.abspath(os.fsdecode(value))
                    for root in _r123_observer["forbid"]:
                        if os.path.commonpath((decoded, root)) == root:
                            return True
                        physical = _r128_physical_path(decoded)
                        root_physical = _r128_physical_path(root)
                        if (physical is None or root_physical is None
                                or os.path.commonpath((physical, root_physical))
                                    == root_physical):
                            return True
                        try:
                            opened = _r128_os_original["stat"](decoded)
                        except OSError:
                            continue
                        if (opened.st_dev, opened.st_ino) in _r128_tree_inodes(root):
                            return True
                    return False
                if isinstance(value, (tuple, list)):
                    return any(_r128_forbidden_effect(item) for item in value)
                if isinstance(value, dict):
                    return any(_r128_forbidden_effect(item)
                               for pair in value.items() for item in pair)
                return False
            def _r123_product_audit(event, args):
                target = _r123_observer["events"]
                mutating = event in {"os.mkdir", "os.remove", "os.rmdir", "os.rename",
                                     "os.replace", "os.link", "os.symlink"}
                if event == "open" and len(args) > 2 and isinstance(args[2], int):
                    mutating = bool(args[2] & (os.O_WRONLY | os.O_RDWR | os.O_CREAT
                                               | os.O_TRUNC | os.O_APPEND))
                if mutating and _r123_observer["control_roots"]:
                    try:
                        frozen = _r123_freeze_audit(args)
                        paths = [os.path.abspath(os.fsdecode(item)) for item in args[:2]
                                 if isinstance(item, (str, bytes))]
                        if any(os.path.commonpath((path, root)) == root
                               for path in paths
                               for root in _r123_observer["control_roots"]):
                            _r123_observer["control"].append(
                                (event, frozen, target is _flow_audit_events))
                    except (TypeError, ValueError, OSError):
                        _r123_observer["invalid"] = True
                if target is None:
                    return
                if (event in _r123_selected_events
                        or event.startswith("os.exec")
                        or event.startswith("os.spawn")):
                    try:
                        target.append((event, _r123_freeze_audit(args)))
                        if _r128_forbidden_effect(args):
                            raise RuntimeError("post-provider scratch effect")
                    except (TypeError, ValueError, OverflowError):
                        _r123_observer["invalid"] = True
            sys.addaudithook(_r123_product_audit)
            _r128_os_names = ("stat", "lstat", "access", "readlink", "listdir",
                              "scandir", "open", "fstat", "read", "pread",
                              "fdopen", "fchdir")
            _r128_os_original = {name: getattr(os, name) for name in _r128_os_names}
            _r128_path_names = tuple(dict.fromkeys((
                "stat", "lstat", "exists", "resolve", "iterdir", "glob", "rglob",
                "read_bytes", "read_text", "open", "readlink", "samefile",
                "owner", "group", "walk",
                *(name for name in dir(Path) if name.startswith("is_")))))
            _r128_path_original = {name: getattr(Path, name) for name in _r128_path_names
                                   if hasattr(Path, name)}
            _r128_builtin_open, _r128_io_open = builtins.open, io.open
            _r128_fcntl, _r128_popen = fcntl.fcntl, subprocess.Popen

            def _r128_physical_path(value):
                try:
                    pending = list(Path(os.path.abspath(os.fsdecode(value))).parts[1:])
                    resolved = os.path.sep; links = 0
                    while pending:
                        part = pending.pop(0)
                        candidate = os.path.join(resolved, part)
                        try:
                            opened = _r128_os_original["lstat"](candidate)
                        except FileNotFoundError:
                            return os.path.normpath(os.path.join(
                                candidate, *pending))
                        if stat.S_ISLNK(opened.st_mode):
                            links += 1
                            if links > 40:
                                return None
                            target = _r128_os_original["readlink"](candidate)
                            target = (target if os.path.isabs(target)
                                      else os.path.join(resolved, target))
                            rebuilt = Path(os.path.normpath(target))
                            pending = list(rebuilt.parts[1:]) + pending
                            resolved = rebuilt.anchor
                        else:
                            resolved = candidate
                    return os.path.normpath(resolved)
                except (OSError, TypeError, ValueError, UnicodeError):
                    return None

            def _r128_tree_inodes(root):
                rows = set(); stack = [os.path.abspath(os.fspath(root))]
                try:
                    while stack and len(rows) <= 10000:
                        current = stack.pop()
                        opened = _r128_os_original["lstat"](current)
                        rows.add((opened.st_dev, opened.st_ino))
                        if stat.S_ISDIR(opened.st_mode):
                            stack.extend(entry.path for entry in
                                         _r128_os_original["scandir"](current))
                except (OSError, TypeError, ValueError):
                    return frozenset()
                return frozenset(rows) if len(rows) <= 10000 else frozenset()

            def _r128_fd_path(fd):
                if type(fd) is not int:
                    return None
                try:
                    raw = _r128_fcntl(fd, fcntl.F_GETPATH, b"\0" * 1024)
                    return os.path.abspath(os.fsdecode(raw.split(b"\0", 1)[0]))
                except (AttributeError, OSError, ValueError):
                    try:
                        return os.path.abspath(_r128_os_original["readlink"](
                            f"/proc/self/fd/{fd}"))
                    except OSError:
                        return None

            def _r128_guard(value, label):
                if type(value) is int:
                    path = _r128_fd_path(value)
                elif isinstance(value, (str, bytes)):
                    path = value
                else:
                    try:
                        path = os.fspath(value)
                    except TypeError as exc:
                        raise RuntimeError(
                            f"unbound filesystem observation: {label}") from exc
                if path is not None and _r128_forbidden_effect((path,)):
                    target = _r123_observer["events"]
                    if target is not None:
                        target.append((f"r128.guard.{label}", (os.fsdecode(path),)))
                    raise RuntimeError(f"post-provider scratch observation: {label}")

            def _r128_os_wrapper(name, function):
                def guarded(*args, **kwargs):
                    _r128_guard(args[0] if args else ".", f"os.{name}")
                    if kwargs.get("dir_fd") is not None:
                        _r128_guard(kwargs["dir_fd"], f"os.{name}.dir_fd")
                    return function(*args, **kwargs)
                return guarded

            def _r128_path_wrapper(name, function):
                def guarded(path_self, *args, **kwargs):
                    _r128_guard(path_self, f"Path.{name}")
                    if name == "samefile" and args:
                        _r128_guard(args[0], "Path.samefile.other")
                    return function(path_self, *args, **kwargs)
                return guarded

            def _r128_open_wrapper(label, function):
                def guarded(file, *args, **kwargs):
                    _r128_guard(file, label)
                    return function(file, *args, **kwargs)
                return guarded

            def _r128_fcntl_wrapper(fd, *args, **kwargs):
                _r128_guard(fd, "fcntl.fcntl")
                return _r128_fcntl(fd, *args, **kwargs)

            def _r128_inherited_fd_paths(kwargs):
                paths = []
                pass_fds = kwargs.get("pass_fds", ())
                try:
                    candidates = set(pass_fds)
                except TypeError:
                    return None
                if kwargs.get("close_fds", True) is False:
                    try:
                        directory = "/dev/fd" if os.path.isdir("/dev/fd") \
                            else "/proc/self/fd"
                        for entry in _r128_os_original["scandir"](directory):
                            if entry.name.isdecimal():
                                fd = int(entry.name)
                                if fd > 2 and os.get_inheritable(fd):
                                    candidates.add(fd)
                    except (OSError, ValueError):
                        return None
                for name in ("stdin", "stdout", "stderr"):
                    value = kwargs.get(name)
                    if type(value) is int and value >= 0:
                        candidates.add(value)
                for fd in candidates:
                    if type(fd) is not int or fd < 0:
                        return None
                    paths.append((fd, _r128_fd_path(fd)))
                return tuple(sorted(paths))

            def _r128_popen_wrapper(*args, **kwargs):
                argv = args[0] if args else kwargs.get("args")
                cwd = kwargs.get("cwd")
                effective_env = kwargs.get("env")
                if effective_env is None:
                    effective_env = dict(os.environ)
                inherited = _r128_inherited_fd_paths(kwargs)
                capabilities = {
                    "env": effective_env, "fds": inherited,
                    "pass_fds": kwargs.get("pass_fds", ()),
                    "close_fds": kwargs.get("close_fds", True),
                    "stdin": kwargs.get("stdin"), "stdout": kwargs.get("stdout"),
                    "stderr": kwargs.get("stderr"),
                }
                if inherited is None or _r128_forbidden_effect(
                        (argv, cwd, effective_env,
                         tuple(path for _fd, path in inherited))):
                    raise RuntimeError("process receives quarantined scratch capability")
                process = _r128_popen(*args, **kwargs)
                _r123_observer["processes"].append(
                    (process, _r123_freeze_audit(argv),
                     _r123_freeze_audit(cwd),
                     _r123_freeze_audit(capabilities)))
                return process

            for _name, _function in _r128_os_original.items():
                setattr(os, _name, _r128_os_wrapper(_name, _function))
            for _name, _function in _r128_path_original.items():
                setattr(Path, _name, _r128_path_wrapper(_name, _function))
            builtins.open = _r128_open_wrapper("builtins.open", _r128_builtin_open)
            io.open = _r128_open_wrapper("io.open", _r128_io_open)
            fcntl.fcntl = _r128_fcntl_wrapper
            subprocess.Popen = _r128_popen_wrapper

            def _r128_restore_observers():
                for name, function in _r128_os_original.items():
                    setattr(os, name, function)
                for name, function in _r128_path_original.items():
                    setattr(Path, name, function)
                builtins.open = _r128_builtin_open; io.open = _r128_io_open
                fcntl.fcntl = _r128_fcntl; subprocess.Popen = _r128_popen

            def _r128_no_scratch_fds(scratch):
                try:
                    entries = tuple(_r128_os_original["scandir"]("/dev/fd"))
                except OSError:
                    entries = tuple(_r128_os_original["scandir"]("/proc/self/fd"))
                return not any(entry.name.isdecimal()
                    and _r128_forbidden_effect((_r128_fd_path(int(entry.name)),))
                    for entry in entries)

            def _r128_no_scratch_processes(scratch):
                return all(process.poll() is not None
                    or not _r128_forbidden_effect((argv, cwd, capabilities))
                    for process, argv, cwd, capabilities
                    in _r123_observer["processes"])

            def _r128_quarantine_oracle_rig(scratch):
                saved_forbid = _r123_observer["forbid"]
                saved_events = _r123_observer["events"]
                scratch = os.path.abspath(os.fspath(scratch))
                fd = _r128_os_original["open"](scratch, os.O_RDONLY)
                fd_reject = False
                try:
                    _r123_observer["forbid"] = (scratch,)
                    fd_reject = not _r128_no_scratch_fds(scratch)
                finally:
                    os.close(fd); _r123_observer["forbid"] = ()
                process = subprocess.Popen(["/bin/sleep", "10"], cwd=scratch,
                                           stdout=subprocess.DEVNULL,
                                           stderr=subprocess.DEVNULL)
                authority = os.path.join(os.path.dirname(scratch),
                                         "r128-controller-authority")
                _r123_observer["forbid"] = (authority,)
                own_process_positive = _r128_no_scratch_processes(authority)
                process.terminate(); process.wait(timeout=5)
                alias_root = Path(scratch).parent / "r128-quarantine-alias"
                alias_file = Path(scratch).parent / "r128-quarantine-hardlink"
                target_file = Path(scratch) / "r128-alias-target"
                target_file.write_bytes(b"alias\n")
                os.symlink(scratch, alias_root); os.link(target_file, alias_file)
                _r123_observer["forbid"] = (scratch,)
                metadata = []
                for operation in (lambda: os.stat(scratch),
                                  lambda: Path(scratch).lstat(),
                                  lambda: Path(scratch).stat(),
                                  lambda: Path(scratch).resolve()):
                    try:
                        operation(); metadata.append(False)
                    except RuntimeError:
                        metadata.append(True)
                for operation in (lambda: Path(alias_root).resolve(),
                                  lambda: Path(alias_file).lstat()):
                    try:
                        operation(); metadata.append(False)
                    except RuntimeError:
                        metadata.append(True)
                fds_after = _r128_no_scratch_fds(scratch)
                _r123_observer["forbid"] = ()
                alias_root.unlink(); alias_file.unlink()
                nonforbidden = Path(scratch).parent.stat().st_uid == os.getuid()
                capability_results = []
                capability_file = Path(scratch) / "r128-capability"
                capability_file.write_bytes(b"capability\n")
                authority_file = Path(authority); authority_file.write_bytes(b"authority\n")
                inherited_fd = _r128_os_original["open"](authority_file, os.O_RDONLY)
                os.set_inheritable(inherited_fd, True)
                for kwargs in (
                        {"env": dict(os.environ, R128_AUTHORITY=authority)},
                        {"pass_fds": (inherited_fd,)},
                        {"close_fds": False}):
                    _r123_observer["forbid"] = ()
                    child = subprocess.Popen(
                        ["/bin/sleep", "10"], stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL, **kwargs)
                    _r123_observer["forbid"] = (authority,)
                    capability_results.append(
                        not _r128_no_scratch_processes(authority))
                    child.terminate(); child.wait(timeout=5)
                own_fd = _r128_os_original["open"](capability_file, os.O_RDONLY)
                neutral = subprocess.Popen(
                    ["/bin/sleep", "10"], cwd=scratch, pass_fds=(own_fd,),
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    env={"PATH": "/usr/bin:/bin", "R128_SCRATCH": scratch})
                neutral_positive = _r128_no_scratch_processes(authority)
                neutral.terminate(); neutral.wait(timeout=5)
                os.close(inherited_fd); os.close(own_fd); authority_file.unlink()
                _r123_observer["forbid"] = saved_forbid
                _r123_observer["events"] = saved_events
                return (fd_reject and fds_after and own_process_positive
                        and all(metadata) and all(capability_results)
                        and neutral_positive and nonforbidden)
