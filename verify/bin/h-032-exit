    tracked_identities: set[tuple[int, int, str]] = set()
    monitor_stop = threading.Event(); monitor_threads: list[threading.Thread] = []
    original_tracked_popen = module.subprocess.Popen
    def process_table():
        lines = subprocess.run(["/bin/ps", "-axo", "pid=,ppid=,lstart="], text=True,
                               stdout=subprocess.PIPE, check=True).stdout.splitlines()
        rows = {}
        for line in lines:
            parts = line.split()
            if len(parts) >= 7:
                try: rows[int(parts[0])] = (int(parts[1]), " ".join(parts[2:7]))
                except ValueError: pass
        return rows
    def monitor_family(root_pid: int):
        while not monitor_stop.is_set():
            rows = process_table(); family = {root_pid}; changed = True
            while changed:
                changed = False
                for pid, (ppid, started) in rows.items():
                    if ppid in family and pid not in family:
                        family.add(pid); changed = True
            for pid in family:
                if pid in rows: tracked_identities.add((pid, rows[pid][0], rows[pid][1]))
            time.sleep(0.01)
    def tracked_popen(argv, *args, **kwargs):
        process = original_tracked_popen(argv, *args, **kwargs)
        if "-o" in list(argv):
            rows = process_table()
            if process.pid in rows:
                tracked_identities.add((process.pid, rows[process.pid][0], rows[process.pid][1]))
            thread = threading.Thread(target=monitor_family, args=(process.pid,), daemon=True)
            monitor_threads.append(thread); thread.start()
        return process
    module.subprocess.Popen = tracked_popen
    try:
        tracked_interruption = result_case("interruption")
        def tracked_timeout_popen(argv, *args, **kwargs):
            changed = ["1" if value == "86400" else value for value in list(argv)]
            return tracked_popen(changed, *args, **kwargs)
        module.subprocess.Popen = tracked_timeout_popen
        tracked_timeout = result_case("timeout")
        module.subprocess.Popen = tracked_popen
        tracked_fork = result_case("fork_descendant")
    finally:
        module.subprocess.Popen = original_tracked_popen
        monitor_stop.set()
        for thread in monitor_threads: thread.join(timeout=1)
        launch_mode[0] = "valid"
    time.sleep(2.5)
    remaining_identities = []
    rows_after = process_table()
    for identity in tracked_identities:
        pid, _ppid, started = identity
        if pid in rows_after and rows_after[pid][1] == started: remaining_identities.append(identity)
    tracked_timeout_paths = tracked_timeout[1].get("_gate_output_paths", [])
    tracked_timeout_root = (Path(tracked_timeout_paths[-1]).parent
                            if tracked_timeout_paths else work)
    tracked_fork_paths = tracked_fork[1].get("_gate_output_paths", [])
    tracked_fork_root = Path(tracked_fork_paths[-1]).parent if tracked_fork_paths else work
    # R117 control 4: identity-bound quiescence, not admit/reject.  A confined +
    # killpg-on-success launcher legitimately ADMITS a fork-descendant run (its
    # staging write is denied and it is killed before cleanup), so PASS may not
    # require the fork run to be rejected.  Instead every bound pid+lstart
    # identity of the launched family must be ACTUALLY gone before the sample and
    # the staging must be residue-free; marker-absence or an observed killpg are
    # not sufficient on their own.  Interruption and timeout still reject cleanly.
    tracked_quiescent = (not tracked_interruption[0][0] and not tracked_timeout[0][0]
                         and bool(tracked_identities)
                         and not tracked_timeout_root.exists()
                         and not tracked_fork_root.exists()
                         and not remaining_identities)
    # A broken candidate may leave the deliberately escaped mutant alive.
    # Remove only identities emitted by this exact fixture after recording the
    # failed verdict; this cleanup is not part of the passing oracle.
    for pid, _ppid, started in remaining_identities:
        current = process_table().get(pid)
        if current and current[1] == started:
            try: os.kill(pid, signal.SIGKILL)
            except ProcessLookupError: pass

    # R116 CONTROL 03 — success-path same-group closed-stdio quiescence
    # (E167-REV-03, owner precision #4).  A descendant in the provider's OWN
    # process group, with closed stdio (so no inherited pipe keeps the launcher
    # blocked), that outlives the provider's NORMAL exit must be DEAD before
    # staging cleanup.  The verdict is identity-bound — the exact pid+lstart is
    # recorded while the family is still linked, then re-checked — never a bare or
    # reused PGID sample.  The current launcher killpg's only on timeout, so on a
    # normal success the descendant survives (RED); a launcher that killpg's the
    # group on SUCCESS leaves it dead (GREEN).
    def same_group_closed_stdio_case(mode: str):
        stop = threading.Event(); threads: list[threading.Thread] = []
        identities: set[tuple[int, int, str]] = set()
        original = module.subprocess.Popen
        def monitor(root_pid: int):
            while not stop.is_set():
                rows = process_table(); family = {root_pid}; changed = True
                while changed:
                    changed = False
                    for pid, (ppid, started) in rows.items():
                        if ppid in family and pid not in family:
                            family.add(pid); changed = True
                for pid in family:
                    if pid in rows:
                        identities.add((pid, rows[pid][0], rows[pid][1]))
                time.sleep(0.01)
        def observed_popen(argv, *args, **kwargs):
            process = original(argv, *args, **kwargs)
            if "-o" in list(argv):
                rows = process_table()
                if process.pid in rows:
                    identities.add((process.pid, rows[process.pid][0], rows[process.pid][1]))
                thread = threading.Thread(target=monitor, args=(process.pid,), daemon=True)
                threads.append(thread); thread.start()
            return process
        module.subprocess.Popen = observed_popen
        try:
            case = result_case(mode)
        finally:
            module.subprocess.Popen = original
            stop.set()
            for thread in threads:
                thread.join(timeout=1)
            launch_mode[0] = "valid"
        time.sleep(3.0)
        rows_after = process_table()
        remaining = [ident for ident in identities
                     if ident[0] in rows_after and rows_after[ident[0]][1] == ident[2]]
        paths = case[1].get("_gate_output_paths", [])
        root_path = Path(paths[-1]).parent if paths else work
        child_binding = (
            case[1].get("same_group_child_pid"),
            case[1].get("same_group_child_pgid"),
            case[1].get("provider_pgid"))
        # A failed verdict never earns cleanup credit. Remove only the exact
        # pid+lstart identities emitted by this disposable fixture afterward.
        for pid, _ppid, started in remaining:
            current = process_table().get(pid)
            if current and current[1] == started:
                try: os.kill(pid, signal.SIGKILL)
                except ProcessLookupError: pass
        return case, identities, remaining, root_path, child_binding

    sg_case, sg_identities, sg_remaining, sg_root, sg_child_binding = \
        same_group_closed_stdio_case("same_group_closed_stdio")
    (nonzero_sg_case, nonzero_sg_identities, nonzero_sg_remaining,
     nonzero_sg_root, nonzero_sg_child_binding) = \
        same_group_closed_stdio_case("same_group_closed_stdio_nonzero")
    (signal_sg_case, signal_sg_identities, signal_sg_remaining,
     signal_sg_root, signal_sg_child_binding) = \
        same_group_closed_stdio_case("same_group_closed_stdio_signal")
    def same_group_child_observed(binding, identities):
        child_pid, child_pgid, provider_pgid = binding
        return (type(child_pid) is int and child_pid > 0
            and type(child_pgid) is int and child_pgid > 0
            and type(provider_pgid) is int and provider_pgid > 0
            and child_pgid == provider_pgid
            and any(identity[0] == child_pid for identity in identities))
    # Success and the two independent provider-failure cases differ only in the
    # provider's terminal status. All three must observe the linked
    # launcher/provider/child family, prove every exact pid+lstart identity gone,
    # and finish without staging residue. Each provider failure additionally
    # must keep canonical absent and satisfy the same complete rejected-clean
    # predicate as every negative.
    success_quiescent_ok = (
        sg_case[0][0]
        and same_group_child_observed(sg_child_binding, sg_identities)
        and not sg_remaining
        and not sg_root.exists())
    def failed_same_group_quiescent(case, expected_mode, identities,
                                    remaining, root_path, child_binding):
        return (not case[0][0]
            and case[0][1].startswith(
                "Stop:Codex role TEST_AUTHOR failed rc=4;")
            and case[1].get("mode") == expected_mode
            and rejected_clean(case)
            and same_group_child_observed(child_binding, identities)
            and not remaining
            and not root_path.exists())
    nonzero_quiescent_ok = failed_same_group_quiescent(
        nonzero_sg_case, "same_group_closed_stdio_nonzero",
        nonzero_sg_identities, nonzero_sg_remaining, nonzero_sg_root,
        nonzero_sg_child_binding)
    signal_quiescent_ok = failed_same_group_quiescent(
        signal_sg_case, "same_group_closed_stdio_signal",
        signal_sg_identities, signal_sg_remaining, signal_sg_root,
        signal_sg_child_binding)

    def object_attack(kind: str):
        attack_repo = make_repo(str(provider))
        seeded: list[Path] = []
        moved_parents: list[Path] = []
        precreated: list[tuple[bool,int,int]] = []
        target_guard = work / f"object-attack-{kind}-guard"
        target_guard.write_text("guard", encoding="utf-8")
        original = module.subprocess.Popen
        def inject(argv, *args, **kwargs):
            flat = list(argv)
            if "-o" not in flat:
                return original(argv, *args, **kwargs)
            index = flat.index("-o")
            target = Path(flat[index + 1]); target.parent.mkdir(parents=True, exist_ok=True)
            opened=target.lstat()
            precreated.append((stat.S_ISREG(opened.st_mode),opened.st_nlink,
                               stat.S_IMODE(opened.st_mode)))
            if kind != "parent_swap": target.unlink()
            if kind == "symlink": target.symlink_to(target_guard)
            elif kind == "directory": target.mkdir()
            elif kind == "hardlink": os.link(target_guard, target)
            elif kind == "fifo": os.mkfifo(target, 0o600)
            elif kind == "socket":
                sock = socket.socket(socket.AF_UNIX); sock.bind(str(target)); sock.close()
            elif kind == "parent_swap":
                moved = target.parent.with_name(target.parent.name + "-moved")
                target.parent.rename(moved); moved_parents.append(moved); target.parent.mkdir()
            else: raise RuntimeError(kind)
            seeded.append(target)
            return original(["1" if value == "86400" else value for value in flat], *args, **kwargs)
        module.subprocess.Popen = inject
        prior_mode=launch_mode[0];launch_mode[0]="missing"
        try:
            outcome = attempt(attack_repo)
        finally:
            module.subprocess.Popen = original
            launch_mode[0]=prior_mode
        intact = target_guard.read_text(encoding="utf-8") == "guard"
        for path in seeded:
            if path.is_symlink() or (path.exists() and not path.is_dir()): path.unlink()
            elif path.is_dir(): path.rmdir()
        for path in moved_parents:
            if path.exists(): shutil.rmtree(path)
        residue_free = (not any(path.exists() or path.is_symlink() for path in seeded)
                        and not any(path.exists() for path in moved_parents))
        return outcome, len(seeded) == 1, intact, residue_free, precreated
    object_attacks = {kind: object_attack(kind) for kind in
                      ("symlink", "directory", "hardlink", "fifo", "socket", "parent_swap")}
    def object_residue_acceptable(kind, residue) -> bool:
        # R117 control 5: an object-substitution attack must leave no residue —
        # EXCEPT a parent_swap, whose non-bound empty replacement directory the
        # finalizer must PRESERVE (control 01: no blind deletion of a non-bound
        # object).  A preserved replacement is acceptable ONLY when it is exactly
        # an empty, non-symlink directory (no private-family content); any file,
        # non-empty directory or symlink residue stays RED.  The moved BOUND
        # staging object is separately required absent by residue_free (value[3]),
        # and a blind-deleting finalizer is caught by control 01, so those stay RED.
        if not residue:
            return True
        if kind != "parent_swap":
            return False
        for entry in residue:
            path = Path(entry)
            try:
                if (path.is_symlink() or not path.is_dir()
                        or any(True for _ in path.iterdir())):
                    return False
            except OSError:
                return False
        return True
    object_attacks_ok = all(not value[0][0]
                            and object_residue_acceptable(kind, value[0][4])
                            and value[1] and value[2] and value[3]
                            and value[4]==[(True,1,0o600)]
                            for kind, value in object_attacks.items())

    def r109_call_name(node: ast.AST) -> str | None:
        return node.id if isinstance(node, ast.Name) else None

    def r109_direct_calls(node: ast.AST, capability: str) -> list[ast.Call]:
        return [candidate for candidate in ast.walk(node)
                if isinstance(candidate, ast.Call)
                and r109_call_name(candidate.func) == capability]

    def r109_top_level_helpers(tree: ast.Module) -> dict[str, ast.FunctionDef]:
        helpers: dict[str, ast.FunctionDef] = {}
        for node in tree.body:
            if isinstance(node, ast.FunctionDef) and node.name != "run_codex":
                helpers[node.name] = node
        return helpers

    def r109_statement_calls_capability(statement: ast.stmt, capability: str,
                                        helpers: dict[str, ast.FunctionDef]) -> bool:
        if r109_direct_calls(statement, capability):
            return True
        called = {r109_call_name(call.func) for call in ast.walk(statement)
                  if isinstance(call, ast.Call)}
        relays = [helper for name, helper in helpers.items() if name in called
                  and len(r109_direct_calls(helper, capability)) == 1]
        return len(relays) == 1

    def r109_transform_tree(raw_source: str, ordering: str):
        """Bounded structural move of the existing consume effect around cleanup.

        This is deliberately not a Python interpreter.  It admits one run_codex
        try/finally, one consumer capability (directly or through one Python
        helper), and one cleanup capability in that finalizer.  The existing
        cleanup statements are never copied: the publication slice is moved
        across them and the existing fd-close slice is moved to an inner finally.
        """
        try:
            tree = ast.parse(raw_source)
        except (SyntaxError, ValueError):
            return None, {"seam_present": False, "transform_available": False,
                          "reason": "parse"}
        functions = [node for node in tree.body
                     if isinstance(node, ast.FunctionDef) and node.name == "run_codex"]
        if len(functions) != 1:
            return None, {"seam_present": False, "transform_available": False,
                          "reason": "run_codex-cardinality"}
        function = functions[0]
        helpers = r109_top_level_helpers(tree)
        consumer_calls = r109_direct_calls(function, "consume_private_result")
        helper_relays = {
            name for name, helper in helpers.items()
            if len(r109_direct_calls(helper, "consume_private_result")) == 1
        }
        helper_call_sites = [call for call in ast.walk(function)
                             if isinstance(call, ast.Call)
                             and r109_call_name(call.func) in helper_relays]
        cleanup_calls = r109_direct_calls(function, "_cleanup_result_staging")
        # Consumer capability presence is independent of whether the cleanup
        # prerequisite exists.  Cleanup cardinality belongs only to transform
        # availability; otherwise consumer=1/cleanup=0 would falsely be ABSENT.
        seam_present = bool(consumer_calls or helper_call_sites)
        facts = {"seam_present": seam_present, "transform_available": False,
                 "consumer_sites": len(consumer_calls) + len(helper_call_sites),
                 "cleanup_sites": len(cleanup_calls), "reason": "shape"}
        if not seam_present or len(consumer_calls) + len(helper_call_sites) != 1 \
                or len(cleanup_calls) != 1:
            return None, facts
        outer_tries = [node for node in function.body if isinstance(node, ast.Try)
                       and any(call is cleanup_calls[0] for call in ast.walk(node))]
        if len(outer_tries) != 1:
            return None, facts
        outer_try = outer_tries[0]
        publication_indices = [index for index, statement in enumerate(outer_try.body)
                               if r109_statement_calls_capability(
                                   statement, "consume_private_result", helpers)]
        if len(publication_indices) != 1:
            return None, facts
        publication_index = publication_indices[0]
        publication_statement = outer_try.body[publication_index]

        # The return value is either assigned by the publication statement and
        # returned once later, or is the direct return expression itself.
        result_name = "__h032_r109_accepted"
        moved: list[ast.stmt]
        return_statement: ast.Return
        remove_through = publication_index
        if isinstance(publication_statement, ast.Return):
            if publication_statement.value is None:
                return None, facts
            moved = [ast.Assign(targets=[ast.Name(id=result_name, ctx=ast.Store())],
                                value=publication_statement.value)]
            return_statement = ast.Return(value=ast.Name(id=result_name, ctx=ast.Load()))
        else:
            moved = [publication_statement]
            later_returns = [(index, statement) for index, statement
                             in enumerate(outer_try.body[publication_index + 1:],
                                          publication_index + 1)
                             if isinstance(statement, ast.Return)]
            if len(later_returns) != 1 or later_returns[0][1].value is None:
                return None, facts
            return_index, original_return = later_returns[0]
            # Only simple flag assignments may sit between publication and return;
            # they move with the publication effect without depending on spelling.
            middle = outer_try.body[publication_index + 1:return_index]
            if any(not isinstance(statement, ast.Assign) for statement in middle):
                return None, facts
            moved.extend(middle)
            return_statement = original_return
            remove_through = return_index

        # The publication slice must be terminal within the try body.  This keeps
        # the transform local and prevents interpreting arbitrary later flow.
        if remove_through != len(outer_try.body) - 1:
            return None, facts
        pending_name = "__h032_r109_publish_pending"
        outer_try.body[publication_index:] = [
            ast.Assign(targets=[ast.Name(id=pending_name, ctx=ast.Store())],
                       value=ast.Constant(value=True))]
        function.body.insert(function.body.index(outer_try), ast.Assign(
            targets=[ast.Name(id=pending_name, ctx=ast.Store())],
            value=ast.Constant(value=False)))

        close_indices = [index for index, statement in enumerate(outer_try.finalbody)
                         if any(isinstance(call, ast.Call)
                                and r109_call_name(call.func) is None
                                and isinstance(call.func, ast.Attribute)
                                and isinstance(call.func.value, ast.Name)
                                and call.func.value.id == "os"
                                and call.func.attr == "close"
                                for call in ast.walk(statement))]
        if len(close_indices) != 1:
            return None, facts
        close_statement = outer_try.finalbody.pop(close_indices[0])
        publish_guard = ast.If(
            test=ast.Name(id=pending_name, ctx=ast.Load()), body=moved, orelse=[])

        if ordering == "cleanup_before":
            ordered_body = outer_try.finalbody + [publish_guard]
        elif ordering == "publish_before":
            ordered_body = [publish_guard] + outer_try.finalbody
        elif ordering == "disconnected":
            ordered_body = [publish_guard, ast.If(
                test=ast.Constant(value=False), body=outer_try.finalbody, orelse=[])]
        else:
            raise RuntimeError(f"unsupported R109 ordering: {ordering}")
        outer_try.finalbody = [ast.Try(body=ordered_body, handlers=[], orelse=[],
                                      finalbody=[close_statement])]
        function.body.insert(function.body.index(outer_try) + 1, return_statement)
        facts.update({"transform_available": True, "reason": "ok",
                      "helper_relay": bool(helper_call_sites),
                      "helper_names": sorted(
                          {r109_call_name(call.func) for call in helper_call_sites}),
                      "publication_node": type(publication_statement).__name__,
                      "transformed_cleanup_sites": len(r109_direct_calls(
                          function, "_cleanup_result_staging"))})
        ast.fix_missing_locations(tree)
        return tree, facts

    def r109_compile_run_codex(raw_source: str, ordering: str,
                               namespace: dict[str, object]):
        tree, facts = r109_transform_tree(raw_source, ordering)
        if tree is None:
            return None, False, facts
        functions = [node for node in tree.body
                     if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
                     and node.name == "run_codex"]
        if len(functions) != 1 or not isinstance(functions[0], ast.FunctionDef):
            return None, False, facts
        helper_names = set(facts.get("helper_names", []))
        helper_defs = [node for node in tree.body
                       if isinstance(node, ast.FunctionDef)
                       and node.name in helper_names]
        compiled_tree = ast.Module(body=helper_defs + [functions[0]], type_ignores=[])
        ast.fix_missing_locations(compiled_tree)
        variant_namespace = dict(namespace)
        exec(compile(compiled_tree, f"<h032-r109-{ordering}>", "exec"),
             variant_namespace)
        function = variant_namespace.get("run_codex")
        return (function if callable(function) else None,
                integration_structure_inventory(tree)[0], facts)

    # Unconditional source/effect sensitivity.  Product credit still comes
    # only from the connected full-attempt cases below.
    r109_fixture_source = '''def run_codex(repo, wt, role, prompt):
        global _LAST_AGENT_CONTEXT
        result_root = "private-root"
        result_root_identity = (1, 2)
        result = "canonical"
        sink_fd = 3
        invocation_id = "i"
        run_id = "r"
        canonical_published = False
        try:
            _LAST_AGENT_CONTEXT = (None, None, result)
            accepted = consume_private_result(sink_fd, result, invocation_id, run_id, role)
            canonical_published = True
            return accepted
        finally:
            if sink_fd >= 0:
                try:
                    os.close(sink_fd)
                except OSError:
                    pass
            result_residue = []
            result_cleanup_degraded = False
            if result_root is not None and result_root_identity is not None:
                result_residue, result_cleanup_degraded = _cleanup_result_staging(
                    result_root, result_root_identity)
            cleanup_incomplete = bool(result_residue) or result_cleanup_degraded
            if cleanup_incomplete and canonical_published:
                rollback()
            if cleanup_incomplete:
                raise Stop("private execution staging cleanup incomplete")
'''
    def r109_fixture_effect(source: str, ordering: str,
                           namespace_extra: dict[str, object] | None = None):
        events: list[str] = []
        class FixtureStop(Exception): pass
        namespace: dict[str, object] = {
            "_LAST_AGENT_CONTEXT": None,
            "OSError": OSError,
            "Stop": FixtureStop,
            "os": type("FixtureOS", (), {"close": staticmethod(lambda unused: None)}),
            "rollback": lambda: events.append("rollback"),
            "_cleanup_result_staging": lambda *unused: (events.append("cleanup") or ([], True)),
            "consume_private_result": lambda *unused: (events.append("publish") or {"ok": True}),
        }
        if namespace_extra:
            namespace.update(namespace_extra)
        function, _inventory, facts = r109_compile_run_codex(source, ordering, namespace)
        stopped = False
        try:
            if function is None:
                return tuple(events), False, facts
            function(None, None, "TEST_AUTHOR", "H032")
        except FixtureStop:
            stopped = True
        return tuple(events), stopped, facts
    r109_fixture_effects = {
        ordering: r109_fixture_effect(r109_fixture_source, ordering)
        for ordering in ("cleanup_before", "publish_before", "disconnected")}
    r109_source_ordering_rig_ok = (
        r109_fixture_effects["cleanup_before"][:2] == (("cleanup",), True)
        and r109_fixture_effects["publish_before"][:2]
            == (("publish", "cleanup", "rollback"), True)
        and r109_fixture_effects["disconnected"][:2] == (("publish",), False)
        and all(effect[2].get("transform_available") is True
                for effect in r109_fixture_effects.values()))

    r109_local_rename_source = r109_fixture_source.replace(
        "accepted = consume_private_result", "delivered = consume_private_result"
    ).replace("return accepted", "return delivered")
    r109_direct_return_source = r109_fixture_source.replace(
        '''            accepted = consume_private_result(sink_fd, result, invocation_id, run_id, role)
            canonical_published = True
            return accepted''',
        '''            return consume_private_result(
                sink_fd, result, invocation_id, run_id, role)''')
    r109_helper_relay_source = (
        '''def publish_result(fd, destination, invocation, run, current_role):
    return consume_private_result(fd, destination, invocation, run, current_role)

''' + r109_fixture_source.replace(
        "consume_private_result(sink_fd, result, invocation_id, run_id, role)",
        "publish_result(sink_fd, result, invocation_id, run_id, role)"))
    r109_try_relay_source = r109_fixture_source.replace(
        '''            accepted = consume_private_result(sink_fd, result, invocation_id, run_id, role)
            canonical_published = True''',
        '''            try:
                accepted = consume_private_result(
                    sink_fd, result, invocation_id, run_id, role)
            except RuntimeError:
                raise
            finally:
                publication_finally_marker()
            canonical_published = True''')
    r109_legitimate_sources = {
        "local_rename": (r109_local_rename_source, {}),
        "direct_return": (r109_direct_return_source, {}),
        "helper_relay": (r109_helper_relay_source, {}),
        "try_exception_finally": (
            r109_try_relay_source, {"publication_finally_marker": lambda: None}),
    }
    r109_legitimate_effects = {
        name: r109_fixture_effect(source, "cleanup_before", extra)
        for name, (source, extra) in r109_legitimate_sources.items()}
    r109_legitimate_variants_ok = all(
        effect[:2] == (("cleanup",), True)
        and effect[2].get("seam_present") is True
        and effect[2].get("transform_available") is True
        and effect[2].get("cleanup_sites") == 1
        and effect[2].get("transformed_cleanup_sites") == 1
        for effect in r109_legitimate_effects.values())
    r109_missing_seam_source = r109_fixture_source.replace(
        "consume_private_result(sink_fd, result, invocation_id, run_id, role)",
        "{'not': 'a publication'}")
    r109_ambiguous_seam_source = r109_fixture_source.replace(
        "            accepted = consume_private_result",
        "            ignored = consume_private_result(sink_fd, result, invocation_id, run_id, role)\n"
        "            accepted = consume_private_result")
    r110_cleanup_missing_source = r109_fixture_source.replace(
        "_cleanup_result_staging(\n                    result_root, result_root_identity)",
        "cleanup_not_available(\n                    result_root, result_root_identity)")
    r110_cleanup_ambiguous_source = r109_fixture_source.replace(
        '''                result_residue, result_cleanup_degraded = _cleanup_result_staging(
                    result_root, result_root_identity)''',
        '''                _cleanup_result_staging(result_root, result_root_identity)
                result_residue, result_cleanup_degraded = _cleanup_result_staging(
                    result_root, result_root_identity)''')
    _r109_missing_tree, r109_missing_facts = r109_transform_tree(
        r109_missing_seam_source, "cleanup_before")
    _r109_ambiguous_tree, r109_ambiguous_facts = r109_transform_tree(
        r109_ambiguous_seam_source, "cleanup_before")
    _r110_cleanup_missing_tree, r110_cleanup_missing_facts = r109_transform_tree(
        r110_cleanup_missing_source, "cleanup_before")
    _r110_cleanup_ambiguous_tree, r110_cleanup_ambiguous_facts = r109_transform_tree(
        r110_cleanup_ambiguous_source, "cleanup_before")
    r109_seam_cardinality_controls_ok = (
        r109_missing_facts.get("seam_present") is False
        and r109_missing_facts.get("transform_available") is False
        and r109_ambiguous_facts.get("seam_present") is True
        and r109_ambiguous_facts.get("transform_available") is False)

    def r109_connected_disposition(facts: dict[str, object]) -> str:
        if facts.get("seam_present") is not True:
            return "ABSENT"
        if facts.get("transform_available") is not True:
            return "RIG_ODOMBART"
        return "CONNECTED"

    def r109_enforce_connected_disposition(disposition: str) -> None:
        if disposition == "RIG_ODOMBART":
            raise RuntimeError(
                "R109 connected consumer seam is present but structurally ambiguous")

    try:
        r109_enforce_connected_disposition(
            r109_connected_disposition(r109_ambiguous_facts))
    except RuntimeError as r109_ambiguous_error:
        r109_ambiguous_fail_closed = "structurally ambiguous" in str(
            r109_ambiguous_error)
    else:
        r109_ambiguous_fail_closed = False
    r109_disposition_controls_ok = (
        r109_connected_disposition(r109_missing_facts) == "ABSENT"
        and r109_connected_disposition(
            r109_legitimate_effects["local_rename"][2]) == "CONNECTED"
        and r109_ambiguous_fail_closed)

    def r110_fail_closed(facts: dict[str, object]) -> bool:
        try:
            r109_enforce_connected_disposition(
                r109_connected_disposition(facts))
        except RuntimeError as error:
            return "structurally ambiguous" in str(error)
        return False

    r110_cardinality_controls_ok = (
        r109_missing_facts.get("consumer_sites") == 0
        and r109_missing_facts.get("cleanup_sites") == 1
        and r109_connected_disposition(r109_missing_facts) == "ABSENT"
        and r110_cleanup_missing_facts.get("consumer_sites") == 1
        and r110_cleanup_missing_facts.get("cleanup_sites") == 0
        and r110_cleanup_missing_facts.get("seam_present") is True
        and r110_cleanup_missing_facts.get("transform_available") is False
        and r110_fail_closed(r110_cleanup_missing_facts)
        and r110_cleanup_ambiguous_facts.get("consumer_sites") == 1
        and r110_cleanup_ambiguous_facts.get("cleanup_sites") == 2
        and r110_cleanup_ambiguous_facts.get("seam_present") is True
        and r110_cleanup_ambiguous_facts.get("transform_available") is False
        and r110_fail_closed(r110_cleanup_ambiguous_facts))

    # R112 freezes a pathless handoff at the exact consumer entry.  The whole
    # current-attempt private execution family is checked with lexists/lstat so
    # moved roots and broken symlinks cannot disappear from the verdict.  The
    # originally opened numeric fd must remain the sole live alias; a restored
    # number after close/dup2 is rejected by the operation lineage.
    def r112_handoff_case(mode: str, relay: bool = False) -> dict[str, object]:
        root = Path(module.tempfile.mkdtemp(prefix="r112-handoff-", dir=work))
        private = root / "private"; private.mkdir(mode=0o700)
        sink = private / "result.json"
        snapshot = private / "provider-snapshot"
        raw = b'{"role":"TEST_AUTHOR","summary":"r112"}'
        sink.write_bytes(raw); sink.chmod(0o600)
        retained = os.open(sink, os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
                           | getattr(os, "O_NOFOLLOW", 0))
        original_number = retained
        pre_path = sink.lstat(); pre_fd = os.fstat(retained)
        identity = (pre_fd.st_dev, pre_fd.st_ino)
        family = {sink, private, snapshot}
        lineage: list[tuple[object, ...]] = []
        calls: list[dict[str, object]] = []
        published = False
        alias_fd = -1; other_fd = -1; writer_fd = -1

        def aliases() -> list[int]:
            found=[]
            for item in Path("/dev/fd").iterdir():
                try: number=int(item.name); current=os.fstat(number)
                except (OSError,ValueError): continue
                if (current.st_dev,current.st_ino)==identity: found.append(number)
            return sorted(found)

        def actual_consumer(fd, canonical, invocation, run, role):
            nonlocal published
            before=os.fstat(fd); before_state=(before.st_dev,before.st_ino,before.st_mode,
                before.st_nlink,before.st_size,before.st_mtime_ns,before.st_ctime_ns)
            value=os.pread(fd,MAX_RESULT_BYTES+1,0);after=os.fstat(fd)
            after_state=(after.st_dev,after.st_ino,after.st_mode,after.st_nlink,
                after.st_size,after.st_mtime_ns,after.st_ctime_ns)
            present=[str(path) for path in sorted(family,key=str)
                     if os.path.lexists(path)]
            record={"fd":fd,"same_numeric":fd==original_number,
                "same_inode":(before.st_dev,before.st_ino)==identity,
                "nlink":before.st_nlink,"stable":before_state==after_state,
                "raw":value,"aliases":aliases(),"lineage":list(lineage),
                "family_present":present,"canonical":str(canonical),
                "invocation":invocation,"run":run,"role":role}
            calls.append(record)
            if (not stat.S_ISREG(before.st_mode) or before.st_nlink!=0
                    or before_state!=after_state or value!=raw
                    or fd!=original_number or record["aliases"]!=[original_number]
                    or lineage or present):
                raise ValueError("R112 unsafe consumer-entry handoff")
            published=True
            return hashlib.sha256(value).hexdigest()

        def helper(fd, canonical, invocation, run, role):
            return actual_consumer(fd, canonical, invocation, run, role)

        try:
            if mode in {"late_snapshot_cleanup","moved_root"}:
                snapshot.mkdir()
            if mode == "moved_root":
                moved=root/"moved-snapshot"; snapshot.rename(moved); family.add(moved)
            if mode == "alternate_root":
                alternate=root/"alternate-snapshot";alternate.mkdir();family.add(alternate)
            if mode == "broken_symlink":
                broken=root/"broken-snapshot";os.symlink("missing",broken);family.add(broken)
            if mode == "unstable_bytes": writer_fd=os.open(sink,os.O_WRONLY)
            if mode != "nlink_one_after_cleanup": sink.unlink()
            if mode == "unstable_bytes":
                os.pwrite(writer_fd,b"X",1);os.fsync(writer_fd)
                os.close(writer_fd);writer_fd=-1
            if mode == "extra_alias":
                alias_fd=os.dup(retained);lineage.append(("dup",retained,alias_fd))
            if mode == "dup_close_original":
                alias_fd=os.dup(retained);lineage.append(("dup",retained,alias_fd))
                os.close(retained);lineage.append(("close_original",retained));retained=-1
            if mode == "dup2_reuse":
                alias_fd=os.dup(retained);lineage.append(("dup",retained,alias_fd))
                os.close(retained);lineage.append(("close_original",retained))
                os.dup2(alias_fd,original_number);lineage.append(
                    ("dup2",alias_fd,original_number));retained=original_number
                os.close(alias_fd);alias_fd=-1
            if mode == "fcntl_alias":
                alias_fd=fcntl.fcntl(retained,fcntl.F_DUPFD,0)
                lineage.append(("fcntl_dup",retained,alias_fd))
            if mode == "different_fd":
                other=root/"other";other.write_bytes(raw)
                other_fd=os.open(other,os.O_RDONLY|getattr(os,"O_CLOEXEC",0))
                other.unlink()
            if mode == "residual_path": sink.write_bytes(b"residue")
            if mode == "residual_private": (private/"residue").write_bytes(b"x")
            if private.exists() and not any(private.iterdir()): private.rmdir()
            selected=(other_fd if mode=="different_fd" else
                      alias_fd if mode=="dup_close_original" else retained)
            count=0 if mode=="zero_calls" else 2 if mode=="two_calls" else 1
            error="NONE";returned=None
            for _unused in range(count):
                try:
                    target=helper if relay else actual_consumer
                    returned=target(selected,root/"canonical","1"*32,"2"*32,"TEST_AUTHOR")
                except Exception as exc:
                    error=f"{type(exc).__name__}:{exc}";break
            entry_present=(calls[0]["family_present"] if calls else
                           [str(path) for path in family if os.path.lexists(path)])
            if mode == "late_snapshot_cleanup" and snapshot.exists(): snapshot.rmdir()
            admitted=(published and len(calls)==1 and error=="NONE"
                      and returned==hashlib.sha256(raw).hexdigest())
            return {"admitted":admitted,"published":published,"calls":len(calls),
                    "error":error,"same_numeric":bool(calls and calls[0]["same_numeric"]),
                    "same_inode":bool(calls and calls[0]["same_inode"]),
                    "pre_nlink":pre_path.st_nlink,
                    "post_nlink":calls[0]["nlink"] if calls else None,
                    "entry_family_present":entry_present,
                    "post_family_present":[str(path) for path in family
                                           if os.path.lexists(path)],
                    "aliases":calls[0]["aliases"] if calls else aliases(),
                    "lineage":list(lineage),"relay":relay}
        finally:
            for number in (alias_fd,other_fd,writer_fd,retained):
                if number >= 0:
                    try: os.close(number)
                    except OSError: pass
            shutil.rmtree(root,ignore_errors=True)

    r112_direct_positive=r112_handoff_case("valid")
    r112_helper_positive=r112_handoff_case("valid",True)
    r112_negative_modes=("nlink_one_after_cleanup","unstable_bytes",
        "residual_path","residual_private","late_snapshot_cleanup","moved_root",
        "alternate_root","broken_symlink","different_fd","extra_alias","dup_close_original",
        "dup2_reuse","fcntl_alias","zero_calls","two_calls")
    r112_negative_cases={name:r112_handoff_case(name) for name in r112_negative_modes}
    r112_handoff_rig_ok=(r112_direct_positive.get("admitted") is True
        and r112_helper_positive.get("admitted") is True
        and r112_direct_positive.get("pre_nlink")==1
        and r112_direct_positive.get("post_nlink")==0
        and r112_direct_positive.get("entry_family_present")==[]
        and len(r112_direct_positive.get("aliases",[]))==1
        and all(case.get("admitted") is False
                for case in r112_negative_cases.values()))

    def cleanup_failure_case(persistent: bool, mutation: str | None = None,
                             rollback_fault: str | None = None,
                             unlink_variant: str | None = None,
                             replacement: str | None = None,
                             ordering_variant: str | None = None,
                             substitution: str | None = None):
        cleanup_repo = make_repo(str(provider))
        targets: list[Path] = []; failures = [0]
        original_popen = module.subprocess.Popen
        original_unlink = module.os.unlink
        original_remove = module.os.remove
        original_path_unlink = module.Path.unlink
        original_rmtree = module.shutil.rmtree
        original_consume = getattr(module, "consume_private_result", None)
        original_run_codex = module.run_codex
        variant_function = None
        variant_inventory_ok = False
        variant_source_changed = False
        variant_facts: dict[str, object] = {}
        if ordering_variant is not None:
            variant_function, variant_inventory_ok, variant_facts = (
                r109_compile_run_codex(source_text, ordering_variant,
                                       module.__dict__))
            variant_source_changed = bool(
                variant_facts.get("transform_available") is True)
        retained_sources: list[tuple[bytes, object, str]] = []
        published_bindings: list[dict[str, object]] = []
        rollback_attempts: list[object] = []
        foreign_attempts: list[object] = []
        replacement_observations: list[dict[str, object]] = []
        race_observation: dict[str, object] = {}
        race_records: list[dict[str, object]] = []
        runs_root = module.journal_root(cleanup_repo) / "runs"
        before_runs = set(runs_root.iterdir()) if runs_root.is_dir() else set()
        foreign = work / f"r105-foreign-{nonlocal_counter[0]}-{replacement or 'none'}"
        same_inode_alias = work / f"r106-same-inode-{nonlocal_counter[0]}-{replacement or 'none'}"
        race_accepted = work / f"r106-race-accepted-{nonlocal_counter[0]}"
        open_race_accepted = work / f"r107-open-race-accepted-{nonlocal_counter[0]}"
        if replacement is not None:
            foreign.write_bytes(b"R105 foreign canonical guard")
        # R115 provider-controlled staging substitution.  substitution_dest is a
        # cross-parent destination that is NOT a sibling of the staging root's
        # original parent; substitution_guard is an unrelated directory whose
        # marker child must survive any root-symlink following.  Both live under
        # work, outside the attempt arena, so only the gate's final teardown
        # removes them and the product can never legitimately touch them.
        substitution_scope = work / f"r115-substitution-{nonlocal_counter[0]}-{substitution or 'none'}"
        substitution_dest = substitution_scope / "moved-elsewhere"
        substitution_guard = substitution_scope / "unrelated-guard"
        substitution_guard_marker = substitution_guard / "guard-marker"
        substitution_state: dict[str, object] = {
            "mode": substitution, "fired": False, "error": None}
        if substitution is not None:
            substitution_scope.mkdir(mode=0o700)
            substitution_guard.mkdir(mode=0o700)
            substitution_guard_marker.write_bytes(b"R115 unrelated guard marker")

        def current_canonical() -> Path | None:
            current = set(runs_root.iterdir()) if runs_root.is_dir() else set()
            candidates = [path / "result.json" for path in sorted(current - before_runs)]
            return candidates[0] if len(candidates) == 1 else None

        def fire_substitution() -> None:
            # Provider-controlled substitution of the exact staging root as the
            # provider's final effect, landing after the provider process exits
            # and before any controller post-provider logic.  This is agnostic
            # to how the controller later retires the family: a safe controller
            # binds the staging inode (a retained no-follow directory handle),
            # so it never leaks relocated family content and never follows the
            # substituted path into the unrelated guard.
            if substitution is None or substitution_state["fired"] or not targets:
                return
            root = targets[-1].parent
            substitution_state["fired"] = True
            try:
                if substitution == "cross_parent_move":
                    os.rename(str(root), str(substitution_dest))
                elif substitution == "root_symlink":
                    original_rmtree(str(root))
                    os.symlink(str(substitution_guard), str(root))
                elif substitution == "real_dir_replacement":
                    # Relocate the real staging root, then plant a REAL foreign
                    # directory (different inode) at the original root path.  A
                    # finalizer that deletes the root path without re-binding its
                    # inode destroys this foreign object (E167-REV-01).
                    os.rename(str(root), str(substitution_dest))
                    os.mkdir(str(root), 0o700)
                    (root / "foreign-marker").write_bytes(
                        b"R116 real-dir replacement foreign marker")
            except OSError as exc:
                substitution_state["error"] = f"{type(exc).__name__}:{exc}"

        class _SubstitutionPopen:
            """Delegates to the real provider process, firing the staging
            substitution exactly once when the controller reaps it."""
            def __init__(self, proc): self._h032_proc = proc
            def wait(self, *args, **kwargs):
                result = self._h032_proc.wait(*args, **kwargs)
                fire_substitution()
                return result
            def __getattr__(self, name): return getattr(self._h032_proc, name)

        def observe_target(argv, *args, **kwargs):
            flat = list(argv)
            has_output = "-o" in flat
            if has_output: targets.append(Path(flat[flat.index("-o") + 1]))
            proc = original_popen(argv, *args, **kwargs)
            if substitution is not None and has_output:
                return _SubstitutionPopen(proc)
            return proc

        def retain_then_consume(sink_fd, canonical_destination,
                                invocation_id, run_id, role):
            before = os.fstat(sink_fd)
            raw = os.pread(sink_fd, MAX_RESULT_BYTES + 1, 0)
            after = os.fstat(sink_fd)
            if (len(raw) <= MAX_RESULT_BYTES
                    and (before.st_dev, before.st_ino, before.st_size,
                         before.st_mtime_ns, before.st_ctime_ns)
                        == (after.st_dev, after.st_ino, after.st_size,
                            after.st_mtime_ns, after.st_ctime_ns)
                    and len(raw) == before.st_size):
                retained_sources.append((raw,
                    strict_json(raw.decode("utf-8", errors="strict")),
                    hashlib.sha256(raw).hexdigest()))
            returned = original_consume(sink_fd, canonical_destination,
                                        invocation_id, run_id, role)
            canonical = Path(canonical_destination).absolute()
            published_state = rollback_object_state(canonical)
            canonical_raw = published_state.get("raw")
            canonical_value = published_state.get("value")
            if not isinstance(canonical_raw, bytes) or not isinstance(canonical_value, dict):
                raise RuntimeError("R107 published canonical has no opened bounded state")
            retained_value = retained_sources[-1][1] if retained_sources else None
            retained_digest = retained_sources[-1][2] if retained_sources else None
            published_bindings.append({
                "path": str(canonical),
                "dev": published_state.get("dev"),
                "ino": published_state.get("ino"),
                "mode": published_state.get("mode"),
                "nlink": published_state.get("nlink"),
                "size": published_state.get("size"),
                "mtime_ns": published_state.get("mtime_ns"),
                "ctime_ns": published_state.get("ctime_ns"),
                "digest": published_state.get("digest"),
                "schema": canonical_result_valid(canonical_value, schema_document),
                "digest_bound": (retained_digest is not None
                                 and canonical_value.get("result_sha256") == retained_digest),
                "value_bound": (retained_value is not None
                                and canonical_value.get("report") == retained_value),
                "state": published_state,
            })
            if replacement is not None:
                rollback_fault_active[0] = None
                if replacement == "symlink":
                    original_path_unlink(canonical)
                    canonical.symlink_to(foreign)
                elif replacement == "hardlink":
                    original_path_unlink(canonical)
                    module.os.link(foreign, canonical)
                elif replacement == "same_inode_nlink":
                    module.os.link(canonical, same_inode_alias)
                    original_path_unlink(canonical)
                    module.os.link(same_inode_alias, canonical)
                elif replacement == "same_inode_mode":
                    module.os.link(canonical, same_inode_alias)
                    original_path_unlink(canonical)
                    same_inode_alias.chmod(
                        0o640 if stat.S_IMODE(published_state.get("mode", 0)) != 0o640
                        else 0o600)
                    module.os.link(same_inode_alias, canonical)
                    original_path_unlink(same_inode_alias)
                elif replacement == "same_inode_value":
                    module.os.link(canonical, same_inode_alias)
                    original_path_unlink(canonical)
                    changed_value = strict_json(canonical_raw.decode("utf-8", errors="strict"))
                    report = changed_value.get("report") if isinstance(changed_value, dict) else None
                    summary = report.get("summary") if isinstance(report, dict) else None
                    if not isinstance(summary, str) or not summary:
                        raise RuntimeError("R106 mutation has no bounded summary")
                    report["summary"] = ("X" if summary[0] != "X" else "Y") + summary[1:]
                    changed_raw = json.dumps(changed_value, ensure_ascii=False,
                                             separators=(",", ":"), sort_keys=True).encode("utf-8")
                    if len(changed_raw) != len(canonical_raw):
                        raise RuntimeError("R106 same-inode mutation changed size")
                    fd = os.open(same_inode_alias, os.O_WRONLY | os.O_TRUNC)
                    try:
                        remaining = memoryview(changed_raw)
                        while remaining:
                            count = os.write(fd, remaining)
                            if count <= 0:
                                raise OSError("R106 short same-inode mutation")
                            remaining = remaining[count:]
                        os.fsync(fd)
                    finally:
                        os.close(fd)
                    module.os.link(same_inode_alias, canonical)
                    original_path_unlink(same_inode_alias)
                elif replacement == "audit_race":
                    pass
                elif replacement in {"open_swap", "third_retry_open_swap"}:
                    fd = os.open(foreign, os.O_WRONLY | os.O_TRUNC)
                    try:
                        remaining = memoryview(canonical_raw)
                        while remaining:
                            count = os.write(fd, remaining)
                            if count <= 0:
                                raise OSError("R107 short foreign-value write")
                            remaining = remaining[count:]
                        os.fsync(fd)
                    finally:
                        os.close(fd)
                else:
                    raise RuntimeError(f"unsupported R105 replacement: {replacement}")
                replacement_state = canonical.lstat()
                try:
                    current_state = rollback_object_state(canonical)
                except OSError:
                    current_state = {"digest": None, "value": None}
                replacement_observations.append({
                    "path": str(canonical),
                    "dev": replacement_state.st_dev,
                    "ino": replacement_state.st_ino,
                    "mode": replacement_state.st_mode,
                    "nlink": replacement_state.st_nlink,
                    "size": replacement_state.st_size,
                    "mtime_ns": replacement_state.st_mtime_ns,
                    "ctime_ns": replacement_state.st_ctime_ns,
                    "digest": current_state.get("digest"),
                    "value": current_state.get("value"),
                    "foreign_dev": foreign.lstat().st_dev,
                    "foreign_ino": foreign.lstat().st_ino,
                    "foreign_digest": sha256(foreign),
                })
            rollback_fault_active[0] = {
                "path": canonical,
                "state": published_state,
                "fault": rollback_fault,
                "attempts": rollback_attempts,
                "foreign_attempts": foreign_attempts,
            }
            if replacement == "audit_race":
                race_record: dict[str, object] = {
                    "path": canonical, "accepted": race_accepted,
                    "foreign": foreign, "attempts": rollback_attempts,
                    "check_saw_expected": False, "swapped": False,
                }
                race_records.append(race_record)
                rollback_race_active[0] = race_record
            elif replacement in {"open_swap", "third_retry_open_swap"}:
                race_record = {
                    "path": canonical, "accepted": open_race_accepted,
                    "foreign": foreign,
                    "swap_attempt": 3 if replacement == "third_retry_open_swap" else 1,
                    "armed": False, "swapped": False,
                }
                race_records.append(race_record)
                rollback_open_race_active[0] = race_record
            return returned

        def repeat_publication_effect() -> None:
            canonical = current_canonical()
            if canonical is None:
                raise RuntimeError("R100 mutation has no exact current canonical path")
            source = canonical.with_name(".r100-republish")
            if canonical.exists() or canonical.is_symlink():
                module.os.replace(canonical, source)
            else:
                source.write_bytes(b"R100 transition probe")
            # Two real absent->present effects use the same source object and
            # bytes.  Both are rolled away, leaving the canonical absent.
            module.os.replace(source, canonical)
            module.os.replace(canonical, source)
            module.os.replace(source, canonical)
            module.os.replace(canonical, source)
            module.os.unlink(source)

        def hardlink_publication_effect() -> None:
            canonical = current_canonical()
            if canonical is None:
                raise RuntimeError("R101 mutation has no exact current canonical path")
            source = canonical.with_name(".r101-link-republish")
            if canonical.exists() and not canonical.is_symlink():
                # Retain the actual product-published object before making the
                # canonical absent.  The following two publications therefore
                # reuse its exact inode and bytes.
                module.os.link(canonical, source)
                module.os.unlink(canonical)
            else:
                source.write_bytes(b"R101 hardlink transition probe")
            module.os.link(source, canonical)
            module.os.unlink(canonical)
            module.os.link(source, canonical)
            module.os.unlink(canonical)
            module.os.unlink(source)

        def stale_canonical_effect() -> None:
            canonical = current_canonical()
            if canonical is None or not canonical.is_file() or canonical.is_symlink():
                raise RuntimeError("R100 mutation has no published canonical")
            raw = bounded_stable_result(canonical, MAX_CANONICAL_BYTES)
            document = strict_json(raw.decode("utf-8", errors="strict"))
            report = document.get("report") if isinstance(document, dict) else None
            summary = report.get("summary") if isinstance(report, dict) else None
            if not isinstance(summary, str) or not summary:
                raise RuntimeError("R100 mutation has no mutable summary")
            report["summary"] = ("X" if summary[0] != "X" else "Y") + summary[1:]
            changed = json.dumps(document, ensure_ascii=False,
                                 separators=(",", ":"), sort_keys=True).encode("utf-8")
            if len(changed) != len(raw):
                raise RuntimeError("R100 mutation did not preserve byte length")
            fd = module.os.open(canonical, os.O_WRONLY | os.O_TRUNC)
            try:
                remaining = memoryview(changed)
                while remaining:
                    count = os.write(fd, remaining)
                    if count <= 0: raise OSError("R100 short mutation write")
                    remaining = remaining[count:]
                os.fsync(fd)
            finally:
                os.close(fd)

        case_run_codex = variant_function or original_run_codex
        def run_with_mutation(*args, **kwargs):
            try:
                returned = case_run_codex(*args, **kwargs)
            except BaseException:
                if mutation == "repeat_publication":
                    repeat_publication_effect()
                elif mutation == "hardlink_publication":
                    hardlink_publication_effect()
                raise
            if mutation == "stale_canonical":
                stale_canonical_effect()
            return returned

        def injected_unlink(path, *args, **kwargs):
            candidate = Path(path)
            if (substitution is None and ordering_variant is None and targets
                    and candidate == targets[-1]
                    and (persistent or failures[0] == 0)):
                failures[0] += 1; raise OSError("H032 injected result cleanup failure")
            return original_unlink(path, *args, **kwargs)
        def injected_rmtree(path, *args, **kwargs):
            candidate = Path(path)
            if substitution is None and targets \
                    and (candidate == targets[-1] or candidate in targets[-1].parents) \
                    and (persistent or failures[0] == 0):
                failures[0] += 1; raise OSError("H032 injected result cleanup failure")
            return original_rmtree(path, *args, **kwargs)
        def aliased_path_unlink(path, *args, **kwargs):
            if unlink_variant == "os_unlink":
                return module.os.unlink(path, *args, **kwargs)
            if unlink_variant == "os_remove":
                return module.os.remove(path, *args, **kwargs)
            return original_path_unlink(path, *args, **kwargs)
        module.subprocess.Popen = observe_target
        module.os.unlink = injected_unlink
        module.shutil.rmtree = injected_rmtree
        if unlink_variant is not None:
            module.Path.unlink = aliased_path_unlink
        if original_consume is not None:
            module.consume_private_result = retain_then_consume
            if variant_function is not None:
                variant_function.__globals__["consume_private_result"] = retain_then_consume
        if ordering_variant is not None:
            if variant_function is None:
                raise RuntimeError(f"R108 source variant unavailable: {ordering_variant}")
            module.run_codex = variant_function
        elif mutation is not None:
            module.run_codex = run_with_mutation
        try:
            outcome = attempt(cleanup_repo)
        finally:
            rollback_fault_active[0] = None
            rollback_race_active[0] = None
            rollback_open_race_active[0] = None
            module.subprocess.Popen = original_popen
            module.os.unlink = original_unlink
            module.os.remove = original_remove
            module.Path.unlink = original_path_unlink
            module.shutil.rmtree = original_rmtree
            if original_consume is not None:
                module.consume_private_result = original_consume
            module.run_codex = original_run_codex
        transport_residue: list[Path] = []
        for target in targets:
            for candidate in (target, target.parent):
                if candidate.exists() or candidate.is_symlink():
                    transport_residue.append(candidate)
        observed_cleanup = last_attempt_observed[0] or {}
        canonical_epochs = list(observed_cleanup.get(
            "canonical_visibility_epochs", []))
        canonical_candidates = {
            Path(value) for value in observed_cleanup.get("canonical_paths", [])
        }
        canonical_candidates.update(
            Path(epoch[0]) for epoch in canonical_epochs
            if isinstance(epoch, (tuple, list)) and epoch
            and isinstance(epoch[0], str))
        retained_raw = retained_sources[0][0] if len(retained_sources) == 1 else None
        retained_value = retained_sources[0][1] if len(retained_sources) == 1 else None
        retained_digest = retained_sources[0][2] if len(retained_sources) == 1 else None
        canonical_states = []
        for canonical in sorted(canonical_candidates):
            present = canonical.exists() or canonical.is_symlink()
            regular = schema_valid = digest_bound = value_bound = False
            if present and not canonical.is_symlink():
                try:
                    opened = canonical.stat()
                    regular = stat.S_ISREG(opened.st_mode)
                    raw = bounded_stable_result(canonical, MAX_CANONICAL_BYTES)
                    document = strict_json(raw.decode("utf-8", errors="strict"))
                    schema_valid = canonical_result_valid(document, schema_document)
                    digest_bound = (retained_digest is not None
                                    and document.get("result_sha256") == retained_digest)
                    value_bound = (retained_value is not None
                                   and document.get("report") == retained_value)
                except Exception:
                    pass
            canonical_states.append((str(canonical), present, regular,
                                     schema_valid, digest_bound, value_bound))
        direct_writes = list(observed_cleanup.get("canonical_direct_writes", []))
        rollback_post = []
        for binding in published_bindings:
            canonical = Path(binding["path"])
            present = canonical.exists() or canonical.is_symlink()
            post_dev = post_ino = post_mode = post_digest = None
            if present:
                try:
                    post = canonical.lstat()
                    post_dev, post_ino, post_mode = post.st_dev, post.st_ino, post.st_mode
                    if stat.S_ISREG(post.st_mode) and not canonical.is_symlink():
                        post_digest = sha256(canonical)
                except OSError:
                    pass
            rollback_post.append({
                "path": str(canonical), "present": present,
                "dev": post_dev, "ino": post_ino, "mode": post_mode,
                "digest": post_digest,
            })
        foreign_post = None
        if replacement is not None:
            canonical = Path(published_bindings[-1]["path"]) if published_bindings else None
            foreign_post = {
                "guard_present": foreign.exists() and not foreign.is_symlink(),
                "guard_digest": sha256(foreign) if foreign.exists() and not foreign.is_symlink() else None,
                "canonical_present": bool(canonical is not None
                                          and (canonical.exists() or canonical.is_symlink())),
                "same_inode_alias_present": (same_inode_alias.exists()
                                              or same_inode_alias.is_symlink()),
                "race_accepted_present": (race_accepted.exists()
                                           or race_accepted.is_symlink()),
            }
            if replacement == "audit_race":
                race_state = race_records[-1] if race_records else None
                accepted_state = (rollback_object_state(race_accepted)
                                  if race_accepted.exists() and not race_accepted.is_symlink()
                                  else None)
                # A race observation exists only when the armed race actually
                # fired; a cleanup-before rejection that never entered any
                # rollback syscall must not be credited with a fabricated
                # all-false race record.
                if race_state is None and accepted_state is None:
                    race_observation = {}
                else:
                    race_observation = {
                    "check_saw_expected": bool(race_state and race_state.get("check_saw_expected")),
                    "swapped": bool(race_state and race_state.get("swapped")),
                    "canonical_absent": bool(canonical is not None
                                             and not canonical.exists()
                                             and not canonical.is_symlink()),
                    "accepted_present": accepted_state is not None,
                    "accepted_object_content_equal": (
                        all(accepted_state.get(key)
                            == published_bindings[-1]["state"].get(key)
                            for key in ("dev", "ino", "mode", "nlink", "size",
                                        "digest", "value"))
                        if accepted_state is not None and published_bindings else False),
                    "foreign_deleted": not foreign.exists() and not foreign.is_symlink(),
                }
            elif replacement in {"open_swap", "third_retry_open_swap"}:
                race_state = race_records[-1] if race_records else None
                accepted_state = (rollback_object_state(open_race_accepted)
                                  if open_race_accepted.exists()
                                  and not open_race_accepted.is_symlink() else None)
                current_state = (rollback_object_state(canonical)
                                 if canonical is not None and canonical.exists()
                                 and not canonical.is_symlink() else None)
                # Same arming rule as the audit race: no fired swap and no
                # accepted-object survivor means no race observation at all.
                if race_state is None and accepted_state is None:
                    race_observation = {}
                else:
                    race_observation = {
                    "swap_attempt": (race_state.get("swap_attempt")
                                     if race_state else None),
                    "swapped": bool(race_state and race_state.get("swapped")),
                    "canonical_present": current_state is not None,
                    "foreign_preserved_at_canonical": bool(
                        current_state is not None and replacement_observations
                        and (current_state.get("dev"), current_state.get("ino"))
                            == (replacement_observations[0].get("foreign_dev"),
                                replacement_observations[0].get("foreign_ino"))),
                    "accepted_present": accepted_state is not None,
                    "accepted_object_equal": bool(
                        accepted_state is not None and published_bindings
                        and all(accepted_state.get(key)
                                == published_bindings[-1]["state"].get(key)
                                for key in ("dev", "ino", "mode", "nlink", "size",
                                            "digest", "value"))),
                }
        attempt_residue = {
            "private_paths_present": list(observed_cleanup.get(
                "private_paths_present", [])),
            "sink_fd_aliases": list(observed_cleanup.get("sink_fd_aliases", [])),
            "provider_process_starts": observed_cleanup.get(
                "provider_process_starts"),
            "source_variant": ordering_variant,
            "source_changed": variant_source_changed,
            "inventory_ok": variant_inventory_ok,
            "substitution": substitution,
            "substitution_fired": bool(substitution_state["fired"]),
            "substitution_error": substitution_state["error"],
            # The unrelated guard and its marker must survive intact: a safe
            # controller never follows the substituted staging path into an
            # unrelated tree.
            "substitution_guard_intact": (
                substitution is None
                or (substitution_guard.is_dir()
                    and not substitution_guard.is_symlink()
                    and substitution_guard_marker.is_file()
                    and substitution_guard_marker.read_bytes()
                        == b"R115 unrelated guard marker")),
            # No private-family CONTENT may survive a substitution: a safe
            # controller retires the family by the bound staging inode, so a
            # relocated sink/result leaves no regular-file residue.  The
            # unrelated guard subtree is excluded (it is not family).
            "substitution_family_residue": sorted(
                str(path) for path in substitution_scope.rglob("*")
                if not path.is_symlink() and path.is_file()
                and substitution_guard not in path.parents
                and path != substitution_guard_marker
            ) if substitution is not None else [],
            # R116 real-directory replacement (E167-REV-01, owner precision #2):
            # the REAL foreign directory planted at the original root path (and
            # its marker) must survive the finalizer.  A blind path-based cleanup
            # deletes it; an inode-bound finalizer leaves it PRESERVED.  For every
            # other mode this arm is vacuously satisfied.
            "substitution_foreign_intact": (
                substitution != "real_dir_replacement"
                or bool(targets
                    and targets[-1].parent.is_dir()
                    and not targets[-1].parent.is_symlink()
                    and (targets[-1].parent / "foreign-marker").is_file()
                    and (targets[-1].parent / "foreign-marker").read_bytes()
                        == b"R116 real-dir replacement foreign marker")),
            # R116 empty moved parent (E167-REV-02, owner precision #3): the
            # relocated staging directory itself must be absent — an EMPTY moved
            # parent counts as residue, not only its regular files.  A finalizer
            # that unlinks the sink by the bound descriptor but never retires the
            # relocated directory leaves this empty directory behind.
            "substitution_moved_parent_residue": sorted(
                str(path) for path in (substitution_dest,)
                if substitution in {"cross_parent_move", "real_dir_replacement"}
                and path.is_dir() and not path.is_symlink()),
        }
        result = (outcome, failures[0], list(outcome[4]),
                  sorted({str(path) for path in transport_residue}),
                  canonical_states, canonical_epochs,
                  (len(retained_sources), retained_digest,
                   len(retained_raw) if retained_raw is not None else None),
                  direct_writes, published_bindings, list(rollback_attempts),
                  list(foreign_attempts), rollback_post,
                  replacement_observations, foreign_post, race_observation,
                  attempt_residue)
        # Gate-owned cleanup happens only after the complete attempt residue and
        # private-parent observations have been retained in result.  A
        # substituted staging root (a symlink, or a path relocated cross-parent)
        # is retired here explicitly and symlink-safely so the generic
        # target-parent teardown below only ever sees an absent or real parent.
        if substitution is not None:
            for target in targets:
                parent = target.parent
                if parent.is_symlink():
                    original_path_unlink(parent)
            if substitution_scope.exists():
                shutil.rmtree(substitution_scope, ignore_errors=True)
        for target in targets:
            if target.parent.is_symlink():
                original_path_unlink(target.parent)
            elif target.parent.exists():
                target.parent.chmod(0o700)
                shutil.rmtree(target.parent)
        cleanup_arena = observed_cleanup.get("arena")
        if isinstance(cleanup_arena, Path) and cleanup_arena.exists():
            # The persistent-failure control may leave protected provider
            # snapshots elsewhere in this exact attempt arena. The verdict
            # above retains them in outcome[4]; only then does the judge make
            # its own arena removable so the gate itself leaves no residue.
            for root_path, directories, _files in os.walk(cleanup_arena, topdown=False):
                for directory in directories:
                    candidate = Path(root_path) / directory
                    if not candidate.is_symlink(): candidate.chmod(0o700)
                Path(root_path).chmod(0o700)
            shutil.rmtree(cleanup_arena)
        for binding in published_bindings:
            canonical = Path(binding["path"])
            if canonical.exists() or canonical.is_symlink():
                original_path_unlink(canonical)
        if foreign.exists() or foreign.is_symlink():
            original_path_unlink(foreign)
        if same_inode_alias.exists() or same_inode_alias.is_symlink():
            original_path_unlink(same_inode_alias)
        if race_accepted.exists() or race_accepted.is_symlink():
            original_path_unlink(race_accepted)
        if open_race_accepted.exists() or open_race_accepted.is_symlink():
            original_path_unlink(open_race_accepted)
        return result
    transient_cleanup = cleanup_failure_case(False)
    persistent_cleanup = cleanup_failure_case(True)
    repeated_publication_cleanup = cleanup_failure_case(
        True, "repeat_publication")
    hardlink_publication_cleanup = cleanup_failure_case(
        True, "hardlink_publication")
    stale_canonical_cleanup = cleanup_failure_case(
        False, "stale_canonical")
    rollback_path_persistent = cleanup_failure_case(
        True, rollback_fault="persistent")
    rollback_os_unlink_persistent = cleanup_failure_case(
        True, rollback_fault="persistent", unlink_variant="os_unlink")
    rollback_os_remove_persistent = cleanup_failure_case(
        True, rollback_fault="persistent", unlink_variant="os_remove")
    rollback_first_failure = cleanup_failure_case(
        True, rollback_fault="first")
    rollback_final_retry = cleanup_failure_case(
        True, rollback_fault="first_two")
    rollback_symlink_replacement = cleanup_failure_case(
        True, replacement="symlink")
    rollback_hardlink_replacement = cleanup_failure_case(
        True, replacement="hardlink")
    rollback_same_inode_nlink = cleanup_failure_case(
        True, replacement="same_inode_nlink")
    rollback_same_inode_mode = cleanup_failure_case(
        True, replacement="same_inode_mode")
    rollback_same_inode_value = cleanup_failure_case(
        True, replacement="same_inode_value")
    rollback_post_check_race = cleanup_failure_case(
        True, replacement="audit_race")
    rollback_open_swap = cleanup_failure_case(
        True, replacement="open_swap")
    rollback_third_retry_open_swap = cleanup_failure_case(
        True, rollback_fault="first_two", replacement="third_retry_open_swap")
    staging_cross_parent_move = cleanup_failure_case(
        True, substitution="cross_parent_move")
    staging_root_symlink = cleanup_failure_case(
        True, substitution="root_symlink")
    staging_real_dir_replacement = cleanup_failure_case(
        True, substitution="real_dir_replacement")
    _r109_probe_tree, r109_connected_probe = r109_transform_tree(
        source_text, "cleanup_before")
    r109_consumer_seam_present = (
        r109_connected_probe.get("seam_present") is True)
    r109_transform_available = (
        r109_consumer_seam_present
        and all(r109_transform_tree(source_text, ordering)[1].get(
                    "transform_available") is True
                for ordering in ("cleanup_before", "publish_before", "disconnected")))
    r109_actual_disposition = r109_connected_disposition({
        "seam_present": r109_consumer_seam_present,
        "transform_available": r109_transform_available,
    })
    r109_enforce_connected_disposition(r109_actual_disposition)
    r108_cleanup_before = (cleanup_failure_case(
        True, ordering_variant="cleanup_before")
        if r109_transform_available else None)
    r108_publish_before = (cleanup_failure_case(
        True, ordering_variant="publish_before")
        if r109_transform_available else None)
    r108_disconnected = (cleanup_failure_case(
        True, ordering_variant="disconnected")
        if r109_transform_available else None)

    def exact_published_binding(case) -> bool:
        if len(case[8]) != 1:
            return False
        binding = case[8][0]
        return (stat.S_ISREG(binding.get("mode", 0))
                and binding.get("schema") is True
                and binding.get("digest_bound") is True
                and binding.get("value_bound") is True)

    def rollback_fault_safe(case, minimum_attempts: int) -> bool:
        rejected_absent = (case[1] > 0 and not case[0][0]
                           and "cleanup" in case[0][1].lower()
                           and not case[7]
                           and not any(state[1] for state in case[4])
                           and not case[10])
        cleanup_before_publication = (
            not case[8] and not case[5] and not case[9] and not case[11])
        published_then_rolled_back = (
            exact_published_binding(case)
            and len(case[5]) == 1
            and len(case[9]) >= minimum_attempts
            and len(case[11]) == 1
            and case[11][0].get("present") is False)
        return rejected_absent and (
            cleanup_before_publication or published_then_rolled_back)

    rollback_fault_controls_ok = (
        rollback_fault_safe(rollback_path_persistent, 3)
        and rollback_fault_safe(rollback_os_unlink_persistent, 3)
        and rollback_fault_safe(rollback_os_remove_persistent, 3)
        and rollback_fault_safe(rollback_first_failure, 1)
        and rollback_fault_safe(rollback_final_retry, 3))

    def replacement_safe(case, expected_kind: int) -> bool:
        observation = case[12][0] if len(case[12]) == 1 else {}
        foreign_post = case[13] if isinstance(case[13], dict) else {}
        rejected = (case[1] > 0 and not case[0][0]
                    and "cleanup" in case[0][1].lower()
                    and not case[7] and not case[9]
                    and foreign_post.get("guard_present") is True
                    and foreign_post.get("guard_digest")
                        == hashlib.sha256(b"R105 foreign canonical guard").hexdigest())
        cleanup_before_publication = (
            not case[8] and not case[5] and not case[10] and not case[11]
            and not case[12] and foreign_post.get("canonical_present") is False)
        protected_replacement = (
            exact_published_binding(case)
            and stat.S_IFMT(observation.get("mode", 0)) == expected_kind
            and not case[10]
            and foreign_post.get("canonical_present") is True)
        return rejected and (cleanup_before_publication or protected_replacement)

    rollback_identity_controls_ok = (
        replacement_safe(rollback_symlink_replacement, stat.S_IFLNK)
        and replacement_safe(rollback_hardlink_replacement, stat.S_IFREG)
        and replacement_safe(rollback_same_inode_nlink, stat.S_IFREG)
        and replacement_safe(rollback_same_inode_mode, stat.S_IFREG)
        and replacement_safe(rollback_same_inode_value, stat.S_IFREG))

    def same_inode_change_observed(case, change: str) -> bool:
        if not case[8] or len(case[12]) != 1:
            return True  # cleanup-before-publication: no rollback authority exercised
        binding = case[8][0]
        observation = case[12][0]
        common = ((binding.get("dev"), binding.get("ino"))
                  == (observation.get("dev"), observation.get("ino")))
        if change == "nlink":
            changed = (observation.get("nlink") != binding.get("nlink")
                       and observation.get("digest") == binding.get("digest")
                       and observation.get("value") == binding.get("state", {}).get("value"))
        elif change == "mode":
            changed = (observation.get("mode") != binding.get("mode")
                       and observation.get("digest") == binding.get("digest")
                       and observation.get("value") == binding.get("state", {}).get("value"))
        elif change == "value":
            changed = (observation.get("digest") != binding.get("digest")
                       and observation.get("value") != binding.get("state", {}).get("value"))
        else:
            return False
        return common and changed

    same_inode_controls_ok = (
        same_inode_change_observed(rollback_same_inode_nlink, "nlink")
        and same_inode_change_observed(rollback_same_inode_mode, "mode")
        and same_inode_change_observed(rollback_same_inode_value, "value"))

    def rollback_race_safe(case) -> bool:
        foreign_post = case[13] if isinstance(case[13], dict) else {}
        race = case[14] if isinstance(case[14], dict) else {}
        cleanup_before_publication = (
            case[1] > 0 and not case[0][0]
            and "cleanup" in case[0][1].lower()
            and not case[5] and not case[7] and not case[8]
            and not case[9] and not case[10] and not case[11] and not case[12]
            and foreign_post.get("guard_present") is True
            and foreign_post.get("canonical_present") is False
            and not race)
        # Once a rollback syscall is entered, the ordered later hook proves the
        # path operation cannot identify what the syscall actually removes.
        return cleanup_before_publication

    rollback_race_control_ok = rollback_race_safe(rollback_post_check_race)

    def rollback_open_swap_safe(case, expected_attempts: int) -> bool:
        foreign_post = case[13] if isinstance(case[13], dict) else {}
        race = case[14] if isinstance(case[14], dict) else {}
        cleanup_before_publication = (
            case[1] > 0 and not case[0][0]
            and "cleanup" in case[0][1].lower()
            and not case[5] and not case[7] and not case[8]
            and not case[9] and not case[10] and not case[11] and not case[12]
            and foreign_post.get("canonical_present") is False and not race)
        protected_open_swap = (
            exact_published_binding(case)
            and case[1] > 0 and not case[0][0]
            and len(case[9]) == expected_attempts
            and len(case[10]) >= 1
            and case[10][-1].get("opened") is True
            and case[10][-1].get("path_bound") is True
            and case[10][-1].get("devino_equal") is False
            and case[10][-1].get("raw_equal") is True
            and race.get("swapped") is True
            and race.get("foreign_preserved_at_canonical") is True
            and race.get("accepted_present") is True
            and race.get("accepted_object_equal") is True)
        return cleanup_before_publication or protected_open_swap

    rollback_open_swap_controls_ok = (
        rollback_open_swap_safe(rollback_open_swap, 0)
        and rollback_open_swap_safe(rollback_third_retry_open_swap, 2))

    # R115: a provider-controlled substitution of the exact staging root at the
    # controller's own teardown boundary must never leave private-family content
    # residue and must never follow the substituted path into an unrelated tree.
    # The injection actually fired cleanly, the provider still started exactly
    # once, the unrelated guard survived intact, and no private-family regular
    # file remains.  A path-based cleanup that trusts the staging pathname —
    # missing a cross-parent move, or following a root symlink — fails at least
    # one arm.  Publication is deliberately not constrained here: a controller
    # that retires the family by its bound inode may still deliver the retained
    # result, while one that fails closed is equally safe.
    def staging_substitution_safe(case) -> bool:
        residue = case[15] if len(case) > 15 and isinstance(case[15], dict) else {}
        return (
            residue.get("substitution_fired") is True
            and residue.get("substitution_error") is None
            and residue.get("provider_process_starts") == 1
            and residue.get("substitution_guard_intact") is True
            and residue.get("substitution_family_residue") == [])

    staging_substitution_ok = (
        staging_substitution_safe(staging_cross_parent_move)
        and staging_substitution_safe(staging_root_symlink))

    # R116 CONTROL 01 — real-directory replacement (E167-REV-01, owner precision
    # #2).  Beyond the shared substitution-safety arms, the REAL foreign
    # directory planted at the original root path must be PRESERVED.  Confinement
    # alone must not legitimize blind finalizer deletion: this is a finalizer
    # robustness control that fails independently of the sandbox boundary.
    def real_dir_replacement_intact(case) -> bool:
        residue = case[15] if len(case) > 15 and isinstance(case[15], dict) else {}
        # Owner precisions #2 and #3 for the real-directory case: the planted
        # foreign object must be PRESERVED AND the relocated staging directory
        # itself (the empty moved parent) must be absent — a mode-aware finalizer
        # cannot escape by preserving the foreign object while leaking the moved
        # parent only in this mode.
        return (residue.get("substitution_foreign_intact") is True
                and residue.get("substitution_moved_parent_residue") == [])
    real_dir_replacement_ok = (
        staging_substitution_safe(staging_real_dir_replacement)
        and real_dir_replacement_intact(staging_real_dir_replacement))

    # R116 CONTROL 02 — empty moved parent as residue (E167-REV-02, owner
    # precision #3).  After a cross-parent move, a finalizer that only unlinks
    # the relocated sink leaves the moved staging directory itself (now empty)
    # behind.  The owner precision counts that empty directory as residue.  A
    # safe finalizer retires the relocated directory (by the bound descriptor's
    # resolved identity) or, under confinement, the move never occurs.
    def moved_parent_absent(case) -> bool:
        residue = case[15] if len(case) > 15 and isinstance(case[15], dict) else {}
        return residue.get("substitution_moved_parent_residue") == []
    moved_parent_residue_ok = moved_parent_absent(staging_cross_parent_move)

    def r108_cleanup_before_safe(case) -> bool:
        if case is None:
            return False
        residue = case[15] if len(case) > 15 and isinstance(case[15], dict) else {}
        return (
            not case[0][0] and "stop:" in case[0][1].lower()
            and "cleanup" in case[0][1].lower()
            and case[1] >= 3
            and not case[2] and not case[3]
            and all(state[1] is False for state in case[4])
            and not case[5] and not case[7] and not case[8]
            and not case[9] and not case[10] and not case[11]
            and not case[12] and not case[14]
            and residue.get("provider_process_starts") == 1
            and residue.get("source_variant") == "cleanup_before"
            and residue.get("source_changed") is True
            and residue.get("inventory_ok") is True
            and residue.get("private_paths_present") == []
            and residue.get("sink_fd_aliases") == [])

    r108_cleanup_before_connected_ok = (
        r108_cleanup_before_safe(r108_cleanup_before)
        if r109_transform_available else not r109_consumer_seam_present)
    r108_publish_before_mutant_caught = (
        not r108_cleanup_before_safe(r108_publish_before)
        if r109_transform_available else not r109_consumer_seam_present)
    r108_disconnected_mutant_caught = (
        not r108_cleanup_before_safe(r108_disconnected)
        if r109_transform_available else not r109_consumer_seam_present)
    r108_connected_controls_ok = (
        (not r109_consumer_seam_present or r109_transform_available)
        and
        r108_cleanup_before_connected_ok
        and r108_publish_before_mutant_caught
        and r108_disconnected_mutant_caught)
    cleanup_rig_ok = (
        repeated_publication_cleanup[1] > 0
        and not repeated_publication_cleanup[0][0]
        and not any(state[1] for state in repeated_publication_cleanup[4])
        and len(repeated_publication_cleanup[5]) >= 2
        and hardlink_publication_cleanup[1] > 0
        and not hardlink_publication_cleanup[0][0]
        and not any(state[1] for state in hardlink_publication_cleanup[4])
        and len(hardlink_publication_cleanup[5]) >= 2
        and stale_canonical_cleanup[1] == 1
        and stale_canonical_cleanup[0][0]
        and len(stale_canonical_cleanup[4]) == 1
        and stale_canonical_cleanup[4][0][1:4] == (True, True, True)
        and stale_canonical_cleanup[4][0][4] is True
        and stale_canonical_cleanup[4][0][5] is False
        and bool(stale_canonical_cleanup[7]))
    cleanup_error_ok = (
        transient_cleanup[1] == 1 and transient_cleanup[0][0]
        and not transient_cleanup[2] and not transient_cleanup[3]
        and len(transient_cleanup[4]) == 1
        and transient_cleanup[4][0][1:] == (True, True, True, True, True)
        and transient_cleanup[6][0] == 1
        and not transient_cleanup[7]
        and len(transient_cleanup[5]) == 1
        and persistent_cleanup[1] > 0 and not persistent_cleanup[0][0]
        and "cleanup" in persistent_cleanup[0][1].lower()
        and not persistent_cleanup[2] and not persistent_cleanup[3]
        and not any(state[1] for state in persistent_cleanup[4])
        and len(persistent_cleanup[5]) <= 1
        and rollback_fault_controls_ok and rollback_identity_controls_ok
        and same_inode_controls_ok and rollback_race_control_ok
        and rollback_open_swap_controls_ok
        and r109_source_ordering_rig_ok
        and r109_legitimate_variants_ok
        and r109_seam_cardinality_controls_ok
        and r109_disposition_controls_ok
        and r110_cardinality_controls_ok
        and r108_connected_controls_ok
        and cleanup_rig_ok)

    def result_root_ordinal_discovery():
        """Identify result staging by its observed -o child, never by snapshot order."""
        allocations: list[Path] = []; output_paths: list[Path] = []
        original_mkdtemp = module.tempfile.mkdtemp
        original_popen = module.subprocess.Popen
        def observe_mkdtemp(*args, **kwargs):
            value = Path(original_mkdtemp(*args, **kwargs)); allocations.append(value)
            return str(value)
        def observe_popen(argv, *args, **kwargs):
            flat = list(argv)
            if "-o" in flat: output_paths.append(Path(flat[flat.index("-o") + 1]))
            return original_popen(argv, *args, **kwargs)
        module.tempfile.mkdtemp = observe_mkdtemp
        module.subprocess.Popen = observe_popen
        try:
            outcome = attempt(make_repo(str(provider)))
        finally:
            module.tempfile.mkdtemp = original_mkdtemp
            module.subprocess.Popen = original_popen
        matches = [(index, root) for index, root in enumerate(allocations, 1)
                   if len(output_paths) == 1 and output_paths[0].parent == root]
        return outcome, allocations, output_paths, matches

    def setup_spawn_fault_case(stage: str, result_root_ordinal: int,
                               case_repo: Path | None = None, *,
                               effect_tree=None, post_effect_target: int | None = None,
                               profile_state=None, profile_preinstalled: bool = False):
        """Inject by actual callable identity, never source spelling or helper order."""
        if case_repo is None: case_repo = make_repo(str(provider))
        if capture.exists(): capture.unlink()
        original_mkdtemp = module.tempfile.mkdtemp
        original_popen = module.subprocess.Popen
        path_type = type(Path()); path_busy = [False]
        subject_tree = source_tree if effect_tree is None else effect_tree
        run_node = next((node for node in subject_tree.body
                         if isinstance(node, ast.FunctionDef) and node.name == "run_codex"), None)
        run_calls = list(ast.walk(run_node)) if run_node is not None else []
        os_names = {node.func.attr for node in run_calls if isinstance(node, ast.Call)
                    and isinstance(node.func, ast.Attribute)
                    and isinstance(node.func.value, ast.Name)
                    and node.func.value.id == "os"
                    and callable(getattr(module.os, node.func.attr, None))}
        path_names = {node.func.attr for node in run_calls if isinstance(node, ast.Call)
                      and isinstance(node.func, ast.Attribute)
                      and not (isinstance(node.func.value, ast.Name)
                               and node.func.value.id in {"os", "stat", "subprocess",
                                   "tempfile", "shutil", "hashlib", "json", "sys", "fcntl"})
                      and callable(getattr(path_type, node.func.attr, None))}
        helper_names = {name for name, value in vars(module).items()
                        if name != "run_codex" and hasattr(value, "__code__")
                        and getattr(value, "__module__", None) == module.__name__}
        # Root/sink observation uses these operations even if a legitimate source
        # spells a later schedule differently. The post-retained verdict comes from
        # actual callable/code identity below, not from this wrapper selection.
        path_names.update({"lstat", "iterdir"})
        os_names.update({"open", "fsync", "fstat", "close"})
        os_originals = {name: getattr(module.os, name) for name in sorted(os_names)}
        path_originals = {name: getattr(path_type, name) for name in sorted(path_names)}
        helper_originals = {name: getattr(module, name) for name in sorted(helper_names)}
        original_open = os_originals["open"]; original_fsync = os_originals["fsync"]
        original_fstat = os_originals["fstat"]; original_close = os_originals["close"]
        allocations: list[Path] = []; target_root: list[Path] = []
        root_operations = [0]; injected = [False]
        create_fd = [-1]; create_identity: list[tuple[int, int]] = []
        retained_validated = [False]
        boundary_aliases: list[tuple[int, int, int, int]] = []
        stage_trace: list[str] = []
        post_effects: list[str] = []
        profile_sink_fstats: list[tuple[str, str]] = []

        # Resolve effects from the callable actually entered.  This inventory is
        # installed before variant exec below and therefore follows defaults,
        # aliases, C-backed callables and project-helper references captured at
        # definition time.  Only calls whose immediate caller is this exact
        # candidate module are effects; pathlib/shutil internals do not expand a
        # single admitted capability into an implementation-specific call tree.
        capability_owners = (module.os, module.fcntl, module.shutil, module.tempfile,
                             path_type)
        c_capabilities = {}
        code_capabilities = {}
        for owner in capability_owners:
            owner_label = "Path" if owner is path_type else getattr(owner, "__name__", "")
            for name in dir(owner):
                if name.startswith("_"):
                    continue
                try: value = getattr(owner, name)
                except Exception: continue
                if not callable(value):
                    continue
                label = f"{owner_label}.{name}"
                code = getattr(value, "__code__", None)
                if code is not None: code_capabilities[code] = label
                else:
                    try: c_capabilities[value] = label
                    except TypeError: pass
        for name, value in helper_originals.items():
            code_capabilities[value.__code__] = f"helper.{name}"

        if profile_state is None:
            profile_state = [None]
        previous_profile = sys.getprofile()

        def profile_router(frame, event, arg):
            callback = profile_state[0]
            if callback is not None:
                callback(frame, event, arg)

        def profile_effect(frame, event, arg):
            label = None
            caller = frame if event == "c_call" else frame.f_back
            if event == "c_call":
                label = c_capabilities.get(arg)
            elif event == "call":
                label = code_capabilities.get(frame.f_code)
                if frame.f_code is observe_open.__code__: label = "os.open"
                elif frame.f_code is observe_fsync.__code__: label = "os.fsync"
                elif frame.f_code is observe_fstat.__code__: label = "os.fstat"
                elif frame.f_code is observe_close.__code__: label = "os.close"
                elif frame.f_code is wrap_os_code:
                    label = f"os.{frame.f_locals.get('_h032_effect_name', 'unknown')}"
                elif frame.f_code is wrap_path_code:
                    label = f"Path.{frame.f_locals.get('_h032_effect_name', 'unknown')}"
                elif wrap_helper_code is not None and frame.f_code is wrap_helper_code:
                    label = f"helper.{frame.f_locals.get('_h032_effect_name', 'unknown')}"
            if label is None or caller is None \
                    or caller.f_globals.get("__name__") != module.__name__:
                return
            if label == "os.fstat":
                candidate_fd = caller.f_locals.get("fd", caller.f_locals.get("sink_fd"))
                if type(candidate_fd) is int and create_identity:
                    try:
                        opened = original_fstat(candidate_fd)
                        access = fcntl.fcntl(candidate_fd, fcntl.F_GETFL) & os.O_ACCMODE
                    except OSError:
                        pass
                    else:
                        if ((opened.st_dev, opened.st_ino) == create_identity[0]
                                and access == os.O_RDONLY):
                            profile_sink_fstats.append(
                                ("post_retained" if retained_validated[0]
                                 else "retained", label))
            if retained_validated[0]:
                post_retained_effect(label)

        def path_value(value) -> Path | None:
            return Path(value) if type(value) is str or type(value) is path_type else None

        def record_sink(path: Path, *, output_path: bool) -> tuple[int, int] | None:
            active = audit_active[0]
            if not isinstance(active, dict): return None
            if output_path:
                outputs = active["provider_outputs"]; assert isinstance(outputs, list)
                if str(path) not in outputs: outputs.append(str(path))
            try: opened = path_originals["lstat"](path)
            except OSError: return None
            identities = active["sink_identities"]; assert isinstance(identities, list)
            identity = (opened.st_dev, opened.st_ino)
            if identity not in identities: identities.append(identity)
            return identity

        def root_effect(path: Path, operation: str) -> None:
            if not target_root or path != target_root[0] or injected[0]: return
            root_operations[0] += 1
            expected = {"root_validation_1": 1, "root_validation_2": 2}.get(stage)
            if expected == root_operations[0]:
                injected[0] = True
                raise OSError(f"H032 injected result-root validation {expected}:{operation}")

        def observe_mkdtemp(*args, **kwargs):
            value = Path(original_mkdtemp(*args, **kwargs)); allocations.append(value)
            if len(allocations) == result_root_ordinal: target_root.append(value)
            return str(value)

        def live_sink_aliases() -> list[tuple[int, int, int, int]]:
            aliases: list[tuple[int, int, int, int]] = []
            if not create_identity: return aliases
            # Use the saved concrete iterator so the judge's own alias inventory
            # cannot recursively trigger the subject-effect interception below.
            for fd_path in path_originals["iterdir"](Path("/dev/fd")):
                try:
                    fd = int(fd_path.name); opened = original_fstat(fd)
                    access = fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE
                except (OSError, ValueError): continue
                if (opened.st_dev, opened.st_ino) == create_identity[0]:
                    aliases.append((fd, opened.st_dev, opened.st_ino, access))
            return aliases

        def post_retained_effect(effect: str) -> None:
            if not retained_validated[0] or injected[0]: return
            ordinal = len(post_effects)
            post_effects.append(effect)
            stage_trace.append(f"post_retained:{ordinal}:{effect}")
            aliases = live_sink_aliases()
            for alias in aliases:
                if alias not in boundary_aliases: boundary_aliases.append(alias)
            if (stage == "post_retained_setup_effect"
                    and post_effect_target == ordinal):
                if not any(item[3] == os.O_RDONLY for item in aliases):
                    raise RuntimeError("post-retained effect lacks live retained sink capability")
                injected[0] = True
                raise OSError(f"H032 injected post-retained effect {ordinal}:{effect}")

        def wrap_path(name):
            original = path_originals[name]
            def wrapped(self, *args, _h032_effect_name=name, **kwargs):
                if not path_busy[0]:
                    root_effect(self, f"Path.{name}")
                    path_busy[0] = True
                    try: return original(self, *args, **kwargs)
                    finally: path_busy[0] = False
                return original(self, *args, **kwargs)
            return wrapped

        def wrap_helper(name):
            original = helper_originals[name]
            def wrapped(*args, _h032_effect_name=name, **kwargs):
                return original(*args, **kwargs)
            return wrapped

        def observe_open(path, flags, *args, **kwargs):
            candidate = path_value(path)
            is_child = bool(target_root and candidate is not None
                            and candidate.parent == target_root[0])
            if is_child and flags & os.O_CREAT:
                if stage in {"before_sink_create", "sink_open_raises"}:
                    injected[0] = True
                    raise OSError(f"H032 injected {stage}")
            if target_root and candidate == target_root[0]:
                root_effect(candidate, "os.open(root)")
            if is_child and (flags & os.O_ACCMODE) == os.O_RDONLY \
                    and stage == "after_create_close_before_retained":
                injected[0] = True
                raise OSError("H032 injected after writable create close")
            fd = original_open(path, flags, *args, **kwargs)
            if is_child and flags & os.O_CREAT:
                create_fd[0] = fd
                opened = original_fstat(fd); create_identity[:] = [(opened.st_dev, opened.st_ino)]
                record_sink(candidate, output_path=True)
            elif is_child and (flags & os.O_ACCMODE) == os.O_RDONLY:
                record_sink(candidate, output_path=True)
            return fd

        def observe_fsync(fd):
            if stage == "create_fd_fsync" and fd == create_fd[0] and not injected[0]:
                injected[0] = True
                raise OSError("H032 injected while product owns writable create fd")
            return original_fsync(fd)

        def observe_close(fd):
            if stage == "create_fd_close" and fd == create_fd[0] and not injected[0]:
                # The close is product-invoked and real; the injected failure is
                # after that syscall, never a judge pre-close of the returned fd.
                result = original_close(fd); injected[0] = True
                raise OSError("H032 injected after product close of writable create fd")
            return original_close(fd)

        def observe_fstat(fd):
            opened = original_fstat(fd)
            if create_identity and (opened.st_dev, opened.st_ino) == create_identity[0] \
                    and (fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE) == os.O_RDONLY:
                if not retained_validated[0]:
                    stage_trace.append("retained_fstat")
                    if stage == "retained_fd_fstat" and not injected[0]:
                        injected[0] = True
                        raise OSError("H032 injected retained sink fstat")
                    retained_validated[0] = True
            return opened

        def wrap_os(name):
            original = os_originals[name]
            def wrapped(*args, _h032_effect_name=name, **kwargs):
                return original(*args, **kwargs)
            return wrapped

        wrap_os_code = wrap_os(next(iter(os_originals))).__code__
        wrap_path_code = wrap_path(next(iter(path_originals))).__code__
        wrap_helper_code = (wrap_helper(next(iter(helper_originals))).__code__
                            if helper_originals else None)

        def observe_popen(argv, *args, **kwargs):
            flat = list(argv)
            if "-o" in flat and stage in {"popen_before_delegate", "discover_post_retained"}:
                sink = Path(flat[flat.index("-o") + 1]); identity = record_sink(sink, output_path=True)
                if identity is not None:
                    for alias in live_sink_aliases():
                        if alias not in boundary_aliases: boundary_aliases.append(alias)
                if any(item[3] == os.O_RDONLY for item in boundary_aliases):
                    stage_trace.append("popen_before_delegate")
                    injected[0] = True
                    raise OSError(f"H032 injected {stage} with retained sink capability")
            return original_popen(argv, *args, **kwargs)

        module.tempfile.mkdtemp = observe_mkdtemp
        for name in os_originals:
            observer = {"open": observe_open, "fsync": observe_fsync,
                        "fstat": observe_fstat, "close": observe_close}.get(name)
            setattr(module.os, name, observer if observer is not None else wrap_os(name))
        for name in helper_originals: setattr(module, name, wrap_helper(name))
        module.subprocess.Popen = observe_popen
        for name in path_originals: setattr(path_type, name, wrap_path(name))
        profile_state[0] = profile_effect
        if not profile_preinstalled:
            sys.setprofile(profile_router)
        try:
            outcome = attempt(case_repo)
        finally:
            profile_state[0] = None
            if not profile_preinstalled:
                sys.setprofile(previous_profile)
            module.tempfile.mkdtemp = original_mkdtemp
            for name, original in os_originals.items(): setattr(module.os, name, original)
            for name, original in helper_originals.items(): setattr(module, name, original)
            module.subprocess.Popen = original_popen
            for name, original in path_originals.items(): setattr(path_type, name, original)
        observed = last_attempt_observed[0] or {}
        case_capture = safe_capture()
        for key in ("provider_outputs", "canonical_paths", "private_paths",
                    "private_paths_present", "sink_identities", "sink_fd_aliases",
                    "journal_start_records"):
            case_capture["_gate_" + key.replace("provider_outputs", "output_paths")] = list(
                observed.get(key, []))
        case_capture["_gate_provider_process_starts"] = observed.get(
            "provider_process_starts", -1)
        case_capture["_gate_journal_append_valid"] = observed.get(
            "journal_append_valid", False)
        case_capture["_gate_journal_append_error"] = observed.get("journal_append_error")
        case_capture["_gate_boundary_sink_aliases"] = list(boundary_aliases)
        case_capture["_gate_create_fd_returned"] = create_fd[0] >= 0
        case_capture["_gate_setup_stage_trace"] = list(stage_trace)
        case_capture["_gate_profile_sink_fstats"] = list(profile_sink_fstats)
        journal_before = observed.get("journal_before", {})
        journal_after = observed.get("journal_after", {})
        case_capture["_gate_journal_preexisting_preserved"] = (
            isinstance(journal_before, dict) and isinstance(journal_after, dict)
            and journal_before.get("exists") is True
            and (journal_before.get("dev"), journal_before.get("ino"),
                 journal_before.get("mode"), journal_before.get("nlink")) ==
                (journal_after.get("dev"), journal_after.get("ino"),
                 journal_after.get("mode"), journal_after.get("nlink"))
            and stat.S_IMODE(int(journal_after.get("mode", 0)))
                == SAFE_ATTEMPT_JOURNAL_MODE
            and isinstance(journal_before.get("raw"), bytes)
            and isinstance(journal_after.get("raw"), bytes)
            and journal_after["raw"].startswith(journal_before["raw"]))
        output_paths = [Path(value) for value in case_capture["_gate_output_paths"]]
        canonical_paths = [Path(value) for value in case_capture["_gate_canonical_paths"]]
        case = (outcome, case_capture,
                any(path.exists() or path.is_symlink() for path in output_paths),
                any(path.exists() or path.is_symlink() for path in canonical_paths), False)
        arena = observed.get("arena")
        if isinstance(arena, Path):
            top_roots = {path for path in map(Path, observed.get("private_paths", []))
                         if path.parent == arena}
            for path in sorted(top_roots, key=lambda item: len(item.parts), reverse=True):
                if path.is_symlink() or (path.exists() and not path.is_dir()): path.unlink()
                elif path.is_dir(): path.chmod(0o700); shutil.rmtree(path)
        return (case, injected[0], [str(path) for path in target_root],
                root_operations[0], list(stage_trace), list(post_effects),
                {"direct_os": sorted(os_names), "direct_path": sorted(path_names),
                 "helper_count": len(helper_names),
                 "profile_c_count": len(c_capabilities),
                 "profile_code_count": len(code_capabilities),
                 "profile_has_os_fstat": "os.fstat" in c_capabilities.values(),
                 "profile_identity_sha256": hashlib.sha256("\n".join(sorted(
                     set(c_capabilities.values()) | set(code_capabilities.values())))
                     .encode("utf-8")).hexdigest()})

    discovery = (False, [], [], []); result_root_ordinal = 0
    setup_spawn_faults = {}; setup_spawn_faults_ok = False
    post_retained_discovery = None; post_retained_effects: list[str] = []
    post_retained_cases = {}; post_retained_omission_caught = False
    r59_repeated_fstat_connected = True; r59_zero_effect_reorder_connected = True
    r62_direct_helper_connected = True
    r59_variant_detail = {"skipped": True}
    if kernel_structure_ok and kernel_integration_structure_ok \
            and hasattr(module, "consume_private_result"):
        discovery = result_root_ordinal_discovery()
        discovery_ok = (discovery[0][0] and not discovery[0][4]
                        and len(discovery[2]) == 1 and len(discovery[3]) == 1)
        if discovery_ok:
            result_root_ordinal = discovery[3][0][0]
            stages = ("root_validation_1", "root_validation_2", "before_sink_create",
                      "sink_open_raises", "create_fd_fsync", "create_fd_close",
                      "after_create_close_before_retained", "retained_fd_fstat",
                      "popen_before_delegate")
            for stage in stages:
                setup_spawn_faults[stage] = setup_spawn_fault_case(stage, result_root_ordinal)
            post_retained_discovery = setup_spawn_fault_case(
                "discover_post_retained", result_root_ordinal)
            post_retained_effects = list(post_retained_discovery[5])
            for ordinal in range(len(post_retained_effects)):
                post_retained_cases[ordinal] = setup_spawn_fault_case(
                    "post_retained_setup_effect", result_root_ordinal,
                    post_effect_target=ordinal)
            precreate = {"root_validation_1", "root_validation_2",
                         "before_sink_create", "sink_open_raises"}
            create_owned = {"create_fd_fsync", "create_fd_close",
                            "after_create_close_before_retained", "retained_fd_fstat"}
            retained_owned = {"popen_before_delegate"}
            fixed_faults_ok = all(
                injected and roots
                and rejected_clean(case, expected_process_starts=0,
                                   expected_output_paths=(0 if stage in precreate else 1),
                                   expected_journal_starts=(0, 1))
                and (stage not in create_owned
                     or case[1].get("_gate_create_fd_returned") is True)
                and (stage not in retained_owned
                     or any(item[3] == os.O_RDONLY for item in
                            case[1].get("_gate_boundary_sink_aliases", [])))
                and (stage != "popen_before_delegate"
                     or trace[-1:] == ["popen_before_delegate"])
                for stage, (case, injected, roots, _ops, trace, _effects, _caps)
                in setup_spawn_faults.items())
            def post_matrix_valid(effects: list[str], cases: dict[int, tuple]) -> bool:
                if set(cases) != set(range(len(effects))): return False
                return all(
                    injected and roots and observed_effects == effects[:ordinal + 1]
                    and rejected_clean(case, expected_process_starts=0,
                                       expected_output_paths=1,
                                       expected_journal_starts=(0, 1))
                    and any(item[3] == os.O_RDONLY for item in
                            case[1].get("_gate_boundary_sink_aliases", []))
                    and trace[-1:] == [
                        f"post_retained:{ordinal}:{effects[ordinal]}"]
                    for ordinal, (case, injected, roots, _ops, trace,
                                  observed_effects, _caps) in cases.items())
            discovery_case, discovery_injected, discovery_roots, _discovery_ops, \
                discovery_trace, _discovery_effects, _discovery_caps = post_retained_discovery
            discovery_ok = (
                discovery_injected and discovery_roots
                and rejected_clean(discovery_case, expected_process_starts=0,
                                   expected_output_paths=1,
                                   expected_journal_starts=(0, 1))
                and discovery_trace[-1:] == ["popen_before_delegate"])
            post_matrix_ok = post_matrix_valid(post_retained_effects, post_retained_cases)
            if post_retained_effects:
                omitted = dict(post_retained_cases); omitted.pop(len(post_retained_effects) // 2)
                post_retained_omission_caught = not post_matrix_valid(
                    post_retained_effects, omitted)
            else:
                post_retained_omission_caught = post_matrix_valid([], {})
            setup_spawn_faults_ok = (fixed_faults_ok and discovery_ok
                                     and post_matrix_ok and post_retained_omission_caught)

            def schedule_variant_case(variant_text: str, label: str,
                                      *, inject_ordinal: int | None = None):
                global module
                variant_tree = ast.parse(variant_text)
                variant_name = f"h032_r59_{label}_{len(sys.modules)}"
                variant_spec = importlib.util.spec_from_loader(
                    variant_name, loader=None, origin=str(source))
                if variant_spec is None: raise RuntimeError("R59 variant spec unavailable")
                variant_module = importlib.util.module_from_spec(variant_spec)
                variant_module.__file__ = str(source)
                sys.modules[variant_name] = variant_module
                saved_module = module
                try:
                    if not _r125_early_controller_source_ok(variant_text):
                        raise RuntimeError("R59 variant capability inventory")
                    (_r125_variant_events, _r125_variant_rejection,
                     _r125_variant_loaders) = r125_observed_definition_exec(
                        variant_text, variant_module.__dict__, str(source))
                    if _r125_variant_rejection is not None or _r125_variant_events:
                        raise RuntimeError("R59 variant definition-time effect")
                    variant_module.now_id = fixture_now_id
                    module = variant_module
                    if inject_ordinal is None:
                        return setup_spawn_fault_case(
                            "discover_post_retained", result_root_ordinal,
                            effect_tree=variant_tree)
                    return setup_spawn_fault_case(
                        "post_retained_setup_effect", result_root_ordinal,
                        effect_tree=variant_tree, post_effect_target=inject_ordinal)
                finally:
                    module = saved_module
                    sys.modules.pop(variant_name, None)

            retained_line = "        sink_identity = os.fstat(sink_fd)\n"
            repeated_text = source_text.replace(
                retained_line, retained_line + "        os.fstat(sink_fd)\n", 1)
            repeated_shape_ok = repeated_text != source_text \
                and repeated_text.count("os.fstat(sink_fd)") \
                    == source_text.count("os.fstat(sink_fd)") + 1
            repeated_discovery = (schedule_variant_case(repeated_text, "repeat_discovery")
                                  if repeated_shape_ok else None)
            repeated_injection = (schedule_variant_case(
                repeated_text, "repeat_injection", inject_ordinal=0)
                if repeated_discovery is not None and repeated_discovery[5][:1] == ["os.fstat"]
                else None)
            r59_repeated_fstat_connected = bool(
                repeated_injection is not None and repeated_injection[1]
                and repeated_injection[5] == ["os.fstat"]
                and repeated_injection[4][-1:] == ["post_retained:0:os.fstat"]
                and repeated_injection[0][1].get("_gate_profile_sink_fstats")
                    == [("retained", "os.fstat"), ("post_retained", "os.fstat")]
                and rejected_clean(repeated_injection[0], expected_process_starts=0,
