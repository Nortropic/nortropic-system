    def kernel_structure_inventory(tree, raw_text):
        expected_args=["sink_fd","canonical_destination","invocation_id","run_id","role"]
        consumers=[node for node in tree.body if isinstance(node,ast.FunctionDef)
                   and node.name=="consume_private_result"]
        exports=[node for node in tree.body if isinstance(node,ast.Assign)
                 and len(node.targets)==1 and isinstance(node.targets[0],ast.Name)
