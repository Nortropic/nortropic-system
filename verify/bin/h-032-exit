    def strict_append_fixture(suffix: bytes, *, preexisting: bool = False,
                              replace: bool = False, truncate: bool = False,
                              chmod_mode: int | None = None):
        fixture_repo = make_repo(str(provider))
        path = module.journal_root(fixture_repo) / "events.jsonl"
