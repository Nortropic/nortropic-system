    def run_r74_environment_oracle(name: str, remove_current_effect: bool=False) -> dict[str,object]:
        # This is judge scheduling only.  Admission still comes exclusively
        # from the actual current run/capture/journal/output effects below.
        barrier_predecessor=r74_last_clock_id[0]
