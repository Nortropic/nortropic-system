"selected={'open','os.chmod','os.mkdir','os.remove','os.rmdir','os.rename','os.replace','os.link','os.symlink','os.listdir','os.scandir','os.putenv','os.unsetenv','subprocess.Popen','os.system','os.posix_spawn','os.fork','os.forkpty','pty.spawn'}\n"
"def loader_read(event,args):\n"
