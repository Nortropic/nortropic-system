"  print('R15_CANONICAL_TRANSITION '+json.dumps({'src':str(args[0]),'dst':str(args[1]),'dev':st.st_dev,'ino':st.st_ino,'mode':st.st_mode,'size':st.st_size,'read_size':len(raw),'digest':hashlib.sha256(raw).hexdigest()},separators=(',',':')),flush=True)\n"
"  transition_seen[0]=True\n"
" elif transition_seen[0] and event in {'os.remove','os.rename','open'} and args and str(args[0]).endswith('/result.json'):\n"
"  print('R16_CANONICAL_OBJECT_EVENT '+event+' '+str(args[0]),flush=True)\n"
" if event=='subprocess.Popen':\n"
"  for value in args:\n"
"   if isinstance(value,(list,tuple)) and '-o' in value:\n"
"    print('R13_OUTPUT_PATH '+str(value[value.index('-o')+1]),flush=True)\n"
"sys.addaudithook(audit)\n"
"print('R12_POPEN_TYPE='+subprocess.Popen.__module__+'.'+subprocess.Popen.__qualname__,flush=True)\n"
"try:\n"
" r=mod.run_codex(repo,wt,'TEST_AUTHOR','H032-R12')\n"
" print('R12_OUTCOME=ADMITTED',flush=True)\n"
"except Exception as exc:\n"
" print('R12_OUTCOME=REJECTED:'+type(exc).__name__+':'+str(exc),flush=True)\n", encoding="utf-8")
    # R126: R12 is a fresh ``-I -S`` interpreter, so its finite judge-owned
    # prewarm must include every stdlib module imported while the dependency
    # definition ticket is armed.  In particular, core executes
    # ``from __future__ import annotations`` and the admitted materializer
    # imports base64.  Loader reads remain narrowly limited to the exact local
    # dependency files; admitting arbitrary import-loader reads would hide an
    # unprewarmed candidate-triggered import.
    _R126_R12_PREWARM = (
        "__future__", "argparse", "base64", "datetime", "fcntl", "fnmatch",
        "hashlib", "importlib.util", "json", "os", "pathlib", "re", "shutil",
        "stat", "subprocess", "sys", "tempfile", "time", "types", "typing",
        "unicodedata", "dataclasses")
    _R126_R12_LOADER_SOURCE = (
        "def loader_read(event,args):\n"
        " if event not in {'open','os.listdir'} or not args or type(args[0]) not in {str,bytes}: return False\n"
        " try:\n"
        "  path=args[0].decode('utf-8') if type(args[0]) is bytes else args[0]\n"
        " except UnicodeDecodeError: return False\n"
        " frame=sys._getframe(1)\n"
        " while frame is not None:\n"
        "  if frame.f_code.co_filename in definition['subject_files']: return False\n"
        "  if frame.f_code.co_filename=='<frozen importlib._bootstrap_external>': break\n"
        "  frame=frame.f_back\n"
        " if frame is None: return False\n"
        " if event=='open': return len(args)>=3 and ((type(args[1]) is str and args[1]=='r') or args[1] is None) and type(args[2]) is int and args[2]==os.O_CLOEXEC and path in definition['loader_files']\n"
        " return path in definition['loader_dirs']\n")
    _r126_broad_loader_source = (
        "def loader_read(event,args):\n"
        " return event in {'open','os.listdir'}\n")
    _r126_r12_source = r12_runner.read_text(encoding="utf-8")
    def _r126_r12_source_ok(text):
        try:
            tree = ast.parse(text)
            first = tree.body[0]
            loaders = [node for node in tree.body
                       if isinstance(node, ast.FunctionDef)
                       and node.name == "loader_read"]
            audit_hooks = [index for index, node in enumerate(tree.body)
                if isinstance(node, ast.Expr) and isinstance(node.value, ast.Call)
                and isinstance(node.value.func, ast.Attribute)
                and isinstance(node.value.func.value, ast.Name)
                and node.value.func.value.id == "sys"
                and node.value.func.attr == "addaudithook"
                and len(node.value.args) == 1
                and isinstance(node.value.args[0], ast.Name)
                and node.value.args[0].id == "definition_audit"]
            expected_loader = ast.parse(_R126_R12_LOADER_SOURCE).body[0]
        except (SyntaxError, ValueError, TypeError, IndexError):
            return False
        return (isinstance(first, ast.Import)
            and tuple(alias.name for alias in first.names) == _R126_R12_PREWARM
            and all(alias.asname is None for alias in first.names)
            and len(audit_hooks) == 1
            and [node for node in tree.body[:audit_hooks[0]]
                 if isinstance(node, (ast.Import, ast.ImportFrom))] == [first]
            and len(loaders) == 1
            and ast.dump(loaders[0], include_attributes=False)
                == ast.dump(expected_loader, include_attributes=False))
    _r126_missing_future_source = _r126_r12_source.replace(
        "import __future__,", "import ", 1)
    _r126_missing_base64_source = _r126_r12_source.replace(
        ",base64,", ",", 1)
    _r126_broad_loader_mutant = _r126_r12_source.replace(
        _R126_R12_LOADER_SOURCE, _r126_broad_loader_source, 1)
    _r126_r12_source_controls = (
        _r126_r12_source.count(_R126_R12_LOADER_SOURCE) == 1
        and _r126_r12_source_ok(_r126_r12_source)
        and not _r126_r12_source_ok(_r126_missing_future_source)
        and not _r126_r12_source_ok(_r126_missing_base64_source)
        and not _r126_r12_source_ok(_r126_broad_loader_mutant))

    # Causal judge controls run in separate fresh system interpreters.  Each
    # missing-module case differs from the positive by one prewarm omission.
    # The broad-loader alternative demonstrates why swallowing unprewarmed
    # loader effects is unsafe, but the exact source predicate above rejects it.
    _r126_base64_dependency = work / "r126-base64-dependency.py"
    _r126_base64_dependency.write_text("import base64\n", encoding="utf-8")
    def _r126_prewarm_case(omitted=(), *, broad_loader=False):
        modules = tuple(name for name in _R126_R12_PREWARM if name not in omitted)
        loader_source = (_r126_broad_loader_source if broad_loader
                         else _R126_R12_LOADER_SOURCE)
        probe = work / ("r126-prewarm-" + "-".join(omitted or ("exact",))
                        + ("-broad" if broad_loader else "") + ".py")
        probe.write_text(
            "import " + ",".join(modules) + "\n"
            "core_path=pathlib.Path(sys.argv[1]);base64_path=pathlib.Path(sys.argv[2])\n"
            "sources=(('core',core_path,core_path.read_text(encoding='utf-8')),('base64',base64_path,base64_path.read_text(encoding='utf-8')))\n"
            "class DefinitionEffect(RuntimeError): pass\n"
            "definition={'active':False,'events':[],'loader':[],'subject_files':tuple(str(item[1]) for item in sources),'loader_files':tuple(str(item[1]) for item in sources),'loader_dirs':tuple(sorted({str(item[1].parent) for item in sources}|{str(item[1].parent.parent) for item in sources}))}\n"
            "selected={'open','os.chmod','os.mkdir','os.remove','os.rmdir','os.rename','os.replace','os.link','os.symlink','os.listdir','os.scandir','os.putenv','os.unsetenv','subprocess.Popen','os.system','os.posix_spawn','os.fork','os.forkpty','pty.spawn'}\n"
            + loader_source +
            "def definition_audit(event,args):\n"
            " if definition['active'] and (event in selected or event.startswith('os.exec') or event.startswith('os.spawn')):\n"
            "  if loader_read(event,args): definition['loader'].append(event);return\n"
            "  definition['events'].append(event);raise DefinitionEffect(event)\n"
            "sys.addaudithook(definition_audit)\n"
            "for name,path,text in sources:\n"
            " module=types.ModuleType('r126_'+name);definition['active']=True\n"
            " try: exec(compile(text,str(path),'exec'),module.__dict__)\n"
            " except DefinitionEffect as exc:\n"
            "  print('R126_DEPENDENCY_EFFECT='+name+':'+str(exc),flush=True);raise SystemExit(61 if name=='core' else 62)\n"
            " finally: definition['active']=False\n"
            "print('R126_EFFECT_COUNTS=%d:%d'%(len(definition['events']),len(definition['loader'])),flush=True)\n"
            "print('R126_POPEN_TYPE='+subprocess.Popen.__module__+'.'+subprocess.Popen.__qualname__,flush=True)\n"
            "proc=subprocess.Popen(['/usr/bin/true'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL);raise SystemExit(proc.wait())\n",
            encoding="utf-8")
        process = system_popen(
            ["/usr/bin/python3", "-I", "-S", "-u", str(probe),
             str(_r125_core_path), str(_r126_base64_dependency)],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        try:
            stdout, _ = process.communicate(timeout=20)
        except subprocess.TimeoutExpired:
            process.kill(); stdout, _ = process.communicate()
            return 124, stdout
        return process.returncode, stdout
    _r126_prewarm_positive = _r126_prewarm_case()
    _r126_missing_future = _r126_prewarm_case(("__future__",))
    _r126_missing_base64 = _r126_prewarm_case(("base64",))
    _r126_broad_unprewarmed = _r126_prewarm_case(
        ("__future__", "base64"), broad_loader=True)
    _r126_r12_prewarm_controls_ok = (
        _r126_r12_source_controls
        and _r126_prewarm_positive == (
            0, "R126_EFFECT_COUNTS=0:0\nR126_POPEN_TYPE=subprocess.Popen\n")
        and _r126_missing_future[0] == 61
        and "R126_DEPENDENCY_EFFECT=core:open" in _r126_missing_future[1]
        and "R126_POPEN_TYPE=" not in _r126_missing_future[1]
        and _r126_missing_base64[0] == 62
        and "R126_DEPENDENCY_EFFECT=base64:open" in _r126_missing_base64[1]
        and "R126_POPEN_TYPE=" not in _r126_missing_base64[1]
        and _r126_broad_unprewarmed[0] == 0
        and "R126_POPEN_TYPE=subprocess.Popen" in _r126_broad_unprewarmed[1]
        and re.search(r"R126_EFFECT_COUNTS=0:[1-9][0-9]*",
                      _r126_broad_unprewarmed[1]) is not None)
    def r12_provider(case: str) -> Path:
        directory = work / f"r12-provider-{case}-{len(list(work.glob('r12-provider-*')))}"; directory.mkdir()
        host = directory / "codex-code-mode-host"
        host.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8"); host.chmod(0o700)
        program = directory / "provider"
        payload = json.dumps({
            "role":"TEST_AUTHOR","outcome":"READY","summary":"r12 causal value",
            "changed_files":[],"blocking_findings":[],"tests":[],
            "allowed_write_violation":False,"frozen_artifacts_modified":False,
            "production_files_modified":False,"frozen_gate_ready":True,
            "baseline_red_for_right_reason":True,"owner_decision_required":False,
            "stop_reason":"NONE","next_action":"BUILD","next_task_id":"h-032",
            "candidate_delta":None,
        }, separators=(",", ":"))
        program.write_text("#!/usr/bin/python3\n" +
            "import json,pathlib,subprocess,sys,time\n" +
            f"case={case!r}; payload={payload!r}\n" +
            "subprocess.run([str(pathlib.Path(sys.argv[0]).parent/'codex-code-mode-host')],check=True)\n" +
            "out=pathlib.Path(sys.argv[sys.argv.index('-o')+1])\n" +
            "if case=='escape':\n"
            " print('R12_ESCAPE_SINK '+str(out),flush=True)\n"
            " first=__import__('os').fork()\n"
            " if first==0:\n"
            "  second=__import__('os').fork()\n"
            "  if second==0:\n"
            "   __import__('os').setsid()\n"
            "   while True:\n"
            "    try: out.parent.mkdir(parents=True,exist_ok=True);out.write_text('late')\n"
            "    except Exception: pass\n"
            "    time.sleep(.1)\n"
            "  __import__('os')._exit(0)\n"
            " __import__('os').waitpid(first,0);time.sleep(3600)\n" +
            "def emit(n,data):\n"
            " out.write_text(data); release='R12_RELEASE_%d'%n\n"
            " limit=time.monotonic()+15\n"
            " while out.read_text()==data:\n"
            "  if time.monotonic()>limit: raise SystemExit(71)\n"
            "  time.sleep(.01)\n"
            " if out.read_text()!=release: raise SystemExit(72)\n"
            " out.write_text(data)\n" +
            "emit(1,payload)\n" +
            "if case=='two':\n"
            " value=json.loads(payload);value['summary']='r12 second';emit(2,json.dumps(value,separators=(',',':')))\n" +
            "print(json.dumps({'type':'thread.started','thread_id':'r12-thread'}),flush=True)\n",
            encoding="utf-8")
        program.chmod(0o700)
        return program
    def r12_real_case(case: str, inject_promotion: bool = False,
                      subject_source: Path = source, sink_attack: str | None = None):
        fixture = r12_provider(case)
        fixture_host = fixture.parent / "codex-code-mode-host"
        case_repo = make_repo(str(fixture), sha256(fixture), str(fixture_host), sha256(fixture_host))
        env = {key:value for key,value in os.environ.items()
               if not key.startswith("H032_")}
        proc = system_popen(["/usr/bin/python3", "-I", "-S", "-u", str(r12_runner),
                             str(subject_source), str(case_repo), str(case_repo)], stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, env=env)
        assert proc.stdout is not None
        selector = selectors.DefaultSelector(); selector.register(proc.stdout, selectors.EVENT_READ)
        identities=[]; outcome="NO_OUTCOME"; popen_type=""; canonical_absent=False
        canonical_transitions=[]
        canonical_object_events=[]
        sink=None; canonical=None
        closed_handled=set()
        def handle_closed(number: int):
            nonlocal canonical_absent,canonical
            assert sink is not None
            fd=os.open(sink,os.O_RDONLY|getattr(os,"O_NOFOLLOW",0))
            before=os.fstat(fd); parts=[]; total=0
            while total <= MAX_RESULT_BYTES:
                chunk=os.read(fd,min(65536,MAX_RESULT_BYTES+1-total))
                if not chunk: break
                parts.append(chunk);total+=len(chunk)
            raw=b"".join(parts)
            if sink_attack == "swap":
                old=sink.with_name(sink.name+".held");sink.rename(old);sink.write_bytes(raw)
            elif sink_attack == "mutate":
                alternate=strict_json(raw.decode("utf-8"))
                alternate["summary"]=alternate["summary"][::-1]
                alternate_raw=json.dumps(alternate,separators=(",",":")).encode()
                if len(alternate_raw)!=len(raw) or hashlib.sha256(alternate_raw).digest()==hashlib.sha256(raw).digest():
                    raise RuntimeError("R15 equal-length mutation fixture invalid")
                writer=os.open(sink,os.O_WRONLY|getattr(os,"O_NOFOLLOW",0))
                os.write(writer,alternate_raw);os.fsync(writer);os.close(writer)
            after=os.fstat(fd);os.close(fd)
            value=strict_json(raw.decode("utf-8"))
            identities.append((before.st_dev,before.st_ino,before.st_mode,before.st_size,
                               before.st_mtime_ns,before.st_ctime_ns,
