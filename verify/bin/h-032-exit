        if g20_ok:
            evidence = dict(binding, g20_effect_result="PASS", write_denied="YES",
                chmod_denied="YES", unlink_denied="YES", rename_denied="YES",
                host_write_denied="YES", host_chmod_denied="YES",
                host_unlink_denied="YES", host_rename_denied="YES",
                create_replacement_denied="YES", parent_rename_denied="YES",
