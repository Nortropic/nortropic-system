def observe_existing_canonical(reason):
 try:
  current=original_lstat(canonical)
  if not stat.S_ISREG(current.st_mode):
   canonical_epochs.append({"reason":reason,"kind":"nonregular","dev":current.st_dev,"ino":current.st_ino})
   return
  flags=os.O_RDONLY|getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0)
  ticket=make_ticket("canonical_epoch_open","original_os_open","open",(lexical_path(canonical),),flags,None,None,None)
  fd=original_os_open(canonical,flags);require_ticket_consumed(ticket)
  try:
   before=original_fstat(fd);data=b""
   while len(data)<=5*1024*1024:
    chunk=os.read(fd,min(65536,5*1024*1024+1-len(data)))
    if not chunk: break
    data+=chunk
   after=original_fstat(fd)
  finally: os.close(fd)
  epoch={"reason":reason,"kind":"regular","dev":before.st_dev,"ino":before.st_ino,
         "size":before.st_size,"digest":hashlib.sha256(data).hexdigest(),
         "stable":(before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns,before.st_ctime_ns)==(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns,after.st_ctime_ns)}
  if not canonical_epochs or any(epoch.get(key)!=canonical_epochs[-1].get(key) for key in ("dev","ino","digest")):
   canonical_epochs.append(epoch)
 except FileNotFoundError: pass
def fd_snapshot(fd):
 before=original_fstat(fd)
 if not stat.S_ISREG(before.st_mode) or before.st_size>5*1024*1024: return None
 read_fd=fd;close_read=False
 if fcntl.fcntl(fd,fcntl.F_GETFL)&os.O_ACCMODE==os.O_WRONLY:
  path=fd_path(fd);flags=os.O_RDONLY|getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0)
  if path is None: return None
  ticket=make_ticket("fsync_snapshot_open","original_os_open","open",(path,),flags,None,None,None)
  try: read_fd=original_os_open(path,flags);require_ticket_consumed(ticket)
  except OSError:
   if ticket in ticket_queue(): ticket_queue().remove(ticket)
   return None
  close_read=True
  opened=original_fstat(read_fd)
  if (opened.st_dev,opened.st_ino)!=(before.st_dev,before.st_ino):
   os.close(read_fd);return None
 try:
  data=b"";offset=0
  while len(data)<=5*1024*1024:
   chunk=os.pread(read_fd,min(65536,5*1024*1024+1-len(data)),offset)
   if not chunk: break
   data+=chunk;offset+=len(chunk)
 finally:
  if close_read: os.close(read_fd)
 after=original_fstat(fd);identity=(before.st_dev,before.st_ino)
 return {"dev":before.st_dev,"ino":before.st_ino,"size":before.st_size,
         "digest":hashlib.sha256(data).hexdigest(),"mtime_ns":before.st_mtime_ns,
         "ctime_ns":before.st_ctime_ns,"version":mutation_versions.get(identity,0),
         "stable":(before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns,before.st_ctime_ns)==
                  (after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns,after.st_ctime_ns)}
