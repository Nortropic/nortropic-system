"for relative,name in dependency_names.items(): install_dependency(relative,name)\n"
"if definition['events']: raise RuntimeError('dependency definition-time effect')\n"
"raw=source.read_bytes()\n"
"if hashlib.sha256(raw).hexdigest()!=expected_digest: raise RuntimeError('controller digest drift')\n"
"try: checked_text=raw.decode('utf-8')\n"
