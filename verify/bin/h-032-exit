        "HOST_SHA_WRONG_LENGTH": json.dumps({**authority_document(str(provider)),"code_mode_host_sha256":"a"*63}),
        "HOST_SHA_NONHEX": json.dumps({**authority_document(str(provider)),"code_mode_host_sha256":"g"*64}),
        "DUPLICATE_PATH": json.dumps(authority_document(str(provider))).replace('"executable_path":', '"executable_path":"/first","executable_path":', 1),
        "DUPLICATE_SHA": json.dumps(authority_document(str(provider))).replace('"executable_sha256":', '"executable_sha256":"' + good_hash + '","executable_sha256":', 1),
        "DUPLICATE_HOST_PATH": json.dumps(authority_document(str(provider))).replace('"code_mode_host_path":', '"code_mode_host_path":"/first","code_mode_host_path":', 1),
        "DUPLICATE_HOST_SHA": json.dumps(authority_document(str(provider))).replace('"code_mode_host_sha256":', '"code_mode_host_sha256":"' + host_good_hash + '","code_mode_host_sha256":', 1),
        "BROKEN_JSON": "{",
    }
    for name, raw in authority_negative.items():
        shape, why = authority_shape(raw)
        check("J_" + name, not shape, f"strict_shape={shape}:{why}")
        cases.append((name, make_raw_repo(raw)))

    results = {}
    for name, repo in cases:
        result = attempt(repo); results[name] = result
        check("K_" + name, family_absent or (not result[0] and result[2] == 0
              and result[3] == 0 and not result[4]), f"result={result}")

    provider.write_bytes(good_bytes); provider.chmod(0o700)
    hardlink = provider_dir / "hardlink-provider"; os.link(provider, hardlink)
    hardlink_result = attempt(make_repo(str(hardlink)))
    check("K_HARDLINK_ALLOWED", family_absent or hardlink_result[0], f"result={hardlink_result}")

    # Fresh validation must occur at every launch in the same imported process.
    provider.write_bytes(good_bytes); provider.chmod(0o700)
    fresh_provider_repo = make_repo(str(provider))
    first = attempt(fresh_provider_repo)
    provider.write_bytes(good_bytes + b"\n# provider drift\n"); provider.chmod(0o700)
    second = attempt(fresh_provider_repo)
    check("K_FRESH_PROVIDER", family_absent or (first[0] and not second[0]
          and second[2] == 0 and second[3] == 0 and not second[4]),
          f"first={first} second_after_drift={second}")

    provider.write_bytes(good_bytes); provider.chmod(0o700)
    fresh_authority_repo = make_repo(str(provider))
    first_authority = attempt(fresh_authority_repo)
    (fresh_authority_repo / "config/codex-provider-identity.json").write_text(
        json.dumps({**authority_document(str(provider)),
                    "executable_sha256":"0"*64}), encoding="utf-8")
    second_authority = attempt(fresh_authority_repo)
    check("K_FRESH_AUTHORITY", family_absent or (first_authority[0] and not second_authority[0]
          and second_authority[2] == 0 and second_authority[3] == 0
          and not second_authority[4]),
          f"first={first_authority} second_after_authority_drift={second_authority}")

    # GR-01: replace the authority pathname immediately AFTER an opened source
    # object has been returned. A safe implementation continues from that open
    # object; a path-reopen implementation observes B and cannot execute it.
    provider.write_bytes(good_bytes); provider.chmod(0o700)
    source_b = provider_dir / "source-b"
    source_b.write_text("#!/bin/sh\ntouch \"$H032_B_EXECUTED\"\nexit 0\n", encoding="utf-8")
    source_b.chmod(0o700)
    b_marker = work / "UNVERIFIED_B_EXECUTED"
    os.environ["H032_B_EXECUTED"] = str(b_marker)
    race_repo = make_repo(str(provider))
    original_builtin_open, original_io_open, original_os_open = builtins.open, io.open, os.open
    swapped = [False]
    def swap_after_open(file, *args, **kwargs):
        f = original_io_open(file, *args, **kwargs)
        try: same = Path(file) == provider
        except TypeError: same = False
        mode = args[0] if args else kwargs.get("mode", "r")
        if same and "r" in str(mode) and not swapped[0]:
            os.replace(source_b, provider); swapped[0] = True
        return f
    def swap_after_builtin_open(file, *args, **kwargs):
        f = original_builtin_open(file, *args, **kwargs)
        try: same = Path(file) == provider
        except TypeError: same = False
        mode = args[0] if args else kwargs.get("mode", "r")
        if same and "r" in str(mode) and not swapped[0]:
            os.replace(source_b, provider); swapped[0] = True
        return f
    def swap_after_os_open(file, flags, *args, **kwargs):
        fd = original_os_open(file, flags, *args, **kwargs)
        try: same = Path(file) == provider
        except TypeError: same = False
        if same and not (flags & os.O_WRONLY) and not (flags & os.O_RDWR) and not swapped[0]:
            os.replace(source_b, provider); swapped[0] = True
        return fd
    builtins.open, io.open, os.open = swap_after_builtin_open, swap_after_open, swap_after_os_open
    try:
        race_result = attempt(race_repo)
    finally:
        builtins.open, io.open, os.open = original_builtin_open, original_io_open, original_os_open
    race_cap = json.loads(capture.read_text()) if capture.exists() else {}
    check("K_SOURCE_PATH_REOPEN_RACE", family_absent or (swapped[0] and race_result[0]
          and race_cap.get("sha256") == good_hash and not b_marker.exists()),
          f"path_replaced={swapped[0]} result={race_result} executed_sha={race_cap.get('sha256')} b={b_marker.exists()}")

    # The required sibling is independently bound to the same opened object;
    # replacing its source pathname after open must not change copied bytes.
    provider.write_bytes(good_bytes); provider.chmod(0o700)
    check("J_HOST_RACE_PROVIDER_FIXTURE_ISOLATED",
          hashlib.sha256(provider.read_bytes()).hexdigest() == good_hash,
          "provider restored before host source race")
    code_mode_host.write_bytes(host_good_bytes); code_mode_host.chmod(0o700)
    host_source_b = provider_dir / "host-source-b"
    host_source_b.write_bytes(host_good_bytes + b"unverified-b")
    host_source_b.chmod(0o700)
    host_race_repo = make_repo(str(provider))
    original_builtin_open, original_io_open, original_os_open = builtins.open, io.open, os.open
    host_swapped = [False]
    def host_swap_after_open(file, *args, **kwargs):
        f = original_io_open(file, *args, **kwargs)
        mode = args[0] if args else kwargs.get("mode", "r")
        try: same = Path(file) == code_mode_host
        except TypeError: same = False
        if same and "r" in str(mode) and not host_swapped[0]:
            os.replace(host_source_b, code_mode_host); host_swapped[0] = True
        return f
    def host_swap_after_builtin_open(file, *args, **kwargs):
        f = original_builtin_open(file, *args, **kwargs)
        mode = args[0] if args else kwargs.get("mode", "r")
        try: same = Path(file) == code_mode_host
        except TypeError: same = False
        if same and "r" in str(mode) and not host_swapped[0]:
            os.replace(host_source_b, code_mode_host); host_swapped[0] = True
        return f
    def host_swap_after_os_open(file, flags, *args, **kwargs):
        fd = original_os_open(file, flags, *args, **kwargs)
        try: same = Path(file) == code_mode_host
        except TypeError: same = False
        if (same and not (flags & os.O_WRONLY)
                and not (flags & os.O_RDWR) and not host_swapped[0]):
            os.replace(host_source_b, code_mode_host); host_swapped[0] = True
        return fd
    builtins.open, io.open, os.open = host_swap_after_builtin_open, host_swap_after_open, host_swap_after_os_open
    try:
        host_race_result = attempt(host_race_repo)
    finally:
        builtins.open, io.open, os.open = original_builtin_open, original_io_open, original_os_open
    host_race_cap = json.loads(capture.read_text()) if capture.exists() else {}
    check("K_CODE_MODE_HOST_SOURCE_REOPEN_RACE", family_absent or (
          host_swapped[0] and host_race_result[0]
          and host_race_cap.get("host_sha256") == host_good_hash),
          f"path_replaced={host_swapped[0]} result={host_race_result} host_sha={host_race_cap.get('host_sha256')}")
    code_mode_host.write_bytes(host_good_bytes); code_mode_host.chmod(0o700)

    # A stale lstat/stat/access decision on the host pathname cannot replace
    # fstat regular+executable identity on the exact no-follow opened fd.
    provider.write_bytes(good_bytes); provider.chmod(0o700)
    check("J_HOST_IDENTITY_PROVIDER_FIXTURE_ISOLATED",
          hashlib.sha256(provider.read_bytes()).hexdigest() == good_hash,
          "provider restored before host opened-identity control")
    host_same_bytes = provider_dir / "host-same-bytes"
    host_same_bytes.write_bytes(host_good_bytes); host_same_bytes.chmod(0o600)
    host_identity_repo = make_repo(str(provider))
    original_stat, original_lstat, original_fstat, original_access = (
        os.stat, os.lstat, os.fstat, os.access)
    host_identity = original_stat(code_mode_host, follow_symlinks=False)
    host_target_text = os.fspath(code_mode_host)
    host_stat_swapped = [False]
    host_opened_checks: list[tuple[bool, bool]] = []
    def swap_host_after_stat(path, *args, **kwargs):
        result = original_stat(path, *args, **kwargs)
        if os.fspath(path) == host_target_text and not host_stat_swapped[0]:
            code_mode_host.unlink(); code_mode_host.symlink_to(host_same_bytes)
            host_stat_swapped[0] = True
        return result
    def swap_host_after_lstat(path, *args, **kwargs):
        result = original_lstat(path, *args, **kwargs)
        if os.fspath(path) == host_target_text and not host_stat_swapped[0]:
            code_mode_host.unlink(); code_mode_host.symlink_to(host_same_bytes)
            host_stat_swapped[0] = True
        return result
    def swap_host_after_access(path, mode, *args, **kwargs):
        result = original_access(path, mode, *args, **kwargs)
        if os.fspath(path) == host_target_text and not host_stat_swapped[0]:
            code_mode_host.unlink(); code_mode_host.symlink_to(host_same_bytes)
            host_stat_swapped[0] = True
        return result
    def observe_host_fstat(fd, *args, **kwargs):
        result = original_fstat(fd, *args, **kwargs)
        if (result.st_dev, result.st_ino) == (host_identity.st_dev, host_identity.st_ino):
            host_opened_checks.append((stat.S_ISREG(result.st_mode), bool(result.st_mode & 0o111)))
        return result
    os.stat, os.lstat, os.fstat, os.access = (
        swap_host_after_stat, swap_host_after_lstat, observe_host_fstat, swap_host_after_access)
    try:
        host_identity_result = attempt(host_identity_repo)
    finally:
        os.stat, os.lstat, os.fstat, os.access = (
            original_stat, original_lstat, original_fstat, original_access)
    host_identity_ok = (bool(host_opened_checks)
                        and all(regular and executable for regular, executable in host_opened_checks)
                        and ((host_stat_swapped[0] and not host_identity_result[0]
                              and host_identity_result[2] == 0 and not host_identity_result[4])
                             or (not host_stat_swapped[0] and host_identity_result[0])))
    check("K_CODE_MODE_HOST_OPENED_REGULAR_EXECUTABLE_IDENTITY",
          family_absent or host_identity_ok,
          f"opened_checks={host_opened_checks} stale_path_swap={host_stat_swapped[0]} result={host_identity_result}")
    if code_mode_host.is_symlink(): code_mode_host.unlink()
    code_mode_host.write_bytes(host_good_bytes); code_mode_host.chmod(0o700)

    # A regular-looking path swapped to a symlink after path-stat must not gain
    # trust. This requires the regular-file decision on the opened object plus
    # no-follow authority-path semantics.
    provider.write_bytes(good_bytes); provider.chmod(0o700)
    same_bytes_target = provider_dir / "same-bytes-target"
    same_bytes_target.write_bytes(good_bytes); same_bytes_target.chmod(0o700)
    opened_identity_repo = make_repo(str(provider))
    original_stat, original_lstat, original_fstat = os.stat, os.lstat, os.fstat
    stat_swapped = [False]
    opened_object_regular_checks = []
    provider_identity = original_stat(provider, follow_symlinks=False)
    target_text = os.fspath(provider)
    def swap_after_stat(path, *args, **kwargs):
        result = original_stat(path, *args, **kwargs)
        if os.fspath(path) == target_text and not stat_swapped[0]:
            provider.unlink(); provider.symlink_to(same_bytes_target); stat_swapped[0] = True
        return result
    def swap_after_lstat(path, *args, **kwargs):
        result = original_lstat(path, *args, **kwargs)
        if os.fspath(path) == target_text and not stat_swapped[0]:
            provider.unlink(); provider.symlink_to(same_bytes_target); stat_swapped[0] = True
        return result
    def observe_fstat(fd, *args, **kwargs):
        result = original_fstat(fd, *args, **kwargs)
        if (result.st_dev, result.st_ino) == (provider_identity.st_dev, provider_identity.st_ino):
            opened_object_regular_checks.append(
                stat.S_ISREG(result.st_mode))
        return result
    os.stat, os.lstat, os.fstat = swap_after_stat, swap_after_lstat, observe_fstat
    try:
        opened_identity_result = attempt(opened_identity_repo)
    finally:
        os.stat, os.lstat, os.fstat = original_stat, original_lstat, original_fstat
    opened_identity_ok = (bool(opened_object_regular_checks)
                          and all(opened_object_regular_checks)
                          and ((stat_swapped[0] and not opened_identity_result[0]
                                and opened_identity_result[2] == 0)
                               or (not stat_swapped[0] and opened_identity_result[0])))
    check("K_OPENED_REGULAR_IDENTITY", family_absent or opened_identity_ok,
          f"opened_regular_checks={opened_object_regular_checks} path_swapped_to_symlink={stat_swapped[0]} result={opened_identity_result}")
    if provider.is_symlink(): provider.unlink()

    # R4-GR05: observe the complete ordered protection/read trace through the
    # actual Popen boundary. A read is authoritative only when it consumes the
    # whole exact member after the LAST chmod/fchmod transition affecting the
    # root or either member. Decoy protect/unprotect/reprotect sequences cannot
    # satisfy this causal relation. Path.chmod, os.chmod and os.fchmod converge
    # on the same observer.
    provider.write_bytes(good_bytes); provider.chmod(0o700)
    code_mode_host.write_bytes(host_good_bytes); code_mode_host.chmod(0o700)
    trace_repo = make_repo(str(provider))
    trace_seq = [0]
    transitions: list[tuple[int, str, int]] = []
    complete_reads: dict[str, list[int]] = {"provider": [], "codex-code-mode-host": []}
    complete_hashes: dict[str, list[int]] = {"provider": [], "codex-code-mode-host": []}
    trace_verdict: list[bool] = []
    fd_paths: dict[int, Path] = {}
    fd_bytes: dict[int, bytearray] = {}
    writable_fds: set[int] = set()
    writable_handles: set[int] = set()
    originals = (builtins.open, io.open, os.open, os.read, os.close,
                 os.chmod, os.fchmod, subprocess.Popen)
    original_builtin_open, original_io_open, original_os_open, original_os_read, original_os_close, original_chmod, original_fchmod, original_popen = originals
    original_sha256 = hashlib.sha256
    expected_by_name = {"provider": good_hash, "codex-code-mode-host": host_good_hash}
    def tick() -> int:
        trace_seq[0] += 1; return trace_seq[0]
    def member_path(value) -> Path | None:
        try: path = Path(value)
        except Exception: return None
        return path if path.name in expected_by_name and path != provider else None
    def record_complete(path: Path, payload: bytes) -> None:
        if original_sha256(payload).hexdigest() == expected_by_name[path.name]:
            complete_reads[path.name].append(tick())
    class TracedHash:
        def __init__(self, data=b""):
            self._hash, self._payload, self._recorded = original_sha256(data), bytearray(data), False
        def update(self, data): self._payload.extend(data); return self._hash.update(data)
        def _record(self):
            if not self._recorded:
                digest = self._hash.hexdigest()
                for name, expected in expected_by_name.items():
                    if digest == expected: complete_hashes[name].append(tick())
                self._recorded = True
        def hexdigest(self): self._record(); return self._hash.hexdigest()
        def digest(self): self._record(); return self._hash.digest()
        def copy(self): return self._hash.copy()
        @property
        def digest_size(self): return self._hash.digest_size
        @property
        def block_size(self): return self._hash.block_size
        @property
        def name(self): return self._hash.name
    def traced_sha256(data=b""): return TracedHash(data)
    class TracedFile:
        def __init__(self, handle, path: Path, writable: bool = False):
            self._handle, self._path, self._payload = handle, path, bytearray()
            self._writer = writable
            if writable: writable_handles.add(id(self))
            try: self._from_zero = handle.tell() == 0
            except Exception: self._from_zero = False
        def read(self, *args, **kwargs):
            data = self._handle.read(*args, **kwargs)
            if self._from_zero and isinstance(data, bytes):
                self._payload.extend(data)
                try: complete = self._handle.tell() == os.fstat(self._handle.fileno()).st_size
                except Exception: complete = False
                if complete: record_complete(self._path, bytes(self._payload)); self._from_zero = False
            return data
        def __enter__(self): return self
        def close(self): writable_handles.discard(id(self)); return self._handle.close()
        def __exit__(self, *args): writable_handles.discard(id(self)); return self._handle.__exit__(*args)
        def __iter__(self): return iter(self._handle)
        def __getattr__(self, name): return getattr(self._handle, name)
    def traced_open(original, file, *args, **kwargs):
        handle = original(file, *args, **kwargs)
        path = member_path(file)
        mode = args[0] if args else kwargs.get("mode", "r")
        writable = any(token in str(mode) for token in ("w", "a", "+", "x"))
        return TracedFile(handle, path, writable) if path is not None else handle
    def traced_builtin_open(file, *args, **kwargs): return traced_open(original_builtin_open, file, *args, **kwargs)
    def traced_io_open(file, *args, **kwargs): return traced_open(original_io_open, file, *args, **kwargs)
    def traced_os_open(file, flags, *args, **kwargs):
        fd = original_os_open(file, flags, *args, **kwargs); path = member_path(file)
        if path is not None and not (flags & os.O_WRONLY) and not (flags & os.O_RDWR):
            fd_paths[fd], fd_bytes[fd] = path, bytearray()
        if path is not None and ((flags & os.O_WRONLY) or (flags & os.O_RDWR)):
            writable_fds.add(fd)
        return fd
    def traced_os_read(fd, size):
        data = original_os_read(fd, size)
        if fd in fd_paths:
            fd_bytes[fd].extend(data)
            if not data or len(fd_bytes[fd]) == os.fstat(fd).st_size:
                record_complete(fd_paths[fd], bytes(fd_bytes[fd])); fd_paths.pop(fd, None); fd_bytes.pop(fd, None)
        return data
    def traced_os_close(fd):
        fd_paths.pop(fd, None); fd_bytes.pop(fd, None); writable_fds.discard(fd); return original_os_close(fd)
    def relevant_transition(path: Path) -> bool:
        return path.name in expected_by_name or (path.is_dir()
            and (path / "provider").exists() and (path / "codex-code-mode-host").exists())
    def traced_chmod(path, mode, *args, **kwargs):
        result = original_chmod(path, mode, *args, **kwargs); p = Path(path)
        if relevant_transition(p): transitions.append((tick(), str(p), mode & 0o777))
        return result
    def traced_fchmod(fd, mode):
        result = original_fchmod(fd, mode)
        try: p = Path(os.readlink(f"/dev/fd/{fd}"))
        except Exception: return result
        if relevant_transition(p): transitions.append((tick(), str(p), mode & 0o777))
        return result
    def traced_popen(argv, *args, **kwargs):
        items = argv if isinstance(argv, (list, tuple)) else [argv]
        candidates = [Path(item) for item in items if isinstance(item, (str, os.PathLike))
                      and Path(item).name == "provider"]
        for snapshot in candidates:
            host = snapshot.parent / "codex-code-mode-host"; root = snapshot.parent
            if host.is_file():
                last_transition = max((seq for seq, path, mode in transitions
                    if Path(path) in {root, snapshot, host}), default=-1)
                protected = all((p.stat().st_mode & 0o222) == 0 for p in (root, snapshot, host))
                identities = {(p.stat().st_dev, p.stat().st_ino) for p in (snapshot, host)}
                live_writable_aliases = []
                for fd_entry in Path("/dev/fd").iterdir():
                    try:
                        fd = int(fd_entry.name); opened = os.fstat(fd)
                        access_mode = fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE
                        if ((opened.st_dev, opened.st_ino) in identities
                                and access_mode in {os.O_WRONLY, os.O_RDWR}):
                            live_writable_aliases.append(fd)
                    except (OSError, ValueError): pass
                fresh = all(complete_reads[name] and complete_reads[name][-1] > last_transition
                            and complete_hashes[name] and complete_hashes[name][-1] > last_transition
                            for name in expected_by_name)
                trace_verdict.append(protected and fresh and not live_writable_aliases)
        return original_popen(argv, *args, **kwargs)
    builtins.open, io.open, os.open, os.read, os.close, os.chmod, os.fchmod, subprocess.Popen = (
        traced_builtin_open, traced_io_open, traced_os_open, traced_os_read, traced_os_close,
        traced_chmod, traced_fchmod, traced_popen)
    hashlib.sha256 = traced_sha256
    try:
        trace_result = attempt(trace_repo)
    finally:
        builtins.open, io.open, os.open, os.read, os.close, os.chmod, os.fchmod, subprocess.Popen = originals
        hashlib.sha256 = original_sha256
    trace_ok = (trace_result[0] and trace_result[2] == 1 and trace_verdict == [True])
    check("K_FINAL_SNAPSHOT_REHASH", family_absent or trace_ok,
          f"trace={trace_verdict} transitions={transitions} reads={complete_reads} hashes={complete_hashes} writable_fds={writable_fds} writable_handles={writable_handles} result={trace_result}")
    check("K_CODE_MODE_HOST_FINAL_REHASH", family_absent or trace_ok,
          f"host_reads={complete_reads['codex-code-mode-host']} trace={trace_verdict}")
    check("K_PROVIDER_LAUNCH_ADJACENT_FINAL_REHASH", family_absent or trace_ok,
          f"provider_reads={complete_reads['provider']} trace={trace_verdict}")
    check("K_POST_SNAPSHOT_FAILURE_CLEANUP", family_absent or (trace_ok and not trace_result[4]),
          f"successful_trace={trace_ok} success_artifacts={trace_result[4]}")
    check("K_PROVIDER_POST_SNAPSHOT_FAILURE_CLEANUP", family_absent or (trace_ok and not trace_result[4]),
          f"successful_trace={trace_ok} success_artifacts={trace_result[4]}")

    # R5-GR05-01: connected physical corruption, independently for each
    # member. Mutation occurs after protection and immediately before the
    # first final read of that same snapshot. If no such read exists, Popen is
    # the fallback mutation point. Cached bytes, ceremonial hashes or ignored
    # comparisons therefore execute a capture marker and fail this oracle.
    def connected_corruption(target_name: str, marker: Path, duplicate_ro: bool = False,
                             openat_ro: bool = False, positional_ro: bool = False,
                             fdopen_preseed: bool = False,
                             fdopen_detach_preseed: bool = False,
                             fdopen_raw_preseed: bool = False,
                             fd_reuse_control: bool = False):
        provider.write_bytes(good_bytes); provider.chmod(0o700)
        code_mode_host.write_bytes(host_good_bytes); code_mode_host.chmod(0o700)
        target_repo = make_repo(str(provider))
        changed, targets = [False], []
        original_builtin, original_io, original_os, original_read, original_fdopen, original_chmod_local, original_fchmod_local, original_popen_local = (
            builtins.open, io.open, os.open, os.read, os.fdopen, os.chmod, os.fchmod, subprocess.Popen)
        preseed_handles: dict[int, object] = {}
        preseed_owners: list[object] = []
        reuse_observation: list[tuple[bytes, bool, bool]] = []
        unrelated = work / f"UNRELATED_REUSE_{target_name}"
        unrelated.write_bytes(b"U")
        bad = (f"#!/bin/sh\nprintf 'bad\\n' >'{marker}'\nexit 0\n").encode()
        def candidate(value):
            try: path = Path(value)
            except Exception: return None
            root = path.parent
            return path if (path.name == target_name and path != provider
                and (root / "provider").exists() and (root / "codex-code-mode-host").exists()) else None
        def protected(path: Path) -> bool: return (path.parent.stat().st_mode & 0o222) == 0
        def fd_target(fd):
            try:
                opened = os.fstat(fd)
                for path in (targets_by_root[0] if targets_by_root else []):
                    current = path.stat()
                    if (opened.st_dev, opened.st_ino) == (current.st_dev, current.st_ino): return path
            except OSError: pass
            return None
        targets_by_root: list[list[Path]] = []
        def mutate(path: Path):
            original_chmod(path, 0o700)
            with original_io(path, "wb") as handle: handle.write(bad)
            targets.append(path); changed[0] = True
        def exercise_fd_reuse(fd: int, path: Path) -> None:
            if not fd_reuse_control or reuse_observation or not protected(path): return
            snapshot_fd = os.dup(fd)
            original_number = fd
            os.close(original_number)
            unrelated_fd = original_os(unrelated, os.O_RDONLY)
            if unrelated_fd != original_number:
                os.dup2(unrelated_fd, original_number); os.close(unrelated_fd)
            before = changed[0]
            unrelated_bytes = original_read(original_number, 1)
            reuse_observation.append((unrelated_bytes, before, changed[0]))
            os.close(original_number)
            os.dup2(snapshot_fd, original_number); os.close(snapshot_fd)
        class CorruptRead:
            def __init__(self, handle, path): self._handle, self._path = handle, path
            def _before(self):
                path = fd_target(self._handle.fileno())
                if path is not None:
                    exercise_fd_reuse(self._handle.fileno(), path)
                    if protected(path) and not changed[0]: mutate(path)
            def read(self, *args, **kwargs):
                self._before()
                return self._handle.read(*args, **kwargs)
            def readinto(self, buffer):
                self._before()
                return self._handle.readinto(buffer)
            def read1(self, *args):
                self._before()
                return self._handle.read1(*args)
            def readinto1(self, buffer):
                self._before()
                return self._handle.readinto1(buffer)
            def detach(self):
                return CorruptRead(self._handle.detach(), None)
            @property
            def raw(self):
                return CorruptRead(self._handle.raw, None)
            def __enter__(self): return self
            def __exit__(self, *args): return self._handle.__exit__(*args)
            def __getattr__(self, name): return getattr(self._handle, name)
        def wrap_open(original, file, *args, **kwargs):
            mode = args[0] if args else kwargs.get("mode", "r")
            path = candidate(file)
            if path is not None and not targets_by_root:
                targets_by_root.append([path.parent / "provider", path.parent / "codex-code-mode-host"])
            handle = original(file, *args, **kwargs)
            return CorruptRead(handle, path) if path is not None and "r" in str(mode) else handle
        def wrap_builtin(file, *args, **kwargs): return wrap_open(original_builtin, file, *args, **kwargs)
        def wrap_io(file, *args, **kwargs): return wrap_open(original_io, file, *args, **kwargs)
        def wrap_os(file, flags, *args, **kwargs):
            path = candidate(file)
            if openat_ro and path is not None and not (flags & os.O_WRONLY) and not (flags & os.O_RDWR):
                rootfd = original_os(path.parent, os.O_RDONLY)
                try: fd = original_os(path.name, flags, *args, dir_fd=rootfd, **kwargs)
                finally: os.close(rootfd)
            else: fd = original_os(file, flags, *args, **kwargs)
            if path is not None:
                root_members = [path.parent / "provider", path.parent / "codex-code-mode-host"]
                if not targets_by_root: targets_by_root.append(root_members)
                if duplicate_ro and not (flags & os.O_WRONLY) and not (flags & os.O_RDWR):
                    duplicate = os.dup(fd); os.close(fd); fd = duplicate
                if (fdopen_preseed or fdopen_detach_preseed or fdopen_raw_preseed) and not (flags & os.O_WRONLY) and not (flags & os.O_RDWR):
                    wrapped = wrap_fdopen(os.dup(fd), "rb")
                    if fdopen_detach_preseed:
                        preseed_handles[fd] = wrapped.detach()
                        preseed_owners.append(preseed_handles[fd])
                    elif fdopen_raw_preseed:
                        preseed_handles[fd] = wrapped.raw
                        preseed_owners.append(wrapped)
                    else:
                        preseed_handles[fd] = wrapped
                        preseed_owners.append(wrapped)
            return fd
        def wrap_read(fd, size):
            if fd in preseed_handles:
                try:
                    live = os.fstat(fd); delegated = os.fstat(preseed_handles[fd]._handle.fileno())
                    same_object = ((live.st_dev, live.st_ino) == (delegated.st_dev, delegated.st_ino))
                except OSError: same_object = False
                if same_object and fd_target(fd) is not None:
                    return preseed_handles[fd].read(size)
            path = fd_target(fd)
            if path is not None:
                exercise_fd_reuse(fd, path)
                if protected(path) and not changed[0]: mutate(path)
            if positional_ro and path is not None and hasattr(os, "pread"):
                offset = os.lseek(fd, 0, os.SEEK_CUR); data = os.pread(fd, size, offset)
                os.lseek(fd, offset + len(data), os.SEEK_SET); return data
            return original_read(fd, size)
        def before_fd_read(fd):
            path = fd_target(fd)
            if path is not None:
                exercise_fd_reuse(fd, path)
                if protected(path) and not changed[0]: mutate(path)
        original_pread = getattr(os, "pread", None); original_readv = getattr(os, "readv", None); original_preadv = getattr(os, "preadv", None)
        def wrap_pread(fd, size, offset): before_fd_read(fd); return original_pread(fd, size, offset)
        def wrap_readv(fd, buffers): before_fd_read(fd); return original_readv(fd, buffers)
        def wrap_preadv(fd, buffers, offset, *args): before_fd_read(fd); return original_preadv(fd, buffers, offset, *args)
        def seed_root(path):
            try: root = Path(path)
            except Exception: return
            members = [root / "provider", root / "codex-code-mode-host"]
            if all(member.exists() for member in members) and not targets_by_root: targets_by_root.append(members)
        def wrap_chmod(path, mode, *args, **kwargs):
            result = original_chmod_local(path, mode, *args, **kwargs); seed_root(path); return result
        def wrap_fchmod(fd, mode):
            result = original_fchmod_local(fd, mode)
            try: seed_root(Path(os.readlink(f"/dev/fd/{fd}")))
            except OSError: pass
            return result
        def wrap_fdopen(fd, *args, **kwargs):
            handle = original_fdopen(fd, *args, **kwargs); path = fd_target(fd)
            return CorruptRead(handle, path)
        def wrap_popen(argv, *args, **kwargs):
            if not changed[0]:
                items = argv if isinstance(argv, (list, tuple)) else [argv]
                for item in items:
                    if isinstance(item, (str, os.PathLike)) and Path(item).name == "provider":
                        path = Path(item).parent / target_name
                        if path.exists(): mutate(path); break
            return original_popen_local(argv, *args, **kwargs)
        builtins.open, io.open, os.open, os.read, os.fdopen, os.chmod, os.fchmod, subprocess.Popen = wrap_builtin, wrap_io, wrap_os, wrap_read, wrap_fdopen, wrap_chmod, wrap_fchmod, wrap_popen
        if original_pread: os.pread = wrap_pread
        if original_readv: os.readv = wrap_readv
        if original_preadv: os.preadv = wrap_preadv
        try: result = attempt(target_repo)
        finally:
            builtins.open, io.open, os.open, os.read, os.fdopen, os.chmod, os.fchmod, subprocess.Popen = original_builtin, original_io, original_os, original_read, original_fdopen, original_chmod_local, original_fchmod_local, original_popen_local
            if original_pread: os.pread = original_pread
            if original_readv: os.readv = original_readv
            if original_preadv: os.preadv = original_preadv
            for handle in preseed_owners:
                try: handle.close()
                except Exception: pass
        residue = [str(path) for path in targets if path.exists() or path.parent.exists()]
        return changed[0], result, marker.exists(), residue, reuse_observation
    bad_provider_marker = work / "BAD_PROVIDER_CONNECTED"
    bad_host_marker = work / "BAD_HOST_CONNECTED"
    connected_provider = connected_corruption("provider", bad_provider_marker)
    connected_host = connected_corruption("codex-code-mode-host", bad_host_marker)
    connected_ro_dup = connected_corruption("provider", work / "BAD_PROVIDER_RO_DUP", True)
    connected_openat = connected_corruption("provider", work / "BAD_PROVIDER_OPENAT", openat_ro=True)
    connected_pread = connected_corruption("provider", work / "BAD_PROVIDER_PREAD", positional_ro=True)
    connected_fdopen_preseed = connected_corruption("provider", work / "BAD_PROVIDER_FDOPEN_PRESEED", fdopen_preseed=True)
    connected_fdopen_detach_preseed = connected_corruption(
        "provider", work / "BAD_PROVIDER_FDOPEN_DETACH_PRESEED", fdopen_detach_preseed=True)
    connected_fdopen_raw_preseed = connected_corruption(
        "provider", work / "BAD_PROVIDER_FDOPEN_RAW_PRESEED", fdopen_raw_preseed=True)
    connected_fd_reuse = connected_corruption(
        "provider", work / "BAD_PROVIDER_FD_REUSE", fd_reuse_control=True)
    check("K_R5_PROVIDER_CONNECTED_POST_PROTECTION_CORRUPTION", family_absent or (
          connected_provider[0] and not connected_provider[1][0]
          and connected_provider[1][2] == 0 and not connected_provider[2]
          and not connected_provider[3] and not connected_provider[1][4]),
          f"connected={connected_provider}")
    check("K_R5_HOST_CONNECTED_POST_PROTECTION_CORRUPTION", family_absent or (
          connected_host[0] and not connected_host[1][0]
          and connected_host[1][2] == 0 and not connected_host[2]
          and not connected_host[3] and not connected_host[1][4]),
          f"connected={connected_host}")
    check("K_R7_CONNECTED_PREOPENED_RO_DUP_CORRUPTION", family_absent or (
          connected_ro_dup[0] and not connected_ro_dup[1][0]
          and connected_ro_dup[1][2] == 0 and not connected_ro_dup[2]
          and not connected_ro_dup[3] and not connected_ro_dup[1][4]),
          f"connected={connected_ro_dup}")
    check("K_R8_CONNECTED_ALL_OPENAT_CORRUPTION", family_absent or (
          connected_openat[0] and not connected_openat[1][0] and not connected_openat[2]
          and not connected_openat[3] and not connected_openat[1][4]), f"connected={connected_openat}")
    check("K_R8_CONNECTED_POSITIONAL_READ_CORRUPTION", family_absent or (
          connected_pread[0] and not connected_pread[1][0] and not connected_pread[2]
          and not connected_pread[3] and not connected_pread[1][4]), f"connected={connected_pread}")
    check("K_R9_CONNECTED_PREPROTECT_FDOPEN_CORRUPTION", family_absent or (
          connected_fdopen_preseed[0] and not connected_fdopen_preseed[1][0]
          and not connected_fdopen_preseed[2] and not connected_fdopen_preseed[3]
          and not connected_fdopen_preseed[1][4]), f"connected={connected_fdopen_preseed}")
    check("K_R10_CONNECTED_PREPROTECT_FDOPEN_DETACH_CORRUPTION", family_absent or (
          connected_fdopen_detach_preseed[0] and not connected_fdopen_detach_preseed[1][0]
          and not connected_fdopen_detach_preseed[2] and not connected_fdopen_detach_preseed[3]
          and not connected_fdopen_detach_preseed[1][4]),
          f"connected={connected_fdopen_detach_preseed}")
    check("K_R10_CONNECTED_PREPROTECT_FDOPEN_RAW_CORRUPTION", family_absent or (
          connected_fdopen_raw_preseed[0] and not connected_fdopen_raw_preseed[1][0]
          and not connected_fdopen_raw_preseed[2] and not connected_fdopen_raw_preseed[3]
          and not connected_fdopen_raw_preseed[1][4]),
          f"connected={connected_fdopen_raw_preseed}")
    check("K_R11_LIVE_OBJECT_FD_REUSE_CORRUPTION", family_absent or (
          connected_fd_reuse[0] and not connected_fd_reuse[1][0]
          and not connected_fd_reuse[2] and not connected_fd_reuse[3]
          and not connected_fd_reuse[1][4]
          and connected_fd_reuse[4] == [(b"U", False, False)]),
          f"connected={connected_fd_reuse}")

    # Authority is one byte observation: replacing the document immediately
    # after its read handle is returned must not mix old path with new digest.
    provider.write_bytes(good_bytes); provider.chmod(0o700)
    coherent_repo = make_repo(str(provider))
    coherent_cfg = coherent_repo / "config/codex-provider-identity.json"
    replacement_cfg = coherent_repo / "config/replacement.json"
    replacement_cfg.write_text(json.dumps({**authority_document(str(provider)),
        "executable_sha256":"0"*64}), encoding="utf-8")
    original_builtin_open, original_io_open, original_os_open = builtins.open, io.open, os.open
    authority_swapped = [False]
    def authority_read_swap(file, *args, **kwargs):
        f = original_io_open(file, *args, **kwargs)
        mode = args[0] if args else kwargs.get("mode", "r")
        try: same = Path(file) == coherent_cfg
        except TypeError: same = False
        if same and "r" in str(mode) and not authority_swapped[0]:
            os.replace(replacement_cfg, coherent_cfg); authority_swapped[0] = True
        return f
    def authority_builtin_swap(file, *args, **kwargs):
        f = original_builtin_open(file, *args, **kwargs)
        mode = args[0] if args else kwargs.get("mode", "r")
        try: same = Path(file) == coherent_cfg
        except TypeError: same = False
        if same and "r" in str(mode) and not authority_swapped[0]:
            os.replace(replacement_cfg, coherent_cfg); authority_swapped[0] = True
        return f
    def authority_os_swap(file, flags, *args, **kwargs):
        fd = original_os_open(file, flags, *args, **kwargs)
        try: same = Path(file) == coherent_cfg
        except TypeError: same = False
        if same and not (flags & os.O_WRONLY) and not (flags & os.O_RDWR) and not authority_swapped[0]:
            os.replace(replacement_cfg, coherent_cfg); authority_swapped[0] = True
        return fd
    builtins.open, io.open, os.open = authority_builtin_swap, authority_read_swap, authority_os_swap
    try:
        coherent_result = attempt(coherent_repo)
    finally:
        builtins.open, io.open, os.open = original_builtin_open, original_io_open, original_os_open
    check("K_COHERENT_AUTHORITY", family_absent or (authority_swapped[0] and coherent_result[0]),
          f"document_replaced_after_open={authority_swapped[0]} result={coherent_result}")

    # GR-02/GR-06 owner-runner control. Evidence may be consumed only when
    # every immutable input equals THIS checked-out candidate.
    g20 = work / "g20"; trust = g20 / "trust"; ws = g20 / "ws"
    trust.mkdir(parents=True); ws.mkdir()
    protected = trust / "provider"; protected.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
    protected_host = trust / "codex-code-mode-host"
    protected_host.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
    protected.chmod(0o500); protected_host.chmod(0o500); trust.chmod(0o500)
    envelope = g20 / "envelope.json"; envelope.write_text('{"task_id":"h-032"}\n', encoding="utf-8")
    launcher = source.parents[1] / "controller/launch/cli"
    task_spec = source.parents[1] / "specs/tasks.spec.json"
    gate_path = source.parents[1] / "verify/bin/h-032-exit"
