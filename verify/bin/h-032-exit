    tracked_quiescent = (not tracked_interruption[0][0] and not tracked_timeout[0][0]
                         and not tracked_fork[0][0]
                         and bool(tracked_identities)
                         and not tracked_timeout_root.exists()
                         and not tracked_fork_root.exists()
                         and not remaining_identities)
    # A broken candidate may leave the deliberately escaped mutant alive.
    # Remove only identities emitted by this exact fixture after recording the
    # failed verdict; this cleanup is not part of the passing oracle.
    for pid, _ppid, started in remaining_identities:
        current = process_table().get(pid)
        if current and current[1] == started:
            try: os.kill(pid, signal.SIGKILL)
            except ProcessLookupError: pass

    def object_attack(kind: str):
        attack_repo = make_repo(str(provider))
        seeded: list[Path] = []
        moved_parents: list[Path] = []
        precreated: list[tuple[bool,int,int]] = []
        target_guard = work / f"object-attack-{kind}-guard"
        target_guard.write_text("guard", encoding="utf-8")
        original = module.subprocess.Popen
        def inject(argv, *args, **kwargs):
            flat = list(argv)
            if "-o" not in flat:
                return original(argv, *args, **kwargs)
            index = flat.index("-o")
            target = Path(flat[index + 1]); target.parent.mkdir(parents=True, exist_ok=True)
            opened=target.lstat()
            precreated.append((stat.S_ISREG(opened.st_mode),opened.st_nlink,
                               stat.S_IMODE(opened.st_mode)))
            if kind != "parent_swap": target.unlink()
            if kind == "symlink": target.symlink_to(target_guard)
            elif kind == "directory": target.mkdir()
            elif kind == "hardlink": os.link(target_guard, target)
            elif kind == "fifo": os.mkfifo(target, 0o600)
            elif kind == "socket":
                sock = socket.socket(socket.AF_UNIX); sock.bind(str(target)); sock.close()
            elif kind == "parent_swap":
                moved = target.parent.with_name(target.parent.name + "-moved")
                target.parent.rename(moved); moved_parents.append(moved); target.parent.mkdir()
            else: raise RuntimeError(kind)
            seeded.append(target)
            return original(["1" if value == "86400" else value for value in flat], *args, **kwargs)
        module.subprocess.Popen = inject
        prior_mode=launch_mode[0];launch_mode[0]="missing"
        try:
            outcome = attempt(attack_repo)
        finally:
            module.subprocess.Popen = original
            launch_mode[0]=prior_mode
        intact = target_guard.read_text(encoding="utf-8") == "guard"
        for path in seeded:
            if path.is_symlink() or (path.exists() and not path.is_dir()): path.unlink()
            elif path.is_dir(): path.rmdir()
        for path in moved_parents:
            if path.exists(): shutil.rmtree(path)
        residue_free = (not any(path.exists() or path.is_symlink() for path in seeded)
                        and not any(path.exists() for path in moved_parents))
        return outcome, len(seeded) == 1, intact, residue_free, precreated
    object_attacks = {kind: object_attack(kind) for kind in
                      ("symlink", "directory", "hardlink", "fifo", "socket", "parent_swap")}
    object_attacks_ok = all(not value[0][0]
                            and not value[0][4]
                            and value[1] and value[2] and value[3]
                            and value[4]==[(True,1,0o600)]
                            for value in object_attacks.values())

    def cleanup_failure_case(persistent: bool):
        cleanup_repo = make_repo(str(provider))
        targets: list[Path] = []; failures = [0]
        original_popen = module.subprocess.Popen
        original_unlink = module.os.unlink
        original_rmtree = module.shutil.rmtree
        def observe_target(argv, *args, **kwargs):
            flat = list(argv)
            if "-o" in flat: targets.append(Path(flat[flat.index("-o") + 1]))
            return original_popen(argv, *args, **kwargs)
        def injected_unlink(path, *args, **kwargs):
            candidate = Path(path)
            if targets and candidate == targets[-1] and (persistent or failures[0] == 0):
                failures[0] += 1; raise OSError("H032 injected result cleanup failure")
            return original_unlink(path, *args, **kwargs)
        def injected_rmtree(path, *args, **kwargs):
            candidate = Path(path)
            if targets and (candidate == targets[-1] or candidate in targets[-1].parents) \
                    and (persistent or failures[0] == 0):
                failures[0] += 1; raise OSError("H032 injected result cleanup failure")
            return original_rmtree(path, *args, **kwargs)
        module.subprocess.Popen = observe_target
        module.os.unlink = injected_unlink
        module.shutil.rmtree = injected_rmtree
        try:
            outcome = attempt(cleanup_repo)
        finally:
            module.subprocess.Popen = original_popen
            module.os.unlink = original_unlink
            module.shutil.rmtree = original_rmtree
        transport_residue: list[Path] = []
        for target in targets:
            for candidate in (target, target.parent):
                if candidate.exists() or candidate.is_symlink():
                    transport_residue.append(candidate)
        result = (outcome, failures[0], list(outcome[4]),
                  sorted({str(path) for path in transport_residue}))
        # Gate-owned cleanup happens only after the complete attempt residue and
        # private-parent observations have been retained in result.
        for target in targets:
            if target.parent.exists():
                target.parent.chmod(0o700)
                shutil.rmtree(target.parent)
        observed_cleanup = last_attempt_observed[0] or {}
        cleanup_arena = observed_cleanup.get("arena")
        if isinstance(cleanup_arena, Path) and cleanup_arena.exists():
            # The persistent-failure control may leave protected provider
            # snapshots elsewhere in this exact attempt arena. The verdict
            # above retains them in outcome[4]; only then does the judge make
            # its own arena removable so the gate itself leaves no residue.
            for root_path, directories, _files in os.walk(cleanup_arena, topdown=False):
                for directory in directories:
                    candidate = Path(root_path) / directory
                    if not candidate.is_symlink(): candidate.chmod(0o700)
                Path(root_path).chmod(0o700)
            shutil.rmtree(cleanup_arena)
        return result
    transient_cleanup = cleanup_failure_case(False)
    persistent_cleanup = cleanup_failure_case(True)
    cleanup_error_ok = (
        transient_cleanup[1] == 1 and transient_cleanup[0][0]
        and not transient_cleanup[2] and not transient_cleanup[3]
        and persistent_cleanup[1] > 0 and not persistent_cleanup[0][0]
        and "cleanup" in persistent_cleanup[0][1].lower()
        and not persistent_cleanup[2] and not persistent_cleanup[3])

    def result_root_ordinal_discovery():
        """Identify result staging by its observed -o child, never by snapshot order."""
        allocations: list[Path] = []; output_paths: list[Path] = []
        original_mkdtemp = module.tempfile.mkdtemp
        original_popen = module.subprocess.Popen
        def observe_mkdtemp(*args, **kwargs):
            value = Path(original_mkdtemp(*args, **kwargs)); allocations.append(value)
            return str(value)
        def observe_popen(argv, *args, **kwargs):
            flat = list(argv)
            if "-o" in flat: output_paths.append(Path(flat[flat.index("-o") + 1]))
            return original_popen(argv, *args, **kwargs)
        module.tempfile.mkdtemp = observe_mkdtemp
        module.subprocess.Popen = observe_popen
        try:
            outcome = attempt(make_repo(str(provider)))
        finally:
            module.tempfile.mkdtemp = original_mkdtemp
            module.subprocess.Popen = original_popen
        matches = [(index, root) for index, root in enumerate(allocations, 1)
                   if len(output_paths) == 1 and output_paths[0].parent == root]
        return outcome, allocations, output_paths, matches

    def setup_spawn_fault_case(stage: str, result_root_ordinal: int,
                               case_repo: Path | None = None, *,
                               effect_tree=None, post_effect_target: int | None = None,
                               profile_state=None, profile_preinstalled: bool = False):
        """Inject by actual callable identity, never source spelling or helper order."""
        if case_repo is None: case_repo = make_repo(str(provider))
        if capture.exists(): capture.unlink()
        original_mkdtemp = module.tempfile.mkdtemp
        original_popen = module.subprocess.Popen
        path_type = type(Path()); path_busy = [False]
        subject_tree = source_tree if effect_tree is None else effect_tree
        run_node = next((node for node in subject_tree.body
                         if isinstance(node, ast.FunctionDef) and node.name == "run_codex"), None)
        run_calls = list(ast.walk(run_node)) if run_node is not None else []
        os_names = {node.func.attr for node in run_calls if isinstance(node, ast.Call)
                    and isinstance(node.func, ast.Attribute)
                    and isinstance(node.func.value, ast.Name)
                    and node.func.value.id == "os"
                    and callable(getattr(module.os, node.func.attr, None))}
        path_names = {node.func.attr for node in run_calls if isinstance(node, ast.Call)
                      and isinstance(node.func, ast.Attribute)
                      and not (isinstance(node.func.value, ast.Name)
                               and node.func.value.id in {"os", "stat", "subprocess",
                                   "tempfile", "shutil", "hashlib", "json", "sys", "fcntl"})
                      and callable(getattr(path_type, node.func.attr, None))}
        helper_names = {name for name, value in vars(module).items()
                        if name != "run_codex" and hasattr(value, "__code__")
                        and getattr(value, "__module__", None) == module.__name__}
        # Root/sink observation uses these operations even if a legitimate source
        # spells a later schedule differently. The post-retained verdict comes from
        # actual callable/code identity below, not from this wrapper selection.
        path_names.update({"lstat", "iterdir"})
        os_names.update({"open", "fsync", "fstat", "close"})
        os_originals = {name: getattr(module.os, name) for name in sorted(os_names)}
        path_originals = {name: getattr(path_type, name) for name in sorted(path_names)}
        helper_originals = {name: getattr(module, name) for name in sorted(helper_names)}
        original_open = os_originals["open"]; original_fsync = os_originals["fsync"]
        original_fstat = os_originals["fstat"]; original_close = os_originals["close"]
        allocations: list[Path] = []; target_root: list[Path] = []
        root_operations = [0]; injected = [False]
        create_fd = [-1]; create_identity: list[tuple[int, int]] = []
        retained_validated = [False]
        boundary_aliases: list[tuple[int, int, int, int]] = []
        stage_trace: list[str] = []
        post_effects: list[str] = []
        profile_sink_fstats: list[tuple[str, str]] = []

        # Resolve effects from the callable actually entered.  This inventory is
        # installed before variant exec below and therefore follows defaults,
        # aliases, C-backed callables and project-helper references captured at
        # definition time.  Only calls whose immediate caller is this exact
        # candidate module are effects; pathlib/shutil internals do not expand a
        # single admitted capability into an implementation-specific call tree.
        capability_owners = (module.os, module.fcntl, module.shutil, module.tempfile,
                             path_type)
        c_capabilities = {}
        code_capabilities = {}
        for owner in capability_owners:
            owner_label = "Path" if owner is path_type else getattr(owner, "__name__", "")
            for name in dir(owner):
                if name.startswith("_"):
                    continue
                try: value = getattr(owner, name)
                except Exception: continue
                if not callable(value):
                    continue
                label = f"{owner_label}.{name}"
                code = getattr(value, "__code__", None)
                if code is not None: code_capabilities[code] = label
                else:
                    try: c_capabilities[value] = label
                    except TypeError: pass
        for name, value in helper_originals.items():
            code_capabilities[value.__code__] = f"helper.{name}"

        if profile_state is None:
            profile_state = [None]
        previous_profile = sys.getprofile()

        def profile_router(frame, event, arg):
            callback = profile_state[0]
            if callback is not None:
                callback(frame, event, arg)

        def profile_effect(frame, event, arg):
            label = None
            caller = frame if event == "c_call" else frame.f_back
            if event == "c_call":
                label = c_capabilities.get(arg)
            elif event == "call":
                label = code_capabilities.get(frame.f_code)
                if frame.f_code is observe_open.__code__: label = "os.open"
                elif frame.f_code is observe_fsync.__code__: label = "os.fsync"
                elif frame.f_code is observe_fstat.__code__: label = "os.fstat"
                elif frame.f_code is observe_close.__code__: label = "os.close"
                elif frame.f_code is wrap_os_code:
                    label = f"os.{frame.f_locals.get('_h032_effect_name', 'unknown')}"
                elif frame.f_code is wrap_path_code:
                    label = f"Path.{frame.f_locals.get('_h032_effect_name', 'unknown')}"
                elif wrap_helper_code is not None and frame.f_code is wrap_helper_code:
                    label = f"helper.{frame.f_locals.get('_h032_effect_name', 'unknown')}"
            if label is None or caller is None \
                    or caller.f_globals.get("__name__") != module.__name__:
                return
            if label == "os.fstat":
                candidate_fd = caller.f_locals.get("fd", caller.f_locals.get("sink_fd"))
                if type(candidate_fd) is int and create_identity:
                    try:
                        opened = original_fstat(candidate_fd)
                        access = fcntl.fcntl(candidate_fd, fcntl.F_GETFL) & os.O_ACCMODE
                    except OSError:
                        pass
                    else:
                        if ((opened.st_dev, opened.st_ino) == create_identity[0]
                                and access == os.O_RDONLY):
                            profile_sink_fstats.append(
                                ("post_retained" if retained_validated[0]
                                 else "retained", label))
            if retained_validated[0]:
                post_retained_effect(label)

        def path_value(value) -> Path | None:
            return Path(value) if type(value) is str or type(value) is path_type else None

        def record_sink(path: Path, *, output_path: bool) -> tuple[int, int] | None:
            active = audit_active[0]
            if not isinstance(active, dict): return None
            if output_path:
                outputs = active["provider_outputs"]; assert isinstance(outputs, list)
                if str(path) not in outputs: outputs.append(str(path))
            try: opened = path_originals["lstat"](path)
            except OSError: return None
            identities = active["sink_identities"]; assert isinstance(identities, list)
            identity = (opened.st_dev, opened.st_ino)
            if identity not in identities: identities.append(identity)
            return identity

        def root_effect(path: Path, operation: str) -> None:
            if not target_root or path != target_root[0] or injected[0]: return
            root_operations[0] += 1
            expected = {"root_validation_1": 1, "root_validation_2": 2}.get(stage)
            if expected == root_operations[0]:
                injected[0] = True
                raise OSError(f"H032 injected result-root validation {expected}:{operation}")

        def observe_mkdtemp(*args, **kwargs):
            value = Path(original_mkdtemp(*args, **kwargs)); allocations.append(value)
            if len(allocations) == result_root_ordinal: target_root.append(value)
            return str(value)

        def live_sink_aliases() -> list[tuple[int, int, int, int]]:
            aliases: list[tuple[int, int, int, int]] = []
            if not create_identity: return aliases
            # Use the saved concrete iterator so the judge's own alias inventory
            # cannot recursively trigger the subject-effect interception below.
            for fd_path in path_originals["iterdir"](Path("/dev/fd")):
                try:
                    fd = int(fd_path.name); opened = original_fstat(fd)
                    access = fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE
                except (OSError, ValueError): continue
                if (opened.st_dev, opened.st_ino) == create_identity[0]:
                    aliases.append((fd, opened.st_dev, opened.st_ino, access))
            return aliases

        def post_retained_effect(effect: str) -> None:
            if not retained_validated[0] or injected[0]: return
            ordinal = len(post_effects)
            post_effects.append(effect)
            stage_trace.append(f"post_retained:{ordinal}:{effect}")
            aliases = live_sink_aliases()
            for alias in aliases:
                if alias not in boundary_aliases: boundary_aliases.append(alias)
            if (stage == "post_retained_setup_effect"
                    and post_effect_target == ordinal):
                if not any(item[3] == os.O_RDONLY for item in aliases):
                    raise RuntimeError("post-retained effect lacks live retained sink capability")
                injected[0] = True
                raise OSError(f"H032 injected post-retained effect {ordinal}:{effect}")

        def wrap_path(name):
            original = path_originals[name]
            def wrapped(self, *args, _h032_effect_name=name, **kwargs):
                if not path_busy[0]:
                    root_effect(self, f"Path.{name}")
                    path_busy[0] = True
                    try: return original(self, *args, **kwargs)
                    finally: path_busy[0] = False
                return original(self, *args, **kwargs)
            return wrapped

        def wrap_helper(name):
            original = helper_originals[name]
            def wrapped(*args, _h032_effect_name=name, **kwargs):
                return original(*args, **kwargs)
            return wrapped

        def observe_open(path, flags, *args, **kwargs):
            candidate = path_value(path)
            is_child = bool(target_root and candidate is not None
                            and candidate.parent == target_root[0])
            if is_child and flags & os.O_CREAT:
                if stage in {"before_sink_create", "sink_open_raises"}:
                    injected[0] = True
                    raise OSError(f"H032 injected {stage}")
            if target_root and candidate == target_root[0]:
                root_effect(candidate, "os.open(root)")
            if is_child and (flags & os.O_ACCMODE) == os.O_RDONLY \
                    and stage == "after_create_close_before_retained":
                injected[0] = True
                raise OSError("H032 injected after writable create close")
            fd = original_open(path, flags, *args, **kwargs)
            if is_child and flags & os.O_CREAT:
                create_fd[0] = fd
                opened = original_fstat(fd); create_identity[:] = [(opened.st_dev, opened.st_ino)]
                record_sink(candidate, output_path=True)
            elif is_child and (flags & os.O_ACCMODE) == os.O_RDONLY:
                record_sink(candidate, output_path=True)
            return fd

        def observe_fsync(fd):
            if stage == "create_fd_fsync" and fd == create_fd[0] and not injected[0]:
                injected[0] = True
                raise OSError("H032 injected while product owns writable create fd")
            return original_fsync(fd)

        def observe_close(fd):
            if stage == "create_fd_close" and fd == create_fd[0] and not injected[0]:
                # The close is product-invoked and real; the injected failure is
                # after that syscall, never a judge pre-close of the returned fd.
                result = original_close(fd); injected[0] = True
                raise OSError("H032 injected after product close of writable create fd")
            return original_close(fd)

        def observe_fstat(fd):
            opened = original_fstat(fd)
            if create_identity and (opened.st_dev, opened.st_ino) == create_identity[0] \
                    and (fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE) == os.O_RDONLY:
                if not retained_validated[0]:
                    stage_trace.append("retained_fstat")
                    if stage == "retained_fd_fstat" and not injected[0]:
                        injected[0] = True
                        raise OSError("H032 injected retained sink fstat")
                    retained_validated[0] = True
            return opened

        def wrap_os(name):
            original = os_originals[name]
            def wrapped(*args, _h032_effect_name=name, **kwargs):
                return original(*args, **kwargs)
            return wrapped

        wrap_os_code = wrap_os(next(iter(os_originals))).__code__
        wrap_path_code = wrap_path(next(iter(path_originals))).__code__
        wrap_helper_code = (wrap_helper(next(iter(helper_originals))).__code__
                            if helper_originals else None)

        def observe_popen(argv, *args, **kwargs):
            flat = list(argv)
            if "-o" in flat and stage in {"popen_before_delegate", "discover_post_retained"}:
                sink = Path(flat[flat.index("-o") + 1]); identity = record_sink(sink, output_path=True)
                if identity is not None:
                    for alias in live_sink_aliases():
                        if alias not in boundary_aliases: boundary_aliases.append(alias)
                if any(item[3] == os.O_RDONLY for item in boundary_aliases):
                    stage_trace.append("popen_before_delegate")
                    injected[0] = True
                    raise OSError(f"H032 injected {stage} with retained sink capability")
            return original_popen(argv, *args, **kwargs)

        module.tempfile.mkdtemp = observe_mkdtemp
        for name in os_originals:
            observer = {"open": observe_open, "fsync": observe_fsync,
                        "fstat": observe_fstat, "close": observe_close}.get(name)
            setattr(module.os, name, observer if observer is not None else wrap_os(name))
        for name in helper_originals: setattr(module, name, wrap_helper(name))
        module.subprocess.Popen = observe_popen
        for name in path_originals: setattr(path_type, name, wrap_path(name))
        profile_state[0] = profile_effect
        if not profile_preinstalled:
            sys.setprofile(profile_router)
        try:
            outcome = attempt(case_repo)
        finally:
            profile_state[0] = None
            if not profile_preinstalled:
                sys.setprofile(previous_profile)
            module.tempfile.mkdtemp = original_mkdtemp
            for name, original in os_originals.items(): setattr(module.os, name, original)
            for name, original in helper_originals.items(): setattr(module, name, original)
            module.subprocess.Popen = original_popen
            for name, original in path_originals.items(): setattr(path_type, name, original)
        observed = last_attempt_observed[0] or {}
        case_capture = safe_capture()
        for key in ("provider_outputs", "canonical_paths", "private_paths",
                    "private_paths_present", "sink_identities", "sink_fd_aliases",
                    "journal_start_records"):
            case_capture["_gate_" + key.replace("provider_outputs", "output_paths")] = list(
                observed.get(key, []))
        case_capture["_gate_provider_process_starts"] = observed.get(
            "provider_process_starts", -1)
        case_capture["_gate_journal_append_valid"] = observed.get(
            "journal_append_valid", False)
        case_capture["_gate_journal_append_error"] = observed.get("journal_append_error")
        case_capture["_gate_boundary_sink_aliases"] = list(boundary_aliases)
        case_capture["_gate_create_fd_returned"] = create_fd[0] >= 0
        case_capture["_gate_setup_stage_trace"] = list(stage_trace)
        case_capture["_gate_profile_sink_fstats"] = list(profile_sink_fstats)
        journal_before = observed.get("journal_before", {})
        journal_after = observed.get("journal_after", {})
        case_capture["_gate_journal_preexisting_preserved"] = (
            isinstance(journal_before, dict) and isinstance(journal_after, dict)
            and journal_before.get("exists") is True
            and (journal_before.get("dev"), journal_before.get("ino"),
                 journal_before.get("mode"), journal_before.get("nlink")) ==
                (journal_after.get("dev"), journal_after.get("ino"),
                 journal_after.get("mode"), journal_after.get("nlink"))
            and stat.S_IMODE(int(journal_after.get("mode", 0)))
                == SAFE_ATTEMPT_JOURNAL_MODE
            and isinstance(journal_before.get("raw"), bytes)
            and isinstance(journal_after.get("raw"), bytes)
            and journal_after["raw"].startswith(journal_before["raw"]))
        output_paths = [Path(value) for value in case_capture["_gate_output_paths"]]
        canonical_paths = [Path(value) for value in case_capture["_gate_canonical_paths"]]
        case = (outcome, case_capture,
                any(path.exists() or path.is_symlink() for path in output_paths),
                any(path.exists() or path.is_symlink() for path in canonical_paths), False)
        arena = observed.get("arena")
        if isinstance(arena, Path):
            top_roots = {path for path in map(Path, observed.get("private_paths", []))
                         if path.parent == arena}
            for path in sorted(top_roots, key=lambda item: len(item.parts), reverse=True):
                if path.is_symlink() or (path.exists() and not path.is_dir()): path.unlink()
                elif path.is_dir(): path.chmod(0o700); shutil.rmtree(path)
        return (case, injected[0], [str(path) for path in target_root],
                root_operations[0], list(stage_trace), list(post_effects),
                {"direct_os": sorted(os_names), "direct_path": sorted(path_names),
                 "helper_count": len(helper_names),
                 "profile_c_count": len(c_capabilities),
                 "profile_code_count": len(code_capabilities),
                 "profile_has_os_fstat": "os.fstat" in c_capabilities.values(),
                 "profile_identity_sha256": hashlib.sha256("\n".join(sorted(
                     set(c_capabilities.values()) | set(code_capabilities.values())))
                     .encode("utf-8")).hexdigest()})

    discovery = (False, [], [], []); result_root_ordinal = 0
    setup_spawn_faults = {}; setup_spawn_faults_ok = False
    post_retained_discovery = None; post_retained_effects: list[str] = []
    post_retained_cases = {}; post_retained_omission_caught = False
    r59_repeated_fstat_connected = True; r59_zero_effect_reorder_connected = True
    r62_direct_helper_connected = True
    r59_variant_detail = {"skipped": True}
    if kernel_structure_ok and kernel_integration_structure_ok \
            and hasattr(module, "consume_private_result"):
        discovery = result_root_ordinal_discovery()
        discovery_ok = (discovery[0][0] and not discovery[0][4]
                        and len(discovery[2]) == 1 and len(discovery[3]) == 1)
        if discovery_ok:
            result_root_ordinal = discovery[3][0][0]
            stages = ("root_validation_1", "root_validation_2", "before_sink_create",
                      "sink_open_raises", "create_fd_fsync", "create_fd_close",
                      "after_create_close_before_retained", "retained_fd_fstat",
                      "popen_before_delegate")
            for stage in stages:
                setup_spawn_faults[stage] = setup_spawn_fault_case(stage, result_root_ordinal)
            post_retained_discovery = setup_spawn_fault_case(
                "discover_post_retained", result_root_ordinal)
            post_retained_effects = list(post_retained_discovery[5])
            for ordinal in range(len(post_retained_effects)):
                post_retained_cases[ordinal] = setup_spawn_fault_case(
                    "post_retained_setup_effect", result_root_ordinal,
                    post_effect_target=ordinal)
            precreate = {"root_validation_1", "root_validation_2",
                         "before_sink_create", "sink_open_raises"}
            create_owned = {"create_fd_fsync", "create_fd_close",
                            "after_create_close_before_retained", "retained_fd_fstat"}
            retained_owned = {"popen_before_delegate"}
            fixed_faults_ok = all(
                injected and roots
                and rejected_clean(case, expected_process_starts=0,
                                   expected_output_paths=(0 if stage in precreate else 1),
                                   expected_journal_starts=(0, 1))
                and (stage not in create_owned
                     or case[1].get("_gate_create_fd_returned") is True)
                and (stage not in retained_owned
                     or any(item[3] == os.O_RDONLY for item in
                            case[1].get("_gate_boundary_sink_aliases", [])))
                and (stage != "popen_before_delegate"
                     or trace[-1:] == ["popen_before_delegate"])
                for stage, (case, injected, roots, _ops, trace, _effects, _caps)
                in setup_spawn_faults.items())
            def post_matrix_valid(effects: list[str], cases: dict[int, tuple]) -> bool:
                if set(cases) != set(range(len(effects))): return False
                return all(
                    injected and roots and observed_effects == effects[:ordinal + 1]
                    and rejected_clean(case, expected_process_starts=0,
                                       expected_output_paths=1,
                                       expected_journal_starts=(0, 1))
                    and any(item[3] == os.O_RDONLY for item in
                            case[1].get("_gate_boundary_sink_aliases", []))
                    and trace[-1:] == [
                        f"post_retained:{ordinal}:{effects[ordinal]}"]
                    for ordinal, (case, injected, roots, _ops, trace,
                                  observed_effects, _caps) in cases.items())
            discovery_case, discovery_injected, discovery_roots, _discovery_ops, \
                discovery_trace, _discovery_effects, _discovery_caps = post_retained_discovery
            discovery_ok = (
                discovery_injected and discovery_roots
                and rejected_clean(discovery_case, expected_process_starts=0,
                                   expected_output_paths=1,
                                   expected_journal_starts=(0, 1))
                and discovery_trace[-1:] == ["popen_before_delegate"])
            post_matrix_ok = post_matrix_valid(post_retained_effects, post_retained_cases)
            if post_retained_effects:
                omitted = dict(post_retained_cases); omitted.pop(len(post_retained_effects) // 2)
                post_retained_omission_caught = not post_matrix_valid(
                    post_retained_effects, omitted)
            else:
                post_retained_omission_caught = post_matrix_valid([], {})
            setup_spawn_faults_ok = (fixed_faults_ok and discovery_ok
                                     and post_matrix_ok and post_retained_omission_caught)

            def schedule_variant_case(variant_text: str, label: str,
                                      *, inject_ordinal: int | None = None):
                global module
                variant_tree = ast.parse(variant_text)
                variant_name = f"h032_r59_{label}_{len(sys.modules)}"
                variant_spec = importlib.util.spec_from_loader(
                    variant_name, loader=None, origin=str(source))
                if variant_spec is None: raise RuntimeError("R59 variant spec unavailable")
                variant_module = importlib.util.module_from_spec(variant_spec)
                variant_module.__file__ = str(source)
                sys.modules[variant_name] = variant_module
                saved_module = module
                try:
                    exec(compile(variant_text, str(source), "exec"),
                         variant_module.__dict__)
                    variant_module.now_id = fixture_now_id
                    module = variant_module
                    if inject_ordinal is None:
                        return setup_spawn_fault_case(
                            "discover_post_retained", result_root_ordinal,
                            effect_tree=variant_tree)
                    return setup_spawn_fault_case(
                        "post_retained_setup_effect", result_root_ordinal,
                        effect_tree=variant_tree, post_effect_target=inject_ordinal)
                finally:
                    module = saved_module
                    sys.modules.pop(variant_name, None)

            retained_line = "        sink_identity = os.fstat(sink_fd)\n"
            repeated_text = source_text.replace(
                retained_line, retained_line + "        os.fstat(sink_fd)\n", 1)
            repeated_shape_ok = repeated_text != source_text \
                and repeated_text.count("os.fstat(sink_fd)") \
                    == source_text.count("os.fstat(sink_fd)") + 1
            repeated_discovery = (schedule_variant_case(repeated_text, "repeat_discovery")
                                  if repeated_shape_ok else None)
            repeated_injection = (schedule_variant_case(
                repeated_text, "repeat_injection", inject_ordinal=0)
                if repeated_discovery is not None and repeated_discovery[5][:1] == ["os.fstat"]
                else None)
            r59_repeated_fstat_connected = bool(
                repeated_injection is not None and repeated_injection[1]
                and repeated_injection[5] == ["os.fstat"]
                and repeated_injection[4][-1:] == ["post_retained:0:os.fstat"]
                and repeated_injection[0][1].get("_gate_profile_sink_fstats")
                    == [("retained", "os.fstat"), ("post_retained", "os.fstat")]
                and rejected_clean(repeated_injection[0], expected_process_starts=0,
                                   expected_output_paths=1,
                                   expected_journal_starts=(0, 1)))

            run_signature = (
                "def run_codex(repo: Path, wt: Path, role: str, prompt: str)"
                " -> dict[str, Any]:")
            helper_definition = (
                "def _fstat(fd: int):\n"
                "    return os.fstat(fd)\n\n\n")
            helper_text = source_text.replace(
                run_signature, helper_definition + run_signature, 1)
            helper_text = helper_text.replace(
                retained_line,
                retained_line + "        helper_alias = _fstat\n"
                "        helper_alias(sink_fd)\n", 1)
            helper_shape_ok = (
                helper_text != source_text
                and helper_text.count("def _fstat") == 1
                and helper_text.count("helper_alias(sink_fd)") == 1)
            helper_discovery = (schedule_variant_case(
                helper_text, "direct_helper_discovery") if helper_shape_ok else None)
            helper_injections = {}
            if helper_discovery is not None and helper_discovery[5][:2] == [
                    "helper._fstat", "os.fstat"]:
                for helper_ordinal in range(2):
                    helper_injections[helper_ordinal] = schedule_variant_case(
                        helper_text, f"direct_helper_injection_{helper_ordinal}",
                        inject_ordinal=helper_ordinal)
            r62_direct_helper_connected = bool(
                helper_discovery is not None
                and helper_discovery[0][1].get("_gate_profile_sink_fstats")
                    == [("retained", "os.fstat"), ("post_retained", "os.fstat")]
                and set(helper_injections) == {0, 1}
                and all(case[1]
                        and case[5] == helper_discovery[5][:ordinal + 1]
                        and rejected_clean(case[0], expected_process_starts=0,
