    def rejected_clean(case, *, expected_process_starts: int = 1,
                       expected_output_paths: int = 1,
                       expected_journal_starts: tuple[int, ...] = (1,)) -> bool:
        result, case_capture, output_exists, canonical_exists, hostile_exists = case
        output_paths = [Path(value) for value in case_capture.get("_gate_output_paths", [])]
        journal_records = case_capture.get("_gate_journal_start_records", [])
        journal_ok = (case_capture.get("_gate_journal_append_valid") is True
            and not case_capture.get("_gate_journal_append_error")
            and isinstance(journal_records, list)
            and len(journal_records) == result[2]
            and all(isinstance(record, dict)
                    and record.get("event") == "AGENT_START"
                    and record.get("role") == "TEST_AUTHOR"
                    and record.get("model") == "gpt-5.6-sol"
                    and record.get("reasoning_effort") == "max"
                    and record.get("model_routing_source") == "AUTOPILOT_ROLE_POLICY"
                    for record in journal_records))
        return (not result[0] and result[2] in expected_journal_starts
                and journal_ok
                and case_capture.get("_gate_provider_process_starts") == expected_process_starts
                and not result[4]
                and len(output_paths) == expected_output_paths
                and all(not path.exists() and not path.is_symlink()
                        and not path.parent.exists() for path in output_paths)
                and not case_capture.get("_gate_private_paths_present")
                and not case_capture.get("_gate_sink_fd_aliases")
                and not output_exists and not canonical_exists and not hostile_exists)
