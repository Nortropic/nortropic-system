               "task_spec_sha256": sha256(task_spec), "h032_gate_sha256": sha256(gate_path),
               "g20_probe_identity": "controller/launch/cli:" + sha256(launcher)}
    attack = ('set +e; echo x >> "$1/provider"; echo WRITE=$?; '
              'chmod 700 "$1/provider"; echo CHMOD=$?; '
              'unlink "$1/provider"; echo UNLINK=$?; '
              'mv "$1/provider" "$1/moved"; echo RENAME=$?; '
              'echo x >> "$1/codex-code-mode-host"; echo HOST_WRITE=$?; '
              'chmod 700 "$1/codex-code-mode-host"; echo HOST_CHMOD=$?; '
              'unlink "$1/codex-code-mode-host"; echo HOST_UNLINK=$?; '
              'mv "$1/codex-code-mode-host" "$1/moved-host"; echo HOST_RENAME=$?; '
              'echo y > "$1/replacement"; echo CREATE=$?; '
              'mv "$1" "$1-moved"; echo PARENT_RENAME=$?')
    env = dict(os.environ, NORTROPIC_TRUST_ROOT=str(trust))
