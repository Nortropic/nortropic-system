            setup_spawn_faults_ok = (setup_spawn_faults_ok
                                     and r59_repeated_fstat_connected
                                     and r62_direct_helper_connected
                                     and r59_zero_effect_reorder_connected)

    journal_write = os.write; journal_fsync = os.fsync
    def append_gate_journal_bytes(case_repo: Path, raw: bytes) -> None:
        path = module.journal_root(case_repo) / "events.jsonl"
        path.parent.mkdir(parents=True, exist_ok=True)
        flags = (os.O_WRONLY | os.O_CREAT | os.O_APPEND
                 | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0))
        fd = journal_open(path, flags, 0o600)
        try:
            offset = 0
            while offset < len(raw):
                written = journal_write(fd, raw[offset:])
                if written <= 0: raise OSError("short journal mutant write")
                offset += written
            journal_fsync(fd)
        finally:
            journal_close(fd)

    def journal_fault_case(mode: str, ordinal: int):
        """Corrupt the exact current-attempt append and retain cleanup observations."""
        case_repo = make_repo(str(provider))
        if capture.exists(): capture.unlink()
        original_mkdtemp = module.tempfile.mkdtemp
        original_open = module.os.open; original_fstat = module.os.fstat
        original_journal = module.journal
        allocations: list[Path] = []; target_root: list[Path] = []
        injected = [False]; sink_paths: list[Path] = []
        journal_mutation_identity: list[tuple[int, int, int, int]] = []

        def observe_mkdtemp(*args, **kwargs):
            value = Path(original_mkdtemp(*args, **kwargs)); allocations.append(value)
            if len(allocations) == ordinal: target_root.append(value)
            return str(value)

        def observe_open(path, flags, *args, **kwargs):
            fd = original_open(path, flags, *args, **kwargs)
            candidate = Path(path) if type(path) is str or type(path) is type(Path()) else None
            if target_root and candidate is not None and candidate.parent == target_root[0]:
                active = audit_active[0]
                if isinstance(active, dict):
                    if candidate not in sink_paths: sink_paths.append(candidate)
                    outputs = active["provider_outputs"]; assert isinstance(outputs, list)
                    if str(candidate) not in outputs: outputs.append(str(candidate))
                    opened = original_fstat(fd); identity = (opened.st_dev, opened.st_ino)
                    identities = active["sink_identities"]; assert isinstance(identities, list)
                    if identity not in identities: identities.append(identity)
            return fd

        def corrupt_journal(*args, **kwargs):
            event = args[1] if len(args) > 1 else kwargs.get("event")
            if event != "AGENT_START": return original_journal(*args, **kwargs)
            injected[0] = True
            if mode == "malformed_unrelated":
                append_gate_journal_bytes(case_repo, b'{"event":"OTHER",}\n')
            elif mode == "non_dict":
                append_gate_journal_bytes(case_repo, b'[]\n')
            elif mode == "truncated_start":
                append_gate_journal_bytes(case_repo, b'{"event":"AGENT_START"')
            elif mode == "valid_plus_truncated":
                original_journal(*args, **kwargs)
                append_gate_journal_bytes(case_repo, b'{"event":"AGENT_START"')
            elif mode == "duplicate_valid":
                original_journal(*args, **kwargs); original_journal(*args, **kwargs)
            elif mode == "chmod_same_inode":
                original_journal(*args, **kwargs)
                journal_path = module.journal_root(case_repo) / "events.jsonl"
                before_fd = journal_open(journal_path, os.O_RDONLY)
                try: before = journal_fstat(before_fd)
                finally: journal_close(before_fd)
                journal_path.chmod(0o666)
                after_fd = journal_open(journal_path, os.O_RDONLY)
                try: after = journal_fstat(after_fd)
                finally: journal_close(after_fd)
                if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
                    raise AssertionError("chmod mutant replaced journal object")
                journal_mutation_identity.append(
                    (before.st_dev, before.st_ino, stat.S_IMODE(before.st_mode),
                     stat.S_IMODE(after.st_mode)))
                append_gate_journal_bytes(case_repo, b'{"event":"OTHER","phase":"chmod"}\n')
            else: raise AssertionError(mode)
            raise OSError(f"H032 injected journal append corruption:{mode}")

        module.tempfile.mkdtemp = observe_mkdtemp
        module.os.open = observe_open; module.journal = corrupt_journal
        try: outcome = attempt(case_repo)
        finally:
            module.tempfile.mkdtemp = original_mkdtemp
            module.os.open = original_open; module.journal = original_journal
        observed = last_attempt_observed[0] or {}; case_capture = safe_capture()
        case_capture.update({
            "_gate_output_paths": list(observed.get("provider_outputs", [])),
            "_gate_canonical_paths": list(observed.get("canonical_paths", [])),
            "_gate_provider_process_starts": observed.get("provider_process_starts", -1),
            "_gate_private_paths": list(observed.get("private_paths", [])),
            "_gate_private_paths_present": list(observed.get("private_paths_present", [])),
            "_gate_sink_identities": list(observed.get("sink_identities", [])),
            "_gate_sink_fd_aliases": list(observed.get("sink_fd_aliases", [])),
            "_gate_journal_start_records": list(observed.get("journal_start_records", [])),
            "_gate_journal_append_valid": observed.get("journal_append_valid", False),
            "_gate_journal_append_error": observed.get("journal_append_error"),
            "_gate_journal_mutation_identity": list(journal_mutation_identity),
        })
        output_paths = [Path(value) for value in case_capture["_gate_output_paths"]]
        canonical_paths = [Path(value) for value in case_capture["_gate_canonical_paths"]]
        case = (outcome, case_capture,
                any(path.exists() or path.is_symlink() for path in output_paths),
                any(path.exists() or path.is_symlink() for path in canonical_paths), False)
        arena = observed.get("arena")
        if isinstance(arena, Path):
            top_roots = {path for path in map(Path, observed.get("private_paths", []))
                         if path.parent == arena}
            for path in sorted(top_roots, key=lambda item: len(item.parts), reverse=True):
                if path.is_symlink() or (path.exists() and not path.is_dir()): path.unlink()
                elif path.is_dir(): path.chmod(0o700); shutil.rmtree(path)
        return case, injected[0], [str(path) for path in target_root]

    journal_faults = {}; journal_faults_ok = False
