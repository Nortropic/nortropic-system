    def _r125_dependency_literal(node, *, allow_set=False):
        if isinstance(node, ast.Constant):
            return True
        if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
            return all(_r125_dependency_literal(item, allow_set=allow_set)
                       for item in node.elts)
        if isinstance(node, ast.Dict):
            return all(key is not None
                       and _r125_dependency_literal(key, allow_set=allow_set)
                       and _r125_dependency_literal(value, allow_set=allow_set)
                       for key, value in zip(node.keys, node.values))
        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.BitOr):
            # R129: static set-union of literal sets, as in the H-035 core.py
            # `PROSPECTIVE_OWNER_PATHS = REQUIRED_OWNER_PATHS | {...}`.  Each `|`
            # operand must be EITHER a literal (Set/Dict/List/Tuple/Constant, or
            # the set() call when allow_set) OR a bare module-level Name(Load) —
            # safe because the whole inventory module is validated literal-only
            # top-to-bottom, so any Name resolves to an already-defined literal.
            # Chained `A | B | C` recurses through the left BinOp.  Every dynamic
            # form still rejects: a Call other than the allowed set() form, any
            # Attribute (e.g. os.environ), a non-BitOr operator (e.g. `+`), a
            # comprehension or f-string.  A bare standalone Name value is NOT
            # accepted here (only as a BitOr operand), so a `X = ALIAS` bare-Name
            # assignment still rejects.
            def _r125_union_operand(operand):
                return (_r125_dependency_literal(operand, allow_set=allow_set)
                        or (isinstance(operand, ast.Name)
                            and isinstance(operand.ctx, ast.Load)))
            return (_r125_union_operand(node.left)
                    and _r125_union_operand(node.right))
        return (allow_set and isinstance(node, ast.Call)
                and isinstance(node.func, ast.Name) and node.func.id == "set"
                and len(node.args) == 1 and not node.keywords
                and _r125_dependency_literal(node.args[0], allow_set=False))
    def _r125_dependency_source_ok(text, expected_imports, *, allow_set=False,
                                   postponed_annotations=False):
        if type(text) is not str:
            return False
        try:
            dependency_tree = ast.parse(text)
        except (SyntaxError, ValueError, TypeError):
            return False
        if allow_set and any(
                (isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef,
                                   ast.ClassDef)) and node.name == "set")
                or (isinstance(node, ast.Name) and node.id == "set"
                    and isinstance(node.ctx, (ast.Store, ast.Del)))
                or (isinstance(node, (ast.Import, ast.ImportFrom))
                    and any((alias.asname or alias.name.split(".", 1)[0])
                            == "set" for alias in node.names))
                for node in ast.walk(dependency_tree)):
            return False
        imports = []
        for node in dependency_tree.body:
            if isinstance(node, ast.Import):
                imports.extend(f"I:{alias.name}" for alias in node.names)
            elif isinstance(node, ast.ImportFrom):
                imports.extend(f"F:{node.level}:{node.module or ''}:{alias.name}"
                               for alias in node.names)
        if imports != expected_imports or len(imports) != len(set(imports)):
            return False
        for node in dependency_tree.body:
            if isinstance(node, (ast.Import, ast.ImportFrom)):
                continue
            if (isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)
                    and isinstance(node.value.value, str)):
                continue
            if isinstance(node, ast.Assign):
                if (not all(isinstance(target, ast.Name) for target in node.targets)
                        or not _r125_dependency_literal(
                            node.value, allow_set=allow_set)):
                    return False
                continue
            if isinstance(node, ast.AnnAssign):
                if (not isinstance(node.target, ast.Name)
                        or not postponed_annotations
                        or (node.value is not None
                            and not _r125_dependency_literal(
                                node.value, allow_set=allow_set))):
                    return False
                continue
            if isinstance(node, ast.ClassDef):
                if (node.decorator_list or node.keywords
                        or any(not isinstance(base, ast.Name)
                               or base.id not in {"Exception", "ValueError"}
                               for base in node.bases)):
                    return False
                if any(not (isinstance(child, ast.Pass)
                            or (isinstance(child, ast.Expr)
                                and isinstance(child.value, ast.Constant)
                                and isinstance(child.value.value, str)))
                       for child in node.body):
                    return False
                continue
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                definition_values = (
                    *node.args.defaults,
                    *(value for value in node.args.kw_defaults
                      if value is not None))
                if (node.decorator_list
                        or (not postponed_annotations
                            and (any(arg.annotation is not None for arg in (
                                *node.args.posonlyargs, *node.args.args,
                                *node.args.kwonlyargs))
                                 or (node.args.vararg is not None
                                     and node.args.vararg.annotation is not None)
                                 or (node.args.kwarg is not None
                                     and node.args.kwarg.annotation is not None)
                                 or node.returns is not None))
                        or any(not _r125_dependency_literal(value)
                               for value in definition_values)):
                    return False
                continue
            return False
        return True
    _r125_core_path = repo / "controller/authority/core.py"
    _r125_dependency_specs = [(_r125_core_path, [
        "F:0:__future__:annotations", "I:json", "I:re", "I:subprocess",
        "F:0:pathlib:Path", "F:0:typing:Iterable"], False, True)]
