def lexical_path(value):
 if type(value) is str: raw=value
 elif type(value) is bytes:
  try: raw=value.decode(sys.getfilesystemencoding(),"surrogateescape")
  except Exception: return None
 elif type(value) is concrete_path_type:
  try: raw=original_purepath_str(value)
  except Exception: return None
 else: return None
