            "H032_LOCKED_SOURCE":str(provider),
            "H032_SAFE_ATTACK_ROOT":str(work),
            "H032_HOST_DIRECT_MARKER":str(work/"HOST_DIRECT_EXECUTED"),
            "H032_CAPTURE_COMPLETE_ENV":"1",
        })
        return expected
    def environment_fingerprint(mapping) -> dict[str,object]:
        valid=(isinstance(mapping,dict)
               and all(isinstance(key,str) and isinstance(value,str)
                       for key,value in mapping.items()))
        if not valid:
            return {"valid":False,"count":-1,"keyset_sha256":None,
                    "mapping_sha256":None}
        keys=json.dumps(sorted(mapping),ensure_ascii=True,
                        separators=(",",":")).encode("utf-8")
        encoded=json.dumps(mapping,sort_keys=True,ensure_ascii=True,
                           separators=(",",":")).encode("utf-8")
        return {"valid":True,"count":len(mapping),
                "keyset_sha256":hashlib.sha256(keys).hexdigest(),
                "mapping_sha256":hashlib.sha256(encoded).hexdigest()}
