    def fresh_success(case,raw):
        canonical=case.get("canonical") or {}
        return (case.get("rc")==0 and case.get("accepted") is True
            and case.get("fd_aliases")==[] and case.get("transition_ok") is True
            and case.get("publication_ok") is True
            and len(case.get("canonical_epochs",[]))==1
            and not case.get("canonical_direct_writes")
            and case.get("visibility_ok") is True and not case.get("temps")
            and not case.get("outside") and not case.get("post_events")
            and not case.get("env_events") and case.get("env_changed") is False
            and not case.get("security_events")
            and case.get("trap_unchanged") is True
            and case.get("ticket_selftest") and all(case["ticket_selftest"].values())
            and canonical.get("keys")==expected_binding_keys
            and canonical.get("schema_version_type")=="int"
            and canonical.get("schema_version")==1
            and canonical.get("invocation")=="1"*32 and canonical.get("run")=="2"*32
            and canonical.get("role")==canonical.get("report_role")=="TEST_AUTHOR"
            and canonical.get("result_sha256")==hashlib.sha256(raw).hexdigest())
    def fresh_reject(case,preseed=False):
        canonical=case.get("canonical")
        preseed_ok=(preseed and case.get("preseed") is not None and canonical is not None
            and canonical.get("dev")==case["preseed"][0]
            and canonical.get("ino")==case["preseed"][1]
            and canonical.get("digest")==hashlib.sha256(bytes.fromhex(case["preseed"][2])).hexdigest())
        return (case.get("rc")==0 and case.get("accepted") is False
            and case.get("fd_aliases")==[] and not case.get("temps")
            and not case.get("outside") and case.get("trap_unchanged") is True
            and not case.get("env_events") and case.get("env_changed") is False
            and not case.get("security_events")
            and case.get("ticket_selftest") and all(case["ticket_selftest"].values())
            and (canonical is None or preseed_ok))
