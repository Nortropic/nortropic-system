    product_fresh_cases={};product_fresh_ok=False
    if kernel_structure_ok:
        product_fresh_cases={
            "valid":fresh_kernel_effect(result_kernel,rig_valid_raw),
            "max":fresh_kernel_effect(result_kernel,exact_sized_report(MAX_RESULT_BYTES)),
