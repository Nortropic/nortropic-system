    # R116 CONTROL 05 — concurrent-canonical no-overwrite (E167-REV-05, owner
    # precision #5).  A foreign canonical is published by an audit-hook adversary
    # in the exact pre-syscall window before the kernel's own publish.  A safe
    # kernel publishes with a no-overwrite primitive: it REJECTS (accepted False)
    # and PRESERVES the foreign object's inode+digest.  An os.replace kernel
    # overwrites the foreign object and accepts.  Rejection alone is insufficient
    # per the owner precision — the foreign object must survive unchanged.
    def concurrent_canonical_preserved(case):
        foreign=case.get("concurrent_canonical");canonical=case.get("canonical")
        return (case.get("rc")==0 and case.get("concurrent_injected") is True
            and case.get("accepted") is False
            and foreign is not None and canonical is not None
            and canonical.get("dev")==foreign.get("dev")
            and canonical.get("ino")==foreign.get("ino")
            and canonical.get("digest")==foreign.get("digest"))
