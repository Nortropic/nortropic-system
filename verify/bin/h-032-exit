    r51_capture_results=[kernel_structure_inventory(ast.parse(text),text)[0]
                         for text in r51_capture_sources]
    r51_shadow_sources=(
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _shadow_parameter(os):\n    return os\ndef _bounded(fd):"),
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _shadow_local():\n    json=1\n    return json\ndef _bounded(fd):"),
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _shadow_comprehension(values):\n    return [pathlib for pathlib in values]\ndef _bounded(fd):"),
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _shadow_exception():\n    try:\n        raise ValueError()\n    except Exception as os:\n        return os\ndef _bounded(fd):"),
    )
    r51_shadow_results=[kernel_structure_inventory(ast.parse(text),text)[0]
                        for text in r51_shadow_sources]
    r51_alias_escape_sources=(
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _module_escape():\n    return os\ndef _bounded(fd):"),
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _container_escape():\n    return {'module': json}\ndef _bounded(fd):"),
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _rebound():\n    os=1\n    import os\n    return os.stat('.')\ndef _bounded(fd):"),
    )
    r51_alias_escape_results=[kernel_structure_inventory(ast.parse(text),text)[0]
                              for text in r51_alias_escape_sources]
    r51_path_deferred_sources=(
        kernel_inventory_fixture.replace("return _bounded(sink_fd)",
            "Path(canonical_destination).chmod(0o600)\n    return _bounded(sink_fd)"),
        kernel_inventory_fixture.replace("return _bounded(sink_fd)",
            "target=Path(canonical_destination)\n    target.mkdir(exist_ok=True)\n    return _bounded(sink_fd)"),
        kernel_inventory_fixture.replace("return _bounded(sink_fd)",
            "Path(canonical_destination).symlink_to('target')\n    return _bounded(sink_fd)"),
    )
    r51_path_deferred_results=[kernel_structure_inventory(ast.parse(text),text)[0]
                               for text in r51_path_deferred_sources]
    r52_namedexpr_sources=(
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _walrus_same_scope(fd):\n    import os\n    data=os.pread(fd,1,0)\n    [(os:=1) for unused in (0,)]\n    return data\ndef _bounded(fd):"),
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _walrus_nested(fd):\n    import os\n    data=os.pread(fd,1,0)\n    [[(os:=1) for inner in (0,)] for outer in (0,)]\n    return data\ndef _bounded(fd):"),
        kernel_inventory_fixture.replace("import stat","import stat\nimport os").replace(
            "def _bounded(fd):",
            "[(os:=1) for unused in (0,)]\ndef _bounded(fd):"),
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _walrus_global(fd):\n    global os\n    [(os:=1) for unused in (0,)]\n    return fd\ndef _bounded(fd):"),
        kernel_inventory_fixture.replace("def _bounded(fd):",
            "def _ordinary_target(values):\n    return [os for os in values]\ndef _bounded(fd):"),
