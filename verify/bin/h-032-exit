                def _owner_delta(repo, base, changes):
                    root = Path(_r125_tempfile.mkdtemp(prefix="r128-owner-delta-", dir=_flow_root))
                    clone = root / "repo"; index = root / "index"
                    env = dict(os.environ, PATH="/usr/bin:/bin", HOME=str(r122),
                               GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL="/dev/null",
                               GIT_NO_REPLACE_OBJECTS="1", GIT_ALTERNATE_OBJECT_DIRECTORIES="")
                    subprocess.run(["/usr/bin/git", "clone", "--no-local", "--no-hardlinks",
                                    "-q", str(repo), str(clone)], env=env, check=True)
                    env.update(GIT_DIR=str(clone / ".git"), GIT_INDEX_FILE=str(index))
                    try:
                        subprocess.run(["/usr/bin/git", "read-tree", base], env=env, check=True)
                        for rel, value in changes.items():
                            payload, replace = value if isinstance(value, tuple) else (value, False)
                            prior = subprocess.run(["/usr/bin/git", "show", f"{base}:{rel}"],
                                env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout
                            row = subprocess.run(["/usr/bin/git", "ls-tree", base, "--", rel],
                                env=env, stdout=subprocess.PIPE, check=True).stdout.split(None, 1)
                            mode = row[0] if row else b"100755"
                            blob = subprocess.run(["/usr/bin/git", "hash-object", "-w", "--stdin"],
                                env=env, input=payload if replace else prior + payload,
                                stdout=subprocess.PIPE, check=True).stdout.strip()
                            subprocess.run(["/usr/bin/git", "update-index", "--add", "--cacheinfo",
                                mode + b"," + blob + b"," + rel.encode()], env=env, check=True)
                        patch = subprocess.run(["/usr/bin/git", "diff", "--cached", "--binary",
                            "--full-index", "--no-renames", base, "--", *changes], env=env,
                            stdout=subprocess.PIPE, check=True).stdout
                        return r122_delta(patch, base=base)
                    finally:
                        shutil.rmtree(root)
