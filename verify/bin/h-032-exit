                                "git","ctypes","multiprocessing","asyncio"}
        callable_module_members={
            "hashlib":{("sha256",)},"json":{("loads",),("dumps",)},
            "stat":{("S_ISREG",)},"tempfile":{("mkstemp",)},
            "pathlib":{("Path",)},"fcntl":{("fcntl",)},
            "os":{("open",),("close",),("read",),("pread",),("readv",),("preadv",),
                  ("write",),("pwrite",),("lseek",),("fstat",),("stat",),("lstat",),
                  ("access",),("readlink",),("fsync",),("unlink",),("remove",),
                  ("replace",),("rename",),("fspath",),("path","dirname"),
                  ("path","abspath"),("path","realpath"),("path","lexists")},
        }
        # This is a lexical binding inventory, not a Python control-flow
        # interpreter.  It distinguishes an actual import capability from a
        # same-spelled parameter/local/comprehension binding and rejects any
        # scope that rebinds an imported capability.
        imports=[];imports_ok=True;scope_parent={tree:None};scope_bindings={tree:{}}
        node_scope={}
        def bind(scope,name,kind,value=None):
            scope_bindings.setdefault(scope,{}).setdefault(name,set()).add((kind,value))
        def bind_arguments(scope,args):
            for arg in (*args.posonlyargs,*args.args,*args.kwonlyargs): bind(scope,arg.arg,"local")
            if args.vararg is not None: bind(scope,args.vararg.arg,"local")
            if args.kwarg is not None: bind(scope,args.kwarg.arg,"local")
        class LexicalBindings(ast.NodeVisitor):
            def __init__(self): self.scope=tree
            def visit(self,node):
                node_scope.setdefault(node,self.scope)
                return super().visit(node)
            def visit_Name(self,node):
                if isinstance(node.ctx,(ast.Store,ast.Del)): bind(self.scope,node.id,"local")
            def visit_ExceptHandler(self,node):
                if node.type is not None: self.visit(node.type)
                if isinstance(node.name,str): bind(self.scope,node.name,"local")
                for statement in node.body: self.visit(statement)
            def generic_visit(self,node):
                # Pattern-capture names are strings rather than Name(Store)
                # nodes on runtimes that support structural matching.
                node_name=type(node).__name__
                if node_name in {"MatchAs","MatchStar"} and isinstance(getattr(node,"name",None),str):
                    bind(self.scope,node.name,"local")
                if node_name=="MatchMapping" and isinstance(getattr(node,"rest",None),str):
                    bind(self.scope,node.rest,"local")
                return super().generic_visit(node)
            def visit_Import(self,node):
                nonlocal_imports=[]
                for alias in node.names:
                    nonlocal_imports.append((alias.name,alias.asname))
                    root=alias.name.split(".",1)[0]
                    permitted=(alias.asname is None and alias.name in allowed_modules
                               and root not in forbidden_module_roots)
                    nonlocal imports_ok
                    imports_ok &= permitted
                    bind(self.scope,alias.asname or root,"module",alias.name)
                imports.extend(nonlocal_imports)
            def visit_ImportFrom(self,node):
                nonlocal imports_ok
                imports.append((node.module or "",tuple((a.name,a.asname) for a in node.names)))
                permitted=(node.level==0 and node.module in allowed_from
                           and all(alias.name in allowed_from.get(node.module,set())
                                   and alias.name!="*" and alias.asname is None
                                   for alias in node.names))
                imports_ok &= permitted
                for alias in node.names:
                    bind(self.scope,alias.asname or alias.name,"member",
                         f"{node.module}.{alias.name}")
            def visit_FunctionDef(self,node):
                bind(self.scope,node.name,"local")
                for item in node.decorator_list: self.visit(item)
                for item in (*node.args.defaults,*node.args.kw_defaults):
                    if item is not None: self.visit(item)
                for arg in (*node.args.posonlyargs,*node.args.args,*node.args.kwonlyargs):
                    if arg.annotation is not None: self.visit(arg.annotation)
                if node.args.vararg and node.args.vararg.annotation: self.visit(node.args.vararg.annotation)
                if node.args.kwarg and node.args.kwarg.annotation: self.visit(node.args.kwarg.annotation)
                if node.returns is not None: self.visit(node.returns)
                outer=self.scope;scope_parent[node]=outer;scope_bindings[node]={};self.scope=node
                bind_arguments(node,node.args)
                for statement in node.body: self.visit(statement)
                self.scope=outer
            visit_AsyncFunctionDef=visit_FunctionDef
            def visit_Lambda(self,node):
                for item in (*node.args.defaults,*node.args.kw_defaults):
                    if item is not None: self.visit(item)
                outer=self.scope;scope_parent[node]=outer;scope_bindings[node]={};self.scope=node
                bind_arguments(node,node.args);self.visit(node.body);self.scope=outer
            def visit_ClassDef(self,node):
                bind(self.scope,node.name,"local")
                for item in node.decorator_list: self.visit(item)
                for item in node.bases: self.visit(item)
                for item in node.keywords: self.visit(item.value)
                outer=self.scope;scope_parent[node]=outer;scope_bindings[node]={};self.scope=node
                for statement in node.body: self.visit(statement)
                self.scope=outer
            def visit_comprehension_scope(self,node,value_nodes):
                outer=self.scope
                if node.generators: self.visit(node.generators[0].iter)
                scope_parent[node]=outer;scope_bindings[node]={};self.scope=node
                for index,generator in enumerate(node.generators):
                    if index: self.visit(generator.iter)
                    self.visit(generator.target)
                    for condition in generator.ifs: self.visit(condition)
                for value in value_nodes: self.visit(value)
                self.scope=outer
            def visit_NamedExpr(self,node):
                # Python 3.9 assignment expressions in comprehensions bind in
                # the nearest enclosing non-comprehension scope, never in the
                # synthetic comprehension iteration scope.  The value still
                # resolves in the current expression scope and is evaluated
                # before the target binding.
                self.visit(node.value)
                target_scope=self.scope
                while isinstance(target_scope,(ast.ListComp,ast.SetComp,
                                                 ast.DictComp,ast.GeneratorExp)):
                    target_scope=scope_parent.get(target_scope)
                if isinstance(node.target,ast.Name):
                    node_scope[node.target]=target_scope
                    bind(target_scope,node.target.id,"local")
                else:
                    outer=self.scope;self.scope=target_scope
                    self.visit(node.target);self.scope=outer
            def visit_ListComp(self,node): self.visit_comprehension_scope(node,(node.elt,))
            visit_SetComp=visit_ListComp
            visit_GeneratorExp=visit_ListComp
            def visit_DictComp(self,node): self.visit_comprehension_scope(node,(node.key,node.value))
        LexicalBindings().visit(tree)
        def resolve_binding(node):
            scope=node_scope.get(node,tree)
            while scope is not None:
                records=scope_bindings.get(scope,{}).get(node.id,set())
                if records:
                    return next(iter(records)) if len(records)==1 else ("ambiguous",None)
                scope=scope_parent.get(scope)
            return ("unbound",None)
        forbidden_names={"eval","exec","compile","__import__","globals","locals","vars",
                         "getattr","setattr","delattr","subprocess","socket","urllib","http",
                         "importlib","requests","git","__builtins__"}
        forbidden_attrs={"__dict__","__globals__","__getattribute__","__subclasses__","__mro__"}
        parents={child:parent for parent in ast.walk(tree) for child in ast.iter_child_nodes(parent)}
        module_capability_ok=True;module_uses=[];ambiguous_capability=False
        for node in ast.walk(tree):
            if not (isinstance(node,ast.Name) and isinstance(node.ctx,ast.Load)): continue
            kind,module_name=resolve_binding(node)
            if kind=="ambiguous":
                ambiguous_capability=True
                continue
            if kind!="module": continue
            current=node;parts=[]
            while isinstance(parents.get(current),ast.Attribute) \
                    and parents[current].value is current:
                current=parents[current];parts.append(current.attr)
            chain=tuple(parts)
            permitted=(chain in allowed_module_members.get(module_name,set())
                       and (chain not in callable_module_members.get(module_name,set())
                            or (isinstance(parents.get(current),ast.Call)
                                and parents[current].func is current)))
            module_uses.append((module_name,chain,permitted))
            module_capability_ok &= permitted
        imported_member_ok=True
        for node in ast.walk(tree):
            if not (isinstance(node,ast.Name) and isinstance(node.ctx,ast.Load)): continue
            kind,capability=resolve_binding(node)
            if kind!="member": continue
            parent=parents.get(node)
            permitted=(capability=="pathlib.Path" and isinstance(parent,ast.Call)
                       and parent.func is node)
            imported_member_ok &= permitted
        forbidden_alias_use=ambiguous_capability
        forbidden_literals=any(isinstance(node,ast.Constant) and isinstance(node.value,str)
            and any(token in node.value.casefold() for token in (
                "codex-provider-identity","/config/","\\config\\","provider-identity",
                "executable_sha256","code_mode_host_path"))
            for node in ast.walk(tree))
        forbidden_use=any(
            (isinstance(node,ast.Name) and node.id in forbidden_names)
            or (isinstance(node,ast.Attribute) and node.attr in forbidden_attrs)
            or isinstance(node,(ast.Global,ast.Nonlocal,ast.ClassDef))
            for node in ast.walk(tree))
        # These are the expression surfaces Python evaluates while defining a
        # module. Function bodies stay dormant, but defaults, annotations and
        # decorators do not. Class bodies and comprehension expressions are
        # reached recursively. Dynamic path effects are independently audited
        # before exec; this inventory closes capability provenance and makes
        # the evaluated surface explicit without interpreting control flow.
        import_time_expressions=[]
        class ImportTimeExpressions(ast.NodeVisitor):
            def remember(self,node):
                if node is not None: import_time_expressions.append(node);self.visit(node)
            def visit_Module(self,node):
                for statement in node.body: self.visit(statement)
            def visit_FunctionDef(self,node):
                for item in node.decorator_list: self.remember(item)
                for item in (*node.args.defaults,*node.args.kw_defaults): self.remember(item)
                for arg in (*node.args.posonlyargs,*node.args.args,*node.args.kwonlyargs):
                    self.remember(arg.annotation)
                self.remember(node.args.vararg.annotation if node.args.vararg else None)
                self.remember(node.args.kwarg.annotation if node.args.kwarg else None)
                self.remember(node.returns)
            visit_AsyncFunctionDef=visit_FunctionDef
            def visit_Lambda(self,node):
                for item in (*node.args.defaults,*node.args.kw_defaults): self.remember(item)
            def visit_ClassDef(self,node):
                for item in node.decorator_list: self.remember(item)
                for item in node.bases: self.remember(item)
                for item in node.keywords: self.remember(item.value)
                for statement in node.body: self.visit(statement)
            def visit_Assign(self,node): self.remember(node.value)
            def visit_AnnAssign(self,node):
                self.remember(node.annotation);self.remember(node.value)
            def visit_AugAssign(self,node): self.remember(node.value)
            def visit_Expr(self,node): self.remember(node.value)
        ImportTimeExpressions().visit(tree)
        def forbidden_expression(node):
            return any((isinstance(child,ast.Name) and child.id in forbidden_names)
                or (isinstance(child,ast.Attribute) and child.attr in forbidden_attrs)
                or (isinstance(child,(ast.Import,ast.ImportFrom,ast.Global,ast.Nonlocal)))
                for child in ast.walk(node))
        import_time_forbidden=any(forbidden_expression(node)
                                  for node in import_time_expressions)
        def immutable_literal(node):
            return (isinstance(node,ast.Constant)
                or (isinstance(node,ast.Tuple) and all(immutable_literal(item) for item in node.elts)))
        module_shape=True
        for node in tree.body:
            if isinstance(node,(ast.Import,ast.ImportFrom,ast.FunctionDef)): continue
            if isinstance(node,ast.Assign):
                names=[target.id for target in node.targets if isinstance(target,ast.Name)]
                module_shape &= (len(names)==len(node.targets)
                                 and all(name=="__all__" or name.isupper() for name in names)
                                 and (names==["__all__"] or immutable_literal(node.value)))
                continue
            if isinstance(node,ast.Expr) and isinstance(node.value,ast.Constant) \
                    and isinstance(node.value.value,str): continue
            module_shape=False
        consumer_ok=(len(consumers)==1 and not consumers[0].decorator_list
            and not consumers[0].args.posonlyargs and not consumers[0].args.kwonlyargs
            and consumers[0].args.vararg is None and consumers[0].args.kwarg is None
            and not consumers[0].args.defaults and not consumers[0].args.kw_defaults
            and [arg.arg for arg in consumers[0].args.args]==expected_args)
        max_assign=[node for node in tree.body if isinstance(node,ast.Assign)
            and any(isinstance(target,ast.Name) and target.id=="MAX_RESULT_BYTES"
                    for target in node.targets)]
        max_ok=(len(max_assign)==1 and isinstance(max_assign[0].value,ast.Constant)
                and type(max_assign[0].value.value) is int
                and max_assign[0].value.value==4194304)
        identity_words={"provider","authority","fixture","session","thread"}
        hidden_identity=any(isinstance(node,ast.Name)
            and any(word in node.id.casefold() for word in identity_words)
            for node in ast.walk(tree))
        attribute_write=any(isinstance(node,ast.Attribute)
            and isinstance(node.ctx,(ast.Store,ast.Del)) for node in ast.walk(tree))
        return (consumer_ok and export_ok and imports_ok and module_shape and max_ok
                and not forbidden_use and not forbidden_alias_use and not forbidden_literals
                and not hidden_identity and not attribute_write and not import_time_forbidden
                and module_capability_ok and imported_member_ok), {
            "consumer":consumer_ok,"export":export_ok,"imports":tuple(imports),
            "imports_ok":imports_ok,"module_shape":module_shape,"max":max_ok,
            "forbidden":forbidden_use,"forbidden_alias":forbidden_alias_use,
            "forbidden_literal":forbidden_literals,"hidden_identity":hidden_identity,
            "attribute_write":attribute_write,"import_time_expressions":len(import_time_expressions),
            "import_time_forbidden":import_time_forbidden,"module_capability":module_capability_ok,
            "imported_member":imported_member_ok,"ambiguous_capability":ambiguous_capability,
            "module_uses":tuple(module_uses)}

    def integration_structure_inventory(tree):
        parents={child:parent for parent in ast.walk(tree) for child in ast.iter_child_nodes(parent)}
        definitions={node.name:node for node in tree.body if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef))}
        run=definitions.get("run_codex")
        imports=[node for node in ast.walk(tree) if isinstance(node,ast.ImportFrom)
            and node.level==0 and node.module=="controller.result.consumer"
            and len(node.names)==1 and node.names[0].name=="consume_private_result"
            and node.names[0].asname is None]
        reachable={"run_codex"} if run is not None else set()
        calls=[]
        if run is not None:
            calls=[("run_codex",call) for call in ast.walk(run)
                if isinstance(call,ast.Call) and isinstance(call.func,ast.Name)
                and call.func.id=="consume_private_result"]
        args_ok=(len(calls)==1 and len(calls[0][1].args)==5
            and not calls[0][1].keywords
            and all(isinstance(arg,ast.Name) for arg in calls[0][1].args)
            and len({arg.id for arg in calls[0][1].args})==5)
        result_connected=False;connection_mode="NONE"
        if len(calls)==1:
            call=calls[0][1];parent=parents.get(call)
            valued_returns=[node for node in ast.walk(run)
                            if isinstance(node,ast.Return) and node.value is not None]
            if isinstance(parent,ast.Return):
                result_connected=(valued_returns==[parent]);connection_mode="DIRECT_RETURN"
            elif isinstance(parent,(ast.Assign,ast.AnnAssign)):
                targets=(parent.targets if isinstance(parent,ast.Assign) else [parent.target])
                names={target.id for target in targets if isinstance(target,ast.Name)}
                if len(names)==1 and len(targets)==1:
                    name=next(iter(names))
                    stores=[node for node in ast.walk(run) if isinstance(node,ast.Name)
                            and isinstance(node.ctx,(ast.Store,ast.Del)) and node.id==name]
                    loads=[node for node in ast.walk(run) if isinstance(node,ast.Name)
                           and isinstance(node.ctx,ast.Load) and node.id==name]
                    exact_returns=[node for node in valued_returns
                        if isinstance(node.value,ast.Name) and node.value.id==name]
                    result_connected=(len(stores)==1 and len(loads)==1
                        and len(exact_returns)==1 and valued_returns==exact_returns
                        and parents.get(loads[0]) is exact_returns[0])
                    if result_connected: connection_mode="SINGLE_ASSIGN_RETURN"
        all_consumer_calls=[node for node in ast.walk(tree) if isinstance(node,ast.Call)
            and isinstance(node.func,ast.Name) and node.func.id=="consume_private_result"]
        local_shadow=any(isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef))
            and node.name=="consume_private_result" for node in tree.body)
        ok=(len(imports)==1 and len(all_consumer_calls)==1 and len(calls)==1
            and args_ok and result_connected and not local_shadow)
        return ok,{"imports":len(imports),"reachable":tuple(sorted(reachable)),
                   "call_owners":tuple(owner for owner,_ in calls),"args":args_ok,
                   "result_connected":result_connected,"all_calls":len(all_consumer_calls),
                   "local_shadow":local_shadow,"connection_mode":connection_mode}

