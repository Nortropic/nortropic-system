#!/bin/bash -p
# h-032-exit — fresh owner-frozen Codex executable-family identity boundary
#
# Predicted controls before execution:
#   valid locked bytes under an arbitrary basename -> admitted through a private snapshot
#   PATH shadow, relative path, symlink, directory, non-executable and hash drift -> rejected
#   source mutation by the launched fixture -> running image remains the verified snapshot

set -u
umask 077
unset CDPATH ENV BASH_ENV GLOBIGNORE PYTHONHOME PYTHONPATH
export PATH="/usr/bin:/bin:/opt/homebrew/bin"

SOURCE_PATH="${BASH_SOURCE[0]}"
case "$SOURCE_PATH" in
  /*) ;;
  *) SOURCE_PATH="$(/bin/pwd -P)/$SOURCE_PATH" ;;
esac
if [[ -L "$SOURCE_PATH" ]]; then
  echo "ODÖMBART K0 — grindens entry är en symlink"
  exit 2
fi
SCRIPT_DIR="$(cd -P -- "$(/usr/bin/dirname -- "$SOURCE_PATH")" 2>/dev/null && /bin/pwd -P)" || exit 2
ROOT="$(cd -P -- "$SCRIPT_DIR/../.." 2>/dev/null && /bin/pwd -P)" || exit 2
if [[ ! "$SOURCE_PATH" -ef "$ROOT/verify/bin/h-032-exit" ]]; then
  echo "ODÖMBART K0 — icke-kanonisk grindentry"
  exit 2
fi
SOURCE="$ROOT/scripts/nortropic-codex-autopilot.py"
RESULT_KERNEL="$ROOT/controller/result/consumer.py"
AUTHORITY="$ROOT/config/codex-provider-identity.json"
SCHEMA="$ROOT/docs/loop/codex-autopilot-report.schema.json"
OWNER_LIVE_HELPER="$ROOT/verify/bin/h-032-owner-live-call"
OWNER_LIVE_HELPER_SHA256="6dda8330d1a7bb8020ca76a8ab7d26ea3d57e507db6f7f211b448b3770614e1f"
if [[ -L "$OWNER_LIVE_HELPER" || ! -f "$OWNER_LIVE_HELPER" || ! -x "$OWNER_LIVE_HELPER" ]]; then
  echo "ODÖMBART K0 — owner-live helper identity invalid"
  exit 2
fi
OBSERVED_OWNER_LIVE_HELPER_SHA256="$(/usr/bin/shasum -a 256 -- "$OWNER_LIVE_HELPER" | /usr/bin/awk '{print $1}')"
if [[ "$OBSERVED_OWNER_LIVE_HELPER_SHA256" != "$OWNER_LIVE_HELPER_SHA256" ]]; then
  echo "ODÖMBART K0 — owner-live helper digest mismatch"
  exit 2
fi
WORK="$(/usr/bin/mktemp -d /private/tmp/nortropic-h032.XXXXXX)" || exit 2
case "$WORK" in /private/tmp/nortropic-h032.*) ;; *) echo "ODÖMBART K0 — osäker tempidentitet"; exit 2;; esac
GATE_PID="";HELPER_PID="";PROTOCOL_INTERRUPTED=0
quiesce_protocol() {
  for owned_pid in "${HELPER_PID:-}" "${GATE_PID:-}"; do
    [[ -n "$owned_pid" ]] || continue
    /bin/kill -TERM "$owned_pid" 2>/dev/null || true
  done
  for owned_pid in "${HELPER_PID:-}" "${GATE_PID:-}"; do
    [[ -n "$owned_pid" ]] || continue
    wait "$owned_pid" 2>/dev/null || true
  done
}
cleanup() {
  cleanup_rc=$?
  trap - EXIT HUP INT TERM
  if [[ "$PROTOCOL_INTERRUPTED" == 1 && ( -n "${HELPER_PID:-}" || -n "${GATE_PID:-}" ) ]]; then
    exit "$cleanup_rc"
  fi
  quiesce_protocol
  case "${WORK:-}" in
    /private/tmp/nortropic-h032.*) /bin/rm -rf -- "$WORK" || cleanup_rc=2 ;;
    *) cleanup_rc=2 ;;
  esac
  exit "$cleanup_rc"
}
trap cleanup EXIT
trap 'PROTOCOL_INTERRUPTED=1; exit 129' HUP
trap 'PROTOCOL_INTERRUPTED=1; exit 130' INT
trap 'PROTOCOL_INTERRUPTED=1; exit 143' TERM

G20_EMIT=""
OWNER_LIVE_MODE="run"
if [[ $# -gt 0 ]]; then
  case "$1:$#" in
    --emit-g20-evidence:2) G20_EMIT="$2" ;;
    --skip-owner-live:1) OWNER_LIVE_MODE="skip" ;;
    *)
      echo "ODÖMBART K0 — användning: h-032-exit [--emit-g20-evidence <path> | --skip-owner-live]"
      exit 2
      ;;
  esac
fi

OWNER_LIVE_CONTROL="$WORK/owner-live-control"
/bin/mkdir -m 700 -- "$OWNER_LIVE_CONTROL" || exit 2
OWNER_LIVE_PLAN="$OWNER_LIVE_CONTROL/plan.json"
OWNER_LIVE_RESULT="$OWNER_LIVE_CONTROL/result.json"

run_gate_python() {
/usr/bin/python3 -I -S - "$SOURCE" "$RESULT_KERNEL" "$AUTHORITY" "$SCHEMA" "$WORK/gate" "$G20_EMIT" "$OWNER_LIVE_MODE" "$OWNER_LIVE_PLAN" "$OWNER_LIVE_RESULT" "$OWNER_LIVE_HELPER" "$OWNER_LIVE_HELPER_SHA256" <<'PY'
