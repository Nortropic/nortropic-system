                    ==(before.st_size,digest,before.st_mtime_ns,before.st_ctime_ns,mutation_versions.get(identity,0)))
    transitions.append({"absent":absent,"dev":before.st_dev,"ino":before.st_ino,"size":before.st_size,"digest":digest,"stable":(before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns,before.st_ctime_ns)==(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns,after.st_ctime_ns),"writers":writers,"fsynced":sync_match})
    held.append(fd);transition_done[0]=True
   except Exception:
