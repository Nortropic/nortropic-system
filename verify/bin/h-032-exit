    def rejected_clean(case, *, expected_process_starts: int = 1,
                       expected_output_paths: int = 1,
                       expected_journal_starts: tuple[int, ...] = (1,)) -> bool:
        result, case_capture, output_exists, canonical_exists, hostile_exists = case
