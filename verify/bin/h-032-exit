    effect_sink_swap = causal_result_case("paused_valid", sink_attack="path_swap")
    effect_once_ok = effect_once[0][0] and len(effect_once[1]) == 1 and effect_once[2]
    effect_two_values_observed = (effect_two_values[0][0] and len(effect_two_values[1]) == 2
                                  and len({item[2] for item in effect_two_values[1]}) == 2)
    effect_two_promotions_caught = (not effect_two_promotions[0][0]
                                    and len(effect_two_promotions[1]) == 1
                                    and effect_two_promotions[2] and effect_two_promotions[3]
                                    and not effect_two_promotions[0][4])
    effect_sink_attacks_caught = (not effect_sink_swap[0][0]
                                  and not effect_sink_swap[0][4])

    # Reproduce repo == ROT and LIVE_GIT physically without touching the shared
