            module.journal(fixture_repo, "PREEXISTING_HISTORY", marker="preserve-me")
        before = journal_object(fixture_repo)
        if replace and path.exists():
            old = path.read_bytes(); path.unlink(); path.write_bytes(old)
        if truncate and path.exists():
            path.write_bytes(path.read_bytes()[:-1])
        if chmod_mode is not None and path.exists():
            path.chmod(chmod_mode)
        if suffix: append_gate_journal_bytes(fixture_repo, suffix)
        return strict_journal_append(before, fixture_repo)

