    # R12 boundary: a fresh interpreter imports the exact candidate source and
    # retains the genuine stdlib subprocess.Popen object.  Each behavior is
    # intrinsic to a separately hashed provider authority; neither environment
    # modes nor monkeypatch state crosses into the subject process.
    r12_runner = work / "r12-real-popen-runner.py"
    r12_runner.write_text("import importlib.util,json,pathlib,sys\n"
"source,repo,wt=map(pathlib.Path,sys.argv[1:4])\n"
"spec=importlib.util.spec_from_file_location('r12_exact_subject',source)\n"
"mod=importlib.util.module_from_spec(spec);sys.modules[spec.name]=mod;spec.loader.exec_module(mod)\n"
"if len(sys.argv)==5: mod.CODEX_RUN_TIMEOUT_SECONDS=int(sys.argv[4])\n"
"import subprocess\n"
"held_transition_fds=[]\n"
"transition_seen=[False]\n"
"def audit(event,args):\n"
" if event=='os.rename' and len(args)>=2 and str(args[1]).endswith('/result.json'):\n"
"  os=__import__('os');hashlib=__import__('hashlib');fd=os.open(args[0],os.O_RDONLY|getattr(os,'O_NOFOLLOW',0));st=os.fstat(fd);raw=b''\n"
"  while len(raw)<=5*1024*1024:\n"
"   chunk=os.read(fd,min(65536,5*1024*1024+1-len(raw)))\n"
"   if not chunk: break\n"
"   raw+=chunk\n"
"  held_transition_fds.append(fd)\n"
"  print('R15_CANONICAL_TRANSITION '+json.dumps({'src':str(args[0]),'dst':str(args[1]),'dev':st.st_dev,'ino':st.st_ino,'mode':st.st_mode,'size':st.st_size,'read_size':len(raw),'digest':hashlib.sha256(raw).hexdigest()},separators=(',',':')),flush=True)\n"
"  transition_seen[0]=True\n"
" elif transition_seen[0] and event in {'os.remove','os.rename','open'} and args and str(args[0]).endswith('/result.json'):\n"
"  print('R16_CANONICAL_OBJECT_EVENT '+event+' '+str(args[0]),flush=True)\n"
" if event=='subprocess.Popen':\n"
"  for value in args:\n"
"   if isinstance(value,(list,tuple)) and '-o' in value:\n"
"    print('R13_OUTPUT_PATH '+str(value[value.index('-o')+1]),flush=True)\n"
"sys.addaudithook(audit)\n"
"print('R12_POPEN_TYPE='+subprocess.Popen.__module__+'.'+subprocess.Popen.__qualname__,flush=True)\n"
"try:\n"
" r=mod.run_codex(repo,wt,'TEST_AUTHOR','H032-R12')\n"
" print('R12_OUTCOME=ADMITTED',flush=True)\n"
"except Exception as exc:\n"
" print('R12_OUTCOME=REJECTED:'+type(exc).__name__+':'+str(exc),flush=True)\n", encoding="utf-8")
    def r12_provider(case: str) -> Path:
        directory = work / f"r12-provider-{case}-{len(list(work.glob('r12-provider-*')))}"; directory.mkdir()
        host = directory / "codex-code-mode-host"
        host.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8"); host.chmod(0o700)
        program = directory / "provider"
        payload = json.dumps({
            "role":"TEST_AUTHOR","outcome":"READY","summary":"r12 causal value",
            "changed_files":[],"blocking_findings":[],"tests":[],
            "allowed_write_violation":False,"frozen_artifacts_modified":False,
            "production_files_modified":False,"frozen_gate_ready":True,
            "baseline_red_for_right_reason":True,"owner_decision_required":False,
            "stop_reason":"NONE","next_action":"BUILD","next_task_id":"h-032",
        }, separators=(",", ":"))
        program.write_text("#!/usr/bin/python3\n" +
            "import json,pathlib,subprocess,sys,time\n" +
            f"case={case!r}; payload={payload!r}\n" +
            "subprocess.run([str(pathlib.Path(sys.argv[0]).parent/'codex-code-mode-host')],check=True)\n" +
            "out=pathlib.Path(sys.argv[sys.argv.index('-o')+1])\n" +
            "if case=='escape':\n"
            " print('R12_ESCAPE_SINK '+str(out),flush=True)\n"
            " first=__import__('os').fork()\n"
            " if first==0:\n"
            "  second=__import__('os').fork()\n"
            "  if second==0:\n"
            "   __import__('os').setsid()\n"
            "   while True:\n"
            "    try: out.parent.mkdir(parents=True,exist_ok=True);out.write_text('late')\n"
            "    except Exception: pass\n"
            "    time.sleep(.1)\n"
            "  __import__('os')._exit(0)\n"
            " __import__('os').waitpid(first,0);time.sleep(3600)\n" +
            "def emit(n,data):\n"
            " out.write_text(data); release='R12_RELEASE_%d'%n\n"
            " limit=time.monotonic()+15\n"
            " while out.read_text()==data:\n"
            "  if time.monotonic()>limit: raise SystemExit(71)\n"
            "  time.sleep(.01)\n"
            " if out.read_text()!=release: raise SystemExit(72)\n"
            " out.write_text(data)\n" +
            "emit(1,payload)\n" +
            "if case=='two':\n"
            " value=json.loads(payload);value['summary']='r12 second';emit(2,json.dumps(value,separators=(',',':')))\n" +
            "print(json.dumps({'type':'thread.started','thread_id':'r12-thread'}),flush=True)\n",
            encoding="utf-8")
        program.chmod(0o700)
        return program
    def r12_real_case(case: str, inject_promotion: bool = False,
                      subject_source: Path = source, sink_attack: str | None = None):
        fixture = r12_provider(case)
        fixture_host = fixture.parent / "codex-code-mode-host"
        case_repo = make_repo(str(fixture), sha256(fixture), str(fixture_host), sha256(fixture_host))
        env = {key:value for key,value in os.environ.items()
               if not key.startswith("H032_")}
        proc = system_popen(["/usr/bin/python3", "-I", "-S", "-u", str(r12_runner),
                             str(subject_source), str(case_repo), str(case_repo)], stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, env=env)
        assert proc.stdout is not None
        selector = selectors.DefaultSelector(); selector.register(proc.stdout, selectors.EVENT_READ)
        identities=[]; outcome="NO_OUTCOME"; popen_type=""; canonical_absent=False
        canonical_transitions=[]
        canonical_object_events=[]
        sink=None; canonical=None
        closed_handled=set()
        def handle_closed(number: int):
            nonlocal canonical_absent,canonical
            assert sink is not None
            fd=os.open(sink,os.O_RDONLY|getattr(os,"O_NOFOLLOW",0))
            before=os.fstat(fd); parts=[]; total=0
            while total <= MAX_RESULT_BYTES:
                chunk=os.read(fd,min(65536,MAX_RESULT_BYTES+1-total))
                if not chunk: break
                parts.append(chunk);total+=len(chunk)
            raw=b"".join(parts)
            if sink_attack == "swap":
                old=sink.with_name(sink.name+".held");sink.rename(old);sink.write_bytes(raw)
            elif sink_attack == "mutate":
                alternate=strict_json(raw.decode("utf-8"))
                alternate["summary"]=alternate["summary"][::-1]
                alternate_raw=json.dumps(alternate,separators=(",",":")).encode()
                if len(alternate_raw)!=len(raw) or hashlib.sha256(alternate_raw).digest()==hashlib.sha256(raw).digest():
                    raise RuntimeError("R15 equal-length mutation fixture invalid")
                writer=os.open(sink,os.O_WRONLY|getattr(os,"O_NOFOLLOW",0))
                os.write(writer,alternate_raw);os.fsync(writer);os.close(writer)
            after=os.fstat(fd);os.close(fd)
            value=strict_json(raw.decode("utf-8"))
            identities.append((before.st_dev,before.st_ino,before.st_mode,before.st_size,
                               before.st_mtime_ns,before.st_ctime_ns,
                               after.st_dev,after.st_ino,after.st_mode,after.st_size,
                               after.st_mtime_ns,after.st_ctime_ns,
                               hashlib.sha256(raw).hexdigest(),
                               complete_schema_valid(value,schema_document)))
            runs=sorted((module.journal_root(case_repo)/"runs").iterdir())
            if len(runs)!=1: raise RuntimeError("R12 controller canonical identity ambiguous")
            canonical=runs[0]/"result.json"; canonical_absent=not canonical.exists()
            if inject_promotion: canonical.write_bytes(raw)
            sink.write_text(f"R12_RELEASE_{number}",encoding="utf-8")
            closed_handled.add(number)
        deadline=time.monotonic()+25
        while time.monotonic()<deadline and proc.poll() is None:
            events=selector.select(timeout=.25)
            for key,_mask in events:
                line=key.fileobj.readline().strip()
                if line.startswith("R12_POPEN_TYPE="): popen_type=line.split("=",1)[1]
                elif line.startswith("R13_OUTPUT_PATH "): sink=Path(line.split(" ",1)[1])
                elif line.startswith("R15_CANONICAL_TRANSITION "):
                    canonical_transitions.append(strict_json(line.split(" ",1)[1]))
                elif line.startswith("R16_CANONICAL_OBJECT_EVENT "):
                    canonical_object_events.append(line)
                elif line.startswith("R12_OUTCOME="): outcome=line.split("=",1)[1]
            if sink is not None:
                for number in (1,2):
                    if number in closed_handled: continue
                    try:
                        candidate_raw=bounded_stable_result(sink)
                        candidate_value=strict_json(candidate_raw.decode("utf-8",errors="strict"))
                        candidate_digest=hashlib.sha256(candidate_raw).hexdigest()
                        prior_digest=(identities[0][12] if identities else None)
                        if (complete_schema_valid(candidate_value,schema_document)
                                and (number==1 or candidate_digest!=prior_digest)):
                            handle_closed(number)
                    except Exception: pass
        try: proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.terminate()
            try: proc.wait(timeout=2)
            except subprocess.TimeoutExpired: proc.kill(); proc.wait()
        for line in proc.stdout:
            line=line.strip()
            if line.startswith("R12_OUTCOME="): outcome=line.split("=",1)[1]
            elif line.startswith("R15_CANONICAL_TRANSITION "):
                canonical_transitions.append(strict_json(line.split(" ",1)[1]))
            elif line.startswith("R16_CANONICAL_OBJECT_EVENT "):
                canonical_object_events.append(line)
        post_canonical=None; staging_absent=(sink is None or not sink.parent.exists())
        if canonical is not None and canonical.is_file():
            try:
                fd=os.open(canonical,os.O_RDONLY|getattr(os,"O_NOFOLLOW",0));st=os.fstat(fd)
                raw=b""
                while len(raw)<=MAX_CANONICAL_BYTES:
                    chunk=os.read(fd,min(65536,MAX_CANONICAL_BYTES+1-len(raw)))
                    if not chunk: break
                    raw+=chunk
                end=os.fstat(fd);os.close(fd)
                document=strict_json(raw.decode("utf-8"))
                post_canonical=(st.st_dev,st.st_ino,st.st_size,end.st_dev,end.st_ino,
                                end.st_size,hashlib.sha256(raw).hexdigest(),
                                canonical_result_valid(document,schema_document),
                                document.get("result_sha256") if isinstance(document,dict) else None)
            except Exception: post_canonical=None
        if inject_promotion and canonical is not None and canonical.exists():
            canonical.unlink()
        selector.close()
        return (outcome,popen_type,identities,canonical_absent,post_canonical,
                staging_absent,canonical_transitions,canonical_object_events)
    r12_once = r12_real_case("one")
    r12_two = r12_real_case("two")
    r12_promote = r12_real_case("one", True)
    r12_mutate = r12_real_case("one", sink_attack="mutate")
    r12_swap = r12_real_case("one", sink_attack="swap")
    kernel_valid_report={
        "role":"TEST_AUTHOR","outcome":"READY","summary":"kernel result",
        "changed_files":[],"blocking_findings":[],"tests":[],
        "allowed_write_violation":False,"frozen_artifacts_modified":False,
        "production_files_modified":False,"frozen_gate_ready":True,
        "baseline_red_for_right_reason":True,"owner_decision_required":False,
        "stop_reason":"NONE","next_action":"BUILD","next_task_id":"h-032"}
    def encoded_report(report):
        return json.dumps(report,ensure_ascii=False,separators=(",",":"),
                          sort_keys=True).encode("utf-8")
    def exact_sized_report(size):
        report=dict(kernel_valid_report);report["summary"]=""
        base_raw=encoded_report(report)
        report["summary"]="x"*(size-len(base_raw))
        raw=encoded_report(report)
        if len(raw)!=size: raise RuntimeError("exact result-size fixture drift")
        return raw
