        export_ok=(len(exports)==1 and isinstance(exports[0].value,(ast.List,ast.Tuple))
                   and [item.value for item in exports[0].value.elts
                        if isinstance(item,ast.Constant)]==["consume_private_result"])
        allowed_modules={"hashlib","json","os","stat","tempfile","pathlib","fcntl"}
        allowed_from={
