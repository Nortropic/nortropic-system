    r55_clean_rejection = ((False, "REJECTED", 1, 0, []), r55_capture,
                           False, False, False)
    r55_parent_only_rejection = ((False, "REJECTED", 1, 0,
                                  [str(r55_private_parent)]), r55_capture,
