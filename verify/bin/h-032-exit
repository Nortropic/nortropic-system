        box = []
        module.subprocess.Popen = popen
        launch_mode[0] = mode
        thread = threading.Thread(target=lambda: box.append(attempt(effect_repo)), daemon=True)
        thread.start()
        def await_path(path: Path, timeout: float = 10.0):
            deadline = time.monotonic() + timeout
            while not path.exists() and time.monotonic() < deadline: time.sleep(.01)
            return path.exists()
        def await_complete(path: Path, prior_digest: str | None = None, timeout: float = 10.0):
            deadline=time.monotonic()+timeout
            while time.monotonic()<deadline:
                try:
                    raw=bounded_stable_result(path)
                    value=strict_json(raw.decode("utf-8",errors="strict"))
                    digest=hashlib.sha256(raw).hexdigest()
                    if complete_schema_valid(value,schema_document) and digest!=prior_digest:
                        return raw,digest
                except Exception: pass
                time.sleep(.01)
            raise RuntimeError("provider did not expose a complete closed sink value")
        identities = []
        injected = False
        try:
            if not launched.wait(10):
                raise RuntimeError("provider launch did not expose private sink")
            sink = paths["sink"]
            _first_raw,first_digest=await_complete(sink)
            run_dirs=sorted((module.journal_root(effect_repo)/"runs").iterdir())
            if len(run_dirs)!=1: raise RuntimeError("controller canonical run identity ambiguous")
            canonical=run_dirs[0]/"result.json";paths["canonical"]=canonical
            fd = os.open(sink, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
            try:
                before = os.fstat(fd); raw = bytearray()
                while len(raw) <= MAX_RESULT_BYTES:
                    chunk = os.read(fd, min(65536, MAX_RESULT_BYTES + 1 - len(raw)))
                    if not chunk: break
                    raw.extend(chunk)
                after = os.fstat(fd)
            finally: os.close(fd)
            document = strict_json(bytes(raw).decode("utf-8", errors="strict"))
            if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != \
                    (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
                raise RuntimeError("sink changed during causal observation")
            if len(raw) > MAX_RESULT_BYTES or not complete_schema_valid(document, schema_document):
                raise RuntimeError("closed sink did not contain one complete accepted value")
            identities.append((before.st_dev, before.st_ino, hashlib.sha256(raw).hexdigest()))
            canonical_was_absent = not canonical.exists()
            if sink_attack:
                changed = strict_json(bytes(raw).decode("utf-8")); changed["summary"] = sink_attack
                changed_raw = json.dumps(changed, separators=(",", ":")).encode()
                if sink_attack == "path_swap":
                    displaced = sink.with_name(sink.name + ".bound-object")
                    sink.rename(displaced); sink.write_bytes(changed_raw)
                else:
                    fdw = os.open(sink, os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0))
                    try: os.ftruncate(fdw, 0); os.write(fdw, changed_raw); os.fsync(fdw)
                    finally: os.close(fdw)
            if second_promotion:
                canonical.write_bytes(bytes(raw)); injected = True
            sink.write_text("H032_RELEASE_1",encoding="utf-8")
            if mode == "two_values":
                _second_raw,_second_digest=await_complete(sink,first_digest)
                second = bounded_stable_result(sink); st = sink.stat()
                identities.append((st.st_dev, st.st_ino, hashlib.sha256(second).hexdigest()))
                sink.write_text("H032_RELEASE_2",encoding="utf-8")
            thread.join(timeout=15)
        finally:
            module.subprocess.Popen = original
            launch_mode[0] = "valid"
            if thread.is_alive() and "sink" in paths:
                sink=paths["sink"];sink.parent.mkdir(parents=True,exist_ok=True)
                sink.write_text("H032_RELEASE_1",encoding="utf-8")
                thread.join(timeout=1)
                if thread.is_alive(): sink.write_text("H032_RELEASE_2",encoding="utf-8")
                thread.join(timeout=4)
        outcome = box[0] if len(box) == 1 else (False, "gate causal run incomplete", 0, 0, [])
        displaced = paths.get("sink", work).with_name(paths.get("sink", work).name + ".bound-object")
        if displaced.exists(): displaced.unlink()
        if second_promotion and paths.get("canonical", work).exists(): paths["canonical"].unlink()
