    # These cases are constructed before rejected_clean so that their process
    # lifecycle can be monitored causally. Bind their final verdict here to the
    # same complete attempt-residue/private-parent oracle as every other
    # negative result rather than retaining the earlier leaf-only fallback.
    timeout_ok = rejected_clean(timeout_case)
