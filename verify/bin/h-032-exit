def observed_path_method(name):
 def invoke(self,*args,**kwargs):
  primitive_counts["path_"+name]+=1
  allowed=inside_allowed(self)
  if name=="open":
   mode=args[0] if args else kwargs.get("mode","r")
   allowed=allowed and not any(token in str(mode) for token in "wax+")
  if name=="chmod": allowed=mutation_allowed("chmod",(self,args[0] if args else kwargs.get("mode")))
  if name=="mkdir": allowed=mutation_allowed("mkdir",(self,args[0] if args else kwargs.get("mode",0o777)))
  if name in {"unlink","rmdir"}: allowed=mutation_allowed(name,(self,))
  if name in {"rename","replace"}:
   allowed=strict_member(self) and bool(args) and strict_member(args[0])
  if name=="touch": allowed=strict_member(self) and secure_mode(args[0] if args else kwargs.get("mode",0o666))
  if name=="symlink_to": allowed=False
  if name=="link_to": allowed=mutation_allowed("link",(self,args[0])) if args else False
  if name=="hardlink_to": allowed=mutation_allowed("link",(args[0],self)) if args else False
  if call_active[0]:
   events.append(("path."+name,path_label(self),path_label(args[0]) if args else "",allowed))
   if not allowed: raise PermissionError("path outside scoped result authority")
  return original_path_methods[name](self,*args,**kwargs)
 return invoke
