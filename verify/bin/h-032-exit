    def quiescence_inventory(root: Path):
        entries = []
        for path in root.rglob("*"):
            st = path.lstat(); kind = ("symlink" if path.is_symlink() else
                "directory" if stat.S_ISDIR(st.st_mode) else
                "regular" if stat.S_ISREG(st.st_mode) else "other")
            digest_value = sha256(path) if kind == "regular" and st.st_size <= MAX_RESULT_BYTES else None
            entries.append((str(path), kind, st.st_dev, st.st_ino,
                            stat.S_IMODE(st.st_mode), st.st_size, digest_value,
                            os.readlink(path) if kind == "symlink" else None))
        fd_state = []
        for fd_path in Path("/dev/fd").iterdir():
            try:
                st = fd_path.stat(); fd_state.append((int(fd_path.name), st.st_dev, st.st_ino))
            except (OSError, ValueError): pass
        ps = subprocess.run(["/bin/ps", "-axo", "pid=,ppid=,command="], text=True,
                            stdout=subprocess.PIPE, check=True).stdout.splitlines()
        owned = sorted(line.strip() for line in ps
                       if str(work) in line and int(line.split(None,1)[0]) != os.getpid())
        descendant_fds = []
        lsof = Path("/usr/sbin/lsof")
        if lsof.is_file():
            for line in owned:
                try: pid = line.split(None, 1)[0]
                except Exception: continue
                listing = subprocess.run([str(lsof), "-n", "-p", pid], text=True,
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                         check=False).stdout.splitlines()
                descendant_fds.extend(f"{pid}:{item}" for item in listing[1:])
        return sorted(entries), sorted(fd_state), owned, sorted(descendant_fds)
