    def current_provider_capture_binding_admits(observed, start_delta,
                                                prior_output) -> bool:
        identity=observed.get("output_identity") if isinstance(observed,dict) else None
        output=observed.get("output_path") if isinstance(observed,dict) else None
        return (start_delta==1 and observed.get("mode")=="valid"
            and isinstance(output,str) and bool(output) and Path(output).is_absolute()
            and output!=prior_output and isinstance(identity,dict)
            and set(identity)=={"dev","ino","size","mode","digest"}
            and type(identity.get("dev")) is int and type(identity.get("ino")) is int
            and type(identity.get("size")) is int and identity.get("size",0)>0
            and identity.get("mode")==0o600
            and isinstance(identity.get("digest"),str)
            and len(identity.get("digest"))==64
            and set(identity.get("digest"))<=set("0123456789abcdef"))
    def launcher_observation_admits(observation, observed) -> bool:
        if not (isinstance(observation,dict)
                and set(observation)=={"valid","output","envelope","worktree",
                                       "timeout","separator","provider_output_count",
                                       "provider_worktree_count","checks","current_run"}):
            return False
        envelope=observation.get("envelope")
        current_run=observation.get("current_run")
        return (isinstance(envelope,str) and isinstance(current_run,str)
            and Path(envelope).is_absolute() and Path(current_run).is_absolute()
            and Path(envelope).parent==Path(current_run)
            and observation.get("valid") is True
            and isinstance(observation.get("checks"),dict)
            and all(observation["checks"].values())
            and observation.get("output")==observed.get("output_path")
            and observation.get("timeout")=="86400"
            and observation.get("separator")==8
            and observation.get("provider_output_count")==1
            and observation.get("provider_worktree_count")==1)
    def expected_provider_environment(incoming, observed, launch_observation):
        if not launcher_observation_admits(launch_observation,observed):
            return None
        expected={key:value for key,value in incoming.items()
                  if not key.startswith("GIT_")
                  and not key.startswith("DYLD_")
                  and key not in {"LD_PRELOAD","LD_LIBRARY_PATH",
                                  "__PYVENV_LAUNCHER__"}
                  and not key.startswith(("GH_","GITHUB_","SLACK_"))}
        expected.update({
            "NORTROPIC_TRUST_ROOT":str(Path(observed.get(
                "argv0","/private/tmp/h032-missing-provider")).parent),
            "NORTROPIC_KUVERT":str(launch_observation["envelope"]),
            "H032_RESULT_MODE":"valid",
