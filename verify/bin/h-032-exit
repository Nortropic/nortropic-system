            expected_repo=Path(context["repo"]).resolve(strict=True)
            expected_worktree=Path(context["worktree"]).resolve(strict=True)
            expected_runs=(Path(context["journal_common"]).resolve(strict=True)
                           /"nortropic-codex-autopilot"/"runs")
            runs_before=set(context["runs_before"])
            current_runs=sorted(set(expected_runs.iterdir())-runs_before)
            current_run=(current_runs[0] if len(current_runs)==1 else None)
            journal_path=expected_runs.parent/"events.jsonl"
            journal_before=context["journal_before"]
            journal_after=journal_path.read_bytes() if journal_path.is_file() else b""
            journal_current=False
            if (isinstance(journal_before,bytes)
                    and journal_after.startswith(journal_before)
                    and len(journal_after)>len(journal_before)):
                suffix=journal_after[len(journal_before):]
                if suffix.endswith(b"\n"):
                    records=[strict_json(line.decode("utf-8"))
                             for line in suffix.splitlines()]
                    journal_current=(len(records)==1 and isinstance(records[0],dict)
                        and records[0].get("event")=="AGENT_START"
                        and records[0].get("role")=="TEST_AUTHOR"
                        and records[0].get("worktree")==str(expected_worktree)
                        and records[0].get("head")==git_repository_head(expected_worktree))
            trust_root=Path(child_env["NORTROPIC_TRUST_ROOT"])
            checks={
                "python_flags":values[1:3]==["-I","-S"],
                "launcher":launcher==expected_repo/"controller/launch/cli"
                    and launcher.is_file() and not launcher.is_symlink(),
                "run":values[4]=="run",
                "worktree":worktree==expected_worktree,
                "envelope_object":envelope_raw.is_absolute() and envelope_raw==envelope
                    and stat.S_ISREG(envelope_stat.st_mode) and not envelope_raw.is_symlink(),
                "envelope_name":envelope.name=="provider-envelope.json",
                "envelope_journal":envelope.parent.parent==expected_runs,
                "current_run":current_run is not None and envelope.parent==current_run,
                "current_journal":journal_current,
                "timeout":values[7]=="86400",
                "provider":provider_argv[0]==str(trust_root/"provider"),
                "provider_worktree":provider_argv[2]==str(expected_worktree),
                "output":output.is_absolute(),
                "python":python==trust_root/"python3.12",
            }
            syntax_ok=all(checks.values())
            observation={
                "valid":syntax_ok,"output":str(output),"envelope":str(envelope),
                "worktree":str(worktree),"timeout":values[7],"separator":separators[0],
                "provider_output_count":len(output_indexes),
                "provider_worktree_count":len(worktree_indexes),
                "checks":checks,
                "current_run":str(current_run) if current_run is not None else None,
            }
        except (KeyError,OSError,ValueError,IndexError):
            pass
        return observation
    def fixture_popen(argv, *args, **kwargs):
        flat = list(argv)
        if "-o" in flat:
            if launch_output_override[0] is not None:
                output_indexes=[index for index,value in enumerate(flat) if value=="-o"]
                if len(output_indexes)==1 and output_indexes[0]+1<len(flat):
                    flat[output_indexes[0]+1]=str(launch_output_override[0])
                    argv=flat
            active = audit_active[0]
            if isinstance(active, dict):
                try:
                    sink = Path(flat[flat.index("-o") + 1])
                    opened = sink.lstat()
                    identities = active["sink_identities"]
                    assert isinstance(identities, list)
                    identity = (opened.st_dev, opened.st_ino)
                    if identity not in identities:
                        identities.append(identity)
                    prechecks = active["sink_prechecks"]
                    assert isinstance(prechecks, list)
                    precheck = {
                        "path": str(sink.absolute()), "dev": opened.st_dev,
                        "ino": opened.st_ino, "mode": opened.st_mode,
                        "nlink": opened.st_nlink, "size": opened.st_size,
                        "mtime_ns": opened.st_mtime_ns,
                        "ctime_ns": opened.st_ctime_ns,
                    }
                    prechecks.append(precheck)
                    open_returns = active["open_returns"]
                    assert isinstance(open_returns, list)
                    retained = []
                    for item in open_returns:
                        number = item.get("fd")
                        if type(number) is not int or item.get("path") != str(sink.absolute()):
                            continue
                        try:
                            current = os.fstat(number)
                            access = fcntl.fcntl(number, fcntl.F_GETFL) & os.O_ACCMODE
                        except OSError:
                            continue
                        if ((current.st_dev, current.st_ino) == identity
                                and access == os.O_RDONLY):
                            retained.append(number)
                    if len(retained) == 1:
                        active["original_sink_fd"] = retained[0]
                        active["original_sink_precheck"] = precheck
                except (OSError, ValueError):
                    pass
            kwargs = dict(kwargs); child_env = dict(kwargs.get("env") or {})
            child_env.update(launch_environment_additions[0])
            if launch_environment_mode[0] is not None:
                output_key=str(flat[flat.index("-o")+1])
                launch_environment_inputs[output_key]=dict(child_env)
                child_env=fixture_provider_environment(
                    launch_environment_mode[0],child_env)
            fixture_manpath_present="1" if "MANPATH" in child_env else "0"
            fixture_manpath_value=child_env.get("MANPATH","")
            child_env.update({
                "H032_RESULT_MODE": launch_mode[0],
                "H032_CAPTURE": str(capture),
                "H032_LOCKED_SOURCE": str(provider),
                "H032_SAFE_ATTACK_ROOT": str(work),
                "H032_HOST_DIRECT_MARKER": str(work / "HOST_DIRECT_EXECUTED"),
                "H032_FIXTURE_MANPATH_PRESENT":fixture_manpath_present,
                "H032_FIXTURE_MANPATH_VALUE":fixture_manpath_value,
                **launch_extra,
            })
            kwargs["env"] = child_env
            observation=observe_launcher_argv(flat,child_env)
            output=observation.get("output")
            if isinstance(output,str): launch_observations[output]=observation
            if "NORTROPIC_ATTEMPT_ROOT" in child_env:
                provider_argv=[str(item) for item in flat[9:]]
                managed_launch_observations.append({
                    "attempt":child_env["NORTROPIC_ATTEMPT_ROOT"],
                    "staging":child_env.get("NORTROPIC_STAGING_ROOT",""),
                    "sink":child_env.get("NORTROPIC_RESULT_SINK",""),
                    "trust":child_env.get("NORTROPIC_TRUST_ROOT",""),
                    "workspace":str(flat[5]), "snapshot":provider_argv[0],
                })
        process = system_popen(argv, *args, **kwargs)
        if "-o" in flat:
            provider_process_starts[0] += 1
        return process
    module.subprocess.Popen = fixture_popen
    run_seq = [0]
    forced_run_ids: list[str] = []
    original_now_id = module.now_id
    def fixture_now_id():
        if forced_run_ids:
            return forced_run_ids.pop(0)
        run_seq[0] += 1
        return f"{original_now_id()}-{run_seq[0]:04d}"
    module.now_id = fixture_now_id

    journal_open = os.open; journal_close = os.close
    journal_fstat = os.fstat; journal_pread = os.pread
    MAX_ATTEMPT_JOURNAL_BYTES = 4 * 1024 * 1024
    SAFE_ATTEMPT_JOURNAL_MODE = 0o600

    def journal_object(repo: Path) -> dict[str, object]:
        path = module.journal_root(repo) / "events.jsonl"
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        try: fd = journal_open(path, flags)
        except FileNotFoundError:
            return {"valid": True, "exists": False, "path": str(path), "raw": b""}
        except Exception as exc:
            return {"valid": False, "exists": path.exists(), "path": str(path),
                    "raw": b"", "error": f"open:{type(exc).__name__}:{exc}"}
        try:
            before = journal_fstat(fd)
            if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1
                    or stat.S_IMODE(before.st_mode) != SAFE_ATTEMPT_JOURNAL_MODE
                    or before.st_size < 0 or before.st_size > MAX_ATTEMPT_JOURNAL_BYTES):
                return {"valid": False, "exists": True, "path": str(path), "raw": b"",
                        "error": "unsafe journal object"}
            chunks: list[bytes] = []; offset = 0
            while offset <= MAX_ATTEMPT_JOURNAL_BYTES:
                chunk = journal_pread(fd, min(65536, MAX_ATTEMPT_JOURNAL_BYTES + 1 - offset), offset)
                if not chunk: break
                chunks.append(chunk); offset += len(chunk)
            raw = b"".join(chunks)
            after = journal_fstat(fd)
            stable = (before.st_dev, before.st_ino, before.st_mode, before.st_nlink,
                      before.st_size, before.st_mtime_ns, before.st_ctime_ns) == (
                      after.st_dev, after.st_ino, after.st_mode, after.st_nlink,
                      after.st_size, after.st_mtime_ns, after.st_ctime_ns)
            return {"valid": stable and len(raw) == before.st_size,
                    "exists": True, "path": str(path), "raw": raw,
                    "dev": before.st_dev, "ino": before.st_ino,
                    "mode": before.st_mode, "nlink": before.st_nlink,
                    "size": before.st_size,
                    "error": None if stable and len(raw) == before.st_size
                    else "unstable journal object"}
        except Exception as exc:
            return {"valid": False, "exists": True, "path": str(path), "raw": b"",
                    "error": f"read:{type(exc).__name__}:{exc}"}
        finally:
            journal_close(fd)

    def strict_journal_append(before: dict[str, object], repo: Path) -> dict[str, object]:
        after = journal_object(repo)
        result: dict[str, object] = {"valid": False, "records": [],
                                    "start_records": [], "error": None,
                                    "before": before, "after": after}
        if before.get("valid") is not True or after.get("valid") is not True:
            result["error"] = f"object:{before.get('error')}:{after.get('error')}"
            return result
        before_exists = before.get("exists") is True
        after_exists = after.get("exists") is True
        if before_exists and not after_exists:
            result["error"] = "journal removed"
            return result
        if not after_exists:
            result["valid"] = True
            return result
        before_raw = before.get("raw", b""); after_raw = after.get("raw", b"")
        if not isinstance(before_raw, bytes) or not isinstance(after_raw, bytes):
            result["error"] = "journal bytes unavailable"
            return result
        if before_exists and (
                before.get("dev"), before.get("ino"),
                stat.S_IFMT(int(before.get("mode", 0))), before.get("nlink"),
                stat.S_IMODE(int(before.get("mode", 0)))) != (
                after.get("dev"), after.get("ino"),
                stat.S_IFMT(int(after.get("mode", 0))), after.get("nlink"),
                stat.S_IMODE(int(after.get("mode", 0)))):
            result["error"] = "journal object identity or protection changed"
            return result
        if (after.get("nlink") != 1
                or stat.S_IFMT(int(after.get("mode", 0))) != stat.S_IFREG
                or stat.S_IMODE(int(after.get("mode", 0))) != SAFE_ATTEMPT_JOURNAL_MODE):
            result["error"] = "journal protection is not owner-private regular nlink-one"
            return result
        if not after_raw.startswith(before_raw):
            result["error"] = "journal truncated or prefix changed"
            return result
        suffix = after_raw[len(before_raw):]
        if (not isinstance(before.get("size", 0), int)
                or not isinstance(after.get("size"), int)
                or before.get("size", 0) != len(before_raw)
                or after.get("size") != len(after_raw)
                or after.get("size", -1) < before.get("size", 0)
                or len(suffix) != after.get("size", 0) - before.get("size", 0)):
            result["error"] = "journal size/prefix accounting changed"
            return result
        result["suffix"] = suffix
        if not suffix:
            result["valid"] = True
            return result
        if not suffix.endswith(b"\n"):
            result["error"] = "journal append is not newline complete"
            return result
        try: text = suffix.decode("utf-8", errors="strict")
        except UnicodeDecodeError as exc:
            result["error"] = f"invalid UTF-8:{exc}"
            return result
        records: list[dict[str, object]] = []
        starts_now: list[dict[str, object]] = []
        for encoded_line in text.splitlines():
            if not encoded_line:
                result["error"] = "empty journal record"
                return result
            try: value = strict_json(encoded_line)
            except Exception as exc:
                result["error"] = f"invalid strict JSON:{type(exc).__name__}:{exc}"
                return result
            if not isinstance(value, dict) or not isinstance(value.get("event"), str):
                result["error"] = "journal record is not an event object"
                return result
            if value.get("event") == "AGENT_START":
                if (set(value) != {"event", "ts", "role", "model", "reasoning_effort",
                                   "model_routing_source", "worktree", "head"}
                        or value.get("role") != "TEST_AUTHOR"
                        or value.get("model") != "gpt-5.6-sol"
                        or value.get("reasoning_effort") != "max"
                        or value.get("model_routing_source") != "AUTOPILOT_ROLE_POLICY"
                        or not all(isinstance(value.get(key), str) and value.get(key)
                                   for key in ("ts", "worktree", "head"))):
                    result["error"] = "invalid AGENT_START shape"
                    return result
                starts_now.append(value)
            records.append(value)
        result.update({"valid": True, "records": records,
                       "start_records": starts_now, "error": None})
        return result

    def agent_start_records(repo: Path) -> list[dict[str, object]]:
        observed = strict_journal_append(
            {"valid": True, "exists": False, "raw": b""}, repo)
        if observed.get("valid") is not True: return []
        return list(observed.get("start_records", []))

    def starts(repo: Path) -> int:
        return len(agent_start_records(repo))

    def safe_capture() -> dict[str, object]:
        try:
            value = strict_json(capture.read_text(encoding="utf-8"))
            return value if isinstance(value, dict) else {}
        except Exception:
            return {}

    # H-032 owns only provider launch selection. The actual production generic
    # dispatcher must continue to execute Git, GitHub and arbitrary fixed
    # non-provider controller helpers without creating AGENT_START.
    git_effect = module.run([GIT, "--version"], cwd=base, check=False)
    check("K_NONPROVIDER_GIT_BOUNDARY", git_effect.rc == 0
          and git_effect.out.startswith("git version ") and starts(base) == 0,
          f"rc={git_effect.rc} out={git_effect.out.strip()} starts={starts(base)}")
    gh_path = shutil.which("gh")
    gh_effect = module.run([gh_path, "--version"], cwd=base, check=False) if gh_path else None
    check("K_NONPROVIDER_GITHUB_BOUNDARY", gh_effect is not None and gh_effect.rc == 0
          and "gh version" in gh_effect.out and starts(base) == 0,
          f"path={gh_path} result={gh_effect} starts={starts(base)}")
    generic_marker = work / "generic-controller-effect"
    generic = work / "generic-controller-helper"
    generic.write_text("#!/bin/sh\nprintf '%s\\n' \"$2\" >\"$1\"\nprintf 'GENERIC_OK\\n'\n", encoding="utf-8")
    generic.chmod(0o700)
    generic_effect = module.run([str(generic), str(generic_marker), "exact-token"], cwd=base, check=False)
    check("K_NONPROVIDER_GENERIC_EFFECT", generic_effect.rc == 0
          and generic_effect.out == "GENERIC_OK\n"
          and generic_marker.read_text(encoding="utf-8") == "exact-token\n"
          and starts(base) == 0,
          f"rc={generic_effect.rc} out={generic_effect.out!r} marker={generic_marker.exists()} starts={starts(base)}")

    attempt_sequence = [0]
    audit_active: list[dict[str, object] | None] = [None]
    last_attempt_observed: list[dict[str, object] | None] = [None]
    rollback_fault_active: list[dict[str, object] | None] = [None]
    rollback_race_active: list[dict[str, object] | None] = [None]
    rollback_open_race_active: list[dict[str, object] | None] = [None]

    def rollback_object_state(path: Path) -> dict[str, object]:
        """Read metadata and bounded value from one retained no-follow object."""
        flags = os.O_RDONLY | os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(path, flags)
        try:
            before = os.fstat(fd)
            raw: bytes | None = None
            value: object = None
            digest: str | None = None
            if stat.S_ISREG(before.st_mode):
                chunks: list[bytes] = []
                offset = 0
                while offset <= MAX_CANONICAL_BYTES:
                    chunk = os.pread(
                        fd, min(65536, MAX_CANONICAL_BYTES + 1 - offset), offset)
                    if not chunk:
                        break
                    chunks.append(chunk)
                    offset += len(chunk)
                raw = b"".join(chunks)
                if len(raw) > MAX_CANONICAL_BYTES:
                    raise ValueError("R107 rollback object exceeds bound")
                digest = hashlib.sha256(raw).hexdigest()
                try:
                    value = strict_json(raw.decode("utf-8", errors="strict"))
                except Exception:
                    value = None
            after = os.fstat(fd)
            before_tuple = (
                before.st_dev, before.st_ino, before.st_mode, before.st_nlink,
                before.st_size, before.st_mtime_ns, before.st_ctime_ns)
            after_tuple = (
                after.st_dev, after.st_ino, after.st_mode, after.st_nlink,
                after.st_size, after.st_mtime_ns, after.st_ctime_ns)
            if before_tuple != after_tuple:
                raise OSError("R107 rollback object changed during opened read")
            return {
                "dev": after.st_dev, "ino": after.st_ino,
                "mode": after.st_mode, "nlink": after.st_nlink,
                "size": after.st_size, "mtime_ns": after.st_mtime_ns,
                "ctime_ns": after.st_ctime_ns, "raw": raw,
                "digest": digest, "value": value,
            }
        finally:
            os.close(fd)

    def rollback_path_matches_opened(path: Path,
                                     opened: dict[str, object]) -> bool:
        """Bind the current pathname metadata back to the one opened object."""
        current = os.lstat(path)
        return (
            current.st_dev, current.st_ino, current.st_mode, current.st_nlink,
            current.st_size, current.st_mtime_ns, current.st_ctime_ns) == (
            opened.get("dev"), opened.get("ino"), opened.get("mode"),
            opened.get("nlink"), opened.get("size"), opened.get("mtime_ns"),
            opened.get("ctime_ns"))

    def register_canonical(active: dict[str, object], value: object) -> None:
        if not isinstance(value, (str, bytes, os.PathLike)):
            return
        try:
            path = Path(value).absolute()
            runs_root = active["runs_root"]
            assert isinstance(runs_root, Path)
            if path.name != "result.json" or runs_root not in path.parents:
                return
            candidates = active["canonical_candidates"]
            states = active["canonical_visibility_state"]
            assert isinstance(candidates, set) and isinstance(states, dict)
            key = str(path)
            candidates.add(key)
            # Every current run starts with no canonical result.  Initializing
            # the exact newly discovered destination to absent makes the first
            # post-operation observation causal even if the publishing API did
            # not expose a separate pre-create callback.
            states.setdefault(key, False)
        except Exception:
            return

    def sync_canonical_visibility(active: dict[str, object]) -> None:
        """Record every observed absent->present effect, without deduplication."""
        if active.get("observer_busy") is True:
            return
        active["observer_busy"] = True
        try:
            candidates = active["canonical_candidates"]
            states = active["canonical_visibility_state"]
            epochs = active["canonical_visibility_epochs"]
            assert isinstance(candidates, set) and isinstance(states, dict)
            assert isinstance(epochs, list)
            for value in sorted(candidates):
                path = Path(value)
                present = path.exists() or path.is_symlink()
                prior = states.get(value, False)
                if present and prior is False:
                    dev = ino = None; digest = None
                    try:
                        current = path.lstat()
                        dev, ino = current.st_dev, current.st_ino
                        if stat.S_ISREG(current.st_mode) and not path.is_symlink():
                            digest = sha256(path)
                    except _product_module.Reject:
                        pass
                    # Identical path/dev/inode/digest values are intentionally
                    # appended again after an intervening absence.  Cardinality
                    # is an effect count, not a unique-state inventory.
                    epochs.append((value, dev, ino, digest))
                states[value] = present
        finally:
            active["observer_busy"] = False

    def audit_inventory(event: str, args: tuple[object, ...]) -> None:
        active = audit_active[0]
        rollback = rollback_fault_active[0]
        if event == "os.remove" and rollback is not None and args:
            try:
                candidate = Path(args[0]).absolute()
                target = rollback["path"]
                assert isinstance(target, Path)
                if candidate == target:
                    attempts = rollback["attempts"]
                    foreign_attempts = rollback["foreign_attempts"]
                    assert isinstance(attempts, list) and isinstance(foreign_attempts, list)
                    expected = rollback["state"]
                    assert isinstance(expected, dict)
                    open_race = rollback_open_race_active[0]
                    if open_race is not None:
                        race_target = open_race.get("path")
                        swap_attempt = open_race.get("swap_attempt")
                        if (isinstance(race_target, Path) and race_target == candidate
                                and type(swap_attempt) is int
                                and len(attempts) + len(foreign_attempts) + 1
                                    == swap_attempt):
                            open_race["armed"] = True
                    try:
                        observed = rollback_object_state(candidate)
                        path_bound = rollback_path_matches_opened(candidate, observed)
                    except OSError as exc:
                        foreign_attempts.append({
                            "opened": False, "path_bound": False,
                            "error": type(exc).__name__,
                        })
                        raise OSError(
                            "H032 protected unopenable canonical replacement") from exc
                    if observed != expected or not path_bound:
                        foreign_attempts.append({
                            "opened": True, "path_bound": path_bound,
                            "devino_equal": (observed.get("dev"), observed.get("ino"))
                                == (expected.get("dev"), expected.get("ino")),
                            "mode_equal": observed.get("mode") == expected.get("mode"),
                            "nlink_equal": observed.get("nlink") == expected.get("nlink"),
                            "size_equal": observed.get("size") == expected.get("size"),
                            "times_equal": (observed.get("mtime_ns"), observed.get("ctime_ns"))
                                == (expected.get("mtime_ns"), expected.get("ctime_ns")),
                            "raw_equal": observed.get("raw") == expected.get("raw"),
                            "digest_equal": observed.get("digest") == expected.get("digest"),
                            "value_equal": observed.get("value") == expected.get("value"),
                        })
                        raise OSError("H032 protected foreign canonical replacement")
                    attempts.append({"full_state_equal": True, "path_bound": True})
                    policy = rollback.get("fault")
                    if (policy == "persistent"
                            or (policy == "first" and len(attempts) == 1)
                            or (policy == "first_two" and len(attempts) <= 2)):
                        raise OSError("H032 injected canonical rollback failure")
            except FileNotFoundError:
                pass
        if active is None or event not in {"os.mkdir", "open", "os.remove", "os.rename",
                                           "os.link", "os.symlink", "subprocess.Popen"}:
            return
        if active.get("observer_busy") is True:
            return
        # Audit callbacks precede their filesystem operation.  Synchronizing
        # every already-known destination here observes the completed effect of
        # the preceding operation.  attempt() performs the final post-run sync.
        sync_canonical_visibility(active)
        if event == "subprocess.Popen":
            outputs = active["provider_outputs"]
            assert isinstance(outputs, list)
            for value in args:
                if isinstance(value, (list, tuple)) and "-o" in value:
                    outputs.append(str(value[value.index("-o") + 1]))
            return
        created = active["created"]
        assert isinstance(created, set)
        if event == "open" and args:
            register_canonical(active, args[0])
        elif event == "os.remove" and args:
            register_canonical(active, args[0])
        elif event in {"os.rename", "os.link", "os.symlink"}:
            if args: register_canonical(active, args[0])
            if len(args) > 1: register_canonical(active, args[1])
        # Registration occurs before the audited operation and therefore
        # retains the exact absent precondition for its later post-op sync.
        sync_canonical_visibility(active)
        if event == "open":
            opened = active["opened"]
            assert isinstance(opened, list)
            opened.append(tuple(args))
            if args:
                try:
                    path = Path(args[0]).absolute()
                    flags = args[2] if len(args) > 2 and type(args[2]) is int else 0
                    runs_root = active["runs_root"]
                    assert isinstance(runs_root, Path)
                    if (path.name == "result.json" and runs_root in path.parents
                            and flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC)):
                        direct_writes = active["canonical_direct_writes"]
                        assert isinstance(direct_writes, list)
                        direct_writes.append((str(path), flags, path.exists()))
                except Exception:
                    pass
        values = args[1:2] if event in {"os.rename", "os.link", "os.symlink"} else args[:1]
        for value in values:
            if isinstance(value, (str, bytes, os.PathLike)):
                try:
                    path = Path(value).absolute()
                    arena = active.get("arena")
                    arena_before = active.get("arena_before", set())
                    family = active.get("private_family_paths")
                    assert isinstance(arena, Path) and isinstance(arena_before, set)
                    assert isinstance(family, set)
                    # Family probing may only touch attempt-arena paths through
                    # the call-time os.lstat surface; foreign paths keep the
                    # import-bound Path.exists probe so audited opens stay
                    # effect-free for the provider-executable stale-path
                    # controls, which bind the first path-stat of their target.
                    if arena not in path.parents:
                        if not path.exists(): created.add(str(path))
                    elif not os.path.lexists(path):
                        created.add(str(path))
                        if str(path.absolute()) not in arena_before:
                            family.add(str(path))
                except Exception: pass
        if event in {"os.rename", "os.link"} and len(args) > 1:
            try:
                source_path = Path(args[0]).absolute()
                destination_path = Path(args[1]).absolute()
                family = active.get("private_family_paths")
                assert isinstance(family, set)
                if (str(source_path) in family
                        or any(Path(member) in source_path.parents for member in family)):
                    family.add(str(destination_path))
            except Exception:
                pass
    sys.addaudithook(audit_inventory)

    def rollback_race_audit(event: str, args: tuple[object, ...]) -> None:
        """Causally swap after the R106 check but before the same remove syscall."""
        race = rollback_race_active[0]
        if event != "os.remove" or race is None or not args:
            return
        try:
            candidate = Path(args[0]).absolute()
        except Exception:
            return
        target = race["path"]
        assert isinstance(target, Path)
        if candidate != target:
            return
        attempts = race["attempts"]
        assert isinstance(attempts, list)
        race["check_saw_expected"] = bool(
            attempts and attempts[-1]
                == {"full_state_equal": True, "path_bound": True})
        rollback_race_active[0] = None
        accepted = race["accepted"]
        foreign = race["foreign"]
        assert isinstance(accepted, Path) and isinstance(foreign, Path)
        os.rename(target, accepted)
        os.rename(foreign, target)
        race["swapped"] = True

    sys.addaudithook(rollback_race_audit)

    def rollback_open_race_audit(event: str, args: tuple[object, ...]) -> None:
        """Swap during the exact internal no-follow open used for state credit."""
        race = rollback_open_race_active[0]
        if event != "open" or race is None or race.get("armed") is not True or not args:
            return
        try:
            candidate = Path(args[0]).absolute()
        except Exception:
            return
        target = race.get("path")
        if not isinstance(target, Path) or candidate != target:
            return
        flags = args[2] if len(args) > 2 and type(args[2]) is int else 0
        if flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC):
            return
        race["armed"] = False
        rollback_open_race_active[0] = None
        accepted = race.get("accepted")
        foreign = race.get("foreign")
        assert isinstance(accepted, Path) and isinstance(foreign, Path)
        os.rename(target, accepted)
        os.rename(foreign, target)
        race["swapped"] = True
        race["opened_foreign_devino"] = (
            target.lstat().st_dev, target.lstat().st_ino)

    sys.addaudithook(rollback_open_race_audit)

    def rollback_fault_probe(api: str, fault: str, failures: int,
                             foreign: bool = False) -> bool:
        """Prove the rollback fault/identity hook observes the real unlink effect."""
        probe = work / f"r105-rollback-probe-{api}-{fault}-{int(foreign)}"
        probe.write_bytes(b"R105 rollback audit probe")
        opened = probe.lstat()
        attempts: list[object] = []
        foreign_attempts: list[object] = []
        expected_state = rollback_object_state(probe)
        if foreign:
            expected_state = dict(expected_state)
            expected_state["ino"] = opened.st_ino + 1
        rollback_fault_active[0] = {
            "path": probe.absolute(),
            "state": expected_state,
            "fault": fault,
            "attempts": attempts,
            "foreign_attempts": foreign_attempts,
        }
        raised = 0
        calls = failures if fault == "persistent" or foreign else failures + 1
        try:
            for _index in range(calls):
                try:
                    if api == "Path.unlink":
                        probe.unlink()
                    elif api == "os.unlink":
                        os.unlink(probe)
                    elif api == "os.remove":
                        os.remove(probe)
                    else:
                        raise RuntimeError("unknown R105 rollback probe API")
                except OSError:
                    raised += 1
        finally:
            rollback_fault_active[0] = None
        present = probe.exists() or probe.is_symlink()
        if present:
            probe.unlink()
        if foreign:
            return raised == calls and present and not attempts \
                and len(foreign_attempts) == calls
        if fault == "persistent":
            return (raised == calls and present
                    and len(attempts) == calls and not foreign_attempts)
        return (raised == failures and not present
                and len(attempts) == calls and not foreign_attempts)

    rollback_fault_rig_ok = (
        rollback_fault_probe("Path.unlink", "persistent", 1)
        and rollback_fault_probe("os.unlink", "persistent", 1)
        and rollback_fault_probe("os.remove", "persistent", 1)
        and rollback_fault_probe("Path.unlink", "first", 1)
        and rollback_fault_probe("Path.unlink", "first_two", 2)
        and rollback_fault_probe("Path.unlink", "persistent", 1, True))

    def rollback_state_probe(mutation: str) -> bool:
        probe = work / f"r106-full-state-probe-{mutation}"
        alias = work / f"r106-full-state-alias-{mutation}"
        probe.write_bytes(b'{"value":1}')
        expected_state = rollback_object_state(probe)
        attempts: list[object] = []
        foreign_attempts: list[object] = []
        if mutation == "nlink":
            os.link(probe, alias)
        elif mutation == "mode":
            probe.chmod(0o640)
        elif mutation == "value":
            fd = os.open(probe, os.O_WRONLY | os.O_TRUNC)
            try:
                os.write(fd, b'{"value":2}')
                os.fsync(fd)
            finally:
                os.close(fd)
        else:
            raise RuntimeError("unknown R106 full-state probe")
        changed_state = rollback_object_state(probe)
        rollback_fault_active[0] = {
            "path": probe.absolute(), "state": expected_state, "fault": None,
            "attempts": attempts, "foreign_attempts": foreign_attempts,
        }
        raised = False
        try:
            probe.unlink()
        except OSError:
            raised = True
        finally:
            rollback_fault_active[0] = None
        present = probe.exists() and not probe.is_symlink()
        if present:
            probe.unlink()
        if alias.exists() or alias.is_symlink():
            alias.unlink()
        expected_difference = {
            "nlink": changed_state.get("nlink") != expected_state.get("nlink"),
            "mode": changed_state.get("mode") != expected_state.get("mode"),
            "value": (changed_state.get("digest") != expected_state.get("digest")
                      and changed_state.get("value") != expected_state.get("value")),
        }[mutation]
        return (expected_difference and raised and present and not attempts
                and len(foreign_attempts) == 1
                and foreign_attempts[0].get(f"{mutation if mutation != 'value' else 'digest'}_equal")
                    is False)

    rollback_full_state_rig_ok = all(
        rollback_state_probe(mutation) for mutation in ("nlink", "mode", "value"))

    def rollback_race_probe() -> bool:
        probe = work / "r106-race-probe"
        accepted = work / "r106-race-accepted"
        foreign = work / "r106-race-foreign"
        probe.write_bytes(b'{"accepted":true}')
        foreign.write_bytes(b"R106 foreign race guard")
        expected_state = rollback_object_state(probe)
        foreign_state = rollback_object_state(foreign)
        attempts: list[object] = []
        foreign_attempts: list[object] = []
        race_record: dict[str, object] = {
            "path": probe.absolute(), "accepted": accepted, "foreign": foreign,
            "attempts": attempts, "check_saw_expected": False, "swapped": False,
        }
        rollback_fault_active[0] = {
            "path": probe.absolute(), "state": expected_state, "fault": None,
            "attempts": attempts, "foreign_attempts": foreign_attempts,
        }
        rollback_race_active[0] = race_record
        probe.unlink()
        rollback_fault_active[0] = None
        rollback_race_active[0] = None
        accepted_state = rollback_object_state(accepted)
        result = (
            race_record.get("check_saw_expected") is True
            and race_record.get("swapped") is True
            and not probe.exists() and not probe.is_symlink()
            and accepted_state.get("dev") == expected_state.get("dev")
            and accepted_state.get("ino") == expected_state.get("ino")
            and accepted_state.get("digest") == expected_state.get("digest")
            and accepted_state.get("value") == expected_state.get("value")
            and not foreign.exists() and not foreign.is_symlink()
            and foreign_state.get("ino") != expected_state.get("ino")
            and len(attempts) == 1 and not foreign_attempts)
        accepted.unlink()
        return result

    rollback_race_rig_ok = rollback_race_probe()

    def rollback_open_swap_probe(swap_attempt: int) -> bool:
        probe = work / f"r107-open-swap-probe-{swap_attempt}"
        accepted = work / f"r107-open-swap-accepted-{swap_attempt}"
        foreign = work / f"r107-open-swap-foreign-{swap_attempt}"
        raw = b'{"same":"bounded-value"}'
        probe.write_bytes(raw)
        foreign.write_bytes(raw)
        expected_state = rollback_object_state(probe)
        foreign_initial = rollback_object_state(foreign)
        attempts: list[object] = []
        foreign_attempts: list[object] = []
        race_record: dict[str, object] = {
            "path": probe.absolute(), "accepted": accepted,
            "foreign": foreign, "swap_attempt": swap_attempt,
            "armed": False, "swapped": False,
        }
        rollback_fault_active[0] = {
            "path": probe.absolute(), "state": expected_state,
            "fault": "first_two" if swap_attempt == 3 else None,
            "attempts": attempts, "foreign_attempts": foreign_attempts,
        }
        rollback_open_race_active[0] = race_record
        raised = 0
        try:
            for _index in range(swap_attempt):
                try:
                    probe.unlink()
                except OSError:
                    raised += 1
        finally:
            rollback_fault_active[0] = None
            rollback_open_race_active[0] = None
        canonical_state = rollback_object_state(probe)
        accepted_state = rollback_object_state(accepted)
        result = (
            raised == swap_attempt
            and race_record.get("swapped") is True
            and len(attempts) == swap_attempt - 1
            and all(attempt == {"full_state_equal": True, "path_bound": True}
                    for attempt in attempts)
            and len(foreign_attempts) == 1
            and foreign_attempts[0].get("opened") is True
            and foreign_attempts[0].get("path_bound") is True
            and foreign_attempts[0].get("devino_equal") is False
            and foreign_attempts[0].get("raw_equal") is True
            and canonical_state.get("dev") == foreign_initial.get("dev")
            and canonical_state.get("ino") == foreign_initial.get("ino")
            and canonical_state.get("raw") == expected_state.get("raw")
            and accepted_state.get("dev") == expected_state.get("dev")
            and accepted_state.get("ino") == expected_state.get("ino")
            and accepted_state.get("raw") == expected_state.get("raw"))
        probe.unlink()
        accepted.unlink()
        return result

    rollback_open_swap_rig_ok = rollback_open_swap_probe(1)
    rollback_third_retry_open_swap_rig_ok = rollback_open_swap_probe(3)

    def attempt(repo: Path) -> tuple[bool, str, int, int, list[str]]:
        journal_before = journal_object(repo)
        cap_before = capture.stat().st_mtime_ns if capture.exists() else -1
        process_starts_before = provider_process_starts[0]
        runs_root = module.journal_root(repo) / "runs"
        before_runs = set(runs_root.iterdir()) if runs_root.is_dir() else set()
        attempt_sequence[0] += 1
        arena = work / f"attempt-tmp-{attempt_sequence[0]}"
        arena.mkdir()
        prior_tmpdir = os.environ.get("TMPDIR")
        prior_tempdir = module.tempfile.tempdir
        os.environ["TMPDIR"] = str(arena)
        module.tempfile.tempdir = str(arena)
        # Seed macOS's exact TMPDIR-local xcrun cache before observation. It is
        # now pre-existing host state, not a basename exception.
        subprocess.run([GIT, "--version"], env=dict(os.environ),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        arena_before = {str(path.absolute()) for path in arena.rglob("*")}
        observed: dict[str, object] = {"created": set(), "opened": [], "provider_outputs": [],
                                      "sink_identities": [], "sink_prechecks": [],
                                      "sink_fd_aliases": [], "open_returns": [],
                                      "original_sink_fd": None,
                                      "original_sink_precheck": None,
                                      "fd_lineage_events": [],
                                      "private_family_paths": set(),
                                      "provider_process_starts": 0,
                                      "journal_start_records": [],
                                      "journal_append_valid": False,
                                      "journal_append_error": None,
                                      "journal_before": journal_before,
                                      "private_paths": [], "private_paths_present": [],
                                      "run_return": None, "canonical_paths": [],
                                      "runs_root": runs_root,
                                      "arena": arena,
                                      "arena_before": arena_before,
                                      "canonical_direct_writes": [],
                                      "canonical_candidates": set(),
                                      "canonical_visibility_state": {},
                                      "canonical_visibility_epochs": [],
                                      "observer_busy": False}
        original_os_open = module.os.open
        original_os_close = module.os.close
        original_os_dup = module.os.dup
        original_os_dup2 = module.os.dup2
        original_os_fdopen = module.os.fdopen
        original_fcntl_call = module.fcntl.fcntl

        def observed_open(path, flags, *args, **kwargs):
            number = original_os_open(path, flags, *args, **kwargs)
            active = audit_active[0]
            if isinstance(active, dict):
                try:
                    absolute = str(Path(path).absolute())
                    opened = system_os_fstat(number)
                    item = {"path": absolute, "fd": number, "flags": flags,
                            "dev": opened.st_dev, "ino": opened.st_ino}
                    returns = active["open_returns"]
                    assert isinstance(returns, list); returns.append(item)
                    if active.get("original_sink_fd") == number:
                        events = active["fd_lineage_events"]
                        assert isinstance(events, list)
                        events.append(("open_reuse", number, absolute, flags))
                except Exception:
                    pass
            return number

