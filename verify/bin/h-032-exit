    exec(compile(discarded_runtime,"<h032-r49-discarded-rig>","exec"),discarded_namespace)
    integration_runtime_discarded=(discarded_namespace["run_codex"](1,2,3,4,5) is sentinel)
    integration_rig_ok=(integration_positive and integration_direct
        and not integration_dead and not integration_constants and not integration_discard
        and not integration_rebind and integration_runtime_positive
        and not integration_runtime_discarded)
    # Fixture authority is judge-private.  It is injected only into the actual
    # provider child after production has finished constructing its launch
    # environment; imported production never reads these controls from its own
    # environment or logic.
    launch_mode = ["valid"]
    launch_extra: dict[str, str] = {}
    provider_process_starts = [0]
    launch_output_override: list[Path | None] = [None]
    launch_expected_context: list[dict[str, object] | None] = [None]
    launch_observations: dict[str, dict[str, object]] = {}
    launch_environment_mode: list[str | None] = [None]
    launch_environment_additions: list[dict[str, str]] = [{}]
    launch_environment_inputs: dict[str, dict[str, str]] = {}
    def fixture_provider_environment(mode: str, incoming: dict[str,str]) -> dict[str,str]:
        env={key:value for key,value in incoming.items()
             if not key.startswith("GIT_")
             and not key.startswith("DYLD_")
             and key not in {"LD_PRELOAD","LD_LIBRARY_PATH","__PYVENV_LAUNCHER__"}}
        if mode=="drop_one": env.pop(r72_env_keys[0],None)
        elif mode=="length":
            lengths=set(map(len,r72_unrelated_environment))
            env={key:value for key,value in env.items()
                 if key.startswith(("H032_","NORTROPIC_"))
                 or key in {"PATH","HOME","TMPDIR"} or len(key) in lengths}
        elif mode=="prefix":
            prefixes=tuple(key[:4] for key in r72_unrelated_environment)
            env={key:value for key,value in env.items()
                 if key.startswith(("H032_","NORTROPIC_",*prefixes))
                 or key in {"PATH","HOME","TMPDIR"}}
        elif mode=="fixed":
            fixed=set(r72_unrelated_environment)|{
                "PATH","HOME","TMPDIR","NORTROPIC_TRUST_ROOT",
                "NORTROPIC_OPAQUE_RUNTIME_SENTINEL"}
            env={key:value for key,value in env.items()
                 if key.startswith("H032_") or key in fixed}
        elif mode=="extra": env[r72_extra_key]=r72_extra_value
        elif mode!="exact": raise RuntimeError(f"unknown fixture environment mode: {mode}")
        return env
    system_popen = module.subprocess.Popen
    def observe_launcher_argv(flat: list[object], child_env: dict[str, str]) -> dict[str, object]:
        context=launch_expected_context[0]
        observation: dict[str, object]={"valid":False}
        try:
            values=[str(item) for item in flat]
            separators=[index for index,value in enumerate(values) if value=="--"]
            if context is None or separators != [8]: return observation
            provider_argv=values[9:]
            output_indexes=[index for index,value in enumerate(provider_argv) if value=="-o"]
            worktree_indexes=[index for index,value in enumerate(provider_argv) if value=="-C"]
            if output_indexes != [len(provider_argv)-3] or worktree_indexes != [1]:
                return observation
            output=Path(provider_argv[output_indexes[0]+1])
            envelope_raw=Path(values[6]);worktree=Path(values[5])
            launcher=Path(values[3]);python=Path(values[0])
            envelope_stat=envelope_raw.lstat()
            envelope=envelope_raw.resolve(strict=True)
            expected_repo=Path(context["repo"]).resolve(strict=True)
            expected_worktree=Path(context["worktree"]).resolve(strict=True)
            expected_runs=(Path(context["journal_common"]).resolve(strict=True)
                           /"nortropic-codex-autopilot"/"runs")
            runs_before=set(context["runs_before"])
            current_runs=sorted(set(expected_runs.iterdir())-runs_before)
            current_run=(current_runs[0] if len(current_runs)==1 else None)
            journal_path=expected_runs.parent/"events.jsonl"
            journal_before=context["journal_before"]
            journal_after=journal_path.read_bytes() if journal_path.is_file() else b""
            journal_current=False
            if (isinstance(journal_before,bytes)
                    and journal_after.startswith(journal_before)
                    and len(journal_after)>len(journal_before)):
                suffix=journal_after[len(journal_before):]
                if suffix.endswith(b"\n"):
                    records=[strict_json(line.decode("utf-8"))
                             for line in suffix.splitlines()]
                    journal_current=(len(records)==1 and isinstance(records[0],dict)
                        and records[0].get("event")=="AGENT_START"
                        and records[0].get("role")=="TEST_AUTHOR"
                        and records[0].get("worktree")==str(expected_worktree)
                        and records[0].get("head")==git_repository_head(expected_worktree))
            trust_root=Path(child_env["NORTROPIC_TRUST_ROOT"])
            checks={
                "python_flags":values[1:3]==["-I","-S"],
                "launcher":launcher==expected_repo/"controller/launch/cli"
                    and launcher.is_file() and not launcher.is_symlink(),
                "run":values[4]=="run",
                "worktree":worktree==expected_worktree,
                "envelope_object":envelope_raw.is_absolute() and envelope_raw==envelope
                    and stat.S_ISREG(envelope_stat.st_mode) and not envelope_raw.is_symlink(),
                "envelope_name":envelope.name=="provider-envelope.json",
                "envelope_journal":envelope.parent.parent==expected_runs,
                "current_run":current_run is not None and envelope.parent==current_run,
                "current_journal":journal_current,
                "timeout":values[7]=="86400",
                "provider":provider_argv[0]==str(trust_root/"provider"),
                "provider_worktree":provider_argv[2]==str(expected_worktree),
                "output":output.is_absolute(),
                "python":python==trust_root/"python3.12",
            }
            syntax_ok=all(checks.values())
            observation={
                "valid":syntax_ok,"output":str(output),"envelope":str(envelope),
                "worktree":str(worktree),"timeout":values[7],"separator":separators[0],
                "provider_output_count":len(output_indexes),
                "provider_worktree_count":len(worktree_indexes),
                "checks":checks,
                "current_run":str(current_run) if current_run is not None else None,
            }
        except (KeyError,OSError,ValueError,IndexError):
            pass
        return observation
    def fixture_popen(argv, *args, **kwargs):
        flat = list(argv)
        if "-o" in flat:
            if launch_output_override[0] is not None:
                output_indexes=[index for index,value in enumerate(flat) if value=="-o"]
                if len(output_indexes)==1 and output_indexes[0]+1<len(flat):
                    flat[output_indexes[0]+1]=str(launch_output_override[0])
                    argv=flat
            active = audit_active[0]
            if isinstance(active, dict):
                try:
                    sink = Path(flat[flat.index("-o") + 1])
                    opened = sink.lstat()
                    identities = active["sink_identities"]
                    assert isinstance(identities, list)
                    identity = (opened.st_dev, opened.st_ino)
                    if identity not in identities:
                        identities.append(identity)
                except (OSError, ValueError):
                    pass
            kwargs = dict(kwargs); child_env = dict(kwargs.get("env") or {})
            child_env.update(launch_environment_additions[0])
            if launch_environment_mode[0] is not None:
                output_key=str(flat[flat.index("-o")+1])
                launch_environment_inputs[output_key]=dict(child_env)
                child_env=fixture_provider_environment(
                    launch_environment_mode[0],child_env)
            fixture_manpath_present="1" if "MANPATH" in child_env else "0"
            fixture_manpath_value=child_env.get("MANPATH","")
            child_env.update({
                "H032_RESULT_MODE": launch_mode[0],
                "H032_CAPTURE": str(capture),
                "H032_LOCKED_SOURCE": str(provider),
                "H032_SAFE_ATTACK_ROOT": str(work),
                "H032_HOST_DIRECT_MARKER": str(work / "HOST_DIRECT_EXECUTED"),
                "H032_FIXTURE_MANPATH_PRESENT":fixture_manpath_present,
                "H032_FIXTURE_MANPATH_VALUE":fixture_manpath_value,
                **launch_extra,
            })
            kwargs["env"] = child_env
            observation=observe_launcher_argv(flat,child_env)
            output=observation.get("output")
            if isinstance(output,str): launch_observations[output]=observation
        process = system_popen(argv, *args, **kwargs)
        if "-o" in flat:
            provider_process_starts[0] += 1
        return process
    module.subprocess.Popen = fixture_popen
    run_seq = [0]
    forced_run_ids: list[str] = []
    original_now_id = module.now_id
    def fixture_now_id():
        if forced_run_ids:
            return forced_run_ids.pop(0)
        run_seq[0] += 1
        return f"{original_now_id()}-{run_seq[0]:04d}"
    module.now_id = fixture_now_id

    journal_open = os.open; journal_close = os.close
    journal_fstat = os.fstat; journal_pread = os.pread
    MAX_ATTEMPT_JOURNAL_BYTES = 4 * 1024 * 1024
    SAFE_ATTEMPT_JOURNAL_MODE = 0o600

    def journal_object(repo: Path) -> dict[str, object]:
        path = module.journal_root(repo) / "events.jsonl"
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        try: fd = journal_open(path, flags)
        except FileNotFoundError:
            return {"valid": True, "exists": False, "path": str(path), "raw": b""}
        except Exception as exc:
            return {"valid": False, "exists": path.exists(), "path": str(path),
                    "raw": b"", "error": f"open:{type(exc).__name__}:{exc}"}
        try:
            before = journal_fstat(fd)
            if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1
                    or stat.S_IMODE(before.st_mode) != SAFE_ATTEMPT_JOURNAL_MODE
                    or before.st_size < 0 or before.st_size > MAX_ATTEMPT_JOURNAL_BYTES):
                return {"valid": False, "exists": True, "path": str(path), "raw": b"",
                        "error": "unsafe journal object"}
            chunks: list[bytes] = []; offset = 0
            while offset <= MAX_ATTEMPT_JOURNAL_BYTES:
                chunk = journal_pread(fd, min(65536, MAX_ATTEMPT_JOURNAL_BYTES + 1 - offset), offset)
                if not chunk: break
                chunks.append(chunk); offset += len(chunk)
            raw = b"".join(chunks)
            after = journal_fstat(fd)
            stable = (before.st_dev, before.st_ino, before.st_mode, before.st_nlink,
                      before.st_size, before.st_mtime_ns, before.st_ctime_ns) == (
                      after.st_dev, after.st_ino, after.st_mode, after.st_nlink,
                      after.st_size, after.st_mtime_ns, after.st_ctime_ns)
            return {"valid": stable and len(raw) == before.st_size,
                    "exists": True, "path": str(path), "raw": raw,
                    "dev": before.st_dev, "ino": before.st_ino,
                    "mode": before.st_mode, "nlink": before.st_nlink,
                    "size": before.st_size,
                    "error": None if stable and len(raw) == before.st_size
                    else "unstable journal object"}
        except Exception as exc:
            return {"valid": False, "exists": True, "path": str(path), "raw": b"",
                    "error": f"read:{type(exc).__name__}:{exc}"}
        finally:
            journal_close(fd)

    def strict_journal_append(before: dict[str, object], repo: Path) -> dict[str, object]:
        after = journal_object(repo)
        result: dict[str, object] = {"valid": False, "records": [],
                                    "start_records": [], "error": None,
                                    "before": before, "after": after}
        if before.get("valid") is not True or after.get("valid") is not True:
            result["error"] = f"object:{before.get('error')}:{after.get('error')}"
            return result
        before_exists = before.get("exists") is True
        after_exists = after.get("exists") is True
        if before_exists and not after_exists:
            result["error"] = "journal removed"
            return result
        if not after_exists:
            result["valid"] = True
            return result
        before_raw = before.get("raw", b""); after_raw = after.get("raw", b"")
        if not isinstance(before_raw, bytes) or not isinstance(after_raw, bytes):
            result["error"] = "journal bytes unavailable"
            return result
        if before_exists and (
                before.get("dev"), before.get("ino"),
                stat.S_IFMT(int(before.get("mode", 0))), before.get("nlink"),
                stat.S_IMODE(int(before.get("mode", 0)))) != (
                after.get("dev"), after.get("ino"),
                stat.S_IFMT(int(after.get("mode", 0))), after.get("nlink"),
                stat.S_IMODE(int(after.get("mode", 0)))):
            result["error"] = "journal object identity or protection changed"
            return result
        if (after.get("nlink") != 1
                or stat.S_IFMT(int(after.get("mode", 0))) != stat.S_IFREG
                or stat.S_IMODE(int(after.get("mode", 0))) != SAFE_ATTEMPT_JOURNAL_MODE):
            result["error"] = "journal protection is not owner-private regular nlink-one"
            return result
        if not after_raw.startswith(before_raw):
            result["error"] = "journal truncated or prefix changed"
            return result
        suffix = after_raw[len(before_raw):]
        if (not isinstance(before.get("size", 0), int)
                or not isinstance(after.get("size"), int)
                or before.get("size", 0) != len(before_raw)
                or after.get("size") != len(after_raw)
                or after.get("size", -1) < before.get("size", 0)
                or len(suffix) != after.get("size", 0) - before.get("size", 0)):
            result["error"] = "journal size/prefix accounting changed"
            return result
        result["suffix"] = suffix
        if not suffix:
            result["valid"] = True
            return result
        if not suffix.endswith(b"\n"):
            result["error"] = "journal append is not newline complete"
            return result
        try: text = suffix.decode("utf-8", errors="strict")
        except UnicodeDecodeError as exc:
            result["error"] = f"invalid UTF-8:{exc}"
            return result
        records: list[dict[str, object]] = []
        starts_now: list[dict[str, object]] = []
        for encoded_line in text.splitlines():
            if not encoded_line:
                result["error"] = "empty journal record"
                return result
            try: value = strict_json(encoded_line)
            except Exception as exc:
                result["error"] = f"invalid strict JSON:{type(exc).__name__}:{exc}"
                return result
            if not isinstance(value, dict) or not isinstance(value.get("event"), str):
                result["error"] = "journal record is not an event object"
                return result
            if value.get("event") == "AGENT_START":
                if (set(value) != {"event", "ts", "role", "model", "reasoning_effort",
                                   "model_routing_source", "worktree", "head"}
                        or value.get("role") != "TEST_AUTHOR"
                        or value.get("model") != "gpt-5.6-sol"
                        or value.get("reasoning_effort") != "max"
                        or value.get("model_routing_source") != "AUTOPILOT_ROLE_POLICY"
                        or not all(isinstance(value.get(key), str) and value.get(key)
                                   for key in ("ts", "worktree", "head"))):
                    result["error"] = "invalid AGENT_START shape"
                    return result
                starts_now.append(value)
            records.append(value)
        result.update({"valid": True, "records": records,
                       "start_records": starts_now, "error": None})
        return result

    def agent_start_records(repo: Path) -> list[dict[str, object]]:
        observed = strict_journal_append(
            {"valid": True, "exists": False, "raw": b""}, repo)
        if observed.get("valid") is not True: return []
        return list(observed.get("start_records", []))

    def starts(repo: Path) -> int:
        return len(agent_start_records(repo))

    def safe_capture() -> dict[str, object]:
        try:
            value = strict_json(capture.read_text(encoding="utf-8"))
            return value if isinstance(value, dict) else {}
        except Exception:
            return {}

    # H-032 owns only provider launch selection. The actual production generic
    # dispatcher must continue to execute Git, GitHub and arbitrary fixed
    # non-provider controller helpers without creating AGENT_START.
    git_effect = module.run([GIT, "--version"], cwd=base, check=False)
    check("K_NONPROVIDER_GIT_BOUNDARY", git_effect.rc == 0
          and git_effect.out.startswith("git version ") and starts(base) == 0,
          f"rc={git_effect.rc} out={git_effect.out.strip()} starts={starts(base)}")
    gh_path = shutil.which("gh")
    gh_effect = module.run([gh_path, "--version"], cwd=base, check=False) if gh_path else None
    check("K_NONPROVIDER_GITHUB_BOUNDARY", gh_effect is not None and gh_effect.rc == 0
          and "gh version" in gh_effect.out and starts(base) == 0,
          f"path={gh_path} result={gh_effect} starts={starts(base)}")
    generic_marker = work / "generic-controller-effect"
    generic = work / "generic-controller-helper"
    generic.write_text("#!/bin/sh\nprintf '%s\\n' \"$2\" >\"$1\"\nprintf 'GENERIC_OK\\n'\n", encoding="utf-8")
    generic.chmod(0o700)
    generic_effect = module.run([str(generic), str(generic_marker), "exact-token"], cwd=base, check=False)
    check("K_NONPROVIDER_GENERIC_EFFECT", generic_effect.rc == 0
          and generic_effect.out == "GENERIC_OK\n"
          and generic_marker.read_text(encoding="utf-8") == "exact-token\n"
          and starts(base) == 0,
          f"rc={generic_effect.rc} out={generic_effect.out!r} marker={generic_marker.exists()} starts={starts(base)}")

    attempt_sequence = [0]
    audit_active: list[dict[str, object] | None] = [None]
    last_attempt_observed: list[dict[str, object] | None] = [None]
    def audit_inventory(event: str, args: tuple[object, ...]) -> None:
        active = audit_active[0]
        if active is None or event not in {"os.mkdir", "open", "os.remove", "os.rename", "subprocess.Popen"}:
            return
        if active.get("observer_busy") is True:
            return
        if event == "subprocess.Popen":
            outputs = active["provider_outputs"]
            assert isinstance(outputs, list)
            for value in args:
                if isinstance(value, (list, tuple)) and "-o" in value:
                    outputs.append(str(value[value.index("-o") + 1]))
            return
        created = active["created"]
        assert isinstance(created, set)
        if event == "open":
            opened = active["opened"]
            assert isinstance(opened, list)
            opened.append(tuple(args))
            if args:
                try:
                    path = Path(args[0]).absolute()
                    flags = args[2] if len(args) > 2 and type(args[2]) is int else 0
                    runs_root = active["runs_root"]
                    assert isinstance(runs_root, Path)
                    if (path.name == "result.json" and runs_root in path.parents
                            and flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC)):
                        direct_writes = active["canonical_direct_writes"]
                        assert isinstance(direct_writes, list)
                        direct_writes.append((str(path), flags, path.exists()))
                except Exception:
                    pass
        if event in {"os.remove", "os.rename"} and args:
            candidate = args[1] if event == "os.rename" and len(args) > 1 else args[0]
            try:
                path = Path(candidate).absolute()
                runs_root = active["runs_root"]
                assert isinstance(runs_root, Path)
                if path.name == "result.json" and runs_root in path.parents \
                        and path.is_file() and not path.is_symlink():
                    active["observer_busy"] = True
                    current = path.stat()
                    epoch = (str(path), current.st_dev, current.st_ino, sha256(path))
                    epochs = active["canonical_visibility_epochs"]
                    assert isinstance(epochs, list)
                    if not epochs or epochs[-1] != epoch:
                        epochs.append(epoch)
            except Exception:
                pass
            finally:
                active["observer_busy"] = False
        values = args[1:2] if event == "os.rename" else args[:1]
        for value in values:
            if isinstance(value, (str, bytes, os.PathLike)):
                try:
                    path = Path(value).absolute()
                    if not path.exists(): created.add(str(path))
                except Exception: pass
    sys.addaudithook(audit_inventory)

    def attempt(repo: Path) -> tuple[bool, str, int, int, list[str]]:
        journal_before = journal_object(repo)
        cap_before = capture.stat().st_mtime_ns if capture.exists() else -1
        process_starts_before = provider_process_starts[0]
        runs_root = module.journal_root(repo) / "runs"
        before_runs = set(runs_root.iterdir()) if runs_root.is_dir() else set()
        attempt_sequence[0] += 1
        arena = work / f"attempt-tmp-{attempt_sequence[0]}"
        arena.mkdir()
        prior_tmpdir = os.environ.get("TMPDIR")
        prior_tempdir = module.tempfile.tempdir
        os.environ["TMPDIR"] = str(arena)
        module.tempfile.tempdir = str(arena)
        # Seed macOS's exact TMPDIR-local xcrun cache before observation. It is
        # now pre-existing host state, not a basename exception.
        subprocess.run([GIT, "--version"], env=dict(os.environ),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        arena_before = {str(path.absolute()) for path in arena.rglob("*")}
        observed: dict[str, object] = {"created": set(), "opened": [], "provider_outputs": [],
                                      "sink_identities": [], "sink_fd_aliases": [],
                                      "provider_process_starts": 0,
                                      "journal_start_records": [],
                                      "journal_append_valid": False,
                                      "journal_append_error": None,
                                      "journal_before": journal_before,
                                      "private_paths": [], "private_paths_present": [],
                                      "run_return": None, "canonical_paths": [],
                                      "runs_root": runs_root,
                                      "arena": arena,
                                      "canonical_direct_writes": [],
                                      "canonical_visibility_epochs": [],
                                      "observer_busy": False}
        audit_active[0] = observed
        try:
            try:
                observed["run_return"] = module.run_codex(repo, repo, "TEST_AUTHOR", "H032")
                outcome = (True, "ADMITTED")
            except Exception as exc:
                outcome = (False, f"{type(exc).__name__}:{exc}")
        finally:
            audit_active[0] = None
            module.tempfile.tempdir = prior_tempdir
            if prior_tmpdir is None: os.environ.pop("TMPDIR", None)
            else: os.environ["TMPDIR"] = prior_tmpdir
        cap_after = capture.stat().st_mtime_ns if capture.exists() else -1
        after_runs = set(runs_root.iterdir()) if runs_root.is_dir() else set()
        observed["canonical_paths"] = [str(path / "result.json")
                                       for path in sorted(after_runs - before_runs)]
        for value in observed["canonical_paths"]:
            path = Path(value)
            if path.is_file() and not path.is_symlink():
                current = path.stat()
                epoch = (str(path), current.st_dev, current.st_ino, sha256(path))
                epochs = observed["canonical_visibility_epochs"]
                assert isinstance(epochs, list)
                if not epochs or epochs[-1] != epoch:
                    epochs.append(epoch)
        last_attempt_observed[0] = observed
        created = observed["created"]
        assert isinstance(created, set)
        private_paths = sorted(Path(value) for value in created
                               if Path(value) != arena and arena in Path(value).parents
                               and str(Path(value).absolute()) not in arena_before)
        observed["private_paths"] = [str(path) for path in private_paths]
        observed["private_paths_present"] = [str(path) for path in private_paths
                                               if path.exists() or path.is_symlink()]
        observed["provider_process_starts"] = (
            provider_process_starts[0] - process_starts_before)
        journal_append = strict_journal_append(journal_before, repo)
        observed["journal_append_valid"] = journal_append.get("valid") is True
        observed["journal_append_error"] = journal_append.get("error")
        observed["journal_after"] = journal_append.get("after")
        observed["journal_append_records"] = list(journal_append.get("records", []))
        observed["journal_start_records"] = list(journal_append.get("start_records", []))
        sink_identities = observed["sink_identities"]
        assert isinstance(sink_identities, list)
        aliases: list[tuple[int, int, int]] = []
        for fd_path in Path("/dev/fd").iterdir():
            try:
                fd = int(fd_path.name); opened = os.fstat(fd)
            except (OSError, ValueError):
                continue
            if (opened.st_dev, opened.st_ino) in sink_identities:
                aliases.append((fd, opened.st_dev, opened.st_ino))
        observed["sink_fd_aliases"] = aliases
        residue_paths = {Path(value) for value in created if Path(value).exists()}
