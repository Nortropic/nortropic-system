            changed = ["1" if value == "86400" else value for value in list(argv)]
            return tracked_popen(changed, *args, **kwargs)
        module.subprocess.Popen = tracked_timeout_popen
        tracked_timeout = result_case("timeout")
        module.subprocess.Popen = tracked_popen
        tracked_fork = result_case("fork_descendant")
    finally:
        module.subprocess.Popen = original_tracked_popen
        monitor_stop.set()
        for thread in monitor_threads: thread.join(timeout=1)
        launch_mode[0] = "valid"
    time.sleep(2.5)
    remaining_identities = []
    rows_after = process_table()
    for identity in tracked_identities:
        pid, _ppid, started = identity
        if pid in rows_after and rows_after[pid][1] == started: remaining_identities.append(identity)
    tracked_timeout_paths = tracked_timeout[1].get("_gate_output_paths", [])
    tracked_timeout_root = (Path(tracked_timeout_paths[-1]).parent
                            if tracked_timeout_paths else work)
    tracked_fork_paths = tracked_fork[1].get("_gate_output_paths", [])
