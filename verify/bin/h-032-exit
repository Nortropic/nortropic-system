    journal_write = os.write; journal_fsync = os.fsync
    def append_gate_journal_bytes(case_repo: Path, raw: bytes) -> None:
        path = module.journal_root(case_repo) / "events.jsonl"
        path.parent.mkdir(parents=True, exist_ok=True)
        flags = (os.O_WRONLY | os.O_CREAT | os.O_APPEND
                 | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0))
        fd = journal_open(path, flags, 0o600)
        try:
            offset = 0
            while offset < len(raw):
                written = journal_write(fd, raw[offset:])
                if written <= 0: raise OSError("short journal mutant write")
                offset += written
            journal_fsync(fd)
        finally:
            journal_close(fd)

    def journal_fault_case(mode: str, ordinal: int):
        """Corrupt the exact current-attempt append and retain cleanup observations."""
        case_repo = make_repo(str(provider))
        if capture.exists(): capture.unlink()
        original_mkdtemp = module.tempfile.mkdtemp
        original_open = module.os.open; original_fstat = module.os.fstat
