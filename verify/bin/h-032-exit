                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    g20_out = g20_run.stdout
    if g20_run.returncode == 3 and "sandbox_apply: Operation not permitted" in g20_out:
        g20_odom, g20_ok = True, False
        check("K_G20_NAMESPACE", False, "ODÖMBART nested sandbox-exec förbjuden; owner-runner krävs")
    else:
        denial_lines = {f"{name}=1" for name in
                        ("WRITE","CHMOD","UNLINK","RENAME","HOST_WRITE","HOST_CHMOD",
                         "HOST_UNLINK","HOST_RENAME","CREATE","PARENT_RENAME")}
        g20_ok = (g20_run.returncode == 0 and denial_lines.issubset(set(g20_out.splitlines()))
                  and protected.exists() and protected_host.exists()
                  and not (trust / "replacement").exists())
        check("K_G20_NAMESPACE", g20_ok,
