            if name not in cli_consts:
                root_problems.append("verify cli lacks " + name)
        cli_paths = set()
        for value in cli_consts.values():
            cli_paths |= set(value.keys()) if isinstance(value, dict) else set(value)
        roots |= {p for p in cli_paths if isinstance(p, str) and (PATH_RE.fullmatch(p) or ROOT_DOC_RE.fullmatch(p))}
    except (SyntaxError, ValueError) as exc:
        cli_consts = {}
        root_problems.append("verify cli constants unreadable: " + repr(exc))
    try:
