    colliding = {collision_key(rel) for group in case_dupes for rel in group}
    dirty = [l[3:] for l in run([GIT, "-c", "core.quotePath=false", "-C", str(subject), "status", "--porcelain", "--untracked-files=no"], scratch, probe_env).stdout.splitlines() if l.strip()]
    # v3.2/v3.3 (N4): a case- or normalisation-insensitive checkout cannot hold both members of a colliding pair; that
