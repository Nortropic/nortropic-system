        p = subject / rel
        if not p.is_file() or p.is_symlink():
            raise Rig("subject file missing or not regular: " + rel)
    scratch = Path(tempfile.mkdtemp(prefix="platform-separation-final-")).resolve()
    print("FIXTURE_ROOT=" + str(scratch), flush=True)
    bench = Bench(scratch)
    # v3.9 (review v13 N5): the driver's TMPDIR is no longer its cwd. `python -c` puts the cwd on sys.path ahead of the
    # stdlib, and the TMPDIR is both writable by the product and exempt from the side-effect sweep, so a file staged
    # there in one scenario could shadow a not-yet-imported stdlib module in a later one. cwd is now an empty directory
    # the product is not given, and it IS covered by the sweep.
    ap_cwd = scratch / "driver-cwd"
    ap_cwd.mkdir(mode=0o755)
    driver_dir = scratch / "driver"
    driver_dir.mkdir(mode=0o755)
    driver_src = driver_dir / "gate_driver_source.py"
    write(driver_src, DRIVER.encode("utf-8"), 0o444)
    # The PATH stubs: one per tool the flows may resolve by name. PATH for the live run is the stub directory ALONE, so
    # every name lookup is logged from outside the interpreter that runs the product.
    stub_dir, stub_log = scratch / "stubbin", scratch / "stublog"
    stub_dir.mkdir(mode=0o755)
    stub_log.mkdir(mode=0o755)
    # v3.10 (review v14 N4): `node` had a stub but was in neither the tool nor the wrapper set, so every `node` start was
    # red four times over. The reference never starts `node`; the decision is that it may not be started during the flows,
    # so it gets no stub and any attempt to resolve it through PATH is an unresolved binary AND an unexpected tool.
    STUB_REAL = {"git": GIT, "python3.12": PYTHON, "env": "/usr/bin/env", "sh": "/bin/sh"}
    stub_nonce = hashlib.sha256(os.urandom(32)).hexdigest()
    for name, real in STUB_REAL.items():
        write(stub_dir / name, STUB_TEMPLATE.format(log=stub_log, name=name, real=real, nonce=stub_nonce).encode("utf-8"), 0o755)
    # Measured identities of every file the flows are allowed to execute: the pinned tools, the two wrapper binaries and
    # the gate's own stubs. A script whose BASENAME is `git` has a different sha256 and is red (review v13 B2).
    ALLOWED_START_SHA = {}
    for label, real in list(STUB_REAL.items()):
        p = Path(real)
        if p.is_file():
            ALLOWED_START_SHA[sha(p.read_bytes())] = label
    for name in STUB_REAL:
        ALLOWED_START_SHA[sha((stub_dir / name).read_bytes())] = "stub:" + name
    probe_env = bench.env(bench.tmp("probe"))
    head_probe = run([GIT, "-C", str(subject), "rev-parse", "--verify", "HEAD^{commit}"], scratch, probe_env)
    if head_probe.returncode or not COMMIT_FORM.fullmatch(head_probe.stdout.strip()):
        raise Rig("subject HEAD unavailable: " + head_probe.stderr.strip())
    head = head_probe.stdout.strip()
    for base in (FROZEN_BASE, HISTORICAL_BASE, GOVERNANCE_BASE, LAUNCH_CWD_BASE):
        if run([GIT, "-C", str(subject), "cat-file", "-e", base + "^{commit}"], scratch, probe_env).returncode:
            raise Rig("frozen base " + base + " is not in the subject's history")
    tracked_entries = ls_tree(subject, probe_env, "HEAD", ".")
    tracked = set(tracked_entries)
    def collision_key(rel):
        return unicodedata.normalize("NFC", rel).lower()

    lowered = {}
