# Real module, real callables, never the operational __main__. Stop -> exit 7.
DRIVER = (
    "import importlib.util,sys,json,subprocess as _sp\n"
    "_ORIG_POPEN=_sp.Popen\n"
    "from pathlib import Path\n"
    "subject=Path(sys.argv[1]); root=Path(sys.argv[2]); scenario=sys.argv[3]\n"
    "s=importlib.util.spec_from_file_location(sys.argv[4] if len(sys.argv)>4 else 'subject_autopilot', subject/'" + AUTOPILOT + "')\n"
    "m=importlib.util.module_from_spec(s); sys.modules[s.name]=m; s.loader.exec_module(m)\n"
    "out={'scenario':scenario}\n"
    "import os as _os\n"
    "_PRIMS=[(_sp,'Popen')]+[(_os,n) for n in ('posix_spawn','posix_spawnp','execv','execve','execvp','spawnv','spawnve','system') if hasattr(_os,n)]\n"
    "_ORIG_PRIMS={(mod.__name__,name):getattr(mod,name) for mod,name in _PRIMS}\n"
    "out['popen_identity']=bool(_sp.Popen is _ORIG_POPEN and sys.modules['subprocess'].Popen is _ORIG_POPEN\n"
    "                           and getattr(m,'subprocess',_sp) is _sp\n"
    "                           and all(getattr(sys.modules[mn],pn) is fn for (mn,pn),fn in _ORIG_PRIMS.items()))\n"
    "out['core_module_file']=getattr(sys.modules.get('core'),'__file__',None)\n"
    "try:\n"
    "    if scenario=='selftest_none':\n"
    "        m.selftest(None)\n"
    "        out.update(outcome='returned')\n"
    "    elif scenario=='roadmap_plan':\n"
    "        m.ensure_roadmap_plan(root)\n"
    "        out.update(outcome='returned')\n"
    "    elif scenario=='constants':\n"
    "        out.update(outcome='returned', has_plan_sha=hasattr(m,'ROADMAP_PLAN_SHA'), plan_generation=getattr(m,'PLAN_GENERATION',None),\n"
    "                   plan_blobs=dict(m.ROADMAP_PLAN_BLOBS), substitution_blobs=dict(m.SUBSTITUTION_BLOBS),\n"
    "                   plan_path=m.ROADMAP_PLAN_PATH, handoff_path=m.ROADMAP_HANDOFF_PATH, empirical_gate_path=m.EMPIRICAL_GATE_PATH,\n"
    "                   roadmap=[[sl.code, sl.task_id, sl.gate_path, list(sl.plan_allowed_write or ()), list(sl.required_deps)]\n"
    "                            for sl in tuple(m.SUBSTITUTION_ROADMAP)+tuple(m.ROADMAP)],\n"
    "                   substitution_codes=[sl.code for sl in m.SUBSTITUTION_ROADMAP], roadmap_codes=[sl.code for sl in m.ROADMAP],\n"
    "                   role_policy={k: list(v) for k, v in m.AUTOPILOT_ROLE_POLICY.items()})\n"
    "    elif scenario=='prompts':\n"
    "        import inspect,re as _re\n"
    "        builders={}\n"
    "        def _consts(co):\n"
    "            for c in co.co_consts:\n"
    "                if isinstance(c,str): yield c\n"
    "                elif hasattr(c,'co_consts'): yield from _consts(c)\n"
    "        for _n,_f in list(vars(m).items()):\n"
    "            if not inspect.isfunction(_f) or _f.__module__!=m.__name__: continue\n"
    "            if any(" + repr(PROMPT_MARK) + " in c for c in _consts(_f.__code__)) or _re.search(" + repr(PROMPT_FUNCTION_NAME_RE.pattern) + ", _n): builders[_n]=_f\n"
    "        # a FLOW acts on repositories (repo/wt/wt_root parameter): never called here; recognised by SIGNATURE only\n"
    "        flows={n for n,f in builders.items() if set(inspect.signature(f).parameters) & {'repo','wt','wt_root'}}\n"
    "        for n in flows: builders.pop(n)\n"
    "        slices=list(m.SUBSTITUTION_ROADMAP)+list(m.ROADMAP); SHA='a'*40; texts={}; errors={}\n"
    "        def fixture(p):\n"
    "            n=p.name; a=p.annotation\n"
    "            if n in ('signal','report'): return {}\n"
    "            if n=='findings': return [{'summary':'fixture','severity':'blocking'}]\n"
    "            if n in ('base_sha','candidate_sha'): return SHA\n"
    "            if p.default is not inspect.Parameter.empty: return p.default\n"
    "            if n=='task_id': return 'h-015'\n"
    "            if n=='stage': return 'BUILD'\n"
    "            if a is int: return 0\n"
    "            if a is bool: return False\n"
    "            if a is list: return []\n"
    "            if a is dict: return {}\n"
    "            return 'fixture'\n"
    "        for _n,_f in sorted(builders.items()):\n"
    "            params=[p for p in inspect.signature(_f).parameters.values() if p.kind in (p.POSITIONAL_OR_KEYWORD,p.KEYWORD_ONLY)]\n"
    "            variants=[{}]\n"
    "            if any(p.name=='sl' for p in params): variants=[{'sl':sl} for sl in slices]\n"
    "            if any(p.name=='role' for p in params): variants=[dict(v,role=r) for v in variants for r in ('TEST_AUTHOR','BUILDER')]\n"
    "            if any(p.name=='refrozen' for p in params): variants=[dict(v,refrozen=b) for v in variants for b in (False,True)]\n"
    "            for v in variants:\n"
    "                kwargs={p.name: (v[p.name] if p.name in v else fixture(p)) for p in params}\n"
    "                key=_n+''.join('['+(v[k].code if k=='sl' else str(v[k]))+']' for k in ('sl','role','refrozen') if k in v)\n"
    "                try:\n"
    "                    t=_f(**kwargs); texts[key]=t if isinstance(t,str) else '<non-str '+type(t).__name__+'>'\n"
    "                except Exception as e:\n"
    "                    errors[key]=repr(e)[:200]\n"
    "        stray=[]\n"
    "        for _n,_o in list(vars(m).items()):\n"
    "            if isinstance(_o,str) and " + repr(PROMPT_MARK) + " in _o: stray.append('str:'+_n)\n"
    "            if isinstance(_o,type) and getattr(_o,'__module__',None)==m.__name__:\n"
    "                for _a,_v in vars(_o).items():\n"
    "                    _fn=getattr(_v,'__func__',_v)\n"
    "                    if hasattr(_fn,'__code__') and any(" + repr(PROMPT_MARK) + " in c for c in _consts(_fn.__code__)): stray.append('class:'+_n+'.'+_a)\n"
    "        out.update(outcome='returned', builders=sorted(builders), flows=sorted(flows), texts=texts, errors=errors, stray=stray)\n"
    "    elif scenario=='live_flows':\n"
    "        import tempfile as _tf\n"
    "        missing=[n for n in " + repr(LIVE_STUB_NAMES + LIVE_REQUIRED_ATTRS) + " if getattr(m,n,None) is None]\n"
    "        if missing:\n"
    "            out.update(outcome='returned', flows={}, missing_names=missing)\n"
    "        else:\n"
    "            captured=[]; outcomes={}; state={'flow':None,'l_green':False,'answered':set()}\n"
    "            popen_calls=[]; rec_count=[0]\n"
    "            def _make_rec(mn,pn,orig):\n"
    "                def _rec(*a,**k):\n"
    "                    rec_count[0]+=1\n"
    "                    try:\n"
    "                        argv=a[0] if a else k.get('args') or k.get('argv')\n"
    "                        items=[str(x) for x in argv] if not isinstance(argv,(str,bytes)) else [str(argv)]\n"
    "                    except Exception: items=['<unreadable>']\n"
    "                    popen_calls.append({'prim':mn+'.'+pn,'argv':items})\n"
    "                    return orig(*a,**k)\n"
    "                return _rec\n"
    "            _RECS={}\n"
    "            for mod,name in _PRIMS:\n"
    "                r_=_make_rec(mod.__name__,name,_ORIG_PRIMS[(mod.__name__,name)]); _RECS[(mod.__name__,name)]=r_; setattr(mod,name,r_)\n"
    "            if getattr(m,'subprocess',None) is not None: m.subprocess.Popen=_RECS[('subprocess','Popen')]\n"
    "            head=m.sha(root); results=Path(_tf.mkdtemp(prefix='live-results-'))\n"
    "            def report_for(role):\n"
    "                base={'role':role,'outcome':'READY','owner_decision_required':False,'blocking_findings':[],'frozen_gate_ready':True,\n"
    "                      'baseline_red_for_right_reason':True,'changed_files':[],'production_files_modified':False,'allowed_write_violation':False,\n"
    "                      'next_action':'BUILD','next_task_id':'h-015','summary':'fixture','tests':[]}\n"
    "                key=(state['flow'],role); first=key not in state['answered']; state['answered'].add(key)\n"
    "                if first and (role in ('REVIEWER','GATE_REVIEWER') or (role=='EMPIRICAL' and state['flow']=='empirical_unattended_flow')):\n"
    "                    base['outcome']='NEEDS_REMEDIATION'\n"
    "                    base['blocking_findings']=[{'id':'FIXTURE-1','summary':'fixture blocker','evidence':'fixture'}]\n"
    "                return base\n"
    "            def fake_run_codex(repo_, wt_, role, prompt):\n"
    "                captured.append({'flow':state['flow'],'role':role,'prompt':prompt})\n"
    "                rep_=report_for(role)\n"
    "                res=results/('result-%d.json'%len(captured)); res.write_text(json.dumps(rep_), encoding='utf-8')\n"
    "                return m.AgentRun(rep_, 'fixture-thread', res, res)\n"
    "            def built(task_id):\n"
    "                return any(c['flow']==state['flow'] and c['role']=='BUILDER' and ('TASK='+task_id) in c['prompt'] for c in captured)\n"
    "            def fake_publish(repo_, wt_, branch_name, base_sha, candidate_sha, title, changed, **kw):\n"
    "                if title==m.EMPIRICAL_GATE_SUBJECT: state['l_green']=True\n"
    "                return candidate_sha\n"
    "            stubs={'run_codex':fake_run_codex,'ensure_worktree':lambda *a, **k: root,'detached_worktree':lambda *a, **k: root,\n"
    "                   'remove_worktree':lambda *a, **k: None,'clean':lambda _r: True,'origin_main':lambda _r: head,\n"
    "                   'capture_green_gates':lambda _wt: [],'run_gate':lambda wt_, tid, timeout=1200: m.Cmd(0 if built(tid) else 1, ''),\n"
    "                   'run_empirical_gate':lambda _r, timeout=3600: m.Cmd(0 if state['l_green'] else 1, ''),\n"
    "                   'assert_builder_scope':lambda *a, **k: ['controller/fixture/cli'],'assert_test_author_scope':lambda *a, **k: ['verify/bin/h-003-exit'],\n"
    "                   'assert_roadmap_test_author_scope':lambda *a, **k: ['specs/tasks.spec.json'],'assert_empirical_gate_author_scope':lambda *a, **k: ['verify/bin/autonomous-loop-exit'],\n"
    "                   'assert_final_gates':lambda *a, **k: None,'assert_task_gate_completion':lambda *a, **k: None,'assert_s7_external_prerequisite':lambda *a, **k: None,\n"
    "                   'run_invariants':lambda _r: None,'stage_and_commit':lambda wt_, files, subject: m.sha(wt_),\n"
    "                   'publication_authority':lambda *a, **k: {},'publish':fake_publish,'task_contract_judgeable':lambda *a, **k: True,\n"
    "                   'task_obj':None}\n"
    "            slices={sl.code: sl for sl in tuple(m.SUBSTITUTION_ROADMAP)+tuple(m.ROADMAP)}\n"
    "            stubs['task_obj']=lambda repo_, tid: next(({'id':sl.task_id,'exit_test':sl.gate_path,'depends_on':list(sl.required_deps),'allowed_write':list(sl.plan_allowed_write or ())} for sl in slices.values() if sl.task_id==tid), {'id':tid,'exit_test':'verify/bin/'+tid+'-exit','depends_on':[],'allowed_write':[]})\n"
    "            for n,f in stubs.items(): setattr(m, n, f)\n"
    "            flows={'architect_resolution': lambda: m.architect_resolution(root, root, 'BUILD', 'h-015', {'summary':'fixture'}, ''),\n"
    "                   'roadmap_contract_flow[SUB-1]': lambda: m.roadmap_contract_flow(root, root/'wt', slices['SUB-1']),\n"
    "                   'roadmap_contract_flow[S2]': lambda: m.roadmap_contract_flow(root, root/'wt', slices['S2']),\n"
    "                   'empirical_gate_contract_flow': lambda: m.empirical_gate_contract_flow(root, root/'wt'),\n"
    "                   'builder_flow[S2]': lambda: m.builder_flow(root, root/'wt', slices['S2'].task_id, 'nortropic/loop-fixture', 'loop-fixture', '[LOOP] fixture', extra=m.slice_builder_extra(slices['S2'])),\n"
    "                   'ensure_roadmap_slice[SUB-1]': lambda: m.ensure_roadmap_slice(root, root/'wt', slices['SUB-1']),\n"
    "                   'ensure_roadmap_slice[S2]': lambda: m.ensure_roadmap_slice(root, root/'wt', slices['S2']),\n"
    "                   'test_author_flow': lambda: m.test_author_flow(root, root/'wt'),\n"
    "                   'empirical_unattended_flow': lambda: m.empirical_unattended_flow(root, root/'wt'),\n"
    "                   'full_roadmap': lambda: m.full_roadmap(root, root/'wt')}\n"
    "            for _n,_f in flows.items():\n"
    "                state['flow']=_n; state['l_green']=(_n=='empirical_unattended_flow'); before=len(captured)\n"
    "                try:\n"
    "                    _f(); outcomes[_n]={'outcome':'returned'}\n"
    "                except m.Stop as e:\n"
    "                    outcomes[_n]={'outcome':'stop','message':str(e)[:300]}\n"
    "                except Exception as e:\n"
    "                    outcomes[_n]={'outcome':'error','message':repr(e)[:300]}\n"
    "                outcomes[_n]['captures']=[{'role':c['role'],'prompt':c['prompt']} for c in captured[before:]]\n"
    "            prompts_seen={c['prompt'] for c in captured}\n"
    "            def _shape(c):\n"
    "                base=(c['argv'][0].rsplit('/',1)[-1] if c['argv'] else '')\n"
    "                marked=any(mk in c['argv'] for mk in " + repr(PROVIDER_SHAPE_ELEMENTS) + ") or any(t in base for t in " + repr(PROVIDER_SHAPE_BINARY_TOKENS) + ")\n"
    "                allowed=base in " + repr(sorted(ALLOWED_LIVE_BINARIES)) + "\n"
    "                allowed=allowed and c['prim'] in " + repr(sorted(ALLOWED_LIVE_PRIMITIVES)) + "\n"
    "                return {'prim':c['prim'],'base':base,'marked':marked,'allowed':allowed,'last':(c['argv'][-1] if c['argv'] else ''),\n"
    "                        'matched':any(c['argv'] and (c['argv'][-1]==p or p in c['argv'][-1]) for p in prompts_seen)}\n"
    "            shapes=[_shape(c) for c in popen_calls]\n"
    "            suspect=[s for s in shapes if (s['marked'] or not s['allowed']) and not s['matched']]\n"
    "            identity_after=bool(all(getattr(sys.modules[mn],pn) is _RECS[(mn,pn)] for (mn,pn) in _RECS)\n"
    "                                and getattr(m,'subprocess',_sp) is _sp and m.subprocess.Popen is _RECS[('subprocess','Popen')])\n"
    "            out.update(outcome='returned', flows=outcomes, popen_total=len(popen_calls), recorded=rec_count[0],\n"
    "                       provider_starts=len(suspect), provider_starts_unmatched=[s['base']+':'+s['last'][:120] for s in suspect[:4]],\n"
    "                       start_primitives=sorted({s['prim'] for s in shapes}), start_binaries=sorted({s['base'] for s in shapes}),\n"
    "                       popen_identity_after=identity_after)\n"
    "    elif scenario=='canary_fault':\n"
    "        raise NameError('fixture-canary')\n"
    "    else:\n"
    "        raise SystemExit(9)\n"
    "except m.Stop as e:\n"
    "    out.update(outcome='stop', message=str(e))\n"
    "print('" + DRIVER_MARK + "'+json.dumps(out, ensure_ascii=False))\n"
    "raise SystemExit(7 if out.get('outcome')=='stop' else 0)\n"
)


class Rig(RuntimeError):
    pass


# v3.2 (N4): a tracked-path pair that collides case-insensitively cannot be checked out cleanly on a case-insensitive file
# system; that is a PRODUCT defect (F1 row), so replica construction tolerates the resulting dirtiness instead of raising Rig.
CASE_COLLISION = {"present": False}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def strict(raw):
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                raise ValueError("duplicate JSON member " + repr(key))
            result[key] = value
        return result
    if isinstance(raw, bytes):
        raw = raw.decode("utf-8")
    return json.loads(raw, object_pairs_hook=pairs)


def scan(text, patterns):
    """(pattern, line, excerpt) for every match; an empty list is the only PASS."""
    hits = []
    for pattern in patterns:
        for m in re.finditer(pattern, text):
            line = text.count("\n", 0, m.start()) + 1
            hits.append((pattern, line, text[max(0, m.start() - 20):m.end() + 20].replace("\n", " ")))
    return hits


def fmt_hits(hits, limit=6):
    return "; ".join(f"{p}@{l}: {x}" for p, l, x in hits[:limit])


def label_of(rel):
    return re.sub(r"[^A-Za-z0-9]+", "_", rel)


def sections(text):
    """[(heading, start, end)] over `## ` headings; text before the first heading is the preamble ('')."""
    out, starts = [], [m.start() for m in re.finditer(r"^## .*$", text, re.M)]
    prev, prev_head = 0, ""
    for s in starts:
        out.append((prev_head, prev, s))
        prev, prev_head = s, text[s:text.find("\n", s) if text.find("\n", s) != -1 else len(text)]
    out.append((prev_head, prev, len(text)))
    return out


def clean_candidate(candidate):
    return candidate.rstrip(".,;:")


def refs_from_text(rel, text):
    """Repo-relative file references: path tokens (case-insensitive), root documents, markdown links."""
    out = set()
    for m in PATH_RE.finditer(text):
        c = clean_candidate(m.group(1))
        if "." in c.rsplit("/", 1)[-1]:
            out.add(c)
        else:
            out.add(c + "/")      # directory reference (resolved against tracked directories, never followed)
    for m in ROOT_DOC_RE.finditer(text):
        out.add(m.group(1))
    # ../x outside a markdown link leaves the repository (never tracked -> dangling); inside a link the
    # resolution below decides whether the target escapes the tree.
    for m in OUTSIDE_RE.finditer(LINK_RE.sub("](#)", text)):
        out.add("<outside-tree>" + m.group(1))
    for m in LINK_RE.finditer(text):
        target = m.group(1)
        if "://" in target or target.startswith(("mailto:", "#")):
            continue
        if target.startswith("/"):
            out.add("/" + target)  # absolute link: never a tracked path -> dangling
            continue
        parts, escaped = [], False
        for seg in (Path(rel).parent / target).as_posix().split("/"):
            if seg == "..":
                if parts:
                    parts.pop()
                else:
                    escaped = True
            elif seg and seg != ".":
                parts.append(seg)
        out.add(("<outside-tree>" if escaped else "") + "/".join(parts) + ("/" if target.endswith("/") else ""))
    return out


def refs_from_json(obj):
    out = set()
    if isinstance(obj, dict):
        for v in obj.values():
            out |= refs_from_json(v)
    elif isinstance(obj, list):
        for v in obj:
            out |= refs_from_json(v)
    elif isinstance(obj, str):
        if PATH_RE.fullmatch(obj) or ROOT_DOC_RE.fullmatch(obj):
            out.add(obj)
        m = OUTSIDE_RE.search(obj)
        if m:
            out.add("<outside-tree>" + m.group(1))  # ../x in a JSON value (worker_cmd, rules): never tracked
    return out


def decode_text(raw):
    """UTF-8 text without NUL bytes, else None (binary)."""
    if b"\x00" in raw:
        return None
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return None


def module_constants(source, names):
    """name -> literal value for top-level assignments of `names` (dict keys / tuple items are path literals)."""
    tree = ast.parse(source)
    found = {}
    for node in tree.body:
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id in names:
                    found[target.id] = ast.literal_eval(node.value)
    return found


def ast_path_strings(source):
    """Every repo-relative document path literal anywhere in a Python module (incl. prompt-building functions)."""
    out = set()
    for node in ast.walk(ast.parse(source)):
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            for m in PATH_RE.finditer(node.value):
                out.add(m.group(1))
            if PATH_RE.fullmatch(node.value):
                out.add(node.value)
    return out


def code_strings(source, skip_functions=()):
    """(line, value) for string constants that are neither docstrings nor inside a function named in skip_functions."""
    tree = ast.parse(source)
    docstrings, out, stack = set(), [], []
    for node in ast.walk(tree):
        if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)) and node.body:
            first = node.body[0]
            if isinstance(first, ast.Expr) and isinstance(first.value, ast.Constant) and isinstance(first.value.value, str):
                docstrings.add(id(first.value))

    class V(ast.NodeVisitor):
        def visit_FunctionDef(self, node):
            stack.append(node.name)
            self.generic_visit(node)
            stack.pop()
        visit_AsyncFunctionDef = visit_FunctionDef

        def visit_Constant(self, node):
            if isinstance(node.value, str) and id(node) not in docstrings:
                if not any(n in skip_functions for n in stack):
                    out.append((node.lineno, node.value))
    V().visit(tree)
    return out


def argparse_defaults(source):
    """option -> [string constants inside its default expression] for every add_argument call."""
    out = {}
    for node in ast.walk(ast.parse(source)):
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == "add_argument" \
                and node.args and isinstance(node.args[0], ast.Constant):
            for kw in node.keywords:
                if kw.arg == "default":
                    out[node.args[0].value] = [n.value for n in ast.walk(kw.value)
                                               if isinstance(n, ast.Constant) and isinstance(n.value, str)]
    return out


def prompt_document_sets(source):
    """name -> {docs/ and root-document paths injected by that prompt-building function}: its own string constants
    (incl. f-string parts), the module-level string constants it names, and the same for every function that calls a
    prompt builder (their `extra` strings are injected too). Returns (sets, builders, callers)."""
    tree = ast.parse(source)
    module_str = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name) \
                and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
            module_str[node.targets[0].id] = node.value.value
    functions = {n.name: n for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}

    def consts(node):
        return [c.value for c in ast.walk(node) if isinstance(c, ast.Constant) and isinstance(c.value, str)]

    builders = {name for name, node in functions.items()
                if any(PROMPT_MARK in v for v in consts(node)) or PROMPT_FUNCTION_NAME_RE.search(name)}
    callers = {name for name, node in functions.items() if name not in builders
               and any(isinstance(c, ast.Call) and isinstance(c.func, ast.Name) and c.func.id in builders for c in ast.walk(node))}
    out = {}
    for name in builders | callers:
        node = functions[name]
        values = consts(node) + [module_str[n.id] for n in ast.walk(node) if isinstance(n, ast.Name) and n.id in module_str]
        docs = set()
        for value in values:
            for m in PATH_RE.finditer(value):
                c = clean_candidate(m.group(1))
                if c.startswith("docs/") and "." in c.rsplit("/", 1)[-1]:
                    docs.add(c)
            for m in ROOT_DOC_RE.finditer(value):
                docs.add(m.group(1))
        out[name] = docs
    return out, builders, callers


def prompt_world(source):
    """Static closed-world view of the autopilot's prompt path (top-level functions only) — v3.3 fail-closed:
    producers  = functions carrying the role marker in any string constant, or returning an expression whose string
                 constants carry the marker or a docs/ document path;
    referrers  = functions whose body names an expected prompt builder;
    runner_problems = every prompt argument of a PROMPT_RUNNERS call whose ROOT is not a direct Call to an expected builder
                 (an f-string inside an expected flow, or the `prompt` parameter inside a runner, are the only other roots);
                 parameters, module-level names, other functions, methods, subscripts, comprehensions and conditionals
                 with a rootless branch are RED; plus every reference to a runner name that is not a direct call (alias);
    stray      = module- or class-level string constants carrying the marker or a docs/ document that is not a bare path constant;
    reachable  = functions reachable from main() through CALLS (a name in Call.func position), not mere references;
    guard_callers = functions calling PLAN_GUARD in Call position."""
    tree = ast.parse(source)
    functions = {n.name: n for n in tree.body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}

    def strs(node):
        return [c.value for c in ast.walk(node) if isinstance(c, ast.Constant) and isinstance(c.value, str)]

    def promptish(values):
        return any(PROMPT_MARK in v or DOC_LITERAL_RE.search(v) for v in values)

    module_names = {t.id for n in tree.body if isinstance(n, (ast.Assign, ast.AnnAssign))
                    for t in (n.targets if isinstance(n, ast.Assign) else [n.target]) if isinstance(t, ast.Name)}
    imported = set()
    for n in tree.body:
        if isinstance(n, (ast.Import, ast.ImportFrom)):
            imported |= {(a.asname or a.name).split(".")[0] for a in n.names}
    stray = []
    for n in tree.body:
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        for v in strs(n):
            if PROMPT_MARK in v:
                stray.append(f"line {n.lineno}: role marker outside a builder")
            elif DOC_LITERAL_RE.search(v) and not (PATH_RE.fullmatch(v) or ROOT_DOC_RE.fullmatch(v)):
                stray.append(f"line {n.lineno}: document path embedded in a module/class-level text")
        for nm in ast.walk(n):
            if isinstance(nm, ast.Name) and nm.id in PROMPT_RUNNERS:
                stray.append(f"line {n.lineno}: runner {nm.id} aliased or referenced at module/class level")
            if isinstance(nm, ast.Constant) and isinstance(nm.value, str) and any(r in nm.value for r in PROMPT_RUNNERS):
                stray.append(f"line {n.lineno}: module/class-level string names a runner")
    producers, referrers, runner_problems, guard_callers = set(), set(), [], set()
    for name, fn in functions.items():
        if any(PROMPT_MARK in v for v in strs(fn)):
            producers.add(name)
        for node in ast.walk(fn):
            if isinstance(node, ast.Return) and node.value is not None and promptish(strs(node.value)):
                producers.add(name)
        if {n.id for n in ast.walk(fn) if isinstance(n, ast.Name)} & EXPECTED_PROMPT_BUILDERS:
            referrers.add(name)
        if any(isinstance(c, ast.Call) and isinstance(c.func, ast.Name) and c.func.id == PLAN_GUARD for c in ast.walk(fn)):
            guard_callers.add(name)
    for name, fn in functions.items():
        params = {a.arg for a in fn.args.args + fn.args.kwonlyargs}
        assigns = {}
        for node in ast.walk(fn):
            if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
                assigns.setdefault(node.targets[0].id, []).append(node.value)
            if isinstance(node, ast.AugAssign) and promptish(strs(node.value)):
                runner_problems.append(f"{name}: augmented assignment adds prompt text")
        call_funcs = {id(c.func) for c in ast.walk(fn) if isinstance(c, ast.Call)}
        for node in ast.walk(fn):
            if isinstance(node, ast.Name) and node.id in PROMPT_RUNNERS and id(node) not in call_funcs and node.id != name:
                runner_problems.append(f"{name}: runner {node.id} referenced without a direct call (alias)")
        # v3.4 (review v8 B1): dynamic lookups and runner-name strings only inside the measured closed sets
        for node in ast.walk(fn):
            if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in DYNAMIC_LOOKUP_NAMES \
                    and name not in DYNAMIC_LOOKUP_FUNCTIONS:
                runner_problems.append(f"{name}: dynamic lookup {node.func.id}() outside the closed set")
            if isinstance(node, ast.Attribute) and (node.attr in ("modules", "__dict__") or (isinstance(node.value, ast.Name) and node.value.id == "importlib")) \
                    and name not in DYNAMIC_LOOKUP_FUNCTIONS:
                runner_problems.append(f"{name}: dynamic attribute lookup .{node.attr} outside the closed set")
            if isinstance(node, ast.Constant) and isinstance(node.value, str) and any(r in node.value for r in PROMPT_RUNNERS) \
                    and name not in RUNNER_NAME_STRING_FUNCTIONS:
                runner_problems.append(f"{name}: string constant names a runner")

        def classify(expr, depth=0):
            """(root, problems): root is True only when the expression's text comes from a direct builder call."""
            if depth > 8:
                return False, ["indirection too deep"]
            if isinstance(expr, ast.Name):
                if expr.id in assigns:
                    results = [classify(v, depth + 1) for v in assigns[expr.id]]
                    root = all(r for r, _ in results)
                    probs = [p for _, ps in results for p in ps]
                    if not root and any(r for r, _ in results):
                        probs.append(f"assignments to {expr.id} disagree on the builder root")
                    return root, probs
                if expr.id in params:
                    if name in PROMPT_RUNNERS and expr.id == "prompt":
                        return True, []
                    return False, []          # additive parameter text; never a root
                return False, [f"module-level or unknown text source {expr.id}"]
            if isinstance(expr, ast.Constant):
                if isinstance(expr.value, str) and promptish([expr.value]):
                    return False, ["inline prompt text"]
                return False, []
            if isinstance(expr, ast.JoinedStr):
                if name in EXPECTED_PROMPT_FLOWS:
                    return True, []
                probs = ["inline prompt text outside an expected flow"] if promptish(
                    [v.value for v in expr.values if isinstance(v, ast.Constant) and isinstance(v.value, str)]) else []
                for v in expr.values:
                    if isinstance(v, ast.FormattedValue):
                        probs += classify(v.value, depth + 1)[1]
                return False, probs
            if isinstance(expr, ast.BinOp):
                if not isinstance(expr.op, ast.Add):
                    return False, [f"prompt text combined with operator {type(expr.op).__name__} (only + is allowed)"]
                rl, pl = classify(expr.left, depth + 1)
                rr, pr = classify(expr.right, depth + 1)
                if rl and rr:
                    return True, pl + pr + ["two builder roots concatenated"]
                return rl or rr, pl + pr
            if isinstance(expr, ast.IfExp):
                rb, pb = classify(expr.body, depth + 1)
                ro, po = classify(expr.orelse, depth + 1)
                if rb != ro:
                    return rb or ro, pb + po + ["conditional prompt: one branch lacks a builder root"]
                return rb, pb + po
            if isinstance(expr, ast.Call):
                if isinstance(expr.func, ast.Name):
                    if expr.func.id in EXPECTED_PROMPT_BUILDERS:
                        return True, []
                    return False, [f"prompt from non-builder call {expr.func.id}()"]
                if isinstance(expr.func, ast.Attribute) and expr.func.attr in PROMPT_TEXT_METHODS and not expr.args and not expr.keywords:
                    return classify(expr.func.value, depth + 1)   # whitespace trim of the source; no rewriting
                return False, ["prompt from a method or attribute call (rewriting methods, dynamic lookups and class methods are RED)"]
            return False, [f"unresolved prompt source {type(expr).__name__}"]

        for node in ast.walk(fn):
            if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in PROMPT_RUNNERS:
                arg = node.args[PROMPT_ARG_INDEX] if len(node.args) > PROMPT_ARG_INDEX else \
                    next((k.value for k in node.keywords if k.arg == "prompt"), None)
                if arg is None:
                    runner_problems.append(f"{name}: runner call without prompt argument")
                    continue
                root, probs = classify(arg)
                if not root:
                    probs.append("no direct builder call as root")
                runner_problems += [f"{name}: {p}" for p in probs]
    calls = {name: {c.func.id for c in ast.walk(fn) if isinstance(c, ast.Call) and isinstance(c.func, ast.Name) and c.func.id in functions}
             for name, fn in functions.items()}
    reachable, queue = set(), ["main"]
    while queue:
        n = queue.pop()
        if n in reachable or n not in functions:
            continue
        reachable.add(n)
        queue.extend(calls[n])
    return producers, referrers, runner_problems, reachable, stray, guard_callers


def exec_surface_assignments(source):
    """[] when no assignment ANYWHERE in the file rebinds an exec-surface attribute or a module-level container (v3.6, B1).

    Allowed everywhere: plain names, tuple/list destructuring of names, `self.<attr>` (attr outside the exec surface) and
    subscript assignment to a LOCAL name. Red: an attribute target whose name is an exec primitive or whose base is an exec
    module (except the whitelisted `sys.dont_write_bytecode`), `sys.modules[...]`, and subscript assignment to a
    module-level name (that is how a class body or function rewrites the role policy or a plan constant at import time)."""
    tree = ast.parse(source)
    module_names = {t.id for n in tree.body if isinstance(n, (ast.Assign, ast.AnnAssign))
                    for t in (n.targets if isinstance(n, ast.Assign) else [n.target]) if isinstance(t, ast.Name)}
    problems = []

    def check_target(target, node):
        if isinstance(target, (ast.Tuple, ast.List)):
            for element in target.elts:
                check_target(element, node)
            return
        if isinstance(target, ast.Starred):
            check_target(target.value, node)
            return
        if isinstance(target, ast.Name):
            if target.id in PROMPT_RUNNERS:
                problems.append(f"line {node.lineno}: rebinding of runner {target.id}")
            return
        text = ast.unparse(target)
        if isinstance(target, ast.Attribute):
            if text in ATTRIBUTE_TARGET_WHITELIST:
                return
            if target.attr in EXEC_SURFACE_ATTRS or target.attr in PROMPT_RUNNERS:
                problems.append(f"line {node.lineno}: assignment to exec-surface attribute {text}")
                return
            if isinstance(target.value, ast.Name) and target.value.id in EXEC_MODULE_NAMES:
                problems.append(f"line {node.lineno}: assignment into exec module {text}")
            return
        if isinstance(target, ast.Subscript):
            base = target.value
            base_text = ast.unparse(base)
            if base_text in ("sys.modules", "globals()", "vars()", "locals()"):
                problems.append(f"line {node.lineno}: assignment into {base_text}")
                return
            if isinstance(base, ast.Name) and base.id in module_names:
                problems.append(f"line {node.lineno}: assignment into module-level {base.id}[...]")
            return
        problems.append(f"line {node.lineno}: assignment to {type(target).__name__} target {text[:50]}")

    for node in ast.walk(tree):
        if isinstance(node, ast.Assign):
            for target in node.targets:
                check_target(target, node)
        elif isinstance(node, (ast.AugAssign, ast.AnnAssign)):
            check_target(node.target, node)
        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == "setattr":
            arg = ast.unparse(node.args[0]) if node.args else "?"
            if arg in EXEC_MODULE_NAMES or arg in PROMPT_RUNNERS:
                problems.append(f"line {node.lineno}: setattr on {arg}")
    return problems


def module_level_form(source):
    """[] when every top-level statement of the autopilot matches the declared form (v3.5, review v9 B1; v3.6: class
    bodies are checked with the same statement forms — a ClassDef body executes at import)."""
    tree = ast.parse(source)
    problems = []

    def check_class(node):
        for index, stmt in enumerate(node.body):
            if isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef, ast.AnnAssign, ast.Pass)):
                continue
            if index == 0 and isinstance(stmt, ast.Expr) and isinstance(stmt.value, ast.Constant) and isinstance(stmt.value.value, str):
                continue
            if isinstance(stmt, ast.Assign) and all(isinstance(t, ast.Name) for t in stmt.targets):
                continue
            problems.append(f"line {stmt.lineno}: {type(stmt).__name__} in class body {node.name}: {ast.unparse(stmt)[:60]}")

    for node in ast.walk(tree):
        if isinstance(node, ast.ClassDef):
            check_class(node)
    for index, node in enumerate(tree.body):
        if isinstance(node, (ast.Import, ast.ImportFrom, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            continue
        if index == 0 and isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
            continue
        segment = ast.unparse(node).strip()
        if isinstance(node, (ast.Assign, ast.AnnAssign)):
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            non_name = [t for t in targets if not isinstance(t, ast.Name)]
            if non_name:
                if segment in MODULE_LEVEL_EXCEPTIONS:
                    continue
                problems.append(f"line {node.lineno}: module-level assignment to {ast.unparse(non_name[0])}")
                continue
            if any(isinstance(t, ast.Name) and t.id in EXEC_SURFACE_ATTRS for t in targets):
                problems.append(f"line {node.lineno}: module-level name shadows an exec-surface name")
            if node.value is not None and not isinstance(node.value, ast.Constant):
                # v3.6 (review v10 N7): a document path must be a single literal; assembling one from fragments hides it
                # from every path-literal rule (the plan constants themselves are bound by the single-literal row).
                parts = [c.value for c in ast.walk(node.value) if isinstance(c, ast.Constant) and isinstance(c.value, str)]
                if DOC_LITERAL_RE.search("".join(parts)) and not any(DOC_LITERAL_RE.search(p) for p in parts):
                    problems.append(f"line {node.lineno}: module-level constant assembles a document path from fragments")
            if node.value is not None:
                for sub in ast.walk(node.value):
                    # v3.6 (review v10 N6): only an exec MODULE's attribute is a rebinding; a plain `X = Y.copy()` is legitimate.
                    if isinstance(sub, ast.Attribute) and sub.attr in EXEC_SURFACE_ATTRS \
                            and isinstance(sub.value, ast.Name) and sub.value.id in EXEC_MODULE_NAMES:
                        problems.append(f"line {node.lineno}: module-level binding of {ast.unparse(sub)[:60]}")
                    if isinstance(sub, ast.Name) and sub.id in PROMPT_RUNNERS:
                        problems.append(f"line {node.lineno}: module-level binding of {sub.id}")
            continue
        if isinstance(node, ast.If) and segment.startswith("if __name__ ==") and len(tree.body) - index == 1:
            continue
        if segment in MODULE_LEVEL_EXCEPTIONS:
            continue
        problems.append(f"line {node.lineno}: {type(node).__name__} at module level: {segment[:60]}")
    return problems


def literal_constant_assignments(source, names):
    """name -> (count, literal-or-None, problems) for module-level assignments of `names` (v3.5, review v9 N2)."""
    tree = ast.parse(source)
    found = {name: [0, None, []] for name in names}
    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        for target in node.targets:
            if not isinstance(target, ast.Name) or target.id not in found:
                continue
            entry = found[target.id]
            entry[0] += 1
            for sub in ast.walk(node.value):
                if isinstance(sub, (ast.Call, ast.Attribute, ast.Subscript, ast.IfExp, ast.Starred)):
                    entry[2].append(f"{target.id}: non-literal {type(sub).__name__} in the value")
                if isinstance(sub, ast.Name) and sub.id not in LITERAL_NAME_EXEMPT:
                    entry[2].append(f"{target.id}: name {sub.id} in the value")
            try:
                entry[1] = ast.literal_eval(node.value)
            except (ValueError, TypeError, SyntaxError):
                entry[1] = None
    return found


def literal_dict_with_path_keys(source, name, path_literals):
    """The literal value of a module-level dict assignment whose keys may be the two path-constant names (v3.6)."""
    for node in ast.parse(source).body:
        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == name for t in node.targets) \
                and isinstance(node.value, ast.Dict):
            out = {}
            for key, value in zip(node.value.keys, node.value.values):
                if isinstance(key, ast.Constant) and isinstance(key.value, str):
                    resolved = key.value
                elif isinstance(key, ast.Name) and key.id in path_literals and path_literals[key.id] is not None:
                    resolved = path_literals[key.id]
                else:
                    return None
                if not (isinstance(value, ast.Constant) and isinstance(value.value, str)):
                    return None
                out[resolved] = value.value
            return out
    return None


def ast_identities(source, names):
    """name -> sha256(ast.dump without positions) of the top-level function (or the assigned value) with that name (v3.4 B2)."""
    out = {}
    for n in ast.parse(source).body:
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name in names:
            out[n.name] = hashlib.sha256(ast.dump(n, annotate_fields=True, include_attributes=False).encode("utf-8")).hexdigest()
        if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name) and n.targets[0].id in names:
            out[n.targets[0].id] = hashlib.sha256(ast.dump(n.value, annotate_fields=True, include_attributes=False).encode("utf-8")).hexdigest()
    return out


def selftest_exact_sets(source):
    """{'sub_exact': {...}, 'road_exact': {...}} literal dicts assigned inside selftest()."""
    for node in ast.walk(ast.parse(source)):
        if isinstance(node, ast.FunctionDef) and node.name == "selftest":
            found = {}
            for sub in ast.walk(node):
                if isinstance(sub, ast.Assign) and len(sub.targets) == 1 and isinstance(sub.targets[0], ast.Name) \
                        and sub.targets[0].id in ("sub_exact", "road_exact"):
                    try:
                        found[sub.targets[0].id] = ast.literal_eval(sub.value)
                    except ValueError:
                        pass
            return found
    return {}


def split_cell_list(cell):
    cell = cell.strip().strip("`").strip()
    if cell in ("", "-", "—", "–"):
        return []
    return [x.strip().strip("`").strip() for x in cell.split(",") if x.strip().strip("`").strip()]


def visible_markdown(text):
    """The text a reader sees as prose/tables: HTML comments and fenced code blocks removed (v3.2, review v6 B2)."""
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    return re.sub(r"^(```|~~~).*?^\1[^\n]*$", "", text, flags=re.S | re.M)


def parse_slice_table(text):
    """(rows, problem): rows = [(slice, task, exit_test, [allowed_write], [depends_on], STATUS)] from the ONLY visible
    markdown table whose header cells are exactly PLAN_TABLE_COLUMNS (case-insensitive, backticks/bold tolerated); HTML
    comments and code fences are stripped first; two such tables are a problem (one truth)."""
    lines = visible_markdown(text).splitlines()
    header_cells = [(i, [c.strip().strip("`*").strip().lower() for c in line.strip().strip("|").split("|")])
                    for i, line in enumerate(lines) if line.strip().startswith("|")]
    headers = [i for i, cells in header_cells if cells == list(PLAN_TABLE_COLUMNS)]
    if len(headers) > 1:
        return None, f"multiple slice tables ({len(headers)}) — one truth required"
    # v3.3 (review v7 N3): any other visible table whose header carries slice AND task columns is a competing reading view.
    lookalikes = [i for i, cells in header_cells if cells != list(PLAN_TABLE_COLUMNS) and {"slice", "task"} <= set(cells)]
    if lookalikes:
        return None, f"slice-like table(s) with other columns at line(s) {[i + 1 for i in lookalikes]} — one truth required"
    i, rows = 0, []
    while i < len(lines):
        line = lines[i].strip()
        if line.startswith("|"):
            cells = [c.strip().strip("`*").strip().lower() for c in line.strip("|").split("|")]
            if cells == list(PLAN_TABLE_COLUMNS):
                i += 1
                if i < len(lines) and re.match(r"^\|?\s*:?-{3,}", lines[i].strip()):
                    i += 1
                while i < len(lines) and lines[i].strip().startswith("|"):
                    c = [x.strip() for x in lines[i].strip().strip("|").split("|")]
                    if len(c) != len(PLAN_TABLE_COLUMNS):
                        return None, f"row with {len(c)} cells: {lines[i].strip()[:80]}"
                    rows.append((c[0].strip("`").strip(), c[1].strip("`").strip(), c[2].strip("`").strip(),
                                 split_cell_list(c[3]), split_cell_list(c[4]), c[5].strip("`*").strip().upper()))
                    i += 1
                return rows, ""
        i += 1
    return None, "no table with header " + " | ".join(PLAN_TABLE_COLUMNS)


class Bench:
    """Scratch root, closed child environment and pinned tool resolver."""

    def __init__(self, scratch):
        self.scratch = scratch
        self.resolver = scratch / "resolver"
        self.home = scratch / "home"
        self.xdg = scratch / "xdg"
        self.template = scratch / "empty-template"
        for d in (self.resolver, self.home, self.xdg, self.template):
            d.mkdir(mode=0o700)
        (self.resolver / "python3.12").symlink_to(PYTHON)
        (self.resolver / "node").symlink_to(NODE)
        (self.resolver / "git").symlink_to(GIT)

    def env(self, tmpdir, extra=None):
        e = {
            "HOME": str(self.home), "XDG_CONFIG_HOME": str(self.xdg),
            "PATH": str(self.resolver) + ":/usr/bin:/bin",
            "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8",
            "TMPDIR": str(tmpdir), "DARWIN_USER_TEMP_DIR": str(tmpdir),
            "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_SYSTEM": "/dev/null",
            "GIT_ATTR_NOSYSTEM": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_PAGER": "cat",
            "GIT_OPTIONAL_LOCKS": "0", "GIT_NO_LAZY_FETCH": "1", "GIT_NO_REPLACE_OBJECTS": "1",
            "GIT_AUTHOR_NAME": "Local fixture", "GIT_AUTHOR_EMAIL": "fixture@example.invalid",
            "GIT_COMMITTER_NAME": "Local fixture", "GIT_COMMITTER_EMAIL": "fixture@example.invalid",
            "PYTHONDONTWRITEBYTECODE": "1",
            "PROVIDER_CALL_ALLOWED": "NO", "MODEL_CALL_ALLOWED": "NO",
        }
        if extra:
            e.update(extra)
        return e

    def tmp(self, name):
        p = self.scratch / ("tmp-" + name)
        p.mkdir(mode=0o700)
        return p


def run(argv, cwd, env, timeout=120, stdin=None):
    return subprocess.run([str(a) for a in argv], cwd=str(cwd), env=env, capture_output=True,
                          text=True, timeout=timeout, check=False, input=stdin)


def run_bytes(argv, cwd, env, timeout=120):
    return subprocess.run([str(a) for a in argv], cwd=str(cwd), env=env, capture_output=True, timeout=timeout, check=False)


def git_raw(root, env, *args):
    # core.quotePath=false: non-ASCII paths (NFC/NFD twins, N4) come back verbatim, not octal-escaped
    return run([GIT, "-c", "core.hooksPath=/dev/null", "-c", "core.quotePath=false", *args], root, env)


def git(root, env, *args):
    r = git_raw(root, env, *args)
    if r.returncode:
        raise Rig("fixture Git failed: " + " ".join(args) + ": " + r.stderr.strip())
    return r.stdout.strip()


def write(path, data, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    if isinstance(data, str):
        data = data.encode("utf-8")
    with path.open("xb") as stream:
        stream.write(data)
    path.chmod(mode)


def json_ok(result):
    """Exact one-line JSON dict on stdout with rc 0 and empty stderr, else None."""
    if result.returncode != 0 or result.stderr:
        return None
    if not result.stdout.endswith("\n") or result.stdout.count("\n") != 1:
        return None
    try:
        obj = strict(result.stdout)
    except ValueError:
        return None
    return obj if type(obj) is dict else None


def json_refusal(result):
    """The reason of an exact one-line refusal JSON {"status":"refused","reason":...} with rc != 0, else None (N3)."""
    if result.returncode == 0 or result.stderr or result.stdout.count("\n") != 1:
        return None
    try:
        obj = strict(result.stdout)
    except ValueError:
        return None
    if type(obj) is not dict or set(obj) != {"status", "reason"} or obj["status"] != "refused" or type(obj["reason"]) is not str:
        return None
    return obj["reason"]


def snapshot_tree(root, skip_git=False):
    """{relative path: (size, mtime_ns)} for every file under root (side-effect detection, N5/N6); .git/ optionally skipped
    (index noise from other processes is not a product side effect)."""
    out = {}
    for p in sorted(Path(root).rglob("*")):
        if skip_git and ".git" in p.relative_to(root).parts:
            continue
        if p.is_file() or p.is_symlink():
            st = p.lstat()
            out[str(p.relative_to(root))] = (st.st_size, st.st_mtime_ns)
    return out


def snapshot_names(*dirs):
    """Top-level entries of the given directories as (name, size, mtime_ns) for regular files and (name,) for everything
    else — absolute-path side effects such as /private/tmp/claude/<marker>, including an overwritten existing marker (v3.4 N)."""
    out = {}
    for d in dirs:
        try:
            entries = []
            for name in sorted(os.listdir(d)):
                try:
                    st = os.lstat(os.path.join(d, name))
                    entries.append((name, st.st_size, st.st_mtime_ns) if stat.S_ISREG(st.st_mode) else (name,))
                except OSError:
                    entries.append((name,))
            out[d] = entries
        except OSError:
            out[d] = None
    return out


def driver_outcome(result):
    """Exact driver outcome or None; a traceback/uncaught fault never counts."""
    if result.stderr:
        return None
    lines = result.stdout.splitlines()
    if not lines or not lines[-1].startswith(DRIVER_MARK):
        return None
    try:
        obj = strict(lines[-1][len(DRIVER_MARK):])
    except ValueError:
        return None
    if type(obj) is not dict or obj.get("outcome") not in ("returned", "stop"):
        return None
    if obj["outcome"] == "returned" and result.returncode != 0:
        return None
    if obj["outcome"] == "stop" and (result.returncode != 7 or type(obj.get("message")) is not str):
        return None
    return obj


def replica(bench, name, source, candidate_sha):
    """h-035 recipe: git init with an empty template + local-only exact-SHA fetch + detached checkout; no remote."""
    repo = bench.scratch / ("replica-" + name)
    repo.mkdir(mode=0o755)
    env = bench.env(bench.tmp("git-" + name))
    for command in (
        ("init", "--quiet", f"--template={bench.template}"),
        ("config", "--local", "--replace-all", "core.repositoryformatversion", "0"),
        ("config", "--local", "--replace-all", "core.filemode", "true"),
        ("config", "--local", "--replace-all", "core.bare", "false"),
        ("config", "--local", "--replace-all", "core.logallrefupdates", "false"),
        ("config", "--local", "--replace-all", "core.ignorecase", "true"),
        ("config", "--local", "--replace-all", "core.precomposeunicode", "true"),
        ("config", "--local", "--replace-all", "core.hooksPath", "/dev/null"),
        ("config", "--local", "--replace-all", "gc.auto", "0"),
        ("config", "--local", "--replace-all", "maintenance.auto", "false"),
        ("config", "--local", "--replace-all", "fetch.writeCommitGraph", "false"),
        ("config", "--local", "--replace-all", "pack.writeReverseIndex", "false"),
        ("config", "--local", "--replace-all", "protocol.file.allow", "never"),
        ("-c", "protocol.file.allow=always", "-c", "fetch.unpackLimit=1",
         "fetch", "--quiet", "--no-tags", "--no-recurse-submodules", "--no-write-fetch-head",
         str(source), candidate_sha),
        ("checkout", "--detach", "--quiet", candidate_sha),
    ):
        r = run([GIT, *command], repo, env)
        if r.returncode or r.stdout or r.stderr:
            raise Rig("replica construction " + repr(command) + ": " + (r.stderr or r.stdout))
    if git(repo, env, "rev-parse", "HEAD") != candidate_sha or (git(repo, env, "status", "--porcelain") and not CASE_COLLISION["present"]):
        raise Rig("replica does not reproduce the candidate: " + name)
    if git_raw(repo, env, "remote").stdout.strip():
        raise Rig("replica unexpectedly has a remote")
    return repo, env


def overlay(repo, env, files, removals=(), message="local fixture overlay"):
    """Write/replace files (rel -> (bytes, mode)), remove `removals`, commit on the detached HEAD."""
    for rel, (data, mode) in files.items():
        p = repo / rel
        if p.exists() or p.is_symlink():
            p.unlink()
        write(p, data, mode)
    for rel in removals:
        (repo / rel).unlink()
    git(repo, env, "add", "-A", "--", *files, *removals)
    if git_raw(repo, env, "diff", "--cached", "--quiet").returncode != 0:
        git(repo, env, "commit", "--quiet", "--no-gpg-sign", "-m", message)
    if git(repo, env, "status", "--porcelain") and not CASE_COLLISION["present"]:
        raise Rig("overlay left the replica dirty")
    return git(repo, env, "rev-parse", "HEAD")


def ls_tree(subject, env, rev, path):
    """rel -> (mode, oid) for every blob under path at rev (empty when the path is absent)."""
    r = git_raw(subject, env, "ls-tree", "-r", rev, "--", path)
    if r.returncode:
        raise Rig("ls-tree failed: " + rev + " " + path + ": " + r.stderr.strip())
    out = {}
    for line in r.stdout.splitlines():
        meta, _, rel = line.partition("\t")
        mode, kind, oid = meta.split()
        if kind == "blob":
            out[rel] = (mode, oid)
    return out


def gate_rows(stdout):
    passes = re.findall(r"^PASS (\S+)", stdout, re.M)
    fails = re.findall(r"^FAIL (\S+)", stdout, re.M)
    m = re.search(r"^FIXTURE_ROOT=(.+)$", stdout, re.M)
    return passes, fails, (Path(m.group(1)) if m else None)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--subject", type=Path, default=ROOT)
    parser.add_argument("--held-control-set", type=Path, default=None,
                        help="held copy of verify/bin/platform-control-set-exit (default: the subject's copy, credited "
                             "only when byte-identical to " + FROZEN_BASE[:8] + ")")
    parser.add_argument("--held-launch-cwd", type=Path, default=None, help="held copy of verify/bin/launch-cwd-exit (same rule)")
    parser.add_argument("--held-governance", type=Path, default=None, help="held copy of verify/bin/platform-governance-exit (same rule)")
    parser.add_argument("--skip-held-gates", action="store_true",
                        help="skip the sandbox-exec dependent rows (held gates, loop fall.py); their rows are then FAIL, never PASS")
    args = parser.parse_args()
    subject = args.subject.resolve()
    if sys.version_info[:2] != (3, 12) or sha(Path(PYTHON).read_bytes()) != PYTHON_SHA:
        raise Rig("pinned Python 3.12 required")
    for tool in (GIT, NODE):
        if not Path(tool).is_file() or not os.access(tool, os.X_OK):
            raise Rig("pinned tool unavailable: " + tool)
    for rel in (SPEC, VERIFY_CLI, LOOP_CLI, AUTOPILOT, VERIFIER, REGISTER, PREMIAR, MANAGED, LOOP_CONFIG, LOOP_FALL,
                PUBLICATION_CALLERS, AGENTS, CLAUDE, README, ".gitignore", DRIFT, FULL_ROADMAP, SUBSTITUTION,
