# v3.6 (review v10 B1/N1): provider-shaped process starts are recognised by several independent markers, and every process
# started during the live flows must either be one of these ordinary tools (never provider-shaped) or carry a captured prompt.
# Exact argv ELEMENTS that mark a provider start (a substring test would flag `git show …codex-evidence-contract.md`),
# plus a binary whose basename carries the provider name; every other start must be an ordinary tool below.
PROVIDER_SHAPE_ELEMENTS = ("--output-schema", "danger-full-access")
