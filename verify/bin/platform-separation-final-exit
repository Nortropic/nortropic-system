          and "dead_prompt" not in fx_reachable and {"main", "architect_resolution", "twin_text", "architect_prompt", "run_codex", "agent_prompt_common", "ok_flow", "ensure_roadmap_plan"} <= fx_reachable
          and ast_identities(fixture_module, ("ok_flow", "main")).keys() == {"ok_flow", "main"}
          and ast_identities(fixture_module, ("ok_flow",)) == ast_identities(fixture_module.replace("def ok_flow(repo, wt, guidance=''):", "def ok_flow(repo,  wt, guidance = ''):"), ("ok_flow",))
          and ast_identities(fixture_module, ("ok_flow",)) != ast_identities(fixture_module.replace("ensure_roadmap_plan(repo)\n    return run_codex", "return run_codex"), ("ok_flow",)),
          f"producers={sorted(fx_producers)} referrers={sorted(fx_referrers)} flagged={sorted(fx_flagged)} stray={fx_stray} guard={sorted(fx_guard)} runner={fx_runner_problems[:6]}")
    # Autopilot constants are read once here (module import only; no repository needed) and reused by F2 and F4.
    ap_tmp = bench.tmp("autopilot")
    ap_env = bench.env(ap_tmp)
    stub_env = bench.env(ap_tmp, extra={"PATH": str(stub_dir)})
    r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, canary_repo, "constants"], ap_cwd, ap_env, timeout=300)
    consts = driver_outcome(r)
    consts_detail = (r.stdout + r.stderr)[-200:]
    if not consts or consts["outcome"] != "returned":
        consts = {}
    plan_generation = consts.get("plan_generation")
    check("canary_closure_extraction_follows_backticked_paths_and_relative_links",
          refs_from_text("docs/loop/a.md", "se `docs/loop/y.md`, [z](../loop/z.md) och [w](w.md \"titel\"); AGENTS.md; Docs/05-Beslutslogg.md; docs/loop/; <docs/loop/q.txt>")
          == {"docs/loop/y.md", "docs/loop/z.md", "docs/loop/w.md", AGENTS, "Docs/05-Beslutslogg.md", "docs/loop/", "docs/loop/q.txt"}
          and all(r.startswith("<outside-tree>") for r in refs_from_text(CLAUDE, "Läs `../webb/AGENTS.md` och [r](../../x/regler.md)."))
          and len(refs_from_text(CLAUDE, "Läs `../webb/AGENTS.md` och [r](../../x/regler.md).")) >= 2
          and refs_from_json({"spec": "config/premiar-backlog.json", "x": ["docs/05-beslutslogg.md"], "w": ["bash", "../webb/x.sh"]})
          == {"config/premiar-backlog.json", "docs/05-beslutslogg.md", "<outside-tree>../webb/x.sh"})

    # ------------------------------------------------------------------ F1: tree allowlist, absences, provenance
    offenders = sorted(rel for rel in tracked if rel not in ALLOW_EXACT and not rel.startswith(ALLOW_PREFIXES))
    check("f1_every_tracked_file_matches_platform_allowlist", not offenders and len(tracked) >= 120,
          f"tracked={len(tracked)} offenders={offenders[:12]}")
    present = sorted(rel for rel in tracked if rel in ABSENT_EXACT or rel.startswith(ABSENT_PREFIXES) or ABSENT_RE.match(rel))
    check("f1_required_absences_web_material_and_transferred_files", not present, f"present={present[:12]}")
    prov_ok, prov_detail = False, "missing"
    if PROVENANCE_2 in tracked and (subject / PROVENANCE_2).is_file():
        lines = [l for l in text(PROVENANCE_2).splitlines() if l.strip()]
        data_rows = [l.split("\t") for l in lines if not l.lower().startswith("path")]
        listed = {r[0]: r for r in data_rows if len(r) >= 3}
        problems = []
        for rel in TRANSFERRED:
            row = listed.get(rel)
            base_oid = git_raw(subject, probe_env, "rev-parse", f"{HISTORICAL_BASE}:{rel}").stdout.strip()
            if row is None:
                problems.append(rel + ": not listed")
            elif not OID_FORM.fullmatch(row[1]) or row[1] != base_oid:
                problems.append(f"{rel}: oid {row[1]} != {base_oid}")
            elif not row[2].strip():
                problems.append(rel + ": no destination")
            if rel in tracked:
                problems.append(rel + ": still tracked")
        prov_ok = not problems and set(listed) == set(TRANSFERRED)
        prov_detail = f"listed={sorted(listed)} problems={problems}"
    check("f1_web_transfer_provenance_2_lists_the_four_files_with_blob_oids_at_" + HISTORICAL_BASE[:8], prov_ok, prov_detail)
    check("f1_tracked_paths_unique_case_insensitively", not case_dupes, f"collisions(case/NFC)={case_dupes[:6]}")
    symlinks = sorted(rel for rel, (mode, oid) in tracked_entries.items() if mode == "120000")
    base_symlinks = sorted(rel for rel, (mode, oid) in ls_tree(subject, probe_env, FROZEN_BASE, ".").items() if mode == "120000")
    check("f1_no_symlink_entries_at_head", not symlinks and not base_symlinks, f"symlinks={symlinks} base={base_symlinks}")
    same_object = sorted(f"{rel} == {FORBIDDEN_BLOBS[oid]}" for rel, (mode, oid) in tracked_entries.items() if oid in FORBIDDEN_BLOBS)
    check("f1_no_blob_at_head_equals_a_transferred_pre_split_governance_or_pre_platform_plan_object",
          not same_object and len(FORBIDDEN_BLOBS) == 12, str(same_object)[:600])

    # ------------------------------------------------------------------ F2: reference closure oracle
    roots, root_problems = {AGENTS, CLAUDE, README, LOOP_CONFIG}, []
    skills = sorted(rel for rel in tracked if re.fullmatch(r"\.agents/skills/[^/]+/SKILL\.md", rel))
    roots |= set(skills)
    try:
        spec_obj = strict((subject / SPEC).read_bytes())
        authority = spec_obj.get("authority", {})
        auth_paths = [authority.get(k) for k in ("plan", "architecture", "rules", "backlog")]
        if not all(type(p) is str and PATH_RE.fullmatch(p) for p in auth_paths):
            root_problems.append(f"spec authority not four document paths: {authority}")
        roots |= {p for p in auth_paths if type(p) is str}
        spec_strict = type(spec_obj.get("tasks")) is list and type(spec_obj.get("defaults")) is dict
    except ValueError as exc:
        spec_obj, spec_strict = {}, False
        root_problems.append("spec not strict JSON: " + repr(exc))
    try:
        cli_consts = module_constants(text(VERIFY_CLI), {"PRETASK_PATHS", "PLATFORM_DOCUMENTS", "PLATFORM_CONTROL"})
        for name in ("PRETASK_PATHS", "PLATFORM_DOCUMENTS", "PLATFORM_CONTROL"):
            if name not in cli_consts:
                root_problems.append("verify cli lacks " + name)
        cli_paths = set()
        for value in cli_consts.values():
            cli_paths |= set(value.keys()) if isinstance(value, dict) else set(value)
        roots |= {p for p in cli_paths if isinstance(p, str) and (PATH_RE.fullmatch(p) or ROOT_DOC_RE.fullmatch(p))}
    except (SyntaxError, ValueError) as exc:
        cli_consts = {}
        root_problems.append("verify cli constants unreadable: " + repr(exc))
    try:
        autopilot_source = text(AUTOPILOT)
        autopilot_roots = ast_path_strings(autopilot_source)
        roots |= autopilot_roots
    except SyntaxError as exc:
        autopilot_source, autopilot_roots = "", set()
        root_problems.append("autopilot does not parse: " + repr(exc))
    check("f2_closure_roots_extracted_from_router_skills_spec_authority_verify_cli_autopilot_and_loop_config",
          not root_problems and len(skills) >= 6 and len(autopilot_roots) >= 8 and len(roots) >= 25,
          f"roots={len(roots)} skills={len(skills)} autopilot_roots={len(autopilot_roots)} problems={root_problems}")

    def exempt(rel):
        return rel in CLOSURE_EXEMPT or rel.startswith(CLOSURE_EXEMPT_PREFIXES)

    def scannable_text(rel):
        """The part of a reached document that is ACTIVE instruction (None when the document is frozen evidence)."""
        if rel == EFTERARBETE:   # v3.1 (N3): the appended tail is active and scanned; the 332f07ce body is frozen evidence
            base = base_bytes(rel, HISTORICAL_BASE)
            current = (subject / rel).read_bytes()
            if base is not None and current.startswith(base):
                return current[len(base):].decode("utf-8", "replace")
            return text(rel)
        if exempt(rel):
            return None
        raw = text(rel)
        if rel == DRIFT:
            base = base_bytes(rel, HISTORICAL_BASE)
            current = (subject / rel).read_bytes()
            if base is not None and current.startswith(base):
                return current[len(base):].decode("utf-8", "replace")
            return raw
        if rel in HISTORICAL_NOTE_DOCS:
            base = base_bytes(rel, HISTORICAL_BASE)
            current = (subject / rel).read_bytes()
            if base is None:
                return raw
            if current.endswith(base):
                return current[:len(current) - len(base)].decode("utf-8", "replace")
            if current.startswith(base):
                return current[len(base):].decode("utf-8", "replace")
            return raw
        if rel == SUBSTITUTION:
            keep = []
            for head_line, s, e in sections(raw):
                m = re.match(r"^## (\d+)\.", head_line)
                if m is None or int(m.group(1)) in (6, 12) or int(m.group(1)) > 13:
                    keep.append(raw[s:e])
            return "".join(keep)
        if rel.endswith("-local-development.md"):
            return None
        return raw

    tracked_dirs = {rel.rsplit("/", 1)[0] + "/" for rel in tracked if "/" in rel}
    tracked_dirs |= {d[:i + 1] for d in list(tracked_dirs) for i, ch in enumerate(d) if ch == "/"}
    reached, edges, dangling, queue = set(), {}, {}, sorted(roots)
    while queue:
        rel = queue.pop(0)
        if rel in reached:
            continue
        reached.add(rel)
        if rel not in tracked or not (subject / rel).is_file():
            continue
        body = scannable_text(rel)
        if body is None:
            continue
        if rel.endswith(".json"):
            try:
                refs = refs_from_json(strict((subject / rel).read_bytes()))
            except ValueError:
                refs = set()
        else:
            refs = refs_from_text(rel, body)
        refs.discard(rel)
        edges[rel] = sorted(refs)
        for ref in refs:
            if ref.endswith("/"):
                if ref not in tracked_dirs:
                    dangling.setdefault(ref, []).append(rel)
                continue
            if ref not in tracked:
                dangling.setdefault(ref, []).append(rel)
            if ref not in reached:
                queue.append(ref)
    check("f2_closure_all_active_references_resolve_to_tracked_files", not dangling,
          f"reached={len(reached)} dangling={ {k: v[:3] for k, v in sorted(dangling.items())} }")
    scanned = []
    for rel in sorted(reached):
        if rel not in tracked or not (subject / rel).is_file():
            continue
        body = scannable_text(rel)
        if body is None:
            continue
        scanned.append(rel)
        human = () if rel in HISTORICAL_NOTE_DOCS else HUMAN_TOKENS
        plan_extra = PLAN_TOKENS if rel in (PLAN_GEN, HANDOFF_GEN) else ()
        hits = scan(body, WEB_TOKENS + human + OLD_PLAN_TOKENS + COMMIT_READ_TOKENS + plan_extra)
        check("f2_active_doc_free_of_web_governance_and_human_hand_rules_" + label_of(rel), not hits, fmt_hits(hits))
    check("f2_plan_generation_and_handoff_reached_by_closure_and_scanned_as_active_documents",
          PLAN_GEN in scanned and HANDOFF_GEN in scanned and PLAN_GEN in tracked and HANDOFF_GEN in tracked,
          f"plan_scanned={PLAN_GEN in scanned} handoff_scanned={HANDOFF_GEN in scanned}")
    classification, web_hits, human_hits, binary_outside = {}, [], [], []
    for rel in sorted(tracked):
        p = subject / rel
        if not p.is_file() or p.is_symlink():
            continue
        if rel.startswith(TREE_FROZEN_PREFIXES) or rel in TREE_FROZEN_FILES:
            classification[rel] = "frozen"
            continue
        raw = p.read_bytes()
        body = decode_text(raw)
        if body is None:
            classification[rel] = "binary"
            if not rel.startswith(BINARY_ALLOWED_PREFIXES):
                binary_outside.append(rel)
            continue
        if rel in HISTORICAL_NOTE_DOCS or rel in (DRIFT, SUBSTITUTION, EFTERARBETE):
            classification[rel] = "partial"
            part = scannable_text(rel) or ""
            web_hits += [f"{rel}(added/active)@{l} {pat}: {x}" for pat, l, x in scan(part, WEB_TOKENS + OLD_PLAN_TOKENS + COMMIT_READ_TOKENS)]
            if rel not in HISTORICAL_NOTE_DOCS:
                human_hits += [f"{rel}(added/active)@{l} {pat}: {x}" for pat, l, x in scan(part, HUMAN_TOKENS)]
            continue
        if rel.endswith("-local-development.md"):
            classification[rel] = "local-development"
            continue
        is_python = rel.endswith(".py") or body.startswith("#!/usr/bin/env python")
        is_test = rel.startswith("tests/")
        if is_python:
            classification[rel] = "test" if is_test else "code"
            try:
                strings = code_strings(body, skip_functions={fn for f, fn in HISTORICAL_CODE_FUNCTIONS if f == rel})
            except SyntaxError as exc:
                web_hits.append(f"{rel}: does not parse: {exc!r}")
                continue
            tokens = (TEST_WEB_TOKENS if is_test else CODE_WEB_TOKENS) + OLD_PLAN_TOKENS
            for line, value in strings:
                web_hits += [f"{rel}@{line} {pat}: {value[:50]!r}" for pat in tokens if re.search(pat, value)]
                if SIBLING_RE.search(value):
                    web_hits.append(f"{rel}@{line} sibling-repo path: {value[:60]!r}")
                if not is_test:
                    human_hits += [f"{rel}@{line} {pat}: {value[:50]!r}" for pat in CODE_HUMAN_TOKENS if re.search(pat, value)]
            continue
        if rel.startswith("controller/") and not rel.endswith((".md", ".json")) or rel.endswith((".mjs", ".js", ".c", ".h")):
            classification[rel] = "test" if is_test else "code"
            web_hits += [f"{rel}@{l} {pat}: {x}" for pat, l, x in scan(body, (TEST_WEB_TOKENS if is_test else CODE_WEB_TOKENS) + OLD_PLAN_TOKENS)]
            continue
        classification[rel] = "text"
        plan_extra = PLAN_TOKENS if rel in (PLAN_GEN, HANDOFF_GEN) else ()
        web_hits += [f"{rel}@{l} {pat}: {x}" for pat, l, x in scan(body, WEB_TOKENS + (SIBLING_RE.pattern,) + OLD_PLAN_TOKENS + COMMIT_READ_TOKENS + plan_extra)]
        human_hits += [f"{rel}@{l} {pat}: {x}" for pat, l, x in scan(body, HUMAN_TOKENS)]
    counts = {k: sum(1 for v in classification.values() if v == k) for k in ("frozen", "partial", "local-development", "code", "test", "text", "binary")}
    check("f2_tree_wide_no_web_governance_reference_outside_frozen_evidence",
          not web_hits and not binary_outside and counts["text"] >= 20 and counts["code"] >= 15,
          f"counts={counts} binary_outside={binary_outside} hits={web_hits[:12]}")
    check("f2_tree_wide_no_human_hand_rule_outside_frozen_evidence", not human_hits and counts["text"] >= 20,
          f"counts={counts} hits={human_hits[:12]}")
    base_local_dev = {rel for rel in ls_tree(subject, probe_env, FROZEN_BASE, ".") if rel.endswith("-local-development.md")}
    head_local_dev = {rel for rel in tracked if rel.endswith("-local-development.md")}
    check("f2_local_development_documents_are_exactly_the_" + FROZEN_BASE[:8] + "_set_plus_this_contract",
          head_local_dev == base_local_dev | {DOCUMENT} and len(base_local_dev) >= 4,
          f"extra={sorted(head_local_dev - base_local_dev - {DOCUMENT})} missing={sorted((base_local_dev | {DOCUMENT}) - head_local_dev)}")
    agents_text = text(AGENTS)
    authority_section = next((agents_text[s:e] for h, s, e in sections(agents_text) if h.startswith("## Auktoritetsordning")), "")
    exempt_in_router = []
    # The whole router (AGENTS.md and CLAUDE.md), unit = one paragraph or one list item (a numbered/bulleted entry
    # with its continuation lines, never a following paragraph): every mention of a frozen/exempt document must
    # carry the markers in that same unit. The spec itself is active authority (exempt only from token scanning).
    for rel in (AGENTS, CLAUDE):
        for item in re.split(r"\n\s*\n|\n(?=\s*(?:\d+\.|[-*])\s)", text(rel)):
            for ref in refs_from_text(rel, item):
                if ref != SPEC and (ref in CLOSURE_EXEMPT or ref.startswith(CLOSURE_EXEMPT_PREFIXES) or ref in TREE_FROZEN_FILES):
                    if not (re.search(r"(?i)frys|frus|historisk", item) and re.search(r"(?i)inte\s+dagens\s+instruktion", item)):
                        exempt_in_router.append(f"{rel}: {ref}")
    check("f2_router_authority_section_marks_frozen_gate_inputs_as_not_current_instruction",
          bool(authority_section) and not exempt_in_router, f"unmarked={exempt_in_router}")
    auth_units = [u for u in re.split(r"\n\s*\n|\n(?=\s*(?:\d+\.|[-*])\s)", authority_section) if PLAN_GEN in u]
    demoted = [u[:80] for u in auth_units if re.search(r"(?i)inte\s+dagens\s+instruktion|historisk|frys\w*\s+grindinput|frus\w*\s+grindinput", u)]
    historik = next((agents_text[s:e] for h, s, e in sections(agents_text) if h.startswith("## Historik")), "")
    anchored = [u for u in auth_units if HANDOFF_GEN in u and re.search(r"(?i)plangeneration", u) and re.search(r"(?i)\baktiv", u)]
    hist_units = re.split(r"\n\s*\n|\n(?=\s*(?:\d+\.|[-*])\s)", historik)
    hist_new_active = [u for u in hist_units if PLAN_GEN in u and re.search(r"(?i)\baktiv", u)]
    hist_old_history = [u for u in hist_units if re.search(r"(?i)(tidigare|föregående|gamla|äldre)\s+plangeneration", u)
                        and re.search(r"(?i)\bhistori(a|sk)", u) and re.search(r"(?i)git-?historik", u)]
    check("f2_router_authority_order_names_plan_generation_as_active_and_historik_names_the_earlier_generation_as_history",
          bool(auth_units) and not demoted and len(anchored) == len(auth_units) and bool(historik)
          and bool(hist_new_active) and bool(hist_old_history),
          f"authority_mentions={len(auth_units)} anchored={len(anchored)} demoted={demoted} historik_len={len(historik)} "
          f"new_as_active={len(hist_new_active)} old_as_history={len(hist_old_history)}")
    # v3.10 (owner decision 2026-09-11) B5: regler.md IS the working method, and the router/skills point at it.
    rules_text = visible_markdown(text(RULES)) if RULES in tracked and (subject / RULES).is_file() else ""
    rules_problems = []
    for label, patterns in RULES_REQUIRED:
        missing = [p for p in patterns if not re.search(p, rules_text)]
        if missing:
            rules_problems.append(f"{label}: {missing}")
    check("f2_regler_md_carries_the_working_method_role_flow_frozen_gate_rule_gate_change_rule_review_standard_and_rig_threat_model",
          bool(rules_text) and not rules_problems, f"len={len(rules_text)} problems={rules_problems}"[:900])

    def normative_sentences(rel):
        """Normalised normative sentences of an active document; a sentence that NAMES the rulebook or the plan is a
        pointer, not a duplicated rule, and is left out."""
        body = re.sub(r"[`*_#>|\[\]]", " ", visible_markdown(text(rel)))
        body = re.sub(r"\s+", " ", body)
        out = set()
        for sentence in re.split(r"(?<=[.!?])\s+", body):
            sentence = re.sub(r"\s+", " ", sentence.strip().strip(".;:,").lower())
            if (len(sentence) >= NORMATIVE_MIN_LEN and NORMATIVE_MARKER.search(sentence)
                    and RULES not in sentence and PLAN_GEN not in sentence):
                out.add(sentence)
        return out

    ref_problems, sentence_sets = [], {}
    for rel in (RULES, PLAN_GEN) + REFERENCE_DOCS:
        if rel not in tracked or not (subject / rel).is_file():
            ref_problems.append(rel + ": missing")
            continue
        if rel in REFERENCE_DOCS:
            body = text(rel)
            for target in (RULES, PLAN_GEN):
                if target not in body:
                    ref_problems.append(f"{rel}: does not reference {target}")
        sentence_sets[rel] = normative_sentences(rel)
    duplicated = []
    named = sorted(sentence_sets)
    for i, a in enumerate(named):
        for b in named[i + 1:]:
            for sentence in sorted(sentence_sets[a] & sentence_sets[b])[:2]:
                duplicated.append(f"{a} == {b}: {sentence[:90]}")
    if len(sentence_sets.get(RULES, ())) < RULES_MIN_NORMATIVE_SENTENCES:
        ref_problems.append(f"{RULES} carries {len(sentence_sets.get(RULES, ()))} normative sentences "
                            f"(< {RULES_MIN_NORMATIVE_SENTENCES})")
    check("f2_agents_claude_and_role_skills_reference_regler_md_and_the_plan_without_duplicating_a_normative_sentence",
          not ref_problems and not duplicated,
          f"normative={sum(len(v) for v in sentence_sets.values())} problems={ref_problems[:6]} "
          f"duplicated={duplicated[:4]}"[:900])
    fr = text(FULL_ROADMAP)
    fr_authority = next((fr[s:e] for h, s, e in sections(fr) if h.startswith("## Authority")), "")
    check("f2_full_roadmap_authority_section_binds_plan_generation_and_paths_and_names_agents_md_without_old_commit",
          bool(plan_generation) and "PLAN_GENERATION=" + str(plan_generation) in fr_authority
          and "ROADMAP_PLAN_PATH=" + PLAN_GEN in fr_authority and "ROADMAP_HANDOFF_PATH=" + HANDOFF_GEN in fr_authority
          and AGENTS in fr_authority and "HUMAN_AUTHORITY_HARD_STOP" in fr and not scan(fr, OLD_PLAN_TOKENS),
          f"plan_generation={plan_generation!r} authority_section_len={len(fr_authority)} old={fmt_hits(scan(fr, OLD_PLAN_TOKENS), 3)}")
    sub_base, sub_head = base_bytes(SUBSTITUTION, HISTORICAL_BASE), text(SUBSTITUTION)
    problems = []
    if sub_base is None:
        problems.append("no base")
    else:
        def numbered(txt):
            out = {}
            for h, s, e in sections(txt):
                m = re.match(r"^## (\d+)\.", h)
                if m:
                    out[int(m.group(1))] = txt[s:e]
            return out
        base_secs, head_secs = numbered(sub_base.decode("utf-8", "replace")), numbered(sub_head)
        for n in (1, 2, 3, 4, 5, 7, 8, 9, 10, 11, 13):
            # A section ends at the next heading or EOF; only trailing whitespace may differ (a new §14 follows §13).
            if base_secs.get(n) is None or (head_secs.get(n) or "").rstrip() != base_secs[n].rstrip():
                problems.append(f"§{n} changed or missing")
        for n in (6, 12):
            if head_secs.get(n) is None:
                problems.append(f"§{n} missing")
        amendment = [h for h, s, e in sections(sub_head)
                     if re.search(r"2026-09-10|v1\.1|(?i:amendment|tillägg|ändring)", h) and AGENTS in sub_head[s:e]]
        if not amendment:
            problems.append("no dated amendment section naming AGENTS.md")
        # v3: a later amendment (§15+, v1.2) binds the preamble's plan authority to the platform plan generation.
        generation_amendment = [n for n, body in head_secs.items() if n >= 15 and PLAN_GEN in body and AGENTS in body
                                and re.search(r"2026-09-10|v1\.2", body.split("\n", 1)[0])]
        if not generation_amendment:
            problems.append("no §15+ amendment (heading dated 2026-09-10 or v1.2) naming the plan generation and AGENTS.md")
        preamble = next((sub_head[s:e] for h, s, e in sections(sub_head) if h == ""), "")
        if scan(preamble, OLD_PLAN_TOKENS):
            problems.append("preamble still names the pre-platform plan: " + fmt_hits(scan(preamble, OLD_PLAN_TOKENS), 2))
    check("f2_substitution_contract_sections_1_5_7_11_13_unchanged_dated_amendment_and_plan_generation_amendment_present",
          not problems, str(problems)[:600])
    for rel, markers in HISTORICAL_NOTE_DOCS.items():
        base = base_bytes(rel, HISTORICAL_BASE)
        current = (subject / rel).read_bytes()
        block = None
        if base is not None and current != base:
            if current.endswith(base):
                block = current[:len(current) - len(base)].decode("utf-8", "replace")
            elif current.startswith(base):
                block = current[len(base):].decode("utf-8", "replace")
        problems = []
        if block is None:
            problems.append("document is not <base bytes> plus exactly one added header or appended note")
        else:
            problems += [f"note lacks {m}" for m in ("2026-09-10", AGENTS) + tuple(markers) if not re.search(m, block)]
            problems += [f"note carries web token {p}@{l}" for p, l, _ in scan(block, WEB_TOKENS + OLD_PLAN_TOKENS + COMMIT_READ_TOKENS)[:3]]
            problems += [f"note carries owner-stop token {p}@{l}" for p, l, _ in scan(block, HARD_HUMAN_TOKENS)[:3]]
        check("f2_historical_document_unchanged_plus_dated_supersession_note_" + label_of(rel), not problems, str(problems)[:600])
    drift_base, drift_head = base_bytes(DRIFT, HISTORICAL_BASE), (subject / DRIFT).read_bytes()
    active = scannable_text(DRIFT) or ""
    problems = []
    if drift_base is None or not drift_head.startswith(drift_base) or drift_head == drift_base:
        problems.append("drift.md is not append-only vs " + HISTORICAL_BASE[:8] + " with an appended block")
    if not active or DRIFT_ACTIVE_HEADING.search(active) is None:
        problems.append("appended tail carries no '## Aktiv plattformsnot' heading")
    else:
        problems += [f"tail lacks {m}" for m in ("2026-09-10", AGENTS, r"§\s*5\b", re.escape(PLAN_GEN)) if not re.search(m, active)]
        problems += [f"{p}@{l}" for p, l, _ in scan(active, WEB_TOKENS + HUMAN_TOKENS + OLD_PLAN_TOKENS + COMMIT_READ_TOKENS)[:4]]
    check("f2_drift_md_append_only_whole_tail_scanned_with_active_platform_note_naming_plan_generation", not problems, str(problems)[:600])

    # ------------------------------------------------------------------ F3: config and permission rules
    denied = spec_obj.get("defaults", {}).get("denied_write", []) if spec_strict else []
    try:
        premiar = strict((subject / PREMIAR).read_bytes())
        premiar_denied = premiar.get("defaults", {}).get("denied_write")
        premiar_hits = scan(text(PREMIAR), WEB_TOKENS + HUMAN_TOKENS)
        premiar_ok = spec_strict and premiar_denied == denied and not premiar_hits and "docs/05" not in text(PREMIAR) \
            and type(premiar.get("tasks")) is list and len(premiar["tasks"]) >= 2
        detail = f"denied={premiar_denied} spec={denied} hits={fmt_hits(premiar_hits, 4)}"
    except ValueError as exc:
        premiar_ok, detail = False, repr(exc)
    check("f3_premiar_backlog_denied_write_equals_spec_denied_write_and_no_web_docs", premiar_ok, detail)
    try:
        managed = strict((subject / MANAGED).read_bytes())
        deny = managed["permissions"]["deny"]
        deny_write = managed["sandbox"]["filesystem"]["denyWrite"]
        problems = []
        for entry in deny + deny_write:
            if "/Users/elinhaggstrom/nortropic" in entry and PLATFORM_ROOT not in entry:
                problems.append("not platform root: " + entry)
        problems += [f"web token {p}: {x}" for p, l, x in scan(text(MANAGED), EXEC_WEB_TOKENS + (r"(?<![\w./-])agents/", r"(?<![\w./-])skills/"))[:4]]
        problems += [f"old root: {x}" for p, l, x in scan(text(MANAGED), (OLD_ROOT_RE.pattern,))[:4]]
        for pattern in denied:
            core = pattern[:-3] if pattern.endswith("/**") else pattern
            if f"Edit(/{PLATFORM_ROOT}{pattern})" not in deny:
                problems.append("Edit deny missing for " + pattern)
            if f"{PLATFORM_ROOT}{core}" not in deny_write:
                problems.append("denyWrite missing for " + core)
        if f"Edit(/{PLATFORM_ROOT}{REGISTER})" not in deny or f"{PLATFORM_ROOT}{REGISTER}" not in deny_write:
            problems.append("register not denied")
        if managed["sandbox"].get("enabled") is not True or managed["sandbox"]["network"].get("strictAllowlist") is not True:
            problems.append("sandbox/network hardening changed")
        managed_ok = spec_strict and bool(denied) and not problems
        detail = str(problems)[:600]
    except (ValueError, KeyError, TypeError) as exc:
        managed_ok, detail = False, repr(exc)
    check("f3_managed_settings_source_uses_platform_root_denies_platform_set_and_register_no_web_paths", managed_ok, detail)
    ignore_problems = []
    for rel in NOT_IGNORED:
        if git_raw(subject, probe_env, "check-ignore", "--no-index", "-q", "--", rel).returncode == 0:
            ignore_problems.append("ignored: " + rel)
    for rel in IGNORED:
        if git_raw(subject, probe_env, "check-ignore", "--no-index", "-q", "--", rel).returncode != 0:
            ignore_problems.append("not ignored: " + rel)
    check("f3_gitignore_effect_platform_paths_trackable_web_paths_ignored", not ignore_problems, str(ignore_problems)[:600])
    gi = text(".gitignore")
    stale = []
    for m in re.finditer(r"^!/([^*\n]+?)/?\s*$", gi, re.M):
        rel = m.group(1)
        if rel in tracked or any(t.startswith(rel + "/") for t in tracked):
            continue
        stale.append(rel)
    check("f3_gitignore_whitelists_no_absent_tree", not stale and not GITIGNORE_WEB_WHITELIST.search(gi),
          f"stale={stale} web_whitelist={bool(GITIGNORE_WEB_WHITELIST.search(gi))}")
    try:
        register = strict((subject / REGISTER).read_bytes())
        verifiers = register["verifiers"]
        entry = verifiers.get("check-invariants", {})
        version = SEMVER.match(str(register.get("register_version", "")))
        note_text = json.dumps({k: v for k, v in register.items() if k != "verifiers"}, ensure_ascii=False) \
            + json.dumps([v.get("beskrivning") for v in verifiers.values()], ensure_ascii=False)
        hits = scan(note_text, WEB_TOKENS + HUMAN_TOKENS + (r"(?<![\w./-])workflows/",))
        register_ok = (version is not None and tuple(int(g) for g in version.groups()) > (1, 0, 0) and not hits
                       and entry.get("path") == VERIFIER and entry.get("sha256") == CHECK_INVARIANTS_SHA
                       and sha((subject / VERIFIER).read_bytes()) == CHECK_INVARIANTS_SHA
                       and all(v.get("startbar") is True for v in verifiers.values()))
        detail = f"version={register.get('register_version')} hits={fmt_hits(hits, 4)} entry_sha={str(entry.get('sha256'))[:12]}"
    except (ValueError, KeyError, TypeError, AttributeError) as exc:
        register_ok, detail = False, repr(exc)
    check("f3_register_note_free_of_human_hand_and_web_gate_version_bumped_check_invariants_sha_unchanged", register_ok, detail)
    verify_text = text(VERIFY_CLI)
    pin_spec = re.search(r'^PLATFORM_SPEC\s*=\s*"([0-9a-f]{64})"', verify_text, re.M)
    pin_register = re.search(r'^PLATFORM_REGISTER\s*=\s*"([0-9a-f]{64})"', verify_text, re.M)
    documents = cli_consts.get("PLATFORM_DOCUMENTS", {})
    problems = []
    if pin_spec is None or pin_spec.group(1) != sha((subject / SPEC).read_bytes()):
        problems.append("PLATFORM_SPEC")
    if pin_register is None or pin_register.group(1) != sha((subject / REGISTER).read_bytes()):
        problems.append("PLATFORM_REGISTER")
    if type(documents) is not dict or not (set(GENERATION_DOCS) | {PLAN_GEN, HANDOFF_GEN}) <= set(documents):
        problems.append("PLATFORM_DOCUMENTS key set (eleven generation documents + plan generation + handoff)")
    else:
        for rel, digest in documents.items():
            if rel not in tracked or sha((subject / rel).read_bytes()) != digest:
                problems.append("PLATFORM_DOCUMENTS " + rel)
    check("f3_verify_cli_pins_equal_candidate_spec_register_every_generation_document_and_the_plan_generation", not problems, str(problems))
    spec_base_oid = git_raw(subject, probe_env, "rev-parse", f"{FROZEN_BASE}:{SPEC}").stdout.strip()
    check("f3_spec_byte_identical_to_" + FROZEN_BASE[:8] + "_this_contract_requires_no_spec_change",
          bool(spec_base_oid) and head_oid(SPEC) == spec_base_oid, f"head={head_oid(SPEC)} base={spec_base_oid}")
    rep, rep_env = replica(bench, "candidate", subject, head)
    rep_tmp = bench.tmp("candidate")
    r = run([rep / VERIFY_CLI, "preflight"], scratch, rep_env)
    register_sha = sha((rep / REGISTER).read_bytes())
    check("f3_preflight_exit0_exact_json_with_candidate_register_digest",
          json_ok(r) == {"status": "ok", "register_sha256": register_sha}, (r.stdout + r.stderr)[-300:])
    r = run([NODE, rep / VERIFIER], rep, rep_env, timeout=300)
    check("f3_check_invariants_6_pass_0_fail_in_candidate_replica",
          r.returncode == 0 and re.search(r"^6 PASS, 0 FAIL, 0 overtradelser$", r.stdout, re.M) is not None,
          (r.stdout + r.stderr)[-300:])
    psnap = rep_tmp / "platform-snapshot"
    spec_sha = sha((rep / SPEC).read_bytes())
    r = run([rep / VERIFY_CLI, "platform-prepare", spec_sha, "h-035", register_sha, psnap], scratch, rep_env)
    obj = json_ok(r)
    accept_ok, detail = False, (r.stdout + r.stderr)[-300:]
    obj_snapshot_sha = "0" * 64
    if obj and obj.get("status") == "ok" and SHA256_FORM.fullmatch(str(obj.get("snapshot_sha256"))):
        obj_snapshot_sha = obj["snapshot_sha256"]
        c = run([rep / VERIFY_CLI, "platform-check", spec_sha, "h-035", register_sha, obj["snapshot_sha256"], psnap], scratch, rep_env)
        accept_ok = json_ok(c) == {"status": "ok", "snapshot_sha256": obj["snapshot_sha256"]}
        detail = (c.stdout + c.stderr)[-300:]
    check("f3_platform_prepare_and_check_accept_candidate_documents_in_replica", accept_ok, detail)

    # ------------------------------------------------------------------ F4: autopilot/loop function without old root or origin branch
    try:
        defaults = argparse_defaults(autopilot_source)
        bad = {opt: vals for opt, vals in defaults.items()
               if any(OLD_ROOT_RE.search(v) or OLD_ROOT_REL_RE.match(v) or "nortropic/nortropic-system" in v for v in vals)}
        check("f4_autopilot_argparse_defaults_do_not_point_at_old_root", "--repo" in defaults and not bad,
              f"repo_default_strings={defaults.get('--repo')} bad={bad}")
    except SyntaxError as exc:
        check("f4_autopilot_argparse_defaults_do_not_point_at_old_root", False, repr(exc))
    hits = scan(autopilot_source, EXEC_WEB_TOKENS)
    check("f4_autopilot_source_no_web_document_reference", not hits and bool(autopilot_source), fmt_hits(hits))
    # --- plan generation: the two files at HEAD are the plan; the autopilot binds exactly their HEAD blobs.
    plan_problems = []
    expected_plan_blobs = {}
    for rel in (PLAN_GEN, HANDOFF_GEN):
        mode, oid = tracked_entries.get(rel, (None, None))
        if oid is None or mode != "100644" or not (subject / rel).is_file() or (subject / rel).is_symlink():
            plan_problems.append(f"{rel}: not a tracked regular 100644 file ({mode} {oid})")
        expected_plan_blobs[rel] = oid
    if not consts:
        plan_problems.append("driver constants unavailable: " + consts_detail)
    else:
        if consts.get("plan_path") != PLAN_GEN or consts.get("handoff_path") != HANDOFF_GEN:
            plan_problems.append(f"autopilot paths: {consts.get('plan_path')} {consts.get('handoff_path')}")
        if consts.get("plan_blobs") != expected_plan_blobs:
            plan_problems.append(f"autopilot ROADMAP_PLAN_BLOBS {consts.get('plan_blobs')} != HEAD {expected_plan_blobs}")
    check("f4_plan_generation_files_tracked_100644_and_autopilot_paths_and_blobs_equal_head", not plan_problems, str(plan_problems)[:600])
    check("f4_autopilot_has_plan_generation_constant_and_no_roadmap_plan_sha_attribute",
          bool(consts) and consts.get("has_plan_sha") is False and type(plan_generation) is str and plan_generation.strip() != "",
          f"has_plan_sha={consts.get('has_plan_sha')} plan_generation={plan_generation!r} {consts_detail if not consts else ''}")
    # v3.5 (review v9 N2/N3): the plan constants are single literal assignments whose runtime values equal the literals, and
    # the two roadmap tuples keep their own identities (emptying SUBSTITUTION_ROADMAP into ROADMAP is refused).
    problems = []
    try:
        literals = literal_constant_assignments(autopilot_source, SINGLE_LITERAL_CONSTANTS)
    except SyntaxError as exc:
        literals, _ = {}, problems.append(repr(exc))
    for name in SINGLE_LITERAL_CONSTANTS:
        count, value, issues = literals.get(name, (0, None, ["not assigned at module level"]))
        if count != 1:
            problems.append(f"{name}: {count} module-level assignments (exactly one expected)")
        problems += issues[:2]
    # v3.6 (review v10 B1(b)/N8): all seven constants are compared against their literals; `ROADMAP_PLAN_BLOBS`'s literal
    # uses the two path constants as keys, so it is resolved with the measured literals before the comparison.
    for name, key in sorted(RUNTIME_CONSTANT_KEYS.items()):
        value, literal = consts.get(key), literals.get(name, (0, None, []))[1]
        if value is None or literal is None:
            if name == "ROADMAP_PLAN_BLOBS" and consts.get("plan_blobs") is not None:
                blob_literal = literal_dict_with_path_keys(autopilot_source, name,
                                                           {"ROADMAP_PLAN_PATH": literals.get("ROADMAP_PLAN_PATH", (0, None, []))[1],
                                                            "ROADMAP_HANDOFF_PATH": literals.get("ROADMAP_HANDOFF_PATH", (0, None, []))[1]})
                if blob_literal is not None and blob_literal != consts["plan_blobs"]:
                    problems.append(f"{name}: runtime differs from the literal")
            continue
        if isinstance(literal, (list, tuple)):
            literal = [list(x) if isinstance(x, (list, tuple)) else x for x in literal]
        if isinstance(literal, dict):
            literal = {k: (list(v) if isinstance(v, (list, tuple)) else v) for k, v in literal.items()}
        if literal != value:
            problems.append(f"{name}: runtime {str(value)[:60]!r} != literal {str(literal)[:60]!r}")
    if consts:
        if list(consts.get("substitution_codes") or []) != list(EXPECTED_SUBSTITUTION_CODES):
            problems.append(f"SUBSTITUTION_ROADMAP codes {consts.get('substitution_codes')} != {list(EXPECTED_SUBSTITUTION_CODES)}")
        road = list(consts.get("roadmap_codes") or [])
        if not road or road[0] != EXPECTED_FIRST_ROADMAP_CODE:
            problems.append(f"ROADMAP[0] {road[:1]} != [{EXPECTED_FIRST_ROADMAP_CODE!r}]")
        if set(consts.get("substitution_codes") or []) & set(road):
            problems.append("SUBSTITUTION_ROADMAP and ROADMAP overlap")
    check("f4_plan_constants_are_single_literal_assignments_equal_at_runtime_and_the_two_roadmap_tuples_keep_their_identities",
          not problems, str(problems)[:900])
    r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, rep, "roadmap_plan"], ap_cwd, ap_env, timeout=300)
    obj = driver_outcome(r)
    check("f4_ensure_roadmap_plan_returns_in_replica_without_any_remote",
          bool(obj) and obj["outcome"] == "returned" and git_raw(rep, rep_env, "remote").stdout.strip() == "",
          (r.stdout + r.stderr)[-400:])
    if not plan_problems:
        mut, mut_env = replica(bench, "plan-mutated", subject, head)
        plan_bytes = (mut / PLAN_GEN).read_bytes()
        overlay(mut, mut_env, {PLAN_GEN: (plan_bytes.replace(b"\n", b"\n<!-- LOCAL mutation -->\n", 1), 0o644)},
                message="LOCAL fixture: mutated plan generation")
        r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, mut, "roadmap_plan"], ap_cwd, ap_env, timeout=300)
        obj = driver_outcome(r)
        check("f4_ensure_roadmap_plan_stops_on_mutated_plan_generation", bool(obj) and obj["outcome"] == "stop", (r.stdout + r.stderr)[-300:])
        gone, gone_env = replica(bench, "plan-missing", subject, head)
        overlay(gone, gone_env, {}, removals=(HANDOFF_GEN,), message="LOCAL fixture: handoff removed")
        r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, gone, "roadmap_plan"], ap_cwd, ap_env, timeout=300)
        obj = driver_outcome(r)
        check("f4_ensure_roadmap_plan_stops_on_missing_handoff", bool(obj) and obj["outcome"] == "stop", (r.stdout + r.stderr)[-300:])
        # v3.6 (review v10 N5): mutate the plan AND every other tracked file carrying the same bytes, so a guard that
        # compares against a tracked copy instead of ROADMAP_PLAN_BLOBS no longer sees a difference and must still Stop.
        # v3.7 (review v11 N4): the v3.6 denominator was BYTE-IDENTICAL tracked copies — measured EMPTY on the baseline, so
        # the row took the else branch, reused the previous run's `obj` and proved nothing; and a guard anchored to a tracked
        # DIGEST manifest evaded it. The mutation now runs in its own replica and updates EVERY tracked anchor of the plan
        # to the mutated plan: byte copies are rewritten, and the plan's sha256 and blob OID are replaced with the new
        # values wherever they appear as text, in place and with the file's own mode. A guard that compares the plan with a
        # tracked copy, a tracked digest or a tracked OID therefore sees no difference at all and must still Stop, because
        # the only authority that changed is ROADMAP_PLAN_BLOBS. The anchor count is reported so vacuity stays visible.
        amut, amut_env = replica(bench, "plan-anchors", subject, head)
        plan_blob, plan_digest = head_oid(PLAN_GEN), sha(plan_bytes)
        anchor_plan = (amut / PLAN_GEN).read_bytes().replace(b"\n", b"\n<!-- LOCAL mutation -->\n", 1)
        overlay(amut, amut_env, {PLAN_GEN: (anchor_plan, 0o644)}, message="LOCAL fixture: mutated plan for the anchor sweep")
        new_digest = sha(anchor_plan)
        new_oid = git(amut, amut_env, "rev-parse", "HEAD:" + PLAN_GEN)
        copies = {}
        for rel, (mode, oid) in sorted(tracked_entries.items()):
            f = amut / rel
            if rel == PLAN_GEN or not f.is_file() or f.is_symlink():
                continue
            try:
                body = f.read_bytes()
            except OSError:
                continue
            if oid == plan_blob:
                copies[rel] = (anchor_plan, 0o755 if mode.endswith("755") else 0o644)
            elif plan_digest.encode() in body or plan_blob.encode() in body:
                copies[rel] = (body.replace(plan_digest.encode(), new_digest.encode()).replace(plan_blob.encode(), new_oid.encode()),
                               0o755 if mode.endswith("755") else 0o644)
        if copies:
            overlay(amut, amut_env, copies, message="LOCAL fixture: every tracked plan anchor updated to the mutated plan")
        r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, amut, "roadmap_plan"], ap_cwd, ap_env, timeout=300)
        obj = driver_outcome(r)
        check("f4_ensure_roadmap_plan_stops_when_the_plan_and_every_tracked_copy_are_mutated_together",
              bool(obj) and obj["outcome"] == "stop",
              f"anchors={len(copies)} {sorted(copies)[:4]} " + (r.stdout + r.stderr)[-260:])
        # v3.7 (review v11 N4): and the guard must actually READ ROADMAP_PLAN_BLOBS — repin the constant in the imported
        # module and require Stop on an UNMUTATED replica. A guard anchored to a tracked digest manifest returns here.
        r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, rep, "roadmap_plan_repinned"], ap_cwd, ap_env, timeout=300)
        obj = driver_outcome(r)
        check("f4_ensure_roadmap_plan_reads_the_pinned_plan_blobs_measured_by_repinning_them_in_the_imported_module",
              bool(obj) and obj["outcome"] == "stop", (r.stdout + r.stderr)[-300:])
        hmut, hmut_env = replica(bench, "handoff-mutated", subject, head)
        handoff_bytes = (hmut / HANDOFF_GEN).read_bytes()
        overlay(hmut, hmut_env, {HANDOFF_GEN: (handoff_bytes + b"\n<!-- LOCAL mutation -->\n", 0o644)}, message="LOCAL fixture: mutated handoff")
        r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, hmut, "roadmap_plan"], ap_cwd, ap_env, timeout=300)
        obj = driver_outcome(r)
        check("f4_ensure_roadmap_plan_stops_on_mutated_handoff", bool(obj) and obj["outcome"] == "stop", (r.stdout + r.stderr)[-300:])
        # v3.2 (N3): the verify-cli pin of the plan generation measured IN EFFECT — prepare refuses a mutated plan in the
        # replica, check refuses a snapshot whose plan was mutated after prepare (both exact DOCUMENT_GENERATION refusals).
        mut_tmp = bench.tmp("plan-mutated-cli")
        mut_register_sha = sha((mut / REGISTER).read_bytes())
        r = run([mut / VERIFY_CLI, "platform-prepare", sha((mut / SPEC).read_bytes()), "h-035", mut_register_sha, mut_tmp / "snap"], scratch, mut_env)
        check("f3_platform_prepare_refuses_mutated_plan_generation_in_replica", json_refusal(r) == "DOCUMENT_GENERATION",
              (r.stdout + r.stderr)[-300:])
        hmut_tmp = bench.tmp("handoff-mutated-cli")
        r = run([hmut / VERIFY_CLI, "platform-prepare", sha((hmut / SPEC).read_bytes()), "h-035", sha((hmut / REGISTER).read_bytes()), hmut_tmp / "snap"], scratch, hmut_env)
        check("f3_platform_prepare_refuses_mutated_handoff_in_replica", json_refusal(r) == "DOCUMENT_GENERATION", (r.stdout + r.stderr)[-300:])
        snap_plan = psnap / PLAN_GEN
        if accept_ok and snap_plan.is_file():
            original = snap_plan.read_bytes()
            snap_plan.write_bytes(original + b"\n<!-- LOCAL mutation -->\n")
            c = run([rep / VERIFY_CLI, "platform-check", spec_sha, "h-035", register_sha, obj_snapshot_sha, psnap], scratch, rep_env)
            snap_plan.write_bytes(original)
            check("f3_platform_check_refuses_snapshot_whose_plan_generation_was_mutated_after_prepare",
                  json_refusal(c) == "DOCUMENT_GENERATION", (c.stdout + c.stderr)[-300:])
        else:
            check("f3_platform_check_refuses_snapshot_whose_plan_generation_was_mutated_after_prepare", False,
                  "positive not established (prepare not accepted or plan absent from snapshot)")
    else:
        for label in ("f4_ensure_roadmap_plan_stops_on_mutated_plan_generation", "f4_ensure_roadmap_plan_stops_on_missing_handoff",
                      "f4_ensure_roadmap_plan_stops_on_mutated_handoff",
                      "f4_ensure_roadmap_plan_stops_when_the_plan_and_every_tracked_copy_are_mutated_together",
                      "f4_ensure_roadmap_plan_reads_the_pinned_plan_blobs_measured_by_repinning_them_in_the_imported_module",
                      "f3_platform_prepare_refuses_mutated_plan_generation_in_replica",
                      "f3_platform_prepare_refuses_mutated_handoff_in_replica",
                      "f3_platform_check_refuses_snapshot_whose_plan_generation_was_mutated_after_prepare"):
            check(label, False, "positive not established (plan generation missing or unbound)")
    # --- no commit-SHA plan authority anywhere in the autopilot (full text incl. comments/docstrings, and AST strings)
    old_hits = scan(autopilot_source, OLD_PLAN_TOKENS + (GIT_SHOW_COMMIT_RE, PLAN_SHA_RE))
    try:
        old_hits += [(pat, line, value[:60]) for line, value in code_strings(autopilot_source)
                     for pat in OLD_PLAN_TOKENS + (GIT_SHOW_COMMIT_RE, PLAN_SHA_RE) if re.search(pat, value)]
    except SyntaxError as exc:
        old_hits.append(("parse", 0, repr(exc)))
    check("f4_autopilot_source_free_of_old_plan_commit_git_show_by_commit_and_plan_sha", not old_hits and bool(autopilot_source),
          fmt_hits(old_hits))
    # --- every prompt-building function's injected document set is exactly the declared platform set
    try:
        prompt_sets, builders, callers = prompt_document_sets(autopilot_source)
    except SyntaxError as exc:
        prompt_sets, builders, callers = {}, set(), set()
    injected = set().union(*prompt_sets.values()) if prompt_sets else set()
    marker_builders = {name for name in builders if any(PROMPT_MARK in v for v in
                       [c.value for c in ast.walk(next(n for n in ast.walk(ast.parse(autopilot_source))
                                                          if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name == name))
                        if isinstance(c, ast.Constant) and isinstance(c.value, str)])} if builders else set()
    problems = []
    if len(marker_builders) < 9 or len(builders) < 12:
        problems.append(f"too few prompt builders found: marker={len(marker_builders)} all={len(builders)}")
    problems += [f"required document not injected by any prompt: {rel}" for rel in sorted(PROMPT_DOCS_REQUIRED - injected)]
    problems += [f"undeclared document injected: {rel} by {sorted(n for n, s in prompt_sets.items() if rel in s)[:3]}"
                 for rel in sorted(injected - PROMPT_DOCS_ALLOWED)]
    problems += [f"injected document not tracked: {rel}" for rel in sorted(injected) if rel not in tracked]
    problems += [f"injected document neither scanned nor blob-pinned: {rel}" for rel in sorted(injected)
                 if rel in tracked and rel not in scanned and rel not in GENERATION_DOCS]
    check("f4_prompt_functions_ast_literals_inject_only_the_declared_platform_document_set_all_tracked_and_scanned", not problems,
          f"builders={sorted(builders)} callers={sorted(callers)} injected={sorted(injected)} problems={problems}"[-1100:])
    # --- v3.1 (review v5 B3): the PRODUCED prompts. The driver imports the real module and CALLS every prompt builder with
    # fixture arguments (every real RoadmapSlice, both remediation roles, both refrozen values); the produced text is measured.
    # v3.2 (N5): builders run in a contained fixture — own HOME/XDG/TMPDIR, empty cwd, GIT_DIR on an empty bare repo, proxies
    # pointed at a closed local port; any file created or changed under the fixture, or under the subject tree, is a FAIL.
    prompts_root = bench.tmp("prompts")
    for d in ("home", "xdg", "cwd", "tmp"):
        (prompts_root / d).mkdir(mode=0o700)
    git(prompts_root, probe_env, "init", "--quiet", "--bare", f"--template={bench.template}", str(prompts_root / "gitdir"))
    prompts_env = bench.env(prompts_root / "tmp", extra={
        "HOME": str(prompts_root / "home"), "XDG_CONFIG_HOME": str(prompts_root / "xdg"), "GIT_DIR": str(prompts_root / "gitdir"),
        "http_proxy": "http://127.0.0.1:9", "https_proxy": "http://127.0.0.1:9", "HTTP_PROXY": "http://127.0.0.1:9",
        "HTTPS_PROXY": "http://127.0.0.1:9", "ALL_PROXY": "http://127.0.0.1:9", "no_proxy": "", "NO_PROXY": ""})
    # v3.11 (rig fix): the sweep covers what THIS GATE created — the contained fixture root and the subject tree.
    # v3.4-v3.10 also diffed the top-level entries of /private/tmp, /private/tmp/claude, /private/tmp/claude-501,
    # $TMPDIR and its parent. Those are shared with every other process on the host: a second interactive session
    # creating its own temp directory produced a FALSE RED twice while all four process counters were identical.
    # A false red blocks every future qualification, so it is itself a defect. What this no longer catches is
    # declared in the development document (Vad grinden inte bevisar).
    before_fixture, before_subject = snapshot_tree(prompts_root), snapshot_tree(subject, skip_git=True)
    module_alias = "m" + hashlib.sha256(os.urandom(16)).hexdigest()[:12]
    r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, canary_repo, "prompts", module_alias], prompts_root / "cwd", prompts_env, timeout=300)
    after_fixture, after_subject = snapshot_tree(prompts_root), snapshot_tree(subject, skip_git=True)
    side_effects = sorted(set(after_fixture.items()) ^ set(before_fixture.items())) + \
        sorted("subject:" + k for k in set(after_subject.items()) ^ set(before_subject.items()) for k in [k[0]])
    produced = driver_outcome(r)
    produced = produced if produced and produced["outcome"] == "returned" and type(produced.get("texts")) is dict else {}
    texts, perrors, pbuilders = produced.get("texts", {}), produced.get("errors", {}), produced.get("builders", [])
    pflows = produced.get("flows", [])
    check("f4_prompt_builders_run_in_contained_fixture_without_side_effects",
          bool(produced) and not side_effects, f"side_effects={side_effects[:8]} produced={bool(produced)}")
    # v3.5 (review v9 B1): importing the real module must not rebind the process's exec surface — neither the autopilot's
    # module level nor anything it imports at start-up (controller/authority/core.py) may shadow subprocess.Popen.
    form_problems = []
    try:
        form_problems += module_level_form(autopilot_source)
        form_problems += exec_surface_assignments(autopilot_source)
    except SyntaxError as exc:
        form_problems.append(f"autopilot does not parse: {exc!r}")
    if produced.get("popen_identity") is not True:
        form_problems.append("an exec-surface primitive was rebound by importing the autopilot (module level or an imported library)")
    # v3.6 (review v10 N3): the authority library on sys.path is the pinned one — AST identity of the constant and the file
    # the imported `core` module actually came from.
    try:
        lib_ids = ast_identities(autopilot_source, ("AUTHORITY_LIB",))
    except SyntaxError:
        lib_ids = {}
    if lib_ids.get("AUTHORITY_LIB") != AUTHORITY_LIB_AST_SHA256:
        form_problems.append("AUTHORITY_LIB assignment differs from the 320c9df7 identity")
    core_file = produced.get("core_module_file")
    if not core_file or Path(core_file).resolve() != (subject / AUTHORITY_LIB_DIR / "core.py").resolve():
        form_problems.append(f"imported authority library is not {AUTHORITY_LIB_DIR}/core.py: {core_file}")
    # v3.9 (review v13 B1): the autopilot may not name the gate's own namespace. Measured on 320c9df7: no hit.
    form_problems += [f"autopilot@{line} reaches the gate's namespace: {pat}"
                      for pat, line, _v in scan(autopilot_source, GATE_NAMESPACE_TOKENS)[:3]]
    check("f4_autopilot_module_and_class_bodies_are_the_declared_form_no_exec_surface_rebinding_anywhere_and_the_pinned_authority_library",
          not form_problems, str(form_problems)[:900])
    dep_problems = []
    for rel, expected in sorted(RUNNER_DEPENDENCY_BLOBS.items()):
        actual = head_oid(rel)
        if actual != expected:
            dep_problems.append(f"{rel}: {actual} != {expected}")
    check("f4_runner_dependencies_authority_and_launch_byte_identical_to_320c9df7", not dep_problems, str(dep_problems)[:600])
    argv_problems = []
    try:
        for node in ast.walk(ast.parse(autopilot_source)):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                popen_calls = [c for c in ast.walk(node) if isinstance(c, ast.Call) and isinstance(c.func, ast.Attribute)
                               and c.func.attr == "Popen"]
                markers = [v.value for v in ast.walk(node) if isinstance(v, ast.Constant) and isinstance(v.value, str)
                           and any(mk in v.value for mk in PROVIDER_ARGV_STATIC_MARKERS)]
                if node.name != PROVIDER_ARGV_FUNCTION and (popen_calls or markers):
                    argv_problems.append(f"{node.name}: provider start or argv marker outside {PROVIDER_ARGV_FUNCTION}")
                if node.name == PROVIDER_ARGV_FUNCTION and len(popen_calls) != 1:
                    argv_problems.append(f"{PROVIDER_ARGV_FUNCTION}: {len(popen_calls)} Popen calls (exactly one expected)")
    except SyntaxError as exc:
        argv_problems.append(repr(exc))
    check("f4_provider_argv_built_and_started_in_exactly_one_place_inside_run_codex", not argv_problems, str(argv_problems)[:600])
    try:
        producers, referrers, runner_problems, reachable, stray, guard_callers = prompt_world(autopilot_source)
    except SyntaxError as exc:
        producers, referrers, runner_problems, reachable, stray, guard_callers = set(), set(), [f"autopilot does not parse: {exc!r}"], set(), [], set()
    problems = []
    problems += [f"stray prompt material: {s}" for s in stray]
    problems += [f"dynamic stray prompt material: {s}" for s in produced.get("stray", [])]
    if set(pbuilders) != set(EXPECTED_PROMPT_BUILDERS):
        problems.append(f"builder set differs: extra={sorted(set(pbuilders) - EXPECTED_PROMPT_BUILDERS)} missing={sorted(EXPECTED_PROMPT_BUILDERS - set(pbuilders))}")
    if set(pflows) != set(EXPECTED_PROMPT_FLOWS):
        problems.append(f"flow set differs: {sorted(pflows)}")
    problems += [f"unexpected prompt producer: {n}" for n in sorted(producers - EXPECTED_PROMPT_BUILDERS - EXPECTED_PROMPT_FLOWS)]
    problems += [f"unexpected function references a prompt builder: {n}" for n in sorted(referrers - EXPECTED_PROMPT_BUILDERS - EXPECTED_PROMPT_CALLERS)]
    problems += [f"runner prompt not sourced from an expected builder: {p}" for p in runner_problems]
    problems += [f"prompt builder unreachable from main(): {n}" for n in sorted(EXPECTED_PROMPT_BUILDERS - reachable)]
    check("f4_prompt_builders_flows_and_callers_are_the_closed_expected_sets_every_runner_prompt_sourced_and_every_builder_live",
          not problems and bool(produced), f"problems={problems}"[-1100:])
    # v3.3 (review v7 B2): the plan guard is CALLED by exactly the expected flows/commands, all reachable from main().
    problems = []
    if guard_callers != set(EXPECTED_PLAN_GUARD_CALLERS):
        problems.append(f"guard callers differ: extra={sorted(guard_callers - EXPECTED_PLAN_GUARD_CALLERS)} missing={sorted(EXPECTED_PLAN_GUARD_CALLERS - guard_callers)}")
    problems += [f"guard caller unreachable from main(): {n}" for n in sorted(EXPECTED_PLAN_GUARD_CALLERS - reachable)]
    check("f4_ensure_roadmap_plan_called_from_exactly_the_expected_guard_callers_all_reachable_from_main", not problems and bool(autopilot_source),
          str(problems)[:600])
    # v3.3/v3.4 (review v7/v8 B1 dynamic): the real flows run against replicas with the runner STUBBED. The stub records every
    # prompt and answers a synthetic READY report so each flow runs to completion through reviewer/remediation/publication stubs;
    # every capture is measured (plan + handoff where the role requires it, no old pointers / commit reads / web / owner-stop
    # tokens anywhere), and each flow must reach at least its measured minimum number of runner calls.
    live, live_env = replica(bench, "live-flows", subject, head)
    git(live, live_env, "update-ref", "refs/remotes/origin/main", head)
    # v3.5 (review v9 N4): the same side-effect sweep surrounds the live flows (they run far more product code than `prompts`).
    # v3.7 (review v11 N8): the sweep also covers the subject's `.git/` (refs, hooks, config, top-level entries) and the
    # gate's own FIXTURE_ROOT recursively, minus the two paths the flows legitimately own (the live replica they are given
    # as a repository, and the driver's TMPDIR). Both were measured blind spots: a flow helper wrote real files in each.
    # v3.10 (review v14 N5/B3): the stub log is NOT exempt. It is written by the stubs, which run as the product's own
    # children, and the product can write and delete there — measured. Its expected growth is bounded by the chain check
    # below, so ordinary stub writes are accounted for by `stub_log_expected` instead of by an exemption.
    fixture_skip = (str(live.relative_to(scratch)), str(ap_tmp.relative_to(scratch)))
    before_live_subject = snapshot_tree(subject, skip_git=True)
    before_live_git, before_live_fixture = snapshot_git_meta(subject), snapshot_fixture(scratch, fixture_skip)
    r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, live, "live_flows"], ap_cwd, stub_env, timeout=1800)
    stub_calls = read_stub_calls(stub_log, stub_nonce)
    after_live_subject = snapshot_tree(subject, skip_git=True)
    after_live_git, after_live_fixture = snapshot_git_meta(subject), snapshot_fixture(scratch, fixture_skip)
    live_side_effects = sorted("subject:" + k[0] for k in set(after_live_subject.items()) ^ set(before_live_subject.items())) + \
        sorted("subject/.git:" + k[0] for k in set(after_live_git.items()) ^ set(before_live_git.items())) + \
        sorted("fixture:" + k[0] for k in set(after_live_fixture.items()) ^ set(before_live_fixture.items())
               if not STUB_LOG_ENTRY.match(k[0]))
    live_out = driver_outcome(r)
    live_flows = live_out.get("flows", {}) if live_out and live_out["outcome"] == "returned" else {}
    problems = []
    if not live_out or live_out["outcome"] != "returned":
        problems.append("live driver unavailable: " + (r.stdout + r.stderr)[-200:])
    problems += [f"closed-world name missing in the autopilot: {n}" for n in (live_out or {}).get("missing_names", [])]
    for flow in LIVE_FLOWS:
        res = live_flows.get(flow)
        if not res:
            problems.append(f"{flow}: not run")
            continue
        caps = res.get("captures", [])
        if res.get("outcome") != "returned":
            problems.append(f"{flow}: did not complete ({res.get('outcome')}: {str(res.get('message', ''))[:140]})")
        if len(caps) < LIVE_MIN_CAPTURES[flow]:
            problems.append(f"{flow}: {len(caps)} runner calls < expected minimum {LIVE_MIN_CAPTURES[flow]}")
        for i, c in enumerate(caps):
            p = c.get("prompt", "")
            if c.get("role") in LIVE_PLAN_ROLES[flow] and (PLAN_GEN not in p or HANDOFF_GEN not in p):
                problems.append(f"{flow}#{i + 1} {c.get('role')}: live prompt lacks plan/handoff")
            # v3.7 (review v11 B2): this sweep belongs in the loop. v3.6 indented it into the FIXTURE-1 branch below, so it
            # ran only after that requirement had already failed — never on a green product — and then only on the `p` left
            # over from the last iteration, while `architect_resolution` and `empirical_unattended_flow` were never swept
            # at all. EVERY captured prompt in EVERY flow is scanned here (canaries: ten per-flow negatives).
            problems += [f"{flow}#{i + 1} {c.get('role')}: live prompt carries {pat}"
                         for pat, l, x in scan(p, OLD_PLAN_TOKENS + COMMIT_READ_TOKENS + CODE_WEB_TOKENS + CODE_HUMAN_TOKENS)[:2]]
        # v3.6 (review v10 N4): the remediation position must carry the reviewer's findings, not just another ordinary
        # prompt — the stub's finding id is rendered into the remediation prompt by `remediation_prompt`.
        if flow in LIVE_REMEDIATION_FLOWS and not any(LIVE_FINDING_ID in c.get("prompt", "") for c in caps):
            problems.append(f"{flow}: no captured prompt carries the reviewer finding {LIVE_FINDING_ID}")
    check("f4_live_flows_run_to_completion_through_the_stubbed_runner_every_prompt_naming_plan_and_handoff_where_required_and_free_of_old_pointers",
          not problems, f"captures={ {k: len(v.get('captures', [])) for k, v in live_flows.items()} } problems={problems}"[-1200:])
    # v3.5 (review v9 B1 dynamic): with the runner stubbed, no provider process may be started at all — every Popen during the
    # flows is recorded and any provider-shaped start whose last argument is not one of the captured prompts is a bypass.
    problems = []
    if not live_out or live_out["outcome"] != "returned":
        problems.append("live driver unavailable")
    else:
        if live_out.get("provider_starts"):
            problems.append(f"provider processes started outside the stubbed runner: {live_out.get('provider_starts')}")
        problems += [f"unmatched provider prompt: {x}" for x in live_out.get("provider_starts_unmatched", [])[:2]]
        if live_out.get("popen_identity") is not True:
            problems.append("an exec-surface primitive was rebound by importing the autopilot")
        # v3.6 (review v10 B1): the instrumentation must still be installed when the flows are done — a product that
        # rebinds subprocess.Popen from a function body uninstalls the recorder and would otherwise look clean.
        if live_out.get("popen_identity_after") is not True:
            problems.append("an exec-surface primitive was rebound during the flows (the recorder is no longer installed)")
        # v3.7 (review v11 B1(c)): measure what actually reaches the child. `Popen._execute_child` is the real start, so a
        # start made through a class captured at import shows up here even though the module attribute never changed, and an
        # argv rewritten below the Popen-level recorder no longer matches the argv the recorder saw.
        if live_out.get("child_total") != live_out.get("popen_total"):
            problems.append(f"child starts {live_out.get('child_total')} != recorded Popen starts {live_out.get('popen_total')}")
        # v3.8 (review v12 B1(b)): the aggregate equality above is balanceable; these two are not. `child_unrecorded`
        # names every child start made while no recorded Popen call was on the stack, and `child_argv_rewritten` now
        # compares argv as a MULTISET. `import_time_starts` reports what the product started while it was being imported,
        # which is only visible because the recorders are installed before `exec_module`.
        problems += [f"child start outside any recorded Popen call: {x}" for x in (live_out.get("child_unrecorded") or [])[:2]]
        problems += [f"argv rewritten between Popen and the child: {x}" for x in (live_out.get("child_argv_rewritten") or [])[:2]]
        if live_out.get("import_time_starts") or live_out.get("import_time_children"):
            problems.append(f"the autopilot started {live_out.get('import_time_starts')} process(es) while being imported")
        problems += [f"the child process received an unexpected argv: {x}" for x in (live_out.get("child_starts_unexpected") or [])[:2]]
        unexpected_child = sorted(set(live_out.get("child_binaries") or []) - ALLOWED_LIVE_BINARIES - {""})
        if unexpected_child:
            problems.append(f"child processes ran unexpected binaries: {unexpected_child[:4]}")
        # v3.9 (review v13 B1): a recorder on the Popen CLASS's own __init__ sees every instantiation of the real class,
        # whichever reference to it the caller used — including one recovered from the driver's namespace.
        if live_out.get("init_total") != live_out.get("popen_total"):
            problems.append(f"Popen instantiations {live_out.get('init_total')} != recorded starts {live_out.get('popen_total')}")
        problems += [f"Popen instantiated outside any recorded call: {x}" for x in (live_out.get("init_unrecorded") or [])[:2]]
        problems += [f"the instrumentation was not installed at a recorded start: {x}" for x in (live_out.get("identity_violations") or [])[:2]]
        # v3.9 (review v13 B2): identity, not basename. Every executed file is resolved to its realpath and hashed.
        bad_identity = [f"{p}:{h[:12]}" for p, h in (live_out.get("start_identities") or []) if h not in ALLOWED_START_SHA]
        if bad_identity:
            problems.append(f"processes started from unmeasured binaries: {bad_identity[:3]}")
        # v3.9 (review v13 B2/3): old-plan pointers in argv, in the child's env, and in the STDIN the child receives.
        problems += [f"a started process carries an old-plan pointer: {x}" for x in (live_out.get("old_pointer_starts") or [])[:2]]
        # v3.10 (review v14 B2): stdin in any channel, a private PATH in `env=`, inherited fds and git-as-launcher.
        unexpected_stdin = sorted(set(live_out.get("stdin_forms") or []) - {"none", "devnull"})
        if unexpected_stdin:
            problems.append(f"processes were started with stdin attached: {unexpected_stdin}")
        if live_out.get("private_env_paths"):
            problems.append(f"a start carried its own PATH in env=: {live_out.get('private_env_paths')}")
        if live_out.get("git_launcher_starts"):
            problems.append(f"git was used as a launcher: {live_out.get('git_launcher_starts')}")
        # The out-of-process half: the PATH stubs logged every start the product resolved by name, with stdin content.
        stub_problems = []
        for call in stub_calls:
            stub_text = " ".join(call["argv"]) + " " + call["stdin"]
            hits = scan(stub_text, OLD_PLAN_TOKENS + COMMIT_READ_TOKENS)
            stub_problems += [f"{call['name']} start carries {pat}" for pat, _l, _x in hits[:2]]
            if any(mark in call["stdin"] for mark in PROVIDER_SHAPE_ELEMENTS + PROVIDER_SHAPE_BINARY_TOKENS):
                stub_problems.append(f"{call['name']} start carries a provider marker on stdin")
            if call["name"] not in ALLOWED_LIVE_TOOLS and call["name"] not in ALLOWED_LIVE_WRAPPERS:
                stub_problems.append(f"unexpected tool resolved through PATH: {call['name']}")
        problems += stub_problems[:3]
        unexpected_binaries = sorted(set(live_out.get("start_binaries") or []) - ALLOWED_LIVE_BINARIES - {""})
        if unexpected_binaries:
            problems.append(f"processes started with unexpected binaries: {unexpected_binaries[:4]}")
        unexpected_primitives = sorted(set(live_out.get("start_primitives") or []) - ALLOWED_LIVE_PRIMITIVES)
        if unexpected_primitives:
            problems.append(f"processes started through unexpected primitives: {unexpected_primitives[:4]}")
    problems += [f"side effect during live flows: {x}" for x in live_side_effects[:6]]
    check("f4_live_flows_start_no_provider_process_outside_the_stubbed_runner_and_leave_no_side_effects",
          not problems, f"popen_total={(live_out or {}).get('popen_total')} child_total={(live_out or {}).get('child_total')} "
                        f"init_total={(live_out or {}).get('init_total')} stub_calls={len(stub_calls)} "
                        f"identities={len(live_out.get('start_identities') or []) if live_out else 0} "
                        f"problems={problems}"[-900:])
    live_green = live_out
    # v3.10 (review v14 B1(c)/B3(c)): THE row that ties the two halves together. Under v3.9 nothing compared them, so a
    # product could silence the in-process recorders (measured: 5 against 333) or delete stub log entries (333 -> 328)
    # without any row reacting. All four counters must agree with each other and with the out-of-process log, the log's
    # HMAC chain must be unbroken and its numbering contiguous, the recording containers must be the ones installed, and
    # every counter must clear the measured minimum.
    problems = []
    if not live_out or live_out["outcome"] != "returned":
        problems.append("live driver unavailable")
    else:
        # The PATH stubs can only see starts that resolve a BARE name; a start with a directory in argv[0] bypasses PATH
        # by construction and is bound by the in-process half and by the realpath/sha256 identity instead. The denominator
        # is therefore the bare-name starts, and the three in-process counters must agree with each other.
        counters = {"stub_calls": len(stub_calls), "bare_name_starts": live_out.get("bare_name_starts"),
                    "popen_total": live_out.get("popen_total"),
                    "init_total": live_out.get("init_total"), "child_total": live_out.get("child_total")}
        closure = live_out.get("closure_counts") or []
        if counters["stub_calls"] != counters["bare_name_starts"]:
            problems.append(f"the two halves disagree: stub log has {counters['stub_calls']} entries, "
                            f"the recorders saw {counters['bare_name_starts']} starts that resolve a bare name")
        if len({counters["popen_total"], counters["init_total"], counters["child_total"]}) != 1:
            problems.append(f"the in-process recorders disagree: {counters}")
        if len(closure) == 4 and [closure[0], closure[1], closure[2]] != [counters["popen_total"], counters["child_total"], counters["init_total"]]:
            problems.append(f"closure counters {closure[:3]} differ from the recorded lists {[counters['popen_total'], counters['child_total'], counters['init_total']]}")
        if live_out.get("recorder_integrity"):
            problems.append(f"the recording containers were replaced: {live_out.get('recorder_integrity')}")
        if any(counters[k] is None or counters[k] < LIVE_MIN_PROCESS_STARTS
               for k in ("stub_calls", "bare_name_starts", "popen_total", "init_total", "child_total")):
            problems.append(f"process starts below the measured minimum {LIVE_MIN_PROCESS_STARTS}: {counters}")
        broken = [c["seq"] for c in stub_calls if not c["chain_ok"]][:3]
        if broken:
            problems.append(f"stub log entries with a broken HMAC: {broken}")
        seqs = [c["seq"] for c in stub_calls if c["seq"] is not None]
        if len(seqs) != len(stub_calls) or seqs != list(range(1, len(seqs) + 1)):
            problems.append(f"stub log numbering is not contiguous: {len(seqs)} entries, "
                            f"max={max(seqs) if seqs else 0}, missing={sorted(set(range(1, (max(seqs) if seqs else 0) + 1)) - set(seqs))[:5]}")
    check("f4_live_flows_out_of_process_stub_log_and_in_process_recorders_agree_with_an_unbroken_chain",
          not problems, f"stub_calls={len(stub_calls)} bare={(live_out or {}).get('bare_name_starts')} "
                        f"popen={(live_out or {}).get('popen_total')} "
                        f"init={(live_out or {}).get('init_total')} child={(live_out or {}).get('child_total')} "
                        f"closure={(live_out or {}).get('closure_counts')} problems={problems}"[-900:])
    livemut, livemut_env = replica(bench, "live-flows-mutated", subject, head)
    if PLAN_GEN in tracked and (livemut / PLAN_GEN).is_file():
        overlay(livemut, livemut_env, {PLAN_GEN: ((livemut / PLAN_GEN).read_bytes() + b"\n<!-- LOCAL mutation -->\n", 0o644)},
                message="LOCAL fixture: mutated plan for live flows")
    git(livemut, livemut_env, "update-ref", "refs/remotes/origin/main", git(livemut, livemut_env, "rev-parse", "HEAD"))
    r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, livemut, "live_flows"], ap_cwd, ap_env, timeout=900)
    # v3.8 (review v12 N1): this is the MUTATED run; v3.7 assigned it back to `live_out`, so `result.json` serialised the
    # mutated counters under `live_*` while the row details carried the green run's — the whole "59 vs 333" discrepancy.
    live_mut_out = driver_outcome(r)
    mut_flows = live_mut_out.get("flows", {}) if live_mut_out and live_mut_out["outcome"] == "returned" else {}
    problems = [] if mut_flows else ["live driver unavailable: " + (r.stdout + r.stderr)[-200:]]
    if PLAN_GEN not in tracked:
        problems.append("plan generation missing (positive not established)")
    for flow in LIVE_GUARDED_FLOWS:
        res = mut_flows.get(flow)
        if not res:
            problems.append(f"{flow}: not run")
        elif res.get("outcome") != "stop" or res.get("captures"):
            problems.append(f"{flow}: did not stop before the runner ({res.get('outcome')}, captured={len(res.get('captures', []))})")
    check("f4_live_flows_stop_before_the_stubbed_runner_on_mutated_plan_generation", not problems, f"problems={problems}"[-1100:])
    # v3.4 (review v8 B2): the provider machinery is untouched — normalised AST identity with the platform autopilot at 320c9df7.
    try:
        ids = ast_identities(autopilot_source, tuple(RUNNER_MACHINERY_AST_SHA256))
    except SyntaxError:
        ids = {}
    drift = [f"{n}: {'missing' if n not in ids else 'changed'}" for n, digest in RUNNER_MACHINERY_AST_SHA256.items() if ids.get(n) != digest]
    check("f4_runner_machinery_ast_identical_to_320c9df7_provider_machinery_untouched", not drift and bool(autopilot_source), str(drift)[:600])
    problems = []
    if not produced:
        problems.append("prompt driver unavailable: " + (r.stdout + r.stderr)[-200:])
    for name in REQUIRED_PLAN_PROMPT_BUILDERS:
        if name not in pbuilders:
            problems.append(name + ": not found as a prompt builder")
            continue
        keys = [k for k in texts if k == name or k.startswith(name + "[")]
        raised = [k for k in perrors if k == name or k.startswith(name + "[")]
        if raised:
            problems.append(f"{name}: raised {perrors[raised[0]]}")
        if not keys:
            problems.append(name + ": produced no text")
        problems += [f"{k}: lacks plan/handoff" for k in keys if PLAN_GEN not in texts[k] or HANDOFF_GEN not in texts[k]]
    check("f4_produced_prompts_of_roadmap_empirical_and_architect_builders_name_plan_generation_and_handoff_for_every_slice_and_role",
          not problems and len(texts) >= 20, f"builders={len(pbuilders)} texts={len(texts)} problems={problems}"[-1100:])
    problems, produced_docs = [], set()
    for k, t in sorted(texts.items()):
        problems += [f"{k}@{l} {p}: {x}" for p, l, x in scan(t, OLD_PLAN_TOKENS + COMMIT_READ_TOKENS + CODE_WEB_TOKENS + CODE_HUMAN_TOKENS)[:2]]
        for m_ in PATH_RE.finditer(t):
            c = clean_candidate(m_.group(1))
            if c.startswith("docs/") and "." in c.rsplit("/", 1)[-1]:
                produced_docs.add(c)
        for m_ in ROOT_DOC_RE.finditer(t):
            produced_docs.add(m_.group(1))
    problems += [f"builder raised: {k}: {e}" for k, e in sorted(perrors.items())]
    problems += [f"required document in no produced prompt: {rel}" for rel in sorted(PROMPT_DOCS_REQUIRED - produced_docs)]
    problems += [f"undeclared document in a produced prompt: {rel}" for rel in sorted(produced_docs - PROMPT_DOCS_ALLOWED)]
    problems += [f"produced-prompt document not tracked: {rel}" for rel in sorted(produced_docs) if rel not in tracked]
    problems += [f"produced-prompt document neither scanned nor blob-pinned: {rel}" for rel in sorted(produced_docs)
                 if rel in tracked and rel not in scanned and rel not in GENERATION_DOCS]
    check("f4_produced_prompts_free_of_old_plan_pointers_commit_reads_web_and_owner_stop_tokens_and_inject_only_declared_tracked_documents",
          bool(produced) and not problems and len(texts) >= 20, f"texts={len(texts)} docs={sorted(produced_docs)} problems={problems}"[-1100:])
    # --- the plan's machine-readable slice table equals the autopilot's roadmap tuples and selftest's exact sets
    problems = []
    spec_rows = {t.get("id"): t for t in spec_obj.get("tasks", []) if type(t) is dict} if spec_strict else {}
    table = None
    if PLAN_GEN in tracked and (subject / PLAN_GEN).is_file():
        table, why = parse_slice_table(text(PLAN_GEN))
        if table is None:
            problems.append(why)
    else:
        problems.append("plan generation missing")
    if not consts or type(consts.get("roadmap")) is not list:
        problems.append("autopilot roadmap unavailable")
    if table is not None and consts and type(consts.get("roadmap")) is list:
        autop = {row[0]: row for row in consts["roadmap"]}
        table_rows = {r[0]: r for r in table}
        if len(table_rows) != len(table):
            problems.append("duplicate slice codes in table")
        expected_codes = set(autop) | set(PLAN_HISTORICAL_SLICES) | {PLAN_PROGRAM_SLICE}
        if set(table_rows) != expected_codes:
            problems.append(f"slice set {sorted(set(table_rows) ^ expected_codes)} differs (table vs autopilot+S1/S3/L)")
        all_tasks = {row[1] for row in autop.values()}
        for code, (slice_code, task, gate, allowed, deps, status) in sorted(table_rows.items()):
            if status not in (PLAN_STATUS_BUILT, PLAN_STATUS_UNBUILT):
                problems.append(f"{code}: status {status!r}")
                continue
            if (gate in tracked) != (status == PLAN_STATUS_BUILT):
                problems.append(f"{code}: status {status} but gate tracked={gate in tracked} ({gate})")
            if code in autop:
                _, a_task, a_gate, a_allowed, a_deps = autop[code]
                if task != a_task or gate != a_gate or set(allowed) != set(a_allowed) or set(deps) != set(a_deps):
                    problems.append(f"{code}: table ({task},{gate},{sorted(allowed)},{sorted(deps)}) != autopilot ({a_task},{a_gate},{sorted(a_allowed)},{sorted(a_deps)})")
            elif code in PLAN_HISTORICAL_SLICES:
                s_row = spec_rows.get(PLAN_HISTORICAL_SLICES[code], {})
                if task != PLAN_HISTORICAL_SLICES[code] or gate != s_row.get("exit_test") or allowed \
                        or set(deps) != set(s_row.get("depends_on") or []) or status != PLAN_STATUS_BUILT:
                    problems.append(f"{code}: built slice must equal spec row {PLAN_HISTORICAL_SLICES[code]} (task, exit_test, depends_on), no write surface, {PLAN_STATUS_BUILT}")
            else:  # L
                if task not in ("", "-", "—", "–") or gate != consts.get("empirical_gate_path") or allowed or set(deps) != all_tasks:
                    problems.append(f"{code}: program gate row must be (-, {consts.get('empirical_gate_path')}, -, all roadmap tasks)")
            if task in spec_rows and spec_rows[task].get("exit_test") != gate:
                problems.append(f"{code}: exit_test {gate} != spec row {task} exit_test {spec_rows[task].get('exit_test')}")
        # v3.4 (review v8 N): the table's row order for the autopilot's slices equals SUBSTITUTION_ROADMAP + ROADMAP order (S2 first
        # in ROADMAP, the fixture slice of h-032/governance), and every dependency that is another table row comes earlier.
        table_order = [r[0] for r in table if r[0] in autop]
        if table_order != [row[0] for row in consts["roadmap"]]:
            problems.append(f"table order {table_order} != autopilot order {[row[0] for row in consts['roadmap']]}")
        if consts["roadmap"] and [row[0] for row in consts["roadmap"] if not row[0].startswith("SUB-")][:1] != ["S2"]:
            problems.append("ROADMAP[0] is not S2")
        task_pos = {r[1]: i for i, r in enumerate(table)}
        for i, r in enumerate(table):
            later = [d for d in r[4] if d in task_pos and task_pos[d] >= i]
            if later:
                problems.append(f"{r[0]}: depends on later or same row {later}")
        exact = selftest_exact_sets(autopilot_source)
        st = dict(exact.get("sub_exact", {}))
        st.update(exact.get("road_exact", {}))
        if not st or set(st) != set(autop):
            problems.append(f"selftest exact sets cover {sorted(st)} vs autopilot {sorted(autop)}")
        for code, (s_task, s_gate) in sorted(st.items()):
            if code in table_rows and (table_rows[code][1], table_rows[code][2]) != (s_task, s_gate):
                problems.append(f"{code}: selftest exact ({s_task},{s_gate}) != table")
    check("f4_plan_generation_slice_table_equals_autopilot_roadmap_tuples_and_selftest_exact_sets", not problems, str(problems)[:1100])
    plan_visible_for_boot = visible_markdown(text(PLAN_GEN)) if PLAN_GEN in tracked and (subject / PLAN_GEN).is_file() else ""
    boot = "".join(plan_visible_for_boot[s:e] for h, s, e in sections(plan_visible_for_boot) if re.search(r"(?i)bootstrap", h))
    missing_ids = [f"h-0{n}" for n in range(31, 40) if not re.search(rf"\bh-0{n}\b", boot)]
    check("f4_plan_generation_bootstrap_section_names_h031_to_h039_as_platform_establishment", bool(boot) and not missing_ids,
          f"section_len={len(boot)} missing={missing_ids}")
    plan_visible = visible_markdown(text(PLAN_GEN)) if PLAN_GEN in tracked and (subject / PLAN_GEN).is_file() else ""
    plan_sections = [(h, plan_visible[s:e]) for h, s, e in sections(plan_visible) if h]
    missing_sections = [label for pattern, label in PLAN_REQUIRED_SECTIONS
                        if not any(re.search(pattern, h) and len([l for l in body.splitlines()[1:] if l.strip()]) >= 3 for h, body in plan_sections)]
    check("f4_plan_generation_has_required_sections_syfte_malbild_skydd_skivtabell_bootstrap_arbetsflode_avslutskriterier",
          bool(plan_visible) and not missing_sections, f"headings={len(plan_sections)} missing={missing_sections}")
    # v3.10 (owner decision 2026-09-11) B1-B4: the four measurable exit levels, the finite bootstrap handover point,
    # the goal picture's own identification of needs, and H039's preserved functional requirement.
    def plan_section(pattern):
        return "".join(body for h, body in plan_sections if re.search(pattern, h))

    exit_section = plan_section(r"(?i)avslutskriteri")
    level_problems = []
    for label, patterns in PLAN_EXIT_LEVELS:
        missing = [p for p in patterns if not re.search(p, exit_section)]
        if missing:
            level_problems.append(f"{label}: {missing}")
    check("f4_plan_generation_avslutskriterier_carry_the_four_measurable_levels_planseparation_trust_kernel_bootstrap_milestone_and_later_operational_whole",
          bool(exit_section) and not level_problems, f"len={len(exit_section)} problems={level_problems}"[:900])
    missing_handover = [p for p in PLAN_BOOTSTRAP_HANDOVER if not re.search(p, boot)]
    check("f4_plan_generation_bootstrap_names_a_finite_handover_point_to_qualified_autonomous_operation",
          bool(boot) and not missing_handover, f"len={len(boot)} missing={missing_handover}")
    malbild = plan_section(r"(?i)målbild")
    missing_malbild = [p for p in PLAN_MALBILD_AUTONOMY if not re.search(p, malbild)]
    check("f4_plan_generation_malbild_carries_self_identified_needs_within_goal_and_mandate_and_web_as_a_business_using_the_platform",
          bool(malbild) and not missing_malbild, f"len={len(malbild)} missing={missing_malbild}")
    invariants = plan_section(r"(?i)(skyddade\s+invarianter|tekniska\s+skydd)")
    missing_h039 = [p for p in PLAN_H039_REQUIREMENT if not re.search(p, invariants)]
    check("f4_plan_generation_preserves_h039_functional_requirement_zero_runtime_residues_and_no_loss_of_foreign_data",
          bool(invariants) and not missing_h039, f"len={len(invariants)} missing={missing_h039}")
    # the handoff's pins live in fenced text blocks that readers see; only HTML comments are removed here
    handoff_visible = re.sub(r"<!--.*?-->", "", text(HANDOFF_GEN), flags=re.S) if HANDOFF_GEN in tracked and (subject / HANDOFF_GEN).is_file() else ""
    handoff_sections = [(h, handoff_visible[s:e]) for h, s, e in sections(handoff_visible) if h]
    missing_handoff = [label for pattern, label in HANDOFF_REQUIRED_SECTIONS
                       if not any(re.search(pattern, h) and len([l for l in body.splitlines()[1:] if l.strip()]) >= 2 for h, body in handoff_sections)]
    handoff_problems = list(missing_handoff)
    if PLAN_GEN not in handoff_visible:
        handoff_problems.append("handoff does not name the plan")
    if not plan_generation or ("PLAN_GENERATION" not in handoff_visible or str(plan_generation) not in handoff_visible):
        handoff_problems.append("handoff does not carry PLAN_GENERATION and its value")
    if HANDOFF_GEN in tracked and PLAN_GEN in tracked and head_oid(HANDOFF_GEN) == head_oid(PLAN_GEN):
        handoff_problems.append("handoff is byte-identical to the plan")
    check("f4_handoff_has_required_sections_syfte_pinnar_startordning_stoppregler_avslutskriterier_and_names_plan_and_generation",
          bool(handoff_visible) and not handoff_problems, f"headings={len(handoff_sections)} problems={handoff_problems}")
    skill_problems = []
    for rel in PLAN_SKILLS:
        if rel not in tracked:
            skill_problems.append(rel + ": missing")
            continue
        t = text(rel)
        skill_problems += [f"{rel}@{l} {p}" for p, l, _ in scan(t, SKILL_OLD_PLAN_TOKENS + OLD_PLAN_TOKENS)[:4]]
        if PLAN_GEN not in t:
            skill_problems.append(rel + ": does not name " + PLAN_GEN)
    check("f4_architect_and_empirical_runner_skills_name_plan_generation_and_no_plan_commit", not skill_problems, str(skill_problems)[:600])
    blobs = consts.get("substitution_blobs") if consts else None
    problems = []
    if type(blobs) is not dict or not set(GENERATION_DOCS) <= set(blobs):
        problems.append("SUBSTITUTION_BLOBS key set")
    else:
        problems += [f"{rel}: {oid} != {head_oid(rel)}" for rel, oid in blobs.items() if head_oid(rel) != oid]
    check("f4_autopilot_substitution_blobs_equal_head_blobs_of_generation_documents", not problems, str(problems)[:600])
    r = run([PYTHON, "-B", "-c", DRIVER_BOOT, driver_src, subject, rep, "selftest_none"], ap_cwd, ap_env, timeout=300)
    obj = driver_outcome(r)
    check("f4_autopilot_selftest_none_returns_pass_prints_plan_generation_and_no_plan_sha",
          bool(obj) and obj["outcome"] == "returned" and "AUTOPILOT_V4_SELFTEST=PASS" in r.stdout
          and type(plan_generation) is str and re.search(r"^PLAN_GENERATION=" + re.escape(plan_generation) + r"$", r.stdout, re.M) is not None
          and re.search(PLAN_SHA_RE, r.stdout) is None, (r.stdout + r.stderr)[-300:])
    r = run([PYTHON, "-B", rep / PUBLICATION_CALLERS], rep, ap_env, timeout=600)
    check("f4_autopilot_publication_callers_exit0", r.returncode == 0 and "traceback" not in (r.stdout + r.stderr).lower(),
          f"rc={r.returncode} " + (r.stdout + r.stderr)[-300:])
    check("f4_controller_loop_cli_unchanged_vs_" + FROZEN_BASE[:8],
          head_oid(LOOP_CLI) is not None and git_raw(subject, probe_env, "rev-parse", f"{FROZEN_BASE}:{LOOP_CLI}").stdout.strip() == head_oid(LOOP_CLI))

    # ------------------------------------------------------------------ F5: loop test suite without the web fixture
    hits = scan(text(LOOP_FALL), LOOP_FALL_WEB_TOKENS)
    check("f5_loop_fall_py_b2_no_web_fixture_or_web_invariant", not hits and "B2" in text(LOOP_FALL), fmt_hits(hits))
    if args.skip_held_gates:
        check("f5_loop_fall_py_green_in_replica", False, "skipped by --skip-held-gates")
    else:
        lf, lf_env = replica(bench, "loop-fall", subject, head)
        lf_env = bench.env(bench.tmp("loop-fall"))
        r = run([PYTHON, "-B", lf / LOOP_FALL], lf, lf_env, timeout=1200)
        oks = re.findall(r"^ok\s+(.*)$", r.stdout, re.M)
        fel = re.findall(r"^FEL\s+(.*)$", r.stdout, re.M)
        b2 = [l for l in oks if l.startswith("B2") and "PINV" in l]
        check("f5_loop_fall_py_green_in_replica",
              r.returncode == 0 and not fel and len(oks) >= 53 and b2 and r.stdout.rstrip().endswith("alla fall håller")
              and "traceback" not in (r.stdout + r.stderr).lower(),
              f"rc={r.returncode} ok={len(oks)} fel={fel[:3]} b2_pinv={len(b2)} " + r.stderr[-200:])

    # ------------------------------------------------------------------ F6: frozen evidence, refreeze declaration
    # A declaration byte-identical to the qualified base is inherited history, not a second refreeze.
    # Only a new declaration is parsed as this generation's one change; F6 still binds every H-gate to its base.
    decl_path = subject / REFREEZE_DECL
    decl_problems, declared, refreeze_paths = [], [], set()
    decl_raw = decl_path.read_bytes() if decl_path.is_file() and not decl_path.is_symlink() else None
    if (decl_raw is None) != (REFREEZE_DECL not in tracked):
        decl_problems.append(f"declaration present={decl_raw is not None} tracked={REFREEZE_DECL in tracked}")
    elif decl_raw is not None and decl_raw != base_bytes(REFREEZE_DECL):
        try:
            decl = strict(decl_raw)
        except ValueError as exc:
            decl, _ = None, decl_problems.append(f"declaration is not strict JSON: {exc}")
        if decl is not None:
            if type(decl) is not dict or set(decl) != {"contract", "refreezes"} \
                    or decl.get("contract") != REFREEZE_DECL_CONTRACT or type(decl.get("refreezes")) is not list:
                decl_problems.append("declaration shape: exactly {contract, refreezes} with the pinned contract string")
            else:
                entries = decl["refreezes"]
                # ORDERED: one frozen H gate per candidate. Two refreezes in one candidate is not an ordered refreeze,
                # and it is exactly the shape of "a declared refreeze that also quietly changes a second gate".
                if len(entries) != 1:
                    decl_problems.append(f"exactly one ordered refreeze per candidate, declared {len(entries)}")
                for entry in entries:
                    if type(entry) is not dict or set(entry) not in (REFREEZE_ENTRY_KEYS,
                                                                     REFREEZE_ENTRY_KEYS | REFREEZE_ENTRY_OPTIONAL_KEYS):
                        decl_problems.append(f"entry keys {sorted(entry) if type(entry) is dict else type(entry)}")
                        continue
                    rel = entry["path"]
                    if type(rel) is not str or not REFREEZE_GATE_RE.match(rel):
                        decl_problems.append(f"not a frozen H gate path: {rel!r}")
                        continue
                    if rel in (CONTROL_SET_GATE, LAUNCH_CWD_GATE, GOVERNANCE_GATE, GATE):
                        decl_problems.append(f"a held gate may not be refrozen: {rel}")
                        continue
                    if rel in refreeze_paths:
                        decl_problems.append(f"duplicate declaration: {rel}")
                        continue
                    base_raw = base_bytes(rel)
                    now_path = subject / rel
                    now_raw = now_path.read_bytes() if now_path.is_file() and not now_path.is_symlink() else None
                    if base_raw is None or now_raw is None or rel not in tracked:
                        decl_problems.append(f"{rel}: absent at {FROZEN_BASE[:8]} or not a tracked regular file here")
                        continue
                    refreeze_paths.add(rel)
                    declared.append(entry)
                    if entry["base_sha256"] != sha(base_raw):
                        decl_problems.append(f"{rel}: declared base sha256 is not the {FROZEN_BASE[:8]} object")
                    if entry["new_sha256"] != sha(now_raw):
                        decl_problems.append(f"{rel}: declared new sha256 is not the candidate's bytes")
                    if sha(base_raw) == sha(now_raw):
                        decl_problems.append(f"{rel}: declared refreeze changes nothing")
                    if stat.S_IMODE(now_path.lstat().st_mode) != 0o755:
                        decl_problems.append(f"{rel}: refrozen gate is not mode 755")
                    if type(entry["expected_pass"]) is not int or type(entry["expected_pass"]) is bool \
                            or entry["expected_pass"] < 1:
                        decl_problems.append(f"{rel}: expected_pass is not a positive integer")
                    if type(entry["reason"]) is not str or len(entry["reason"].strip()) < 20:
                        decl_problems.append(f"{rel}: no written reason")
                    # v3.12 (B1): retiring a base row label is allowed, but only named and motivated, and few.
                    retired = entry.get("retired_labels", {})
                    if type(retired) is not dict or not all(type(k) is str and type(v) is str for k, v in retired.items()):
                        decl_problems.append(f"{rel}: retired_labels must be a mapping label -> written reason")
                    else:
                        if len(retired) > REFREEZE_MAX_RETIRED_LABELS:
                            decl_problems.append(f"{rel}: {len(retired)} retired row labels exceeds the cap "
                                                 f"{REFREEZE_MAX_RETIRED_LABELS}; a refreeze that drops more of the "
                                                 f"base gate's checks is a rewrite and needs its own contract round")
                        decl_problems += [f"{rel}: retired label {label!r} has no written reason"
                                          for label, why in sorted(retired.items()) if len(why.strip()) < 20]
                    try:
                        ast.parse((decode_text(now_raw) or ""))
                    except SyntaxError as exc:
                        decl_problems.append(f"{rel}: the refrozen gate does not parse: {exc!r}")
    check("f6_refreeze_declaration_is_one_ordered_frozen_h_gate_with_matching_base_and_new_sha256",
          not decl_problems, f"declared={[e.get('path') for e in declared]} problems={decl_problems[:8]}")
    # v3.12 (review v15 B1): the per-gate content floor, derived from the BASE gate's own frozen bytes. No run and no
    # hand-written list: a refreeze must keep every row label the base gate declared, except the ones it DECLARES
    # retired, and must predict at least that many green rows.
    label_problems, label_counts = [], {}
    for entry in declared:
        rel = entry["path"]
        retired = entry.get("retired_labels") or {}
        retired = retired if type(retired) is dict else {}
        try:
            base_labels = gate_row_labels(decode_text(base_bytes(rel) or b"") or "")
            new_labels = gate_row_labels(decode_text((subject / rel).read_bytes()) or "")
        except (SyntaxError, ValueError) as exc:
            label_problems.append(f"{rel}: row labels not derivable: {exc!r}")
            continue
        floor = len(base_labels) - len(retired)
        missing = sorted(base_labels - new_labels - set(retired))
        not_in_base = sorted(set(retired) - base_labels)
        still_present = sorted(set(retired) & new_labels)
        label_counts[rel] = {"base": len(base_labels), "refrozen": len(new_labels),
                             "retired": sorted(retired), "floor": floor, "missing": len(missing)}
        if len(base_labels) < REFREEZE_MIN_BASE_LABELS:
            label_problems.append(f"{rel}: only {len(base_labels)} row labels derivable from the "
                                  f"{FROZEN_BASE[:8]} bytes; this contract cannot credit a refreeze of it")
        if missing:
            label_problems.append(f"{rel}: {len(missing)} base row label(s) dropped without a declared "
                                  f"retirement: {missing[:5]}")
        if not_in_base:
            label_problems.append(f"{rel}: retired labels that the base gate never had: {not_in_base[:5]}")
        if still_present:
            label_problems.append(f"{rel}: labels declared retired but still present in the refrozen gate: {still_present[:5]}")
        if type(entry["expected_pass"]) is int and type(entry["expected_pass"]) is not bool \
                and entry["expected_pass"] < floor:
            label_problems.append(f"{rel}: expected_pass {entry['expected_pass']} is below the per-gate floor {floor} "
                                  f"({len(base_labels)} base row labels minus {len(retired)} declared retirements)")
    check("f6_refreeze_keeps_every_base_row_label_except_the_declared_retirements",
          not label_problems, f"labels={label_counts} problems={label_problems[:6]}")
    # The added LINES of every declared refreeze are scanned; verify/** is otherwise frozen evidence and unscanned.
    added_hits, added_lines, exempted = [], 0, 0
    for entry in declared:
        rel = entry["path"]
        base_text = decode_text(base_bytes(rel) or b"") or ""
        now_text = decode_text((subject / rel).read_bytes()) or ""
        base_set = set(base_text.splitlines())
        try:
            bound = retirement_bound_lines(now_text)
        except (SyntaxError, ValueError):
            bound = set()          # unparseable is already red on the declaration row; exempt nothing here
        # v3.12 (review v15 N1): scanned per FILE line, with the full token set. A retirement identifier is exempt
        # only on a line that carries a retirement-BOUND string constant; everything else is red.
        for number, line in enumerate(now_text.splitlines(), 1):
            if line in base_set:
                continue
            added_lines += 1
            for pattern, _l, excerpt in scan(line, REFREEZE_ADDED_TOKENS_ALL):
                if pattern in REFREEZE_RETIREMENT_IDENTIFIERS and number in bound:
                    exempted += 1
                    continue
                added_hits.append(f"{rel}@{number} {pattern}: {excerpt}")
    check("f6_refreeze_added_lines_free_of_web_governance_human_hand_and_old_plan_tokens",
          not added_hits, f"added_lines={added_lines} retirement_bound_exempt={exempted} hits={added_hits[:6]}")
    # The qualification receipt: a declared refreeze is credited only against a recorded run of the refrozen gate ON
    # THIS CANDIDATE, supplied at qualification time (--refreeze-receipt).
    # v3.12 (review v15 B2): v3.11 ASSERTED that a receipt can never come from the tree and enforced nothing — an
    # UNTRACKED receipt inside the subject was credited (measured: 126/5, no new red). What is enforced now: a tracked
    # receipt is self-excluding (it cannot carry the sha of the commit it is part of), and a receipt path that
    # resolves inside the subject tree is REFUSED, tracked or not. What the receipt does and does not prove — and what
    # is left to the qualifier rather than to the gate — is written in the development document.
    receipts, receipt_problems = [], []
    for path in (args.refreeze_receipt or []):
        try:
            resolved = Path(path).resolve()
        except (OSError, RuntimeError) as exc:
            receipt_problems.append(f"{path}: unusable receipt path: {exc!r}")
            continue
        if resolved == subject or subject in resolved.parents:
            receipt_problems.append(f"{path}: a qualification receipt may not lie inside the subject tree")
            continue
        try:
            receipts.append((str(resolved), strict(resolved.read_bytes())))
        except (OSError, ValueError) as exc:
            receipt_problems.append(f"{path}: unreadable or not strict JSON: {exc!r}")
    by_gate = {}
    for source, obj in receipts:
        by_gate.setdefault(obj.get("gate") if type(obj) is dict else None, []).append((source, obj))
    for unexpected in sorted(k for k in by_gate if k not in refreeze_paths):
        receipt_problems.append(f"receipt for a gate this candidate does not declare: {unexpected!r}")
    for entry in declared:
        rel = entry["path"]
        found = by_gate.get(rel, [])
        if len(found) != 1:
            receipt_problems.append(f"{rel}: {len(found)} qualification receipts supplied, exactly one required")
            continue
        _source, obj = found[0]
        if type(obj) is not dict or set(obj) != REFREEZE_RECEIPT_KEYS or obj["contract"] != REFREEZE_RECEIPT_CONTRACT:
            receipt_problems.append(f"{rel}: receipt shape / contract string")
            continue
        out = obj["stdout"]
        if type(out) is not str or obj["stdout_sha256"] != sha(out.encode("utf-8")):
            receipt_problems.append(f"{rel}: the receipt's stdout does not match its own sha256")
            continue
        passes = len(re.findall(r"^PASS ", out, re.M))
        fails = len(re.findall(r"^FAIL ", out, re.M))
        if obj["subject_head"] != head:
            receipt_problems.append(f"{rel}: receipt names subject {obj['subject_head']!r}, not this candidate {head}")
        if obj["gate_sha256"] != entry["new_sha256"] or obj["gate_sha256"] != sha((subject / rel).read_bytes()):
            receipt_problems.append(f"{rel}: the receipt's gate sha256 is not this candidate's refrozen bytes")
        if obj["exit_code"] != 0 or fails or obj["fail_count"] != 0:
            receipt_problems.append(f"{rel}: the refrozen gate was not green on this candidate "
                                    f"(exit={obj['exit_code']} declared_fail={obj['fail_count']} FAIL lines={fails})")
        if passes != obj["pass_count"] or passes != entry["expected_pass"]:
            receipt_problems.append(f"{rel}: {passes} PASS lines in the receipt, receipt says {obj['pass_count']}, "
                                    f"the declaration predicted {entry['expected_pass']}")
        invocation = obj["invocation"]
        current_h036 = rel == "verify/bin/h-036-exit"
        canonical_current = [PYTHON, *REFREEZE_INVOCATION_FLAGS, str(subject / rel),
                             "--current-product", head]
        legacy_invocation_ok = type(invocation) is list and all(type(x) is str for x in invocation) \
            and PYTHON in invocation and set(REFREEZE_INVOCATION_FLAGS) <= set(invocation) \
            and bool(invocation) and Path(invocation[-1]).name == Path(rel).name
        if (current_h036 and invocation != canonical_current) \
                or (not current_h036 and not legacy_invocation_ok):
            receipt_problems.append(f"{rel}: the receipt's invocation is not the canonical pinned form: {invocation!r}")
    check("f6_declared_refreeze_is_qualified_by_a_receipt_bound_to_this_candidate_and_the_refrozen_bytes",
          not receipt_problems, f"declared={len(declared)} receipts={len(receipts)} problems={receipt_problems[:6]}")

    # ------------------------------------------------------------------ F6: frozen evidence by blob OID
    # (a) the exact SET of tracked paths under the frozen trees == base set + the declared additions (this gate);
    # (b) every file byte-frozen against the base EXCEPT the declared refreezes; an undeclared byte change stays red,
    # and a declaration of a file that did not change is red too.
    gate_path = subject / GATE
    gate_ok = gate_path.is_file() and not gate_path.is_symlink() and sha(gate_path.read_bytes()) == held[GATE] \
        and stat.S_IMODE(gate_path.lstat().st_mode) == 0o755
    path_problems, byte_problems, additions, removals = [], [], [], []
    expected_additions = []
    for tree_rel in FROZEN_TREES:
        base_entries = ls_tree(subject, probe_env, FROZEN_BASE, tree_rel)
        head_entries = ls_tree(subject, probe_env, "HEAD", tree_rel)
        if tree_rel == "verify" and GATE not in base_entries:
            expected_additions.append(GATE)
        for rel, entry in base_entries.items():
            if rel not in head_entries:
                removals.append(rel)
            elif head_entries[rel] != entry and not (rel == GATE and gate_ok):
                byte_problems.append(rel)
        additions += [rel for rel in head_entries if rel not in base_entries]
        if git_raw(subject, probe_env, "status", "--porcelain", "--untracked-files=no", "--", tree_rel).stdout.strip():
            path_problems.append(tree_rel + " (working tree differs from HEAD)")
    for rel in FROZEN_FILES:
        base_oid = git_raw(subject, probe_env, "rev-parse", f"{FROZEN_BASE}:{rel}").stdout.strip()
        if not base_oid:
            path_problems.append(rel + " (absent at " + FROZEN_BASE[:8] + ")")
        elif rel not in tracked:
            removals.append(rel)
        elif base_oid != head_oid(rel):
            byte_problems.append(rel)
        if git_raw(subject, probe_env, "status", "--porcelain", "--untracked-files=no", "--", rel).stdout.strip():
            path_problems.append(rel + " (working tree differs from HEAD)")
    check("f6_frozen_tree_paths_are_the_" + FROZEN_BASE[:8] + "_set_plus_this_gate_only",
          not path_problems and sorted(additions) == expected_additions and not removals and gate_ok,
          f"problems={path_problems[:10]} additions={sorted(additions)} removals={removals[:10]} gate_ok={gate_ok}")
    undeclared = sorted(set(byte_problems) - refreeze_paths)
    unchanged_declared = sorted(refreeze_paths - set(byte_problems))
    check("f6_frozen_tree_bytes_identical_to_" + FROZEN_BASE[:8] + "_except_the_declared_refreeze",
          not undeclared and not unchanged_declared,
          f"undeclared_byte_changes={undeclared[:10]} declared_but_unchanged={unchanged_declared}")
    ea_base, ea_head = base_bytes(EFTERARBETE, HISTORICAL_BASE), (subject / EFTERARBETE).read_bytes() if (subject / EFTERARBETE).is_file() else b""
    ea_added = ea_head[len(ea_base):].decode("utf-8", "replace") if ea_base is not None and ea_head.startswith(ea_base) else None
    ea_hits = scan(ea_added or "", WEB_TOKENS + HUMAN_TOKENS + OLD_PLAN_TOKENS + COMMIT_READ_TOKENS)
    check("f6_efterarbete_append_only_vs_" + HISTORICAL_BASE[:8] + "_with_scanned_addition",
          EFTERARBETE in tracked and ea_added is not None and not ea_hits, f"append_only={ea_added is not None} hits={fmt_hits(ea_hits, 4)}")
    held_identical = {}
    for rel in (CONTROL_SET_GATE, LAUNCH_CWD_GATE, GOVERNANCE_GATE):
        base_oid = git_raw(subject, probe_env, "rev-parse", f"{FROZEN_BASE}:{rel}").stdout.strip()
        actual = git_raw(subject, probe_env, "hash-object", "--", str(subject / rel)).stdout.strip()
        held_identical[rel] = bool(base_oid) and base_oid == actual and os.access(subject / rel, os.X_OK)
    check("f6_earlier_local_gates_identical_to_" + FROZEN_BASE[:8], all(held_identical.values()), str(held_identical))

    # ------------------------------------------------------------------ F7: earlier frozen local gates on the candidate
    def held_gate(rel, override):
        """The held copy: the subject's own copy when byte-identical to the base, else an override that is."""
        base_oid = git_raw(subject, probe_env, "rev-parse", f"{FROZEN_BASE}:{rel}").stdout.strip()
        if override is not None:
            p = override.resolve()
            if not p.is_file() or git_raw(subject, probe_env, "hash-object", "--", str(p)).stdout.strip() != base_oid:
                return None
            return p
        return (subject / rel) if held_identical.get(rel) else None

    gate_runs = {}

    def run_held(label, rel, override, timeout, judge):
        if args.skip_held_gates:
            check(label, False, "skipped by --skip-held-gates")
            return
        program = held_gate(rel, override)
        if program is None:
            check(label, False, "no held copy: neither the subject copy nor the given override is byte-identical to " + FROZEN_BASE[:8] + ":" + rel)
            return
        tmp = bench.tmp("held-" + Path(rel).name)
        r = run([PYTHON, "-B", program, "--subject", subject], scratch, bench.env(tmp), timeout=timeout)
        passes, fails, root = gate_rows(r.stdout)
        result = None
        if root is not None and (root / "result.json").is_file():
            try:
                result = strict((root / "result.json").read_bytes())
            except ValueError:
                result = None
        gate_runs[rel] = {"program": str(program), "program_sha256": sha(program.read_bytes()), "rc": r.returncode,
                          "pass": len(passes), "fail": len(fails), "fails": fails, "fixture_root": str(root),
                          "result_sha256": sha((root / "result.json").read_bytes()) if result is not None else None,
                          "stderr": r.stderr[-400:]}
        ok, detail = judge(r, passes, fails, result)
        check(label, ok, f"rc={r.returncode} pass={len(passes)} fail={len(fails)} " + detail + " " + r.stderr[-200:])

    def rows_by_label(result):
        return {row["label"]: row for row in result["rows"]} if result and type(result.get("rows")) is list else {}

    # Exact inherited H-gate drift comes only from the qualified FROZEN_BASE, never from the candidate's diff.
    # Add this generation's declared path; each held gate keeps its own immutable base and exact verdict rules.
    def base_oid_at(rev, rel):
        return git_raw(subject, probe_env, "rev-parse", f"{rev}:{rel}").stdout.strip()

    frozen_h_gates = {rel: oid for rel, (mode, oid) in ls_tree(subject, probe_env, FROZEN_BASE, "verify/bin").items()
                      if REFREEZE_GATE_RE.fullmatch(rel)}
    cs_inherited = {rel for rel, oid in frozen_h_gates.items() if base_oid_at(CONTROL_SET_BASE, rel) != oid}
    lc_inherited = {rel for rel, oid in frozen_h_gates.items() if base_oid_at(LAUNCH_CWD_BASE, rel) != oid}
    cs_expected = sorted(rel for rel in cs_inherited | refreeze_paths
                         if base_oid_at(CONTROL_SET_BASE, rel) and base_oid_at(CONTROL_SET_BASE, rel) != head_oid(rel))
    lc_expected = sorted(rel for rel in lc_inherited | refreeze_paths
                         if base_oid_at(LAUNCH_CWD_BASE, rel) and base_oid_at(LAUNCH_CWD_BASE, rel) != head_oid(rel))
    gov_expected_fails = sorted(GOVERNANCE_EXPECTED_FAILS) + ([GOVERNANCE_CONTROL_SET_ROW] if cs_expected else [])
    control_state = {"missing": None}

    def judge_control_set(r, passes, fails, result):
        rows_by = rows_by_label(result)
        missing = [name for name in CONTROL_SET_ROWS if not rows_by.get(name, {}).get("pass")]
        control_state["missing"] = missing
        if cs_expected:
            frozen = rows_by.get(CONTROL_SET_FROZEN_ROW, {})
            # The refreeze makes exactly the frozen-artifacts row red, naming exactly the declared paths; the seven
            # product rows (loop e2e, prepare/check, fixture task, selftest, substitution, invariant-required) stay green.
            ok = (r.returncode == 1 and len(passes) == CONTROL_SET_ROW_COUNT - 1 and fails == [CONTROL_SET_FROZEN_ROW]
                  and "PLATFORM_CONTROL_SET_RESULT=RED_LOCAL_QUALIFICATION" in r.stdout
                  and result is not None and result.get("pass") is False and result.get("subject_head") == head
                  and not missing and frozen.get("pass") is False
                  and str(frozen.get("detail", "")).endswith("problems=" + repr(cs_expected)))
            return ok, f"fails={fails[:6]} missing_rows={missing} expected_problems={cs_expected} " \
                       f"frozen_detail={str(frozen.get('detail'))[-120:]!r}"
        ok = (r.returncode == 0 and len(passes) == CONTROL_SET_ROW_COUNT and not fails
              and "PLATFORM_CONTROL_SET_RESULT=PASS_LOCAL_QUALIFICATION_ONLY" in r.stdout
              and result is not None and result.get("pass") is True and result.get("subject_head") == head and not missing)
        return ok, f"fails={fails[:6]} missing_rows={missing}"

    def judge_launch_cwd(r, passes, fails, result):
        frozen = rows_by_label(result).get(LAUNCH_CWD_FROZEN_ROW, {})
        # launch-cwd froze the whole verify/bin listing at 383ed387 (+ itself); this candidate carries exactly two
        # later gates there (governance + this one), so that single row is red for exactly that reason. v3.11: a
        # declared refreeze adds exactly its own paths to that row's `problems`, and nothing else.
        expected_detail = "problems=" + repr(lc_expected) + LAUNCH_CWD_EXPECTED_EXTRA
        ok = (len(passes) + len(fails) == LAUNCH_CWD_ROW_COUNT and fails == [LAUNCH_CWD_FROZEN_ROW] and r.returncode == 1
              and result is not None and result.get("subject_head") == head and frozen.get("pass") is False
              and str(frozen.get("detail", "")).endswith(expected_detail))
        return ok, f"fails={fails[:6]} expected_detail={expected_detail!r} frozen_detail={str(frozen.get('detail'))[-160:]!r}"

    def judge_governance(r, passes, fails, result):
        # v3.11: the governance gate RUNS the control-set gate, so a declared refreeze adds exactly that one row to its
        # red set — and that row must be red for exactly the refreeze's effect (67 of 68, naming the frozen row).
        nested = rows_by_label(result).get(GOVERNANCE_CONTROL_SET_ROW, {})
        nested_ok = True
        if cs_expected:
            nested_ok = (nested.get("pass") is False
                         and f"pass={CONTROL_SET_ROW_COUNT - 1} fail=1 fails=[{CONTROL_SET_FROZEN_ROW!r}]" in str(nested.get("detail", "")))
        ok = (len(passes) + len(fails) == GOVERNANCE_ROW_COUNT and sorted(fails) == gov_expected_fails
              and r.returncode == 1 and result is not None and result.get("subject_head") == head
              and "PLATFORM_GOVERNANCE_RESULT=RED_LOCAL_QUALIFICATION" in r.stdout and nested_ok)
        return ok, f"fails={fails[:8]} expected={gov_expected_fails} nested_detail={str(nested.get('detail'))[-140:]!r}"

    run_held("f7_platform_control_set_exit_on_candidate_68_of_68_or_exactly_the_declared_refreeze_effect",
             CONTROL_SET_GATE, args.held_control_set, 3600, judge_control_set)
    run_held("f7_launch_cwd_exit_19_of_20_frozen_listing_sees_exactly_governance_this_gate_and_the_declared_refreeze",
             LAUNCH_CWD_GATE, args.held_launch_cwd, 1800, judge_launch_cwd)
    run_held("f7_platform_governance_exit_red_exactly_on_its_frozen_rows_and_the_declared_refreeze_effect",
             GOVERNANCE_GATE, args.held_governance, 7200, judge_governance)

    # ------------------------------------------------------------------ F8: no coupling to the web repo path or the old root
    coupling = []
    for rel in sorted(tracked):
        if rel.startswith(("SEPARATION-20260910/", "verify/", "docs/loop/arkiv/")) or rel.endswith("-local-development.md") \
                or rel in (SPEC, DRIFT, "docs/loop/owner-author-workflow-v1.md",
                           "docs/loop/remaining-bootstrap-delegation-v1.md"):
            continue
        p = subject / rel
        if not p.is_file():
            continue
        raw = p.read_text(encoding="utf-8", errors="replace")
        is_python = rel.endswith(".py") or raw.startswith("#!/usr/bin/env python")
        if is_python:
            try:
                for line, value in code_strings(raw, skip_functions={fn for f, fn in HISTORICAL_CODE_FUNCTIONS if f == rel}):
                    if OLD_ROOT_RE.search(value) or OLD_ROOT_REL_RE.match(value) or WEB_REPO_RE.search(value) or SIBLING_RE.search(value):
                        coupling.append(f"{rel}:{line} {value[:60]}")
                continue
            except SyntaxError:
                pass
        for m in list(OLD_ROOT_RE.finditer(raw)) + list(WEB_REPO_RE.finditer(raw)) + list(SIBLING_RE.finditer(raw)):
            coupling.append(f"{rel}:{raw.count(chr(10), 0, m.start()) + 1} {raw[max(0, m.start() - 15):m.end() + 25]!r}")
    check("f8_no_tracked_file_couples_to_web_repo_path_or_old_root", not coupling, "; ".join(coupling[:10]))  # incl. sibling repos
    cs = gate_runs.get(CONTROL_SET_GATE)
    # v3.11: the meaning is unchanged — the ORDINARY loop e2e and platform prepare/check are green on the candidate.
    # With a declared refreeze the held control-set gate's own frozen-artifacts row is red by construction, so the
    # expectation is exactly that one row and the seven product rows still green, never "some failures allowed".
    expected_cs_fails = [CONTROL_SET_FROZEN_ROW] if cs_expected else []
    check("f8_ordinary_loop_e2e_and_platform_prepare_check_green_on_candidate_via_held_control_set",
          cs is not None and cs["fails"] == expected_cs_fails and control_state["missing"] == []
          and cs["rc"] == (1 if cs_expected else 0),
          (f"expected_fails={expected_cs_fails} missing_rows={control_state['missing']} " + str(cs)[:300])
          if cs else "control-set gate not run")

    # ------------------------------------------------------------------ F10: development document, bytes unchanged
    doc = subject / DOCUMENT
    doc_text = doc.read_text(encoding="utf-8", errors="replace") if doc.is_file() and not doc.is_symlink() else ""
    missing = [s for s in DOC_SECTIONS if s not in doc_text]
    check("f10_development_document_tracked_with_required_sections",
          bool(doc_text) and DOCUMENT in tracked and not missing and "F9" in doc_text, f"missing={missing}")
    check("f10_subject_and_held_bytes_unchanged",
          all((subject / rel).is_file() and sha((subject / rel).read_bytes()) == digest for rel, digest in subject_sha.items())
          and all(sha((ROOT / rel).read_bytes()) == digest for rel, digest in held.items()))
    result = {"scope": "LOCAL_QUALIFICATION_ONLY", "subject": str(subject), "subject_head": head, "frozen_base": FROZEN_BASE,
              "plan_generation": plan_generation, "plan_generation_paths": [PLAN_GEN, HANDOFF_GEN],
              "plan_generation_blobs": {rel: head_oid(rel) for rel in (PLAN_GEN, HANDOFF_GEN)},
              "old_plan_commit": OLD_PLAN_COMMIT, "old_plan_blobs": OLD_PLAN_BLOBS,
              "produced_prompts": sorted(texts), "produced_prompt_documents": sorted(produced_docs),
              "prompt_builders": sorted(pbuilders), "prompt_flows": sorted(pflows), "prompt_side_effects": side_effects,
              "plan_guard_callers": sorted(guard_callers),
              "live_flows": {k: {"outcome": v.get("outcome"), "message": v.get("message", ""),
                                 "captures": [(c.get("role"), len(c.get("prompt", ""))) for c in v.get("captures", [])]} for k, v in live_flows.items()},
              "live_flows_mutated": {k: {"outcome": v.get("outcome"), "captures": len(v.get("captures", []))} for k, v in mut_flows.items()},
              "runner_machinery_ast": ids, "runner_dependency_blobs": {rel: head_oid(rel) for rel in RUNNER_DEPENDENCY_BLOBS},
              "live_popen_total": (live_green or {}).get("popen_total"), "live_provider_starts": (live_green or {}).get("provider_starts"),
              "live_start_primitives": (live_green or {}).get("start_primitives"), "live_start_binaries": (live_green or {}).get("start_binaries"),
              "live_child_total": (live_green or {}).get("child_total"), "live_child_binaries": (live_green or {}).get("child_binaries"),
              "live_child_argv_rewritten": (live_green or {}).get("child_argv_rewritten"),
              "live_child_unrecorded": (live_green or {}).get("child_unrecorded"),
              "live_import_time_starts": (live_green or {}).get("import_time_starts"),
              "live_init_total": (live_green or {}).get("init_total"),
              "live_init_unrecorded": (live_green or {}).get("init_unrecorded"),
              "live_identity_violations": (live_green or {}).get("identity_violations"),
              "live_old_pointer_starts": (live_green or {}).get("old_pointer_starts"),
              "live_stdin_starts": (live_green or {}).get("stdin_starts"),
              "live_start_identities": (live_green or {}).get("start_identities"),
              "live_stub_calls": [{"name": c["name"], "argv": c["argv"][:6], "stdin_len": len(c["stdin"])} for c in stub_calls[:6]],
              "live_stub_call_total": len(stub_calls),
              "live_allowed_wrapper_forms": [list(f) for f in ALLOWED_LIVE_WRAPPER_FORMS],
              "live_allowed_start_sha256": sorted(ALLOWED_START_SHA.values()),
              "live_popen_identity": (live_green or {}).get("popen_identity"),
              "live_popen_identity_after": (live_green or {}).get("popen_identity_after"),
              "live_mutated_popen_total": (live_mut_out or {}).get("popen_total"),
              "live_mutated_provider_starts": (live_mut_out or {}).get("provider_starts"),
              "live_allowed_tools": sorted(ALLOWED_LIVE_TOOLS), "live_allowed_wrappers": sorted(ALLOWED_LIVE_WRAPPERS),
              "core_module_file": produced.get("core_module_file"),
              "live_side_effects": live_side_effects,
              "case_collisions": case_dupes,
              "subject_sha256": subject_sha, "held_sha256": held, "held_gate_runs": gate_runs,
              "closure_roots": sorted(roots), "closure_reached": sorted(reached), "closure_scanned": scanned,
              "closure_dangling": {k: sorted(v) for k, v in sorted(dangling.items())},
              "tree_classification": classification, "forbidden_blobs": FORBIDDEN_BLOBS,
              "governance_expected_fails": gov_expected_fails,
              "refreeze_declaration": declared, "refreeze_declaration_path": REFREEZE_DECL,
              "refreeze_added_lines": added_lines, "refreeze_label_counts": label_counts,
              "refreeze_max_retired_labels": REFREEZE_MAX_RETIRED_LABELS,
              "refreeze_receipts": [{"source": s, "gate": o.get("gate"), "exit_code": o.get("exit_code"),
                                     "pass_count": o.get("pass_count"), "fail_count": o.get("fail_count"),
                                     "stdout_sha256": o.get("stdout_sha256"), "subject_head": o.get("subject_head"),
                                     "gate_sha256": o.get("gate_sha256"), "invocation": o.get("invocation")}
                                    for s, o in receipts if type(o) is dict],
              "refreeze_expected_control_set_problems": cs_expected,
              "refreeze_expected_launch_cwd_problems": lc_expected,
              "python": PYTHON, "python_sha256": PYTHON_SHA, "node": NODE, "node_sha256": sha(Path(NODE).read_bytes()),
              "sandbox_exec_present": Path(SANDBOX_EXEC).is_file(),
              "fixture_root": str(scratch), "expected_rows": EXPECTED_ROW_COUNT, "rows": rows,
              "pass": False}
    check("f10_gate_emitted_the_expected_number_of_rows",
          len(rows) + 2 == EXPECTED_ROW_COUNT, f"emitted={len(rows) + 2} expected={EXPECTED_ROW_COUNT}")
    check("f10_gate_reached_its_last_row_without_an_unexpected_failure", True, f"rows={len(rows) + 1}")
    # v3.10 (review v14 N3): the verdict is computed AFTER the last row exists, over the complete row list, and it
    # requires the pinned row count as well as every row being green.
    result["pass"] = all(row["pass"] for row in rows) and len(rows) == EXPECTED_ROW_COUNT
    with (scratch / "result.json").open("x") as stream:
        json.dump(result, stream, indent=2, ensure_ascii=False)
    print("PLATFORM_SEPARATION_FINAL_RESULT=" + ("PASS_LOCAL_QUALIFICATION_ONLY" if result["pass"] else "RED_LOCAL_QUALIFICATION"))
    return 0 if result["pass"] else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        # v3.10 (review v14 N2): `Rig` is no longer exempt once judging has begun. `git()` raises `Rig` on every failed
        # fixture command and those run on product-controlled content, so a product that broke a late fixture git made the
        # gate undecidable — exactly the class v3.9 claimed to have closed. A failure BEFORE the first row (missing tool,
        # unusable subject) is still a rig error; after it, the run is a product verdict.
        if EMITTED_ROWS:
            rows, scratch = ABORT_STATE["rows"], ABORT_STATE["scratch"]
            rows.append({"label": "f10_gate_reached_its_last_row_without_an_unexpected_failure", "pass": False,
                         "detail": f"aborted after {len(rows)} of {EXPECTED_ROW_COUNT} rows: {exc!r}"[:1200]})
            print("FAIL f10_gate_reached_its_last_row_without_an_unexpected_failure", flush=True)
            # v3.10 (review v14 N1): every row that never ran counts as FAIL, so an aborted run can never read as
            # numerically closer to green than an honest baseline, and the evidence file is written on this path too.
            not_run = max(0, EXPECTED_ROW_COUNT - len(rows))
            for index in range(not_run):
                rows.append({"label": f"not_run_{index + 1}", "pass": False, "detail": "row never reached (run aborted)"})
            if scratch is not None:
                try:
                    with (Path(scratch) / "result.json").open("w") as stream:
                        json.dump({"aborted": True, "abort": repr(exc), "rows": rows, "pass": False,
                                   "expected_rows": EXPECTED_ROW_COUNT}, stream, indent=2, ensure_ascii=False)
                except OSError:
                    pass
            print("PLATFORM_SEPARATION_FINAL_ABORT=" + repr(exc), file=sys.stderr)
            print(f"PLATFORM_SEPARATION_FINAL_ROWS={sum(1 for r in rows if r['pass'])}/{sum(1 for r in rows if not r['pass'])}")
            print("PLATFORM_SEPARATION_FINAL_RESULT=RED_LOCAL_QUALIFICATION")
            sys.exit(1)
        print("PLATFORM_SEPARATION_FINAL_RIG_ERROR=" + repr(exc), file=sys.stderr)
        sys.exit(2)
