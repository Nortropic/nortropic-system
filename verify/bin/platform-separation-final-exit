    # The recorders are already installed (before the module was executed); only the module's own namespace is refreshed,
    # and the import-time starts the product may have made are discarded so the flow counters start at zero.
    "            if getattr(m,'subprocess',None) is not None: m.subprocess.Popen=_RECS[('subprocess','Popen')]\n"
