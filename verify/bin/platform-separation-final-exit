DRIVER_MARK = "PLATFORM_SEPARATION_DRIVER="
# Real module, real callables, never the operational __main__. Stop -> exit 7.
DRIVER = (
    "import importlib.util,sys,json,subprocess as _sp\n"
    "import os as _os, hashlib as _hl, shutil as _sh\n"
    # v3.7 (review v11 B1): every primitive AND the Popen class's own start method are captured before the subject module is
    # loaded, so an import-time rebinding is measured against the stdlib original rather than against itself.
    "_ORIG_POPEN=_sp.Popen\n"
    "_ORIG_EXEC_CHILD=getattr(_ORIG_POPEN,'_execute_child',None)\n"
    "_ORIG_POPEN_INIT=_ORIG_POPEN.__init__\n"
    "_ORIG_COMM=_ORIG_POPEN.communicate\n"
    "_PRIMS=[(_sp,'Popen')]+[(_os,n) for n in ('posix_spawn','posix_spawnp','execv','execve','execvp','spawnv','spawnve','system') if hasattr(_os,n)]\n"
    "_ORIG_PRIMS={(mod.__name__,name):getattr(mod,name) for mod,name in _PRIMS}\n"
    "from pathlib import Path\n"
    "subject=Path(sys.argv[1]); root=Path(sys.argv[2]); scenario=sys.argv[3]\n"
    # v3.8 (review v12 B1): in the LIVE scenario the recorders are installed BEFORE the subject module is executed. v3.7
    # captured the stdlib originals before the load but installed the recorders after it, so any import-time capture that
    # is not a statement — a FUNCTION DEFAULT (`def _s(t, _S=os.posix_spawn)`), a decorator argument, a method default,
    # a metaclass — took the real primitive and started processes the gate never saw (measured: 24 real children with a
    # neutral prompt while the gate was green). With the recorders installed first, every such capture captures the
    # INSTRUMENTED object, which closes the whole class structurally rather than form by form. The eight `os.*`
    # primitives have no attribute below the module attribute to record, so this is the only place they can be bound.
    "popen_calls=[]; child_calls=[]; init_calls=[]; stdin_seen=[]; rec_count=[0]; _ACTIVE=[]; _RECS={}; _IDC={}\n"
    # v3.9 (review v13 B2): every started process is identified by the RESOLVED PATH and the sha256 of the file that is
    # actually executed, never by its basename — a script whose basename is `git` reported `start_binaries=['git']` and
    # was indistinguishable from the reference in the evidence file.
    # v3.10 (review v14 B2): `Popen` resolves a bare argv[0] through the PATH of the `env=` argument, not through the
    # driver's own environment. v3.9 resolved it through `os.environ`, so `env={'PATH': <own dir>}` made the gate hash the
    # gate's own stub while the product's own binary ran (measured: 114/5 green with the old plan on the child's stdin).
    "def _identify(path_, env_=None):\n"
    "    try:\n"
    "        path_str=(dict(env_).get('PATH') if env_ else None)\n"
    "        if path_str is None: path_str=_os.environ.get('PATH','')\n"
    "        p_=_sh.which(str(path_), path=path_str) or str(path_)\n"
    "        rp=_os.path.realpath(p_)\n"
    "    except Exception:\n"
    "        rp=str(path_)\n"
    "    if rp in _IDC: return _IDC[rp]\n"
    "    try:\n"
    "        with open(rp,'rb') as fh_: h_=_hl.sha256(fh_.read()).hexdigest()\n"
    "    except Exception: h_=''\n"
    "    _IDC[rp]=(rp,h_); return _IDC[rp]\n"
    # v3.9 (review v13 B1): the identity of the instrumentation is checked at EVERY recorded call, not only before and
    # after the flows — a product that restores a primitive around one start and puts the recorder back was invisible.
    "def _identity_now():\n"
    "    try:\n"
    "        return bool(all(getattr(sys.modules[mn],pn) is _EXPECT[(mn,pn)] for (mn,pn) in _EXPECT)\n"
    "                    and getattr(_ORIG_POPEN,'_execute_child',None) is _EXPECT_CHILD\n"
    "                    and _ORIG_POPEN.__init__ is _EXPECT_INIT)\n"
    "    except Exception:\n        return False\n"
    "def _envtext(env_):\n"
    "    try:\n"
    # When the child inherits, the environment it actually receives is the driver's own.
    "        return ' '.join(str(k_)+'='+str(v_) for k_,v_ in dict(env_ if env_ is not None else _os.environ).items())\n"
    "    except Exception: return ''\n"
    # v3.10 (review v14 B2): stdin is measured in every channel, not only as `communicate(input=...)` or a pipe seen by a
    # stub. A plain temporary FILE and an inherited fd were both invisible; both are read here through /dev/fd.
    "def _fd_text(obj_):\n"
    "    try:\n"
    "        fd_=obj_ if isinstance(obj_,int) else (obj_.fileno() if hasattr(obj_,'fileno') else None)\n"
    "        if fd_ is None or fd_<0: return ''\n"
    "        target=_os.path.realpath('/dev/fd/%d'%fd_)\n"
    "        if _os.path.isfile(target):\n"
    "            with open(target,'rb') as fh_: return fh_.read(65536).decode('utf-8','replace')\n"
    "        try:\n"
    "            pos=_os.lseek(fd_,0,1); _os.lseek(fd_,0,0)\n"
    "            data=_os.read(fd_,65536); _os.lseek(fd_,pos,0)\n"
    "            return data.decode('utf-8','replace')\n"
    "        except Exception: return ''\n"
    "    except Exception: return ''\n"
    "def _stdin_form(k_):\n"
    "    v_=k_.get('stdin')\n"
    "    if k_.get('input') is not None: return 'input'\n"
    "    if v_ is None: return 'none'\n"
    "    if v_ is _sp.DEVNULL: return 'devnull'\n"
    "    if v_ is _sp.PIPE: return 'pipe'\n"
    "    return 'fd'\n"
    # v3.10 (review v14 B2): `git` is a general launcher. These argv fragments and environment variables make it start
    # something else; the reference uses none of them.
    "def _git_launcher(items,envtext):\n"
    "    hits=[]\n"
    "    if items and items[0].rsplit('/',1)[-1]=='git':\n"
    "        for i_,a_ in enumerate(items):\n"
    "            if a_ in ('-c','--exec-path','--upload-pack','--receive-pack') or a_.startswith('--exec-path='):\n"
    "                nxt=(items[i_+1] if i_+1<len(items) else '').lower()\n"
    "                if a_!='-c' or any(nxt.startswith(t_) for t_ in " + repr(tuple(t.lower() for t in GIT_LAUNCHER_CONFIG)) + "):\n"
    "                    hits.append(a_+' '+nxt[:40])\n"
    "    for v_ in " + repr(tuple(GIT_LAUNCHER_ENV)) + ":\n"
    "        if (v_+'=') in envtext and (v_+'=/dev/null') not in envtext and (v_+'=cat') not in envtext and (v_+'=1') not in envtext:\n"
    "            hits.append('env:'+v_)\n"
    "    return hits[:3]\n"
    "def _make_rec(mn,pn,orig):\n"
    "    def _rec(*a,**k):\n"
    "        rec_count[0]+=1\n"
    "        try:\n"
    "            argv=a[0] if a else k.get('args') or k.get('argv')\n"
    "            items=[str(x) for x in argv] if not isinstance(argv,(str,bytes)) else [str(argv)]\n"
    "        except Exception: items=['<unreadable>']\n"
    "        rp_,h_=_identify(k.get('executable') or (items[0] if items else ''), k.get('env'))\n"
    "        envtext_=_envtext(k.get('env'))\n"
    "        form_=_stdin_form(k)\n"
    "        stdin_text_=_fd_text(k.get('stdin')) if form_=='fd' else ''\n"
    "        fd_text_=''\n"
    "        for fd_ in (k.get('pass_fds') or ()):\n"
    "            fd_text_+=' '+_fd_text(fd_)\n"
    "        rec_={'prim':mn+'.'+pn,'argv':items,'path':rp_,'sha256':h_,'identity':_identity_now(),\n"
    "              'stdin_set':(form_ not in ('none','devnull')),'stdin_form':form_,\n"
    "              'stdin_text':(stdin_text_+fd_text_)[:4000],'pass_fds':len(k.get('pass_fds') or ()),\n"
    "              'env_given':(k.get('env') is not None),\n"
    "              'env_path':(dict(k.get('env') or {}).get('PATH') or ''),\n"
    "              'git_launcher':_git_launcher(items,envtext_),'env_text':envtext_}\n"
    "        popen_calls.append(rec_); _COUNTS[0]+=1\n"
    "        _ACTIVE.append(items)\n"
    "        try:\n"
    "            return orig(*a,**k)\n"
    "        finally:\n"
    "            _ACTIVE.pop()\n"
    "    return _rec\n"
    # v3.9 (review v13 B1): a recorder on the CLASS's own __init__ sees every instantiation of the real Popen class, no
    # matter which reference to the class the caller used — including a class object recovered from the driver's own
    # namespace. `init_total` must equal `popen_total`, and an instantiation made while no recorded call is on the stack
    # is reported by identity.
    "def _init_rec(self,args,*a,**k):\n"
    "    try:\n"
    "        items=[str(x) for x in args] if not isinstance(args,(str,bytes)) else [str(args)]\n"
    "    except Exception: items=['<unreadable>']\n"
    "    init_calls.append({'argv':items,'recorded':bool(_ACTIVE),'identity':_identity_now()}); _COUNTS[2]+=1\n"
    "    return _ORIG_POPEN_INIT(self,args,*a,**k)\n"
    # v3.9 (review v13 B2/3): stdin CONTENT is captured, not only the fact that stdin was set — the decisive mutant put
    # `PROMPT=read docs/loop/autonomous-loop-plan-v1.md` on a child's stdin with argv=['/bin/sh'].
    "def _comm_rec(self,input=None,timeout=None):\n"
    "    if input is not None:\n"
    "        try:\n"
    "            t_=input if isinstance(input,str) else bytes(input).decode('utf-8','replace')\n"
    "            stdin_seen.append({'argv':[str(x) for x in (getattr(self,'args',None) or [])],'text':t_[:4000]}); _COUNTS[3]+=1\n"
    "        except Exception: pass\n"
    "    return _ORIG_COMM(self,input,timeout)\n"
    # Per-CALL identity, not an aggregate: a child start that happens while no recorded Popen call is on the stack is
    # unrecorded, whatever the totals say. Review v12 B1(b) balanced the v3.7 aggregates (19 hidden starts + 19 recorded
    # Popen calls with the same argv that raised inside __init__ before _execute_child); that is caught here.
    "def _child_rec(self,args,executable=None,*a,**k):\n"
    "    try:\n"
    "        items=[str(x) for x in args] if not isinstance(args,(str,bytes)) else [str(args)]\n"
    "    except Exception: items=['<unreadable>']\n"
    "    child_calls.append({'argv':items,'recorded':bool(_ACTIVE)}); _COUNTS[1]+=1\n"
    "    return _ORIG_EXEC_CHILD(self,args,executable,*a,**k)\n"
    "_EXPECT=dict(_ORIG_PRIMS); _EXPECT_CHILD=_ORIG_EXEC_CHILD; _EXPECT_INIT=_ORIG_POPEN_INIT\n"
    "if scenario=='live_flows':\n"
    "    for mod,name in _PRIMS:\n"
    "        r_=_make_rec(mod.__name__,name,_ORIG_PRIMS[(mod.__name__,name)]); _RECS[(mod.__name__,name)]=r_; setattr(mod,name,r_)\n"
    "    _EXPECT=dict(_RECS)\n"
    "    if _ORIG_EXEC_CHILD is not None:\n"
    "        _ORIG_POPEN._execute_child=_child_rec; _EXPECT_CHILD=_child_rec\n"
    "    _ORIG_POPEN.__init__=_init_rec; _EXPECT_INIT=_init_rec\n"
    "    _ORIG_POPEN.communicate=_comm_rec\n"
    # v3.10 (review v14 B1(b)): the recording containers themselves were swappable. A mutant replaced the four lists with
    # list subclasses whose `append` does nothing and was 114/5 green with in-process counters of 5 against 333 stub
    # calls. Their exact types and bound `append` methods are pinned here and re-checked after the flows; a count is also
    # kept in a closure cell that no list swap can reach.
    "_COUNTS=[0,0,0,0]\n"
    "_PINNED={'popen':(type(popen_calls),id(popen_calls)),'child':(type(child_calls),id(child_calls)),\n"
    "         'init':(type(init_calls),id(init_calls)),'stdin':(type(stdin_seen),id(stdin_seen))}\n"
    "def _integrity_of_recorders():\n"
    "    now={'popen':(type(popen_calls),id(popen_calls)),'child':(type(child_calls),id(child_calls)),\n"
    "         'init':(type(init_calls),id(init_calls)),'stdin':(type(stdin_seen),id(stdin_seen))}\n"
    "    bad=[k for k in _PINNED if now[k]!=_PINNED[k]]\n"
    "    bad+=[k for k,v in (('popen',popen_calls),('child',child_calls),('init',init_calls),('stdin',stdin_seen))\n"
    "          if type(v) is not list or v.append.__self__ is not v]\n"
    "    return sorted(set(bad))\n"
    "s=importlib.util.spec_from_file_location(sys.argv[4] if len(sys.argv)>4 else 'subject_autopilot', subject/'" + AUTOPILOT + "')\n"
    "m=importlib.util.module_from_spec(s); sys.modules[s.name]=m; s.loader.exec_module(m)\n"
    "out={'scenario':scenario}\n"
    "out['popen_identity']=bool(all(getattr(sys.modules[mn],pn) is _EXPECT[(mn,pn)] for (mn,pn) in _EXPECT)\n"
    "                           and getattr(m,'subprocess',_sp) is _sp\n"
    "                           and getattr(_ORIG_POPEN,'_execute_child',None) is _EXPECT_CHILD\n"
    "                           and _ORIG_POPEN.__init__ is _EXPECT_INIT)\n"
    "out['core_module_file']=getattr(sys.modules.get('core'),'__file__',None)\n"
    "try:\n"
    "    if scenario=='selftest_none':\n"
    "        m.selftest(None)\n"
    "        out.update(outcome='returned')\n"
    "    elif scenario=='roadmap_plan':\n"
    "        m.ensure_roadmap_plan(root)\n"
    "        out.update(outcome='returned')\n"
    # v3.7 (review v11 N4): measure that the guard READS ROADMAP_PLAN_BLOBS. The copy-mutation row is satisfiable by a guard
    # anchored to a tracked digest manifest; repinning the constant in the imported module and requiring Stop on an
    # UNMUTATED replica is the direct measurement of which authority the guard actually consults.
    "    elif scenario=='roadmap_plan_repinned':\n"
