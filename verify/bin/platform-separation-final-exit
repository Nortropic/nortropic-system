    def text(rel):
        return (subject / rel).read_text(encoding="utf-8", errors="replace")

    def base_bytes(rel, rev=FROZEN_BASE):
        r = run_bytes([GIT, "-C", str(subject), "show", f"{rev}:{rel}"], scratch, probe_env)
