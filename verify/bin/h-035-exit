def r15_fault_events(result: subprocess.CompletedProcess, branch: str) -> list[dict[str,object]]:
    rows=getattr(result,"r15_judge_status",None)
    if not isinstance(rows,list):return []
    if len(rows)!=1 or rows[0].get("branch")!=branch:return []
    events=rows[0].get("events")
    return events if isinstance(events,list) else []


def r15_fault_event_exact(result: subprocess.CompletedProcess, branch: str,
                          primitive: str, identity: object,
                          route_calls: list[dict[str,object]] | None = None) -> bool:
    expected=[{"primitive":primitive,"identity":identity}]
    if route_calls is not None:
        expected.extend({"primitive":"route_call","identity":row} for row in route_calls)
    return r15_json_equal(r15_fault_events(result,branch),expected)


def r15_attest_trace_invocation_exact(
        trace_rows: object, trace_events: object,
        finalizer_identity: list[int], expected_source_sha256: str,
        expected_argv_tail: list[str], expected_kwargs: dict[str,object]) -> bool:
    try:
        if (not isinstance(trace_rows,list) or len(trace_rows)!=1
                or not isinstance(trace_rows[0],dict)
                or set(trace_rows[0])!={"argv","kwargs"}):
            return False
        trace_argv=trace_rows[0]["argv"];trace_kwargs=trace_rows[0]["kwargs"]
        if (not isinstance(trace_argv,list) or len(trace_argv)!=12
                or any(type(value) is not str for value in trace_argv)
                or not isinstance(trace_kwargs,dict)):
            return False
        if (not isinstance(trace_events,list) or len(trace_events)!=1
                or not isinstance(trace_events[0],dict)
                or set(trace_events[0])!={"primitive","identity"}
                or trace_events[0].get("primitive")!="attest_subprocess"):
            return False
        subject_identity=trace_events[0].get("identity")
        if (not isinstance(subject_identity,dict)
                or set(subject_identity)!={
                    "initial_sys_executable","initial_sys_version"}
                or type(subject_identity.get("initial_sys_executable")) is not str
                or subject_identity["initial_sys_executable"]!=sys.executable
                or subject_identity["initial_sys_executable"]!=str(H035_R15_AST_PYTHON)
                or type(subject_identity.get("initial_sys_version")) is not list
                or len(subject_identity["initial_sys_version"])!=3
                or any(type(value) is not int
                       for value in subject_identity["initial_sys_version"])
                or tuple(subject_identity["initial_sys_version"])
                   != tuple(sys.version_info[:3])):
            return False
        subject_executable=subject_identity["initial_sys_executable"]
        subject_version=tuple(subject_identity["initial_sys_version"])
        interpreter_ok,_=r15_ast_interpreter_validate(
            H035_R15_AST_PYTHON,H035_R15_AST_PYTHON_SHA256,
            H035_R15_AST_PYTHON_VERSION,subject_executable,subject_version)
        fd_token=trace_argv[6]
        if re.fullmatch(r"[1-9][0-9]*",fd_token) is None:
            return False
        trace_fd=int(fd_token)
        if trace_fd<3 or fd_token!=str(trace_fd):
            return False
        identity_token=json.dumps(finalizer_identity,separators=(",",":"))
        expected_argv=[
            subject_executable,"-I","-S","-B","-c",
            H035_R15_FINALIZER_FD_LOADER,str(trace_fd),expected_source_sha256,
            identity_token,*expected_argv_tail]
        return (interpreter_ok and trace_argv==expected_argv
                and r15_json_equal(trace_kwargs,expected_kwargs))
    except (KeyError,OverflowError,TypeError,ValueError):
        return False


def r15_attest_trace_invocation_selftests() -> None:
    startup_env=os.environ.copy()
    startup_env.pop("PYTHONDONTWRITEBYTECODE",None)
    startup_env.pop("PYTHONPYCACHEPREFIX",None)
    startup_source=(
        "import os,sys;os.write(1,(sys.executable+'\\n'+"
        "'.'.join(str(value) for value in sys.version_info[:3])+'\\n').encode())")
    startup=subprocess.run(
        [sys.executable,"-S","-c",startup_source],cwd=ROOT,env=startup_env,
        text=False,capture_output=True,shell=False,check=False,timeout=30)
    expected_startup=(str(H035_R15_AST_PYTHON)+"\n"
                      +".".join(str(value) for value in H035_R15_AST_PYTHON_VERSION)
                      +"\n").encode("utf-8")
    if (startup.returncode!=0 or startup.stderr!=b""
            or startup.stdout!=expected_startup
            or sys.executable!=str(H035_R15_AST_PYTHON)):
        raise Rig("R15 nested -S interpreter startup authority")

    production_repository="git@github.com:Nortropic/nortropic-system.git"
    local_repository="/private/tmp/h035-r15-local-fixture.git"
    validated_agent="/private/tmp/h035-r15-validated-agent/agent.sock"
    production_projection=r15_finalizer_agent_projection(
        production_repository,validated_agent,validated_agent)
    local_projection=r15_finalizer_agent_projection(
        local_repository,validated_agent,validated_agent)
    wrong_repositories=(
        "git@github.com:Nortropic/neighbor.git",
        "https://github.com/Nortropic/nortropic-system.git",
        production_repository+".substitute",
    )
    rejected_projection=[]
    for initial_agent,live_agent in (("",""),
                                      (validated_agent,validated_agent+".substitute")):
        try:
            r15_finalizer_agent_projection(
                production_repository,initial_agent,live_agent)
            rejected_projection.append(False)
        except Rig:
            rejected_projection.append(True)
    if (production_projection!={"SSH_AUTH_SOCK":validated_agent}
            or local_projection!={}
            or rejected_projection!=[True,True]
            or any(r15_finalizer_agent_projection(
                       value,validated_agent,validated_agent)!={}
                   for value in wrong_repositories)
            or r15_json_equal(production_projection,{})
            or r15_json_equal(production_projection,
                              {"SSH_AUTH_SOCK":validated_agent+".substitute"})
            or r15_json_equal(production_projection,
                              {"SSH_AUTH_SOCK":validated_agent,"EXTRA":"1"})
            or r15_json_equal(local_projection,{"SSH_AUTH_SOCK":validated_agent})):
        raise Rig("R15 finalizer SSH repository/initial-agent projection")

    finalizer_identity=[1,2,stat.S_IFREG|0o755,os.getuid(),1,9,10,11]
    source_sha="a"*64;argv_tail=["/fixture/controller/attest/cli","/fixture/attest",
                                 "finalize-owner-publication"]
    kwargs={"cwd":"/fixture","env":{"PATH":"/usr/bin:/bin"},"input":"{}",
            "text":True,"capture_output":True,"shell":False,"check":False,
            "timeout":30,"pass_fds":[3],"close_fds":True}
    subject_identity={"initial_sys_executable":sys.executable,
                      "initial_sys_version":list(sys.version_info[:3])}
    events=[{"primitive":"attest_subprocess","identity":subject_identity}]
    argv=[sys.executable,"-I","-S","-B","-c",H035_R15_FINALIZER_FD_LOADER,
          "3",source_sha,json.dumps(finalizer_identity,separators=(",",":")),*argv_tail]
    rows=[{"argv":argv,"kwargs":kwargs}]
    exact=lambda candidate_rows,candidate_events:r15_attest_trace_invocation_exact(
        candidate_rows,candidate_events,finalizer_identity,source_sha,argv_tail,kwargs)
    if not exact(rows,events):raise Rig("R15 exact attest trace oracle positive")
    mutants=[]
    for replacement in (
            "/opt/homebrew/opt/python@3.12/bin/python3.12","python3.12",
            "/private/tmp/arbitrary-python-alias"):
        candidate_rows=copy.deepcopy(rows);candidate_events=copy.deepcopy(events)
        candidate_rows[0]["argv"][0]=replacement
        candidate_events[0]["identity"]["initial_sys_executable"]=replacement
        mutants.append((candidate_rows,candidate_events))
    for replacement in ([3,12,12],[3,12,13,0],[3,12,True]):
        candidate_events=copy.deepcopy(events)
        candidate_events[0]["identity"]["initial_sys_version"]=replacement
        mutants.append((copy.deepcopy(rows),candidate_events))
    mutants.extend((copy.deepcopy(rows),candidate_events) for candidate_events in (
        [],events+copy.deepcopy(events),
        [{"primitive":"attest_subprocess","identity":None}],
        [{"primitive":"forged","identity":copy.deepcopy(subject_identity)}],
        [{"primitive":"attest_subprocess","identity":{
            **copy.deepcopy(subject_identity),"extra":True}}],
    ))
    for index in range(1,5):
        candidate=copy.deepcopy(rows);candidate[0]["argv"][index]="--mutated"
        mutants.append((candidate,copy.deepcopy(events)))
    candidate=copy.deepcopy(rows);candidate[0]["argv"][1:3]=reversed(
        candidate[0]["argv"][1:3]);mutants.append((candidate,copy.deepcopy(events)))
    candidate=copy.deepcopy(rows);candidate[0]["argv"].pop();mutants.append(
        (candidate,copy.deepcopy(events)))
    candidate=copy.deepcopy(rows);candidate[0]["argv"].append("extra");mutants.append(
        (candidate,copy.deepcopy(events)))
    for token in ("+3","03"," 3","3 ","-3","0","2"):
        candidate=copy.deepcopy(rows);candidate[0]["argv"][6]=token
        mutants.append((candidate,copy.deepcopy(events)))
    candidate=copy.deepcopy(rows);candidate[0]["argv"][8]=json.dumps(finalizer_identity)
    mutants.append((candidate,copy.deepcopy(events)))
    for index in (5,7,8,9,10,11):
        candidate=copy.deepcopy(rows);candidate[0]["argv"][index]+="-mutated"
        mutants.append((candidate,copy.deepcopy(events)))
    mutants.extend((candidate,copy.deepcopy(events)) for candidate in (
        [],rows+copy.deepcopy(rows),[{**copy.deepcopy(rows[0]),"extra":True}]))
    for key,value in kwargs.items():
        candidate=copy.deepcopy(rows);candidate[0]["kwargs"].pop(key)
        mutants.append((candidate,copy.deepcopy(events)))
        candidate=copy.deepcopy(rows)
        hostile=(not value if type(value) is bool else value+1 if type(value) is int
                 else value+"-mutated" if type(value) is str
                 else [*value,"mutated"] if isinstance(value,list)
                 else {**value,"R15_MUTATED":"1"})
        candidate[0]["kwargs"][key]=hostile
        mutants.append((candidate,copy.deepcopy(events)))
    candidate=copy.deepcopy(rows);candidate[0]["kwargs"]["extra"]=True
    mutants.append((candidate,copy.deepcopy(events)))
    for key in ("text","capture_output","shell","check","close_fds"):
        candidate=copy.deepcopy(rows)
        candidate[0]["kwargs"][key]=int(candidate[0]["kwargs"][key])
        mutants.append((candidate,copy.deepcopy(events)))
    candidate=copy.deepcopy(rows);candidate[0]["kwargs"]["timeout"]=30.0
    mutants.append((candidate,copy.deepcopy(events)))
    candidate=copy.deepcopy(rows);candidate[0]["kwargs"]["pass_fds"]=[3.0]
    mutants.append((candidate,copy.deepcopy(events)))
    if not mutants or any(exact(candidate_rows,candidate_events)
                          for candidate_rows,candidate_events in mutants):
        raise Rig("R15 attest trace invocation mutant admitted")


def r15_fault_answer(result: subprocess.CompletedProcess, reason: str | None) -> bool:
    try:value=strict_json_bytes(result.stdout.encode("utf-8"))
    except (ValueError,UnicodeError):return False
    if reason is None:
        return (result.returncode==1 and result.stderr=="" and isinstance(value,dict)
                and set(value)=={"accepted","reason"} and value.get("accepted") is False
                and isinstance(value.get("reason"),str) and 0<len(value["reason"])<=500
                and not any(item in value["reason"] for item in ("\r","\n","\x00")))
    return (result.returncode==1 and result.stderr==""
            and r15_json_equal(value,{"accepted":False,"reason":reason}))


def r15_fault_error(result: subprocess.CompletedProcess, reason: str | None) -> bool:
    if reason is None:
        return (result.returncode==1 and result.stdout=="" and result.stderr.endswith("\n")
                and 1<=len(result.stderr)<=501 and "\r" not in result.stderr
                and "\x00" not in result.stderr and "\n" not in result.stderr[:-1])
    return result.returncode==1 and result.stdout=="" and result.stderr==reason+"\n"


def r15_matrix_authorized(reference_ok: object, reference_count: object,
                          identity_ok: object, prior_failed: object) -> bool:
    return (reference_ok is True and type(reference_count) is int
            and reference_count>0 and identity_ok is True
            and type(prior_failed) is int and prior_failed==0)


def r15_authority(repo: Path, command: str, value: dict[str,object],
                  env_extra: dict[str,str] | None = None) -> tuple[int,dict[str,object],str]:
    value={"h035_r15_request":dict(R15_AUTHORITY_REQUEST_MARKER),**value}
    result=r15_cli(repo,"controller/authority/cli",command,
                   stdin=json.dumps(value,sort_keys=True,separators=(",",":")),
                   env_extra=env_extra)
    try: payload=strict_json_bytes(result.stdout.encode("utf-8"))
    except (ValueError,UnicodeError): payload={}
    return result.returncode,(payload if isinstance(payload,dict) else {}),(result.stderr or result.stdout)[-500:]


def r15_commit_tree(repo: Path, tree: str, parents: list[str], message: str) -> str:
    env=os.environ.copy()
    env.update({"GIT_AUTHOR_NAME":"H035 R15 Fixture","GIT_AUTHOR_EMAIL":"fixture@example.invalid",
                "GIT_COMMITTER_NAME":"H035 R15 Fixture","GIT_COMMITTER_EMAIL":"fixture@example.invalid"})
    argv=["/usr/bin/git","-C",str(repo),"commit-tree",tree]
    for parent in parents: argv.extend(("-p",parent))
    result=run(argv,cwd=repo,env=env,stdin=message+"\n")
    sha=result.stdout.strip()
    if result.returncode or not r15_lower_hex(sha,40):
        raise Rig(f"cannot create R15 fixture merge: {result.stderr}")
    return sha


def r15_review_file(path: Path, *, task: str, base: str,
                    candidate_sha: str, candidate_tree: str) -> str:
    value={
        "schema_version":1, "record_type":"nortropic_independent_owner_product_review",
        "role":"PRODUCT_REVIEWER", "result":"PASS", "task":task,
        "base_sha":base, "candidate_sha":candidate_sha,
        "candidate_tree":candidate_tree, "blocking_findings":[],
    }
    write_json(path,value); path.chmod(0o600)
    return hashlib.sha256(path.read_bytes()).hexdigest()


R15_H038_REFREEZE_PATHS=(
    "docs/05-beslutslogg.md","docs/loop/drift.md",
    "docs/loop/owner-author-workflow-v1.md","specs/tasks.spec.json",
    "verify/bin/h-038-exit",
)


def r15_json_task_row_extent(raw: bytes, task_id: str) -> tuple[int,int]:
    marker=(f'    {{\n      "id": "{task_id}",').encode("utf-8")
    if raw.count(marker)!=1: raise Rig("R15 JSON task row anchor cardinality")
    start=raw.index(marker); depth=0; quoted=False; escaped=False
    for offset in range(start,len(raw)):
        byte=raw[offset]
        if quoted:
            if escaped: escaped=False
            elif byte==0x5c: escaped=True
            elif byte==0x22: quoted=False
        elif byte==0x22: quoted=True
        elif byte==0x7b: depth+=1
        elif byte==0x7d:
            depth-=1
            if depth==0: return start,offset+1
    raise Rig("R15 JSON task row is unterminated")


def r15_expected_h038_refreeze_bytes(repo: Path, product_publication: str,
                                      binding: dict[str,object]) -> dict[str,bytes]:
    """Acyclic byte-exact five-file transform; review cannot authorize content."""
    raw_spec=r15_git_object_bytes(repo,product_publication,"specs/tasks.spec.json")
    if raw_spec is None:raise Rig("R15 H038 baseline spec")
    spec=strict_json_bytes(raw_spec)
    if not isinstance(spec,dict):raise Rig("R15 H038 baseline spec shape")
    rows=[row for row in spec.get("tasks",[]) if isinstance(row,dict) and row.get("id")=="h-038"]
    if len(rows)!=1 or rows[0].get("depends_on")!=["h-036"] or "h035_r15_published_authority" in rows[0]:
        raise Rig("R15 H038 baseline row")
    product_identity=(rows[0].get("h038_managed_attempt_root_confinement",{})
                      .get("product_identity"))
    if (not isinstance(product_identity,dict)
            or product_identity.get("candidate_relation")
               != "DIRECT_SINGLE_CHILD_OF_EXACT_PUBLISHED_H038_CONTRACT_BASE"
            or product_identity.get("remote_origin_main_states")!=[
                "PREPUBLICATION_EXACT_H038_CONTRACT_BASE",
                "POSTPUBLICATION_EXACT_TWO_PARENT_PRODUCT_MERGE_WITH_CANDIDATE_TREE"]):
        raise Rig("R15 H038 old product base semantics")
    row_start,row_end=r15_json_task_row_extent(raw_spec,"h-038")
    binding_sha=canonical_json_sha256(binding)
    row_raw=raw_spec[row_start:row_end]
    row_replacements=(
        (b'      "depends_on": [\n        "h-036"\n      ],',
         b'      "depends_on": [\n        "h-035",\n        "h-036"\n      ],'),
        (b'"candidate_relation": "DIRECT_SINGLE_CHILD_OF_EXACT_PUBLISHED_H038_CONTRACT_BASE"',
         b'"candidate_relation": "DIRECT_SINGLE_CHILD_OF_EXACT_GUARDED_H038_R15_DEPENDENCY_REFREEZE_MERGE"'),
        (b'"PREPUBLICATION_EXACT_H038_CONTRACT_BASE",',
         b'"PREPUBLICATION_EXACT_GUARDED_H038_R15_DEPENDENCY_REFREEZE_MERGE",'),
    )
    for old,new in row_replacements:
        if row_raw.count(old)!=1:raise Rig("R15 H038 spec transform anchor")
        row_raw=row_raw.replace(old,new,1)
    insert=b'      "max_changed_files": 3,\n'
    binding_text=json.dumps(binding,indent=2,ensure_ascii=False)
    binding_field=('      "h035_r15_published_authority": '
                   +binding_text.replace("\n","\n      ")+",\n").encode("utf-8")
    if row_raw.count(insert)!=1:raise Rig("R15 H038 binding insertion anchor")
    row_raw=row_raw.replace(insert,binding_field+insert,1)
    transformed_spec=raw_spec[:row_start]+row_raw+raw_spec[row_end:]
    transformed_doc=strict_json_bytes(transformed_spec)
    rows=[row for row in transformed_doc.get("tasks",[])
          if isinstance(row,dict) and row.get("id")=="h-038"] if isinstance(transformed_doc,dict) else []
    if len(rows)!=1:raise Rig("R15 transformed H038 row")
    values: dict[str,bytes]={
        "specs/tasks.spec.json":transformed_spec}
    suffixes={
        "docs/05-beslutslogg.md":(
            f"\n| H-038 R15 dependency refreeze | Exact guarded H-035 product publication {binding['product_publication_sha']} and binding {binding_sha}; H-038 product base becomes the guarded refreeze merge M. |\n"),
        "docs/loop/drift.md":(
            f"\n## H-038 R15 dependency-refreeze\n\nExact H-035 product publication `{binding['product_publication_sha']}` and binding `{binding_sha}` are the acyclic base; only the frozen five-path transform is admitted and the future product is a direct child of guarded refreeze merge M.\n"),
        "docs/loop/owner-author-workflow-v1.md":(
            f"\n## H-038 R15 dependency-refreeze handoff\n\nBind H-035 publication `{binding['product_publication_sha']}` / `{binding_sha}`, review the exact five-byte transform, publish M=[M0,R], then review the H-038 product only as a direct child of M.\n"),
    }
    for path,suffix in suffixes.items():
        baseline=r15_git_object_bytes(repo,product_publication,path)
        if baseline is None or not baseline.endswith(b"\n"):raise Rig("R15 H038 doc baseline "+path)
        values[path]=baseline+suffix.encode("utf-8")
    gate=r15_git_object_bytes(repo,product_publication,"verify/bin/h-038-exit")
    if gate is None or not gate.endswith(b"\n"):raise Rig("R15 H038 gate baseline")
    replacements=(
        (b'task.get("depends_on") == ["h-036"]',b'task.get("depends_on") == ["h-035", "h-036"]'),
        (b'== "DIRECT_SINGLE_CHILD_OF_EXACT_PUBLISHED_H038_CONTRACT_BASE"',b'== "DIRECT_SINGLE_CHILD_OF_EXACT_GUARDED_H038_R15_DEPENDENCY_REFREEZE_MERGE"'),
        (b'"PREPUBLICATION_EXACT_H038_CONTRACT_BASE",',b'"PREPUBLICATION_EXACT_GUARDED_H038_R15_DEPENDENCY_REFREEZE_MERGE",'),
    )
    for old,new in replacements:
        if gate.count(old)!=1:raise Rig("R15 H038 gate transform anchor")
        gate=gate.replace(old,new,1)
    h035_rows=[row for row in transformed_doc.get("tasks",[])
               if isinstance(row,dict) and row.get("id")=="h-035"]
    if len(h035_rows)!=1:raise Rig("R15 H035 transformed task cardinality")
    pin_replacements=(
        (b'"verify/bin/h-035-exit": "cae895110129f5066be9ae7f770e7f4e96594698ef5500d586820fea472d27e2"',
         ('"verify/bin/h-035-exit": "'+str(binding["gate_sha256"])+'"').encode()),
        (b'TASK_SHA256 = "c133ae2b9a7524c69108ccc7e6c8b5630dc3cde78c345159bbfcfd8e712a2171"',
         ('TASK_SHA256 = "'+canonical_json_sha256(rows[0])+'"').encode()),
        (b'H035_TASK_SHA256 = "f854ddc0b5ca05b87cbaf15431f58c59803be586d6d9ff67d14e40e8a5970f22"',
         ('H035_TASK_SHA256 = "'+canonical_json_sha256(h035_rows[0])+'"').encode()),
    )
    for old,new in pin_replacements:
        if gate.count(old)!=1:raise Rig("R15 H038 gate pin transform anchor")
        gate=gate.replace(old,new,1)
    artifact_anchor=b"\ndef product_identity(h37: dict[str, Any], binding: Any, old: dict[str, Any],\n"
    if gate.count(artifact_anchor)!=1:raise Rig("R15 H038 stable artifact helper anchor")
    artifact_helper=r'''
def r15_refreeze_artifact(path: Path) -> tuple[Any, bytes]:
    if not path.is_absolute() or Path(os.path.normpath(str(path))) != path:
        raise Rig("noncanonical R15 refreeze artifact path")
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    fds: list[int] = []
    leaf = -1
    try:
        parent = os.open(path.anchor, flags)
        fds.append(parent)
        links: list[tuple[int, str, int, tuple[int, int, int]]] = []
        for part in path.parts[1:-1]:
            before = os.stat(part, dir_fd=parent, follow_symlinks=False)
            child = os.open(part, flags, dir_fd=parent)
            opened = os.fstat(child)
            identity = (opened.st_dev, opened.st_ino, opened.st_mode)
            if not stat.S_ISDIR(opened.st_mode) or identity != (before.st_dev, before.st_ino, before.st_mode):
                raise Rig("R15 refreeze artifact ancestor race")
            links.append((parent, part, child, identity)); fds.append(child); parent = child
        before = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
        leaf = os.open(path.name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NONBLOCK", 0), dir_fd=parent)
        opened = os.fstat(leaf)
        fields = ("st_dev", "st_ino", "st_mode", "st_uid", "st_nlink", "st_size", "st_mtime_ns", "st_ctime_ns")
        identity = tuple(getattr(opened, field) for field in fields)
        if (tuple(getattr(before, field) for field in fields) != identity
                or not stat.S_ISREG(opened.st_mode) or opened.st_uid != os.getuid()
                or opened.st_nlink != 1 or stat.S_IMODE(opened.st_mode) not in (0o600, 0o644)
                or opened.st_size > 262144):
            raise Rig("unsafe R15 refreeze artifact")
        raw = b""; offset = 0
        while offset < opened.st_size:
            part = os.pread(leaf, min(65536, opened.st_size - offset), offset)
            if not part: raise Rig("short R15 refreeze artifact read")
            raw += part; offset += len(part)
        after = os.fstat(leaf); named = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
        if len(raw) != opened.st_size or tuple(getattr(after, field) for field in fields) != identity or tuple(getattr(named, field) for field in fields) != identity:
            raise Rig("R15 refreeze artifact replacement")
        for directory, part, child, want in links:
            current = os.stat(part, dir_fd=directory, follow_symlinks=False); held = os.fstat(child)
            if (current.st_dev, current.st_ino, current.st_mode) != want or (held.st_dev, held.st_ino, held.st_mode) != want:
                raise Rig("R15 refreeze artifact ancestor replacement")
        return strict_json(raw), raw
    finally:
        if leaf >= 0: os.close(leaf)
        for descriptor in reversed(fds): os.close(descriptor)
'''.encode("utf-8")
    gate=gate.replace(artifact_anchor,b"\n"+artifact_helper+artifact_anchor,1)
    topology_start=b"        contract_publication = False\n"
    topology_end=b'        numstat = h37["identity_git"](\n'
    if gate.count(topology_start)!=1 or gate.count(topology_end)!=1:
        raise Rig("R15 H038 product topology transform anchor")
    start=gate.index(topology_start); end=gate.index(topology_end,start)
    topology=r'''        contract_publication = False
        contract_candidate = ""
        contract_changes = []
        current_spec = strict_json(SPEC.read_bytes())
        current_rows = task_rows(current_spec, "h-038") if isinstance(current_spec, dict) else []
        published_binding = current_rows[0].get("h035_r15_published_authority") if len(current_rows) == 1 else None
        if len(base_record.parents) == 2 and isinstance(published_binding, dict):
            published_h035, refreeze_candidate = base_record.parents
            refreeze_record = h37["strict_commit_record"](binding, refreeze_candidate)
            refreeze_changes = commit_changes(
                h37, binding, published_h035, refreeze_candidate,
            )
            contract_candidate = refreeze_candidate
            contract_changes = refreeze_changes
            expected_refreeze_changes = {
                ("M", "specs/tasks.spec.json", "100644"),
                ("M", "verify/bin/h-038-exit", "100755"),
                ("M", "docs/loop/owner-author-workflow-v1.md", "100644"),
                ("M", "docs/05-beslutslogg.md", "100644"),
                ("M", "docs/loop/drift.md", "100644"),
            }
            review_path = Path(published_binding.get("review_path", "")).parent / (
                f"h038-r15-dependency-refreeze-review-{refreeze_candidate[:8]}.json"
            )
            receipt_path = Path(published_binding.get("review_path", "")).parent / (
                f"h038-r15-dependency-refreeze-publication-{base[:8]}.json"
            )
            review, review_raw = r15_refreeze_artifact(review_path)
            receipt, _receipt_raw = r15_refreeze_artifact(receipt_path)
            expected_review = {
                "schema_version": 1, "record_type": "nortropic_independent_h038_r15_refreeze_review",
                "role": "GATE_REVIEWER", "result": "PASS", "task": "h-038",
                "base_sha": published_h035, "candidate_sha": refreeze_candidate,
                "candidate_tree": refreeze_record.tree,
                "changed_files": sorted(TEST_AUTHOR_SURFACE), "blocking_findings": [],
            }
            expected_receipt = {
                "schema_version": 1, "record_type": "nortropic_publication_receipt",
                "phase": "H038_R15_DEPENDENCY_REFREEZE_PUBLICATION",
                "repository": published_binding.get("repository_identity"), "task_id": "h-038",
                "base_sha": published_h035, "candidate_sha": refreeze_candidate,
                "candidate_tree": refreeze_record.tree, "merge_sha": base,
                "merge_tree": refreeze_record.tree,
                "ordered_parents": [published_h035, refreeze_candidate],
                "independent_review_path": str(review_path),
                "independent_review_sha256": sha(review_raw),
                "force": False, "history_rewrite": False,
            }
            h035_runtime = runpy.run_path(
                str(H035_GATE), run_name="h038_frozen_h035_refreeze_renderer",
            )
            expected_refreeze = h035_runtime["r15_expected_h038_refreeze_bytes"](
                ROOT, published_h035, published_binding,
            )
            refreeze_bytes_equal = set(expected_refreeze) == set(TEST_AUTHOR_SURFACE) and all(
                h37["git_blob"](binding, refreeze_candidate, path)
                    == h37["git_blob"](binding, base, path)
                    == (ROOT / path).read_bytes()
                    == expected_refreeze[path]
                for path in TEST_AUTHOR_SURFACE
            )
            contract_publication = (
                published_binding.get("record_type") == "h035_r15_published_authority_v1"
                and type(published_binding.get("schema_version")) is int
                and published_binding.get("schema_version") == 1
                and published_binding.get("task") == "h-035"
                and published_binding.get("product_publication_sha") == published_h035
                and refreeze_record.parents == [published_h035]
                and base_record.tree == refreeze_record.tree
                and len(refreeze_changes) == len(expected_refreeze_changes)
                and set(refreeze_changes) == expected_refreeze_changes
                and refreeze_bytes_equal
                and review == expected_review and receipt == expected_receipt
            )
'''.encode("utf-8")
    gate=gate[:start]+topology+gate[end:]
    marker=("\n# H035_R15_REFREEZE_BINDING_V1 "
            +binding_sha+" "+str(binding["product_publication_sha"])+"\n").encode()
    values["verify/bin/h-038-exit"]=gate+marker
    return values


def r15_prepare_published_fixture(tmp: Path, product_base: str,
                                  product_candidate: str, *,
                                  source_repo: Path = ROOT) -> dict[str,object]:
    repo=tmp/"published-repo"
    clone=run(["/usr/bin/git","clone","--no-hardlinks","-q",str(source_repo),str(repo)],cwd=tmp)
    if clone.returncode: raise Rig(f"R15 fixture clone: {clone.stderr}")
    for key,value in (("user.name","H035 R15 Fixture"),("user.email","fixture@example.invalid")):
        configured=git(repo,"config",key,value)
        if configured.returncode: raise Rig(configured.stderr)
    checkout=git(repo,"checkout","-q",product_candidate)
    if checkout.returncode: raise Rig(checkout.stderr)
    remote=tmp/"published-origin.git"
    made=run(["/usr/bin/git","init","--bare","-q",str(remote)],cwd=tmp)
    if made.returncode: raise Rig(made.stderr)
    configured=git(repo,"remote","set-url","origin",str(remote.resolve()))
    if configured.returncode: raise Rig(configured.stderr)
    repository_identity=str(remote.resolve())

    product_tree=r15_git(repo,"rev-parse",f"{product_candidate}^{{tree}}").stdout.strip()
    contract_tree=r15_git(repo,"rev-parse",f"{product_base}^{{tree}}").stdout.strip()
    product_publication=r15_commit_tree(
        repo,product_tree,[product_base,product_candidate],"R15 guarded product publication")

    evidence=tmp/"evidence"; evidence.mkdir(mode=0o700)
    contract_commit=r15_git(repo,"cat-file","-p",product_base)
    contract_parents=[line.split(" ",1)[1] for line in contract_commit.stdout.splitlines()
                      if line.startswith("parent ")]
    if (contract_commit.returncode or len(contract_parents)!=2
            or contract_parents[0] not in {
                H035_R15_BASE,str(H035_R26_SUCCESSOR["authority_base_sha"])}):
        raise Rig("R15 fixture contract publication graph")
    contract_authority_base=contract_parents[0]
    contract_candidate=contract_parents[1]
    candidate_commit=r15_git(repo,"cat-file","-p",contract_candidate)
    candidate_parents=[line.split(" ",1)[1]
                       for line in candidate_commit.stdout.splitlines()
                       if line.startswith("parent ")]
    candidate_tree=r15_git(repo,"rev-parse",f"{contract_candidate}^{{tree}}").stdout.strip()
    if (candidate_commit.returncode or candidate_parents!=[contract_authority_base]
            or not r15_lower_hex(candidate_tree,40) or contract_tree!=candidate_tree):
        raise Rig("R15 fixture contract candidate relation")
    contract_tree=candidate_tree
    if contract_authority_base==H035_R15_BASE:
        contract_review_path=(evidence/"h035-r15-contract-review.json").resolve()
        write_json(contract_review_path,{
            "schema_version":1,"record_type":"nortropic_independent_h035_r15_contract_review",
            "role":"GATE_REVIEWER","result":"PASS","task":"h-035",
            "authority_base_sha":contract_authority_base,
            "contract_candidate_sha":contract_candidate,
            "contract_candidate_tree":contract_tree,"blocking_findings":[],
        }); contract_review_path.chmod(0o600)
        contract_phase="H035_R15_GUARDED_CONTRACT_PUBLICATION"
    else:
        exact_paths=list(sorted(H035_R15_TEST_AUTHOR_PATHS))
        lane_bindings=[]
        for lane,label in (("A","a"),("B","b")):
            lane_path=(evidence/f"h035-r26-gate-review-{label}.json").resolve()
            write_json(lane_path,{
                "schema_version":1,
                "record_type":"nortropic_independent_h035_r26_gate_review",
                "role":"GATE_REVIEWER","lane":lane,"result":"PASS","task":"h-035",
                "authority_base_sha":contract_authority_base,
                "contract_candidate_sha":contract_candidate,
                "contract_candidate_tree":contract_tree,
                "changed_files":exact_paths,"blocking_findings":[],
            }); lane_path.chmod(0o600)
            lane_bindings.append({
                "lane":lane,"path":str(lane_path),
                "sha256":hashlib.sha256(lane_path.read_bytes()).hexdigest(),
            })
        contract_review_path=(evidence/"h035-r26-dual-gate-review.json").resolve()
        write_json(contract_review_path,{
            "schema_version":1,
            "record_type":"nortropic_dual_h035_r26_gate_review_binding",
            "role":"DUAL_GATE_REVIEW_BINDING","result":"PASS","task":"h-035",
            "authority_base_sha":contract_authority_base,
            "contract_candidate_sha":contract_candidate,
            "contract_candidate_tree":contract_tree,
            "changed_files":exact_paths,"reviews":lane_bindings,"blocking_findings":[],
        }); contract_review_path.chmod(0o600)
        contract_phase="H035_R26_GUARDED_CONTRACT_PUBLICATION"
    contract_review_sha=hashlib.sha256(contract_review_path.read_bytes()).hexdigest()
    receipt_name=("h035-r15-contract-publication.json"
                  if contract_authority_base==H035_R15_BASE
                  else "h035-r26-contract-publication.json")
    contract_receipt_path=(evidence/receipt_name).resolve()
    write_json(contract_receipt_path,{
        "schema_version":1,"record_type":"nortropic_publication_receipt",
        "phase":contract_phase,"repository":repository_identity,
        "task_id":"h-035","base_sha":contract_authority_base,
        "candidate_sha":contract_candidate,
        "candidate_tree":contract_tree,"merge_sha":product_base,"merge_tree":contract_tree,
        "ordered_parents":[contract_authority_base,contract_candidate],
        "independent_review_path":str(contract_review_path),
        "independent_review_sha256":contract_review_sha,
        "force":False,"history_rewrite":False,
    }); contract_receipt_path.chmod(0o600)
    contract_receipt_sha=hashlib.sha256(contract_receipt_path.read_bytes()).hexdigest()
    review_path=(evidence/"h035-r15-product-review.json").resolve()
    review_sha=r15_review_file(review_path,task="h-035",base=product_base,
                               candidate_sha=product_candidate,candidate_tree=product_tree)
    receipt_path=(evidence/"h035-r15-product-publication.json").resolve()
    write_json(receipt_path,{
        "schema_version":1,"record_type":"nortropic_publication_receipt",
        "phase":"H035_R15_GUARDED_PRODUCT_PUBLICATION",
        "repository":repository_identity,"task_id":"h-035",
        "base_sha":product_base,"candidate_sha":product_candidate,
        "candidate_tree":product_tree,"merge_sha":product_publication,
        "merge_tree":product_tree,"ordered_parents":[product_base,product_candidate],
        "independent_review_path":str(review_path),
        "independent_review_sha256":review_sha,"force":False,"history_rewrite":False,
    }); receipt_path.chmod(0o600)
    receipt_sha=hashlib.sha256(receipt_path.read_bytes()).hexdigest()

    contract_spec=strict_json_bytes(
        r15_git_object_bytes(repo,product_base,"specs/tasks.spec.json") or b"")
    if not isinstance(contract_spec,dict): raise Rig("R15 fixture contract spec")
    h035_rows=[row for row in contract_spec.get("tasks",[])
               if isinstance(row,dict) and row.get("id")=="h-035"]
    if len(h035_rows)!=1 or not isinstance(h035_rows[0].get("r15_owner_product_lifecycle"),dict):
        raise Rig("R15 fixture contract manifest missing")
    contract_manifest_sha=canonical_json_sha256(h035_rows[0]["r15_owner_product_lifecycle"])
    gate_raw=r15_git_object_bytes(repo,product_base,"verify/bin/h-035-exit")
    if gate_raw is None: raise Rig("R15 fixture contract gate missing")
    gate_sha=hashlib.sha256(gate_raw).hexdigest()
    binding={
        "record_type":"h035_r15_published_authority_v1","schema_version":1,
        "task":"h-035","contract_merge_sha":product_base,
        "contract_tree":contract_tree,"contract_manifest_sha256":contract_manifest_sha,
        "product_candidate_sha":product_candidate,"product_tree":product_tree,
        "product_publication_sha":product_publication,
        "ordered_parents":[product_base,product_candidate],
        "product_paths_and_modes":[[path,"100755"] for path in H035_R15_PRODUCT_PATHS],
        "gate_path":"verify/bin/h-035-exit","gate_sha256":gate_sha,
        "review_path":str(review_path),"review_sha256":review_sha,
        "review_role":"PRODUCT_REVIEWER","review_result":"PASS","blocking_findings":[],
        "publication_receipt_path":str(receipt_path),
        "publication_receipt_sha256":receipt_sha,
        "contract_review_path":str(contract_review_path),
        "contract_review_sha256":contract_review_sha,
        "contract_publication_receipt_path":str(contract_receipt_path),
        "contract_publication_receipt_sha256":contract_receipt_sha,
        "repository_identity":repository_identity,
    }
    if tuple(binding) != R15_H038_BINDING_FIELDS:
        raise Rig("R15 fixture binding field order")

    checkout=git(repo,"checkout","-q",product_publication)
    if checkout.returncode: raise Rig(checkout.stderr)
    refreeze_paths=R15_H038_REFREEZE_PATHS
    for relative,raw in r15_expected_h038_refreeze_bytes(
            repo,product_publication,binding).items():
        path=repo/relative;path.write_bytes(raw)
    refreeze=commit_paths(repo,"H038 dependency and H035 R15 publication refreeze",
                          *refreeze_paths)
    refreeze_tree=r15_git(repo,"rev-parse",f"{refreeze}^{{tree}}").stdout.strip()
    refreeze_review_path=(
        evidence/f"h038-r15-dependency-refreeze-review-{refreeze[:8]}.json").resolve()
    write_json(refreeze_review_path,{
        "schema_version":1,
        "record_type":"nortropic_independent_h038_r15_refreeze_review",
        "role":"GATE_REVIEWER","result":"PASS","task":"h-038",
        "base_sha":product_publication,"candidate_sha":refreeze,
        "candidate_tree":refreeze_tree,"changed_files":list(refreeze_paths),
        "blocking_findings":[],
    }); refreeze_review_path.chmod(0o600)
    refreeze_review_sha=hashlib.sha256(refreeze_review_path.read_bytes()).hexdigest()
    current_main=r15_commit_tree(
        repo,refreeze_tree,[product_publication,refreeze],"H038 guarded refreeze publication")
    refreeze_receipt_path=(
        evidence/f"h038-r15-dependency-refreeze-publication-{current_main[:8]}.json").resolve()
    write_json(refreeze_receipt_path,{
        "schema_version":1,"record_type":"nortropic_publication_receipt",
        "phase":"H038_R15_DEPENDENCY_REFREEZE_PUBLICATION",
        "repository":repository_identity,"task_id":"h-038",
        "base_sha":product_publication,"candidate_sha":refreeze,
        "candidate_tree":refreeze_tree,"merge_sha":current_main,
        "merge_tree":refreeze_tree,"ordered_parents":[product_publication,refreeze],
        "independent_review_path":str(refreeze_review_path),
        "independent_review_sha256":refreeze_review_sha,
        "force":False,"history_rewrite":False,
    }); refreeze_receipt_path.chmod(0o600)
    set_remote_main(remote,repo,current_main)
    checkout=git(repo,"checkout","--detach","-q",current_main)
    if checkout.returncode: raise Rig(checkout.stderr)
    return {
        "repo":repo,"remote":remote,"repository_identity":repository_identity,
        "product_publication":product_publication,"h038_refreeze":refreeze,
        "current_main":current_main,"binding":binding,"review_path":review_path,
        "receipt_path":receipt_path,"h038_review_path":refreeze_review_path,
        "h038_receipt_path":refreeze_receipt_path,
        "contract_review_path":contract_review_path,
        "contract_receipt_path":contract_receipt_path,
    }


def r15_events(path: Path) -> list[dict[str,object]]:
    raw=path.read_bytes()
    if raw and not raw.endswith(b"\n"): raise ValueError("truncated events")
    values=[]
    for line in raw.splitlines():
        value=strict_json_bytes(line)
        if not isinstance(value,dict): raise ValueError("event not object")
        values.append(value)
    return values


def r15_h038_refreeze_proof(repo: Path, contract_review_path: Path,
                            contract_receipt_path: Path) -> tuple[bool,str]:
    """Prove the non-caller-selected H035 product and guarded H038 refreeze chain."""
    try:
        origin,current_main=r15_observed_remote_main(repo)
        main_commit=r15_git(repo,"cat-file","-p",current_main)
        main_parents=[line.split(" ",1)[1] for line in main_commit.stdout.splitlines()
                      if line.startswith("parent ")]
        if main_commit.returncode or len(main_parents)!=2:
            return False,"R15_H038_REFREEZE_GRAPH"
        product_publication,refreeze=main_parents
        refreeze_commit=r15_git(repo,"cat-file","-p",refreeze)
        refreeze_parents=[line.split(" ",1)[1] for line in refreeze_commit.stdout.splitlines()
                          if line.startswith("parent ")]
        if refreeze_commit.returncode or refreeze_parents!=[product_publication]:
            return False,"R15_H038_REFREEZE_DIRECT_CHILD"
        refreeze_tree=r15_git(repo,"rev-parse",f"{refreeze}^{{tree}}").stdout.strip()
        main_tree=r15_git(repo,"rev-parse",f"{current_main}^{{tree}}").stdout.strip()
        if not r15_lower_hex(refreeze_tree,40) or main_tree!=refreeze_tree:
            return False,"R15_H038_REFREEZE_TREE"

        expected_paths=(
            "docs/05-beslutslogg.md","docs/loop/drift.md",
            "docs/loop/owner-author-workflow-v1.md","specs/tasks.spec.json",
            "verify/bin/h-038-exit",
        )
        status=r15_git(repo,"diff","--name-status","--no-renames","--no-ext-diff",
                       "--no-textconv",product_publication,refreeze)
        if (status.returncode or status.stdout.splitlines()
                != [f"M\t{path}" for path in expected_paths]):
            return False,"R15_H038_REFREEZE_SCOPE"
        tree=r15_git(repo,"--literal-pathspecs","ls-tree",refreeze,"--",*expected_paths)
        observed={}
        for line in tree.stdout.splitlines():
            fields=line.split(None,3)
            if len(fields)==4: observed[fields[3]]=(fields[0],fields[1])
        expected_modes={path:("100755" if path=="verify/bin/h-038-exit" else "100644","blob")
                        for path in expected_paths}
        if tree.returncode or observed!=expected_modes:
            return False,"R15_H038_REFREEZE_MODES"

        before=strict_json_bytes(r15_git_object_bytes(
            repo,product_publication,"specs/tasks.spec.json") or b"")
        after=strict_json_bytes(r15_git_object_bytes(repo,refreeze,"specs/tasks.spec.json") or b"")
        if not isinstance(before,dict) or not isinstance(after,dict):
            return False,"R15_H038_REFREEZE_SPEC"
        before_rows=[row for row in before.get("tasks",[])
                     if isinstance(row,dict) and row.get("id")=="h-038"]
        after_rows=[row for row in after.get("tasks",[])
                    if isinstance(row,dict) and row.get("id")=="h-038"]
        if len(before_rows)!=1 or len(after_rows)!=1:
            return False,"R15_H038_REFREEZE_TASK_CARDINALITY"
        binding=after_rows[0].get("h035_r15_published_authority")
        if (after_rows[0].get("depends_on")!=["h-035","h-036"]
                or before_rows[0].get("depends_on")!=["h-036"]
                or "h035_r15_published_authority" in before_rows[0]
                or not isinstance(binding,dict)
                or set(binding)!=set(R15_H038_BINDING_FIELDS)):
            return False,"R15_H038_REFREEZE_SEMANTIC_DELTA"
        if (binding.get("record_type")!="h035_r15_published_authority_v1"
                or type(binding.get("schema_version")) is not int
                or binding.get("schema_version")!=1 or binding.get("task")!="h-035"
                or binding.get("product_publication_sha")!=product_publication
                or binding.get("repository_identity")!=origin):
            return False,"R15_H035_PRODUCT_BINDING"
        try:
            expected_bytes=r15_expected_h038_refreeze_bytes(
                repo,product_publication,binding)
        except (OSError,ValueError,AttributeError,KeyError,Rig) as exc:
            return False,"R15_H038_REFREEZE_EXPECTED_TRANSFORM:"+str(exc)
        for path,expected_raw in expected_bytes.items():
            if r15_git_object_bytes(repo,refreeze,path)!=expected_raw:
                return False,"R15_H038_REFREEZE_EXACT_BYTES:"+path

        contract_merge=binding.get("contract_merge_sha")
        product_candidate=binding.get("product_candidate_sha")
        if not isinstance(contract_merge,str) or not isinstance(product_candidate,str):
            return False,"R15_H035_PRODUCT_IDENTITIES"
        if (binding.get("contract_review_path")!=str(contract_review_path)
                or binding.get("contract_publication_receipt_path")
                   != str(contract_receipt_path)):
            return False,"R15_H035_CONTRACT_ARTIFACT_PATH_SUBSTITUTION"
        contract_ok,contract_candidate=r15_contract_publication_proof(
            repo,contract_merge,Path(str(binding.get("contract_review_path",""))),
            Path(str(binding.get("contract_publication_receipt_path",""))),
            observe_remote=False,judge_fixture_artifacts=True)
        if not contract_ok or not isinstance(contract_candidate,str):
            return False,"R15_H035_CONTRACT_PUBLICATION:"+str(contract_candidate)
        try:
            _value,_raw,bound_contract_review_sha=r15_safe_artifact(
                Path(str(binding["contract_review_path"])))
            _value,_raw,bound_contract_receipt_sha=r15_safe_artifact(
                Path(str(binding["contract_publication_receipt_path"])))
        except (OSError,ValueError,Rig,KeyError) as exc:
            return False,"R15_H035_CONTRACT_ARTIFACT_IDENTITY:"+str(exc)
        if (binding.get("contract_review_sha256")!=bound_contract_review_sha
                or binding.get("contract_publication_receipt_sha256")
                   != bound_contract_receipt_sha):
            return False,"R15_H035_CONTRACT_ARTIFACT_DIGEST"
        reference_sources=r15_reference_sources(repo,contract_merge)
        product_ok,_=r15_product_diff_scope(
            repo,contract_merge,product_candidate,reference_sources)
        product_commit=r15_git(repo,"cat-file","-p",product_publication)
        product_parents=[line.split(" ",1)[1] for line in product_commit.stdout.splitlines()
                         if line.startswith("parent ")]
        product_tree=r15_git(repo,"rev-parse",f"{product_candidate}^{{tree}}").stdout.strip()
        if (not product_ok or product_commit.returncode
                or product_parents!=[contract_merge,product_candidate]
                or r15_git(repo,"rev-parse",f"{product_publication}^{{tree}}").stdout.strip()!=product_tree
                or binding.get("product_tree")!=product_tree
                or binding.get("ordered_parents")!=[contract_merge,product_candidate]
                or binding.get("product_paths_and_modes")
                   != [[path,"100755"] for path in H035_R15_PRODUCT_PATHS]):
            return False,"R15_H035_PRODUCT_GRAPH_SCOPE"
        contract_tree=r15_git(repo,"rev-parse",f"{contract_merge}^{{tree}}").stdout.strip()
        contract_spec=strict_json_bytes(r15_git_object_bytes(
            repo,contract_merge,"specs/tasks.spec.json") or b"")
        contract_rows=[row for row in contract_spec.get("tasks",[])
                       if isinstance(row,dict) and row.get("id")=="h-035"]
        contract_manifest=(contract_rows[0].get("r15_owner_product_lifecycle")
                           if len(contract_rows)==1 else None)
        gate_raw=r15_git_object_bytes(repo,contract_merge,"verify/bin/h-035-exit")
        if (binding.get("contract_tree")!=contract_tree
                or not isinstance(contract_manifest,dict)
                or binding.get("contract_manifest_sha256")
                   != canonical_json_sha256(contract_manifest)
                or gate_raw is None or binding.get("gate_path")!="verify/bin/h-035-exit"
                or binding.get("gate_sha256")!=hashlib.sha256(gate_raw).hexdigest()):
            return False,"R15_H035_CONTRACT_BINDING"

        product_review_path=Path(str(binding.get("review_path","")))
        product_receipt_path=Path(str(binding.get("publication_receipt_path","")))
        product_review,_raw,product_review_sha=r15_safe_artifact(product_review_path)
        product_receipt,_raw,product_receipt_sha=r15_safe_artifact(product_receipt_path)
        expected_product_review={
            "schema_version":1,"record_type":"nortropic_independent_owner_product_review",
            "role":"PRODUCT_REVIEWER","result":"PASS","task":"h-035",
            "base_sha":contract_merge,"candidate_sha":product_candidate,
            "candidate_tree":product_tree,"blocking_findings":[],
        }
        expected_product_receipt={
            "schema_version":1,"record_type":"nortropic_publication_receipt",
            "phase":"H035_R15_GUARDED_PRODUCT_PUBLICATION","repository":origin,
            "task_id":"h-035","base_sha":contract_merge,
            "candidate_sha":product_candidate,"candidate_tree":product_tree,
            "merge_sha":product_publication,"merge_tree":product_tree,
            "ordered_parents":[contract_merge,product_candidate],
            "independent_review_path":str(product_review_path),
            "independent_review_sha256":product_review_sha,
            "force":False,"history_rewrite":False,
        }
        if (not r15_json_equal(product_review,expected_product_review)
                or not r15_json_equal(product_receipt,expected_product_receipt)
                or binding.get("review_sha256")!=product_review_sha
                or binding.get("publication_receipt_sha256")!=product_receipt_sha
                or binding.get("review_role")!="PRODUCT_REVIEWER"
                or binding.get("review_result")!="PASS"
                or binding.get("blocking_findings")!=[]):
            return False,"R15_H035_PRODUCT_ARTIFACTS"

        evidence_parent=product_review_path.parent
        review_path=(evidence_parent/
                     f"h038-r15-dependency-refreeze-review-{refreeze[:8]}.json").resolve()
        receipt_path=(evidence_parent/
                      f"h038-r15-dependency-refreeze-publication-{current_main[:8]}.json").resolve()
        review,_raw,review_sha=r15_safe_artifact(review_path)
        receipt,_raw,_receipt_sha=r15_safe_artifact(receipt_path)
        expected_review={
            "schema_version":1,
            "record_type":"nortropic_independent_h038_r15_refreeze_review",
            "role":"GATE_REVIEWER","result":"PASS","task":"h-038",
            "base_sha":product_publication,"candidate_sha":refreeze,
            "candidate_tree":refreeze_tree,"changed_files":list(expected_paths),
            "blocking_findings":[],
        }
        expected_receipt={
            "schema_version":1,"record_type":"nortropic_publication_receipt",
            "phase":"H038_R15_DEPENDENCY_REFREEZE_PUBLICATION",
            "repository":origin,"task_id":"h-038","base_sha":product_publication,
            "candidate_sha":refreeze,"candidate_tree":refreeze_tree,
            "merge_sha":current_main,"merge_tree":refreeze_tree,
            "ordered_parents":[product_publication,refreeze],
            "independent_review_path":str(review_path),
            "independent_review_sha256":review_sha,
            "force":False,"history_rewrite":False,
        }
        if not r15_json_equal(review,expected_review) or not r15_json_equal(receipt,expected_receipt):
            return False,"R15_H038_REFREEZE_ARTIFACTS"
        return True,"exact guarded H035 product then H038 dependency refreeze"
    except (OSError,ValueError,AttributeError,Rig) as exc:
        return False,"R15_H038_REFREEZE_PROOF:"+str(exc)


def r15_h038_closed_env() -> dict[str,str]:
    private_tmp=r15_private_tmpdir()
    return {"PATH":"/usr/bin:/bin","LANG":"C","LC_ALL":"C",
            "TMPDIR":private_tmp,"DARWIN_USER_TEMP_DIR":private_tmp}


def r15_run_rendered_h038(repo: Path, *args: str) -> subprocess.CompletedProcess:
    """Run the exact rendered gate while replacing only its material runtime lane.

    This judge-only runner exercises the gate's real static, Git, refreeze-artifact
    and product-identity control flow.  It cannot earn material H038 product credit:
    the injected runtime result deliberately keeps the operational label red.
    """
    gate=repo/"verify/bin/h-038-exit"
    first=gate.read_bytes().splitlines()[0]
    if not first.startswith(b"#!"):
        raise Rig("R15 rendered H038 shebang")
    python=Path(first[2:].decode("utf-8"))
    if not python.is_absolute() or not python.is_file() or python.is_symlink():
        raise Rig("R15 rendered H038 Python authority")
    program=r'''import runpy,sys
subject=sys.argv[1]
namespace=runpy.run_path(subject,run_name="h035_r15_h038_state_matrix")
namespace["main"].__globals__["runtime_matrix_with_bound_umask"]=(
    lambda *args,**kwargs:(True,False,{"judge_only":"identity_not_product_credit"})
)
raise SystemExit(namespace["main"](sys.argv[2:]))
'''
    return subprocess.run(
        [str(python),"-I","-S","-B","-c",program,str(gate),*args],cwd=repo,
        env=r15_h038_closed_env(),
        stdin=subprocess.DEVNULL,text=True,capture_output=True,shell=False,
        check=False,timeout=45)


def r15_h038_rendered_gate_controls(fixture: dict[str,object],
                                    cases: list[tuple[str,bool,str]]) -> None:
    """Execute rendered H038 across its exact R/M/Q/N authority states."""
    private_tmp=r15_private_tmpdir()
    expected_env={"PATH":"/usr/bin:/bin","LANG":"C","LC_ALL":"C",
                  "TMPDIR":private_tmp,"DARWIN_USER_TEMP_DIR":private_tmp}
    observed_env=r15_h038_closed_env()
    missing_env=dict(observed_env);missing_env.pop("TMPDIR")
    foreign_env=dict(observed_env);foreign_env["DARWIN_USER_TEMP_DIR"]="/tmp/requester-selected"
    gate_module=ast.parse(Path(__file__).read_text(encoding="utf-8"))
    runner_node=next((node for node in gate_module.body
                      if isinstance(node,ast.FunctionDef)
                      and node.name=="r15_run_rendered_h038"),None)
    runner_calls=[node for node in ast.walk(runner_node)
                  if isinstance(node,ast.Call) and isinstance(node.func,ast.Attribute)
                  and isinstance(node.func.value,ast.Name)
                  and node.func.value.id=="subprocess" and node.func.attr=="run"] if runner_node else []
    runner_returns=[node for node in ast.walk(runner_node)
                    if isinstance(node,ast.Return)] if runner_node else []
    runner_env_values=[keyword.value for node in runner_calls
                       for keyword in node.keywords if keyword.arg=="env"]
    expected_env_call=ast.dump(ast.parse("r15_h038_closed_env()",mode="eval").body,
                               include_attributes=False)
    probe_source=("import json,os;print(json.dumps({k:os.environ.get(k) for k in "
                  "('TMPDIR','DARWIN_USER_TEMP_DIR')},sort_keys=True,separators=(',',':')))" )
    def temp_probe(value: dict[str,str]) -> subprocess.CompletedProcess:
        return subprocess.run([sys.executable,"-I","-S","-B","-c",probe_source],
                              env=value,stdin=subprocess.DEVNULL,text=True,
                              capture_output=True,shell=False,check=False,timeout=10)
    exact_probe=temp_probe(observed_env);missing_probe=temp_probe(missing_env)
    foreign_probe=temp_probe(foreign_env)
    expected_probe=json.dumps({"TMPDIR":private_tmp,"DARWIN_USER_TEMP_DIR":private_tmp},
                              sort_keys=True,separators=(",",":"))+"\n"
    check(exact_value(observed_env,expected_env)
          and not exact_value(missing_env,expected_env)
          and not exact_value(foreign_env,expected_env)
          and len(runner_calls)==1 and len(runner_returns)==1
          and runner_returns[0].value is runner_calls[0] and len(runner_env_values)==1
          and ast.dump(runner_env_values[0],include_attributes=False)==expected_env_call
          and exact_probe.returncode==0 and exact_probe.stdout==expected_probe
          and missing_probe.stdout!=expected_probe and foreign_probe.stdout!=expected_probe,
          "J_R15_H038_RENDERED_RUNNER_EXACT_OS_PRIVATE_TEMP_AUTHORITY_CAUSAL")
    repo=fixture.get("repo");remote=fixture.get("remote")
    if not isinstance(repo,Path) or not isinstance(remote,Path):
        raise Rig("R15 rendered H038 fixture paths")
    product_publication=str(fixture["product_publication"])
    refreeze=str(fixture["h038_refreeze"]);current_main=str(fixture["current_main"])
    def record(name: str, ok: bool, result: subprocess.CompletedProcess) -> None:
        detail=(result.stderr or result.stdout)[-500:]
        cases.append((name,ok,detail))
        print(f"R15_CASE={name} RESULT={'PASS' if ok else 'FAIL'} {detail[:200]}")
    state_serial=[0]
    def state(head: str, origin: str, *args: str) -> subprocess.CompletedProcess:
        state_serial[0]+=1
        set_remote_main(remote,repo,origin)
        state_ref=f"refs/heads/r15-h038-state-{state_serial[0]}"
        pinned=r15_git(repo,"update-ref",state_ref,head)
        isolated=repo.parent/f"h038-rendered-state-{state_serial[0]}"
        cloned=run(["/usr/bin/git","clone","--no-hardlinks","-q",str(repo),str(isolated)],cwd=repo.parent)
        if pinned.returncode or cloned.returncode:
            raise Rig("R15 rendered H038 isolated state clone: "+pinned.stderr+cloned.stderr)
        configured=r15_git(isolated,"remote","set-url","origin",str(remote.resolve()))
        fetched=r15_git(isolated,"fetch","-q","--force","origin",
                        "main:refs/remotes/origin/main")
        checked=r15_git(isolated,"checkout","--detach","-q",head)
        if configured.returncode or fetched.returncode or checked.returncode:
            raise Rig("R15 rendered H038 state setup: "+configured.stderr+fetched.stderr+checked.stderr)
        return r15_run_rendered_h038(isolated,*args)
    def red(result: subprocess.CompletedProcess) -> bool:
        return (result.returncode==1
                and "H038_GATE_RESULT=RED_EXPECTED label=A_H038_MANAGED_ATTEMPT_ROOT_CONFINEMENT_OPERATIONAL reason=PUBLISHED_H036_CROSS_ATTEMPT_CONFINEMENT_ABSENT" in result.stdout)
    def identity(result: subprocess.CompletedProcess) -> bool:
        return (result.returncode==1
                and "PASS A_H038_EXACT_DIRECT_CHILD_THREE_FILE_PRODUCT_IDENTITY" in result.stdout
                and "FAIL A_H038_MANAGED_ATTEMPT_ROOT_CONFINEMENT_OPERATIONAL" in result.stdout)
    def rejects_identity(result: subprocess.CompletedProcess) -> bool:
        return (result.returncode!=0
                and "PASS A_H038_EXACT_DIRECT_CHILD_THREE_FILE_PRODUCT_IDENTITY" not in result.stdout)
    review_path=Path(str(fixture["h038_review_path"]))
    receipt_path=Path(str(fixture["h038_receipt_path"]))
    review_raw=review_path.read_bytes();receipt_raw=receipt_path.read_bytes()
    extra_artifacts: list[Path]=[]
    try:
        result=state(refreeze,product_publication)
        record("H038_RENDERED_REVIEW_R_REMOTE_M0_NOARGS_EXACT_RED",red(result),result)
        result=state(current_main,current_main)
        record("H038_RENDERED_PUBLISHED_M_NOARGS_EXACT_RED",red(result),result)

        namespace=runpy.run_path(str(repo/"verify/bin/h-038-exit"),
                                 run_name="h035_r15_h038_q_renderer")
        product_paths=tuple(namespace.get("PRODUCT_PATHS",()))
        if product_paths!=("controller/launch/cli","controller/launch/runtime_snapshot.py",
                          "config/python-runtime-authority-v2.json"):
            raise Rig("R15 rendered H038 product paths")
        launcher=(repo/product_paths[0]).read_bytes()+b"\n# H035_R15_IDENTITY_ONLY_Q\n"
        helper=(repo/product_paths[1]).read_bytes()+b"\n# H035_R15_IDENTITY_ONLY_Q\n"
        old=strict_json_bytes((repo/product_paths[2]).read_bytes())
        expected_config=namespace.get("expected_config")
        if not isinstance(old,dict) or not callable(expected_config):
            raise Rig("R15 rendered H038 config renderer")
        config=expected_config(old,hashlib.sha256(launcher).hexdigest(),
                               hashlib.sha256(helper).hexdigest())
        (repo/product_paths[0]).write_bytes(launcher)
        (repo/product_paths[1]).write_bytes(helper)
        (repo/product_paths[2]).write_bytes(canonical_json_bytes(config)+b"\n")
        candidate=commit_paths(repo,"H038 judge-only identity candidate",*product_paths)
        candidate_tree=r15_git(repo,"rev-parse",f"{candidate}^{{tree}}").stdout.strip()
        publication=r15_commit_tree(
            repo,candidate_tree,[current_main,candidate],"H038 judge-only product publication")

        result=state(candidate,current_main,"--product",current_main,candidate)
        record("H038_RENDERED_PRODUCT_Q_DIRECT_CHILD_OF_M_PREPUBLICATION_IDENTITY_PASS",
               identity(result),result)
        result=state(candidate,publication,"--product",current_main,candidate)
        record("H038_RENDERED_PRODUCT_Q_POSTPUBLICATION_N_ORDERED_M_Q_TREE_Q_IDENTITY_PASS",
               identity(result),result)

        contract_record=r15_git(repo,"cat-file","-p",str(fixture["binding"]["contract_merge_sha"]))
        contract_parents=[line.split(" ",1)[1] for line in contract_record.stdout.splitlines()
                          if line.startswith("parent ")]
        if contract_record.returncode or len(contract_parents)!=2:
            raise Rig("R15 rendered H038 contract parents")
        for label,old_base in (
            ("AUTHORITY_408923",H035_R15_BASE),("CONTRACT_CANDIDATE_A",contract_parents[1]),
            ("CONTRACT_MERGE_C",str(fixture["binding"]["contract_merge_sha"])),
            ("H035_PRODUCT_CANDIDATE_P",str(fixture["binding"]["product_candidate_sha"])),
            ("H035_PRODUCT_PUBLICATION_M0",product_publication),("REFREEZE_CANDIDATE_R",refreeze),
        ):
            result=state(candidate,current_main,"--product",old_base,candidate)
            record("H038_RENDERED_REJECT_OLD_PRODUCT_BASE_"+label,
                   rejects_identity(result),result)

        wrong_parent=r15_commit_tree(
            repo,candidate_tree,[product_publication],"H038 wrong-parent product")
        result=state(wrong_parent,current_main,"--product",current_main,wrong_parent)
        record("H038_RENDERED_REJECT_Q_WRONG_PARENT",rejects_identity(result),result)
        reversed_publication=r15_commit_tree(
            repo,candidate_tree,[candidate,current_main],"H038 reversed product publication")
        result=state(candidate,reversed_publication,"--product",current_main,candidate)
        record("H038_RENDERED_REJECT_N_REVERSED_PARENTS",rejects_identity(result),result)
        refreeze_tree=r15_git(repo,"rev-parse",f"{current_main}^{{tree}}").stdout.strip()
        wrong_tree_publication=r15_commit_tree(
            repo,refreeze_tree,[current_main,candidate],"H038 wrong-tree product publication")
        result=state(candidate,wrong_tree_publication,"--product",current_main,candidate)
        record("H038_RENDERED_REJECT_N_WRONG_TREE",rejects_identity(result),result)

        review=strict_json_bytes(review_raw)
        if not isinstance(review,dict):raise Rig("R15 H038 review fixture")
        review["result"]="FAIL";write_json(review_path,review);review_path.chmod(0o600)
        result=state(candidate,current_main,"--product",current_main,candidate)
        record("H038_RENDERED_REJECT_REFREEZE_REVIEW_ARTIFACT_DEFECT",
               rejects_identity(result),result)
        review_path.write_bytes(review_raw);review_path.chmod(0o600)
        receipt=strict_json_bytes(receipt_raw)
        if not isinstance(receipt,dict):raise Rig("R15 H038 receipt fixture")
        receipt["ordered_parents"]=list(reversed(receipt["ordered_parents"]))
        write_json(receipt_path,receipt);receipt_path.chmod(0o600)
        result=state(candidate,current_main,"--product",current_main,candidate)
        record("H038_RENDERED_REJECT_REFREEZE_RECEIPT_ARTIFACT_DEFECT",
               rejects_identity(result),result)
        receipt_path.write_bytes(receipt_raw);receipt_path.chmod(0o600)

        checked=r15_git(repo,"checkout","--detach","-q",product_publication)
        if checked.returncode:raise Rig("R15 H038 byte mutant checkout: "+checked.stderr)
        expected_bytes=r15_expected_h038_refreeze_bytes(
            repo,product_publication,fixture["binding"])
        for relative,raw in expected_bytes.items():
            (repo/relative).write_bytes(raw)
        (repo/"docs/loop/drift.md").write_bytes(
            expected_bytes["docs/loop/drift.md"]+b"H038_REVIEW_CANNOT_AUTHORIZE_EXTRA_BYTE\n")
        bad_refreeze=commit_paths(
            repo,"H038 one-byte-extra refreeze mutant",*R15_H038_REFREEZE_PATHS)
        bad_tree=r15_git(repo,"rev-parse",f"{bad_refreeze}^{{tree}}").stdout.strip()
        evidence=review_path.parent
        bad_review=(evidence/f"h038-r15-dependency-refreeze-review-{bad_refreeze[:8]}.json").resolve()
        extra_artifacts.append(bad_review)
        write_json(bad_review,{
            "schema_version":1,
            "record_type":"nortropic_independent_h038_r15_refreeze_review",
            "role":"GATE_REVIEWER","result":"PASS","task":"h-038",
            "base_sha":product_publication,"candidate_sha":bad_refreeze,
            "candidate_tree":bad_tree,"changed_files":list(R15_H038_REFREEZE_PATHS),
            "blocking_findings":[],
        });bad_review.chmod(0o600)
        bad_main=r15_commit_tree(
            repo,bad_tree,[product_publication,bad_refreeze],
            "H038 one-byte-extra guarded refreeze mutant")
        bad_receipt=(evidence/f"h038-r15-dependency-refreeze-publication-{bad_main[:8]}.json").resolve()
        extra_artifacts.append(bad_receipt)
        write_json(bad_receipt,{
            "schema_version":1,"record_type":"nortropic_publication_receipt",
            "phase":"H038_R15_DEPENDENCY_REFREEZE_PUBLICATION",
            "repository":str(fixture["repository_identity"]),"task_id":"h-038",
            "base_sha":product_publication,"candidate_sha":bad_refreeze,
            "candidate_tree":bad_tree,"merge_sha":bad_main,"merge_tree":bad_tree,
            "ordered_parents":[product_publication,bad_refreeze],
            "independent_review_path":str(bad_review),
            "independent_review_sha256":hashlib.sha256(bad_review.read_bytes()).hexdigest(),
            "force":False,"history_rewrite":False,
        });bad_receipt.chmod(0o600)
        checked=r15_git(repo,"checkout","--detach","-q",bad_main)
        if checked.returncode:raise Rig("R15 H038 bad publication checkout: "+checked.stderr)
        for relative in product_paths:
            raw=r15_git_object_bytes(repo,candidate,relative)
            if raw is None:raise Rig("R15 H038 identity candidate blob")
            (repo/relative).write_bytes(raw)
        bad_candidate=commit_paths(
            repo,"H038 product on nonminimal refreeze",*product_paths)
        result=state(bad_candidate,bad_main,"--product",bad_main,bad_candidate)
        record("H038_RENDERED_REJECT_REVIEWED_NONMINIMAL_REFREEZE_BYTES",
               rejects_identity(result),result)
    finally:
        review_path.write_bytes(review_raw);review_path.chmod(0o600)
        receipt_path.write_bytes(receipt_raw);receipt_path.chmod(0o600)
        for artifact in extra_artifacts:
            try:artifact.unlink()
            except FileNotFoundError:pass
        set_remote_main(remote,repo,current_main)
        r15_git(repo,"fetch","-q","--force","origin",
                "main:refs/remotes/origin/main")
        r15_git(repo,"checkout","--detach","-q",current_main)


def r15_review_stat_identity(path: Path) -> str:
    info=os.lstat(path)
    return canonical_json_sha256({
        "record_type":"owner_review_stat_v1","review_path":str(path.resolve(strict=True)),
        "st_dev":info.st_dev,"st_ino":info.st_ino,"st_mode":info.st_mode,
        "st_uid":info.st_uid,"st_nlink":info.st_nlink,"st_size":info.st_size,
        "st_mtime_ns":info.st_mtime_ns,"st_ctime_ns":info.st_ctime_ns,
    })


def r15_workspace_identity(path: Path) -> str:
    path=Path(path)
    if not path.is_absolute() or Path(os.path.normpath(str(path)))!=path:
        raise Rig("R15 workspace canonical path")
    ancestors=[];current=Path(path.anchor)
    for part in path.parts[1:-1]:
        info=os.lstat(current);ancestors.append([
            str(current),info.st_dev,info.st_ino,info.st_mode,info.st_uid])
        current/=part
    parent=os.lstat(path.parent);ancestors.append([
        str(path.parent),parent.st_dev,parent.st_ino,parent.st_mode,parent.st_uid])
    leaf=os.lstat(path)
    return canonical_json_sha256({
        "record_type":"owner_workspace_v1","workspace_root":str(path),
        "ancestors":ancestors,
        "leaf":[leaf.st_dev,leaf.st_ino,leaf.st_mode,leaf.st_uid,leaf.st_nlink],
    })


def r15_bootstrap_claim_controls(tmp: Path, fixture: dict[str,object],
                                 cases: list[tuple[str,bool,str]]) -> dict[str,object]:
    tmp=tmp.resolve()
    repo=fixture["repo"]
    if not isinstance(repo,Path): raise Rig("R15 fixture repo type")
    remote=fixture["remote"]
    if not isinstance(remote,Path): raise Rig("R15 fixture remote type")
    spec=(repo/"specs/tasks.spec.json").resolve()
    taskval="controller/taskval/cli"
    current_main=str(fixture["current_main"])
    spec_raw=r15_git_object_bytes(repo,current_main,"specs/tasks.spec.json")
    registry_raw=r15_git_object_bytes(repo,current_main,"specs/owner-production-paths.v1.json")
    if spec_raw is None or registry_raw is None: raise Rig("R15 current-main authority objects")
    spec_doc=strict_json_bytes(spec_raw)
    if not isinstance(spec_doc,dict): raise Rig("R15 current-main spec object")
    task_rows=spec_doc.get("tasks",[])
    h038_rows=[row for row in task_rows if isinstance(row,dict) and row.get("id")=="h-038"]
    if len(h038_rows)!=1 or not isinstance(h038_rows[0].get("exit_test"),str):
        raise Rig("R15 current-main H038 gate")
    gate_path=str(h038_rows[0]["exit_test"])
    gate_raw=r15_git_object_bytes(repo,current_main,gate_path)
    if gate_raw is None: raise Rig("R15 current-main H038 gate object")
    expected_events=[{"task":row["id"],"status":"bootstrap_serialized"}
                     for row in task_rows if isinstance(row,dict) and row.get("id")!="h-038"]
    expected_events_raw=b"".join(canonical_json_bytes(event)+b"\n"
                                 for event in expected_events)
    authority_objects={
        "specs/tasks.spec.json":spec_raw,
        "specs/owner-production-paths.v1.json":registry_raw,
        gate_path:gate_raw,
    }
    repo_before=r15_repository_authority_snapshot(repo,remote)
    def authority_unchanged(expected_snapshot: dict[str,object] | None = None) -> bool:
        try:
            return (all((repo/path).read_bytes()==raw for path,raw in authority_objects.items())
                    and all(r15_git_object_bytes(repo,current_main,path)==raw
                            for path,raw in authority_objects.items())
                    and r15_repository_authority_snapshot(repo,remote)
                        == (expected_snapshot if expected_snapshot is not None else repo_before))
        except OSError:
            return False
    def record(name: str, ok: bool, detail: str = "",
               expected_snapshot: dict[str,object] | None = None) -> None:
        ok=ok and authority_unchanged(expected_snapshot)
        cases.append((name,ok,detail))
        print(f"R15_CASE={name} RESULT={'PASS' if ok else 'FAIL'} {detail[:200]}")
    def trace_rows(path: Path) -> list[object]:
        try:return [strict_json_bytes(line) for line in path.read_bytes().splitlines()]
        except (OSError,ValueError,UnicodeError):return []
    def bootstrap(bundle: Path, spec_arg: Path = spec,
                  attest: Path | None = None, state: Path | None = None,
                  env: dict[str,str] | None = None) -> subprocess.CompletedProcess:
        return r15_cli(repo,taskval,"bootstrap-serialized",str(spec_arg),
                       str(attest or bundle/"attest"),str(state or bundle/"state"),
                       env_extra=env)

    refreeze_ok,refreeze_why=r15_h038_refreeze_proof(
        repo,Path(str(fixture["contract_review_path"])),
        Path(str(fixture["contract_receipt_path"])))
    record("GUARDED_H035_PRODUCT_AND_H038_EXACT_REFREEZE_PUBLICATION_PROOF",
           refreeze_ok,refreeze_why)

    swapped=tmp/"bootstrap-swapped"
    result=bootstrap(swapped,attest=swapped/"state",state=swapped/"attest")
    record("BOOTSTRAP_FIXED_SIBLING_ORDER_REJECT",
           result.returncode!=0 and not swapped.exists(),result.stderr)
    same=tmp/"bootstrap-same"
    result=bootstrap(same,attest=same/"attest",state=same/"attest")
    record("BOOTSTRAP_EQUAL_ROOT_REJECT",
           result.returncode!=0 and not same.exists(),result.stderr)
    partial=tmp/"bootstrap-partial"; partial.mkdir(mode=0o700); (partial/"state").mkdir(mode=0o700)
    before=filesystem_snapshot(partial); result=bootstrap(partial)
    record("BOOTSTRAP_PARTIAL_BUNDLE_REJECT_UNCHANGED",
           result.returncode!=0 and filesystem_snapshot(partial)==before,result.stderr)
    real=tmp/"bootstrap-real"; real.mkdir(mode=0o700)
    linked=tmp/"bootstrap-linked"; linked.symlink_to(real)
    result=bootstrap(linked)
    record("BOOTSTRAP_SYMLINK_BUNDLE_REJECT_PRESERVE",
           result.returncode!=0 and linked.is_symlink() and not list(real.iterdir()),result.stderr)
    alternate=tmp/"alternate-spec.json"; alternate.write_bytes(spec.read_bytes())
    alternate_bundle=tmp/"bootstrap-alternate-spec"
    result=bootstrap(alternate_bundle,alternate)
    record("BOOTSTRAP_ALTERNATE_SPEC_REJECT_NO_ROOT",
           result.returncode!=0 and not alternate_bundle.exists(),result.stderr)
    spec_link=tmp/"spec-link.json"; spec_link.symlink_to(spec)
    link_bundle=tmp/"bootstrap-spec-link"; result=bootstrap(link_bundle,spec_link)
    record("BOOTSTRAP_SYMLINK_SPEC_REJECT_NO_ROOT",
           result.returncode!=0 and not link_bundle.exists(),result.stderr)
    unsafe_parent=tmp/"unsafe-parent"; unsafe_parent.mkdir(); unsafe_parent.chmod(0o777)
    unsafe_bundle=unsafe_parent/"bundle"; result=bootstrap(unsafe_bundle)
    record("BOOTSTRAP_UNSAFE_PARENT_REJECT_NO_ROOT",
           result.returncode!=0 and not unsafe_bundle.exists(),result.stderr)

    bundle=tmp/"bootstrap-bundle"
    bootstrap_trace=tmp/"dispatch-valid-taskval-bootstrap.jsonl"
    result=r15_cli_runpy_fault(
        repo,taskval,["bootstrap-serialized",str(spec),str(bundle/"attest"),str(bundle/"state")],
        stdin=None,fault="trace_runtime_exports",target=bootstrap_trace)
    bootstrap_argv=["bootstrap-serialized",str(spec),str(bundle/"attest"),str(bundle/"state")]
    bootstrap_export=(trace_rows(bootstrap_trace)==r15_expected_export_trace(
        "taskval_main",bootstrap_argv,stdin=None,result=0))
    state=bundle/"state"; attest=bundle/"attest"
    try:
        events_raw=(state/"events.jsonl").read_bytes()
        events=r15_events(state/"events.jsonl")
        store_raw=(attest/"attestations.json").read_bytes()
        store=strict_json_bytes(store_raw)
        h035=store.get("attestations",{}).get("h-035") if isinstance(store,dict) else None
        h036=store.get("attestations",{}).get("h-036") if isinstance(store,dict) else None
        h036_ok=r15_owner_publication_valid(
            h036,task="h-036",repository_identity=str(fixture["repository_identity"]))[0]
        manifest_raw=[(root/"bootstrap-manifest.json").read_bytes()
                      for root in (state,attest)]
        manifests=[strict_json_bytes(raw) for raw in manifest_raw]
        state_db_raw=(state/"state.db").read_bytes()
        state_shadow_raw=(state/".r15-state-db-shadow").read_bytes()
        attest_shadow_raw=(attest/".r15-attest-shadow").read_bytes()
        recovery_raw=(attest/".r15-attest-recovery.jsonl").read_bytes()
        expected_manifest={
            "record_type":"h035_r15_bootstrap_roots_v1","schema_version":1,
            "repository_identity":str(fixture["repository_identity"]),
            "current_main":current_main,"bundle_root":str(bundle.resolve(strict=True)),
            "bundle_root_dev_ino":[os.lstat(bundle).st_dev,os.lstat(bundle).st_ino],
            "state_root":str(state.resolve(strict=True)),
            "state_root_dev_ino":[os.lstat(state).st_dev,os.lstat(state).st_ino],
            "attest_root":str(attest.resolve(strict=True)),
            "attest_root_dev_ino":[os.lstat(attest).st_dev,os.lstat(attest).st_ino],
            "state_manifest_dev_ino":[os.lstat(state/"bootstrap-manifest.json").st_dev,
                                       os.lstat(state/"bootstrap-manifest.json").st_ino],
            "attest_manifest_dev_ino":[os.lstat(attest/"bootstrap-manifest.json").st_dev,
                                        os.lstat(attest/"bootstrap-manifest.json").st_ino],
            "state_lock_dev_ino":[os.lstat(state/".r15-owner.lock").st_dev,
                                   os.lstat(state/".r15-owner.lock").st_ino],
            "attest_lock_dev_ino":[os.lstat(attest/".r15-attest.lock").st_dev,
                                    os.lstat(attest/".r15-attest.lock").st_ino],
            "state_event_log_dev_ino":[os.lstat(state/"events.jsonl").st_dev,
                                        os.lstat(state/"events.jsonl").st_ino],
            "state_db_slot_dev_inos":sorted([
                [os.lstat(state/"state.db").st_dev,os.lstat(state/"state.db").st_ino],
                [os.lstat(state/".r15-state-db-shadow").st_dev,
                 os.lstat(state/".r15-state-db-shadow").st_ino]]),
            "attestation_store_slot_dev_inos":sorted([
                [os.lstat(attest/"attestations.json").st_dev,
                 os.lstat(attest/"attestations.json").st_ino],
                [os.lstat(attest/".r15-attest-shadow").st_dev,
                 os.lstat(attest/".r15-attest-shadow").st_ino]]),
            "attest_recovery_log_dev_ino":[os.lstat(attest/".r15-attest-recovery.jsonl").st_dev,
                                            os.lstat(attest/".r15-attest-recovery.jsonl").st_ino],
            "h038_refreeze_binding_sha256":canonical_json_sha256(fixture["binding"]),
            "bootstrap_event_stream_sha256":hashlib.sha256(events_raw).hexdigest(),
            "bootstrap_state_db_sha256":hashlib.sha256(state_db_raw).hexdigest(),
            "bootstrap_state_db_shadow_sha256":hashlib.sha256(state_shadow_raw).hexdigest(),
            "bootstrap_attestation_store_sha256":hashlib.sha256(store_raw).hexdigest(),
            "bootstrap_attestation_store_shadow_sha256":hashlib.sha256(attest_shadow_raw).hexdigest(),
            "bootstrap_attest_recovery_log_sha256":hashlib.sha256(recovery_raw).hexdigest(),
        }
        expected_manifest_raw=canonical_json_bytes(expected_manifest)+b"\n"
        manifest_ok=(all(r15_json_equal(value,expected_manifest) for value in manifests)
                     and manifest_raw==[expected_manifest_raw,expected_manifest_raw])
        dump=r15_cli(repo,"controller/state/cli","dump",str(state))
        rebuild=r15_cli(repo,"controller/state/cli","rebuild",str(state))
        state_info=os.lstat(state/"state.db")
        persistent_infos=[os.lstat(path) for path in (
            state/"state.db",state/".r15-state-db-shadow",state/"events.jsonl",
            state/".r15-owner.lock",state/"bootstrap-manifest.json",
            attest/"attestations.json",attest/".r15-attest-shadow",
            attest/".r15-attest-recovery.jsonl",attest/".r15-attest.lock",
            attest/"bootstrap-manifest.json")]
        bootstrap_ok=(result.returncode==0 and stat.S_IMODE(bundle.stat().st_mode)==0o700
                      and stat.S_IMODE(state.stat().st_mode)==0o700
                      and stat.S_IMODE(attest.stat().st_mode)==0o700
                      and stat.S_ISREG(state_info.st_mode)
                      and state_info.st_uid==os.getuid()
                      and stat.S_IMODE(state_info.st_mode)==0o600 and state_info.st_nlink==1
                      and set(os.listdir(state))=={".r15-owner.lock",".r15-state-db-shadow",
                                                   "bootstrap-manifest.json","events.jsonl","state.db"}
                      and set(os.listdir(attest))=={".r15-attest-recovery.jsonl",
                                                    ".r15-attest-shadow",".r15-attest.lock",
                                                    "attestations.json","bootstrap-manifest.json"}
                      and all(stat.S_ISREG(info.st_mode) and info.st_uid==os.getuid()
                              and info.st_nlink==1 and stat.S_IMODE(info.st_mode)==0o600
                              for info in persistent_infos)
                      and state_shadow_raw==b"" and attest_shadow_raw==b"" and recovery_raw==b""
                      and not (state/"current.json").exists()
                      and events_raw==expected_events_raw and events==expected_events
                      and dump.returncode==0 and rebuild.returncode==0
                      and dump.stdout==rebuild.stdout
                      and isinstance(store,dict) and set(store)=={"attestations","omtest_ko","invalidated_shas"}
                      and r15_json_equal(h035,{"task":"h-035","candidate_sha":current_main,
                                  "invalidates_on":[current_main],"stale":False})
                      and h036_ok and store.get("invalidated_shas")==[] and manifest_ok)
    except (OSError,ValueError,AttributeError) as exc:
        bootstrap_ok=False; h035=h036=None; store={}; events=[]
        result=subprocess.CompletedProcess([],1,"",str(exc))
    record("BOOTSTRAP_EXACT_RAW_EVENTS_STATE_PROJECTION_H035_ORDINARY_H036_RICH_AND_MANIFESTS",
           bootstrap_ok,result.stderr)
    snapshot=filesystem_snapshot(bundle); retry=bootstrap(bundle)
    record("BOOTSTRAP_EXACT_COMPLETED_BUNDLE_RETRY_IDEMPOTENT",
           retry.returncode==0 and filesystem_snapshot(bundle)==snapshot,retry.stderr)
    residue=bundle.parent/(".r15-bootstrap-"+"a"*64)
    residue.write_bytes(b"foreign-preserved\n");residue.chmod(0o600)
    residue_before=filesystem_snapshot(residue);bundle_before=filesystem_snapshot(bundle)
    poisoned=bootstrap(bundle)
    record("BOOTSTRAP_RESERVED_TEMP_RESIDUE_POISONS_COMPLETED_RETRY_PRESERVED",
           poisoned.returncode!=0 and "INDETERMINATE_PRESERVED" in poisoned.stderr
           and filesystem_snapshot(residue)==residue_before
           and filesystem_snapshot(bundle)==bundle_before,poisoned.stderr)
    residue.unlink()
    resumed=bootstrap(bundle)
    record("BOOTSTRAP_JUDGE_REMOVED_FOREIGN_FIXTURE_THEN_EXACT_RETRY_POSITIVE",
           resumed.returncode==0 and filesystem_snapshot(bundle)==snapshot,resumed.stderr)

    # A legitimate current-store evolution does not rewrite immutable baseline provenance.
    store_path=attest/"attestations.json"
    state_manifest=state/"bootstrap-manifest.json"; attest_manifest=attest/"bootstrap-manifest.json"
    initial_store=store_path.read_bytes()
    initial_shadow=(attest/".r15-attest-shadow").read_bytes()
    initial_recovery=(attest/".r15-attest-recovery.jsonl").read_bytes()
    initial_manifest=state_manifest.read_bytes()
    evolved=r15_cli(repo,"controller/attest/cli",str(attest),"write",
                    "h-001","f"*40)
    evolved_store=store_path.read_bytes()
    pristine=(evolved_store,state_manifest.read_bytes(),attest_manifest.read_bytes(),
              (attest/".r15-attest-shadow").read_bytes(),
              (attest/".r15-attest-recovery.jsonl").read_bytes())
    state_before=(state/"events.jsonl").read_bytes()
    dependency_mutants=(
        ("ORDINARY","WRONG_RECORD_TYPE",lambda d:d["attestations"].__setitem__("h-036",{
            "task":"h-036","candidate_sha":R15_H036["candidate_sha"],
            "invalidates_on":[R15_H036["candidate_sha"]],"stale":False})),
        ("STALE","STALE",lambda d:(
            d["attestations"]["h-036"].__setitem__("stale",True),
            d["invalidated_shas"].append(str(R15_H036["candidate_sha"])),
            d["invalidated_shas"].sort(),d["omtest_ko"].append("h-036"))),
        ("CROSS_REPOSITORY","REPOSITORY",lambda d:d["attestations"]["h-036"].__setitem__(
            "repository_identity","/copied/repository.git")),
        ("CROSS_TASK","TASK",lambda d:d["attestations"]["h-036"].__setitem__("task","h-034")),
        ("IDENTITY","GRAPH_OR_IDENTITY",lambda d:d["attestations"]["h-036"].__setitem__(
            "candidate_identity","0"*64)),
    )
    attest_fixture=runpy.run_path(str(repo/"controller/attest/cli"),run_name="h035_dependency_fixture")
    def install_invalid_dependency(mutant: dict[str,object], label: str) -> bool:
        old=pristine[0];new=canonical_json_bytes(mutant)+b"\n";prefix=pristine[4]
        before=(filesystem_snapshot(bundle),r15_repository_authority_snapshot(repo,remote),
                store_path.read_bytes(),
                (attest/".r15-attest-shadow").read_bytes(),
                (attest/".r15-attest-recovery.jsonl").read_bytes())
        expected_product_problem={"ORDINARY":"ordinary record task class",
            "CROSS_TASK":"attestation record schema","CROSS_REPOSITORY":"historical H036 record identity",
            "IDENTITY":"historical H036 record identity"}[label]
        product_problem=""
        try:
            with attest_fixture["locked"](attest/".r15-attest.lock"):
                attest_fixture["atomic"](store_path,mutant,
                    {"record_type":"h035_r15_attest_request_v1","command":"write",
                     "argv":["h-036-fixture",label],"stdin":None})
        except attest_fixture["Stop"] as exc:product_problem=str(exc)
        if before!=(filesystem_snapshot(bundle),r15_repository_authority_snapshot(repo,remote),
                   store_path.read_bytes(),
                   (attest/".r15-attest-shadow").read_bytes(),
                   (attest/".r15-attest-recovery.jsonl").read_bytes()):return False
        manifest_raw=attest_manifest.read_bytes();ma=strict_json_bytes(manifest_raw)
        request={"record_type":"h035_r15_attest_request_v1","command":"write",
                 "argv":["h-036-fixture",label],"stdin":None}
        prefix_lines=prefix.splitlines(keepends=True);sequence=len(prefix_lines)+1
        request_sha=canonical_json_sha256(request);manifest_sha=hashlib.sha256(manifest_raw).hexdigest()
        old_sha=hashlib.sha256(old).hexdigest();new_sha=hashlib.sha256(new).hexdigest()
        operation={"record_type":"h035_r15_attest_operation_v1","command":"write",
            "task":"h-036-fixture","request_sha256":request_sha,"manifest_sha256":manifest_sha,
            "attest_root_dev_ino":ma["attest_root_dev_ino"],
            "attest_manifest_dev_ino":ma["attest_manifest_dev_ino"],
            "attest_lock_dev_ino":ma["attest_lock_dev_ino"],
            "attestation_store_slot_dev_inos":ma["attestation_store_slot_dev_inos"],
            "attest_recovery_log_dev_ino":ma["attest_recovery_log_dev_ino"],
            "pending_sequence":sequence,"old_store_sha256":old_sha,"new_store_sha256":new_sha}
        pending={"record_type":"h035_r15_attest_recovery_v1","schema_version":1,
            "sequence":sequence,"phase":"PENDING","command":"write","task":"h-036-fixture",
            "manifest_sha256":manifest_sha,"operation_identity":canonical_json_sha256(operation),
            "request_sha256":request_sha,"old_store_sha256":old_sha,"new_store_sha256":new_sha,
            "previous_record_sha256":hashlib.sha256(
                prefix_lines[-1] if prefix_lines else b"").hexdigest()}
        committed={**pending,"sequence":sequence+1,"phase":"COMMITTED",
            "previous_record_sha256":hashlib.sha256(canonical_json_bytes(pending)+b"\n").hexdigest()}
        recovery=prefix+canonical_json_bytes(pending)+b"\n"+canonical_json_bytes(committed)+b"\n"
        def slot_state(path: Path) -> tuple[int,int,int,int,int,int,int,str]:
            info=os.lstat(path);raw=path.read_bytes()
            return (info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid,info.st_nlink,
                    info.st_size,hashlib.sha256(raw).hexdigest())
        store_info=slot_state(store_path);shadow_info=slot_state(attest/".r15-attest-shadow")
        recovery_info=slot_state(attest/".r15-attest-recovery.jsonl")
        store_path.write_bytes(new);(attest/".r15-attest-shadow").write_bytes(b"")
        (attest/".r15-attest-recovery.jsonl").write_bytes(recovery)
        return (product_problem==expected_product_problem and sequence%2==1
                and (attest/".r15-attest-recovery.jsonl").read_bytes()==recovery
                and recovery==prefix+canonical_json_bytes(pending)+b"\n"
                    +canonical_json_bytes(committed)+b"\n"
                and all(slot_state(path)[:6]==info[:6] for path,info in (
                            (store_path,store_info),(attest/".r15-attest-shadow",shadow_info),
                            (attest/".r15-attest-recovery.jsonl",recovery_info)))
                and slot_state(store_path)[6:]==(len(new),hashlib.sha256(new).hexdigest())
                and slot_state(attest/".r15-attest-shadow")[6:]==(0,hashlib.sha256(b"").hexdigest())
                and slot_state(attest/".r15-attest-recovery.jsonl")[6:]==(
                    len(recovery),hashlib.sha256(recovery).hexdigest()))
    primary_dependency=(bundle,state,attest,store_path,state_manifest,attest_manifest,pristine,
                        state_before,evolved)
    for label,reason,mutate in dependency_mutants:
        bundle=tmp/("dependency-"+label.lower())
        bootstrapped=bootstrap(bundle)
        if bootstrapped.returncode:raise Rig("R15 dependency bootstrap "+label+": "+bootstrapped.stderr)
        state=bundle/"state";attest=bundle/"attest";store_path=attest/"attestations.json"
        state_manifest=state/"bootstrap-manifest.json";attest_manifest=attest/"bootstrap-manifest.json"
        evolved=r15_cli(repo,"controller/attest/cli",str(attest),"write","h-001","f"*40)
        if evolved.returncode:raise Rig("R15 dependency evolution "+label+": "+evolved.stderr)
        pristine=(store_path.read_bytes(),state_manifest.read_bytes(),attest_manifest.read_bytes(),
                  (attest/".r15-attest-shadow").read_bytes(),
                  (attest/".r15-attest-recovery.jsonl").read_bytes())
        state_before=(state/"events.jsonl").read_bytes()
        if label=="STALE":
            installed=r15_cli(repo,"controller/attest/cli",str(attest),"invalidate",
                              str(R15_H036["candidate_sha"]))
            if installed.returncode:raise Rig("R15 stale dependency fixture: "+installed.stderr)
            stale_expected=strict_json_bytes(pristine[0]);stale_record=stale_expected["attestations"]["h-036"]
            stale_record["stale"]=True
            stale_expected["invalidated_shas"]=sorted(set(stale_expected["invalidated_shas"]+[str(R15_H036["candidate_sha"])]))
            stale_expected["omtest_ko"]=sorted(set(stale_expected["omtest_ko"]+["h-036"]))
            stale_actual=strict_json_bytes(store_path.read_bytes())
            pristine_value=strict_json_bytes(pristine[0])
            fixture_exact=(r15_json_equal(stale_actual,stale_expected)
                and set(stale_actual)==set(pristine_value)
                and set(stale_actual["attestations"])==set(pristine_value["attestations"])
                and r15_json_equal(stale_actual["attestations"]["h-035"],
                                   pristine_value["attestations"]["h-035"])
                and r15_json_equal(stale_actual["attestations"]["h-001"],
                                   pristine_value["attestations"]["h-001"])
                and set(stale_actual["invalidated_shas"])
                    ==set(pristine_value["invalidated_shas"])
                      |{str(R15_H036["candidate_sha"])}
                and set(stale_actual["omtest_ko"])
                    ==set(pristine_value["omtest_ko"])|{"h-036"})
        else:
            mutant=strict_json_bytes(pristine[0])
            if label=="CROSS_REPOSITORY":
                mutant["attestations"]["h-036"]=r15_h036_owner_publication(
                    "/copied/repository.git")
            else:mutate(mutant)
            expected_mutant=strict_json_bytes(pristine[0])
            if label=="ORDINARY":expected_mutant["attestations"]["h-036"]={
                "task":"h-036","candidate_sha":R15_H036["candidate_sha"],
                "invalidates_on":[R15_H036["candidate_sha"]],"stale":False}
            elif label=="CROSS_REPOSITORY":expected_mutant["attestations"]["h-036"]=r15_h036_owner_publication("/copied/repository.git")
            elif label=="CROSS_TASK":expected_mutant["attestations"]["h-036"]["task"]="h-034"
            elif label=="IDENTITY":expected_mutant["attestations"]["h-036"]["candidate_identity"]="0"*64
            fixture_exact=(r15_json_equal(mutant,expected_mutant)
                and set(mutant)==set(strict_json_bytes(pristine[0]))
                and set(mutant["attestations"])==set(strict_json_bytes(pristine[0])["attestations"])
                and r15_json_equal(mutant["attestations"]["h-035"],strict_json_bytes(pristine[0])["attestations"]["h-035"])
                and r15_json_equal(mutant["attestations"]["h-001"],strict_json_bytes(pristine[0])["attestations"]["h-001"]))
            if not fixture_exact or not install_invalid_dependency(mutant,label):
                raise Rig("R15 coherent invalid dependency fixture "+label)
        dependency_before=(filesystem_snapshot(bundle),r15_repository_authority_snapshot(repo,remote),
                           store_path.read_bytes(),(attest/".r15-attest-shadow").read_bytes(),
                           (attest/".r15-attest-recovery.jsonl").read_bytes())
        attempt=r15_cli(repo,taskval,"claim",str(spec),str(attest),str(state))
        record("DEPENDENCY_"+label+"_REJECT_UNCHANGED",
               fixture_exact and attempt.returncode!=0 and (state/"events.jsonl").read_bytes()==state_before
               and dependency_before==(filesystem_snapshot(bundle),
                   r15_repository_authority_snapshot(repo,remote),store_path.read_bytes(),
                   (attest/".r15-attest-shadow").read_bytes(),
                   (attest/".r15-attest-recovery.jsonl").read_bytes())
               and f"R15_OWNER_DEPENDENCY_INVALID:{reason}" in attempt.stderr,
               attempt.stderr)
    (bundle,state,attest,store_path,state_manifest,attest_manifest,pristine,
     state_before,evolved)=primary_dependency

    manifest_value=strict_json_bytes(pristine[1])
    if not isinstance(manifest_value,dict): raise Rig("R15 manifest fixture type")
    exact_h036=r15_h036_owner_publication(str(manifest_value["repository_identity"]))
    wrong_h036=json.loads(json.dumps(exact_h036));wrong_h036["candidate_identity"]="0"*64
    classification_exact=(attest_fixture["dependency_problem"](
        exact_h036,str(manifest_value["repository_identity"])) is None
        and attest_fixture["dependency_problem"](
            wrong_h036,str(manifest_value["repository_identity"]))=="GRAPH_OR_IDENTITY")
    record("DEPENDENCY_CLASSIFICATION_EXACT_H036_NONE_AND_WRONG_IDENTITY_GRAPH",
           classification_exact,repr(classification_exact))
    baseline_results=[]
    for field in ("bootstrap_attestation_store_sha256","bootstrap_state_db_sha256"):
        original_boundary=(filesystem_snapshot(bundle),
                           r15_repository_authority_snapshot(repo,remote),
                           (state/"events.jsonl").read_bytes())
        mutant=json.loads(json.dumps(manifest_value));mutant[field]="0"*64
        mutant_raw=canonical_json_bytes(mutant)+b"\n"
        state_manifest.write_bytes(mutant_raw);attest_manifest.write_bytes(mutant_raw)
        tampered_boundary=(filesystem_snapshot(bundle),
                           r15_repository_authority_snapshot(repo,remote),
                           (state/"events.jsonl").read_bytes())
        attempt=r15_cli(repo,taskval,"claim",str(spec),str(attest),str(state))
        after_boundary=(filesystem_snapshot(bundle),
                        r15_repository_authority_snapshot(repo,remote),
                        (state/"events.jsonl").read_bytes())
        state_manifest.write_bytes(pristine[1]);attest_manifest.write_bytes(pristine[2])
        restored_boundary=(filesystem_snapshot(bundle),
                           r15_repository_authority_snapshot(repo,remote),
                           (state/"events.jsonl").read_bytes())
        baseline_results.append(
            attempt.returncode!=0 and attempt.stdout==""
            and attempt.stderr=="R15_BOOTSTRAP_MANIFEST_INVALID\n"
            and "R15_OWNER_DEPENDENCY_INVALID" not in attempt.stderr
            and after_boundary==tampered_boundary
            and restored_boundary==original_boundary)
    record("CLAIM_BOOTSTRAP_STORE_AND_STATE_DB_BASELINE_MANIFEST_TAMPER_CAUSAL_REJECT",
           all(baseline_results),repr(baseline_results))
    record("ATTEST_STORE_EVOLUTION_PRESERVES_BOOTSTRAP_BASELINE_PROVENANCE",
           evolved.returncode==0 and evolved_store!=initial_store
           and state_manifest.read_bytes()==pristine[1]
           and attest_manifest.read_bytes()==pristine[2],evolved.stderr)

    current_json=state/"current.json"; current_json.write_text("{}\n")
    attempt=r15_cli(repo,taskval,"claim",str(spec),str(attest),str(state))
    record("CLAIM_CURRENT_JSON_SUBSTITUTION_REJECT",
           attempt.returncode!=0 and (state/"events.jsonl").read_bytes()==state_before,
           attempt.stderr); current_json.unlink()
    attempt=r15_cli(repo,taskval,"claim",str(spec),str(state),str(attest))
    record("CLAIM_STATE_ATTEST_ROOT_SUBSTITUTION_REJECT",
           attempt.returncode!=0 and (state/"events.jsonl").read_bytes()==state_before,
           attempt.stderr)
    set_remote_main(remote,repo,str(fixture["product_publication"]))
    drift_snapshot=r15_repository_authority_snapshot(repo,remote)
    attempt=r15_cli(repo,taskval,"claim",str(spec),str(attest),str(state))
    record("CLAIM_WRONG_REMOTE_MAIN_REJECT_UNCHANGED",
           attempt.returncode!=0 and (state/"events.jsonl").read_bytes()==state_before,
           attempt.stderr,drift_snapshot)
    set_remote_main(remote,repo,current_main)
    repo_before=r15_repository_authority_snapshot(repo,remote)

    fake=tmp/"claim-fake"; fake.mkdir(); (fake/"git").write_text("#!/bin/sh\nexit 0\n"); (fake/"git").chmod(0o755)
    hostile={"PATH":str(fake),"GIT_DIR":"/nonexistent","GIT_WORK_TREE":"/nonexistent",
             "GIT_INDEX_FILE":"/nonexistent","GIT_REPLACE_REF_BASE":"refs/replace/",
             "GIT_SSH":str(fake/"git"),"GIT_SSH_COMMAND":"false",
             "GIT_ASKPASS":str(fake/"git"),"SSH_ASKPASS":str(fake/"git")}
    selected_before=filesystem_snapshot(bundle)
    select_trace=tmp/"dispatch-valid-taskval-select.jsonl"
    selected=r15_cli_runpy_fault(
        repo,taskval,["select",str(spec),str(attest),str(state)],stdin=None,
        fault="trace_runtime_exports",target=select_trace,env_extra=hostile)
    select_argv=["select",str(spec),str(attest),str(state)]
    select_export=(trace_rows(select_trace)==r15_expected_export_trace(
        "taskval_main",select_argv,stdin=None,result=0))
    record("SOLE_NORMAL_SELECT_IS_H038_AND_HAS_NO_STATE_EFFECT",
           selected.returncode==0 and selected.stdout=="h-038\n"
           and filesystem_snapshot(bundle)==selected_before,selected.stderr)
    claim_trace=tmp/"dispatch-valid-taskval-claim.jsonl"
    claim=r15_cli_runpy_fault(
        repo,taskval,["claim",str(spec),str(attest),str(state)],stdin=None,
        fault="trace_runtime_exports",target=claim_trace,env_extra=hostile)
    claim_argv=["claim",str(spec),str(attest),str(state)]
    claim_export=(trace_rows(claim_trace)==r15_expected_export_trace(
        "taskval_main",claim_argv,stdin=None,result=0))
    try:
        after=r15_events(state/"events.jsonl")
        dep_records=[
            {"task":"h-035","authority_class":"ordinary","attestation":h035},
            {"task":"h-036","authority_class":"owner_authority","attestation":h036},
        ]
        spec_sha=hashlib.sha256(spec_raw).hexdigest()
        registry_sha=hashlib.sha256(registry_raw).hexdigest()
        gate_sha=hashlib.sha256(gate_raw).hexdigest()
        expected_claim=r15_claim_event(
            "h-038",current_main,spec_sha,registry_sha,gate_path,gate_sha,
            str(fixture["repository_identity"]),canonical_json_sha256(dep_records))
        claim_ok=(claim.returncode==0 and claim.stdout=="" and len(after)==len(events)+1
                  and set(after[-1])==set(R15_CLAIM_FIELDS)
                  and r15_json_equal(after[-1],expected_claim))
    except (OSError,ValueError) as exc:
        after=[]; expected_claim={}; claim_ok=False; claim=subprocess.CompletedProcess([],1,"",str(exc))
    record("CANONICAL_FULL_DEPENDENCY_BOUND_OWNER_CLAIM_NO_BUILDER_ID",
           claim_ok,claim.stderr)
    record("DISPATCH_VALID_FULL_BOOTSTRAP_SELECT_CLAIM_RETAINED_EXPORT_EXACTLY_ONCE",
           bootstrap_export and select_export and claim_export,
           repr((trace_rows(bootstrap_trace),trace_rows(select_trace),trace_rows(claim_trace))))
    claimed_snapshot=filesystem_snapshot(bundle)
    replay=r15_cli(repo,taskval,"claim",str(spec),str(attest),str(state))
    record("CLAIM_AFTER_SUCCESS_EMPTY_IDEMPOTENT",
           replay.returncode==0 and replay.stdout=="" and filesystem_snapshot(bundle)==claimed_snapshot,
           replay.stderr)
    return {**fixture,"bundle":bundle,"state":state,"attest":attest,
            "claim_event":expected_claim,"h035_record":h035,"h036_record":h036}


def r15_material_candidate(repo: Path, base: str, label: str,
                           writes: dict[str,bytes], removes: tuple[str,...] = ()) -> str:
    checkout=git(repo,"checkout","-q",base)
    if checkout.returncode: raise Rig(checkout.stderr)
    for relative,raw in writes.items():
        path=repo/relative; path.parent.mkdir(parents=True,exist_ok=True); path.write_bytes(raw)
    for relative in removes:
        path=repo/relative
        if path.exists() or path.is_symlink(): path.unlink()
    add=git(repo,"--literal-pathspecs","add","-A","--",*sorted((*writes,*removes)))
    if add.returncode: raise Rig(add.stderr)
    commit=git(repo,"commit","-qm",label)
    if commit.returncode: raise Rig(commit.stderr)
    return git(repo,"rev-parse","HEAD").stdout.strip()


def r15_parallel_cli(repo: Path, calls: list[tuple[str,list[str],str | None]],
                     *, held_lock: Path | None = None,
                     env_extra: dict[str,str] | None = None,
                     stagger_first: bool = False,
                     diagnostics: list[dict[str,object]] | None = None
                     ) -> list[subprocess.CompletedProcess]:
    env=os.environ.copy(); env.pop("PYTHONDONTWRITEBYTECODE",None); env.pop("PYTHONPYCACHEPREFIX",None)
    if env_extra: env.update(env_extra)
    processes=[];owned_pgids=[];launch_times=[];blocked_before_release=[];released_at=None
    outputs: dict[int,tuple[str,str,float]]={}
    monitor_required=held_lock is not None or stagger_first
    exit_queue=select.kqueue() if monitor_required else None
    exited_pids: set[int]=set()
    ready_readers=[];release_writers=[]
    cleanup_started=False;cleanup_deadline: float | None=None
    barrier_program=(
        "import fcntl,os,runpy,sys\n"
        "target=sys.argv[1];ready=int(sys.argv[2]);release=int(sys.argv[3])\n"
        "wanted=(int(sys.argv[4]),int(sys.argv[5]));target_args=sys.argv[6:]\n"
        "real_flock=fcntl.flock;arrived=False\n"
        "def barrier_flock(fd,operation):\n"
        " global arrived,ready,release\n"
        " info=os.fstat(fd)\n"
        " if not arrived and operation==fcntl.LOCK_EX and (info.st_dev,info.st_ino)==wanted:\n"
        "  arrived=True\n"
        "  if os.write(ready,b'R')!=1:raise RuntimeError('R15 lock barrier ready write')\n"
        "  os.close(ready);ready=-1\n"
        "  if os.read(release,1)!=b'G':raise RuntimeError('R15 lock barrier release read')\n"
        "  os.close(release);release=-1\n"
        " return real_flock(fd,operation)\n"
        "fcntl.flock=barrier_flock;sys.argv=[target,*target_args]\n"
        "try:runpy.run_path(target,run_name='__main__')\n"
        "finally:\n"
        " if ready>=0:os.close(ready)\n"
        " if release>=0:os.close(release)\n")
    def close_fd(descriptor: int) -> None:
        try: os.close(descriptor)
        except OSError: pass
    def nonreaping_exited_pids(timeout_seconds: float = 0.0) -> set[int]:
        if exit_queue is None: raise Rig("R15 nonreaping child monitor absent")
        if timeout_seconds not in (0.0,0.5):
            raise Rig("R15 nonreaping child monitor timeout authority")
        try: events=exit_queue.control(
            None,max(1,len(processes)+1),timeout_seconds)
        except OSError as exc: raise Rig("R15 nonreaping child observation failed") from exc
        for event in events:
            pid=int(event.ident)
            if (pid not in owned_pgids or event.filter!=select.KQ_FILTER_PROC
                    or event.fflags!=select.KQ_NOTE_EXIT
                    or event.flags&select.KQ_EV_ERROR or pid in exited_pids):
                raise Rig("R15 nonreaping child event identity")
            exited_pids.add(pid)
        return set(exited_pids)
    def bounded_group_cleanup(primary_timeout: int | None) -> set[int]:
        nonlocal cleanup_started,cleanup_deadline
        if cleanup_started:
            raise Rig("R15 concurrent cleanup reentry")
        cleanup_started=True;cleanup_deadline=time.monotonic()+5
        pending=[(index,process) for index,process in enumerate(processes)
                 if index not in outputs]
        cleanup_failures=[];signal_failures=[];signaled=set()
        for index,process in pending:
            owned_pgid=owned_pgids[index]
            if owned_pgid<=1:
                signal_failures.append((index,process,Rig("invalid owned pgid")))
                continue
            try:
                os.killpg(owned_pgid,signal.SIGKILL);signaled.add(index)
            except OSError as exc: signal_failures.append((index,process,exc))
        for index,process,exc in signal_failures:
            if isinstance(exc,ProcessLookupError): continue
            cleanup_failures.append(f"killpg[{index}]={exc}")
            direct_status=process.poll()
            if direct_status is None:
                try: process.kill()
                except OSError as kill_exc:
                    cleanup_failures.append(f"kill[{index}]={kill_exc}")
        for index,process in pending:
            try:
                stdout,stderr=process.communicate(
                    timeout=max(0.0,cleanup_deadline-time.monotonic()))
            except subprocess.TimeoutExpired:
                for stream in (process.stdout,process.stderr):
                    if stream is not None:
                        try: stream.close()
                        except OSError: pass
                cleanup_failures.append(f"pipe_drain[{index}]=timeout")
                try: process.wait(timeout=max(0.0,cleanup_deadline-time.monotonic()))
                except (subprocess.TimeoutExpired,OSError) as exc:
                    cleanup_failures.append(f"reap[{index}]={exc}")
                stdout="";stderr=""
            except (OSError,UnicodeError,ValueError) as exc:
                cleanup_failures.append(f"pipe_drain[{index}]={exc}")
                try: process.wait(timeout=max(0.0,cleanup_deadline-time.monotonic()))
                except (subprocess.TimeoutExpired,OSError) as wait_exc:
                    cleanup_failures.append(f"reap[{index}]={wait_exc}")
                stdout="";stderr=""
            outputs[index]=(stdout,stderr,time.monotonic())
        if cleanup_failures:
            raise Rig("R15 bounded concurrent cleanup failed: "+"; ".join(cleanup_failures))
        return ({primary_timeout} if primary_timeout is not None else set()) | (
            signaled if primary_timeout is not None else set())
    lock_descriptor=None
    try:
        if held_lock is not None:
            lock_descriptor=os.open(held_lock,os.O_RDWR|getattr(os,"O_CLOEXEC",0)
                                     |getattr(os,"O_NOFOLLOW",0))
            lock_info=os.fstat(lock_descriptor);path_info=os.lstat(held_lock)
            if ((lock_info.st_dev,lock_info.st_ino)!=(path_info.st_dev,path_info.st_ino)
                    or not stat.S_ISREG(lock_info.st_mode) or lock_info.st_nlink!=1):
                raise Rig("R15 held lock stable regular identity")
            fcntl.flock(lock_descriptor,fcntl.LOCK_EX)
        for index,(relative,args,stdin) in enumerate(calls):
            if stdin is not None and len(stdin.encode("utf-8"))>8192:
                raise Rig("R15 concurrent stdin exceeds fixed 8192-byte fixture envelope")
            launched_at=time.monotonic()
            ready_write=None;release_read=None
            if lock_descriptor is not None:
                ready_read,ready_write=os.pipe();release_read,release_write=os.pipe()
                ready_readers.append(ready_read);release_writers.append(release_write)
                argv=[sys.executable,"-I","-S","-B","-c",barrier_program,
                      str(repo/relative),str(ready_write),str(release_read),
                      str(lock_info.st_dev),str(lock_info.st_ino),*args]
                pass_fds=(ready_write,release_read)
            else:
                argv=[sys.executable,str(repo/relative),*args];pass_fds=()
            try:
                process=subprocess.Popen(
                    argv,cwd=repo,env=env,
                    stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
                    stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,shell=False,
                    start_new_session=True,close_fds=True,pass_fds=pass_fds)
            finally:
                if ready_write is not None: close_fd(ready_write)
                if release_read is not None: close_fd(release_read)
            processes.append(process);owned_pgids.append(process.pid);launch_times.append(launched_at)
            blocked_before_release.append(False)
            if exit_queue is not None:
                exit_queue.control([select.kevent(
                    process.pid,filter=select.KQ_FILTER_PROC,
                    flags=select.KQ_EV_ADD|select.KQ_EV_ENABLE|select.KQ_EV_ONESHOT,
                    fflags=select.KQ_NOTE_EXIT)],0,0)
            if stdin is not None:
                if process.stdin is None: raise Rig("R15 concurrent stdin pipe missing")
                try: process.stdin.write(stdin); process.stdin.flush()
                finally:
                    try: process.stdin.close()
                    finally: process.stdin=None
            if stagger_first and index==0:
                time.sleep(0.25)
                if processes[0].pid in nonreaping_exited_pids():
                    raise Rig("R15 first lock-order child did not block behind held lock")
        if lock_descriptor is not None:
            pending_readers=set(ready_readers);barrier_deadline=time.monotonic()+5
            while pending_readers:
                readable,_writable,_exceptional=select.select(
                    sorted(pending_readers),[],[],
                    max(0.0,barrier_deadline-time.monotonic()))
                if not readable: raise Rig("R15 exact held-lock attempt barrier timeout")
                for descriptor in readable:
                    if os.read(descriptor,2)!=b"R":
                        nonreaping_exited_pids(0.5)
                        raise Rig("R15 exact held-lock attempt barrier failed")
                    close_fd(descriptor);pending_readers.remove(descriptor)
            observed_exits=nonreaping_exited_pids()
            if any(process.pid in observed_exits for process in processes):
                raise Rig("R15 child exited at exact held-lock attempt barrier")
            blocked_before_release=[True for _process in processes]
            for descriptor in release_writers:
                if os.write(descriptor,b"G")!=1:
                    raise Rig("R15 exact held-lock barrier release write")
                close_fd(descriptor)
            release_writers=[]
            current_info=os.lstat(held_lock)
            if (current_info.st_dev,current_info.st_ino)!=(lock_info.st_dev,lock_info.st_ino):
                raise Rig("R15 held lock replaced before release")
            fcntl.flock(lock_descriptor,fcntl.LOCK_UN)
            released_at=time.monotonic()
        else:
            released_at=time.monotonic()
    except BaseException:
        if not cleanup_started: bounded_group_cleanup(None)
        raise
    finally:
        for descriptor in ready_readers: close_fd(descriptor)
        for descriptor in release_writers: close_fd(descriptor)
        if lock_descriptor is not None: os.close(lock_descriptor)
        if exit_queue is not None and released_at is None: exit_queue.close()
    if released_at is None: raise Rig("R15 concurrent release timestamp missing")
    deadline=released_at+60
    timeout_indices: set[int]=set()
    pending=set(range(len(processes)));collection_failure=None
    try:
        while pending and collection_failure is None:
            for index in sorted(tuple(pending)):
                process=processes[index]
                try:
                    stdout,stderr=process.communicate(timeout=min(
                        0.05,max(0.0,deadline-time.monotonic())))
                except subprocess.TimeoutExpired:
                    pass
                except (OSError,UnicodeError,ValueError) as exc:
                    collection_failure=f"pipe_drain[{index}]={exc}"
                    if process.returncode is not None:
                        outputs[index]=("","",time.monotonic());pending.remove(index)
                    break
                else:
                    outputs[index]=(stdout,stderr,time.monotonic());pending.remove(index)
            if pending and collection_failure is None and time.monotonic()>=deadline:
                timeout_indices=bounded_group_cleanup(min(pending));pending.clear()
        if collection_failure is not None:
            if not cleanup_started: bounded_group_cleanup(None)
            raise Rig("R15 concurrent result collection failed: "+collection_failure)
    except BaseException:
        if not cleanup_started: bounded_group_cleanup(None)
        raise
    finally:
        if exit_queue is not None: exit_queue.close()
    results=[]
    for index,process in enumerate(processes):
        stdout,stderr,reaped_at=outputs[index]
        result_returncode=124 if index in timeout_indices else process.returncode
        results.append(subprocess.CompletedProcess(process.args,result_returncode,stdout,stderr))
        if diagnostics is not None:
            diagnostics.append({
                "index":index,"blocked_before_release":blocked_before_release[index],
                "launch_to_release_ms":int(round((released_at-launch_times[index])*1000)),
                "release_to_reap_ms":int(round((reaped_at-released_at)*1000)),
                "deadline_ms":60000,"cleanup_deadline_ms":5000,
                "actual_returncode":process.returncode,
                "timed_out":index in timeout_indices})
    return results


def r15_state_attest_lock_order_probe(repo: Path, state_lock: Path, attest_lock: Path,
                                      finalizer_args: list[str], finalizer_stdin: str,
                                      _unused_transition_stdin: str) -> tuple[bool,list[subprocess.CompletedProcess]]:
    flags=os.O_RDWR|getattr(os,"O_CLOEXEC",0)|getattr(os,"O_NOFOLLOW",0)
    state_fd=os.open(state_lock,flags); attest_fd=os.open(attest_lock,flags)
    processes=[]; acquired_state=False
    try:
        if ((os.fstat(state_fd).st_dev,os.fstat(state_fd).st_ino)
                != (os.lstat(state_lock).st_dev,os.lstat(state_lock).st_ino)
                or (os.fstat(attest_fd).st_dev,os.fstat(attest_fd).st_ino)
                != (os.lstat(attest_lock).st_dev,os.lstat(attest_lock).st_ino)):
            return False,[]
        fcntl.flock(attest_fd,fcntl.LOCK_EX)
        env=os.environ.copy(); env.pop("PYTHONDONTWRITEBYTECODE",None); env.pop("PYTHONPYCACHEPREFIX",None)
        finalizer=subprocess.Popen(
            [sys.executable,str(repo/"controller/attest/cli"),*finalizer_args],cwd=repo,env=env,
            stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,shell=False)
        if finalizer.stdin is None: raise Rig("R15 finalizer stdin")
        finalizer.stdin.write(finalizer_stdin); finalizer.stdin.close(); finalizer.stdin=None
        processes.append(finalizer)
        deadline=time.monotonic()+5
        while time.monotonic()<deadline:
            try:
                fcntl.flock(state_fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
            except BlockingIOError:
                acquired_state=True; break
            else:
                fcntl.flock(state_fd,fcntl.LOCK_UN); time.sleep(0.02)
        if not acquired_state: return False,[]
        state_waiter=subprocess.Popen(
            [sys.executable,str(repo/"controller/taskval/cli"),"claim",
             str(repo/"specs/tasks.spec.json"),str(attest_lock.parent),
             str(state_lock.parent)],cwd=repo,env=env,stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,shell=False)
        processes.append(state_waiter); time.sleep(0.25)
        both_blocked=all(process.poll() is None for process in processes)
        fcntl.flock(attest_fd,fcntl.LOCK_UN)
        results=[]
        for process in processes:
            stdout,stderr=process.communicate(timeout=30)
            results.append(subprocess.CompletedProcess(process.args,process.returncode,stdout,stderr))
        return both_blocked,results
    finally:
        try: fcntl.flock(attest_fd,fcntl.LOCK_UN)
        except OSError: pass
        os.close(state_fd); os.close(attest_fd)
        for process in processes:
            if process.poll() is None:
                process.kill(); process.wait()


def r15_owner_transition_controls(tmp: Path, context: dict[str,object],
                                  cases: list[tuple[str,bool,str]]) -> None:
    tmp=tmp.resolve()
    repo=context["repo"]; state=context["state"]; attest=context["attest"]
    bundle=context["bundle"]; remote=context["remote"]
    if not all(isinstance(value,Path) for value in (repo,state,attest,bundle,remote)):
        raise Rig("R15 lifecycle fixture path type")
    base=str(context["current_main"]); task="h-038"
    claim=context["claim_event"]
    if not isinstance(claim,dict): raise Rig("R15 claim fixture")
    def record(name: str, ok: bool, detail: str = "") -> None:
        cases.append((name,ok,detail)); print(f"R15_CASE={name} RESULT={'PASS' if ok else 'FAIL'} {detail[:200]}")
    smoke_path=repo/"specs/tasks.spec.json";smoke=r15_leaf_state(smoke_path)
    smoke_info=os.lstat(smoke_path)
    record("OWNER_GLOBAL_LEAF_STATE_READ_ONLY_ENTRY_SMOKE",
           set(smoke)=={"dev","ino","mode","uid","gid","nlink","size","sha256"}
           and (smoke["dev"],smoke["ino"])==(smoke_info.st_dev,smoke_info.st_ino)
           and smoke["sha256"]==hashlib.sha256(smoke_path.read_bytes()).hexdigest())
    def runtime_trace_rows(path: Path) -> list[object]:
        try:return [strict_json_bytes(line) for line in path.read_bytes().splitlines()]
        except (OSError,ValueError,UnicodeError):return []
    authority_dispatch_traces: dict[str,list[object]]={}
    authority_dispatch_expected: dict[str,list[dict[str,object]]]={}
    def traced_authority(command: str,request: dict[str,object],label: str
                         ) -> tuple[int,dict[str,object],str]:
        value={"h035_r15_request":dict(R15_AUTHORITY_REQUEST_MARKER),**request}
        trace=tmp/("dispatch-valid-authority-"+label+".jsonl")
        stdin_value=json.dumps(value,sort_keys=True,separators=(",",":"))
        result=r15_cli_runpy_fault(
            repo,"controller/authority/cli",[command],
            stdin=stdin_value,
            fault="trace_runtime_exports",target=trace)
        rows=runtime_trace_rows(trace);authority_dispatch_traces[label]=rows
        authority_dispatch_expected[label]=r15_expected_export_trace(
            "authority_value",[command],stdin=stdin_value,result=0,request=value)
        try:payload=strict_json_bytes(result.stdout.encode("utf-8"))
        except (ValueError,UnicodeError):payload={}
        return (result.returncode,payload if isinstance(payload,dict) else {},
                (result.stderr or result.stdout)[-500:])
    store_checkpoints: dict[bytes,tuple[bytes,bytes]]={}
    def remember_store(raw: bytes) -> None:
        store_checkpoints[raw]=((attest/".r15-attest-shadow").read_bytes(),
                                (attest/".r15-attest-recovery.jsonl").read_bytes())
    def reset_store(raw: bytes) -> None:
        if raw not in store_checkpoints:raise Rig("R15 unbound store checkpoint")
        shadow,recovery=store_checkpoints[raw]
        (attest/"attestations.json").write_bytes(raw)
        (attest/".r15-attest-shadow").write_bytes(shadow)
        (attest/".r15-attest-recovery.jsonl").write_bytes(recovery)
    def attest_static_snapshot() -> dict[str,str]:
        value=filesystem_snapshot(attest)
        for name in ("attestations.json",".r15-attest-shadow",
                     ".r15-attest-recovery.jsonl"):
            value.pop(name,None)
        return value
    def rejected(name: str, command: str, request: dict[str,object],
                 env: dict[str,str] | None = None) -> None:
        before=(filesystem_snapshot(bundle),filesystem_snapshot(Path(str(request.get("workspace_root",tmp/"absent-workspace")))),
                r15_repository_authority_snapshot(repo,remote))
        rc,payload,detail=r15_authority(repo,command,request,env)
        after=(filesystem_snapshot(bundle),filesystem_snapshot(Path(str(request.get("workspace_root",tmp/"absent-workspace")))),
               r15_repository_authority_snapshot(repo,remote))
        product_rejection=(rc==1 and payload.get("accepted") is False
                           and type(payload.get("reason")) is str
                           and bool(payload.get("reason")))
        record(name,product_rejection and before==after,detail)

    checkout=git(repo,"checkout","--detach","-q",base)
    if checkout.returncode: raise Rig(checkout.stderr)
    workspace_parent=tmp/"owner-workspaces";workspace_parent.mkdir(mode=0o700)
    workspace=(workspace_parent/"owner-workspace").resolve()
    author_request={"h035_r15_request":dict(R15_AUTHORITY_REQUEST_MARKER),
                    "repo":str(repo.resolve()),"task_id":task,
                    "state_dir":str(state.resolve()),"workspace_root":str(workspace)}
    rejected("OWNER_AUTHOR_REQUEST_SELECTED_BINDING_REJECT", "owner-author",
             {**author_request,"base_sha":base})

    # Projection substitutions must fail before the real provisional transition.
    state_db=state/"state.db"; db_backup=state/"state.db.r15-backup"
    state_db.rename(db_backup); state_db.symlink_to(db_backup.name)
    rejected("OWNER_AUTHOR_STATE_DB_SYMLINK_REJECT", "owner-author",author_request)
    state_db.unlink(); db_backup.rename(state_db)
    os.link(state_db,state/"state-db-hardlink")
    rejected("OWNER_AUTHOR_STATE_DB_HARDLINK_REJECT", "owner-author",author_request)
    (state/"state-db-hardlink").unlink()
    state_db.chmod(0o644)
    rejected("OWNER_AUTHOR_STATE_DB_MODE_REJECT", "owner-author",author_request)
    state_db.chmod(0o600)
    state_lock=state/".r15-owner.lock"; lock_backup=state/".r15-owner.lock.r15-backup"
    state_lock.rename(lock_backup); state_lock.symlink_to(lock_backup.name)
    rejected("OWNER_AUTHOR_STATE_LOCK_SYMLINK_REJECT", "owner-author",author_request)
    state_lock.unlink(); lock_backup.rename(state_lock)
    os.link(state_lock,state/"state-lock-hardlink")
    rejected("OWNER_AUTHOR_STATE_LOCK_HARDLINK_REJECT", "owner-author",author_request)
    (state/"state-lock-hardlink").unlink()
    state_lock.chmod(0o644)
    rejected("OWNER_AUTHOR_STATE_LOCK_MODE_REJECT", "owner-author",author_request)
    state_lock.chmod(0o600)

    database_bytes=state_db.read_bytes(); event_bytes=(state/"events.jsonl").read_bytes()
    state_db.write_bytes(database_bytes[:max(1,len(database_bytes)//2)])
    state_db.chmod(0o600)
    rejected("OWNER_AUTHOR_STATE_DB_CONTENT_TAMPER_REJECT", "owner-author",author_request)
    state_db.write_bytes(database_bytes); state_db.chmod(0o600)
    alien=tmp/"alien-state"; initialized=r15_cli(repo,"controller/state/cli","init",str(alien))
    appended=r15_cli(repo,"controller/state/cli","append",str(alien),
                     json.dumps({"task":"alien","status":"claimed"},sort_keys=True,separators=(",",":")))
    if initialized.returncode or appended.returncode: raise Rig("R15 alien state fixture")
    state_db.write_bytes((alien/"state.db").read_bytes()); state_db.chmod(0o600)
    rejected("OWNER_AUTHOR_STATE_DB_REBUILD_DUMP_MISMATCH_REJECT", "owner-author",author_request)
    state_db.write_bytes(database_bytes); state_db.chmod(0o600)
    (state/"events.jsonl").write_bytes(
        event_bytes+canonical_json_bytes({"task":"h-038","status":"replayed-substitution"})+b"\n")
    rejected("OWNER_AUTHOR_EVENT_REPLAY_PROJECTION_MISMATCH_REJECT", "owner-author",author_request)
    (state/"events.jsonl").write_bytes(event_bytes)

    # These are product-consumer checks, not helper-only Git assertions.  The
    # exact generated/installed authority CLI must reject every index state
    # which could make status or the worktree conceal a different authority.
    index_path=repo/".git/index"; index_raw=index_path.read_bytes()
    flag_path="specs/tasks.spec.json"
    for label,set_flag,clear_flag in (
        ("SKIP_WORKTREE","--skip-worktree","--no-skip-worktree"),
        ("ASSUME_UNCHANGED","--assume-unchanged","--no-assume-unchanged"),
    ):
        changed=git(repo,"update-index",set_flag,flag_path)
        if changed.returncode:raise Rig(changed.stderr)
        rejected("OWNER_AUTHOR_PHYSICAL_INDEX_"+label+"_EXACT_BYTES_REJECT",
                 "owner-author",author_request)
        restored=git(repo,"update-index",clear_flag,flag_path)
        if restored.returncode:raise Rig(restored.stderr)
    index_path.write_bytes(b"DIRC\0r15-corrupt-index")
    rejected("OWNER_AUTHOR_PHYSICAL_CORRUPT_INDEX_NONZERO_EMPTY_STATUS_REJECT",
             "owner-author",author_request)
    index_path.write_bytes(index_raw)
    staged_path=repo/flag_path; staged_raw=staged_path.read_bytes()
    staged_path.write_bytes(staged_raw+b"\n")
    staged=git(repo,"add","--",flag_path)
    if staged.returncode:raise Rig(staged.stderr)
    staged_index_raw=index_path.read_bytes()
    staged_path.write_bytes(staged_raw)
    rejected("OWNER_AUTHOR_PHYSICAL_STAGED_INDEX_WORKTREE_CANONICAL_REJECT",
             "owner-author",author_request)
    reset=git(repo,"reset","-q","--mixed",base)
    if reset.returncode:raise Rig(reset.stderr)
    physical_path=repo/flag_path;held=tmp/"physical-held-tasks.spec.json"
    git_reason_by_operation={name:("blob batch read" if name=="batch"
                                   else "closed Git HEAD/status/tree/index observation")
                             for name in ("head","status","tree","stage","flags","batch")}
    git_reason_swapped=dict(git_reason_by_operation)
    git_reason_swapped["batch"]=git_reason_by_operation["head"]
    git_reason_swapped["head"]="blob batch read"
    record("OWNER_AUTHOR_PHYSICAL_GIT_OPERATION_REASON_PARTITION_AND_SWAP_REJECT",
           git_reason_by_operation=={
               "head":"closed Git HEAD/status/tree/index observation",
               "status":"closed Git HEAD/status/tree/index observation",
               "tree":"closed Git HEAD/status/tree/index observation",
               "stage":"closed Git HEAD/status/tree/index observation",
               "flags":"closed Git HEAD/status/tree/index observation",
               "batch":"blob batch read"}
           and git_reason_swapped!=git_reason_by_operation,repr(git_reason_by_operation))
    for git_fault_kind,git_fault_suffix in (
        ("stderr","RC0_NONEMPTY_STDERR"),("nonzero","NONZERO_VALID_OUTPUT")):
        for git_operation in ("head","status","tree","stage","flags","batch"):
            git_before=(filesystem_snapshot(bundle),filesystem_snapshot(workspace),
                        r15_repository_authority_snapshot(repo,remote))
            git_trace=tmp/("physical-git-"+git_fault_kind+"-"+git_operation+"-fired")
            git_bad=r15_cli_runpy_fault(
                repo,"controller/authority/cli",["owner-author"],
                stdin=json.dumps(author_request,sort_keys=True,separators=(",",":")),
                fault="physical_git_"+git_fault_kind+"_"+git_operation,substitute=git_trace)
            git_fired=git_trace.is_file()
            if git_trace.exists():git_trace.unlink()
            git_product_rejection=r15_fault_answer(git_bad,git_reason_by_operation[git_operation])
            git_events=r15_fault_events(
                git_bad,"physical_git_"+git_fault_kind+"_"+git_operation)
            git_fault_clean=("Traceback" not in git_bad.stderr
                             and "NameError" not in git_bad.stderr
                             and "original_exec" not in git_bad.stderr
                             and "original_open" not in git_bad.stderr)
            record("OWNER_AUTHOR_PHYSICAL_GIT_"+git_operation.upper()+"_"+git_fault_suffix+"_REJECT",
                   git_product_rejection and git_fired
                   and r15_fault_event_exact(git_bad,
                       "physical_git_"+git_fault_kind+"_"+git_operation,
                       "subprocess_run",git_operation)
                   and git_fault_clean and git_before==(
                       filesystem_snapshot(bundle),filesystem_snapshot(workspace),
                       r15_repository_authority_snapshot(repo,remote)),git_bad.stderr)
    hidden_serial=[0]
    def hidden_status_rejected(name: str, target: Path) -> tuple[float,list[dict[str,object]]]:
        hidden_serial[0]+=1;trace=tmp/f"physical-status-hidden-{hidden_serial[0]}"
        before=(filesystem_snapshot(bundle),filesystem_snapshot(workspace),
                r15_repository_authority_snapshot(repo,remote))
        started=time.monotonic()
        result=r15_cli_runpy_fault(
            repo,"controller/authority/cli",["owner-author"],
            stdin=json.dumps(author_request,sort_keys=True,separators=(",",":")),
            fault="physical_hide_status",target=target,substitute=trace)
        elapsed=time.monotonic()-started
        try:events=[strict_json_bytes(line) for line in trace.read_bytes().splitlines()]
        except (OSError,ValueError):events=[]
        try:payload=strict_json_bytes(result.stdout.encode("utf-8"))
        except (ValueError,UnicodeError):payload={}
        fired=any(isinstance(row,dict) and row.get("event")=="status_hidden" for row in events)
        expected_reason=("tree/index inequality" if "STAGED_INDEX" in name else
                         "directory inventory" if any(token in name for token in
                             ("MISSING_LEAF","EXTRA_LEAF","EXTRA_EMPTY_DIRECTORY")) else
                         "leaf identity")
        product_rejection=r15_fault_answer(result,expected_reason)
        judge_events=r15_fault_events(result,"physical_hide_status")
        if trace.exists():trace.unlink()
        record(name,product_rejection and fired
               and r15_fault_event_exact(result,"physical_hide_status","subprocess_run","status")
               and sum(row.get("event")=="status_hidden" for row in events)==1 and before==(
            filesystem_snapshot(bundle),filesystem_snapshot(workspace),
            r15_repository_authority_snapshot(repo,remote)),result.stderr)
        return elapsed,[row for row in events if isinstance(row,dict)]
    index_path.write_bytes(staged_index_raw)
    hidden_status_rejected(
        "OWNER_AUTHOR_PHYSICAL_STAGED_INDEX_STATUS_HIDDEN_STAGE_MAP_CAUSAL_REJECT",
        physical_path)
    index_path.write_bytes(index_raw)
    physical_path.rename(held);os.link(held,physical_path)
    rejected("OWNER_AUTHOR_PHYSICAL_HARDLINK_LEAF_REJECT","owner-author",author_request)
    physical_path.unlink();held.rename(physical_path)
    physical_path.rename(held);physical_path.symlink_to(held)
    hidden_status_rejected("OWNER_AUTHOR_PHYSICAL_SYMLINK_LEAF_REJECT",physical_path)
    physical_path.unlink();held.rename(physical_path)
    physical_path.rename(held);os.mkfifo(physical_path)
    _elapsed,events=hidden_status_rejected("OWNER_AUTHOR_PHYSICAL_FIFO_LEAF_REJECT",physical_path)
    record("OWNER_AUTHOR_PHYSICAL_FIFO_NONBLOCKING",
           any(row.get("event")=="stat_call" for row in events)
           and not any(row.get("event")=="open_call" for row in events),repr(events))
    physical_path.unlink();held.rename(physical_path)
    physical_path.rename(held)
    with tempfile.TemporaryDirectory(prefix="r15-physical-socket-",dir="/private/tmp") as socket_raw:
        short_socket=Path(socket_raw)/"leaf";physical_socket=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
        physical_socket.bind(str(short_socket));os.rename(short_socket,physical_path)
        _elapsed,events=hidden_status_rejected("OWNER_AUTHOR_PHYSICAL_SOCKET_LEAF_REJECT",physical_path)
        record("OWNER_AUTHOR_PHYSICAL_SOCKET_NONBLOCKING",
               any(row.get("event")=="stat_call" for row in events)
               and not any(row.get("event")=="open_call" for row in events),repr(events))
        physical_socket.close();physical_path.unlink()
    held.rename(physical_path)
    physical_path.chmod(0o600)
    hidden_status_rejected("OWNER_AUTHOR_PHYSICAL_WRONG_LEAF_MODE_REJECT",physical_path)
    physical_path.chmod(0o644)
    physical_path.rename(held)
    hidden_status_rejected("OWNER_AUTHOR_PHYSICAL_MISSING_LEAF_REJECT",physical_path)
    held.rename(physical_path)
    extra=repo/"r15-untracked-physical-extra";extra.write_bytes(b"extra\n");extra.chmod(0o644)
    hidden_status_rejected("OWNER_AUTHOR_PHYSICAL_EXTRA_LEAF_REJECT",extra)
    extra.unlink()
    empty_extra=repo/"r15-untracked-empty-directory";empty_extra.mkdir(mode=0o755)
    hidden_status_rejected("OWNER_AUTHOR_PHYSICAL_EXTRA_EMPTY_DIRECTORY_REJECT",empty_extra)
    empty_extra.rmdir()
    noncanonical=repo/"r15[glob].txt";noncanonical_raw=r15_git_object_bytes(repo,base,"README.md")
    if noncanonical_raw is None:raise Rig("R15 noncanonical parser fixture blob")
    noncanonical.write_bytes(noncanonical_raw);noncanonical.chmod(0o644)
    parser_before=(filesystem_snapshot(bundle),filesystem_snapshot(workspace),
                   r15_repository_authority_snapshot(repo,remote))
    parser_trace=tmp/"physical-noncanonical-parser-fired"
    parser_bad=r15_cli_runpy_fault(
        repo,"controller/authority/cli",["owner-author"],
        stdin=json.dumps(author_request,sort_keys=True,separators=(",",":")),
        fault="physical_noncanonical_git_rows",target=noncanonical,
        replacement=noncanonical_raw,substitute=parser_trace)
    parser_fired=parser_trace.is_file()
    if parser_trace.exists():parser_trace.unlink()
    record("OWNER_AUTHOR_PHYSICAL_NONCANONICAL_TREE_INDEX_PATH_PARSER_CAUSAL_REJECT",
           r15_fault_answer(parser_bad,"noncanonical checkout path") and parser_fired
           and r15_fault_event_exact(parser_bad,"physical_noncanonical_git_rows",
                                     "subprocess_run","noncanonical_status")
           and parser_before==(
               filesystem_snapshot(bundle),filesystem_snapshot(workspace),
               r15_repository_authority_snapshot(repo,remote)),parser_bad.stderr)
    noncanonical.unlink()
    specs_dir=physical_path.parent;specs_dir.chmod(0o700)
    rejected("OWNER_AUTHOR_PHYSICAL_WRONG_DIRECTORY_MODE_REJECT","owner-author",author_request)
    specs_dir.chmod(0o755)
    repo.chmod(0o700)
    rejected("OWNER_AUTHOR_PHYSICAL_WRONG_ROOT_MODE_REJECT","owner-author",author_request)
    repo.chmod(0o755)
    physical_before=(filesystem_snapshot(bundle),filesystem_snapshot(workspace),
                     r15_repository_authority_snapshot(repo,remote))
    for uid_label,uid_target in (("LEAF",physical_path),("DIRECTORY",specs_dir),("ROOT",repo)):
        uid_bad=r15_cli_runpy_fault(
            repo,"controller/authority/cli",["owner-author"],
            stdin=json.dumps(author_request,sort_keys=True,separators=(",",":")),
            fault="wrong_uid",target=uid_target)
        uid_reason={"LEAF":"leaf identity","DIRECTORY":"directory identity",
                    "ROOT":"repository root identity"}[uid_label]
        uid_identity=os.lstat(uid_target)
        record("OWNER_AUTHOR_PHYSICAL_WRONG_UID_"+uid_label+"_CAUSAL_REJECT",
               r15_fault_answer(uid_bad,uid_reason)
               and r15_fault_event_exact(uid_bad,"wrong_uid","changed_stat",
                                         [uid_identity.st_dev,uid_identity.st_ino])
               and physical_before==(
                   filesystem_snapshot(bundle),filesystem_snapshot(workspace),
                   r15_repository_authority_snapshot(repo,remote)),uid_bad.stderr)
    substitute=tmp/"physical-leaf-substitute";substitute.write_bytes(physical_path.read_bytes());substitute.chmod(0o644)
    leaf_identity=os.lstat(physical_path);leaf_substitute_identity=os.lstat(substitute)
    leaf_substitute_before={"dev":leaf_substitute_identity.st_dev,"ino":leaf_substitute_identity.st_ino,
        "mode":leaf_substitute_identity.st_mode,
        "uid":leaf_substitute_identity.st_uid,"gid":leaf_substitute_identity.st_gid,
        "nlink":leaf_substitute_identity.st_nlink,"size":leaf_substitute_identity.st_size,
        "sha256":hashlib.sha256(substitute.read_bytes()).hexdigest()}
    leaf_bad=r15_cli_runpy_fault(
        repo,"controller/authority/cli",["owner-author"],
        stdin=json.dumps(author_request,sort_keys=True,separators=(",",":")),
        fault="path_substitute",target=physical_path,substitute=substitute)
    record("OWNER_AUTHOR_PHYSICAL_LEAF_OPEN_SUBSTITUTION_CAUSAL_REJECT",
           r15_fault_answer(leaf_bad,"leaf open race")
           and r15_fault_event_exact(leaf_bad,"path_substitute","open_redirect",
                                     {"target":[leaf_identity.st_dev,leaf_identity.st_ino],
                                      "substitute":[leaf_substitute_identity.st_dev,leaf_substitute_identity.st_ino],
                                      "opened":[leaf_substitute_identity.st_dev,leaf_substitute_identity.st_ino]})
           and physical_before==(
               filesystem_snapshot(bundle),filesystem_snapshot(workspace),
               r15_repository_authority_snapshot(repo,remote))
           and leaf_substitute_before=={"dev":os.lstat(substitute).st_dev,"ino":os.lstat(substitute).st_ino,
               "mode":os.lstat(substitute).st_mode,
               "uid":os.lstat(substitute).st_uid,"gid":os.lstat(substitute).st_gid,
               "nlink":os.lstat(substitute).st_nlink,"size":os.lstat(substitute).st_size,
               "sha256":hashlib.sha256(substitute.read_bytes()).hexdigest()},leaf_bad.stderr)
    opened_leaf=tmp/"physical-leaf-retained-original"
    leaf_rebind_bad=r15_cli_runpy_fault(
        repo,"controller/authority/cli",["owner-author"],
        stdin=json.dumps(author_request,sort_keys=True,separators=(",",":")),
