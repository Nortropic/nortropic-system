           direct_bad.returncode!=0 and (attest/"attestations.json").read_bytes()==preissue_store,
           direct_bad.stderr)
    reversed_request=dict(reversed(list(direct_request.items())))
    direct_positive_before=(filesystem_snapshot(state),filesystem_snapshot(workspace),
                            r15_repository_authority_snapshot(repo,remote))
    direct_finalizer_trace=tmp/"dispatch-r15-attest-finalizer.jsonl"
