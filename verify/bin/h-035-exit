def validate_registry(doc: object) -> tuple[bool, str]:
    if not isinstance(doc, dict): return False, "top-level type"
    if set(doc) != REG_KEYS: return False, "top-level membership"
    version = doc.get("schema_version")
    if type(version) is not int or version not in (1, 2): return False, "schema version"
    if doc.get("path_grammar") != "repo-tree-exact-or-terminal-recursive-prefix-v1": return False, "grammar"
    if doc.get("authority_source") != "git-candidate-plus-independent-gate-review-plus-owner-final-freeze": return False, "authority source"
    if doc.get("self_digest_is_authority") is not False: return False, "self digest"
    for key in ("owner_production_paths", "prospective_ordinary_protected_paths", "owner_author_global_denied_paths"):
        value = doc.get(key)
        if not isinstance(value, list) or not value or not all(isinstance(x, str) for x in value):
            return False, f"{key} type/empty"
        try: canon = [parse_path(x) for x in value]
        except ValueError as e: return False, f"{key} path {e}"
        if len(canon) != len(set(canon)): return False, f"{key} duplicate"
    required = REQUIRED_OWNER if version == 1 else PROSPECTIVE_OWNER
    if set(doc["owner_production_paths"]) != required: return False, "version-bound owner membership"
    return True, "ok"


def registry_selftests(good: dict[str, object]) -> None:
    ok, why = validate_registry(good); check(ok, "J_REGISTRY_POSITIVE", why)
    current = json.loads(json.dumps(good))
    current["schema_version"] = 1
    current["owner_production_paths"] = list(H034_OWNER_PATHS)
    prospective = json.loads(json.dumps(good))
    prospective["schema_version"] = 2
    prospective["owner_production_paths"] = [*H034_OWNER_PATHS, *H036_OWNER_PATHS]
    current_reordered = json.loads(json.dumps(current))
    current_reordered["owner_production_paths"] = list(reversed(current_reordered["owner_production_paths"]))
    reordered = json.loads(json.dumps(prospective))
    reordered["owner_production_paths"] = list(reversed(reordered["owner_production_paths"]))
    ok, why = validate_registry(current); check(ok, "J_R14_REGISTRY_V1_CURRENT_POSITIVE", why)
    ok, why = validate_registry(current_reordered); check(ok, "J_R14_REGISTRY_V1_REORDERED_EXACT_SET_POSITIVE", why)
    ok, why = validate_registry(prospective); check(ok, "J_R14_REGISTRY_V2_PROSPECTIVE_POSITIVE", why)
    ok, why = validate_registry(reordered); check(ok, "J_R14_REGISTRY_V2_REORDERED_EXACT_SET_POSITIVE", why)
    mutants: list[tuple[str, object]] = []
    for name, mutate in (
        ("MISSING_KEY", lambda d: d.pop("path_grammar")),
        ("UNEXPECTED_KEY", lambda d: d.update(extra=[])),
        ("WRONG_VERSION_STATE_PAIR", lambda d: d.update(schema_version=2)),
        ("WRONG_LIST_TYPE", lambda d: d.update(owner_production_paths={})),
        ("EMPTY_LIST", lambda d: d.update(owner_production_paths=[])),
        ("DUPLICATE_PATH", lambda d: d.update(owner_production_paths=list(d["owner_production_paths"])+[d["owner_production_paths"][0]])),
        ("MALFORMED_PATH", lambda d: d.update(owner_production_paths=["../escape"])),
        ("REQUIRED_REMOVED", lambda d: d.update(owner_production_paths=list(d["owner_production_paths"])[1:])),
        ("REQUIRED_ALTERED", lambda d: d.update(owner_production_paths=["controller/h034-native/*", *list(d["owner_production_paths"])[1:]])),
    ):
        copy = json.loads(json.dumps(current)); mutate(copy); mutants.append((name, copy))
    for name, mutant in mutants:
        accepted, _ = validate_registry(mutant)
        check(not accepted, f"J_REGISTRY_{name}")
    try:
        json.loads('{"schema_version":1,"schema_version":1}', object_pairs_hook=lambda p: (_ for _ in ()).throw(ValueError("duplicate")) if len({k for k,_ in p}) != len(p) else dict(p))
        duplicate_rejected = False
    except ValueError: duplicate_rejected = True
    check(duplicate_rejected, "J_REGISTRY_DUPLICATE_KEY")
    r14_mutants: list[dict[str, object]] = []
    for index in range(len(H036_OWNER_PATHS)):
        mutant = json.loads(json.dumps(prospective)); del mutant["owner_production_paths"][len(H034_OWNER_PATHS) + index]
        r14_mutants.append(mutant)
    for value in (
        "controller/launch/other.py", "controller/launch/**", "controller/**", "config/**",
        "controller\\launch\\cli", "./controller/launch/cli",
    ):
        mutant = json.loads(json.dumps(prospective)); mutant["owner_production_paths"][-3] = value
        r14_mutants.append(mutant)
    for version in (0, 3, True, 1.0, 2.0):
        mutant = json.loads(json.dumps(prospective)); mutant["schema_version"] = version
        r14_mutants.append(mutant)
    mutant = json.loads(json.dumps(prospective)); mutant["owner_production_paths"].append(H036_OWNER_PATHS[0]); r14_mutants.append(mutant)
    mutant = json.loads(json.dumps(prospective)); mutant["owner_production_paths"][0] = "controller/h034-native/kernel.c"; r14_mutants.append(mutant)
    mutant = json.loads(json.dumps(prospective)); mutant["owner_production_paths"].append("verify/h036/neighbor"); r14_mutants.append(mutant)
    mutant = json.loads(json.dumps(prospective)); mutant["schema_version"] = 1; r14_mutants.append(mutant)
    check(all(not validate_registry(mutant)[0] for mutant in r14_mutants),
          "J_R14_REGISTRY_PARTIAL_MIXED_ARBITRARY_MISSING_SUBSTITUTED_BROADER_DUPLICATE_ALIAS_REJECT")


def path_selftests() -> None:
    bad = ["", "/x", "C:/x", "./x", "x//y", "x/../y", "x/./y", "x/", "x/*", "x/**/y", "../x"]
    check(all(_bad_path(x) for x in bad), "J_PATH_REJECT_FAMILY")
    check(parse_path(r"a\b\c") == ("a/b/c", False), "J_PATH_BACKSLASH_NORMALIZED")
    check(overlap("controller/**", "controller/h034-native/kernel.c"), "J_PATH_PARENT")
    check(overlap("controller/h034-native/**", "controller/h034-native/kernel.c"), "J_PATH_CHILD")
    check(not overlap("safe/**", "controller/h034-native/**"), "J_PATH_SIBLING")
    # Predicted outcome: each superficial implementation is rejected by real acceptance below.
    for mutant, guard in (
        ("HARDCODE_PROBE_NAMES", "A_OWNER_ROUTE"),
        ("PERMISSIVE_REGISTRY_CONSUMER", "N_REGISTRY_RUNTIME"),
        ("DOCS_IMPACT_ESCALATION", "N_DOCS_IMPACT"),
        ("RESTART_LAUNCHES_BUILDER", "A_OWNER_RESTART"),
        ("REVIEW_AUTO_PUBLISH", "N_REVIEW_PUBLICATION"),
        ("AUTOPILOT_OLD_MATCHER", "N_PATH_CONSISTENCY"),
    ):
        print(f"MUTANT={mutant} PREDICTED=REJECT GUARD={guard}")


def _bad_path(value: str) -> bool:
    try: parse_path(value); return False
    except ValueError: return True


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")


def git(cwd: Path, *args: str) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd=cwd)


def git_object_bytes(repo: Path, sha: str, path: str) -> bytes | None:
    result = subprocess.run(["git", "-C", str(repo), "show", f"{sha}:{path}"],
                            capture_output=True, shell=False, check=False, timeout=45)
    return result.stdout if result.returncode == 0 else None


def init_repo(path: Path) -> str:
    path.mkdir()
    for args in (("init", "-q"), ("config", "user.name", "H035 Fixture"), ("config", "user.email", "fixture@example.invalid")):
        p = git(path, *args)
        if p.returncode: raise Rig(p.stderr)
    (path / "seed.txt").write_text("seed\n")
    for args in (("add", "seed.txt"), ("commit", "-qm", "seed")):
        p = git(path, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(path, "rev-parse", "HEAD").stdout.strip()


def commit_paths(repo: Path, message: str, *paths: str) -> str:
    # Fixture paths are repository data, never Git pathspec programs. This is
    # material for R11's legitimate filenames beginning with pathspec magic.
    for args in (("--literal-pathspecs", "add", "--", *paths),
                 ("commit", "-qm", message)):
        p = git(repo, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(repo, "rev-parse", "HEAD").stdout.strip()


def authority_repo(tmp: Path, name: str, tasks: list[dict[str, object]],
                   *, gates: dict[str, bytes] | None = None,
                   gate_modes: dict[str, int] | None = None,
                   registry: dict[str, object] | None = None) -> tuple[Path, str]:
    """A disposable Git authority root containing both canonical documents."""
    repo = tmp / name; init_repo(repo)
    (repo / "specs").mkdir()
    write_json(repo / "specs/tasks.spec.json", {
        "spec_version":"2.0.0", "defaults":{"denied_write":[]}, "tasks":tasks})
    if registry is None:
        (repo / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    else:
        write_json(repo / "specs/owner-production-paths.v1.json", registry)
    gate_paths: list[str] = []
    for task in tasks:
        gate_path = task.get("exit_test")
        if not isinstance(gate_path, str) or gate_path in gate_paths:
            continue
        target = repo / gate_path; target.parent.mkdir(parents=True, exist_ok=True)
        if gates is not None and gate_path in gates:
            target.write_bytes(gates[gate_path])
        elif gate_path == "verify/bin/h-035-exit":
            target.write_bytes(Path(__file__).read_bytes())
        else:
            target.write_bytes(b"#!/bin/sh\nexit 1\n")
        target.chmod(gate_modes.get(gate_path, 0o755) if gate_modes else 0o755)
        gate_paths.append(gate_path)
    base = commit_paths(repo, "canonical authority", "specs/tasks.spec.json",
                        "specs/owner-production-paths.v1.json", *gate_paths)
    return repo, base


def owner_task(task_id: str, surface: list[str],
               exit_test: str = "verify/bin/h-035-exit") -> dict[str, object]:
    return {"id":task_id, "authority_class":"owner_authority", "allowed_write":[],
            "owner_author_allowed_write":surface, "docs_impact":[], "depends_on":[],
            "exit_test":exit_test}


def ordinary_task(task_id: str, surface: list[str],
                  exit_test: str = "verify/bin/h-035-exit") -> dict[str, object]:
    return {"id":task_id, "authority_class":"ordinary", "allowed_write":surface,
            "owner_author_allowed_write":[], "docs_impact":[], "depends_on":[],
            "exit_test":exit_test}


def init_state(path: Path) -> None:
    p = run([str(STATE), "init", str(path)])
    if p.returncode: raise Rig(p.stderr or p.stdout)


def set_remote_main(remote: Path, source: Path, sha: str) -> None:
    p = run(["git", "fetch", "-q", str(source), sha], cwd=remote)
    if p.returncode: raise Rig(p.stderr)
    p = run(["git", "update-ref", "refs/heads/main", sha], cwd=remote)
    if p.returncode: raise Rig(p.stderr)


def candidate(repo: Path, base: str, path: str, serial: int) -> str:
    p = git(repo, "checkout", "-q", base)
    if p.returncode: raise Rig(p.stderr)
    target = repo / path; target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(f"h035 fixture candidate {serial}\n")
    for args in (("--literal-pathspecs", "add", "--", path),
                 ("commit", "-qm", f"candidate-{serial}")):
        p = git(repo, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(repo, "rev-parse", "HEAD").stdout.strip()


def candidate_paths(repo: Path, base: str, paths: list[str], serial: int) -> str:
    """Create one fixture candidate whose material diff covers every exact path."""
    p = git(repo, "checkout", "-q", base)
    if p.returncode: raise Rig(p.stderr)
    if not paths or len(paths) != len(set(paths)):
        raise Rig("candidate_paths requires a non-empty unique exact path list")
    for path in paths:
        target = repo / path; target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(f"h035 fixture candidate {serial}: {path}\n")
    for args in (("--literal-pathspecs", "add", "--", *paths),
                 ("commit", "-qm", f"candidate-{serial}")):
        p = git(repo, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(repo, "rev-parse", "HEAD").stdout.strip()


def registry_candidate(tmp: Path, name: str, raw: str) -> tuple[Path, str, str]:
    repo = tmp / f"registry-{name}"; base = init_repo(repo)
    target = repo / "specs/owner-production-paths.v1.json"; target.parent.mkdir()
    target.write_text(raw)
    # Operational authority is always candidate-local. Registry tests carry
    # a canonical task spec too, so none can pass by borrowing installed bytes.
    (repo / "specs/tasks.spec.json").write_bytes(SPEC.read_bytes())
    commit_paths(repo, name, "specs/tasks.spec.json", "specs/owner-production-paths.v1.json")
    return repo, base, git(repo, "rev-parse", "HEAD").stdout.strip()


def task_candidate(tmp: Path, name: str, version: str, task: dict[str, object]) -> tuple[Path, str, str]:
    repo = tmp / f"task-{name}"; base = init_repo(repo)
    (repo / "specs").mkdir()
    write_json(repo / "specs/tasks.spec.json", {"spec_version":version,"defaults":{"denied_write":[]},"tasks":[{"id":"fixture-task","depends_on":[],**task}]})
    (repo / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    p = git(repo, "add", "specs")
    if p.returncode: raise Rig(p.stderr)
    p = git(repo, "commit", "-qm", name)
    if p.returncode: raise Rig(p.stderr)
    return repo, base, git(repo, "rev-parse", "HEAD").stdout.strip()


def path_candidate(tmp: Path, name: str, pattern: str) -> tuple[Path, str, str]:
    repo = tmp / f"path-{name}"; init_repo(repo)
    (repo / "specs").mkdir()
    write_json(repo / "specs/tasks.spec.json", {"spec_version":"2.0.0", "defaults":{"denied_write":[]},
        "tasks":[{"id":"fixture-task", "authority_class":"ordinary", "allowed_write":[pattern],
                  "docs_impact":[], "depends_on":[]}]})
    (repo / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    git(repo, "add", "specs"); git(repo, "commit", "-qm", "canonical authority")
    base = git(repo, "rev-parse", "HEAD").stdout.strip()
    target = repo / "safe/x"; target.parent.mkdir(); target.write_text("effect\n")
    git(repo, "add", "safe/x"); git(repo, "commit", "-qm", "candidate")
    return repo, base, git(repo, "rev-parse", "HEAD").stdout.strip()


def process_snapshot() -> tuple[str, list[dict[str, object]], str]:
    argv = ["ps", "-ww", "-axo", "pid=,ppid=,pgid=,comm=,args="]
    try:
        p = subprocess.run(argv, text=True, capture_output=True, check=False,
                           timeout=V6_PROCESS_SNAPSHOT_TIMEOUT_S)
    except (OSError, PermissionError, subprocess.TimeoutExpired) as e:
        return "ODÖMBART", [], f"{type(e).__name__}: {e}"
    if p.returncode != 0:
        return "ODÖMBART", [], f"ps exit {p.returncode}: {p.stderr.strip()[:200]}"
    rows: list[dict[str, object]] = []
    for line in p.stdout.splitlines():
        fields = line.strip().split(None, 4)
        if len(fields) == 5 and all(fields[i].isdigit() for i in range(3)):
            rows.append({"pid":int(fields[0]), "ppid":int(fields[1]), "pgid":int(fields[2]),
                         "comm":fields[3], "args":fields[4]})
    return "OK", rows, ""


def observe_provider(rows: list[dict[str, object]], *, loop_pid: int, provider: Path,
                     nonce: str) -> tuple[dict[str, object] | None, list[dict[str, object]]]:
    by_pid = {int(r["pid"]): r for r in rows}
    # Bind the spelling actually passed to exec. On macOS /var resolves to
    # /private/var; resolving here made V2 reject the real /var/folders argv.
    provider_text = str(provider)
    required = [str(LOOP), str(ROOT/"controller/brytare/cli"),
                str(ROOT/"controller/utforare/cli"), str(ROOT/"controller/launch/cli")]
    loop_row = by_pid.get(loop_pid)
    if loop_row is None:
        return None, []
    controller_image = str(loop_row["comm"])

    def argv(row: dict[str, object]) -> list[str]:
        try:
            return shlex.split(str(row["args"]), posix=True)
        except ValueError:
            return []

    def stage(row: dict[str, object]) -> str | None:
        tokens = argv(row)
        # macOS truncates ps(1)'s comm field (the real Homebrew Python image is
        # observed as /opt/homebrew/Ce). Bind every controller stage to the
        # exact image reported for the gate-started loop.
        if str(row["comm"]) != controller_image:
            return None
        hits = [expected for expected in required if expected in tokens]
        return hits[0] if len(hits) == 1 else None

    for row in rows:
        comm = str(row["comm"]); tokens = argv(row)
        if comm != "/bin/sh" or tokens != ["/bin/sh", provider_text, nonce]:
            continue
        chain = [row]; seen = {int(row["pid"])}; parent = int(row["ppid"])
        while parent in by_pid and parent not in seen:
            ancestor = by_pid[parent]; chain.append(ancestor); seen.add(parent)
            if parent == loop_pid: break
            parent = int(ancestor["ppid"])
        if not chain or int(chain[-1]["pid"]) != loop_pid:
            continue
        ordered = list(reversed(chain[1:]))
        observed_stages = [stage(ancestor) for ancestor in ordered]
        if observed_stages == required:
            return row, chain
        if (len(ordered) == len(required) + 1
                and observed_stages[:len(required)] == required
                and str(ordered[-1]["comm"]).endswith("sandbox-exec")
                and stage(ordered[-1]) is None):
            return row, chain
    return None, []


def observe_provider_lifetime(proc: subprocess.Popen, *, provider: Path, nonce: str,
                              ready: Path, release: Path, snapshot_fn=process_snapshot,
                              clock=time.monotonic, pause=time.sleep,
                              startup_window_s: float = V6_STARTUP_WINDOW_S,
                              post_ready_window_s: float = V6_POST_READY_WINDOW_S,
                              ) -> tuple[str, dict[str, object]]:
    """Observe one provider attempt and unconditionally release it on conclusion.

    A post-ready snapshot may finish after the nominal window.  Production
    process_snapshot has its own hard timeout, and the controller fail-safe is
    ordered after window + maximum overrun + cleanup margin.
    """
    verdict = "FAIL"
    started = clock()
    startup_deadline = started + startup_window_s
    ready_deadline: float | None = None
    evidence: dict[str, object] = {
        "nonce":nonce, "samples":0, "post_ready_samples":0,
        "lifetime_synchronization":"V6 observer-owned release; readiness is never verdict authority",
        "startup_window_s":startup_window_s,
        "post_ready_window_s":post_ready_window_s,
        "process_snapshot_timeout_s":V6_PROCESS_SNAPSHOT_TIMEOUT_S,
        "provider_failsafe_s":V6_PROVIDER_FAILSAFE_S,
    }
    try:
        while proc.poll() is None:
            before = clock()
            if os.path.lexists(ready) and ready_deadline is None:
                ready_deadline = before + post_ready_window_s
                evidence["ready_observed"] = True
                evidence["ready_observed_at_s"] = before - started
            active_deadline = ready_deadline if ready_deadline is not None else startup_deadline
            if before >= active_deadline:
                evidence["window_exhausted"] = "post_ready" if ready_deadline is not None else "startup"
                break

            status, rows, why = snapshot_fn()
            after = clock()
            evidence["samples"] = int(evidence["samples"]) + 1
            if os.path.lexists(ready):
                if ready_deadline is None:
                    # Readiness during a slow snapshot gets a complete new
                    # post-ready window; elapsed pre-ready time cannot steal it.
                    ready_deadline = after + post_ready_window_s
                    evidence["ready_observed"] = True
                    evidence["ready_observed_at_s"] = after - started
                evidence["post_ready_samples"] = int(evidence["post_ready_samples"]) + 1
            if status == "ODÖMBART":
                verdict = "ODÖMBART"; evidence["observer_error"] = why; break
            hit, chain = observe_provider(rows, loop_pid=proc.pid, provider=provider, nonce=nonce)
            if hit is not None:
                verdict = "PASS"; evidence["provider"] = hit; evidence["ancestry"] = chain; break
            pause(0.03)
        if proc.poll() is not None:
            evidence["process_exited_before_observer_conclusion"] = True
    finally:
        # This is the only normal release.  The later controller timeout is a
        # cleanup fail-safe and is mechanically ordered after every bounded
        # post-ready sample can conclude, including its maximum overrun.
        release.touch()
        evidence["release_written"] = True
        evidence["observer_elapsed_s"] = clock() - started
    evidence["ready_observed"] = bool(evidence.get("ready_observed", False))
    return verdict, evidence


def observer_selftests() -> None:
    provider = Path("/var/folders/h035/provider.sh"); nonce = "a" * 32
    def row(pid: int, ppid: int, comm: str, args: str, pgid: int = 60) -> dict[str, object]:
        return {"pid":pid,"ppid":ppid,"pgid":pgid,"comm":comm,"args":args}
    forwarded = f" -- {provider} {nonce}"
    real_comm = "/opt/homebrew/Ce"
    chain = [row(10,1,real_comm,str(LOOP)+" run cfg",60),
             row(20,10,real_comm,str(ROOT/"controller/brytare/cli")+" kor"+forwarded,60),
             row(30,20,real_comm,str(ROOT/"controller/utforare/cli")+" kor"+forwarded,60),
             row(40,30,real_comm,str(ROOT/"controller/launch/cli")+" run"+forwarded,60),
             row(61,40,"/bin/sh",f"/bin/sh {provider} {nonce}",61)]
    check(observe_provider(chain, loop_pid=10, provider=provider, nonce=nonce)[0] is not None,
          "J_OBSERVER_REAL_OWNER_SPLIT_PGID_POSITIVE")
    shell = lambda pid, ppid, path=provider, value=nonce, extra="": row(
        pid, ppid, "/bin/sh", f"/bin/sh {path} {value}{extra}", pid)
    mutants = {
      "WRONG_NONCE":chain[:-1]+[shell(62,40,value="b"*32)],
      "STALE_NONCE":chain[:-1]+[shell(63,40,value="c"*32)],
      "NONCE_SUBSTRING":chain[:-1]+[shell(64,40,value=nonce+"x")],
      "SAME_BASENAME_DIFFERENT_PATH":chain[:-1]+[shell(65,40,path=Path("/private/other/provider.sh"))],
      "FORWARDED_ARGV_ONLY":chain[:-1],
      "SANDBOX_WITHOUT_PROVIDER":chain[:-1]+[row(66,40,"/usr/bin/sandbox-exec",f"/usr/bin/sandbox-exec {provider} {nonce}")],
      "OUTSIDE_LOOP_ANCESTRY":chain[:-1]+[shell(67,1)],
      "WRONG_LOOP_PID":chain,
      "MISSING_LAUNCH":chain[:3]+[shell(68,30)],
      "MISSING_UTFORARE":chain[:2]+[chain[3]|{"ppid":20}]+[shell(69,40)],
      "MISSING_BRYTARE":[chain[0],chain[2]|{"ppid":10},chain[3],shell(70,40)],
      "REORDERED_ANCESTRY":[chain[0],chain[2]|{"ppid":10},chain[1]|{"ppid":30},chain[3]|{"ppid":20},shell(71,40)],
      "UNRELATED_SH_EXTRA_ARG":chain[:-1]+[shell(72,40,extra=" unrelated")],
      "FABRICATED_PPID":chain[:-1]+[shell(73,999)],
      "FAKE_CONTROLLER_IMAGE":[chain[0],chain[1],chain[2],
          row(40,30,"/bin/sh",str(ROOT/"controller/launch/cli")+" run"+forwarded),shell(74,40)],
    }
    for name, rows in mutants.items():
        print(f"MUTANT={name} PREDICTED=REJECT GUARD=J_OBSERVER_{name}")
        test_loop_pid = 999 if name == "WRONG_LOOP_PID" else 10
        check(observe_provider(rows, loop_pid=test_loop_pid, provider=provider, nonce=nonce)[0] is None,
              f"J_OBSERVER_{name}")

    sandbox = chain[:-1]+[row(80,40,"/usr/bin/sandbox-exec","/usr/bin/sandbox-exec profile",80),
                          shell(81,80)]
    check(observe_provider(sandbox, loop_pid=10, provider=provider, nonce=nonce)[0] is not None,
          "J_OBSERVER_OPTIONAL_SANDBOX_POSITIVE")

    check((V6_PROCESS_SNAPSHOT_TIMEOUT_S, V6_STARTUP_WINDOW_S,
           V6_POST_READY_WINDOW_S, V6_RELEASE_CLEANUP_MARGIN_S,
           V6_PROVIDER_FAILSAFE_S) == (5.0, 24.0, 24.0, 10.0, 45),
          "J_OBSERVER_V6_FROZEN_LIFETIME_CONSTANTS")
    check(V6_PROVIDER_FAILSAFE_S > (V6_POST_READY_WINDOW_S
          + V6_PROCESS_SNAPSHOT_TIMEOUT_S + V6_RELEASE_CLEANUP_MARGIN_S),
          "J_OBSERVER_V6_FAILSAFE_AFTER_MAXIMUM_OBSERVER_COMPLETION")

    def start_fixture(root: Path, *, creates_ready: bool = True,
                      rapid_exit: bool = False) -> tuple[subprocess.Popen, Path, Path, Path]:
        ready = root / "ready"; release = root / "release"; worker = root / "provider.sh"
        if rapid_exit:
            source = "#!/bin/sh\nexit 7\n"
        elif creates_ready:
            source = synchronized_provider_script(ready, release)
        else:
            source = ("#!/bin/sh\n"
                      f"while [ ! -e {shlex.quote(str(release))} ]; do sleep 0.05; done\n"
                      "exit 7\n")
        worker.write_text(source); worker.chmod(0o700)
        proc = subprocess.Popen(["/bin/sh", str(worker), nonce], stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
        return proc, worker, ready, release

    def wait_ready(proc: subprocess.Popen, ready: Path) -> bool:
        deadline = time.monotonic() + 2
        while not ready.exists() and proc.poll() is None and time.monotonic() < deadline:
            time.sleep(0.01)
        return ready.exists()

    # Five empty snapshots consume 21 simulated seconds.  The sixth returns
    # the exact relationship after 25.2 seconds, later than the R7 review's
    # 20.2722-second counterexample and after the nominal 24-second check.
    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-slow-match-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root)
        is_ready = wait_ready(proc, ready); virtual = [0.0]; calls = [0]
        slow_chain = [row(proc.pid,1,real_comm,str(LOOP)+" run cfg",60),
                      row(120,proc.pid,real_comm,str(ROOT/"controller/brytare/cli")+f" kor -- {worker} {nonce}",60),
                      row(130,120,real_comm,str(ROOT/"controller/utforare/cli")+f" kor -- {worker} {nonce}",60),
                      row(140,130,real_comm,str(ROOT/"controller/launch/cli")+f" run -- {worker} {nonce}",60),
                      row(161,140,"/bin/sh",f"/bin/sh {worker} {nonce}",161)]
        def slow_then_match() -> tuple[str, list[dict[str, object]], str]:
            calls[0] += 1; virtual[0] += 4.2
            return "OK", slow_chain if calls[0] == 6 else [], ""
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=slow_then_match, clock=lambda:virtual[0], pause=lambda _delay:None)
        proc.communicate(timeout=3)
        check(is_ready and verdict == "PASS" and calls[0] == 6
              and float(evidence["observer_elapsed_s"]) > 20.2722
              and release.exists() and proc.returncode == 7,
              "J_OBSERVER_V6_SLOW_MATCH_AFTER_PRIOR_20_27_SECONDS", repr(evidence))

    # Marker-only slow schedules exhaust as FAIL, but the provider remains
    # alive for every sample and exits only after observer-owned release.
    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-slow-empty-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root)
        is_ready = wait_ready(proc, ready); virtual = [0.0]; alive = [True]
        def slow_empty() -> tuple[str, list[dict[str, object]], str]:
            alive[0] = alive[0] and proc.poll() is None; virtual[0] += 4.2
            return "OK", [], ""
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=slow_empty, clock=lambda:virtual[0], pause=lambda _delay:None)
        proc.communicate(timeout=3)
        check(is_ready and verdict == "FAIL" and alive[0]
              and float(evidence["observer_elapsed_s"]) > 20.2722
              and release.exists() and proc.returncode == 7,
              "J_OBSERVER_V6_SLOW_MARKER_ONLY_REJECTS_AND_RELEASES", repr(evidence))

    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-error-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root)
        is_ready = wait_ready(proc, ready)
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=lambda:("ODÖMBART", [], "forced observer error"))
        proc.communicate(timeout=3)
        check(is_ready and verdict == "ODÖMBART" and release.exists() and proc.returncode == 7
              and not evidence.get("provider"),
              "J_OBSERVER_V6_ERROR_RELEASES_WITHOUT_PASS", repr(evidence))

    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-no-ready-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root, creates_ready=False)
        virtual = [0.0]
        def no_ready_empty() -> tuple[str, list[dict[str, object]], str]:
            virtual[0] += 4.2; return "OK", [], ""
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=no_ready_empty, clock=lambda:virtual[0], pause=lambda _delay:None)
        proc.communicate(timeout=3)
        check(verdict == "FAIL" and not ready.exists() and release.exists() and proc.returncode == 7,
              "J_OBSERVER_V6_NO_READY_BOUNDED_FAIL_AND_CLEANUP", repr(evidence))

    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-rapid-exit-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root, rapid_exit=True)
        proc.wait(timeout=3)
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=lambda:("OK", [], ""))
        proc.communicate(timeout=3)
        check(verdict == "FAIL" and not ready.exists() and release.exists() and proc.returncode == 7,
              "J_OBSERVER_V6_RAPID_EXIT_NO_READY_REJECTS", repr(evidence))


def synchronized_provider_script(ready: Path, release: Path) -> str:
    """V6 provider: only observer release ends normal fixture lifetime."""
    return (
        "#!/bin/sh\n"
        f": > {shlex.quote(str(ready))}\n"
        f"while [ ! -e {shlex.quote(str(release))} ]; do\n"
        "  sleep 0.05\n"
        "done\n"
        "printf '%s\\n' 'fixture provider refusal' >&2\n"
        "exit 7\n")


def loop_fixture(tmp: Path, authority: str, *, restart: bool = False,
                 observe: bool = False) -> tuple[subprocess.CompletedProcess, str, str, bool, dict[str, object]]:
    """Execute the real normal loop entrypoint; only external boundaries are fixtures."""
    # Current workspace/loop resolves the repository from its installed ROOT.
    # The only repository effect is a disposable worktree under workspace_rot.
    repo = ROOT; base = git(ROOT, "rev-parse", "HEAD").stdout.strip()
    worker = tmp / f"provider-{authority}-{int(restart)}.sh"
    nonce = secrets.token_hex(16)
    ready = tmp / f"provider-{authority}-{int(restart)}-{nonce}.ready"
    release = tmp / f"provider-{authority}-{int(restart)}-{nonce}.release"
    if observe:
        # V6 lifetime synchronization.  Only observer release ends the normal
        # gate-owned shell lifetime; readiness is never execution evidence.
        worker.write_text(synchronized_provider_script(ready, release))
    else:
        worker.write_text("#!/bin/sh\nsleep 2\nprintf '%s\\n' 'fixture provider refusal' >&2\nexit 7\n")
    worker.chmod(0o700)
    allowed = ["safe/**"] if authority == "ordinary" else []
    owner_allowed = ["controller/h034-native/**"] if authority == "owner_authority" else []
    task = {"id":"fixture-task", "authority_class":authority, "allowed_write":allowed,
            "owner_author_allowed_write":owner_allowed, "docs_impact":[], "depends_on":[],
            "exit_test":"verify/bin/fixture-red", "max_changed_files":5, "max_added_lines":20}
    spec = tmp / f"spec-{authority}-{int(restart)}.json"
    write_json(spec, {"spec_version":"2.0.0", "defaults":{"denied_write":[]}, "tasks":[task]})
    state = tmp / f"state-{authority}-{int(restart)}"; attest = tmp / f"attest-{authority}-{int(restart)}"
    state_init = run([str(ROOT / "controller/state/cli"), "init", str(state)])
    if state_init.returncode: raise Rig(state_init.stderr or state_init.stdout)
    attest.mkdir()
    cfg = tmp / f"config-{authority}-{int(restart)}.json"
    write_json(cfg, {"spec":str(spec), "attest_dir":str(attest), "state_dir":str(state),
        "lease_dir":str(tmp/f"lease-{authority}-{int(restart)}"), "lease_resurs":"fixture",
        "workspace_rot":str(tmp/f"workspaces-{authority}-{int(restart)}"), "base_sha":base,
        "verifier_id":"h035-fixture-unregistered", "run_id":f"h035-{authority}-{int(restart)}",
        "brytare_rot":str(tmp/f"breaker-{authority}-{int(restart)}"), "budget":1, "troskel":1,
        "worker_cmd":[str(worker), nonce],
        "timeout_s":V6_PROVIDER_FAILSAFE_S if observe else 5})
    def observed_run() -> tuple[subprocess.CompletedProcess, str, dict[str, object]]:
        proc = subprocess.Popen([str(LOOP), "run", str(cfg)], cwd=repo,
                                text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if observe:
            verdict, evidence = observe_provider_lifetime(
                proc, provider=worker, nonce=nonce, ready=ready, release=release)
        else:
            verdict, evidence = "NOT_OBSERVED", {"nonce":nonce}
        try:
            stdout, stderr = proc.communicate(timeout=V6_RELEASE_CLEANUP_MARGIN_S)
        except subprocess.TimeoutExpired:
            proc.terminate()
            try:
                stdout, stderr = proc.communicate(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill(); stdout, stderr = proc.communicate(timeout=2)
            verdict = "ODÖMBART"
            evidence["cleanup_error"] = "loop did not exit within release cleanup margin"
        evidence.update({"loop_pid":proc.pid,"provider_path":str(worker),
                         "ready_observed":bool(evidence.get("ready_observed", False)),
                         "loop_cleanup_complete":proc.poll() is not None,
                         "ps_fields":["pid","ppid","pgid","comm","args"]})
        return subprocess.CompletedProcess(proc.args, proc.returncode, stdout, stderr), verdict, evidence
    first, verdict, evidence = observed_run()
    if restart:
        second, second_verdict, second_evidence = observed_run()
        if second_verdict == "PASS" or verdict != "PASS": verdict, evidence = second_verdict, second_evidence
        result = second
    else: result = first
    events = state / "events.jsonl"
    text = events.read_text(errors="replace") if events.exists() else ""
    done = '"status": "done"' in text or '"status":"done"' in text
    return result, verdict, text, done, evidence


def real_routing(tmp: Path) -> None:
    ordinary, _verdict, _, _, _ = loop_fixture(tmp, "ordinary")
    print("OWNER_ACCEPTANCE_OBSERVATION=DEFERRED_TO_OWNER_TERMINAL_V6")
    print("OWNER_ACCEPTANCE_REQUIRED=YES")
    owner, verdict, state, done, _ = loop_fixture(tmp, "owner_authority")
    owner_required = "OWNER_ACTION_REQUIRED" in state
    check(verdict == "NOT_OBSERVED" and owner_required and not done, "A_OWNER_ROUTE_REAL_EFFECT",
          f"rc={owner.returncode} verdict={verdict} state={state[-300:]!r}")
    restarted, verdict, state, done, _ = loop_fixture(tmp, "owner_authority", restart=True)
    check(verdict == "NOT_OBSERVED" and "OWNER_ACTION_REQUIRED" in state and not done,
          "A_OWNER_RESTART_REAL_RECONSTRUCTION",
          f"rc={restarted.returncode} verdict={verdict} state={state[-300:]!r}")


def owner_acceptance(candidate_sha: str, artifact: Path) -> int:
    """Candidate-bound owner-terminal subgate over the same normal loop route."""
    actual = git(ROOT, "rev-parse", "HEAD").stdout.strip()
    if not re.fullmatch(r"[0-9a-f]{40}", candidate_sha) or actual != candidate_sha:
        raise Rig(f"candidate mismatch requested={candidate_sha} actual={actual}")
    if git(ROOT, "status", "--porcelain").stdout.strip():
        raise Rig("owner acceptance requires clean immutable candidate")
    with tempfile.TemporaryDirectory(prefix="h035-owner-effect-") as raw:
        result, verdict, _state, _done, evidence = loop_fixture(Path(raw), "ordinary", observe=True)
    record = {
        "acceptance_mode": "H035_OWNER_PROVIDER_EXEC_V6",
        "task": "h-035", "candidate_sha": candidate_sha,
        "gate_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "spec_sha256": hashlib.sha256(SPEC.read_bytes()).hexdigest(),
        "normal_entrypoint": "controller/loop/cli run",
        "observer": "H035_OWNER_PROVIDER_EXEC_V6 exact-argv, loop-image-bound normal-ancestry, observer-release-coupled lifetime",
        "observer_version": 6,
        "candidate_bound_attempts": 1,
        "observer_verdict": verdict,
        "provider_process_execution_observed": verdict == "PASS",
        "raw_process_evidence": evidence,
        "loop_exit": result.returncode,
    }
    artifact.parent.mkdir(parents=True, exist_ok=True)
    artifact.write_text(json.dumps(record, sort_keys=True, indent=2) + "\n")
    print(json.dumps(record, sort_keys=True))
    return {"PASS":0, "FAIL":1, "ODÖMBART":2}.get(verdict, 2)


def authority_call(tmp: Path, command: str, request: dict[str, object]) -> tuple[int, dict[str, object], str]:
    if not AUTH.is_file(): return 127, {}, f"missing operational entrypoint {AUTH}"
    # Gate-owned operational probes must not dirty the immutable candidate.
    # RV-02 separately removes these controls when judging normal taskval and
    # policy production execution, so this harness hygiene cannot mask it.
    env = os.environ.copy(); env["PYTHONDONTWRITEBYTECODE"] = "1"
    p = run([str(AUTH), command], cwd=tmp, env=env, stdin=json.dumps(request))
    try: out = json.loads(p.stdout)
    except ValueError: out = {}
    return p.returncode, out, (p.stderr or p.stdout)[-500:]


def filesystem_snapshot(root: Path, *, exclude_top: set[str] | None = None) -> dict[str, str]:
    """Logical byte/type snapshot without following symlinks.

    The root, empty directories, symlink targets and filesystem object types
    are material.  Mode and ownership are included because content alone is
    insufficient to restore an executable or equally owned projection.
    Timestamps are excluded: merely reading the snapshot can update atime.
    """
    snapshot: dict[str, str] = {}
    excluded = exclude_top or set()

    def visit(item: Path, name: str) -> None:
        try:
            info = os.lstat(item)
        except FileNotFoundError:
            snapshot[name] = "ABSENT"
            return
        metadata = f"mode={stat.S_IMODE(info.st_mode):04o}:uid={info.st_uid}:gid={info.st_gid}"
        if stat.S_ISLNK(info.st_mode):
            snapshot[name] = f"L:{metadata}:target={os.readlink(item)}"
        elif stat.S_ISDIR(info.st_mode):
            snapshot[name] = f"D:{metadata}"
            with os.scandir(item) as entries:
                children = sorted(entries, key=lambda candidate: candidate.name)
            for entry in children:
                if name == "." and entry.name in excluded:
                    continue
                child_name = entry.name if name == "." else f"{name}/{entry.name}"
                visit(Path(entry.path), child_name)
        elif stat.S_ISREG(info.st_mode):
            digest = hashlib.sha256(item.read_bytes()).hexdigest()
            snapshot[name] = f"F:{metadata}:size={info.st_size}:sha256={digest}"
        else:
            snapshot[name] = f"OTHER:{stat.S_IFMT(info.st_mode):o}:{metadata}:size={info.st_size}"

    visit(root, ".")
    return snapshot


def repository_snapshot(repo: Path) -> dict[str, str]:
    """All repository-local filesystem bytes/types outside Git metadata."""
    return filesystem_snapshot(repo, exclude_top={".git"})


def snapshot_delta(before: dict[str, str], after: dict[str, str]) -> list[str]:
    return sorted(name for name in set(before) | set(after)
                  if before.get(name) != after.get(name))


def snapshot_selftests() -> None:
    """Mutate disposable objects to prove cleanup/type drift cannot collide."""
    with tempfile.TemporaryDirectory(prefix="h035-snapshot-selftest-") as raw:
        root = Path(raw) / "projection"; root.mkdir()
        empty = root / "state.db"; empty.mkdir()
        payload = root / "events.jsonl"; payload.write_bytes(b"event\n")
        link = root / "current"; link.symlink_to("events.jsonl")
        baseline = filesystem_snapshot(root)

        empty.rmdir()
        deleted = filesystem_snapshot(root)
        check(snapshot_delta(baseline, deleted) == ["state.db"],
              "J_SNAPSHOT_CLEANUP_MUTANT_EMPTY_DIRECTORY_DELETION_REJECTS",
              repr(snapshot_delta(baseline, deleted)))

        empty.write_bytes(b"")
        changed_type = filesystem_snapshot(root)
        check(snapshot_delta(baseline, changed_type) == ["state.db"],
              "J_SNAPSHOT_DIRECTORY_TO_FILE_REJECTS",
              repr(snapshot_delta(baseline, changed_type)))

        empty.unlink(); empty.mkdir()
        link.unlink(); link.symlink_to("state.db")
        changed_link = filesystem_snapshot(root)
        check(snapshot_delta(baseline, changed_link) == ["current"],
              "J_SNAPSHOT_SYMLINK_TARGET_REJECTS",
              repr(snapshot_delta(baseline, changed_link)))

        link.unlink(); link.symlink_to("events.jsonl")
        payload.chmod(0o600)
        changed_mode = filesystem_snapshot(root)
        check(snapshot_delta(baseline, changed_mode) == ["events.jsonl"],
              "J_SNAPSHOT_MODE_CHANGE_REJECTS",
              repr(snapshot_delta(baseline, changed_mode)))


def ordinary_python_env() -> dict[str, str]:
    """Normal execution: do not let the outer gate hide bytecode writes."""
    env = os.environ.copy()
    env.pop("PYTHONDONTWRITEBYTECODE", None)
    env.pop("PYTHONPYCACHEPREFIX", None)
    return env


def remote_refs(remote: Path) -> str:
    p = run(["git", "for-each-ref", "--format=%(refname) %(objectname)"], cwd=remote)
    if p.returncode: raise Rig(p.stderr)
    return p.stdout


def persisted_state(state_dir: Path) -> str:
    texts = []
    if state_dir.exists():
        for item in sorted(state_dir.rglob("*")):
            if item.is_file(): texts.append(item.read_text(errors="replace"))
    return "\n".join(texts)


def expect_auth(tmp: Path, name: str, command: str, request: dict[str, object], accepted: bool,
                *, state_after: str | None = None, state_changes: bool | None = None,
                workspace_changes: bool | None = None, refs_change: bool | None = None,
                **diagnostics: object) -> None:
    state_dir = Path(str(request["state_dir"])); workspace = Path(str(request["workspace_root"]))
    remote = Path(str(request["remote"]))
    before_state = filesystem_snapshot(state_dir)
    before_ws = filesystem_snapshot(workspace)
    before_refs = remote_refs(remote)
    rc, out, detail = authority_call(tmp, command, request)
    ok = ((rc == 0) == accepted) and out.get("accepted") is accepted
    after_state = filesystem_snapshot(state_dir)
    after_ws = filesystem_snapshot(workspace)
    after_refs = remote_refs(remote)
    for key, value in diagnostics.items(): ok = ok and out.get(key) == value
    if state_after is not None: ok = ok and state_after in persisted_state(state_dir)
    if state_changes is not None: ok = ok and ((before_state != after_state) is state_changes)
    if workspace_changes is not None: ok = ok and ((before_ws != after_ws) is workspace_changes)
    if refs_change is not None: ok = ok and ((before_refs != after_refs) is refs_change)
    check(ok, name, detail or repr(out))


def r14_product_diff_scope(repo: Path, base: str, candidate_sha: str) -> tuple[bool, str]:
    """Bind the separately reviewed R14 product to one core-only commit."""
    if (re.fullmatch(r"[0-9a-f]{40}", base) is None
            or re.fullmatch(r"[0-9a-f]{40}", candidate_sha) is None):
        return False, "base/candidate must be exact lowercase commit identities"
    for identity in (base, candidate_sha):
        resolved = git(repo, "rev-parse", "--verify", "--quiet", f"{identity}^{{commit}}")
        if resolved.returncode or resolved.stdout.strip() != identity:
            return False, f"unknown exact commit {identity}"
    parents = git(repo, "rev-list", "--parents", "-n", "1", candidate_sha)
    if parents.returncode or parents.stdout.split() != [candidate_sha, base]:
        return False, "candidate must have exactly the reviewed base as its single parent"
    changed = git(repo, "diff", "--name-only", "--no-renames", base, candidate_sha)
    if changed.returncode:
        return False, "cannot derive exact product Git diff"
    files = changed.stdout.splitlines()
    if files != ["controller/authority/core.py"]:
        return False, f"product changed set is not exact core-only: {files!r}"
    return True, "exact single-parent core-only product diff"


def r14_product_identity(base: str, candidate_sha: str) -> tuple[bool, str]:
    ok, why = r14_product_diff_scope(ROOT, base, candidate_sha)
    if not ok:
        return ok, why
    head = git(ROOT, "rev-parse", "HEAD")
    if head.returncode or head.stdout.strip() != candidate_sha:
        return False, "checked-out HEAD is not the exact product candidate"
    status = git(ROOT, "status", "--porcelain=v1", "--untracked-files=all")
    if status.returncode or status.stdout:
        return False, "product acceptance requires a clean immutable checkout"
    for relative, local in (("specs/tasks.spec.json", SPEC),
                            ("verify/bin/h-035-exit", Path(__file__))):
        raw = git_object_bytes(ROOT, candidate_sha, relative)
        if raw is None or raw != local.read_bytes():
            return False, f"candidate contract bytes mismatch: {relative}"
    return True, "clean exact candidate, contract bytes, and core-only diff bound"


def r14_product_scope_selftests(tmp: Path) -> None:
    repo = tmp / "r14-product-scope"; init_repo(repo)
    core = repo / "controller/authority/core.py"
    core.parent.mkdir(parents=True); core.write_text("base core\n")
    base = commit_paths(repo, "r14 product base", "controller/authority/core.py")
    good = candidate(repo, base, "controller/authority/core.py", 1410)
    good_ok = r14_product_diff_scope(repo, base, good)[0]

    checkout = git(repo, "checkout", "-q", base)
    if checkout.returncode: raise Rig(checkout.stderr)
    core.write_text("mutated core\n")
    cli = repo / "controller/authority/cli"; cli.write_text("out of scope\n")
    out_of_scope = commit_paths(repo, "r14 forbidden second product file",
                                "controller/authority/core.py", "controller/authority/cli")
    outside_ok = r14_product_diff_scope(repo, base, out_of_scope)[0]

    safe_only = candidate(repo, base, "safe/not-core.txt", 1411)
    safe_ok = r14_product_diff_scope(repo, base, safe_only)[0]
    stacked = candidate(repo, good, "controller/authority/core.py", 1412)
    stacked_ok = r14_product_diff_scope(repo, base, stacked)[0]
    check(good_ok and not outside_ok and not safe_ok and not stacked_ok,
          "J_R14_PRODUCT_EXACT_BASE_CANDIDATE_CORE_ONLY_DIFF_AND_OUT_OF_SCOPE_MUTANT")


def r14_registry_migration_controls(tmp: Path) -> None:
    """Effect-bound two-state parser migration; one causal aggregate RED."""
    canonical = strict_load(REG)
    if not isinstance(canonical, dict):
        raise Rig("R14 current registry is not an object")
    current = json.loads(json.dumps(canonical))
    current["schema_version"] = 1
    current["owner_production_paths"] = list(H034_OWNER_PATHS)
    prospective = json.loads(json.dumps(canonical))
    prospective["schema_version"] = 2
    prospective["owner_production_paths"] = [*H034_OWNER_PATHS, *H036_OWNER_PATHS]

    observations: list[tuple[str, bool, str, str]] = []

    def record(name: str, ok: bool, reason: str, detail: object) -> None:
        observations.append((name, ok, reason,
                             detail if isinstance(detail, str) else repr(detail)))

    def clone_case(name: str, registry: object, owner_surface: list[str],
                   protected_paths: list[str] | None = None,
                   global_denied_paths: list[str] | None = None) -> tuple[Path, str, str, Path]:
        protected_paths = (list(protected_paths) if protected_paths is not None
                           else [H036_OWNER_PATHS[0]])
        global_denied_paths = (list(global_denied_paths)
                               if global_denied_paths is not None else [])
        if not protected_paths:
            raise Rig("R14 protected positive-control paths must be non-empty")
        repo = tmp / ("r14-case-" + name.lower().replace("_", "-"))
        init_repo(repo)
        (repo / "specs").mkdir()
        registry_path = repo / "specs/owner-production-paths.v1.json"
        if isinstance(registry, dict):
            write_json(registry_path, registry)
        elif isinstance(registry, str):
            registry_path.write_text(registry + ("" if registry.endswith("\n") else "\n"))
        else:
            raise Rig("R14 registry fixture must be an object or raw JSON string")
        write_json(repo / "specs/tasks.spec.json", {
            "spec_version":"2.0.0",
            "defaults":{"denied_write":[], "max_changed_files":10,
                        "max_added_lines":100},
            "tasks":[],
        })
        commit_paths(repo, "r14 registry activation without future fixture tasks",
                     "specs/tasks.spec.json", "specs/owner-production-paths.v1.json")

        core_path = repo / "controller/authority/core.py"
        core_path.parent.mkdir(parents=True)
        core_path.write_bytes((ROOT / "controller/authority/core.py").read_bytes())
        policy_path = repo / "controller/policy/cli"
        policy_path.parent.mkdir(parents=True)
        policy_path.write_bytes((ROOT / "controller/policy/cli").read_bytes())
        policy_path.chmod(0o755)
        gate_path = repo / "verify/bin/h-035-exit"
        gate_path.parent.mkdir(parents=True)
        gate_path.write_bytes(Path(__file__).read_bytes())
        gate_path.chmod(0o755)
        tasks = [
            ordinary_task("r14-safe", ["tests/r14-safe/**"]),
            owner_task("r14-owner", owner_surface),
        ]
        tasks.extend(ordinary_task(f"r14-protected-{index}", [path])
                     for index, path in enumerate(protected_paths))
        tasks.extend(owner_task(f"r14-global-denied-{index}", [path])
                     for index, path in enumerate(global_denied_paths))
        write_json(repo / "specs/tasks.spec.json", {
            "spec_version":"2.0.0",
            "defaults":{"denied_write":[], "max_changed_files":10,
                        "max_added_lines":100},
            "tasks":tasks,
        })
        base = commit_paths(repo, "r14 material registry case",
                            "controller/authority/core.py", "controller/policy/cli",
                            "verify/bin/h-035-exit", "specs/tasks.spec.json")
        safe_candidate = candidate(repo, base, "tests/r14-safe/effect.txt", 1420)
        bare = tmp / ("r14-origin-" + name.lower().replace("_", "-") + ".git")
        p = run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
        if p.returncode: raise Rig(p.stderr)
        set_remote_main(bare, repo, base)
        return repo, base, safe_candidate, bare

    def call_unchanged(case: str, repo: Path, base: str, candidate_sha: str,
                       bare: Path, command: str, fields: dict[str, object],
                       *, accept: bool, reason: str | None = None,
                       seed: bool = False) -> tuple[bool, str]:
        suffix = command.replace("-", "-") + "-" + str(len(observations))
        state = tmp / f"r14-{case.lower()}-{suffix}-state"
        workspace = tmp / f"r14-{case.lower()}-{suffix}-workspace"
        request = transition_request(repo, base, str(fields.get("task_id", "r14-owner")),
                                     state, workspace, bare,
                                     candidate_sha=candidate_sha)
        request.update(fields)
        if seed:
            seed_owner_command_state(state, command, request)
        before = (filesystem_snapshot(state), filesystem_snapshot(workspace),
                  remote_refs(bare))
        rc, out, detail = authority_call(tmp, command, request)
        after = (filesystem_snapshot(state), filesystem_snapshot(workspace),
                 remote_refs(bare))
        accepted = rc == 0 and out.get("accepted") is True
        rejected = rc != 0 and out.get("accepted") is False
        reason_ok = reason is None or (rc == 1 and out.get("reason") == reason)
        unchanged = before == after
        ok = (accepted if accept else rejected and unchanged) and reason_ok
        return ok, repr({"rc":rc, "out":out, "unchanged":unchanged,
                         "detail":detail})

    def full_owner_chain(case: str, repo: Path, base: str,
                         bare: Path) -> tuple[bool, str]:
        state = tmp / f"r14-{case.lower()}-chain-state"
        workspace = tmp / f"r14-{case.lower()}-chain-workspace"
        write_json(state / "current.json", {
            "task":"r14-owner", "state":"OWNER_ACTION_REQUIRED", "base_sha":base})
        request = transition_request(repo, base, "r14-owner", state, workspace, bare)
        refs_before = remote_refs(bare)
        results = []
        for command, fields in (
            ("owner-author", {}),
            ("check-candidate", {"actor":"owner_authority"}),
            ("record-review", {"review_result":"PASS",
                               "review_identity":f"r14-{case}-review"}),
            ("owner-freeze", {"review_result":"PASS",
                              "review_identity":f"r14-{case}-review"}),
        ):
            rc, out, detail = authority_call(tmp, command, {**request, **fields})
            results.append((command, rc, out, detail))
        ok = (all(rc == 0 and out.get("accepted") is True
                  for _command, rc, out, _detail in results)
              and "OWNER_FROZEN" in persisted_state(state)
              and workspace.is_dir() and remote_refs(bare) == refs_before)
        return ok, repr(results)

    def policy_probe(repo: Path, base: str, candidate_sha: str,
                     task_id: str, *, accept: bool,
                     reason_fragment: str = "",
                     reason_exact: str = "") -> tuple[bool, str]:
        state = tmp / f"r14-policy-{task_id}-{candidate_sha}-state"
        workspace = tmp / f"r14-policy-{task_id}-{candidate_sha}-workspace"
        bare = tmp / f"r14-policy-{task_id}-{candidate_sha}-origin.git"
        p = run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
        if p.returncode: raise Rig(p.stderr)
        set_remote_main(bare, repo, base)
        before = (filesystem_snapshot(state), filesystem_snapshot(workspace),
                  remote_refs(bare))
        p = run([str(repo / "controller/policy/cli"), "check", task_id,
                 base, candidate_sha], cwd=repo, env=ordinary_python_env())
        after = (filesystem_snapshot(state), filesystem_snapshot(workspace),
                 remote_refs(bare))
        accepted = p.returncode == 0
        ok = (accepted is accept and before == after
              and (not reason_fragment or reason_fragment in (p.stdout + p.stderr))
              and (not reason_exact or (p.returncode == 4
                                        and p.stdout == reason_exact + "\n"
                                        and not p.stderr)))
        return ok, repr({"rc":p.returncode, "unchanged":before == after,
                         "output":(p.stdout or p.stderr)[-500:]})

    def concrete_path(pattern: str, serial: int) -> str:
        core, recursive = parse_path(pattern)
        return f"{core}/r14-{serial}.txt" if recursive else core

    def guarded_candidate(repo: Path, base: str, pattern: str, serial: int) -> str:
        """Touch one guarded path without corrupting canonical JSON consumers."""
        path = concrete_path(pattern, serial)
        if path not in {"specs/tasks.spec.json",
                        "specs/owner-production-paths.v1.json"}:
            return candidate(repo, base, path, serial)
        p = git(repo, "checkout", "-q", base)
        if p.returncode: raise Rig(p.stderr)
        target = repo / path
        target.write_bytes(target.read_bytes() + b"\n")
        return commit_paths(repo, f"candidate-{serial}", path)

    def path_permitted(path: str, guards: tuple[str, ...]) -> bool:
        target, target_recursive = parse_path(path)
        for guard in guards:
            parent, parent_recursive = parse_path(guard)
            if target_recursive:
                if parent_recursive and (target == parent
                                         or target.startswith(parent + "/")):
                    return True
            elif target == parent or (parent_recursive
                                      and target.startswith(parent + "/")):
                return True
        return False

    def require_distinguishing_entries(
            family: str, paths: list[str], *, owner_relation: str) -> None:
        for index, path in enumerate(paths):
            material = concrete_path(path, 1700 + index)
            if not overlap(material, path):
                raise Rig(f"R14 {family} entry {index} does not guard its probe")
            owner_paths = (*H034_OWNER_PATHS, *H036_OWNER_PATHS)
            if owner_relation == "disjoint":
                if any(overlap(path, owner) or overlap(material, owner)
                       for owner in owner_paths):
                    raise Rig(f"R14 {family} entry {index} is masked by owner production")
            elif owner_relation == "permitted":
                if not (path_permitted(path, owner_paths)
                        and path_permitted(material, owner_paths)):
                    raise Rig(f"R14 {family} entry {index} lacks owner-production control")
            else:
                raise Rig(f"R14 {family} unknown owner relation")
            for other_index, other in enumerate(paths):
                if index != other_index and (overlap(path, other)
                                             or overlap(material, other)):
                    raise Rig(f"R14 {family} entry {index} is masked by {other_index}")

    def positive_material(name: str, registry: dict[str, object],
                          owner_surface: list[str], owner_changes: list[str],
                          protected_paths: list[str],
                          global_denied_paths: list[str] | None = None,
                          *, require_protected_entry_independence: bool = False,
                          require_global_denied_entry_independence: bool = False,
                          global_denied_entries_owner_permitted: bool = False
                          ) -> tuple[bool, dict[str, str], tuple[Path, str, str, Path, str]]:
        global_denied_paths = (list(global_denied_paths)
                               if global_denied_paths is not None else [])
        if require_protected_entry_independence:
            require_distinguishing_entries(
                "prospective protected", protected_paths, owner_relation="disjoint")
        if require_global_denied_entry_independence:
            require_distinguishing_entries(
                "owner global deny", global_denied_paths,
                owner_relation=("permitted" if global_denied_entries_owner_permitted
                                else "disjoint"))
        repo, base, safe_candidate, bare = clone_case(
            name, registry, owner_surface, protected_paths, global_denied_paths)
        details: dict[str, str] = {}
        checks: list[bool] = []
        for label, command, candidate_sha, fields in (
            ("registry", "validate-registry", safe_candidate, {}),
            ("task", "validate-task", base, {"task_id":"r14-owner"}),
            ("candidate", "check-candidate", safe_candidate,
             {"task_id":"r14-safe", "actor":"ordinary"}),
        ):
            ok, detail = call_unchanged(name, repo, base, candidate_sha, bare,
                                        command, fields, accept=True)
            checks.append(ok); details[label] = detail
        ok, detail = full_owner_chain(name, repo, base, bare)
        checks.append(ok); details["base_owner_chain"] = detail
        changed_owner = candidate_paths(
            repo, base,
            [concrete_path(path, 1421 + index)
             for index, path in enumerate(owner_changes)],
            1421)
        ok, detail = call_unchanged(name + "-changed", repo, base, changed_owner,
                                    bare, "check-candidate",
                                    {"task_id":"r14-owner", "actor":"owner_authority"},
                                    accept=True)
        checks.append(ok); details["changed_owner_candidate"] = detail
        ok, detail = policy_probe(repo, base, safe_candidate, "r14-safe", accept=True)
        checks.append(ok); details["policy"] = detail
        for index, protected_path in enumerate(protected_paths):
            protected_task_id = f"r14-protected-{index}"
            ok, detail = call_unchanged(
                name + f"-protected-task-{index}", repo, base, base, bare,
                "validate-task", {"task_id":protected_task_id}, accept=False,
                reason="ordinary surface overlaps protected authority")
            checks.append(ok); details[f"protected_validate_task_{index}"] = detail
            protected_candidate = guarded_candidate(
                repo, base, protected_path, 1500 + index)
            ok, detail = call_unchanged(
                name + f"-protected-candidate-{index}", repo, base,
                protected_candidate, bare, "check-candidate",
                {"task_id":protected_task_id, "actor":"ordinary"},
                accept=False, reason="ordinary candidate overlaps protected authority")
            checks.append(ok); details[f"protected_check_candidate_{index}"] = detail
            ok, detail = policy_probe(repo, base, protected_candidate,
                                      protected_task_id, accept=False,
                                      reason_exact=(f"ordinary task {protected_task_id} "
                                                    "överlappar skyddad authority-yta"))
            checks.append(ok); details[f"ordinary_policy_protection_{index}"] = detail
        for index, global_denied_path in enumerate(global_denied_paths):
            global_task_id = f"r14-global-denied-{index}"
            ok, detail = call_unchanged(
                name + f"-global-denied-task-{index}", repo, base, base, bare,
                "validate-task", {"task_id":global_task_id}, accept=False,
                reason="owner surface overlaps global deny")
            checks.append(ok); details[f"global_denied_validate_task_{index}"] = detail
            denied_candidate = guarded_candidate(
                repo, base, global_denied_path, 1600 + index)
            ok, detail = call_unchanged(
                name + f"-global-denied-candidate-{index}", repo, base,
                denied_candidate, bare, "check-candidate",
                {"task_id":global_task_id, "actor":"owner_authority"},
                accept=False, reason="owner candidate changed global deny")
            checks.append(ok); details[f"global_denied_check_candidate_{index}"] = detail
        return all(checks), details, (repo, base, safe_candidate, bare, changed_owner)

    current_reordered = json.loads(json.dumps(current))
    current_reordered["owner_production_paths"] = list(
        reversed(current_reordered["owner_production_paths"]))
    prospective_reordered = json.loads(json.dumps(prospective))
    prospective_reordered["owner_production_paths"] = list(
        reversed(prospective_reordered["owner_production_paths"]))

    v1_ok, v1_detail, v1_case = positive_material(
        "V1_EXACT", current, list(H034_OWNER_PATHS), list(H034_OWNER_PATHS),
        list(H034_OWNER_PATHS))
    v1_reordered_ok, v1_reordered_detail, _ = positive_material(
        "V1_REORDERED", current_reordered, list(H034_OWNER_PATHS),
        list(H034_OWNER_PATHS), list(H034_OWNER_PATHS))
    _v1_repo, _v1_base, _v1_safe, _v1_bare, _v1_changed = v1_case
    v1_h036_repo, v1_h036_base = authority_repo(
        tmp, "r14-v1-h036-owner-denied",
        [owner_task("r14-h036-owner", list(H036_OWNER_PATHS))],
        registry=current)
    v1_h036_bare = tmp / "r14-v1-h036-owner-denied-origin.git"
    p = run(["git", "init", "--bare", "-q", str(v1_h036_bare)], cwd=tmp)
    if p.returncode: raise Rig(p.stderr)
    set_remote_main(v1_h036_bare, v1_h036_repo, v1_h036_base)
    v1_h036_ok, v1_h036_detail = call_unchanged(
        "V1-H036-DENIED", v1_h036_repo, v1_h036_base, v1_h036_base,
        v1_h036_bare, "validate-task", {"task_id":"r14-h036-owner"},
        accept=False, reason="owner surface outside owner production")
    record("V1_EXACT_AND_REORDERED_COMPATIBILITY", v1_ok and v1_reordered_ok
           and v1_h036_ok, "V1_COMPATIBILITY_REGRESSION",
           {"exact":v1_detail, "reordered":v1_reordered_detail,
            "h036_denied":v1_h036_detail})

    def registry_path_values(document: dict[str, object], key: str) -> list[str]:
        value = document.get(key)
        if (not isinstance(value, list) or not value
                or not all(isinstance(item, str) for item in value)):
            raise Rig(f"R14 {key} positive fixture is not a non-empty string list")
        return list(value)

    def canonical_list_entry_controls(
            state_name: str, template: dict[str, object]
            ) -> tuple[bool, dict[str, str]]:
        ok, detail, _ = positive_material(
            f"{state_name}_CANONICAL_LIST_ENTRIES", template,
            list(H034_OWNER_PATHS), [H034_OWNER_PATHS[1]],
            registry_path_values(template, "prospective_ordinary_protected_paths"),
            registry_path_values(template, "owner_author_global_denied_paths"),
            require_protected_entry_independence=True,
            require_global_denied_entry_independence=True)
        return ok, detail

    def non_owner_list_positives(
            state_name: str, template: dict[str, object]
            ) -> tuple[bool, dict[str, dict[str, str]]]:
        cases: list[tuple[str, str, list[str], bool]] = [
            ("PROSPECTIVE_DISTINGUISHING", "prospective_ordinary_protected_paths",
             ["r14-causal/protected/exact-a.txt",
              "r14-causal/protected/tree-b/**",
              "r14-causal/protected/exact-c.txt"], True),
            ("GLOBAL_DENIED_DISTINGUISHING", "owner_author_global_denied_paths",
             ["controller/h034-native/r14-causal-deny/exact-a.txt",
              "controller/h034-native/r14-causal-deny/tree-b/**",
              "controller/h034-native/r14-causal-deny/exact-c.txt"], True),
            ("PROSPECTIVE_OVERLAPPING", "prospective_ordinary_protected_paths",
             ["alternate/protected/**", "alternate/protected/child"], False),
            ("PROSPECTIVE_REORDERED", "prospective_ordinary_protected_paths", [
              "r14-causal/protected/exact-c.txt",
              "r14-causal/protected/tree-b/**",
              "r14-causal/protected/exact-a.txt"], True),
            ("GLOBAL_DENIED_OVERLAPPING", "owner_author_global_denied_paths",
             ["controller/h034-native/r14-overlap-deny/**",
              "controller/h034-native/r14-overlap-deny/child"], False),
            ("GLOBAL_DENIED_REORDERED", "owner_author_global_denied_paths", [
              "controller/h034-native/r14-causal-deny/exact-c.txt",
              "controller/h034-native/r14-causal-deny/tree-b/**",
              "controller/h034-native/r14-causal-deny/exact-a.txt"], True),
            ("PROSPECTIVE_BACKSLASH", "prospective_ordinary_protected_paths",
             ["r14-causal\\protected-backslash\\**"], True),
            ("GLOBAL_DENIED_BACKSLASH", "owner_author_global_denied_paths",
             ["controller\\h034-native\\r14-backslash-deny\\**"], True),
        ]
        results: list[bool] = []
        details: dict[str, dict[str, str]] = {}
        for label, field, values, distinguishing in cases:
            registry = json.loads(json.dumps(template)); registry[field] = values
            is_prospective = field == "prospective_ordinary_protected_paths"
            ok, detail, _ = positive_material(
                f"{state_name}_{label}", registry,
                (list(H034_OWNER_PATHS) if is_prospective
                 else [H034_OWNER_PATHS[1]]),
                [H034_OWNER_PATHS[1]],
                values if is_prospective else [H034_OWNER_PATHS[1]],
                [] if is_prospective else values,
                require_protected_entry_independence=(distinguishing and is_prospective),
                require_global_denied_entry_independence=(distinguishing and not is_prospective),
                global_denied_entries_owner_permitted=(distinguishing and not is_prospective))
            results.append(ok); details[label] = detail
        return all(results), details

    v1_canonical_lists_ok, v1_canonical_lists_detail = canonical_list_entry_controls(
        "V1", current)
    non_owner_positive_ok, non_owner_positive_detail = non_owner_list_positives(
        "V1_NON_OWNER", current)
    record("V1_NON_OWNER_LIST_VALUES_REMAIN_REGISTRY_AUTHORITY",
           v1_canonical_lists_ok and non_owner_positive_ok,
           "NON_OWNER_LIST_VALUES_WERE_INCORRECTLY_PINNED",
           {"canonical_every_entry":v1_canonical_lists_detail,
            "alternative_values":non_owner_positive_detail})

    v2_ok, v2_detail, v2_case = positive_material(
        "V2_EXACT", prospective, list(H036_OWNER_PATHS), list(H036_OWNER_PATHS),
        list(H036_OWNER_PATHS))
    v2_reordered_ok, v2_reordered_detail, _ = positive_material(
        "V2_REORDERED", prospective_reordered, list(H036_OWNER_PATHS),
        list(H036_OWNER_PATHS), list(H036_OWNER_PATHS))
    v2_h034_ok, v2_h034_detail, _ = positive_material(
        "V2_RETAINED_H034_EXACT", prospective, list(H034_OWNER_PATHS),
        list(H034_OWNER_PATHS), list(H034_OWNER_PATHS))
    v2_h034_reordered_ok, v2_h034_reordered_detail, _ = positive_material(
        "V2_RETAINED_H034_REORDERED", prospective_reordered,
        list(H034_OWNER_PATHS), list(H034_OWNER_PATHS), list(H034_OWNER_PATHS))
    v2_canonical_lists_ok, v2_canonical_lists_detail = canonical_list_entry_controls(
        "V2", prospective)
    v2_non_owner_ok, v2_non_owner_detail = non_owner_list_positives(
        "V2_NON_OWNER", prospective)
    record("V2_EXACT_POSITIVE_MATERIAL_CONSUMERS",
           v2_ok and v2_reordered_ok and v2_h034_ok and v2_h034_reordered_ok
           and v2_canonical_lists_ok and v2_non_owner_ok,
           "V1_ONLY_REJECTS_SCHEMA_V2",
           {"h036_exact":v2_detail, "h036_reordered":v2_reordered_detail,
            "retained_h034_exact":v2_h034_detail,
            "retained_h034_reordered":v2_h034_reordered_detail,
            "canonical_every_list_entry":v2_canonical_lists_detail,
            "non_owner_lists":v2_non_owner_detail})

    v2_repo, v2_base, _v2_safe, v2_bare, v2_changed = v2_case
    causal_checks: list[bool] = []
    causal_detail: dict[str, str] = {}
    for label, actor, task_id, reason in (
