def clean_head(repo,sha):
 def canonical(raw):
  value=raw.decode("utf-8",errors="strict")
  if (not value or value.replace("\\","/")!=value or value.startswith("/")
   or re.match(r"^[A-Za-z]:",value) or value.startswith("./") or value.endswith("/")
   or "//" in value or any(x in ("",".","..") for x in value.split("/"))
   or any(x in value for x in "*?[]{}")):raise Stop("noncanonical checkout path")
  return value
 def rows(raw):
  values=raw.split(b"\0")
  if not values or values[-1]!=b"":raise Stop("unterminated Git -z output")
  return values[:-1]
 def fields(value):return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_nlink,value.st_size,value.st_mtime_ns,value.st_ctime_ns)
 if not HEX40.fullmatch(sha):raise Stop("candidate SHA grammar")
 head=gitb(repo,"rev-parse","--verify","HEAD");status=gitb(repo,"status","--porcelain=v1","-z","--untracked-files=all")
 listing=gitb(repo,"ls-tree","-r","-z","--full-tree",sha);stage=gitb(repo,"ls-files","--cached","--stage","-z","--full-name");flags=gitb(repo,"ls-files","--cached","-v","-z","--full-name")
 if (head.returncode or head.stderr or head.stdout!=(sha+"\n").encode() or status.returncode or status.stderr or status.stdout
  or listing.returncode or listing.stderr or stage.returncode or stage.stderr or flags.returncode or flags.stderr):raise Stop("closed Git HEAD/status/tree/index observation")
 tracked={};expected_dirs=set();object_order=[]
 for entry in rows(listing.stdout):
  header,path_raw=entry.split(b"\t",1);parts=header.split(b" ")
  if len(parts)!=3:raise Stop("tree header")
  mode,kind,oid=(x.decode("ascii") for x in parts);path=canonical(path_raw)
  if path in tracked or kind!="blob" or mode not in ("100644","100755") or not HEX40.fullmatch(oid):raise Stop("tree member")
  tracked[path]=(mode,oid,b"");object_order.append(oid);parents=path.split("/")[:-1]
  for end in range(1,len(parents)+1):expected_dirs.add("/".join(parents[:end]))
 batch=gitb(repo,"cat-file","--batch",stdin=b"".join(oid.encode()+b"\n" for oid in object_order))
 if batch.returncode or batch.stderr:raise Stop("blob batch read")
 cursor=0;objects={}
 for oid in object_order:
  newline=batch.stdout.find(b"\n",cursor)
  if newline<0:raise Stop("blob batch header")
  header=batch.stdout[cursor:newline].split(b" ")
  if len(header)!=3 or header[0]!=oid.encode() or header[1]!=b"blob" or not header[2].isdigit():raise Stop("blob batch identity")
  size=int(header[2]);start=newline+1;finish=start+size
  if finish>=len(batch.stdout) or batch.stdout[finish:finish+1]!=b"\n":raise Stop("blob batch extent")
  raw=batch.stdout[start:finish];actual=hashlib.sha1(b"blob "+str(len(raw)).encode()+b"\0"+raw).hexdigest()
  if actual!=oid:raise Stop("blob identity")
  objects[oid]=raw;cursor=finish+1
 if cursor!=len(batch.stdout):raise Stop("blob batch trailing bytes")
 tracked={path:(mode,oid,objects[oid]) for path,(mode,oid,_raw) in tracked.items()}
 indexed={}
 for entry in rows(stage.stdout):
  header,path_raw=entry.split(b"\t",1);parts=header.split(b" ")
  if len(parts)!=3:raise Stop("index header")
  mode,oid,slot=(x.decode("ascii") for x in parts);path=canonical(path_raw)
  if path in indexed or slot!="0" or mode not in ("100644","100755") or not HEX40.fullmatch(oid):raise Stop("index member")
  indexed[path]=(mode,oid)
 if indexed!={path:(value[0],value[1]) for path,value in tracked.items()}:raise Stop("tree/index inequality")
 tagged=set()
 for entry in rows(flags.stdout):
  if not entry.startswith(b"H "):raise Stop("index flag")
  path=canonical(entry[2:])
  if path in tagged:raise Stop("duplicate index flag")
  tagged.add(path)
 if tagged!=set(tracked):raise Stop("index flag inventory")
 df=os.O_RDONLY|getattr(os,"O_DIRECTORY",0)|getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0)
 ff=os.O_RDONLY|getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0)|getattr(os,"O_NONBLOCK",0)
 opened=[];ancestors=[];directories={};leaves={}
 try:
  if not repo.is_absolute() or Path(os.path.normpath(str(repo)))!=repo:raise Stop("noncanonical repository root")
  parent=os.open(repo.anchor,df);opened.append(parent);ancestors.append((None,"",parent,fields(os.fstat(parent))))
  for part in repo.parts[1:]:
   before=os.stat(part,dir_fd=parent,follow_symlinks=False);child=os.open(part,df,dir_fd=parent);opened.append(child);after=os.fstat(child)
   if fields(before)!=fields(after) or not stat.S_ISDIR(after.st_mode):raise Stop("repository ancestor open race")
   ancestors.append((parent,part,child,fields(after)));parent=child
  root_fd=parent;root_identity=fields(os.fstat(root_fd));root_view=os.fstat(root_fd)
  if root_view.st_uid!=os.getuid() or stat.S_IMODE(root_view.st_mode)!=0o755:raise Stop("repository root identity")
  directories[""]=(root_fd,root_identity,None,"",None);stack=[""]
  while stack:
   prefix=stack.pop();descriptor=directories[prefix][0];names=os.listdir(descriptor)
   for name in names:
    name.encode("utf-8",errors="strict")
    if not name or "/" in name or name in (".",".."):raise Stop("directory member")
   if len(names)!=len(set(names)):raise Stop("directory duplicate")
   visible=set(names)-({".git"} if not prefix else set());wanted=set()
   for path in set(tracked)|expected_dirs:
    if prefix:
     if not path.startswith(prefix+"/"):continue
     rest=path[len(prefix)+1:]
    else:rest=path
    if "/" not in rest:wanted.add(rest)
   if visible!=wanted:raise Stop("directory inventory")
   directories[prefix]=(descriptor,directories[prefix][1],directories[prefix][2],directories[prefix][3],frozenset(names))
   for name in sorted(visible):
    relative=name if not prefix else prefix+"/"+name;before=os.stat(name,dir_fd=descriptor,follow_symlinks=False)
    if relative in expected_dirs:
     child=os.open(name,df,dir_fd=descriptor);opened.append(child);after=os.fstat(child)
     if fields(before)!=fields(after) or not stat.S_ISDIR(after.st_mode) or after.st_uid!=os.getuid() or stat.S_IMODE(after.st_mode)!=0o755:raise Stop("directory identity")
     directories[relative]=(child,fields(after),descriptor,name,None);stack.append(relative)
    elif relative in tracked:
     mode,_oid,want_raw=tracked[relative];want_mode=0o755 if mode=="100755" else 0o644
     if not stat.S_ISREG(before.st_mode) or before.st_uid!=os.getuid() or before.st_nlink!=1 or stat.S_IMODE(before.st_mode)!=want_mode or before.st_size>8*1024*1024:raise Stop("leaf identity")
     leaf=os.open(name,ff,dir_fd=descriptor);opened.append(leaf);after=os.fstat(leaf)
     if fields(before)!=fields(after):raise Stop("leaf open race")
     raw=b"";offset=0
     while offset<after.st_size:
      part=os.pread(leaf,min(65536,after.st_size-offset),offset)
      if not part:raise Stop("leaf short read")
      raw+=part;offset+=len(part)
     if os.pread(leaf,1,offset) or raw!=want_raw:raise Stop("leaf bytes")
     leaves[relative]=(leaf,fields(after),descriptor,name)
    else:raise Stop("untracked entry")
  if set(directories)-{""}!=expected_dirs or set(leaves)!=set(tracked):raise Stop("physical inventory inequality")
  for leaf,want,parent_fd,name in leaves.values():
   if fields(os.fstat(leaf))!=want or fields(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=want:raise Stop("leaf final rebind")
  for _relative,(descriptor,want,parent_fd,name,names) in reversed(list(directories.items())):
   if fields(os.fstat(descriptor))!=want or frozenset(os.listdir(descriptor))!=names:raise Stop("directory final identity")
   if parent_fd is not None and fields(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=want:raise Stop("directory final rebind")
  if fields(os.stat(repo,follow_symlinks=False))!=root_identity:raise Stop("repository root path rebind")
  for parent_fd,name,descriptor,want in reversed(ancestors):
   if fields(os.fstat(descriptor))!=want:raise Stop("repository ancestor changed")
   if parent_fd is not None and fields(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=want:raise Stop("repository ancestor rebind")
 finally:
  for descriptor in reversed(opened):
   try:os.close(descriptor)
   except OSError:pass
