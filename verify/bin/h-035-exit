    mutant=clone(); mutant["current_state"]["schema_version"]=1.0; state_mutants.append(mutant)
    check(all(not exact_value(mutant,H035_R14_TWO_STATE_REGISTRY) for mutant in state_mutants),
          "J_R14_VERSION_MEMBERSHIP_AND_TYPE_BINDING_REJECT")
    scope_mutants=[]
    for key in ("test_author_allowed_write","builder_actual_changed_files"):
        mutant=clone(); mutant[key].pop(); scope_mutants.append(mutant)
        mutant=clone(); mutant[key].append("controller/**"); scope_mutants.append(mutant)
    mutant=clone(); mutant["registry_mutation_owner"]="H035"; scope_mutants.append(mutant)
    mutant=clone(); mutant["product_acceptance"]["exact_git_diff"].append("controller/authority/cli"); scope_mutants.append(mutant)
    mutant=clone(); mutant["product_acceptance"]["base_candidate_relation"]="BASE_IS_ANCESTOR"; scope_mutants.append(mutant)
    mutant=clone(); mutant["product_acceptance"]["operational_matrix"]="STANDARD_MODE_ONLY"; scope_mutants.append(mutant)
    mutant=clone(); mutant["operational_matrix"]["material_consumers"].pop(); scope_mutants.append(mutant)
