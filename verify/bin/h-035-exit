    "fd=int(sys.argv[1]);expected=sys.argv[2];identity=tuple(json.loads(sys.argv[3]));canonical=sys.argv[4];args=sys.argv[5:]\n"
    "fields=lambda value:(value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_nlink,value.st_size,value.st_mtime_ns,value.st_ctime_ns)\n"
    "opened=os.fstat(fd)\n"
    "if fields(opened)!=identity or not stat.S_ISREG(opened.st_mode) or opened.st_uid!=os.getuid() or opened.st_nlink!=1 or stat.S_IMODE(opened.st_mode)!=0o755 or opened.st_size>262144:raise SystemExit(126)\n"
    "raw=b'';offset=0\n"
    "while offset<opened.st_size:\n part=os.pread(fd,min(65536,opened.st_size-offset),offset)\n if not part:raise SystemExit(126)\n raw+=part;offset+=len(part)\n"
    "if hashlib.sha256(raw).hexdigest()!=expected or fields(os.fstat(fd))!=identity:raise SystemExit(126)\n"
    "sys.argv=[canonical,*args];namespace={'__name__':'__main__'};namespace['__'+'file__']=canonical\n"
    "exec(compile(raw,canonical,'exec',dont_inherit=True,optimize=0),namespace,namespace)\n"
