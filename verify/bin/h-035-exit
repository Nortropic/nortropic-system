            final_recovery=(attest/".r15-attest-recovery.jsonl").read_bytes()
            final_rows=[strict_json_bytes(line) for line in final_recovery.splitlines()]
            pending_results.append(
                different.returncode!=0 and still_pending==pending_snapshot
                and replay[0]==0 and final_shadow==b""
