    artifacts=[*H035_R33_REQUEST_BOUND_REGISTRY["immutable_no_credit_product_attempts"],
               H035_R33_REQUEST_BOUND_REGISTRY["architectural_impossibility"]]
    artifact_checks=[]
    for row in artifacts:
        path=Path(str(row["artifact_path"]))
        try:raw=path.read_bytes()
        except OSError:raw=b""
        artifact_checks.append(hashlib.sha256(raw).hexdigest()==row["artifact_sha256"])
    review_checks=[];no_credit_identities=[]
    for key in ("prior_no_credit_gate_candidate",
                "intermediate_no_credit_gate_candidate",
                "immutable_no_credit_gate_candidate"):
        no_credit=H035_R33_REQUEST_BOUND_REGISTRY[key]
        for row in no_credit["review_artifacts"]:
            path=Path(str(row["path"]))
            try:
                raw=path.read_bytes();value=strict_json_bytes(raw)
            except (OSError,UnicodeError,ValueError,json.JSONDecodeError):
                raw=b"";value=None
            review_checks.append(hashlib.sha256(raw).hexdigest()==row["sha256"]
                and isinstance(value,dict) and value.get("result")==row["result"]
                and value.get("role")=="GATE_REVIEWER"
                and value.get("contract_candidate_sha")==no_credit["candidate_sha"])
        identity=git(ROOT,"rev-list","--parents","-n","1",
                     str(no_credit["candidate_sha"]))
        tree=git(ROOT,"rev-parse",str(no_credit["candidate_sha"])+"^{tree}")
        no_credit_identities.append(identity.returncode==0
            and identity.stdout.split()==[
                no_credit["candidate_sha"],no_credit["authority_base_sha"]]
            and tree.returncode==0 and tree.stdout.strip()==no_credit["candidate_tree"])
    check(len(artifact_checks)==3 and all(artifact_checks)
          and len(review_checks)==6 and all(review_checks)
          and len(no_credit_identities)==3 and all(no_credit_identities),
          "F_R33_IMMUTABLE_NO_CREDIT_AND_IMPOSSIBILITY_ARTIFACT_IDENTITIES")
    delegation=(ROOT/"docs/loop/remaining-bootstrap-delegation-v1.md").read_bytes()
    decision=r33_owner_decision_split(delegation)
    terms=(b"controller/authority/core.py",b"controller/authority/cli",
           b"strict NUL-delimited UTF-8",b"check-candidate",b"transition_context",
           b"ContextVar",b"caller-introspection",b"not a parent",
           b"nested/reentrant/concurrent",b"No\nsupervisor resume",
           b"b49a99cd25d3c2a85b397cfb9ffb812adb2acfb8",
           b"R31-A-001_NESTED_MUTABLE_DEFAULT_AMBIENT_ORACLE_BYPASS",
           b"closed positive whole-module AST",b"candidate==base==remote-main")
    check(decision is not None and all(term in decision[1] for term in terms),
          "F_R33_EXACT_OWNER_DECISION_BOUNDARY")
    owner_workflow=(ROOT/"docs/loop/owner-author-workflow-v1.md").read_text(encoding="utf-8")
    terms=("H-035 R33 request-bound registry consumer refreeze",
           "git diff --name-only -z","strict UTF-8","candidate-object registry",
           "legacy request-bound CLI consumers",
           "Opposite mutable-checkout, semantically applicable base registry bytes",
           "same-process child sequence","owner surface outside owner production",
           "nested, reentrant and deterministic concurrent",
           "exact only files, canonical JSON bytes and 0600 modes",
           "b49a99cd25d3c2a85b397cfb9ffb812adb2acfb8",
           "R31-B-001_INDIRECT_AMBIENT_MUTATION_SOURCE_ORACLE_BYPASS",
           "positive reference mechanically", "additional closed 2×5 matrix",
           "--r33-registry-migration BASE_SHA CANDIDATE_SHA",
           "A_R33_REQUEST_BOUND_REGISTRY_AND_NUL_PATH_OPERATIONAL",
           "Core-only, CLI-only", "third-path and\nstacked")
    check(all(term in owner_workflow for term in terms),
          "F_R33_WORKFLOW_DATAFLOW_PATH_AND_IDENTITY_CONTRACT")


def r15_gate_expected_policy() -> dict[str,object]:
    return {
        "base_definitions_exact_once_in_order":True,"unchanged_definition_count":53,
        "altered_definition_names":list(H035_R15_GATE_ALTERED_DEFINITIONS),
        "other_retained_statements_normalize_exactly_to_base":True,
        "base_nondefinitions_unique_ordered_subsequence":True,"terminal_main_guard_exact":True,
        "exact_python_preamble_and_no_pep263_encoding_override":True,
        "inherited_binding_rebind_alias_global_nonlocal_code_globals_module_mutation":False,
        "scope_analysis_claim":"DEFENSE_IN_DEPTH_FOR_EXACT_ADMITTED_SOURCE_NOT_A_GENERAL_PYTHON_SEMANTICS_PROOF",
        "nested_or_conditional_imports":False,
        "module_level_executable_statements_or_unreviewed_calling_assignments":False,
        "exact_source_aggregate_is_primary_authority":True,
        "reviewed_parent_environment_save_restore_functions_ast_exact":True,
        "capability_family_checks_are_supplemental_to_exact_source_aggregate":True,
        "import_effect_oracle_preserves_inherited_callable_identity":True,
        "new_top_level_requires_exact_manifest":True,
        "manifest_independent_admitted_definition_count":154,
        "manifest_independent_admitted_definition_aggregate_sha256":H035_R15_GATE_ADMITTED_DEFINITION_AGGREGATE,
        "manifest_independent_admitted_nondefinition_count":82,
        "manifest_independent_admitted_nondefinition_aggregate_sha256":H035_R15_GATE_ADMITTED_NONDEFINITION_AGGREGATE,
        "manifest_independent_complete_ordered_module_body_aggregate_sha256":H035_R15_GATE_ADMITTED_BODY_AGGREGATE,
        "complete_body_aggregate_normalizes_exactly_body_nondefinition_and_contract_digest_anchor_literals":True,
        "aggregate_anchor_literal_equals_trusted_runtime_constant_and_position_is_bound":True,
        "contract_digest_source_normalization_sentinel":"<H035_R15_CONTRACT_SHA256_AUTHORITY_V1>",
        "contract_digest_normalization_sites":["admitted_new_top_level_ast_and_layout_projection",
            "manifest_independent_admitted_nondefinition_aggregate",
            "manifest_independent_complete_ordered_module_body_aggregate"],
        "contract_digest_normalizes_only_exact_one_simple_top_level_assignment_literal":True,
        "contract_digest_raw_binding_position_syntax_lowerhex_and_runtime_value_separately_exact":True,
        "contract_digest_literal_equals_full_owner_lifecycle_canonical_json_sha256":True,
        "historical_floor_direct_ordered_calls_only":True,
        "frozen_checks_directly_precedes_floor_and_dominates_both_r15_arms":True,
        "floor_catch_conditional_return_counter_reset":False,
    }


def r15_contract_selftests(contract: object, tasks: list[object], current_spec: object) -> None:
    """The R15 manifest is exact frozen authority, not an extensible schema."""
    r15_attest_trace_invocation_selftests()
    check(isinstance(contract, dict)
          and canonical_json_sha256(contract) == H035_R15_CONTRACT_SHA256,
          "J_R15_EXACT_CONTRACT_DIGEST_POSITIVE")
    if not isinstance(contract, dict):
        check(False, "J_R15_CONTRACT_TOP_LEVEL_MUTANTS_REJECT", "contract not object")
        return
    mutants: list[object] = []
    for key in contract:
        mutant = json.loads(json.dumps(contract)); mutant.pop(key); mutants.append(mutant)
    mutant = json.loads(json.dumps(contract)); mutant["extra_authority"] = True; mutants.append(mutant)
    mutant = json.loads(json.dumps(contract)); mutant["fail_closed"] = 1; mutants.append(mutant)
    mutant = json.loads(json.dumps(contract)); mutant["product_budget"]["max_added_lines"] = 1950; mutants.append(mutant)
    mutant = json.loads(json.dumps(contract)); mutant["product_budget"]["max_deleted_lines"] = 1; mutants.append(mutant)
    mutant = json.loads(json.dumps(contract)); mutant["product_budget"]["max_total_changed_lines"] = 1950; mutants.append(mutant)
    mutant = json.loads(json.dumps(contract)); mutant["historical_h036_import"]["task"] = "h-034"; mutants.append(mutant)
    mutant = json.loads(json.dumps(contract)); mutant["publication_finalization"]["ordered_parents"].reverse(); mutants.append(mutant)
    mutant = json.loads(json.dumps(contract)); mutant["owner_publication_attestation"]["exact_fields"].pop(); mutants.append(mutant)
    check(all(canonical_json_sha256(value) != H035_R15_CONTRACT_SHA256 for value in mutants),
          "J_R15_MISSING_EXTRA_TYPE_BUDGET_GRAPH_SCHEMA_MUTANTS_REJECT")
    policy=((contract.get("gate_inheritance_scope") or {}).get("policy")
            if isinstance(contract.get("gate_inheritance_scope"),dict) else None)
    check(isinstance(policy,dict) and exact_value(policy,r15_gate_expected_policy()),
          "J_R15_GATE_INHERITANCE_COMPLETE_POLICY_EXACT")
    normalization_policy={
        "manifest_independent_admitted_definition_count":154,
        "manifest_independent_admitted_definition_aggregate_sha256":H035_R15_GATE_ADMITTED_DEFINITION_AGGREGATE,
        "manifest_independent_admitted_nondefinition_count":82,
        "manifest_independent_admitted_nondefinition_aggregate_sha256":H035_R15_GATE_ADMITTED_NONDEFINITION_AGGREGATE,
        "manifest_independent_complete_ordered_module_body_aggregate_sha256":H035_R15_GATE_ADMITTED_BODY_AGGREGATE,
        "complete_body_aggregate_normalizes_exactly_body_nondefinition_and_contract_digest_anchor_literals":True,
        "aggregate_anchor_literal_equals_trusted_runtime_constant_and_position_is_bound":True,
        "contract_digest_source_normalization_sentinel":"<H035_R15_CONTRACT_SHA256_AUTHORITY_V1>",
        "contract_digest_normalization_sites":[
            "admitted_new_top_level_ast_and_layout_projection",
            "manifest_independent_admitted_nondefinition_aggregate",
            "manifest_independent_complete_ordered_module_body_aggregate"],
        "contract_digest_normalizes_only_exact_one_simple_top_level_assignment_literal":True,
        "contract_digest_raw_binding_position_syntax_lowerhex_and_runtime_value_separately_exact":True,
        "contract_digest_literal_equals_full_owner_lifecycle_canonical_json_sha256":True,
    }
    projection=lambda value:{key:item for key,item in value.items()
        if key in normalization_policy or key.startswith("manifest_independent_")
        or key.startswith("contract_digest_")
        or key.startswith("complete_body_aggregate_")
        or key.startswith("aggregate_anchor_literal_")} if isinstance(value,dict) else None
    policy_mutants=[]
    for key in normalization_policy:
        value=json.loads(json.dumps(normalization_policy)); value.pop(key); policy_mutants.append(value)
    for key,hostile_values in (
            ("manifest_independent_admitted_definition_count",(153,154.0,True)),
            ("manifest_independent_admitted_nondefinition_count",(81,82.0,True)),
            ("manifest_independent_admitted_definition_aggregate_sha256",("0"*64,True)),
            ("manifest_independent_admitted_nondefinition_aggregate_sha256",("0"*64,True)),
            ("manifest_independent_complete_ordered_module_body_aggregate_sha256",("0"*64,True))):
        for hostile in hostile_values:
            value=json.loads(json.dumps(normalization_policy)); value[key]=hostile
            policy_mutants.append(value)
    value=json.loads(json.dumps(normalization_policy)); value["contract_digest_extra"]=True; policy_mutants.append(value)
    value=json.loads(json.dumps(normalization_policy)); value["manifest_independent_extra_authority"]=True; policy_mutants.append(value)
    value=json.loads(json.dumps(normalization_policy)); value["contract_digest_normalization_sites"].reverse(); policy_mutants.append(value)
    value=json.loads(json.dumps(normalization_policy)); value["contract_digest_source_normalization_sentinel"]="wrong"; policy_mutants.append(value)
    value=json.loads(json.dumps(normalization_policy)); value["contract_digest_normalizes_only_exact_one_simple_top_level_assignment_literal"]=1; policy_mutants.append(value)
    check(exact_value(projection(policy),normalization_policy)
          and all(not exact_value(projection(value),normalization_policy)
                  for value in policy_mutants),
          "J_R15_CONTRACT_DIGEST_NORMALIZATION_POLICY_EXACT_AND_CAUSAL")

    legacy = {row.get("id"): row for row in tasks if isinstance(row, dict)
              and row.get("id") in H035_R15_LEGACY_TASKS}
    check(tuple(legacy) == H035_R15_LEGACY_TASKS
          and all(legacy[task].get("authority_class") == "ordinary"
                  for task in H035_R15_LEGACY_TASKS),
          "F_R15_LEGACY_H001_H017_EXPLICIT_ORDINARY_NORMALIZATION")
    base_spec_raw = r15_git_object_bytes(
        ROOT, H035_R15_BASE, "specs/tasks.spec.json")
    base_spec: object = None
    try:
        base_spec = strict_json_bytes(base_spec_raw or b"")
        base_rows = {row.get("id"):row for row in base_spec.get("tasks", [])
                     if isinstance(row, dict) and row.get("id") in H035_R15_LEGACY_TASKS}
    except (ValueError, AttributeError):
        base_rows = {}
    normalized_exact = tuple(base_rows) == H035_R15_LEGACY_TASKS
    for task_id in H035_R15_LEGACY_TASKS:
        current = json.loads(json.dumps(legacy.get(task_id, {})))
        normalized_exact = (normalized_exact
                            and current.pop("authority_class", None) == "ordinary"
                            and exact_value(current, base_rows.get(task_id)))
    check(normalized_exact,
          "F_R15_LEGACY_H001_H017_ONLY_AUTHORITY_CLASS_BYTE_SEMANTIC_DELTA_FROM_BASE")
    for task_id in H035_R15_LEGACY_TASKS:
        mutant = json.loads(json.dumps(legacy[task_id])); mutant.pop("authority_class")
        check(mutant.get("authority_class") != "ordinary",
              "J_R15_LEGACY_" + task_id.upper().replace("-", "_") + "_MISSING_CLASS_REJECT")

    r29_base_spec_raw=r15_git_object_bytes(
        ROOT,str(H035_R29_THREE_STATE_REGISTRY["preproduct_evidence"]["base_sha"]),
        "specs/tasks.spec.json")
    try:r29_base_spec=strict_json_bytes(r29_base_spec_raw or b"")
    except ValueError:r29_base_spec=None

    def exact_spec_transform(candidate_spec: object) -> bool:
        if not isinstance(candidate_spec,dict) or not isinstance(r29_base_spec,dict): return False
        candidate_copy=json.loads(json.dumps(candidate_spec))
        base_copy=json.loads(json.dumps(r29_base_spec))
        candidate_rows=candidate_copy.get("tasks")
        base_candidate_rows=base_copy.get("tasks")
        if not isinstance(candidate_rows,list) or not isinstance(base_candidate_rows,list): return False
        if len(candidate_rows)!=len(base_candidate_rows): return False
        if ([row.get("id") if isinstance(row,dict) else None for row in candidate_rows]
                != [row.get("id") if isinstance(row,dict) else None for row in base_candidate_rows]):
            return False
        for row in candidate_rows:
            if not isinstance(row,dict): return False
            task_id=row.get("id")
            if task_id=="h-035":
                base_h035=next((value for value in base_candidate_rows
                                if isinstance(value,dict)
                                and value.get("id")=="h-035"),None)
                criterion=row.get("exit_criterion")
                if (not isinstance(base_h035,dict) or not isinstance(criterion,str)
                        or criterion!=base_h035.get("exit_criterion")
                        or row.get("r15_owner_product_lifecycle") is None):
                    return False
                row["r15_owner_product_lifecycle"]=base_h035.get(
                    "r15_owner_product_lifecycle")
                if row.pop("r29_three_state_owner_production_registry",None) is None:
                    return False
                if row.pop("r33_request_bound_registry_consumers",None) is None:
                    return False
        return r15_json_equal(candidate_copy,base_copy)

    check(exact_spec_transform(current_spec),
          "F_R15_COMPLETE_BASE_OBJECT_TO_CANDIDATE_SPEC_TRANSFORM_EXACT")
    spec_mutants=[]
    if isinstance(current_spec,dict):
        mutant=json.loads(json.dumps(current_spec)); mutant["spec_version"]="2.0.1"; spec_mutants.append(mutant)
        mutant=json.loads(json.dumps(current_spec))
        neighboring=next((row for row in mutant["tasks"] if row.get("id")=="h-034"),None)
        if isinstance(neighboring,dict): neighboring["title"]="hostile neighboring change"
        spec_mutants.append(mutant)
        mutant=json.loads(json.dumps(current_spec))
        h035_mutant=next(row for row in mutant["tasks"] if row.get("id")=="h-035")
        h035_mutant["summary"] += " hostile"; spec_mutants.append(mutant)
        mutant=json.loads(json.dumps(current_spec)); mutant["tasks"].append({"id":"h-039"}); spec_mutants.append(mutant)
        mutant=json.loads(json.dumps(current_spec)); mutant["tasks"][17],mutant["tasks"][18]=mutant["tasks"][18],mutant["tasks"][17]; spec_mutants.append(mutant)
        mutant=json.loads(json.dumps(current_spec)); mutant["tasks"][0]["extra"]=True; spec_mutants.append(mutant)
        for replacement in (
                h035_mutant["exit_criterion"]+" hostile",
                next(row["exit_criterion"] for row in base_spec["tasks"]
                     if isinstance(row,dict) and row.get("id")=="h-035"),
                h035_mutant["exit_criterion"].replace(
                    "H035_OWNER_PROVIDER_EXEC_V7","H035_OWNER_PROVIDER_EXEC_V6",1)):
            mutant=json.loads(json.dumps(current_spec))
            next(row for row in mutant["tasks"] if row.get("id")=="h-035")[
                "exit_criterion"]=replacement
            spec_mutants.append(mutant)
    check(len(spec_mutants)==9 and all(not exact_spec_transform(mutant) for mutant in spec_mutants),
          "J_R17_ROOT_NEIGHBOR_H035_CRITERION_EXTRA_REORDER_LEGACY_SPEC_MUTANTS_REJECT")

    h035_current=next((row for row in current_spec.get("tasks",[])
                       if isinstance(row,dict) and row.get("id")=="h-035"),{}) \
        if isinstance(current_spec,dict) else {}
    r17_criterion=h035_current.get("exit_criterion","") \
        if isinstance(h035_current,dict) else ""
    r17_terms=(
        "H035_OWNER_PROVIDER_EXEC_V7",
        "V7 supersedes H035_OWNER_PROVIDER_EXEC_V6 direct-controller ancestry",
        "fresh gate-private standalone repository",
        "local-only exact-SHA fetch",
        "standalone checkout with a current-UID mode-0700-or-0755 physical .git directory, no commondir file",
        "globally inode-disjoint",
        "Within each gate invocation one exact full baseline is re-compared around every route it executes",
        "the no-argument gate compares ordinary, owner and restart including both restart runs",
        "owner-acceptance compares around its observe route",
        "finite child environment containing no caller Git/Python injection, credential-bearing variables, remote, or network-selecting configuration",
        "before observe or artifact creation every retained ancestor must be physically dev/inode-disjoint from all authenticated checkout/Git roots",
        "runtime_snapshot.py supervise-v1",
        "Direct legacy launch-to-provider ancestry",
        "does not weaken or bypass Seatbelt",
        "independent of lexical alias spelling",
    )
    check(isinstance(r17_criterion,str) and all(term in r17_criterion
          for term in r17_terms),"F_R17_EXACT_STANDALONE_FIXTURE_AND_V7_CRITERION")

    fixture=contract.get("historical_fixture_isolation",{})
    fixture_keys={
        "schema_version","acceptance_mode","topology_supersession",
        "inherited_lifetime","candidate_binding","replica_construction",
        "physical_authority","child_authority","observed_topology",
        "owner_artifact","forbidden_authority_delta","failure"}
    def r17_fixture_exact(value: object) -> bool:
        if not isinstance(value,dict) or set(value)!=fixture_keys:return False
        replica=value.get("replica_construction",{})
        candidate_binding=value.get("candidate_binding",{})
        physical=value.get("physical_authority",{})
        child=value.get("child_authority",{})
        topology=value.get("observed_topology",{})
        artifact=value.get("owner_artifact",{})
        return (value.get("schema_version") == 1
            and value.get("acceptance_mode") == "H035_OWNER_PROVIDER_EXEC_V7"
            and value.get("topology_supersession") ==
                "V7_SUPERSEDES_H035_OWNER_PROVIDER_EXEC_V6_DIRECT_CONTROLLER_ANCESTRY"
            and value.get("inherited_lifetime") ==
                "UNCHANGED_V6_READY_RELEASE_WINDOW_SNAPSHOT_OVERRUN_AND_CLEANUP_CONSTANTS"
            and isinstance(replica,dict)
            and replica.get("repository") ==
                "FRESH_GATE_PRIVATE_STANDALONE_GIT_INIT_EMPTY_PRIVATE_TEMPLATE"
            and replica.get("transfer") ==
                "LOCAL_ONLY_EXACT_SHA_FETCH_WITHOUT_REMOTE_THEN_DETACHED_CHECKOUT"
            and isinstance(candidate_binding,dict)
            and candidate_binding.get("source_continuity") ==
                "PER_GATE_INVOCATION_ONE_EXACT_FULL_BASELINE_RECOMPARED_AROUND_EVERY_EXECUTED_ROUTE_NOARG_ORDINARY_OWNER_RESTART_BOTH_RUNS_OWNER_ACCEPTANCE_OBSERVE_WITH_ROOT_DOT_GIT_CONFIG_DESCRIPTORS_RETAINING_EXACT_IDENTITIES_ONLY_WITHIN_EACH_INDIVIDUAL_ROUTE"
            and isinstance(physical,dict)
            and physical.get("source_roots") == [
                "STANDALONE_CHECKOUT","PHYSICAL_DOT_GIT_DIR","LOCAL_CONFIG"]
            and physical.get("source_repository") ==
                "STANDALONE_CURRENT_UID_MODE_0700_OR_0755_PHYSICAL_DOT_GIT_DIRECTORY_NO_COMMONDIR_GITFILE_LINKED_WORKTREE_OR_ADMIN_ALIAS"
            and isinstance(child,dict)
            and child.get("environment") ==
                "FINITE_NO_CALLER_GIT_OR_PYTHON_INJECTION_CREDENTIAL_BEARING_VARIABLE_REMOTE_OR_NETWORK_SELECTING_CONFIGURATION"
            and isinstance(topology,dict)
            and topology.get("ordered_ancestry") == [
                "LOOP","BRYTARE","UTFORARE","LAUNCH","H036_SUPERVISOR","PROVIDER"]
            and topology.get("process_groups") ==
                "SUPERVISOR_AND_PROVIDER_EACH_PGID_EQUALS_PID"
            and isinstance(artifact,dict)
            and artifact.get("location") ==
                "ABSENT_LEAF_WITH_RETAINED_ANCESTOR_DEV_INO_DISJOINT_FROM_AUTHENTICATED_CHECKOUT_GIT_DIR_AND_COMMON_DIR_BEFORE_OBSERVE_OR_CREATE"
            and artifact.get("creation") ==
                "RETAINED_NOFOLLOW_PARENT_O_CREAT_O_EXCL_O_NOFOLLOW_O_CLOEXEC_MODE_0600_FSYNC"
            and artifact.get("postcondition") ==
                "SOURCE_AND_COMPLETE_RETAINED_ARTIFACT_ANCESTRY_REAUTHENTICATED"
            and value.get("failure") ==
                "RIG_OR_ODEMBART_OWNER_STOP_WITH_CLEANUP_NO_ROOT_FALLBACK_AND_NO_PUBLICATION_CREDIT")
    check(r17_fixture_exact(fixture),
          "F_R17_EXACT_FIXTURE_ISOLATION_V7_AND_OWNER_ARTIFACT_CONTRACT")
    fixture_mutants=[]
    for key in fixture_keys:
        mutant=json.loads(json.dumps(fixture));mutant.pop(key,None);fixture_mutants.append(mutant)
    for path,value in (("acceptance_mode","H035_OWNER_PROVIDER_EXEC_V6"),
                       ("topology_supersession","DIRECT_CHAIN_ALLOWED"),
                       ("failure","PASS_ON_UNCERTAINTY")):
        mutant=json.loads(json.dumps(fixture));mutant[path]=value;fixture_mutants.append(mutant)
    mutant=json.loads(json.dumps(fixture));mutant["candidate_binding"]["source_continuity"]=(
        "ONE_BASELINE_ACROSS_SEPARATE_INVOCATIONS");fixture_mutants.append(mutant)
    mutant=json.loads(json.dumps(fixture));mutant["observed_topology"]["process_groups"]=(
        "SUPERVISOR_ONLY");fixture_mutants.append(mutant)
    mutant=json.loads(json.dumps(fixture));mutant["physical_authority"]["source_repository"]=(
        "STANDALONE_WORLD_WRITABLE_DOT_GIT_ALLOWED");fixture_mutants.append(mutant)
    mutant=json.loads(json.dumps(fixture));mutant["child_authority"]["environment"]=(
        "FINITE_NO_GIT_OVERRIDE_PYTHON_INJECTION_SSH_CREDENTIAL_OR_NETWORK_AUTHORITY")
    fixture_mutants.append(mutant)
    mutant=json.loads(json.dumps(fixture));mutant["owner_artifact"]["location"]=(
        "ABSENT_LEAF_OUTSIDE_AUTHENTICATED_CHECKOUT_GIT_DIR_AND_COMMON_DIR")
    fixture_mutants.append(mutant)
    check(len(fixture_mutants)==20 and all(not r17_fixture_exact(value)
          for value in fixture_mutants),
          "J_R17_FIXTURE_FIELD_CONTINUITY_PGID_SOURCE_MODE_ENVIRONMENT_PHYSICAL_ARTIFACT_V6_DIRECT_FAIL_OPEN_MUTANTS_REJECT")

    publication = contract.get("owner_publication_attestation", {})
    review = contract.get("independent_review_artifact", {})
    claim = contract.get("canonical_owner_claim", {})
    product = contract.get("product_acceptance", {})
    check(isinstance(publication, dict)
          and tuple(publication.get("exact_fields", [])) == R15_OWNER_PUBLICATION_FIELDS,
          "J_R15_OWNER_PUBLICATION_V1_EXACT_FIELD_ORDER")
    check(isinstance(review, dict)
          and tuple(review.get("exact_fields", [])) == R15_REVIEW_FIELDS,
          "J_R15_INDEPENDENT_REVIEW_EXACT_FIELD_ORDER")
    stat_identity=review.get("persisted_stat_identity", {}) if isinstance(review,dict) else {}
    check(isinstance(stat_identity,dict)
          and stat_identity.get("record_type") == "owner_review_stat_v1"
          and stat_identity.get("exact_fields") == [
              "record_type","review_path","st_dev","st_ino","st_mode","st_uid",
              "st_nlink","st_size","st_mtime_ns","st_ctime_ns"],
          "J_R15_REVIEW_STAT_IDENTITY_EXACT_DOMAIN_OBJECT")
    check(isinstance(claim, dict)
          and tuple(claim.get("event_fields", [])) == R15_CLAIM_FIELDS
          and claim.get("builder_identity_fields") == [],
          "J_R15_CANONICAL_CLAIM_EXACT_FIELDS_AND_NO_BUILDER")
