        graph_mutants.append(mutant)
    sentinel_mutants=[]
    ordered_pair=[expected_sentinel[0],{**expected_sentinel[0],"task":"h-035"}]
    for value in ([],expected_sentinel*2,list(reversed(ordered_pair)),
                  [{**expected_sentinel[0],"task":"h-035"}],
