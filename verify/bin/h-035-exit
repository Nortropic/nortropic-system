def _retain_context(state):
 attest,ma=manifest_docs(state);bundle=state.parent;parent=bundle.parent;fds=[]
 flags=os.O_RDONLY|getattr(os,"O_DIRECTORY",0)|getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0)
 def directory(parentfd,name,want):
  before=os.stat(name,dir_fd=parentfd,follow_symlinks=False);fd=os.open(name,flags,dir_fd=parentfd);opened=os.fstat(fd)
  if not stat.S_ISDIR(opened.st_mode) or devino(before)!=devino(opened) or devino(opened)!=want:os.close(fd);raise Stop("retained directory open race")
  fds.append(fd);return fd
 def manifest(rootfd,want):
  before=os.stat(SM,dir_fd=rootfd,follow_symlinks=False);fd=os.open(SM,os.O_RDONLY|getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0)|getattr(os,"O_NONBLOCK",0),dir_fd=rootfd);opened=os.fstat(fd)
  if (not stat.S_ISREG(opened.st_mode) or opened.st_uid!=os.getuid() or opened.st_nlink!=1 or stat.S_IMODE(opened.st_mode)!=0o600 or devino(before)!=devino(opened) or devino(opened)!=want):os.close(fd);raise Stop("retained manifest open race")
  fds.append(fd);return fd,_full(opened),fdbytes(fd,262144)
 try:
  parentfd=root_open(parent);fds.append(parentfd);bundlefd=directory(parentfd,bundle.name,ma["bundle_root_dev_ino"]);statefd=directory(bundlefd,"state",ma["state_root_dev_ino"]);attestfd=directory(bundlefd,"attest",ma["attest_root_dev_ino"])
  smfd,smi,smraw=manifest(statefd,ma["state_manifest_dev_ino"]);amfd,ami,amraw=manifest(attestfd,ma["attest_manifest_dev_ino"])
  if smraw!=amraw or smraw!=C(ma)+b"\n":raise Stop("retained manifest bytes")
  context={"parent":parent,"bundle":bundle,"state":state,"attest":attest,"parentfd":parentfd,"bundlefd":bundlefd,"statefd":statefd,"attestfd":attestfd,"state_manifestfd":smfd,"attest_manifestfd":amfd,"state_manifest_identity":smi,"attest_manifest_identity":ami,"manifest_raw":smraw,"manifest":ma,"fds":fds}
  _validate_context(context);return context
 except Exception:
  for fd in reversed(fds):
   try:os.close(fd)
   except OSError:pass
  raise
def _close_context(context):
 for fd in reversed(context["fds"]):
  try:os.close(fd)
  except OSError:pass
def lockfile(path):
 state=(path.parent if path.name==".r15-owner.lock" else path.parent.parent/"state");context=_context_for(state);owned=context is None
 if owned:context=_retain_context(state)
 rootfd=context["statefd"] if path.name==".r15-owner.lock" else context["attestfd"];key="state_lock_dev_ino" if path.name==".r15-owner.lock" else "attest_lock_dev_ino"
 try:fd=leaf_open(rootfd,path.name)
 except Exception:
  if owned:_close_context(context)
  raise
 if devino(os.fstat(fd))!=context["manifest"][key]:os.close(fd);(_close_context(context) if owned else None);raise Stop("manifest lock identity")
 return fd,context,context["manifest"][key],owned
@contextmanager
def locked(path):
 fd,context,want,owned=lockfile(path);held=False;body_error=None
 if owned:_R15_CONTEXTS.append(context)
 try:
  fcntl.flock(fd,fcntl.LOCK_EX);held=True;_validate_context(context);rootfd=context["statefd"] if path.name==".r15-owner.lock" else context["attestfd"];q=os.stat(path.name,dir_fd=rootfd,follow_symlinks=False)
  if devino(os.fstat(fd))!=want or devino(q)!=want:raise Stop("lock replacement after flock")
  try:yield context
  except Exception as error:body_error=error
  try:
   _validate_context(context);q=os.stat(path.name,dir_fd=rootfd,follow_symlinks=False)
   if devino(os.fstat(fd))!=want or devino(q)!=want:raise Stop("lock replacement during effect")
  except Exception as integrity:raise Indeterminate("INDETERMINATE_PRESERVED retained context/lock: "+str(integrity)) from (body_error or integrity)
  if body_error is not None:raise body_error.with_traceback(body_error.__traceback__)
 finally:
  if held:fcntl.flock(fd,fcntl.LOCK_UN)
  os.close(fd)
  if owned:
   if not _R15_CONTEXTS or _R15_CONTEXTS[-1] is not context:raise Stop("retained context stack")
   _R15_CONTEXTS.pop();_close_context(context)
def task_classes(attest):
 state=attest.parent/"state";_repo,bound,ma,doc=manifest_info(state,False)
 if bound!=attest:raise Stop("attest manifest root substitution")
 return ({x["id"]:x.get("authority_class","ordinary") for x in doc["tasks"] if isinstance(x,dict) and isinstance(x.get("id"),str)},ma["repository_identity"])
def store_value(raw,classes,trusted_origin):
 v=loadb(raw)
 if raw!=C(v)+b"\n":raise Stop("attestation store canonical bytes")
 if not isinstance(v,dict) or set(v)!={"attestations","omtest_ko","invalidated_shas"} or not isinstance(v["attestations"],dict) or not isinstance(v["omtest_ko"],list) or len(v["omtest_ko"])!=len(set(v["omtest_ko"])) or not isinstance(v["invalidated_shas"],list) or v["invalidated_shas"]!=sorted(set(v["invalidated_shas"])) or not all(isinstance(x,str) and HEX40.fullmatch(x) for x in v["invalidated_shas"]):raise Stop("attestation store schema")
 stale_tasks=[]
 for task,record in v["attestations"].items():
  if not isinstance(task,str) or not isinstance(record,dict) or record.get("task")!=task or type(record.get("stale")) is not bool:raise Stop("attestation record schema")
  keys=set(record)
  if record.get("record_type")=="owner_publication_v1":
   if keys!=OWNER_FIELDS:raise Stop("owner record schema")
   if classes is not None and (task not in classes or classes[task]!="owner_authority"):raise Stop("rich record task class")
   if (type(record.get("schema_version")) is not int or record["schema_version"]!=1
    or record.get("authority_class")!="owner_authority" or record.get("review_result")!="PASS"
    or record.get("spec_path")!="specs/tasks.spec.json"
    or record.get("registry_path")!="specs/owner-production-paths.v1.json"
    or not isinstance(record.get("gate_path"),str) or not record["gate_path"].startswith("verify/bin/")
    or not isinstance(record.get("repository_identity"),str) or not record["repository_identity"]
    or any(not isinstance(record.get(x),str) or not HEX40.fullmatch(record[x]) for x in ("base_sha","candidate_sha","candidate_tree","publication_sha"))
    or any(not isinstance(record.get(x),str) or not HEX64.fullmatch(record[x]) for x in ("spec_sha256","registry_sha256","gate_sha256","dependency_attestations_sha256","transition_identity","candidate_identity","review_identity"))
    or not isinstance(record.get("changed_files"),list) or record["changed_files"]!=sorted(set(record["changed_files"]))
    or not all(isinstance(x,str) and x and not x.startswith("/") and "\\" not in x and "\x00" not in x and all(part not in ("",".","..") for part in x.split("/")) for x in record["changed_files"])
   or record.get("invalidates_on")!=[record.get("candidate_sha"),record.get("publication_sha")]):raise Stop("owner record value schema")
   if task=="h-036":
    expected_h036=h036_record(trusted_origin);expected_h036["stale"]=any(x in v["invalidated_shas"] for x in expected_h036["invalidates_on"])
    if record!=expected_h036:raise Stop("historical H036 record identity")
   else:
    origin=trusted_origin
    if record["repository_identity"]!=origin:raise Stop("owner record repository identity")
    specraw=blob(ROOT,record["base_sha"],record["spec_path"]);registryraw=blob(ROOT,record["base_sha"],record["registry_path"]);doc=loadb(specraw);registry=loadb(registryraw);taskrows=[x for x in doc.get("tasks",[]) if isinstance(x,dict) and x.get("id")==task]
    if len(taskrows)!=1 or taskrows[0].get("authority_class")!="owner_authority" or taskrows[0].get("exit_test")!=record["gate_path"] or F(specraw)!=record["spec_sha256"] or F(registryraw)!=record["registry_sha256"] or F(blob(ROOT,record["base_sha"],record["gate_path"]))!=record["gate_sha256"]:raise Stop("owner record frozen authority")
    ti=D(transition(task,record["base_sha"],record["spec_sha256"],record["registry_sha256"],record["gate_path"],record["gate_sha256"],origin,record["dependency_attestations_sha256"]))
    ci=candidate_id(task,record["base_sha"],record["candidate_sha"],record["candidate_tree"],record["changed_files"],ti,record["review_identity"])
    actual_changed,actual_tree=candidate_scope(ROOT,record["base_sha"],record["candidate_sha"],taskrows[0],registry)
    if record["transition_identity"]!=ti or record["candidate_identity"]!=ci or actual_changed!=record["changed_files"] or actual_tree!=record["candidate_tree"] or parents(ROOT,record["candidate_sha"])!=[record["base_sha"]] or tree(ROOT,record["candidate_sha"])!=record["candidate_tree"] or parents(ROOT,record["publication_sha"])!=[record["base_sha"],record["candidate_sha"]] or tree(ROOT,record["publication_sha"])!=record["candidate_tree"]:raise Stop("owner record graph/scope/identity")
  elif keys not in ({"task","candidate_sha","invalidates_on","stale"},{"task","candidate_sha","invalidates_on","stale","grind_id","grind_sha256"}):raise Stop("ordinary record schema")
