def _r15_direct_selector_path(path):
    path=Path(path);proof=None
    if not path.is_absolute():
        if any(part in (".","..","") for part in path.parts):raise Stop("selector relative path")
        return path,None
    if len(path.parts)>1 and path.parts[1] in ("var","tmp"):
        alias="/"+path.parts[1];target="private/"+path.parts[1]
        root_before=os.stat("/",follow_symlinks=False);before=os.lstat(alias)
        if stat.S_ISLNK(before.st_mode):
            if before.st_uid!=0 or before.st_nlink!=1 or os.readlink(alias)!=target:raise Stop("selector system alias")
            after=os.lstat(alias);root_after=os.stat("/",follow_symlinks=False)
            fields=lambda value:(value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_nlink,value.st_size,value.st_mtime_ns,value.st_ctime_ns)
            root_fields=lambda value:(value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_nlink)
            if fields(before)!=fields(after) or root_fields(root_before)!=root_fields(root_after):raise Stop("selector system alias race")
            proof=(alias,target,fields(before),root_fields(root_before))
            path=Path("/private")/path.parts[1]/Path(*path.parts[2:])
    return path,proof
def _r15_direct_alias_recheck(proof):
    if proof is None:return
    alias,target,want,want_root=proof;value=os.lstat(alias);root=os.stat("/",follow_symlinks=False)
    fields=lambda item:(item.st_dev,item.st_ino,item.st_mode,item.st_uid,item.st_nlink,item.st_size,item.st_mtime_ns,item.st_ctime_ns)
    root_fields=lambda item:(item.st_dev,item.st_ino,item.st_mode,item.st_uid,item.st_nlink)
    if fields(value)!=want or root_fields(root)!=want_root or os.readlink(alias)!=target:raise Stop("selector system alias changed")
def _r15_direct_reserved(path):
    try:path,proof=_r15_direct_selector_path(path)
    except (Stop,OSError,ValueError):return True
    try:
        try:safe_raw(path,(0o600,0o644),8*1024*1024);return True
        except FileNotFoundError:return False
        except (Stop,OSError,ValueError):return True
    finally:_r15_direct_alias_recheck(proof)
def _r15_direct_store(path):
