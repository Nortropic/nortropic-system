def recovery_rows(raw,ma=None,manifest_sha=None):
 if raw and not raw.endswith(b"\n"):raise Stop("INDETERMINATE incomplete recovery tail")
 if len(raw.splitlines())>8192:raise Stop("attest recovery count")
 rows=[];previous=F(b"");pending=None;last_new=(ma["bootstrap_attestation_store_sha256"] if ma is not None else None)
 for number,line in enumerate(raw.splitlines(keepends=True),1):
  value=loadb(line[:-1])
  if C(value)+b"\n"!=line:raise Stop("attest recovery canonical line")
  if (not isinstance(value,dict) or set(value)!={"record_type","schema_version","sequence","phase","command","task","manifest_sha256","operation_identity","request_sha256","old_store_sha256","new_store_sha256","previous_record_sha256"}
   or value["record_type"]!="h035_r15_attest_recovery_v1" or type(value["schema_version"]) is not int or value["schema_version"]!=1
   or type(value["sequence"]) is not int or value["sequence"]!=number or value["previous_record_sha256"]!=previous
   or value["command"] not in ("write","invalidate","finalize-owner-publication","import-h036-owner-publication")
   or value["task"] is not None and (not isinstance(value["task"],str) or not value["task"])
   or not all(isinstance(value.get(x),str) and HEX64.fullmatch(value[x]) for x in ("manifest_sha256","operation_identity","request_sha256","old_store_sha256","new_store_sha256","previous_record_sha256"))):raise Stop("attest recovery schema")
  if ((value["command"] in ("write","finalize-owner-publication") and not isinstance(value["task"],str))
   or (value["command"]=="invalidate" and value["task"] is not None)
   or (value["command"]=="import-h036-owner-publication" and value["task"]!="h-036")):raise Stop("attest recovery command task domain")
  if ma is not None:
   if manifest_sha!=value["manifest_sha256"]:raise Stop("attest recovery manifest identity")
   expected=attest_operation(value["command"],value["task"],value["request_sha256"],ma,manifest_sha,value["sequence"] if value["phase"]=="PENDING" else value["sequence"]-1,value["old_store_sha256"],value["new_store_sha256"])
   if D(expected)!=value["operation_identity"]:raise Stop("attest recovery operation identity")
  if value["phase"]=="PENDING":
   if number%2!=1 or pending is not None:raise Stop("attest recovery pairing")
   if value["old_store_sha256"]==value["new_store_sha256"] or last_new is not None and value["old_store_sha256"]!=last_new:raise Stop("attest recovery store continuity")
   pending=value
  elif value["phase"]=="COMMITTED":
   if number%2 or pending is None or any(value[x]!=pending[x] for x in ("command","task","manifest_sha256","operation_identity","request_sha256","old_store_sha256","new_store_sha256")):raise Stop("attest recovery pairing")
   last_new=value["new_store_sha256"];pending=None
  else:raise Stop("attest recovery phase")
  previous=F(line);rows.append(value)
 return rows,pending,previous
def recovery_active(rows,pending,active_raw,shadow_raw,ma):
 digest=F(active_raw);shadow_digest=F(shadow_raw)
 if pending is None:
  expected=(rows[-1]["new_store_sha256"] if rows else ma["bootstrap_attestation_store_sha256"])
  if digest!=expected or shadow_raw!=b"":raise Stop("attest recovery committed slot orientation")
 elif not ((digest==pending["old_store_sha256"] and shadow_digest==pending["new_store_sha256"])
           or (digest==pending["new_store_sha256"] and shadow_digest in (pending["old_store_sha256"],F(b"")))):raise Stop("attest pending slot orientation")
def mutation_preflight(raw,ma,manifest_sha,active_raw,shadow_raw):
 incomplete=bool(raw and not raw.endswith(b"\n"));complete=(raw[:raw.rfind(b"\n")+1] if incomplete else raw);rows,pending,previous=recovery_rows(complete,ma,manifest_sha)
 if pending is None and (incomplete or shadow_raw):
  expected=(rows[-1]["new_store_sha256"] if rows else ma["bootstrap_attestation_store_sha256"])
  if F(active_raw)!=expected:raise Stop("attest pre-PENDING "+("incomplete-tail" if incomplete else "recovery")+" active mismatch")
 else:recovery_active(rows,pending,active_raw,shadow_raw,ma)
 return rows,pending,previous,complete
