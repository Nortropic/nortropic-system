  safe_components(spec,False);parentfd=root_open(bundle.parent);pi=os.fstat(parentfd)
  if pi.st_uid!=os.getuid() or stat.S_IMODE(pi.st_mode)&0o022:raise Stop("unsafe bootstrap parent")
  if any(name.startswith(".r15-bootstrap-") for name in os.listdir(parentfd)):raise Indeterminate("INDETERMINATE_PRESERVED bootstrap temp residue")
