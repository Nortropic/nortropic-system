    for label,reason in cases.items():
        mutant=r15_gate_mutant_source(candidate_raw,label)
        repinned=r15_gate_repin_manifest(base_raw,mutant,manifest)
        accepted,why=r15_gate_inheritance_bytes(base_raw,mutant,repinned)
