#!/usr/bin/env python3.12
"""Frozen H-035 owner-author workflow gate.

Exit 0 = all frozen production effects PASS.
Exit 1 = judge is sound but the product is RED.
Exit 2 = rig/environment error; never a product verdict.

The gate first proves a disposable legitimate reference can satisfy the same
black-box contract. Production real-route negatives receive no credit until a
provider process-image positive ordinary control has actually executed.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import unicodedata
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterable


# Fixture Python processes must not add interpreter cache files to the Git
# candidates whose exact changed-file set is under test.
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"


ROOT = Path(__file__).resolve().parents[2]
SPEC = ROOT / "specs/tasks.spec.json"
REGISTRY = ROOT / "specs/owner-production-paths.v1.json"
CONTRACT = ROOT / "docs/loop/owner-author-workflow-v1.md"
AUTHORITY_CLI = Path("controller/authority/cli")
LOOP_CLI = Path("controller/loop/cli")
AUTOPILOT = Path("scripts/nortropic-codex-autopilot.py")

EXPECTED_OWNER_PATHS = (
    "verify/h034/kernel.py",
    "verify/h034/plan.json",
    "verify/h034/identity.json",
)
EXPECTED_H035_ALLOWED = (
    "controller/authority/**",
    "controller/policy/cli",
    "controller/taskval/cli",
    "controller/envelope/cli",
    "controller/state/cli",
    "controller/attest/cli",
    "controller/loop/cli",
    "scripts/nortropic-codex-autopilot.py",
    "docs/05-beslutslogg.md",
    "docs/loop/drift.md",
)
EXPECTED_GLOBAL_DENIED = (
