    call_identity=hashlib.sha256(canonical_json_bytes({
        "relative":relative,"args":args,"fault":fault,"route_audit":route_audit,
        "target":str(target) if target is not None else None,
        "substitute":str(substitute) if substitute is not None else None,
        "nonce":nonce})).hexdigest()
    status_read,status_write=os.pipe()
    key_read,key_write=os.pipe();status_key=secrets.token_bytes(32);key_offset=0
    try:
