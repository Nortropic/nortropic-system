  clean_head(repo,ma["current_main"])
  if current.get("status")=="OWNER_CANDIDATE_REVIEW_REQUIRED":
   if (current.get("workspace_root")!=str(workspace) or current.get("candidate_sha")!=current.get("base_sha")
    or workspace_validate(workspace,current.get("workspace_identity"))!=current.get("workspace_identity")):raise Stop("owner author retry substitution")
   append(state,current)
   return answer(True,state=current["status"])
  if current.get("status")!="OWNER_ACTION_REQUIRED" or current.get("base_sha")!=ma["current_main"]:raise Stop("owner author state")
  context=workspace_open(workspace,True)
  event={k:current[k] for k in CLAIM_FIELDS};event["status"]="OWNER_CANDIDATE_REVIEW_REQUIRED";event["candidate_sha"]=current["base_sha"];event["workspace_root"]=str(workspace);event["workspace_identity"]=context["identity"]
  try:append(state,event)
  except Indeterminate:
   try:workspace_close(context)
   except Exception as integrity:raise Indeterminate("INDETERMINATE_PRESERVED workspace after state truth uncertainty: "+str(integrity)) from integrity
   raise
  except Exception:
   try:workspace_close(context,True)
   except Exception as cleanup:raise Indeterminate("INDETERMINATE_PRESERVED workspace pretruth cleanup: "+str(cleanup)) from cleanup
   raise
  try:workspace_close(context)
  except Exception as integrity:raise Indeterminate("INDETERMINATE_PRESERVED workspace after owner-author: "+str(integrity)) from integrity
  return answer(True,state=event["status"])
def path_rule(value):
 if not isinstance(value,str) or not value or value.startswith("/") or "\\" in value or any(x in ("",".","..") for x in value.split("/")) or any(x in value for x in "*?[") and not (value.endswith("/**") and all(x not in value[:-3] for x in "*?[")):raise Stop("owner path rule")
 return value
def permits(path,rules):return any(path==rule or rule.endswith("/**") and (path==rule[:-3] or path.startswith(rule[:-3]+"/")) for rule in rules)
def candidate_scope(repo,base,cand,task,registry):
 if not HEX40.fullmatch(cand) or parents(repo,cand)!=[base] or tree(repo,cand)==tree(repo,base):raise Stop("candidate direct nonempty child")
 st=git(repo,"diff","--name-status","--no-renames","--no-ext-diff","--no-textconv",base,cand)
 rows=st.stdout.splitlines();changed=[]
 for row in rows:
  f=row.split("\t")
  if len(f)!=2 or f[0] not in ("A","M","D"):raise Stop("candidate rename/type")
  changed.append(f[1])
 surface=[path_rule(x) for x in task.get("owner_author_allowed_write",[])];denied=[path_rule(x) for x in registry.get("owner_author_global_denied_paths",[])]
 mf=task.get("max_changed_files");ml=task.get("max_added_lines")
 if type(mf) is not int or type(ml) is not int or mf<0 or ml<0 or not changed or changed!=sorted(changed) or len(changed)>mf or any(not permits(x,surface) or permits(x,denied) for x in changed):raise Stop("candidate owner surface")
 ns=git(repo,"diff","--numstat","--no-renames",base,cand)
 total=0
 for row in ns.stdout.splitlines():
  a,d,p=row.split("\t")
  if not a.isdigit() or not d.isdigit():raise Stop("candidate binary")
  total+=int(a)
 if total>ml:raise Stop("candidate line budget")
 modes=ls_modes(repo,cand,changed)
 if any(status!="D" and modes.get(path) not in (("100644","blob"),("100755","blob")) or status=="D" and path in modes for status,path in (row.split("\t") for row in rows)):raise Stop("candidate path mode")
 for path in ("specs/tasks.spec.json","specs/owner-production-paths.v1.json",task["exit_test"]):
  if blob(repo,base,path)!=blob(repo,cand,path):raise Stop("candidate authority drift")
 return changed,tree(repo,cand)
