            finally:r15_close_retained_known_hosts(handle)
            controls.append((label,outcome and not os.path.lexists(copy_path)
                             and not os.path.lexists(copy_dir)))
        failures=[name for name,result in controls if not result]
        return len(controls)==24 and not failures,repr(failures)

    hostile_keys=("GIT_SSH","GIT_SSH_COMMAND","SSH_ASKPASS","GIT_ASKPASS",
                  "GIT_TERMINAL_PROMPT","HOME","GIT_CONFIG_GLOBAL")
    local_origin=tmp/"origin.git"
    made=run(["/usr/bin/git","init","--bare","-q",str(local_origin)],cwd=tmp)
    if made.returncode: raise Rig(made.stderr)
    local_env,local_args=r15_remote_environment(str(local_origin.resolve()))
    check("SSH_AUTH_SOCK" not in local_env and local_args == [],
          "J_R15_LOCAL_BARE_REMOTE_NEEDS_NO_CREDENTIAL_AUTHORITY")
    prior={key:os.environ.get(key) for key in hostile_keys}
    os.environ.update({key:"/hostile/caller/value" for key in hostile_keys})
    handle=None
    try:
        ssh_env,ssh_args,handle,agent_identity=r15_remote_setup(
            "git@github.com:Nortropic/nortropic-system.git")
        copy_argument="-oUserKnownHostsFile="+str(handle["copy_path"])
        exact_ssh=["/usr/bin/ssh","-F","/dev/null","-oBatchMode=yes",
                   "-oStrictHostKeyChecking=yes","-oProxyCommand=none","-oProxyJump=none",
                   "-oCanonicalizeHostname=no","-oIdentitiesOnly=no","-oIdentityFile=none",
                   copy_argument,"-oGlobalKnownHostsFile=/dev/null",
                   "-oPasswordAuthentication=no","-oKbdInteractiveAuthentication=no"]
        observed_ssh=shlex.split(ssh_args[1].removeprefix("core.sshCommand="))
        ssh_ok=(ssh_env.get("SSH_AUTH_SOCK")==R15_INITIAL_SSH_AUTH_SOCK
                and all(key not in ssh_env for key in (
                    "GIT_SSH","GIT_SSH_COMMAND","SSH_ASKPASS","GIT_ASKPASS"))
                and ssh_env.get("HOME")=="/private/var/empty"
                and ssh_env.get("GIT_CONFIG_GLOBAL")=="/dev/null"
                and ssh_env.get("GIT_TERMINAL_PROMPT")=="0"
                and len(ssh_args)==2 and ssh_args[0]=="-c"
                and ssh_args[1].startswith("core.sshCommand=")
                and observed_ssh==exact_ssh
                and isinstance(handle,dict) and isinstance(agent_identity,tuple)
                and observed_ssh.count(copy_argument)==1
                and all("/dev/fd/" not in token for token in observed_ssh))
    finally:
        r15_close_retained_known_hosts(handle)
        for key,value in prior.items():
            if value is None: os.environ.pop(key,None)
            else: os.environ[key]=value
    prior_agent=os.environ.get("SSH_AUTH_SOCK")
    os.environ["SSH_AUTH_SOCK"]="/private/tmp/r15-caller-selected-agent.sock"
    try:
        try: r15_remote_environment("git@github.com:Nortropic/nortropic-system.git")
        except Rig: changed_agent_rejected=True
        else: changed_agent_rejected=False
    finally:
        if prior_agent is None: os.environ.pop("SSH_AUTH_SOCK",None)
        else: os.environ["SSH_AUTH_SOCK"]=prior_agent
    url_rejections=[]
    for hostile in ("https://github.com/Nortropic/nortropic-system.git","../origin.git",
                    "ext::/bin/false","git@github.com:Nortropic/neighbor.git",
                    "ssh://git@github.com/Nortropic/nortropic-system.git"):
        try: r15_remote_environment(hostile)
        except Rig: url_rejections.append(True)
        else: url_rejections.append(False)
    copy_ok,copy_detail=known_hosts_copy_selftests()
    check(ssh_ok and changed_agent_rejected and all(url_rejections) and copy_ok,
          "J_R15_SSH_REMOTE_PRESERVES_ONLY_INITIAL_AGENT_AND_RETAINED_PLAIN_KNOWN_HOSTS",
          copy_detail)


def git_object_bytes(repo: Path, sha: str, path: str) -> bytes | None:
    result = subprocess.run(["git", "-C", str(repo), "show", f"{sha}:{path}"],
                            capture_output=True, shell=False, check=False, timeout=45)
    return result.stdout if result.returncode == 0 else None


def init_repo(path: Path) -> str:
    path.mkdir()
    for args in (("init", "-q"), ("config", "user.name", "H035 Fixture"), ("config", "user.email", "fixture@example.invalid")):
        p = git(path, *args)
        if p.returncode: raise Rig(p.stderr)
    (path / "seed.txt").write_text("seed\n")
    for args in (("add", "seed.txt"), ("commit", "-qm", "seed")):
        p = git(path, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(path, "rev-parse", "HEAD").stdout.strip()


def commit_paths(repo: Path, message: str, *paths: str) -> str:
    # Fixture paths are repository data, never Git pathspec programs. This is
    # material for R11's legitimate filenames beginning with pathspec magic.
    for args in (("--literal-pathspecs", "add", "--", *paths),
                 ("commit", "-qm", message)):
        p = git(repo, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(repo, "rev-parse", "HEAD").stdout.strip()


def authority_repo(tmp: Path, name: str, tasks: list[dict[str, object]],
                   *, gates: dict[str, bytes] | None = None,
                   gate_modes: dict[str, int] | None = None,
                   registry: dict[str, object] | None = None) -> tuple[Path, str]:
    """A disposable Git authority root containing both canonical documents."""
    repo = tmp / name; init_repo(repo)
    (repo / "specs").mkdir()
    write_json(repo / "specs/tasks.spec.json", {
        "spec_version":"2.0.0", "defaults":{"denied_write":[]}, "tasks":tasks})
    if registry is None:
        (repo / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    else:
        write_json(repo / "specs/owner-production-paths.v1.json", registry)
    gate_paths: list[str] = []
    for task in tasks:
        gate_path = task.get("exit_test")
        if not isinstance(gate_path, str) or gate_path in gate_paths:
            continue
        target = repo / gate_path; target.parent.mkdir(parents=True, exist_ok=True)
        if gates is not None and gate_path in gates:
            target.write_bytes(gates[gate_path])
        elif gate_path == "verify/bin/h-035-exit":
            target.write_bytes(Path(__file__).read_bytes())
        else:
            target.write_bytes(b"#!/bin/sh\nexit 1\n")
        target.chmod(gate_modes.get(gate_path, 0o755) if gate_modes else 0o755)
        gate_paths.append(gate_path)
    base = commit_paths(repo, "canonical authority", "specs/tasks.spec.json",
                        "specs/owner-production-paths.v1.json", *gate_paths)
    return repo, base


def owner_task(task_id: str, surface: list[str],
               exit_test: str = "verify/bin/h-035-exit") -> dict[str, object]:
    return {"id":task_id, "authority_class":"owner_authority", "allowed_write":[],
            "owner_author_allowed_write":surface, "docs_impact":[], "depends_on":[],
            "exit_test":exit_test}


def ordinary_task(task_id: str, surface: list[str],
                  exit_test: str = "verify/bin/h-035-exit") -> dict[str, object]:
    return {"id":task_id, "authority_class":"ordinary", "allowed_write":surface,
            "owner_author_allowed_write":[], "docs_impact":[], "depends_on":[],
            "exit_test":exit_test}


def init_state(path: Path) -> None:
    p = run([str(STATE), "init", str(path)])
    if p.returncode: raise Rig(p.stderr or p.stdout)


def set_remote_main(remote: Path, source: Path, sha: str) -> None:
    p = run(["git", "fetch", "-q", str(source), sha], cwd=remote)
    if p.returncode: raise Rig(p.stderr)
    p = run(["git", "update-ref", "refs/heads/main", sha], cwd=remote)
    if p.returncode: raise Rig(p.stderr)


def candidate(repo: Path, base: str, path: str, serial: int) -> str:
    p = git(repo, "checkout", "-q", base)
    if p.returncode: raise Rig(p.stderr)
    target = repo / path; target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(f"h035 fixture candidate {serial}\n")
    for args in (("--literal-pathspecs", "add", "--", path),
                 ("commit", "-qm", f"candidate-{serial}")):
        p = git(repo, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(repo, "rev-parse", "HEAD").stdout.strip()


def candidate_paths(repo: Path, base: str, paths: list[str], serial: int) -> str:
    """Create one fixture candidate whose material diff covers every exact path."""
    p = git(repo, "checkout", "-q", base)
    if p.returncode: raise Rig(p.stderr)
    if not paths or len(paths) != len(set(paths)):
        raise Rig("candidate_paths requires a non-empty unique exact path list")
    for path in paths:
        target = repo / path; target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(f"h035 fixture candidate {serial}: {path}\n")
    for args in (("--literal-pathspecs", "add", "--", *paths),
                 ("commit", "-qm", f"candidate-{serial}")):
        p = git(repo, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(repo, "rev-parse", "HEAD").stdout.strip()


def registry_candidate(tmp: Path, name: str, raw: str) -> tuple[Path, str, str]:
    repo = tmp / f"registry-{name}"; base = init_repo(repo)
    target = repo / "specs/owner-production-paths.v1.json"; target.parent.mkdir()
    target.write_text(raw)
    # Operational authority is always candidate-local. Registry tests carry
    # a canonical task spec too, so none can pass by borrowing installed bytes.
    (repo / "specs/tasks.spec.json").write_bytes(SPEC.read_bytes())
    commit_paths(repo, name, "specs/tasks.spec.json", "specs/owner-production-paths.v1.json")
    return repo, base, git(repo, "rev-parse", "HEAD").stdout.strip()


def task_candidate(tmp: Path, name: str, version: str, task: dict[str, object]) -> tuple[Path, str, str]:
    repo = tmp / f"task-{name}"; base = init_repo(repo)
    (repo / "specs").mkdir()
    write_json(repo / "specs/tasks.spec.json", {"spec_version":version,"defaults":{"denied_write":[]},"tasks":[{"id":"fixture-task","depends_on":[],**task}]})
    (repo / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    p = git(repo, "add", "specs")
    if p.returncode: raise Rig(p.stderr)
    p = git(repo, "commit", "-qm", name)
    if p.returncode: raise Rig(p.stderr)
    return repo, base, git(repo, "rev-parse", "HEAD").stdout.strip()


def path_candidate(tmp: Path, name: str, pattern: str) -> tuple[Path, str, str]:
    repo = tmp / f"path-{name}"; init_repo(repo)
    (repo / "specs").mkdir()
    write_json(repo / "specs/tasks.spec.json", {"spec_version":"2.0.0", "defaults":{"denied_write":[]},
        "tasks":[{"id":"fixture-task", "authority_class":"ordinary", "allowed_write":[pattern],
                  "docs_impact":[], "depends_on":[]}]})
    (repo / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    git(repo, "add", "specs"); git(repo, "commit", "-qm", "canonical authority")
    base = git(repo, "rev-parse", "HEAD").stdout.strip()
    target = repo / "safe/x"; target.parent.mkdir(); target.write_text("effect\n")
    git(repo, "add", "safe/x"); git(repo, "commit", "-qm", "candidate")
    return repo, base, git(repo, "rev-parse", "HEAD").stdout.strip()


def process_snapshot() -> tuple[str, list[dict[str, object]], str]:
    argv = ["ps", "-ww", "-axo", "pid=,ppid=,pgid=,comm=,args="]
    try:
        p = subprocess.run(argv, text=True, capture_output=True, check=False,
                           timeout=V6_PROCESS_SNAPSHOT_TIMEOUT_S)
    except (OSError, PermissionError, subprocess.TimeoutExpired) as e:
        return "ODÖMBART", [], f"{type(e).__name__}: {e}"
    if p.returncode != 0:
        return "ODÖMBART", [], f"ps exit {p.returncode}: {p.stderr.strip()[:200]}"
    rows: list[dict[str, object]] = []
    for line in p.stdout.splitlines():
        fields = line.strip().split(None, 4)
        if len(fields) == 5 and all(fields[i].isdigit() for i in range(3)):
            rows.append({"pid":int(fields[0]), "ppid":int(fields[1]), "pgid":int(fields[2]),
                         "comm":fields[3], "args":fields[4]})
    return "OK", rows, ""


def observe_provider(rows: list[dict[str, object]], *, loop_pid: int, provider: Path,
                     nonce: str, controller_root: Path = ROOT,
                     loop_path: Path = LOOP) -> tuple[dict[str, object] | None, list[dict[str, object]]]:
    by_pid = {int(r["pid"]): r for r in rows}
    # Bind the spelling actually passed to exec. On macOS /var resolves to
    # /private/var; resolving here made V2 reject the real /var/folders argv.
    provider_text = str(provider)
    if (not controller_root.is_absolute() or not loop_path.is_absolute()
            or Path(os.path.normpath(str(controller_root))) != controller_root
            or Path(os.path.normpath(str(loop_path))) != loop_path
            or loop_path != controller_root/"controller/loop/cli"):
        return None, []
    required = [str(loop_path), str(controller_root/"controller/brytare/cli"),
                str(controller_root/"controller/utforare/cli"),
                str(controller_root/"controller/launch/cli")]
    controller_suffixes = tuple("/controller/"+name+"/cli"
                                for name in ("loop","brytare","utforare","launch"))
    loop_row = by_pid.get(loop_pid)
    if loop_row is None:
        return None, []
    controller_image = str(loop_row["comm"])

    def argv(row: dict[str, object]) -> list[str]:
        try:
            return shlex.split(str(row["args"]), posix=True)
        except ValueError:
            return []

    loop_tokens = argv(loop_row)
    if len(loop_tokens) < 2 or loop_tokens[1] != required[0]:
        return None, []
    controller_executable = loop_tokens[0]
    supervisor_helper=str(controller_root/"controller/launch/runtime_snapshot.py")

    def stage(row: dict[str, object]) -> str | None:
        tokens = argv(row)
        # macOS truncates ps(1)'s comm field (the real Homebrew Python image is
        # observed as /opt/homebrew/Ce). Bind every controller stage to the
        # exact image reported for the gate-started loop.
        if (str(row["comm"]) != controller_image or len(tokens) < 2
                or tokens[0] != controller_executable):
            return None
        scripts = [token for token in tokens if token.endswith(controller_suffixes)]
        hits = [expected for expected in required
                if tokens[1]==expected and scripts==[expected]]
        return hits[0] if len(hits) == 1 else None

    def supervisor(row: dict[str, object]) -> bool:
        tokens=argv(row)
        valid_fd=lambda value:(re.fullmatch(r"(?:0|[1-9][0-9]*)",value) is not None
                               and int(value)>=3)
        if (len(tokens)!=10 or tokens[1:4]!=["-I","-S","-B"]
                or tokens[4:7]!=[supervisor_helper,"supervise-v1","--control-fd"]
                or not valid_fd(tokens[7]) or tokens[8]!="--ready-fd"
                or not valid_fd(tokens[9]) or tokens[7]==tokens[9]):
            return False
        executable=Path(tokens[0]);runtime_root=executable.parent
        return (executable==runtime_root/"python3.12"
                and runtime_root.parent==Path("/private/tmp")
                and re.fullmatch(r"\.nortropic-h036-runtime-[A-Za-z0-9_]{6,64}",
                                 runtime_root.name) is not None
                and int(row["pgid"])==int(row["pid"])
                and all(not token.endswith(controller_suffixes) for token in tokens)
                and tokens.count(supervisor_helper)==1)

    for row in rows:
        comm = str(row["comm"]); tokens = argv(row)
        if (comm != "/bin/sh" or tokens != ["/bin/sh",provider_text,nonce]
                or int(row["pgid"])!=int(row["pid"])):
            continue
        chain = [row]; seen = {int(row["pid"])}; parent = int(row["ppid"])
        while parent in by_pid and parent not in seen:
            ancestor = by_pid[parent]; chain.append(ancestor); seen.add(parent)
            if parent == loop_pid: break
            parent = int(ancestor["ppid"])
        if not chain or int(chain[-1]["pid"]) != loop_pid:
            continue
        ordered = list(reversed(chain[1:]))
        if (len(ordered)==len(required)+1
                and [stage(ancestor) for ancestor in ordered[:4]]==required
                and supervisor(ordered[4])):
            return row, chain
    return None, []


def observe_provider_lifetime(proc: subprocess.Popen, *, provider: Path, nonce: str,
                              ready: Path, release: Path, snapshot_fn=process_snapshot,
                              clock=time.monotonic, pause=time.sleep,
                              startup_window_s: float = V6_STARTUP_WINDOW_S,
                              post_ready_window_s: float = V6_POST_READY_WINDOW_S,
                              controller_root: Path = ROOT,
                              loop_path: Path = LOOP,
                              ) -> tuple[str, dict[str, object]]:
    """Observe one provider attempt and unconditionally release it on conclusion.

    A post-ready snapshot may finish after the nominal window.  Production
    process_snapshot has its own hard timeout, and the controller fail-safe is
    ordered after window + maximum overrun + cleanup margin.
    """
    verdict = "FAIL"
    started = clock()
    startup_deadline = started + startup_window_s
    ready_deadline: float | None = None
    evidence: dict[str, object] = {
        "nonce":nonce, "samples":0, "post_ready_samples":0,
        "lifetime_synchronization":"V7 H036-supervisor ancestry; unchanged V6 observer-owned release; readiness is never verdict authority",
        "startup_window_s":startup_window_s,
        "post_ready_window_s":post_ready_window_s,
        "process_snapshot_timeout_s":V6_PROCESS_SNAPSHOT_TIMEOUT_S,
        "provider_failsafe_s":V6_PROVIDER_FAILSAFE_S,
    }
    try:
        while proc.poll() is None:
            before = clock()
            if os.path.lexists(ready) and ready_deadline is None:
                ready_deadline = before + post_ready_window_s
                evidence["ready_observed"] = True
                evidence["ready_observed_at_s"] = before - started
            active_deadline = ready_deadline if ready_deadline is not None else startup_deadline
            if before >= active_deadline:
                evidence["window_exhausted"] = "post_ready" if ready_deadline is not None else "startup"
                break

            status, rows, why = snapshot_fn()
            after = clock()
            evidence["samples"] = int(evidence["samples"]) + 1
            if os.path.lexists(ready):
                if ready_deadline is None:
                    # Readiness during a slow snapshot gets a complete new
                    # post-ready window; elapsed pre-ready time cannot steal it.
                    ready_deadline = after + post_ready_window_s
                    evidence["ready_observed"] = True
                    evidence["ready_observed_at_s"] = after - started
                evidence["post_ready_samples"] = int(evidence["post_ready_samples"]) + 1
            if status == "ODÖMBART":
                verdict = "ODÖMBART"; evidence["observer_error"] = why; break
            hit, chain = observe_provider(
                rows, loop_pid=proc.pid, provider=provider, nonce=nonce,
                controller_root=controller_root, loop_path=loop_path)
            if hit is not None:
                verdict = "PASS"; evidence["provider"] = hit; evidence["ancestry"] = chain; break
            pause(0.03)
        if proc.poll() is not None:
            evidence["process_exited_before_observer_conclusion"] = True
    finally:
        # This is the only normal release.  The later controller timeout is a
        # cleanup fail-safe and is mechanically ordered after every bounded
        # post-ready sample can conclude, including its maximum overrun.
        release.touch()
        evidence["release_written"] = True
        evidence["observer_elapsed_s"] = clock() - started
    evidence["ready_observed"] = bool(evidence.get("ready_observed", False))
    return verdict, evidence


def observer_selftests() -> None:
    provider = Path("/var/folders/h035/provider.sh"); nonce = "a" * 32
    def row(pid: int, ppid: int, comm: str, args: str, pgid: int = 60) -> dict[str, object]:
        return {"pid":pid,"ppid":ppid,"pgid":pgid,"comm":comm,"args":args}
    forwarded = f" -- {provider} {nonce}"
    real_comm = "/opt/homebrew/Ce"
    controller_exec = "/opt/homebrew/Cellar/python@3.12/fixture/Python"
    runtime_exec="/private/tmp/.nortropic-h036-runtime-a1b2c3d4/python3.12"
    supervisor_args=(runtime_exec+" -I -S -B "+
        str(ROOT/"controller/launch/runtime_snapshot.py")+
        " supervise-v1 --control-fd 17 --ready-fd 250")
    chain = [row(10,1,real_comm,controller_exec+" "+str(LOOP)+" run cfg",60),
             row(20,10,real_comm,controller_exec+" "+str(ROOT/"controller/brytare/cli")+" kor"+forwarded,60),
             row(30,20,real_comm,controller_exec+" "+str(ROOT/"controller/utforare/cli")+" kor"+forwarded,60),
             row(40,30,real_comm,controller_exec+" "+str(ROOT/"controller/launch/cli")+" run"+forwarded,60),
             row(50,40,"/private/tmp/.n",supervisor_args,50),
             row(61,50,"/bin/sh",f"/bin/sh {provider} {nonce}",61)]
    clone_root = Path("/private/tmp/h035-observer-clone-root")
    clone_loop = clone_root/"controller/loop/cli"
    clone_required = [clone_loop, clone_root/"controller/brytare/cli",
                      clone_root/"controller/utforare/cli",
                      clone_root/"controller/launch/cli"]
    clone_chain = [dict(value) for value in chain]
    for index, expected in enumerate(clone_required):
        tokens=shlex.split(str(chain[index]["args"]),posix=True)
        tokens[1]=str(expected);clone_chain[index]["args"]=shlex.join(tokens)
    clone_supervisor=shlex.split(str(clone_chain[4]["args"]),posix=True)
    clone_supervisor[4]=str(clone_root/"controller/launch/runtime_snapshot.py")
    clone_chain[4]["args"]=shlex.join(clone_supervisor)
    mixed_root = []
    for index, expected in enumerate(clone_required):
        rows = [dict(value) for value in clone_chain]
        wrong = (LOOP, ROOT/"controller/brytare/cli", ROOT/"controller/utforare/cli",
                 ROOT/"controller/launch/cli")[index]
        tokens=shlex.split(str(rows[index]["args"]),posix=True)
        tokens[1]=str(wrong);tokens.append(str(expected));rows[index]["args"]=shlex.join(tokens)
        mixed_root.append(rows)
    late_token=[dict(value) for value in clone_chain]
    late_tokens=shlex.split(str(late_token[0]["args"]),posix=True)
    late_tokens[1]="-c";late_tokens.append(str(clone_loop))
    late_token[0]["args"]=shlex.join(late_tokens)
    different_executable=[dict(value) for value in clone_chain]
    different_tokens=shlex.split(str(different_executable[2]["args"]),posix=True)
    different_tokens[0]="/opt/homebrew/Cellar/python@3.12/other/Python"
    different_executable[2]["args"]=shlex.join(different_tokens)
    direct_chain=[dict(value) for value in clone_chain[:4]]
    direct_chain.append(row(61,40,"/bin/sh",f"/bin/sh {provider} {nonce}",61))
    wrong_helper=[dict(value) for value in clone_chain]
    wrong_helper_tokens=shlex.split(str(wrong_helper[4]["args"]),posix=True)
    wrong_helper_tokens[4]=str(ROOT/"controller/launch/runtime_snapshot.py")
    wrong_helper[4]["args"]=shlex.join(wrong_helper_tokens)
    wrong_runtime=[dict(value) for value in clone_chain]
    wrong_runtime_tokens=shlex.split(str(wrong_runtime[4]["args"]),posix=True)
    wrong_runtime_tokens[0]="/private/tmp/not-h036-runtime/python3.12"
    wrong_runtime[4]["args"]=shlex.join(wrong_runtime_tokens)
    wrong_fds=[]
    for control_fd,ready_fd in (("02","250"),("2","250"),("17","17"),("٣","250")):
        rows=[dict(value) for value in clone_chain]
        tokens=shlex.split(str(rows[4]["args"]),posix=True)
        tokens[7]=control_fd;tokens[9]=ready_fd;rows[4]["args"]=shlex.join(tokens)
        wrong_fds.append(rows)
    wrong_supervisor_pgid=[dict(value) for value in clone_chain]
    wrong_supervisor_pgid[4]["pgid"]=10
    wrong_provider_pgid=[dict(value) for value in clone_chain]
    wrong_provider_pgid[5]["pgid"]=10
    check(observe_provider(chain, loop_pid=10, provider=provider, nonce=nonce)[0] is not None
          and observe_provider(clone_chain, loop_pid=10, provider=provider, nonce=nonce,
                               controller_root=clone_root,loop_path=clone_loop)[0] is not None
          and observe_provider(clone_chain, loop_pid=10, provider=provider, nonce=nonce,
                               controller_root=ROOT,loop_path=clone_loop)[0] is None
          and observe_provider(clone_chain, loop_pid=10, provider=provider, nonce=nonce,
                               controller_root=clone_root,loop_path=LOOP)[0] is None
          and all(observe_provider(rows,loop_pid=10,provider=provider,nonce=nonce,
                                   controller_root=clone_root,loop_path=clone_loop)[0] is None
                  for rows in [*mixed_root,late_token,different_executable,
                               direct_chain,wrong_helper,wrong_runtime,*wrong_fds,
                               wrong_supervisor_pgid,wrong_provider_pgid]),
          "J_OBSERVER_REAL_OWNER_SPLIT_PGID_POSITIVE")
    shell = lambda pid, ppid, path=provider, value=nonce, extra="": row(
        pid, ppid, "/bin/sh", f"/bin/sh {path} {value}{extra}", pid)
    mutants = {
      "WRONG_NONCE":chain[:-1]+[shell(62,50,value="b"*32)],
      "STALE_NONCE":chain[:-1]+[shell(63,50,value="c"*32)],
      "NONCE_SUBSTRING":chain[:-1]+[shell(64,50,value=nonce+"x")],
      "SAME_BASENAME_DIFFERENT_PATH":chain[:-1]+[shell(65,50,path=Path("/private/other/provider.sh"))],
      "FORWARDED_ARGV_ONLY":chain[:-1],
      "SANDBOX_WITHOUT_PROVIDER":chain[:-1]+[row(66,50,"/usr/bin/sandbox-exec",f"/usr/bin/sandbox-exec {provider} {nonce}")],
      "OUTSIDE_LOOP_ANCESTRY":chain[:-1]+[shell(67,1)],
      "WRONG_LOOP_PID":chain,
      "MISSING_LAUNCH":chain[:3]+[chain[4]|{"ppid":30}]+[shell(68,50)],
      "MISSING_UTFORARE":chain[:2]+[chain[3]|{"ppid":20},chain[4]]+[shell(69,50)],
      "MISSING_BRYTARE":[chain[0],chain[2]|{"ppid":10},chain[3],chain[4],shell(70,50)],
      "REORDERED_ANCESTRY":[chain[0],chain[2]|{"ppid":10},chain[1]|{"ppid":30},
          chain[3]|{"ppid":20},chain[4],shell(71,50)],
      "UNRELATED_SH_EXTRA_ARG":chain[:-1]+[shell(72,50,extra=" unrelated")],
      "FABRICATED_PPID":chain[:-1]+[shell(73,999)],
      "FAKE_CONTROLLER_IMAGE":[chain[0],chain[1],chain[2],
          row(40,30,"/bin/sh",str(ROOT/"controller/launch/cli")+" run"+forwarded),
          chain[4],shell(74,50)],
    }
    for name, rows in mutants.items():
        print(f"MUTANT={name} PREDICTED=REJECT GUARD=J_OBSERVER_{name}")
        test_loop_pid = 999 if name == "WRONG_LOOP_PID" else 10
        check(observe_provider(rows, loop_pid=test_loop_pid, provider=provider, nonce=nonce)[0] is None,
              f"J_OBSERVER_{name}")

    sandbox = chain[:-1]+[row(80,50,"/usr/bin/sandbox-exec",
                              "/usr/bin/sandbox-exec profile",80),shell(81,80)]
    check(observe_provider(sandbox, loop_pid=10, provider=provider, nonce=nonce)[0] is None,
          "J_OBSERVER_UNPROVEN_SANDBOX_ANCESTRY_REJECTS")

    check((V6_PROCESS_SNAPSHOT_TIMEOUT_S, V6_STARTUP_WINDOW_S,
           V6_POST_READY_WINDOW_S, V6_RELEASE_CLEANUP_MARGIN_S,
           V6_PROVIDER_FAILSAFE_S) == (5.0, 24.0, 24.0, 10.0, 45),
          "J_OBSERVER_V6_FROZEN_LIFETIME_CONSTANTS")
    check(V6_PROVIDER_FAILSAFE_S > (V6_POST_READY_WINDOW_S
          + V6_PROCESS_SNAPSHOT_TIMEOUT_S + V6_RELEASE_CLEANUP_MARGIN_S),
          "J_OBSERVER_V6_FAILSAFE_AFTER_MAXIMUM_OBSERVER_COMPLETION")

    def start_fixture(root: Path, *, creates_ready: bool = True,
                      rapid_exit: bool = False) -> tuple[subprocess.Popen, Path, Path, Path]:
        ready = root / "ready"; release = root / "release"; worker = root / "provider.sh"
        if rapid_exit:
            source = "#!/bin/sh\nexit 7\n"
        elif creates_ready:
            source = synchronized_provider_script(ready, release)
        else:
            source = ("#!/bin/sh\n"
                      f"while [ ! -e {shlex.quote(str(release))} ]; do sleep 0.05; done\n"
                      "exit 7\n")
        worker.write_text(source); worker.chmod(0o700)
        proc = subprocess.Popen(["/bin/sh", str(worker), nonce], stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
        return proc, worker, ready, release

    def wait_ready(proc: subprocess.Popen, ready: Path) -> bool:
        deadline = time.monotonic() + 2
        while not ready.exists() and proc.poll() is None and time.monotonic() < deadline:
            time.sleep(0.01)
        return ready.exists()

    # Five empty snapshots consume 21 simulated seconds.  The sixth returns
    # the exact relationship after 25.2 seconds, later than the R7 review's
    # 20.2722-second counterexample and after the nominal 24-second check.
    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-slow-match-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root)
        is_ready = wait_ready(proc, ready); virtual = [0.0]; calls = [0]
        slow_chain = [row(proc.pid,1,real_comm,controller_exec+" "+str(LOOP)+" run cfg",60),
                      row(120,proc.pid,real_comm,controller_exec+" "+str(ROOT/"controller/brytare/cli")+f" kor -- {worker} {nonce}",60),
                      row(130,120,real_comm,controller_exec+" "+str(ROOT/"controller/utforare/cli")+f" kor -- {worker} {nonce}",60),
                      row(140,130,real_comm,controller_exec+" "+str(ROOT/"controller/launch/cli")+f" run -- {worker} {nonce}",60),
                      row(150,140,"/private/tmp/.n",supervisor_args,150),
                      row(161,150,"/bin/sh",f"/bin/sh {worker} {nonce}",161)]
        def slow_then_match() -> tuple[str, list[dict[str, object]], str]:
            calls[0] += 1; virtual[0] += 4.2
            return "OK", slow_chain if calls[0] == 6 else [], ""
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=slow_then_match, clock=lambda:virtual[0], pause=lambda _delay:None)
        proc.communicate(timeout=3)
        check(is_ready and verdict == "PASS" and calls[0] == 6
              and float(evidence["observer_elapsed_s"]) > 20.2722
              and release.exists() and proc.returncode == 7,
              "J_OBSERVER_V6_SLOW_MATCH_AFTER_PRIOR_20_27_SECONDS", repr(evidence))

    # Marker-only slow schedules exhaust as FAIL, but the provider remains
    # alive for every sample and exits only after observer-owned release.
    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-slow-empty-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root)
        is_ready = wait_ready(proc, ready); virtual = [0.0]; alive = [True]
        def slow_empty() -> tuple[str, list[dict[str, object]], str]:
            alive[0] = alive[0] and proc.poll() is None; virtual[0] += 4.2
            return "OK", [], ""
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=slow_empty, clock=lambda:virtual[0], pause=lambda _delay:None)
        proc.communicate(timeout=3)
        check(is_ready and verdict == "FAIL" and alive[0]
              and float(evidence["observer_elapsed_s"]) > 20.2722
              and release.exists() and proc.returncode == 7,
              "J_OBSERVER_V6_SLOW_MARKER_ONLY_REJECTS_AND_RELEASES", repr(evidence))

    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-error-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root)
        is_ready = wait_ready(proc, ready)
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=lambda:("ODÖMBART", [], "forced observer error"))
        proc.communicate(timeout=3)
        check(is_ready and verdict == "ODÖMBART" and release.exists() and proc.returncode == 7
              and not evidence.get("provider"),
              "J_OBSERVER_V6_ERROR_RELEASES_WITHOUT_PASS", repr(evidence))

    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-no-ready-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root, creates_ready=False)
        virtual = [0.0]
        def no_ready_empty() -> tuple[str, list[dict[str, object]], str]:
            virtual[0] += 4.2; return "OK", [], ""
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=no_ready_empty, clock=lambda:virtual[0], pause=lambda _delay:None)
        proc.communicate(timeout=3)
        check(verdict == "FAIL" and not ready.exists() and release.exists() and proc.returncode == 7,
              "J_OBSERVER_V6_NO_READY_BOUNDED_FAIL_AND_CLEANUP", repr(evidence))

    with tempfile.TemporaryDirectory(prefix="h035-observer-v6-rapid-exit-") as raw:
        root = Path(raw); proc, worker, ready, release = start_fixture(root, rapid_exit=True)
        proc.wait(timeout=3)
        verdict, evidence = observe_provider_lifetime(
            proc, provider=worker, nonce=nonce, ready=ready, release=release,
            snapshot_fn=lambda:("OK", [], ""))
        proc.communicate(timeout=3)
        check(verdict == "FAIL" and not ready.exists() and release.exists() and proc.returncode == 7,
              "J_OBSERVER_V6_RAPID_EXIT_NO_READY_REJECTS", repr(evidence))


def synchronized_provider_script(ready: Path, release: Path) -> str:
    """V6 provider: only observer release ends normal fixture lifetime."""
    return (
        "#!/bin/sh\n"
        f": > {shlex.quote(str(ready))}\n"
        f"while [ ! -e {shlex.quote(str(release))} ]; do\n"
        "  sleep 0.05\n"
        "done\n"
        "printf '%s\\n' 'fixture provider refusal' >&2\n"
        "exit 7\n")


def r17_standalone_source_topology(source: Path) -> tuple[Path,Path,Path]:
    """Return one exact standalone checkout/.git/common topology or fail closed."""
    if (not source.is_absolute() or Path(os.path.normpath(str(source)))!=source
            or source.resolve(strict=True)!=source):
        raise Rig("loop repository source root grammar")
    nofollow,why=r15_nofollow_components(source,leaf_directory=True)
    if not nofollow:raise Rig("loop repository source root "+why)
    source_dot_git=source/".git"
    source_dot_git_info=os.lstat(source_dot_git)
    if (not stat.S_ISDIR(source_dot_git_info.st_mode)
            or source_dot_git_info.st_uid!=os.getuid()):
        raise Rig("loop repository source must be standalone .git directory")
    if stat.S_IMODE(source_dot_git_info.st_mode) not in (0o700,0o755):
        raise Rig("loop repository source standalone .git mode")
    if os.path.lexists(source_dot_git/"commondir"):
        raise Rig("loop repository source standalone commondir forbidden")
    source_git,source_common,_config=r15_admin_paths(source)
    if source_git!=source_dot_git or source_common!=source_git:
        raise Rig("loop repository source standalone common Git authority")
    return source,source_git,source_common


def r15_loop_repository_state(candidate_sha: str,
                              replica: Path | None = None) -> tuple[dict[str,object],dict[str,object]]:
    """Authenticate source and optional standalone replica without following links."""
    if re.fullmatch(r"[0-9a-f]{40}",candidate_sha) is None:
        raise Rig("loop replica candidate SHA grammar")

    def metadata(value: os.stat_result) -> tuple[int,...]:
        return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_gid,
                value.st_nlink,value.st_size,value.st_mtime_ns,value.st_ctime_ns)

    def inventory(root: Path, *, single_links: bool) -> tuple[dict[str,object],set[tuple[int,int]]]:
        if (not root.is_absolute() or Path(os.path.normpath(str(root)))!=root
                or root.resolve(strict=True)!=root):
            raise Rig("loop repository inventory root identity")
        nofollow,why=r15_nofollow_components(root,leaf_directory=True)
        if not nofollow:raise Rig("loop repository inventory "+why)
        directory_flags=(os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
        file_flags=(os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
        entries: dict[str,object]={};inodes:set[tuple[int,int]]=set()
        counters={"entries":0,"regular_bytes":0}

        def visit(descriptor: int, relative: str, initial: os.stat_result) -> None:
            names=os.listdir(descriptor)
            if len(names)!=len(set(names)):
                raise Rig("loop repository duplicate directory entry")
            for name in names:
                name.encode("utf-8",errors="strict")
                if not name or name in (".","..") or "/" in name or "\x00" in name:
                    raise Rig("loop repository noncanonical directory entry")
            entries[relative]=["D",*metadata(initial),sorted(names)]
            counters["entries"]+=1
            if counters["entries"]>16384:
                raise Rig("loop repository inventory count bound")
            for name in sorted(names):
                child=name if relative=="." else relative+"/"+name
                before=os.stat(name,dir_fd=descriptor,follow_symlinks=False)
                if stat.S_ISDIR(before.st_mode):
                    child_fd=os.open(name,directory_flags,dir_fd=descriptor)
                    try:
                        opened=os.fstat(child_fd)
                        if metadata(opened)!=metadata(before):
                            raise Rig("loop repository directory open race")
                        visit(child_fd,child,opened)
                        if (metadata(os.fstat(child_fd))!=metadata(opened)
                                or metadata(os.stat(name,dir_fd=descriptor,
                                                    follow_symlinks=False))!=metadata(opened)):
                            raise Rig("loop repository directory rebind")
                    finally:os.close(child_fd)
                elif stat.S_ISREG(before.st_mode):
                    if before.st_size>16*1024*1024:
                        raise Rig("loop repository regular leaf size bound")
                    leaf=os.open(name,file_flags,dir_fd=descriptor)
                    try:
                        opened=os.fstat(leaf)
                        if metadata(opened)!=metadata(before):
                            raise Rig("loop repository regular open race")
                        identity=(opened.st_dev,opened.st_ino)
                        if single_links and (opened.st_nlink!=1 or identity in inodes):
                            raise Rig("loop repository aliased regular byte")
                        digest=hashlib.sha256();remaining=opened.st_size
                        while remaining:
                            part=os.read(leaf,min(65536,remaining))
                            if not part:raise Rig("loop repository short regular read")
                            digest.update(part);remaining-=len(part)
                        if os.read(leaf,1):raise Rig("loop repository growing regular leaf")
                        if (metadata(os.fstat(leaf))!=metadata(opened)
                                or metadata(os.stat(name,dir_fd=descriptor,
                                                    follow_symlinks=False))!=metadata(opened)):
                            raise Rig("loop repository regular rebind")
                        entries[child]=["F",*metadata(opened),digest.hexdigest()]
                        inodes.add(identity);counters["entries"]+=1
                        counters["regular_bytes"]+=opened.st_size
                        if (counters["entries"]>16384
                                or counters["regular_bytes"]>256*1024*1024):
                            raise Rig("loop repository inventory aggregate bound")
                    finally:os.close(leaf)
                else:
                    raise Rig("loop repository symlink or special object")
            if (metadata(os.fstat(descriptor))!=metadata(initial)
                    or sorted(os.listdir(descriptor))!=sorted(names)):
                raise Rig("loop repository directory changed during inventory")

        before=os.lstat(root);root_fd=os.open(root,directory_flags)
        try:
            opened=os.fstat(root_fd)
            if metadata(opened)!=metadata(before):
                raise Rig("loop repository root open race")
            visit(root_fd,".",opened)
            if (metadata(os.fstat(root_fd))!=metadata(opened)
                    or metadata(os.lstat(root))!=metadata(opened)):
                raise Rig("loop repository root rebind")
        finally:os.close(root_fd)
        stable={name:(value[:8]+value[10:] if name==".git" else value)
                for name,value in entries.items()}
        projection={"root":str(root),"entries":entries,
                    "regular_count":len(inodes),"regular_bytes":counters["regular_bytes"]}
        projection["sha256"]=hashlib.sha256(json.dumps(
            projection,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode()).hexdigest()
        projection["stable_sha256"]=hashlib.sha256(json.dumps(
            stable,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode()).hexdigest()
        return projection,inodes

    source,source_git,source_common=r17_standalone_source_topology(ROOT)
    source_config,source_config_raw,source_config_identity,_origin=(
        r15_local_config_snapshot(source))
    source_forbidden=tuple(
        base/relative for base in {source_git,source_common} for relative in (
            "commondir","shallow","info/grafts","objects/info/alternates",
            "objects/info/http-alternates","refs/replace"))
    if any(os.path.lexists(path) for path in source_forbidden):
        raise Rig("loop repository source alternate object authority")
    checkout_before,_checkout_before_inodes=inventory(source,single_links=False)
    git_before,_git_before_inodes=inventory(source_git,single_links=False)
    common_before,_common_before_inodes=inventory(source_common,single_links=False)
    source_top=r15_git(source,"rev-parse","--show-toplevel")
    source_git_observed=r15_git(source,"rev-parse","--absolute-git-dir")
    source_common_observed=r15_git(source,"rev-parse","--git-common-dir")
    try:
        observed_top=Path(source_top.stdout.strip()).resolve(strict=True)
        observed_git=Path(source_git_observed.stdout.strip()).resolve(strict=True)
        common_raw=Path(source_common_observed.stdout.strip())
        observed_common=(common_raw if common_raw.is_absolute()
                         else source/common_raw).resolve(strict=True)
    except (OSError,RuntimeError):
        raise Rig("loop repository source Git topology output")
    if (any(value.returncode or value.stderr for value in (
            source_top,source_git_observed,source_common_observed))
            or observed_top!=source or observed_git!=source_git
            or observed_common!=source_common):
        raise Rig("loop repository source Git topology substitution")
    replacements=r15_git(source,"for-each-ref","--format=%(refname)","refs/replace")
    if replacements.returncode or replacements.stderr or replacements.stdout:
        raise Rig("loop repository source replacement refs")
    head=r15_git(source,"rev-parse","--verify","HEAD^{commit}")
    tree=r15_git(source,"show","-s","--format=%T",candidate_sha)
    if (head.returncode or head.stderr or head.stdout!=candidate_sha+"\n"
            or tree.returncode or tree.stderr
            or re.fullmatch(r"[0-9a-f]{40}\n",tree.stdout) is None):
        raise Rig("loop repository source HEAD/tree identity")
    physical,physical_why=r15_physical_checkout_exact(source,candidate_sha)
    if not physical:raise Rig("loop repository source "+physical_why)
    checkout_state,checkout_inodes=inventory(source,single_links=False)
    git_state,git_inodes=inventory(source_git,single_links=False)
    common_state,common_inodes=inventory(source_common,single_links=False)
    if (checkout_state!=checkout_before or git_state!=git_before
            or common_state!=common_before):
        raise Rig("loop repository source changed during closed Git authentication")
    config_after,config_after_raw,config_after_identity,_origin_after=(
        r15_local_config_snapshot(source))
    if (config_after!=source_config or config_after_raw!=source_config_raw
            or metadata(config_after_identity)!=metadata(source_config_identity)):
        raise Rig("loop repository source config changed during authentication")
    source_state={
        "candidate_sha":candidate_sha,"candidate_tree":tree.stdout.strip(),
        "standalone_dot_git_directory":True,
        "checkout_root":str(source),"git_dir":str(source_git),
        "common_dir":str(source_common),
        "checkout_root_identity":list(metadata(os.lstat(source))),
        "git_dir_identity":list(metadata(os.lstat(source_git))),
        "common_dir_identity":list(metadata(os.lstat(source_common))),
        "config_path":str(source_config),
        "config_identity":list(metadata(source_config_identity)),
        "config_sha256":hashlib.sha256(source_config_raw).hexdigest(),
        "checkout_sha256":checkout_state["sha256"],
        "git_dir_sha256":git_state["sha256"],
        "common_dir_sha256":common_state["sha256"],
        "checkout_regular_count":checkout_state["regular_count"],
        "git_dir_regular_count":git_state["regular_count"],
        "common_dir_regular_count":common_state["regular_count"],
    }
    source_state["sha256"]=hashlib.sha256(json.dumps(
        source_state,sort_keys=True,separators=(",",":")).encode()).hexdigest()
    if replica is None:return source_state,{}

    replica=replica.resolve(strict=True)
    replica_git,replica_common,config_path=r15_admin_paths(replica)
    if replica_git!=replica/".git" or replica_common!=replica_git:
        raise Rig("loop replica must be standalone Git repository")
    replica_head=r15_git(replica,"rev-parse","--verify","HEAD^{commit}")
    replica_tree=r15_git(replica,"show","-s","--format=%T",candidate_sha)
    if (replica_head.returncode or replica_head.stderr
            or replica_head.stdout!=candidate_sha+"\n"
            or replica_tree.returncode or replica_tree.stderr
            or replica_tree.stdout!=tree.stdout):
        raise Rig("loop replica HEAD/tree mismatch")
    physical,physical_why=r15_physical_checkout_exact(replica,candidate_sha)
    if not physical:raise Rig("loop replica "+physical_why)
    config=r15_git_bytes(replica,"config","--no-includes","--local","--null","--list")
    if config.returncode or config.stderr:
        raise Rig("loop replica local config observation")
    config_rows=config.stdout.split(b"\0")
    if not config_rows or config_rows[-1]!=b"":
        raise Rig("loop replica local config framing")
    parsed: dict[str,list[str]]={}
    try:
        for raw in config_rows[:-1]:
            key,separator,value=raw.decode("utf-8",errors="strict").partition("\n")
            if not separator:raise Rig("loop replica local config row")
            parsed.setdefault(key,[]).append(value)
    except UnicodeError as exc:raise Rig("loop replica local config UTF-8") from exc
    expected_config={
        "core.repositoryformatversion":["0"],"core.filemode":["true"],
        "core.bare":["false"],"core.logallrefupdates":["false"],
        "core.ignorecase":["true"],"core.precomposeunicode":["true"],
        "core.hookspath":["/dev/null"],"gc.auto":["0"],
        "maintenance.auto":["false"],"fetch.writecommitgraph":["false"],
        "pack.writereverseindex":["false"],
        "protocol.file.allow":["never"],
    }
    if parsed!=expected_config:raise Rig("loop replica local config authority")
    forbidden=(replica_git/"config.worktree",replica_git/"objects/info/alternates",
               replica_git/"objects/info/http-alternates",replica_git/"info/grafts",
               replica_git/"objects/info/commit-graph",
               replica_git/"objects/pack/multi-pack-index",replica_git/"shallow",
               replica_git/"FETCH_HEAD",replica_git/"ORIG_HEAD",
               replica_git/"MERGE_HEAD",replica_git/"CHERRY_PICK_HEAD",
               replica_git/"REVERT_HEAD",replica_git/"BISECT_LOG",
               replica_git/"packed-refs",replica_git/"logs")
    if any(os.path.lexists(path) for path in forbidden):
        raise Rig("loop replica forbidden Git administration surface")
    refs=r15_git(replica,"for-each-ref","--format=%(refname) %(objectname)")
    remotes=r15_git(replica,"remote")
    worktrees=r15_git(replica,"worktree","list","--porcelain")
    expected_worktree=f"worktree {replica}\nHEAD {candidate_sha}\ndetached\n\n"
    if (refs.returncode or refs.stderr or refs.stdout or remotes.returncode
            or remotes.stderr or remotes.stdout or worktrees.returncode
            or worktrees.stderr or worktrees.stdout!=expected_worktree):
        raise Rig("loop replica refs/remotes/worktree residue")
    reachable=r15_git(replica,"rev-list","--objects",candidate_sha)
    stored=r15_git(replica,"cat-file","--batch-all-objects",
                   "--batch-check=%(objectname)")
    if reachable.returncode or reachable.stderr or stored.returncode or stored.stderr:
        raise Rig("loop replica object closure observation")
    reachable_oids=[line.split(" ",1)[0] for line in reachable.stdout.splitlines()]
    stored_oids=stored.stdout.splitlines()
    if (len(reachable_oids)<=1 or len(reachable_oids)!=len(set(reachable_oids))
            or len(stored_oids)!=len(set(stored_oids))
            or set(reachable_oids)!=set(stored_oids)
            or any(re.fullmatch(r"[0-9a-f]{40}",oid) is None
                   for oid in [*reachable_oids,*stored_oids])):
        raise Rig("loop replica stored object closure mismatch")
    fsck=r15_git(replica,"fsck","--strict","--no-reflogs","--full",candidate_sha)
    if fsck.returncode or fsck.stdout or fsck.stderr:
        raise Rig("loop replica object integrity")
    replica_state,replica_inodes=inventory(replica,single_links=True)
    source_inodes=checkout_inodes|git_inodes|common_inodes
    if replica_inodes & source_inodes:
        raise Rig("loop replica shares regular-file identity with authority")
    hostile=[name for name in replica_state["entries"]
             if name.endswith((".lock",".promisor",".keep",".bitmap"))
             or name==".git/worktrees" or name.startswith(".git/worktrees/")]
    for relative in (".git/HEAD",".git/config",".git/index"):
        value=replica_state["entries"].get(relative)
        if not isinstance(value,list) or value[0]!="F" or value[6]!=1:
            raise Rig("loop replica HEAD/config/index physical identity")
    if hostile:raise Rig("loop replica lock/promisor/worktree residue")
    admin=replica_state["entries"]

    def exact_directory(relative: str, names: set[str]) -> bool:
        value=admin.get(relative)
        return (isinstance(value,list) and value[0]=="D"
                and value[4]==os.getuid()
                and stat.S_IMODE(value[3]) in (0o700,0o755)
                and set(value[10])==names)

    if (not exact_directory(".git",{"HEAD","config","index","objects","refs"})
            or not exact_directory(".git/objects/info",set())
            or not exact_directory(".git/refs",{"heads","tags"})
            or not exact_directory(".git/refs/heads",set())
            or not exact_directory(".git/refs/tags",set())):
        raise Rig("loop replica closed Git administration grammar")
    if not exact_directory(".git/objects",{"info","pack"}):
        raise Rig("loop replica object administration membership")
    pack_value=admin.get(".git/objects/pack")
    if not isinstance(pack_value,list) or pack_value[0]!="D":
        raise Rig("loop replica pack administration root")
    pack_files=set(pack_value[10]);pack_stems=set()
    for name in pack_files:
        match=re.fullmatch(r"(pack-[0-9a-f]{40})\.(idx|pack)",name)
        pack_entry=admin.get(".git/objects/pack/"+name)
        if (match is None or not isinstance(pack_entry,list)
                or pack_entry[0]!="F" or stat.S_IMODE(pack_entry[3])!=0o444
                or pack_entry[4]!=os.getuid() or pack_entry[6]!=1):
            raise Rig("loop replica pack file grammar")
        pack_stems.add(match.group(1))
    if (len(pack_stems)!=1 or not exact_directory(".git/objects/pack",pack_files)
            or pack_files!={stem+suffix for stem in pack_stems
                                      for suffix in (".idx",".pack")}
            ):
        raise Rig("loop replica exact pack pair/object grammar")
    head_raw,_head_identity=r15_stable_regular_bytes(
        replica_git/"HEAD",max_bytes=128,modes=(0o600,0o644))
    config_file_raw,_config_identity=r15_stable_regular_bytes(
        config_path,max_bytes=65536,modes=(0o600,0o644))
    _index_raw,_index_identity=r15_stable_regular_bytes(
        replica_git/"index",max_bytes=16*1024*1024,modes=(0o600,0o644))
    if head_raw!=(candidate_sha+"\n").encode():
        raise Rig("loop replica detached HEAD bytes")
    replica_projection={
        "candidate_sha":candidate_sha,"candidate_tree":replica_tree.stdout.strip(),
        "root":str(replica),"git_dir":str(replica_git),"common_dir":str(replica_common),
        "full_sha256":replica_state["sha256"],
        "stable_sha256":replica_state["stable_sha256"],
        "regular_count":replica_state["regular_count"],
        "regular_bytes":replica_state["regular_bytes"],
        "stored_object_count":len(stored_oids),
        "stored_object_sha256":hashlib.sha256(
            ("\n".join(sorted(stored_oids))+"\n").encode()).hexdigest(),
        "config_sha256":hashlib.sha256(config_file_raw).hexdigest(),
        "all_regular_nlink_one":True,"internal_regular_inodes_unique":True,
        "authority_regular_inodes_disjoint":True,
    }
    return source_state,replica_projection


def loop_fixture(tmp: Path, authority: str, candidate_sha: str, *, restart: bool = False,
                 observe: bool = False) -> tuple[subprocess.CompletedProcess, str, str, bool, dict[str, object]]:
    """Run only a fresh no-alias standalone replica of the reviewed candidate."""
    tmp=tmp.resolve(strict=True);tmp_info=os.lstat(tmp)
    nofollow,why=r15_nofollow_components(tmp,leaf_directory=True)
    if (not nofollow or tmp_info.st_uid!=os.getuid()
            or stat.S_IMODE(tmp_info.st_mode)!=0o700
            or ROOT==tmp or ROOT in tmp.parents or tmp in ROOT.parents):
        raise Rig("loop replica gate-private root: "+why)
    source_baseline,_unused=r15_loop_repository_state(candidate_sha)
    source_handles: list[tuple[str,Path,int,tuple[int,...],str | None]]=[]

    def source_fields(value: os.stat_result) -> tuple[int,...]:
        return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_gid,
                value.st_nlink,value.st_size,value.st_mtime_ns,value.st_ctime_ns)

    def retained_regular_sha256(descriptor: int, size: int) -> str:
        chunks=[];offset=0
        while offset<size:
            chunk=os.pread(descriptor,min(65536,size-offset),offset)
            if not chunk:raise Rig("loop replica retained source short read")
            chunks.append(chunk);offset+=len(chunk)
        if os.pread(descriptor,1,size):
            raise Rig("loop replica retained source size changed")
        return hashlib.sha256(b"".join(chunks)).hexdigest()

    def retain_source_authority() -> None:
        directory_flags=(os.O_RDONLY|getattr(os,"O_DIRECTORY",0)
                         |getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0))
        file_flags=(os.O_RDONLY|getattr(os,"O_NOFOLLOW",0)
                    |getattr(os,"O_NONBLOCK",0)|getattr(os,"O_CLOEXEC",0))
        materials=(("root",Path(str(source_baseline["checkout_root"])),True),
                   ("git_dir",Path(str(source_baseline["git_dir"])),True),
                   ("common_dir",Path(str(source_baseline["common_dir"])),True),
                   ("config",Path(str(source_baseline["config_path"])),False))
        try:
            for label,path,is_directory in materials:
                before=os.lstat(path)
                descriptor=os.open(path,directory_flags if is_directory else file_flags)
                opened=os.fstat(descriptor)
                if (source_fields(before)!=source_fields(opened)
                        or is_directory!=stat.S_ISDIR(opened.st_mode)
                        or (not is_directory and not stat.S_ISREG(opened.st_mode))):
                    os.close(descriptor)
                    raise Rig("loop replica retained source "+label+" identity")
                digest=None
                if not is_directory:
                    digest=retained_regular_sha256(descriptor,opened.st_size)
                source_handles.append((label,path,descriptor,source_fields(opened),digest))
        except Exception:
            for _label,_path,descriptor,_identity,_digest in reversed(source_handles):
                os.close(descriptor)
            source_handles.clear()
            raise

    def validate_source_authority() -> None:
        for label,path,descriptor,identity,digest in source_handles:
            linked=os.lstat(path);opened=os.fstat(descriptor)
            if (source_fields(linked)!=identity or source_fields(opened)!=identity
                    or (digest is not None
                        and retained_regular_sha256(descriptor,opened.st_size)!=digest)):
                raise Rig("loop replica retained source changed: "+label)

    retain_source_authority();validate_source_authority()
    nonce=secrets.token_hex(16);suffix=f"{authority}-{int(restart)}-{nonce}"
    repo=tmp/f"r17-loop-repository-{suffix}"
    runtime=tmp/f"r17-loop-runtime-{suffix}"
    workspace_root=tmp/f"workspaces-{authority}-{int(restart)}"
    template=runtime/"empty-template";resolver=runtime/"resolver"
    empty_home=runtime/"home";empty_xdg=runtime/"xdg";runtime_tmp=runtime/"tmp"
    active: list[subprocess.Popen]=[];repo_identity: tuple[int,int] | None=None
    evidence: dict[str,object]={};result: subprocess.CompletedProcess | None=None
    verdict="ODÖMBART";state_text="";done=False

    def h036_runtime_roots() -> dict[str,list[int]]:
        parent=Path("/private/tmp")
        nofollow,runtime_why=r15_nofollow_components(parent,leaf_directory=True)
        if not nofollow:raise Rig("H036 runtime parent "+runtime_why)
        flags=(os.O_RDONLY|getattr(os,"O_DIRECTORY",0)
               |getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0))
        descriptor=os.open(parent,flags)
        try:
            first=sorted(name for name in os.listdir(descriptor)
                         if name.startswith(".nortropic-h036-runtime-"))
            observed={}
            for name in first:
                info=os.stat(name,dir_fd=descriptor,follow_symlinks=False)
                observed[name]=[info.st_dev,info.st_ino,info.st_mode,info.st_uid,
                                info.st_gid,info.st_nlink]
            if sorted(name for name in os.listdir(descriptor)
                      if name.startswith(".nortropic-h036-runtime-"))!=first:
                raise Rig("H036 runtime-root inventory changed during observation")
            return observed
        finally:os.close(descriptor)

    h036_runtime_baseline=h036_runtime_roots()
    if h036_runtime_baseline:
        raise Rig("preexisting H036 runtime-root residue")

    def remove_empty_workspace_root() -> None:
        flags=(os.O_RDONLY|getattr(os,"O_DIRECTORY",0)
               |getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0))
        parent=os.open(tmp,flags)
        try:
            if (os.fstat(parent).st_dev,os.fstat(parent).st_ino)!=(
                    tmp_info.st_dev,tmp_info.st_ino):
                raise Rig("loop fixture private parent changed")
            try:before=os.stat(workspace_root.name,dir_fd=parent,follow_symlinks=False)
            except FileNotFoundError:return
            if not stat.S_ISDIR(before.st_mode) or before.st_uid!=os.getuid():
                raise Rig("loop fixture workspace residue")
            child=os.open(workspace_root.name,flags,dir_fd=parent)
            try:
                opened=os.fstat(child)
                if ((opened.st_dev,opened.st_ino,opened.st_mode)
                        !=(before.st_dev,before.st_ino,before.st_mode)
                        or os.listdir(child)):
                    raise Rig("loop fixture workspace root rebind")
                os.rmdir(workspace_root.name,dir_fd=parent)
            finally:os.close(child)
        finally:os.close(parent)

    def remove_private_tree(path: Path, identity: tuple[int,int]) -> None:
        directory_flags=(os.O_RDONLY|getattr(os,"O_DIRECTORY",0)
                         |getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0))
        parent_fd=os.open(path.parent,directory_flags);root_fd=-1
        try:
            before=os.stat(path.name,dir_fd=parent_fd,follow_symlinks=False)
            root_fd=os.open(path.name,directory_flags,dir_fd=parent_fd)
            opened=os.fstat(root_fd)
            if (not stat.S_ISDIR(opened.st_mode)
                    or (before.st_dev,before.st_ino)!=(opened.st_dev,opened.st_ino)
                    or (opened.st_dev,opened.st_ino)!=identity):
                raise Rig("loop replica cleanup retained root identity")

            def clear(descriptor: int) -> None:
                for name in sorted(os.listdir(descriptor)):
                    info=os.stat(name,dir_fd=descriptor,follow_symlinks=False)
                    if stat.S_ISDIR(info.st_mode):
                        child=os.open(name,directory_flags,dir_fd=descriptor)
                        try:
                            child_info=os.fstat(child)
                            if (child_info.st_dev,child_info.st_ino,child_info.st_mode)!=(
                                    info.st_dev,info.st_ino,info.st_mode):
                                raise Rig("loop replica cleanup child open race")
                            clear(child)
                            final=os.stat(name,dir_fd=descriptor,follow_symlinks=False)
                            if (final.st_dev,final.st_ino,final.st_mode)!=(
                                    child_info.st_dev,child_info.st_ino,child_info.st_mode):
                                raise Rig("loop replica cleanup child rebind")
                            os.rmdir(name,dir_fd=descriptor)
                        finally:os.close(child)
                    else:os.unlink(name,dir_fd=descriptor)
                if os.listdir(descriptor):raise Rig("loop replica cleanup nonempty directory")

            clear(root_fd)
            final=os.stat(path.name,dir_fd=parent_fd,follow_symlinks=False)
            if (final.st_dev,final.st_ino)!=(opened.st_dev,opened.st_ino):
                raise Rig("loop replica cleanup final root rebind")
            os.rmdir(path.name,dir_fd=parent_fd)
        finally:
            if root_fd>=0:os.close(root_fd)
            os.close(parent_fd)

    try:
        runtime.mkdir(mode=0o700)
        for directory in (template,resolver,empty_home,empty_xdg,runtime_tmp):
            directory.mkdir(mode=0o700)
        if any(os.listdir(directory) for directory in
               (template,resolver,empty_home,empty_xdg,runtime_tmp)):
            raise Rig("loop replica runtime roots must start empty")
        python_ok,python_why=r15_ast_interpreter_validate(
            H035_R15_AST_PYTHON,H035_R15_AST_PYTHON_SHA256,
            H035_R15_AST_PYTHON_VERSION,sys.executable,tuple(sys.version_info[:3]))
        if not python_ok:raise Rig("loop replica interpreter "+python_why)
        python_link=resolver/"python3.12";python_link.symlink_to(H035_R15_AST_PYTHON)
        link_info=os.lstat(python_link)
        if (not stat.S_ISLNK(link_info.st_mode)
                or os.readlink(python_link)!=str(H035_R15_AST_PYTHON)
                or python_link.resolve(strict=True)!=H035_R15_AST_PYTHON):
            raise Rig("loop replica interpreter resolver identity")
        child_env={
            "HOME":str(empty_home),"XDG_CONFIG_HOME":str(empty_xdg),
            "PATH":str(resolver)+":/usr/bin:/bin","LANG":"C","LC_ALL":"C",
            "TMPDIR":str(runtime_tmp),"DARWIN_USER_TEMP_DIR":str(runtime_tmp),
            "GIT_CONFIG_NOSYSTEM":"1","GIT_CONFIG_GLOBAL":"/dev/null",
            "GIT_CONFIG_SYSTEM":"/dev/null","GIT_ATTR_NOSYSTEM":"1",
            "GIT_TERMINAL_PROMPT":"0","GIT_PAGER":"cat","GIT_OPTIONAL_LOCKS":"0",
            "GIT_NO_LAZY_FETCH":"1","PYTHONDONTWRITEBYTECODE":"1",
        }
        if set(child_env)!={
                "HOME","XDG_CONFIG_HOME","PATH","LANG","LC_ALL","TMPDIR",
                "DARWIN_USER_TEMP_DIR","GIT_CONFIG_NOSYSTEM","GIT_CONFIG_GLOBAL",
                "GIT_CONFIG_SYSTEM","GIT_ATTR_NOSYSTEM","GIT_TERMINAL_PROMPT",
                "GIT_PAGER","GIT_OPTIONAL_LOCKS","GIT_NO_LAZY_FETCH",
                "PYTHONDONTWRITEBYTECODE"}:
            raise Rig("loop replica child environment authority")
        repo.mkdir(mode=0o755);created=os.lstat(repo)
        if not stat.S_ISDIR(created.st_mode):raise Rig("loop replica root creation")
        repo_identity=(created.st_dev,created.st_ino)
        commands=(
            ("init","--quiet",f"--template={template}"),
            ("config","--local","--replace-all","core.repositoryformatversion","0"),
            ("config","--local","--replace-all","core.filemode","true"),
            ("config","--local","--replace-all","core.bare","false"),
            ("config","--local","--replace-all","core.logallrefupdates","false"),
            ("config","--local","--replace-all","core.ignorecase","true"),
            ("config","--local","--replace-all","core.precomposeunicode","true"),
            ("config","--local","--replace-all","core.hooksPath","/dev/null"),
            ("config","--local","--replace-all","gc.auto","0"),
            ("config","--local","--replace-all","maintenance.auto","false"),
            ("config","--local","--replace-all","fetch.writeCommitGraph","false"),
            ("config","--local","--replace-all","pack.writeReverseIndex","false"),
            ("config","--local","--replace-all","protocol.file.allow","never"),
            ("-c","protocol.file.allow=always","-c","fetch.unpackLimit=1",
             "fetch","--quiet","--no-tags",
             "--no-recurse-submodules","--no-write-fetch-head",str(ROOT),candidate_sha),
            ("checkout","--detach","--quiet",candidate_sha),
        )
        for command in commands:
            if command[0]=="-c":validate_source_authority()
            completed=r15_git(repo,*command)
            if completed.returncode or completed.stdout or completed.stderr:
                raise Rig("loop replica construction command "+repr(command)+": "+
                          (completed.stderr or completed.stdout))
        source_constructed,replica_baseline=r15_loop_repository_state(candidate_sha,repo)
        validate_source_authority()
        if source_constructed!=source_baseline:
            raise Rig("authority changed during loop replica construction")
        initial_stable=replica_baseline["stable_sha256"]
        worker=tmp/f"provider-{authority}-{int(restart)}.sh"
        ready=tmp/f"provider-{authority}-{int(restart)}-{nonce}.ready"
        release=tmp/f"provider-{authority}-{int(restart)}-{nonce}.release"
        if observe:
            worker.write_text(synchronized_provider_script(ready,release))
        else:
            worker.write_text("#!/bin/sh\nsleep 2\nprintf '%s\\n' 'fixture provider refusal' >&2\nexit 7\n")
        worker.chmod(0o700)
        allowed=["safe/**"] if authority=="ordinary" else []
        owner_allowed=["controller/h034-native/**"] if authority=="owner_authority" else []
        task={"id":"fixture-task","authority_class":authority,"allowed_write":allowed,
              "owner_author_allowed_write":owner_allowed,"docs_impact":[],"depends_on":[],
              "exit_test":"verify/bin/fixture-red","max_changed_files":5,"max_added_lines":20}
        spec=tmp/f"spec-{authority}-{int(restart)}.json"
        write_json(spec,{"spec_version":"2.0.0","defaults":{"denied_write":[]},"tasks":[task]})
        state=tmp/f"state-{authority}-{int(restart)}"
        attest=tmp/f"attest-{authority}-{int(restart)}"
        state_init=run([str(repo/"controller/state/cli"),"init",str(state)],
                       cwd=repo,env=child_env)
        if state_init.returncode:raise Rig(state_init.stderr or state_init.stdout)
        attest.mkdir()
        cfg=tmp/f"config-{authority}-{int(restart)}.json"
        write_json(cfg,{"spec":str(spec),"attest_dir":str(attest),"state_dir":str(state),
            "lease_dir":str(tmp/f"lease-{authority}-{int(restart)}"),"lease_resurs":"fixture",
            "workspace_rot":str(workspace_root),
            "base_sha":candidate_sha,"verifier_id":"h035-fixture-unregistered",
            "run_id":f"h035-{authority}-{int(restart)}",
            "brytare_rot":str(tmp/f"breaker-{authority}-{int(restart)}"),
            "budget":1,"troskel":1,"worker_cmd":[str(worker),nonce],
            "timeout_s":V6_PROVIDER_FAILSAFE_S if observe else 5})

        def no_process_residue() -> int:
            status,rows,residue_why=process_snapshot()
            if status!="OK":raise Rig("loop replica process residue observation "+residue_why)
            exact={str(repo/"controller/loop/cli"),str(repo/"controller/brytare/cli"),
                   str(repo/"controller/utforare/cli"),str(repo/"controller/launch/cli"),
                   str(worker),nonce,str(cfg)}
            matches=[]
            for row in rows:
                raw=str(row["args"])
                try:tokens=shlex.split(raw,posix=True)
                except ValueError:
                    if any(value in raw for value in exact):
                        raise Rig("loop replica unparsable process residue")
                    continue
                if (any(token in exact for token in tokens)
                        or any(token==str(repo) or token.startswith(str(repo)+"/")
                               or token==str(runtime) or token.startswith(str(runtime)+"/")
                               for token in tokens)):
                    matches.append(row)
            if matches:raise Rig("loop replica controller/provider process residue")
            return len(rows)

        def stop_bound_loop(proc: subprocess.Popen) -> None:
            if proc.poll() is not None:return
            proc.terminate()
            try:proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                if proc.poll() is None:proc.kill()
                proc.wait(timeout=2)

        def observed_run(serial: int) -> tuple[subprocess.CompletedProcess,str,dict[str,object]]:
            proc=subprocess.Popen([str(repo/"controller/loop/cli"),"run",str(cfg)],
                                  cwd=repo,env=child_env,text=True,
                                  stdout=subprocess.PIPE,stderr=subprocess.PIPE,
                                  start_new_session=True)
            active.append(proc)
            try:
                if observe:
                    local_verdict,local_evidence=observe_provider_lifetime(
                        proc,provider=worker,nonce=nonce,ready=ready,release=release,
                        controller_root=repo,loop_path=repo/"controller/loop/cli")
                else:
                    local_verdict,local_evidence="NOT_OBSERVED",{"nonce":nonce}
                try:
                    stdout,stderr=proc.communicate(timeout=V6_RELEASE_CLEANUP_MARGIN_S)
                except subprocess.TimeoutExpired:
                    stop_bound_loop(proc)
                    stdout,stderr=proc.communicate(timeout=2)
                    local_verdict="ODÖMBART"
                    local_evidence["cleanup_error"]="loop did not exit within release cleanup margin"
            finally:
                stop_bound_loop(proc)
            process_sample_count=no_process_residue()
            remove_empty_workspace_root()
            if h036_runtime_roots()!=h036_runtime_baseline:
                raise Rig("H036 runtime-root residue after loop run")
            source_after,replica_after=r15_loop_repository_state(candidate_sha,repo)
            validate_source_authority()
            if source_after!=source_baseline:
                raise Rig(f"authority changed during loop replica run {serial}")
            if replica_after["stable_sha256"]!=initial_stable:
                raise Rig(f"loop replica stable authority changed during run {serial}")
            local_evidence.update({
                "loop_pid":proc.pid,"provider_path":str(worker),
                "ready_observed":bool(local_evidence.get("ready_observed",False)),
                "loop_cleanup_complete":proc.poll() is not None,
                "ps_fields":["pid","ppid","pgid","comm","args"],
                "replica_candidate_sha":candidate_sha,
                "replica_candidate_tree":replica_after["candidate_tree"],
                "replica_root":str(repo),"replica_git_dir":replica_after["git_dir"],
                "replica_common_dir":replica_after["common_dir"],
                "replica_full_sha256":replica_after["full_sha256"],
                "replica_stable_sha256":replica_after["stable_sha256"],
                "replica_regular_count":replica_after["regular_count"],
                "replica_regular_bytes":replica_after["regular_bytes"],
                "replica_stored_object_count":replica_after["stored_object_count"],
                "replica_stored_object_sha256":replica_after["stored_object_sha256"],
                "replica_all_regular_nlink_one":replica_after["all_regular_nlink_one"],
                "replica_internal_regular_inodes_unique":replica_after[
                    "internal_regular_inodes_unique"],
                "replica_authority_regular_inodes_disjoint":replica_after[
                    "authority_regular_inodes_disjoint"],
                "source_authority_sha256":source_after["sha256"],
                "source_standalone_dot_git_directory":source_after[
                    "standalone_dot_git_directory"],
                "source_checkout_root":source_after["checkout_root"],
                "source_git_dir":source_after["git_dir"],
                "source_common_dir":source_after["common_dir"],
                "source_config_path":source_after["config_path"],
                "source_checkout_sha256":source_after["checkout_sha256"],
                "source_git_dir_sha256":source_after["git_dir_sha256"],
                "source_common_dir_sha256":source_after["common_dir_sha256"],
                "source_config_sha256":source_after["config_sha256"],
                "source_checkout_root_identity":source_after["checkout_root_identity"],
                "source_git_dir_identity":source_after["git_dir_identity"],
                "source_common_dir_identity":source_after["common_dir_identity"],
                "source_config_identity":source_after["config_identity"],
                "child_environment_keys":sorted(child_env),"run_serial":serial,
                "post_run_process_sample_count":process_sample_count,
            })
            return subprocess.CompletedProcess(
                proc.args,proc.returncode,stdout,stderr),local_verdict,local_evidence

        first,verdict,evidence=observed_run(1)
        if restart:
            second,second_verdict,second_evidence=observed_run(2)
            evidence["restart_first_run"]={
                "loop_exit":first.returncode,"observer_verdict":verdict,
                "replica_full_sha256":evidence["replica_full_sha256"],
                "replica_stable_sha256":evidence["replica_stable_sha256"],
                "source_authority_sha256":evidence["source_authority_sha256"],
            }
            if second_verdict=="PASS" or verdict!="PASS":verdict=second_verdict
            evidence.update(second_evidence);result=second
        else:result=first
        events=state/"events.jsonl"
        state_text=events.read_text(errors="replace") if events.exists() else ""
        done='"status": "done"' in state_text or '"status":"done"' in state_text
    finally:
        try:
            for proc in active:
                stop_bound_loop(proc)
            pre_cleanup_process_sample_count=(
                no_process_residue() if "no_process_residue" in locals() else 0)
            validate_source_authority()
            if result is None:remove_empty_workspace_root()
            elif os.path.lexists(workspace_root):
                raise Rig("loop fixture workspace residue after cleanup")
            if os.path.lexists(repo):
                cleanup_info=os.lstat(repo)
                if (repo_identity is None or not stat.S_ISDIR(cleanup_info.st_mode)
                        or (cleanup_info.st_dev,cleanup_info.st_ino)!=repo_identity):
                    raise Rig("loop replica cleanup root substitution")
                remove_private_tree(repo,repo_identity)
            if os.path.lexists(repo):raise Rig("loop replica cleanup residue")
            cleanup_process_sample_count=(
                no_process_residue() if "no_process_residue" in locals() else 0)
            if h036_runtime_roots()!=h036_runtime_baseline:
                raise Rig("H036 runtime-root residue after loop cleanup")
            source_cleanup,_unused=r15_loop_repository_state(candidate_sha)
            validate_source_authority()
            if source_cleanup!=source_baseline:
                raise Rig("authority changed through loop replica cleanup")
            if any(proc.poll() is None for proc in active):
                raise Rig("loop replica process residue")
            evidence["replica_cleanup_complete"]=True
            evidence["source_post_cleanup_sha256"]=source_cleanup["sha256"]
            evidence["pre_cleanup_process_sample_count"]=pre_cleanup_process_sample_count
            evidence["post_cleanup_process_sample_count"]=cleanup_process_sample_count
        finally:
            for _label,_path,descriptor,_identity,_digest in reversed(source_handles):
                os.close(descriptor)
    if result is None:raise Rig("loop replica produced no result")
    return result,verdict,state_text,done,evidence


def real_routing(tmp: Path) -> None:
    r15_local_config_snapshot(ROOT)
    candidate=r15_git(ROOT,"rev-parse","--verify","HEAD^{commit}")
    if (candidate.returncode or candidate.stderr
            or re.fullmatch(r"[0-9a-f]{40}\n",candidate.stdout) is None):
        raise Rig("real routing exact candidate identity")
    candidate_sha=candidate.stdout.strip()
    routing_source,_unused=r15_loop_repository_state(candidate_sha)

    def continuous(evidence: dict[str,object], route: str) -> None:
        current,_unused=r15_loop_repository_state(candidate_sha)
        if (current!=routing_source
                or evidence.get("source_post_cleanup_sha256")!=routing_source["sha256"]):
            raise Rig("real routing source continuity: "+route)

    ordinary, _verdict, _, _, ordinary_evidence = loop_fixture(
        tmp,"ordinary",candidate_sha)
    continuous(ordinary_evidence,"ordinary")
    print("OWNER_ACCEPTANCE_OBSERVATION=DEFERRED_TO_OWNER_TERMINAL_V7")
    print("OWNER_ACCEPTANCE_REQUIRED=YES")
    owner, verdict, state, done, owner_evidence = loop_fixture(
        tmp,"owner_authority",candidate_sha)
    continuous(owner_evidence,"owner")
    owner_required = "OWNER_ACTION_REQUIRED" in state
    check(verdict == "NOT_OBSERVED" and owner_required and not done, "A_OWNER_ROUTE_REAL_EFFECT",
          f"rc={owner.returncode} verdict={verdict} state={state[-300:]!r}")
    restarted, verdict, state, done, restart_evidence = loop_fixture(
        tmp,"owner_authority",candidate_sha,restart=True)
    continuous(restart_evidence,"restart")
    check(verdict == "NOT_OBSERVED" and "OWNER_ACTION_REQUIRED" in state and not done,
          "A_OWNER_RESTART_REAL_RECONSTRUCTION",
          f"rc={restarted.returncode} verdict={verdict} state={state[-300:]!r}")


def owner_acceptance(candidate_sha: str, artifact: Path) -> int:
    """Candidate-bound owner-terminal subgate over the same normal loop route."""
    if (re.fullmatch(r"[0-9a-f]{40}",candidate_sha) is None
            or not artifact.is_absolute()
            or Path(os.path.normpath(str(artifact)))!=artifact
            or str(artifact).startswith("//") or not artifact.name
            or artifact==ROOT or ROOT in artifact.parents):
        raise Rig("owner acceptance candidate/artifact authority")
    def local_test_author_identity() -> tuple[dict[str,object],bytes,bytes]:
        local_source,_unused=r15_loop_repository_state(candidate_sha)
        scoped,scoped_why=r15_contract_candidate_scope(ROOT,candidate_sha)
        if not scoped:raise Rig("owner acceptance TEST_AUTHOR scope: "+scoped_why)
        authenticated={}
        for relative,local in (("specs/tasks.spec.json",SPEC),
                               ("verify/bin/h-035-exit",Path(__file__))):
            candidate_raw=r15_git_object_bytes(ROOT,candidate_sha,relative)
            if candidate_raw is None or candidate_raw!=local.read_bytes():
                raise Rig("owner acceptance candidate byte mismatch: "+relative)
            authenticated[relative]=candidate_raw
        return (local_source,authenticated["specs/tasks.spec.json"],
                authenticated["verify/bin/h-035-exit"])

    source,candidate_spec_raw,candidate_gate_raw=local_test_author_identity()
    authority_roots=tuple(Path(str(source[key])) for key in (
        "checkout_root","git_dir","common_dir"))
    authority_identity_rows=tuple(source.get(key) for key in (
        "checkout_root_identity","git_dir_identity","common_dir_identity"))
    if not all(isinstance(row,list) and len(row)==9
               and all(type(value) is int for value in row)
               for row in authority_identity_rows):
        raise Rig("owner artifact source identity authority")
    authority_directory_identities={(row[0],row[1])
                                    for row in authority_identity_rows}
    if any(artifact==root or root in artifact.parents for root in authority_roots):
        raise Rig("owner artifact overlaps authenticated source authority")

    directory_flags=(os.O_RDONLY|getattr(os,"O_DIRECTORY",0)
                     |getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0))
    retained=[];links=[]
    try:
        parent_fd=os.open(artifact.anchor,directory_flags);retained.append(parent_fd)
        anchor_info=os.fstat(parent_fd)
        if (anchor_info.st_dev,anchor_info.st_ino) in authority_directory_identities:
            raise Rig("owner artifact overlaps authenticated source physical authority")
        for part in artifact.parts[1:-1]:
            before=os.stat(part,dir_fd=parent_fd,follow_symlinks=False)
            child=os.open(part,directory_flags,dir_fd=parent_fd);retained.append(child)
            opened=os.fstat(child)
            if (not stat.S_ISDIR(opened.st_mode)
                    or (before.st_dev,before.st_ino,before.st_mode)
                    !=(opened.st_dev,opened.st_ino,opened.st_mode)):
                raise Rig("owner artifact ancestor substitution")
            if (opened.st_dev,opened.st_ino) in authority_directory_identities:
                raise Rig("owner artifact overlaps authenticated source physical authority")
            links.append((parent_fd,part,child,
                          (opened.st_dev,opened.st_ino,opened.st_mode)))
            parent_fd=child
        try:os.stat(artifact.name,dir_fd=parent_fd,follow_symlinks=False)
        except FileNotFoundError:pass
        else:raise Rig("owner artifact must be absent")

        with tempfile.TemporaryDirectory(prefix="h035-owner-effect-") as raw:
            result, verdict, _state, _done, evidence = loop_fixture(
                Path(raw),"ordinary",candidate_sha,observe=True)
        source_after,spec_after,gate_after=local_test_author_identity()
        if (source_after!=source
                or evidence.get("source_post_cleanup_sha256")!=source["sha256"]
                or spec_after!=candidate_spec_raw or gate_after!=candidate_gate_raw
                ):
            raise Rig("owner acceptance post-fixture candidate continuity")
        record = {
            "acceptance_mode": "H035_OWNER_PROVIDER_EXEC_V7",
            "task": "h-035", "candidate_sha": candidate_sha,
            "gate_sha256": hashlib.sha256(candidate_gate_raw).hexdigest(),
            "spec_sha256": hashlib.sha256(candidate_spec_raw).hexdigest(),
            "normal_entrypoint": "controller/loop/cli run",
            "observer": "H035_OWNER_PROVIDER_EXEC_V7 exact-argv, H036-supervisor and loop-image-bound normal-ancestry, unchanged V6 observer-release-coupled lifetime",
            "observer_version": 7,
            "candidate_bound_attempts": 1,
            "observer_verdict": verdict,
            "provider_process_execution_observed": verdict == "PASS",
            "raw_process_evidence": evidence,
            "loop_exit": result.returncode,
        }
        raw_record=(json.dumps(record,sort_keys=True,indent=2)+"\n").encode()
        for retained_parent,part,child,want in links:
            linked=os.stat(part,dir_fd=retained_parent,follow_symlinks=False)
            opened=os.fstat(child)
            if ((linked.st_dev,linked.st_ino,linked.st_mode)!=want
                    or (opened.st_dev,opened.st_ino,opened.st_mode)!=want):
                raise Rig("owner artifact ancestor changed before create")
        descriptor=os.open(
            artifact.name,os.O_WRONLY|os.O_CREAT|os.O_EXCL
            |getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0),0o600,
            dir_fd=parent_fd)
        try:
            os.fchmod(descriptor,0o600);offset=0
            while offset<len(raw_record):
                written=os.write(descriptor,raw_record[offset:])
                if written<=0:raise Rig("owner artifact short write")
                offset+=written
            os.fsync(descriptor);opened=os.fstat(descriptor)
            linked=os.stat(artifact.name,dir_fd=parent_fd,follow_symlinks=False)
            fields=("st_dev","st_ino","st_mode","st_uid","st_gid","st_nlink",
                    "st_size","st_mtime_ns","st_ctime_ns")
            artifact_identity=tuple(getattr(opened,key) for key in fields)
            if (artifact_identity!=tuple(getattr(linked,key) for key in fields)
                    or not stat.S_ISREG(opened.st_mode) or opened.st_uid!=os.getuid()
                    or opened.st_nlink!=1 or stat.S_IMODE(opened.st_mode)!=0o600
                    or opened.st_size!=len(raw_record)):
                raise Rig("owner artifact post-create identity")
        finally:os.close(descriptor)
        os.fsync(parent_fd)
        final_source,final_spec,final_gate=local_test_author_identity()
        if (final_source!=source or final_spec!=candidate_spec_raw
                or final_gate!=candidate_gate_raw):
            raise Rig("owner artifact creation changed source authority")
        for retained_parent,part,child,want in links:
            linked=os.stat(part,dir_fd=retained_parent,follow_symlinks=False)
            opened=os.fstat(child)
            if ((linked.st_dev,linked.st_ino,linked.st_mode)!=want
                    or (opened.st_dev,opened.st_ino,opened.st_mode)!=want):
                raise Rig("owner artifact ancestor changed after create")
        final_leaf=os.stat(artifact.name,dir_fd=parent_fd,follow_symlinks=False)
        final_path=os.lstat(artifact)
        if (tuple(getattr(final_leaf,key) for key in fields)!=artifact_identity
                or tuple(getattr(final_path,key) for key in fields)!=artifact_identity):
            raise Rig("owner artifact path changed after create")
        print(json.dumps(record, sort_keys=True))
        return {"PASS":0, "FAIL":1, "ODÖMBART":2}.get(verdict, 2)
    finally:
        for descriptor in reversed(retained):os.close(descriptor)


def authority_call(tmp: Path, command: str, request: dict[str, object]) -> tuple[int, dict[str, object], str]:
    if not AUTH.is_file(): return 127, {}, f"missing operational entrypoint {AUTH}"
    # Gate-owned operational probes must not dirty the immutable candidate.
    # RV-02 separately removes these controls when judging normal taskval and
    # policy production execution, so this harness hygiene cannot mask it.
    env = os.environ.copy(); env["PYTHONDONTWRITEBYTECODE"] = "1"
    p = run([str(AUTH), command], cwd=tmp, env=env, stdin=json.dumps(request))
    try: out = json.loads(p.stdout)
    except ValueError: out = {}
    return p.returncode, out, (p.stderr or p.stdout)[-500:]


def filesystem_snapshot(root: Path, *, exclude_top: set[str] | None = None) -> dict[str, str]:
    """Logical byte/type snapshot without following symlinks.

    The root, empty directories, symlink targets and filesystem object types
    are material.  Mode and ownership are included because content alone is
    insufficient to restore an executable or equally owned projection.
    Timestamps are excluded: merely reading the snapshot can update atime.
    """
    snapshot: dict[str, str] = {}
    excluded = exclude_top or set()

    def visit(item: Path, name: str) -> None:
        try:
            info = os.lstat(item)
        except FileNotFoundError:
            snapshot[name] = "ABSENT"
            return
        metadata = (f"mode={stat.S_IMODE(info.st_mode):04o}:uid={info.st_uid}:gid={info.st_gid}"
                    f":dev={info.st_dev}:ino={info.st_ino}:nlink={info.st_nlink}")
        if stat.S_ISLNK(info.st_mode):
            snapshot[name] = f"L:{metadata}:target={os.readlink(item)}"
        elif stat.S_ISDIR(info.st_mode):
            snapshot[name] = f"D:{metadata}"
            with os.scandir(item) as entries:
                children = sorted(entries, key=lambda candidate: candidate.name)
            for entry in children:
                if name == "." and entry.name in excluded:
                    continue
                child_name = entry.name if name == "." else f"{name}/{entry.name}"
                visit(Path(entry.path), child_name)
        elif stat.S_ISREG(info.st_mode):
            cache_key=(str(item),info.st_dev,info.st_ino,info.st_size,
                       info.st_mtime_ns,info.st_ctime_ns)
            digest=R15_SNAPSHOT_DIGEST_CACHE.get(cache_key)
            if digest is None:
                digest=hashlib.sha256(item.read_bytes()).hexdigest()
                R15_SNAPSHOT_DIGEST_CACHE[cache_key]=digest
            snapshot[name] = f"F:{metadata}:size={info.st_size}:sha256={digest}"
        else:
            snapshot[name] = f"OTHER:{stat.S_IFMT(info.st_mode):o}:{metadata}:size={info.st_size}"

    visit(root, ".")
    return snapshot


def repository_snapshot(repo: Path) -> dict[str, str]:
    """All repository-local filesystem bytes/types outside Git metadata."""
    return filesystem_snapshot(repo, exclude_top={".git"})


def r15_repository_authority_snapshot(repo: Path, remote: Path | None = None) -> dict[str,object]:
    """Physical checkout plus decision-relevant local/common Git metadata."""
    result: dict[str,object]={"worktree":repository_snapshot(repo)}
    dot_git=repo/".git"
    try:
        info=os.lstat(dot_git)
        result["dot_git"]=(stat.S_IFMT(info.st_mode),stat.S_IMODE(info.st_mode),
                           info.st_uid,info.st_dev,info.st_ino,info.st_nlink,
                           os.readlink(dot_git) if stat.S_ISLNK(info.st_mode) else
                           (dot_git.read_bytes() if stat.S_ISREG(info.st_mode) else None))
    except OSError as exc:
        result["dot_git"]=("ERROR",str(exc))
    derived=[]
    for command in ("--absolute-git-dir","--git-common-dir"):
        observed=r15_git(repo,"rev-parse",command)
        if observed.returncode: derived.append((command,"ERROR",observed.stderr)); continue
        path=Path(observed.stdout.strip())
        if not path.is_absolute(): path=repo/path
        try: path=path.resolve(strict=True)
        except OSError as exc: derived.append((command,"ERROR",str(exc))); continue
        entries={}
        for relative in ("config","config.worktree","HEAD","index","packed-refs","shallow",
                         "info","objects","refs","logs","hooks"):
            entries[relative]=filesystem_snapshot(path/relative)
        derived.append((command,str(path),entries))
    result["git_metadata"]=derived
    result["head"]=r15_git(repo,"rev-parse","--verify","HEAD").stdout.strip()
    result["replace_refs"]=r15_git(repo,"for-each-ref","--format=%(refname) %(objectname)",
                                    "refs/replace").stdout
    if remote is not None:
        result["remote_refs"]=remote_refs(remote)
        result["remote_full"]=filesystem_snapshot(remote)
    return result


def snapshot_delta(before: dict[str, str], after: dict[str, str]) -> list[str]:
    return sorted(name for name in set(before) | set(after)
                  if before.get(name) != after.get(name))


def snapshot_selftests() -> None:
    """Mutate disposable objects to prove cleanup/type drift cannot collide."""
    with tempfile.TemporaryDirectory(prefix="h035-snapshot-selftest-") as raw:
        root = Path(raw) / "projection"; root.mkdir()
        empty = root / "state.db"; empty.mkdir()
        payload = root / "events.jsonl"; payload.write_bytes(b"event\n")
        link = root / "current"; link.symlink_to("events.jsonl")
        baseline = filesystem_snapshot(root)
        payload_info=os.lstat(payload)
        check(r15_json_equal(r15_leaf_state(payload),{
                  "dev":payload_info.st_dev,"ino":payload_info.st_ino,
                  "mode":payload_info.st_mode,"uid":payload_info.st_uid,
                  "gid":payload_info.st_gid,"nlink":payload_info.st_nlink,
                  "size":payload_info.st_size,
                  "sha256":hashlib.sha256(payload.read_bytes()).hexdigest()}),
              "J_R15_GLOBAL_LEAF_STATE_EXACT_REGULAR_PROJECTION")

        empty.rmdir()
        deleted = filesystem_snapshot(root)
        check(snapshot_delta(baseline, deleted) == [".", "state.db"],
              "J_SNAPSHOT_CLEANUP_MUTANT_EMPTY_DIRECTORY_DELETION_REJECTS",
              repr(snapshot_delta(baseline, deleted)))

        empty.write_bytes(b"")
        changed_type = filesystem_snapshot(root)
        check(snapshot_delta(baseline, changed_type) == ["state.db"],
              "J_SNAPSHOT_DIRECTORY_TO_FILE_REJECTS",
              repr(snapshot_delta(baseline, changed_type)))

        empty.unlink(); empty.mkdir()
        link_baseline = filesystem_snapshot(root)
        link.unlink(); link.symlink_to("state.db")
        changed_link = filesystem_snapshot(root)
        check(snapshot_delta(link_baseline, changed_link) == ["current"],
              "J_SNAPSHOT_SYMLINK_TARGET_REJECTS",
              repr(snapshot_delta(link_baseline, changed_link)))

        link.unlink(); link.symlink_to("events.jsonl")
        mode_baseline = filesystem_snapshot(root)
        payload.chmod(0o600)
        changed_mode = filesystem_snapshot(root)
        check(snapshot_delta(mode_baseline, changed_mode) == ["events.jsonl"],
              "J_SNAPSHOT_MODE_CHANGE_REJECTS",
              repr(snapshot_delta(mode_baseline, changed_mode)))


def ordinary_python_env() -> dict[str, str]:
    """Normal execution: do not let the outer gate hide bytecode writes."""
    env = os.environ.copy()
    env.pop("PYTHONDONTWRITEBYTECODE", None)
    env.pop("PYTHONPYCACHEPREFIX", None)
    return env


def remote_refs(remote: Path) -> str:
    p = run(["git", "for-each-ref", "--format=%(refname) %(objectname)"], cwd=remote)
    if p.returncode: raise Rig(p.stderr)
    return p.stdout


def persisted_state(state_dir: Path) -> str:
    texts = []
    if state_dir.exists():
        for item in sorted(state_dir.rglob("*")):
            if item.is_file(): texts.append(item.read_text(errors="replace"))
    return "\n".join(texts)


def expect_auth(tmp: Path, name: str, command: str, request: dict[str, object], accepted: bool,
                *, state_after: str | None = None, state_changes: bool | None = None,
                workspace_changes: bool | None = None, refs_change: bool | None = None,
                **diagnostics: object) -> None:
    state_dir = Path(str(request["state_dir"])); workspace = Path(str(request["workspace_root"]))
    remote = Path(str(request["remote"]))
    before_state = filesystem_snapshot(state_dir)
    before_ws = filesystem_snapshot(workspace)
    before_refs = remote_refs(remote)
    rc, out, detail = authority_call(tmp, command, request)
    ok = ((rc == 0) == accepted) and out.get("accepted") is accepted
    after_state = filesystem_snapshot(state_dir)
    after_ws = filesystem_snapshot(workspace)
    after_refs = remote_refs(remote)
    for key, value in diagnostics.items(): ok = ok and out.get(key) == value
    if state_after is not None: ok = ok and state_after in persisted_state(state_dir)
    if state_changes is not None: ok = ok and ((before_state != after_state) is state_changes)
    if workspace_changes is not None: ok = ok and ((before_ws != after_ws) is workspace_changes)
    if refs_change is not None: ok = ok and ((before_refs != after_refs) is refs_change)
    check(ok, name, detail or repr(out))


def r14_product_diff_scope(repo: Path, base: str, candidate_sha: str) -> tuple[bool, str]:
    """Bind the separately reviewed R14 product to one core-only commit."""
    if (re.fullmatch(r"[0-9a-f]{40}", base) is None
            or re.fullmatch(r"[0-9a-f]{40}", candidate_sha) is None):
        return False, "base/candidate must be exact lowercase commit identities"
    for identity in (base, candidate_sha):
        resolved = git(repo, "rev-parse", "--verify", "--quiet", f"{identity}^{{commit}}")
        if resolved.returncode or resolved.stdout.strip() != identity:
            return False, f"unknown exact commit {identity}"
    parents = git(repo, "rev-list", "--parents", "-n", "1", candidate_sha)
    if parents.returncode or parents.stdout.split() != [candidate_sha, base]:
        return False, "candidate must have exactly the reviewed base as its single parent"
    changed = git(repo, "diff", "--name-only", "--no-renames", base, candidate_sha)
    if changed.returncode:
        return False, "cannot derive exact product Git diff"
    files = changed.stdout.splitlines()
    if files != ["controller/authority/core.py"]:
        return False, f"product changed set is not exact core-only: {files!r}"
    return True, "exact single-parent core-only product diff"


def r14_product_identity(base: str, candidate_sha: str) -> tuple[bool, str]:
    ok, why = r14_product_diff_scope(ROOT, base, candidate_sha)
    if not ok:
        return ok, why
    head = git(ROOT, "rev-parse", "HEAD")
    if head.returncode or head.stdout.strip() != candidate_sha:
        return False, "checked-out HEAD is not the exact product candidate"
    status = git(ROOT, "status", "--porcelain=v1", "--untracked-files=all")
    if status.returncode or status.stdout:
        return False, "product acceptance requires a clean immutable checkout"
    for relative, local in (("specs/tasks.spec.json", SPEC),
                            ("verify/bin/h-035-exit", Path(__file__))):
        raw = git_object_bytes(ROOT, candidate_sha, relative)
        if raw is None or raw != local.read_bytes():
            return False, f"candidate contract bytes mismatch: {relative}"
    return True, "clean exact candidate, contract bytes, and core-only diff bound"


def r33_exact_git_names(repo: Path,base: str,candidate_sha: str) -> tuple[list[str] | None,str]:
    result=subprocess.run(
        ["git","-C",str(repo),"diff","--name-only","-z","--no-renames",
         "--no-ext-diff","--no-textconv",base,candidate_sha],
        capture_output=True,shell=False,check=False)
    if result.returncode:return None,"cannot derive exact NUL-delimited Git diff"
    raw=result.stdout
    if not raw:return [],"exact empty Git diff"
    if not raw.endswith(b"\0"):return None,"unterminated nonempty Git diff"
    try:files=[value.decode("utf-8",errors="strict") for value in raw[:-1].split(b"\0")]
    except UnicodeDecodeError:return None,"Git changed path is not strict UTF-8"
    if any(not value for value in files) or len(files)!=len(set(files)):
        return None,"empty or duplicate exact Git changed path"
    return files,"exact NUL-delimited strict UTF-8 Git changed paths"


def r33_product_diff_scope(repo: Path,base: str,candidate_sha: str) -> tuple[bool,str]:
    if (re.fullmatch(r"[0-9a-f]{40}",base) is None
            or re.fullmatch(r"[0-9a-f]{40}",candidate_sha) is None):
        return False,"base/candidate must be exact lowercase commit identities"
    for identity in (base,candidate_sha):
        resolved=git(repo,"rev-parse","--verify","--quiet",f"{identity}^{{commit}}")
        if resolved.returncode or resolved.stdout.strip()!=identity:
            return False,f"unknown exact commit {identity}"
    parents=git(repo,"rev-list","--parents","-n","1",candidate_sha)
    if parents.returncode or parents.stdout.split()!=[candidate_sha,base]:
        return False,"candidate must have exactly the reviewed R33 base as single parent"
    files,why=r33_exact_git_names(repo,base,candidate_sha)
    expected=sorted(H035_R33_REQUEST_BOUND_REGISTRY["builder_actual_changed_files"])
    if files!=expected:return False,f"R33 product changed set is not exact two-file scope: {files!r} | {why}"
    tree=git(repo,"--literal-pathspecs","ls-tree",candidate_sha,"--",*expected)
    observed={}
    for line in tree.stdout.splitlines():
        fields=line.split(None,3)
        if len(fields)==4:observed[fields[3]]=(fields[0],fields[1])
    wanted={"controller/authority/core.py":("100644","blob"),
            "controller/authority/cli":("100755","blob")}
    if tree.returncode or observed!=wanted:return False,"R33 exact product modes/types"
    return True,"exact direct-child core-and-CLI product diff"


def r33_product_identity(base: str,candidate_sha: str) -> tuple[bool,str]:
    ok,why=r33_product_diff_scope(ROOT,base,candidate_sha)
    if not ok:return ok,why
    head=git(ROOT,"rev-parse","HEAD")
    if head.returncode or head.stdout.strip()!=candidate_sha:
        return False,"checked-out HEAD is not the exact R33 product candidate"
    status=git(ROOT,"status","--porcelain=v1","--untracked-files=all")
    if status.returncode or status.stdout:
        return False,"R33 product acceptance requires clean immutable checkout"
    for relative,local in (("specs/tasks.spec.json",SPEC),
                           ("verify/bin/h-035-exit",Path(__file__))):
        raw=git_object_bytes(ROOT,candidate_sha,relative)
        base_raw=git_object_bytes(ROOT,base,relative)
        if raw is None or base_raw is None or raw!=base_raw or raw!=local.read_bytes():
            return False,f"R33 candidate frozen contract bytes mismatch: {relative}"
    return True,"clean exact R33 candidate, frozen contract, core-and-CLI diff bound"


def r33_test_author_identity() -> tuple[bool,str]:
    base=str(H035_R33_REQUEST_BOUND_REGISTRY["preproduct_evidence"]["base_sha"])
    expected=sorted(H035_R33_REQUEST_BOUND_REGISTRY["test_author_allowed_write"])
    head=git(ROOT,"rev-parse","--verify","HEAD^{commit}")
    if head.returncode or re.fullmatch(r"[0-9a-f]{40}",head.stdout.strip()) is None:
        return False,"R33 exact candidate HEAD"
    candidate_sha=head.stdout.strip()
    parents=git(ROOT,"rev-list","--parents","-n","1",candidate_sha)
    if parents.returncode or parents.stdout.split()!=[candidate_sha,base]:
        return False,"R33 candidate must be direct child of published ff375 authority"
    files,why=r33_exact_git_names(ROOT,base,candidate_sha)
    if files!=expected:return False,"R33 candidate does not change exact six TEST_AUTHOR files: "+why
    states=git(ROOT,"diff","--name-status","--no-renames","--no-ext-diff",
               "--no-textconv",base,candidate_sha)
    if states.returncode or states.stdout.splitlines()!=[f"M\t{path}" for path in expected]:
        return False,"R33 candidate contains add/delete/rename/type substitution"
    tree=git(ROOT,"--literal-pathspecs","ls-tree",candidate_sha,"--",*expected)
    observed={}
    for line in tree.stdout.splitlines():
        fields=line.split(None,3)
        if len(fields)==4:observed[fields[3]]=(fields[0],fields[1])
    wanted={path:("100755" if path=="verify/bin/h-035-exit" else "100644","blob")
            for path in expected}
    if tree.returncode or observed!=wanted:return False,"R33 exact six path modes/types"
    status=git(ROOT,"status","--porcelain=v1","--untracked-files=all")
    if status.returncode or status.stdout:return False,"R33 contract checkout not clean"
    for path in ("specs/owner-production-paths.v1.json","controller/authority/core.py",
                 "controller/authority/cli"):
        if git_object_bytes(ROOT,base,path)!=git_object_bytes(ROOT,candidate_sha,path):
            return False,"R33 contract mutated frozen registry/product path: "+path
    return True,"clean exact direct-child six-file R33 TEST_AUTHOR candidate"


def r29_test_author_identity() -> tuple[bool,str]:
    base=str(H035_R29_THREE_STATE_REGISTRY["preproduct_evidence"]["base_sha"])
    expected=tuple(sorted(H035_R29_THREE_STATE_REGISTRY[
        "test_author_allowed_write"]))
    head=git(ROOT,"rev-parse","--verify","HEAD^{commit}")
    if head.returncode or re.fullmatch(r"[0-9a-f]{40}",head.stdout.strip()) is None:
        return False,"R29 exact candidate HEAD"
    candidate_sha=head.stdout.strip()
    parents=git(ROOT,"rev-list","--parents","-n","1",candidate_sha)
    if parents.returncode or parents.stdout.split()!=[candidate_sha,base]:
        return False,"R29 candidate must be direct child of exact c161 authority"
    names=git(ROOT,"diff","--name-only","--no-renames","--no-ext-diff",
              "--no-textconv",base,candidate_sha)
    states=git(ROOT,"diff","--name-status","--no-renames","--no-ext-diff",
               "--no-textconv",base,candidate_sha)
    if names.returncode or tuple(names.stdout.splitlines())!=expected:
        return False,"R29 candidate does not change exact six TEST_AUTHOR files"
    if states.returncode or states.stdout.splitlines()!=[f"M\t{path}" for path in expected]:
        return False,"R29 candidate contains add/delete/rename/type substitution"
    tree=git(ROOT,"--literal-pathspecs","ls-tree",candidate_sha,"--",*expected)
    observed={}
    for line in tree.stdout.splitlines():
        fields=line.split(None,3)
        if len(fields)==4:observed[fields[3]]=(fields[0],fields[1])
    wanted={path:(("100755" if path=="verify/bin/h-035-exit" else "100644"),
                  "blob") for path in expected}
    if tree.returncode or observed!=wanted:
        return False,"R29 exact six path modes/types"
    status=git(ROOT,"status","--porcelain=v1","--untracked-files=all")
    if status.returncode or status.stdout:
        return False,"R29 contract acceptance requires clean immutable checkout"
    if git_object_bytes(ROOT,base,"specs/owner-production-paths.v1.json") \
            !=git_object_bytes(ROOT,candidate_sha,
                               "specs/owner-production-paths.v1.json"):
        return False,"R29 contract may not mutate registry"
    return True,"clean exact direct-child six-file R29 TEST_AUTHOR candidate"


def r14_product_scope_selftests(tmp: Path) -> None:
    repo = tmp / "r14-product-scope"; init_repo(repo)
    core = repo / "controller/authority/core.py"
    core.parent.mkdir(parents=True); core.write_text("base core\n")
    base = commit_paths(repo, "r14 product base", "controller/authority/core.py")
    good = candidate(repo, base, "controller/authority/core.py", 1410)
    good_ok = r14_product_diff_scope(repo, base, good)[0]

    checkout = git(repo, "checkout", "-q", base)
    if checkout.returncode: raise Rig(checkout.stderr)
    core.write_text("mutated core\n")
    cli = repo / "controller/authority/cli"; cli.write_text("out of scope\n")
    out_of_scope = commit_paths(repo, "r14 forbidden second product file",
                                "controller/authority/core.py", "controller/authority/cli")
    outside_ok = r14_product_diff_scope(repo, base, out_of_scope)[0]

    safe_only = candidate(repo, base, "safe/not-core.txt", 1411)
    safe_ok = r14_product_diff_scope(repo, base, safe_only)[0]
    stacked = candidate(repo, good, "controller/authority/core.py", 1412)
    stacked_ok = r14_product_diff_scope(repo, base, stacked)[0]
    check(good_ok and not outside_ok and not safe_ok and not stacked_ok,
          "J_R14_PRODUCT_EXACT_BASE_CANDIDATE_CORE_ONLY_DIFF_AND_OUT_OF_SCOPE_MUTANT")


def r33_product_scope_selftests(tmp: Path) -> None:
    repo=tmp/"r33-product-scope";init_repo(repo)
    core=repo/"controller/authority/core.py";cli=repo/"controller/authority/cli"
    core.parent.mkdir(parents=True);core.write_text("base core\n")
    cli.write_text("#!/bin/sh\nexit 1\n");cli.chmod(0o755)
    base=commit_paths(repo,"R33 product base","controller/authority/core.py",
                      "controller/authority/cli")
    core.write_text("product core\n");cli.write_text("#!/bin/sh\nexit 0\n");cli.chmod(0o755)
    good=commit_paths(repo,"R33 exact two-file product","controller/authority/core.py",
                      "controller/authority/cli")
    good_ok=r33_product_diff_scope(repo,base,good)[0]
    core_only=candidate(repo,base,"controller/authority/core.py",3001)
    cli_only=candidate(repo,base,"controller/authority/cli",3002)
    checkout=git(repo,"checkout","-q",base)
    if checkout.returncode:raise Rig(checkout.stderr)
    core.write_text("third core\n");cli.write_text("#!/bin/sh\nexit 0\n");cli.chmod(0o755)
    third=repo/"safe/third";third.parent.mkdir();third.write_text("third\n")
    third_sha=commit_paths(repo,"R33 forbidden third path","controller/authority/core.py",
                           "controller/authority/cli","safe/third")
    stacked=candidate(repo,good,"controller/authority/core.py",3003)
    check(good_ok and not r33_product_diff_scope(repo,base,core_only)[0]
          and not r33_product_diff_scope(repo,base,cli_only)[0]
          and not r33_product_diff_scope(repo,base,third_sha)[0]
          and not r33_product_diff_scope(repo,base,stacked)[0],
          "J_R33_PRODUCT_EXACT_TWO_FILE_CORE_CLI_AND_SINGLE_PARENT_SCOPE")


def r33_reference_sources(base_raw: dict[str,bytes]) -> dict[str,bytes] | None:
    paths=("controller/authority/core.py","controller/authority/cli")
    if any(path not in base_raw for path in paths):
        return None
    def exact_replacements(raw: bytes,
                           replacements: list[tuple[bytes,bytes]]) -> bytes | None:
        for old,new in replacements:
            if raw.count(old)!=1:
                return None
            raw=raw.replace(old,new,1)
        return raw
    core=exact_replacements(base_raw[paths[0]],[
        (b'    "config/python-runtime-authority-v2.json",\n'
         b'}\n\n\nclass AuthorityError',
         b'    "config/python-runtime-authority-v2.json",\n'
         b'}\n'
         b'RUNTIME_CLEANUP_OWNER_PATHS = {\n'
         b'    "controller/runtime-cleanup/install",\n'
         b'    "controller/runtime-cleanup/native/mediator.c",\n'
         b'    "verify/h039/runtime-cleanup-mediator",\n'
         b'    "verify/h039/build-recipe.json",\n'
         b'    "verify/h039/identity-manifest.json",\n'
         b'}\n'
         b'OWNER_PATHS_BY_VERSION = {\n'
         b'    1: REQUIRED_OWNER_PATHS,\n'
         b'    2: PROSPECTIVE_OWNER_PATHS,\n'
         b'    3: PROSPECTIVE_OWNER_PATHS | RUNTIME_CLEANUP_OWNER_PATHS,\n'
         b'}\n\n\nclass AuthorityError'),
        (b'    if type(version) is not int or version not in (1, 2):\n',
         b'    if type(version) is not int or version not in OWNER_PATHS_BY_VERSION:\n'),
        (b'    required_owner_paths = (REQUIRED_OWNER_PATHS if version == 1\n'
         b'                            else PROSPECTIVE_OWNER_PATHS)\n',
         b'    required_owner_paths = OWNER_PATHS_BY_VERSION[version]\n'),
        (b'def changed_files(repo: Path, base: str, candidate: str) -> list[str]:\n'
         b'    exact_commit(repo, base)\n'
         b'    exact_commit(repo, candidate)\n'
         b'    result = git(repo, "diff", "--name-only", "--no-renames", base, candidate)\n'
         b'    if result.returncode:\n'
         b'        raise AuthorityError(f"cannot derive Git changed files: {result.stderr.strip()}")\n'
         b'    files = [canonical_path(line) for line in result.stdout.splitlines() if line]\n'
         b'    if len(files) != len(set(files)):\n'
         b'        raise AuthorityError("duplicate changed path")\n'
         b'    return files\n',
         b'def changed_files(repo: Path, base: str, candidate: str) -> list[str]:\n'
         b'    exact_commit(repo, base)\n'
         b'    exact_commit(repo, candidate)\n'
         b'    result = subprocess.run(\n'
         b'        ["git", "-C", str(repo), "diff", "--name-only", "--no-renames", "-z",\n'
         b'         base, candidate],\n'
         b'        capture_output=True, shell=False, check=False,\n'
         b'    )\n'
         b'    if result.returncode:\n'
         b'        detail = result.stderr.decode("utf-8", errors="replace").strip()\n'
         b'        raise AuthorityError(f"cannot derive Git changed files: {detail}")\n'
         b'    if result.stdout and not result.stdout.endswith(b"\\x00"):\n'
         b'        raise AuthorityError("malformed NUL-delimited Git changed files")\n'
         b'    raw_paths = result.stdout[:-1].split(b"\\x00") if result.stdout else []\n'
         b'    if any(not raw_path for raw_path in raw_paths):\n'
         b'        raise AuthorityError("malformed NUL-delimited Git changed files")\n'
         b'    try:\n'
         b'        files = [canonical_path(raw_path.decode("utf-8", errors="strict"))\n'
         b'                 for raw_path in raw_paths]\n'
         b'    except UnicodeDecodeError as exc:\n'
         b'        raise AuthorityError("Git changed path is not UTF-8") from exc\n'
         b'    if len(files) != len(set(files)):\n'
         b'        raise AuthorityError("duplicate changed path")\n'
         b'    return files\n'),
        (b'\n\ndef task_authority(spec: object, task_id: str)',
         b'\n\ndef validate_owner_surface(surface: Iterable[object], registry: dict[str, object]) -> None:\n'
         b'    if any(overlaps(item, guard) for item in surface for guard in registry["owner_author_global_denied_paths"]):\n'
         b'        raise AuthorityError("owner surface overlaps global deny")\n'
         b'    if any(not permitted(item, registry["owner_production_paths"]) for item in surface):\n'
         b'        raise AuthorityError("owner surface outside owner production")\n'
         b'\n\ndef task_authority(spec: object, task_id: str)'),
    ])
    cli=exact_replacements(base_raw[paths[1]],[
        (b'                  task_authority, validate_registry)\n',
         b'                  task_authority, validate_registry, validate_owner_surface)\n'),
        (b'    if authority == "owner_authority":\n'
         b'        if any(overlaps(item, guard) for item in surface\n'
         b'               for guard in registry["owner_author_global_denied_paths"]):\n'
         b'            raise AuthorityError("owner surface overlaps global deny")\n'
         b'        if any(not permitted(item, registry["owner_production_paths"]) for item in surface):\n'
         b'            raise AuthorityError("owner surface outside owner production")\n',
         b'    if authority == "owner_authority":\n'
         b'        validate_owner_surface(surface, registry)\n'),
        (b'        if any(overlaps(item, guard) for item in files\n'
         b'               for guard in registry["owner_author_global_denied_paths"]):\n'
         b'            raise AuthorityError("owner candidate changed global deny")\n'
         b'        if any(overlaps(item, gate_path) for item in files):\n',
         b'        if any(overlaps(item, guard) for item in files\n'
         b'               for guard in registry["owner_author_global_denied_paths"]):\n'
         b'            raise AuthorityError("owner candidate changed global deny")\n'
         b'        validate_owner_surface(surface, registry)\n'
         b'        if any(overlaps(item, gate_path) for item in files):\n'),
        (b'    repo, candidate, spec_raw, spec, registry_raw, _registry = authority_documents(req)\n',
         b'    repo, candidate, spec_raw, spec, registry_raw, registry = authority_documents(req)\n'),
        (b'    task, authority, _surface = task_authority(spec, task_id)\n',
         b'    task, authority, surface = task_authority(spec, task_id)\n'),
        (b'    if authority != "owner_authority":\n'
         b'        raise AuthorityError("owner transition requires canonical owner task")\n'
         b'    base = exact_commit(repo, req.get("base_sha"))\n',
         b'    if authority != "owner_authority":\n'
         b'        raise AuthorityError("owner transition requires canonical owner task")\n'
         b'    validate_owner_surface(surface, registry)\n'
         b'    base = exact_commit(repo, req.get("base_sha"))\n'),
    ])
    if core is None or cli is None:
        return None
    return {paths[0]:core,paths[1]:cli}


def r33_source_structure(base_raw: dict[str,bytes],candidate_raw: dict[str,bytes]
                         ) -> tuple[bool,str,dict[str,ast.Module] | None]:
    paths=("controller/authority/core.py","controller/authority/cli")
    expected_raw=r33_reference_sources(base_raw)
    if expected_raw is None:
        return False,"R33 exact reference cannot derive from frozen base",None
    preambles=H035_R33_REQUEST_BOUND_REGISTRY["product_acceptance"][
        "interpreter_sensitive_preamble"]
    for path in paths:
        row=preambles.get(path) if isinstance(preambles,dict) else None
        if (not isinstance(row,list) or len(row)!=2
                or not all(isinstance(value,str) for value in row)):
            return False,"R33 interpreter-sensitive preamble contract",None
        prefix="".join(row).encode("utf-8")
        for label,raw in (("base",base_raw.get(path)),
                          ("reference",expected_raw.get(path)),
                          ("candidate",candidate_raw.get(path))):
            if not isinstance(raw,bytes):
                return False,f"R33 {label} preamble source missing: {path}",None
            lines=raw.splitlines(keepends=True)
            if (raw.startswith(b"\xef\xbb\xbf") or len(lines)<2
                    or b"".join(lines[:2])!=prefix
                    or any(not line.endswith(b"\n") or line.endswith(b"\r\n")
                           for line in lines[:2])):
                return False,f"R33 {label} first two physical lines differ: {path}",None
    try:
        base={path:ast.parse(base_raw[path].decode("utf-8",errors="strict"),
                             filename="base "+path) for path in paths}
        candidate={path:ast.parse(candidate_raw[path].decode("utf-8",errors="strict"),
                                  filename="candidate "+path) for path in paths}
        expected={path:ast.parse(expected_raw[path].decode("utf-8",errors="strict"),
                                 filename="expected "+path) for path in paths}
    except (KeyError,UnicodeDecodeError,SyntaxError,ValueError) as exc:
        return False,"R33 product strict Python AST: "+str(exc),None
    for path in paths:
        observed=ast.dump(candidate[path],annotate_fields=True,include_attributes=False)
        wanted=ast.dump(expected[path],annotate_fields=True,include_attributes=False)
        if observed!=wanted:
            return False,"R33 product differs from closed positive reference AST: "+path,None
    core_path,cli_path=paths
    marker=b"\n_r15_loader_root=ROOT\n"
    if (base_raw[cli_path].count(marker)!=1 or candidate_raw[cli_path].count(marker)!=1
            or base_raw[cli_path].split(marker,1)[1]
               !=candidate_raw[cli_path].split(marker,1)[1]):
        return False,"R33 retained R15 CLI suffix is not byte-exact to ff375",None
    return True,"closed positive reference AST and retained R15 route",candidate


def r33_product_source_oracle(repo: Path,base: str,candidate_sha: str) -> tuple[bool,str]:
    paths=("controller/authority/core.py","controller/authority/cli")
    base_raw={path:git_object_bytes(repo,base,path) for path in paths}
    candidate_raw={path:git_object_bytes(repo,candidate_sha,path) for path in paths}
    if any(value is None for value in (*base_raw.values(),*candidate_raw.values())):
        return False,"R33 product source Git object missing"
    ok,why,_trees=r33_source_structure(base_raw,candidate_raw)  # type: ignore[arg-type]
    return ok,why


def r33_source_oracle_selftests() -> None:
    paths=("controller/authority/core.py","controller/authority/cli")
    raw={path:git_object_bytes(ROOT,
        str(H035_R33_REQUEST_BOUND_REGISTRY["preproduct_evidence"]["base_sha"]),path)
        for path in paths}
    if any(value is None for value in raw.values()):
        check(False,"J_R33_CLOSED_POSITIVE_REFERENCE_AST_AND_AMBIENT_MUTANTS_REJECT")
        return
    base={path:value for path,value in raw.items() if value is not None}
    reference=r33_reference_sources(base)
    if reference is None:
        check(False,"J_R33_CLOSED_POSITIVE_REFERENCE_AST_AND_AMBIENT_MUTANTS_REJECT")
        return
    positive=r33_source_structure(base,reference)[0]
    core=reference[paths[0]];cli=reference[paths[1]]
    def mutate(path: str,old: bytes,new: bytes) -> dict[str,bytes]:
        candidate=dict(reference)
        if candidate[path].count(old)!=1:
            return {}
        candidate[path]=candidate[path].replace(old,new,1)
        return candidate
    transition=b"def transition_context(req: dict[str, object]) -> tuple[Path, str, dict[str, object]]:\n"
    transition_call=(b'    if authority != "owner_authority":\n'
        b'        raise AuthorityError("owner transition requires canonical owner task")\n'
        b'    validate_owner_surface(surface, registry)\n')
    mutants=[
        mutate(paths[1],transition,
            b"def transition_context(req: dict[str, object], cache=([],)) -> tuple[Path, str, dict[str, object]]:\n"),
        mutate(paths[1],transition,transition+
            b"    import builtins\n    builtins.setattr(sys.modules[__name__], chr(65), registry)\n"),
        mutate(paths[1],transition,transition+
            b"    import operator\n    operator.setitem(([None],)[0], 0, registry)\n"),
        mutate(paths[1],transition,
            b"def transition_context(req: dict[str, object], cache=([None],)) -> tuple[Path, str, dict[str, object]]:\n"
            b"    list.__iadd__(cache[0], [(req, 1)])\n"),
        mutate(paths[1],transition,transition+
            b"    getattr(sys.modules[__name__], '__dict__')['registry'] = req\n"),
        mutate(paths[1],transition,transition+
            b"    Path('/tmp/r33-ambient').write_text(json.dumps(req))\n"),
        mutate(paths[1],transition,transition+
            b"    def nested():\n        return req\n"),
        mutate(paths[1],transition,transition+
            b"    class Holder:\n        pass\n"),
        mutate(paths[1],transition,transition+
            b"    holder = lambda: req\n"),
        mutate(paths[1],transition,transition+
            b"    if (holder := req):\n        pass\n"),
        mutate(paths[1],
            b"    repo, candidate, spec_raw, spec, registry_raw, registry = authority_documents(req)\n",
            b"    repo, candidate, spec_raw, spec, registry_raw, registry = authority_documents(req)\n"
            b"    registry = dict(registry)\n"),
        mutate(paths[1],transition_call,
            transition_call.replace(b"surface, registry",b"surface, dict(registry)")),
        mutate(paths[1],transition_call,
            transition_call.replace(b"    validate_owner_surface(surface, registry)\n",b"")),
        mutate(paths[0],
            b"def changed_files(repo: Path, base: str, candidate: str) -> list[str]:\n",
            b"def changed_files(repo: Path, base: str, candidate: str, cache=({},)) -> list[str]:\n"),
        mutate(paths[0],
            b"def validate_registry(document: object) -> dict[str, object]:\n",
            b"@staticmethod\ndef validate_registry(document: object) -> dict[str, object]:\n"),
        mutate(paths[1],b"_R15_ATTEST_SHA256=",b"_R15_ATTEST_SHA257="),
        mutate(paths[1],b"def digest(raw: bytes)",b"def digest(raw: bytearray)"),
        mutate(paths[0],b"def parse_path(raw: object)",b"def parse_path(raw: str)"),
    ]
    cli_line_1=b"#!/usr/bin/env python3.12\n"
    cli_line_2=b'"""Operational H-035 authority and owner-transition interface."""\n'
    preamble_mutants=[
        mutate(paths[1],cli_line_1,b"#!/usr/bin/env -S python3.12 -c\n"),
        mutate(paths[1],cli_line_1,b"#!/usr/bin/python3.12\n"),
        mutate(paths[1],cli_line_1,b"#!/usr/bin/env python3.12 -I\n"),
        mutate(paths[1],cli_line_1+cli_line_2,
            cli_line_1+b"# -*- coding: utf-8 -*-\n"+cli_line_2),
        {**reference,paths[0]:b"# coding: utf-8\n"+reference[paths[0]]},
        {**reference,paths[0]:b"# preamble\n# coding: utf-8\n"+reference[paths[0]]},
        {**reference,paths[1]:b"\xef\xbb\xbf"+reference[paths[1]]},
        {**reference,paths[0]:b"\xef\xbb\xbf"+reference[paths[0]]},
    ]
    results=[bool(value) and not r33_source_structure(base,value)[0]
             for value in (*mutants,*preamble_mutants)]
    check(positive and len(mutants)==18 and len(preamble_mutants)==8
          and len(results)==26 and all(results),
          "J_R33_CLOSED_REFERENCE_AST_PREAMBLES_AND_AMBIENT_MUTANTS_REJECT")


def r15_repository_shape(repo: Path) -> tuple[bool, str]:
    config_ok,config_why=r15_local_config_safe(repo)
    if not config_ok: return False,config_why
    try: r15_remote_environment(config_why)
    except Rig as exc: return False,str(exc)
    top = r15_git(repo, "rev-parse", "--show-toplevel")
    git_dir = r15_git(repo, "rev-parse", "--absolute-git-dir")
    common = r15_git(repo, "rev-parse", "--git-common-dir")
    if top.returncode or git_dir.returncode or common.returncode:
        return False, "cannot derive exact repository directories"
    try:
        repo_resolved=repo.resolve(strict=True)
        if Path(top.stdout.strip()).resolve(strict=True) != repo_resolved:
            return False, "repository top-level substitution"
        git_raw=Path(git_dir.stdout.strip())
        if not git_raw.is_absolute(): git_raw=repo/git_raw
        git_path = git_raw.resolve(strict=True)
        common_raw = Path(common.stdout.strip())
        common_unresolved=(common_raw if common_raw.is_absolute() else repo/common_raw)
        common_path = common_unresolved.resolve(strict=True)
    except (OSError, RuntimeError):
        return False, "repository path identity"
    for material,label in ((repo_resolved,"worktree"),(git_raw,"git directory"),
                           (common_unresolved,"common directory")):
        ok,why=r15_nofollow_components(material,leaf_directory=True)
        if not ok: return False,f"{label} {why}"
    dot_git=repo_resolved/".git"
    try: dot_info=os.lstat(dot_git)
    except OSError as exc: return False,f"missing .git identity: {exc}"
    if stat.S_ISDIR(dot_info.st_mode):
        if dot_git.resolve(strict=True) != git_path or git_path != common_path:
            return False,"standalone .git derivation"
    elif stat.S_ISREG(dot_info.st_mode):
        if (dot_info.st_uid != os.getuid() or dot_info.st_nlink != 1
                or stat.S_IMODE(dot_info.st_mode) not in (0o600,0o644)
                or dot_info.st_size > 4096):
            return False,"unsafe linked-worktree .git file"
        try: raw=dot_git.read_text(encoding="utf-8")
        except (OSError,UnicodeError) as exc: return False,f"gitfile read: {exc}"
        if not raw.endswith("\n") or not raw.startswith("gitdir: ") or raw.count("\n") != 1:
            return False,"malformed linked-worktree .git file"
        target=Path(raw[8:-1])
        if not target.is_absolute(): target=repo_resolved/target
        try: target=target.resolve(strict=True)
        except (OSError,RuntimeError): return False,"linked-worktree gitdir target"
        if target != git_path: return False,"linked-worktree gitfile substitution"
    else:
        return False,".git must be a directory or regular gitfile"
    for command, label in (("shallow", "shallow boundary"),
                           ("info/grafts", "graft file"),
                           ("objects/info/alternates", "object alternates")):
        located = r15_git(repo, "rev-parse", "--git-path", command)
        if located.returncode:
            return False, f"cannot derive {label}"
        path = Path(located.stdout.strip())
        if not path.is_absolute(): path = repo / path
        try:
            os.lstat(path)
        except FileNotFoundError:
            pass
        except OSError:
            return False, f"cannot inspect {label}"
        else:
            return False, f"repository has {label}"
    replacements = r15_git(repo, "for-each-ref", "--format=%(refname)", "refs/replace")
    if replacements.returncode or replacements.stdout.strip():
        return False, "repository has replacement refs"
    return True, "closed raw repository and local configuration shape"


def r15_physical_checkout_exact(repo: Path, commit_sha: str) -> tuple[bool, str]:
    def canonical(raw: bytes) -> str:
        value=raw.decode("utf-8",errors="strict")
        normalized=value.replace("\\","/")
        if (normalized != value or not value or value.startswith("/")
                or re.match(r"^[A-Za-z]:",value) or value.startswith("./")
                or value.endswith("/") or "//" in value
                or any(part in ("",".","..") for part in value.split("/"))
                or any(char in value for char in "*?[]{}")):
            raise ValueError("noncanonical checkout path")
        return value
    def rows(raw: bytes) -> list[bytes]:
        parts=raw.split(b"\0")
        if not parts or parts[-1] != b"": raise ValueError("unterminated Git -z output")
        return parts[:-1]
    def meta(value: os.stat_result) -> tuple[int,...]:
        return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_nlink,
                value.st_size,value.st_mtime_ns,value.st_ctime_ns)
    quiet=lambda result:result.stderr==b""
    if not r15_lower_hex(commit_sha,40): return False,"candidate SHA grammar"
    head=r15_git_bytes(repo,"rev-parse","--verify","HEAD")
    status=r15_git_bytes(repo,"status","--porcelain=v1","-z","--untracked-files=all")
    tree=r15_git_bytes(repo,"ls-tree","-r","-z","--full-tree",commit_sha)
    stage=r15_git_bytes(repo,"ls-files","--cached","--stage","-z","--full-name")
    flags=r15_git_bytes(repo,"ls-files","--cached","-v","-z","--full-name")
    if (head.returncode or not quiet(head) or head.stdout != (commit_sha+"\n").encode()
            or status.returncode or not quiet(status) or status.stdout
            or tree.returncode or not quiet(tree) or stage.returncode or not quiet(stage)
            or flags.returncode or not quiet(flags)):
        return False,"closed Git HEAD/status/tree/index observation"
    expected: dict[str,tuple[str,str,bytes]]={}
    expected_dirs:set[str]=set()
    try:
        object_order=[]
        for raw in rows(tree.stdout):
            header,path_raw=raw.split(b"\t",1);fields=header.split(b" ")
            if len(fields)!=3:raise ValueError("tree header")
            mode,kind,oid=(item.decode("ascii") for item in fields);path=canonical(path_raw)
            if path in expected or kind!="blob" or mode not in ("100644","100755") or not r15_lower_hex(oid,40):
                raise ValueError("tree member")
            expected[path]=(mode,oid,b"");object_order.append(oid)
            parts=path.split("/")[:-1]
            for end in range(1,len(parts)+1):expected_dirs.add("/".join(parts[:end]))
        batch=r15_git_bytes(repo,"cat-file","--batch",
                            stdin=b"".join(oid.encode()+b"\n" for oid in object_order))
        if batch.returncode or not quiet(batch):raise ValueError("blob batch read")
        cursor=0;objects={}
        for oid in object_order:
            newline=batch.stdout.find(b"\n",cursor)
            if newline<0:raise ValueError("blob batch header")
            header=batch.stdout[cursor:newline].split(b" ")
            if (len(header)!=3 or header[0]!=oid.encode() or header[1]!=b"blob"
                    or not header[2].isdigit()):raise ValueError("blob batch identity")
            size=int(header[2]);start=newline+1;finish=start+size
            if finish>=len(batch.stdout) or batch.stdout[finish:finish+1]!=b"\n":
                raise ValueError("blob batch extent")
            blob=batch.stdout[start:finish]
            actual_oid=hashlib.sha1(b"blob "+str(len(blob)).encode()+b"\0"+blob).hexdigest()
            if actual_oid!=oid:raise ValueError("blob identity")
            objects[oid]=blob;cursor=finish+1
        if cursor!=len(batch.stdout):raise ValueError("blob batch trailing bytes")
        expected={path:(mode,oid,objects[oid]) for path,(mode,oid,_raw) in expected.items()}
        indexed={}
        for raw in rows(stage.stdout):
            header,path_raw=raw.split(b"\t",1);fields=header.split(b" ")
            if len(fields)!=3:raise ValueError("index header")
            mode,oid,slot=(item.decode("ascii") for item in fields);path=canonical(path_raw)
            if path in indexed or slot!="0" or mode not in ("100644","100755") or not r15_lower_hex(oid,40):
                raise ValueError("index member")
            indexed[path]=(mode,oid)
        if indexed!={path:(value[0],value[1]) for path,value in expected.items()}:
            raise ValueError("tree/index inequality")
        tagged={}
        for raw in rows(flags.stdout):
            if not raw.startswith(b"H "):raise ValueError("index flag")
            path=canonical(raw[2:])
            if path in tagged:raise ValueError("duplicate index flag")
            tagged[path]=True
        if set(tagged)!=set(expected):raise ValueError("index flag inventory")
    except (ValueError,UnicodeError) as exc:
        return False,f"strict physical Git inventory: {exc}"

    directory_flags=(os.O_RDONLY|getattr(os,"O_DIRECTORY",0)
                     |getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0))
    leaf_flags=(os.O_RDONLY|getattr(os,"O_NOFOLLOW",0)
                |getattr(os,"O_CLOEXEC",0)|getattr(os,"O_NONBLOCK",0))
    ancestor_records=[];directory_records={};leaf_records={};opened=[]
    try:
        if not repo.is_absolute() or Path(os.path.normpath(str(repo)))!=repo:
            return False,"noncanonical repository root"
        parent=os.open(repo.anchor,directory_flags);opened.append(parent)
        root_stat=os.fstat(parent);ancestor_records.append((None,"",parent,meta(root_stat)))
        for part in repo.parts[1:]:
            before=os.stat(part,dir_fd=parent,follow_symlinks=False)
            child=os.open(part,directory_flags,dir_fd=parent);opened.append(child);after=os.fstat(child)
            if meta(before)!=meta(after) or not stat.S_ISDIR(after.st_mode):
                return False,"repository ancestor open race"
            ancestor_records.append((parent,part,child,meta(after)));parent=child
        root_fd=parent;root_identity=meta(os.fstat(root_fd))
        if (os.fstat(root_fd).st_uid!=os.getuid()
                or stat.S_IMODE(os.fstat(root_fd).st_mode)!=0o755):
            return False,"repository root uid/mode"
        directory_records[""]=(root_fd,root_identity,None,"",None)
        stack=[""]
        while stack:
            prefix=stack.pop();descriptor=directory_records[prefix][0]
            names=os.listdir(descriptor);encoded=[]
            for name in names:
                name.encode("utf-8",errors="strict")
                if not name or "/" in name or name in (".",".."):raise ValueError("directory member")
                encoded.append(name)
            if len(encoded)!=len(set(encoded)):raise ValueError("directory duplicate")
            visible=set(names)-({".git"} if prefix=="" else set())
            wanted_children={path.split("/")[len(prefix.split("/")) if prefix else 0]
                             for path in set(expected)|expected_dirs
                             if (not prefix and "/" not in path or prefix and path.startswith(prefix+"/")
                                 and "/" not in path[len(prefix)+1:])}
            if visible!=wanted_children:raise ValueError("directory inventory")
            directory_records[prefix]=(descriptor,directory_records[prefix][1],
                                       directory_records[prefix][2],directory_records[prefix][3],frozenset(names))
            for name in sorted(visible):
                relative=name if not prefix else prefix+"/"+name
                before=os.stat(name,dir_fd=descriptor,follow_symlinks=False)
                if relative in expected_dirs:
                    child=os.open(name,directory_flags,dir_fd=descriptor);opened.append(child);after=os.fstat(child)
                    if (meta(before)!=meta(after) or not stat.S_ISDIR(after.st_mode)
                            or after.st_uid!=os.getuid() or stat.S_IMODE(after.st_mode)!=0o755):
                        raise ValueError("directory identity")
                    directory_records[relative]=(child,meta(after),descriptor,name,None);stack.append(relative)
                elif relative in expected:
                    mode,_oid,blob=expected[relative];wanted=0o755 if mode=="100755" else 0o644
                    if (not stat.S_ISREG(before.st_mode) or before.st_uid!=os.getuid()
                            or before.st_nlink!=1 or stat.S_IMODE(before.st_mode)!=wanted
                            or before.st_size>8*1024*1024):raise ValueError("leaf identity")
                    leaf=os.open(name,leaf_flags,dir_fd=descriptor);opened.append(leaf);after=os.fstat(leaf)
                    if meta(before)!=meta(after):raise ValueError("leaf open race")
                    raw=b"";offset=0
                    while offset<after.st_size:
                        part=os.pread(leaf,min(65536,after.st_size-offset),offset)
                        if not part:raise ValueError("leaf short read")
                        raw+=part;offset+=len(part)
                    if os.pread(leaf,1,offset) or raw!=blob:raise ValueError("leaf bytes")
                    leaf_records[relative]=(leaf,meta(after),descriptor,name)
                else:raise ValueError("untracked entry")
        if set(directory_records)-{""}!=expected_dirs or set(leaf_records)!=set(expected):
            raise ValueError("physical inventory inequality")
        for leaf,want,parent_fd,name in leaf_records.values():
            if meta(os.fstat(leaf))!=want or meta(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=want:
                raise ValueError("leaf final rebind")
        for relative,(descriptor,want,parent_fd,name,names) in reversed(list(directory_records.items())):
            if meta(os.fstat(descriptor))!=want or frozenset(os.listdir(descriptor))!=names:
                raise ValueError("directory final identity")
            if parent_fd is not None and meta(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=want:
                raise ValueError("directory final rebind")
        if meta(os.stat(repo,follow_symlinks=False))!=root_identity:
            raise ValueError("repository root path rebind")
        for parent_fd,name,descriptor,want in reversed(ancestor_records):
            if meta(os.fstat(descriptor))!=want:
                raise ValueError("repository ancestor changed")
            if parent_fd is not None and meta(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=want:
                raise ValueError("repository ancestor rebind")
    except (OSError,ValueError,UnicodeError) as exc:
        return False,f"retained physical checkout: {exc}"
    finally:
        for descriptor in reversed(opened):
            try:os.close(descriptor)
            except OSError:pass
    return True,"physical checkout tree index and retained worktree identity exact"


def r15_contract_candidate_scope(repo: Path, candidate_sha: str) -> tuple[bool, str]:
    commit=r15_git(repo,"cat-file","-p",candidate_sha)
    parents=[line.split(" ",1)[1] for line in commit.stdout.splitlines()
             if line.startswith("parent ")]
    successor=H035_R26_SUCCESSOR
    successor_base=str(successor["authority_base_sha"])
    if parents==[H035_R15_BASE]:
        if candidate_sha!=successor["historical_candidate_sha"]:
            return False,"historical contract candidate identity"
        authority_base=H035_R15_BASE
        authority_tree=H035_R15_BASE_TREE
        contract_sha=str(successor["historical_contract_sha256"])
        doc_appends=H035_R15_DOC_APPENDS
        state="historical R15"
    elif parents==[successor_base]:
        authority_base=successor_base
        authority_tree=str(successor["authority_base_tree"])
        contract_sha=H035_R15_CONTRACT_SHA256
        doc_appends={path:(int(row[0]),str(row[1]),str(row[2]).encode("utf-8"))
                     for path,row in dict(successor["doc_appends"]).items()}
        state="successor R26"
    else:
        return False,"contract candidate relation"
    base_commit=r15_git(repo,"cat-file","-p",authority_base)
    if base_commit.returncode or [line for line in base_commit.stdout.splitlines()
                                 if line.startswith("tree ")] != [f"tree {authority_tree}"]:
        return False,"frozen contract authority base/tree missing"
    if commit.returncode: return False,"contract candidate relation"
    expected=tuple(sorted(H035_R15_TEST_AUTHOR_PATHS))
    names=r15_git(repo,"diff","--name-only","--no-renames","--no-ext-diff",
                  "--no-textconv",authority_base,candidate_sha)
    states=r15_git(repo,"diff","--name-status","--no-renames","--no-ext-diff",
                   "--no-textconv",authority_base,candidate_sha)
    if names.returncode or tuple(names.stdout.splitlines()) != expected:
        return False,"contract five-file scope"
    if states.returncode or states.stdout.splitlines() != [f"M\t{path}" for path in expected]:
        return False,"contract rename/add/delete/type substitution"
    tree=r15_git(repo,"--literal-pathspecs","ls-tree",candidate_sha,"--",*expected)
    observed={}
    for line in tree.stdout.splitlines():
        fields=line.split(None,3)
        if len(fields)==4: observed[fields[3]]=(fields[0],fields[1])
    modes={path:("100755" if path=="verify/bin/h-035-exit" else "100644","blob")
           for path in expected}
    if tree.returncode or observed != modes: return False,"contract path mode/type"
    try:
        spec=strict_json_bytes(r15_git_object_bytes(repo,candidate_sha,
                                                    "specs/tasks.spec.json") or b"")
        rows=[row for row in spec.get("tasks",[]) if isinstance(row,dict)
              and row.get("id")=="h-035"] if isinstance(spec,dict) else []
        manifest=rows[0].get("r15_owner_product_lifecycle") if len(rows)==1 else None
    except ValueError:
        manifest=None
    candidate_tree=r15_git(repo,"rev-parse",f"{candidate_sha}^{{tree}}")
    if (candidate_tree.returncode or (state=="historical R15"
            and candidate_tree.stdout.strip()!=successor["historical_candidate_tree"])):
        return False,"historical contract candidate tree"
    if state=="successor R26":
        inheritance_ok,inheritance_why=r15_gate_inheritance_scope(
            repo,H035_R15_BASE,candidate_sha)
        if not inheritance_ok: return False,inheritance_why
    if not isinstance(manifest,dict) or canonical_json_sha256(manifest)!=contract_sha:
        return False,"contract manifest digest"
    for path,(size,digest,marker) in doc_appends.items():
        base_raw=r15_git_object_bytes(repo,authority_base,path)
        candidate_raw=r15_git_object_bytes(repo,candidate_sha,path)
        if base_raw is None or candidate_raw is None or not candidate_raw.startswith(base_raw):
            return False,"contract documentation is not append-only: "+path
        suffix=candidate_raw[len(base_raw):]
        if (len(suffix)!=size or hashlib.sha256(suffix).hexdigest()!=digest
                or not suffix.startswith(marker)
                or not suffix.endswith(b"\n")):
            return False,"contract documentation append mismatch: "+path
    return True,"exact "+state+" contract candidate"


def r26_dual_review_values(aggregate: object,
                           leaves: list[tuple[object,str]],
                           authority_base: str, candidate: str,
                           candidate_tree: str,
                           expected_paths: list[str], *,
                           review_lanes: object=None) -> bool:
    successor=H035_R26_SUCCESSOR
    lanes=successor["review_lanes"] if review_lanes is None else review_lanes
    if (not isinstance(lanes,list) or len(lanes)!=2 or len(leaves)!=2
            or any(not isinstance(row,dict) or tuple(row)!=("lane","path")
                   or not isinstance(row["path"],str) for row in lanes)
            or [row["lane"] for row in lanes] != ["A","B"]
            or len({str(row["path"]) for row in lanes})!=2):
        return False
    bound_reviews=[]
    for lane,(leaf,leaf_sha) in zip(lanes,leaves):
        expected_leaf={
            "schema_version":1,
            "record_type":"nortropic_independent_h035_r26_gate_review",
            "role":"GATE_REVIEWER","lane":lane["lane"],"result":"PASS",
            "task":"h-035","authority_base_sha":authority_base,
            "contract_candidate_sha":candidate,
            "contract_candidate_tree":candidate_tree,
            "changed_files":expected_paths,"blocking_findings":[],
        }
        if (not isinstance(leaf,dict) or not r15_lower_hex(leaf_sha,64)
                or set(leaf)!=set(successor["leaf_review_fields"])
                or not r15_json_equal(leaf,expected_leaf)):
            return False
        bound_reviews.append({"lane":lane["lane"],"path":str(lane["path"]),
                              "sha256":leaf_sha})
    if len({row["sha256"] for row in bound_reviews})!=2:
        return False
    expected_aggregate={
        "schema_version":1,"record_type":"nortropic_dual_h035_r26_gate_review_binding",
        "role":"DUAL_GATE_REVIEW_BINDING","result":"PASS","task":"h-035",
        "authority_base_sha":authority_base,"contract_candidate_sha":candidate,
        "contract_candidate_tree":candidate_tree,"changed_files":expected_paths,
        "reviews":bound_reviews,"blocking_findings":[],
    }
    return (isinstance(aggregate,dict)
            and set(aggregate)==set(successor["aggregate_review_fields"])
            and r15_json_equal(aggregate,expected_aggregate))


def r15_contract_publication_proof(repo: Path, publication_sha: str,
                                   review_path: Path,
                                   receipt_path: Path,
                                   *, observe_remote: bool,
                                   judge_fixture_artifacts: bool=False) -> tuple[bool, str]:
    safe,origin=r15_local_config_safe(repo)
    if not safe: return False,origin
    if observe_remote:
        try: observed_origin,remote_main=r15_observed_remote_main(repo)
        except Rig as exc: return False,str(exc)
        if observed_origin != origin or remote_main != publication_sha:
            return False,"contract publication is not observed origin/main"
    commit=r15_git(repo,"cat-file","-p",publication_sha)
    parents=[line.split(" ",1)[1] for line in commit.stdout.splitlines()
             if line.startswith("parent ")]
    if commit.returncode or len(parents)!=2 or parents[0] not in {
            H035_R15_BASE,str(H035_R26_SUCCESSOR["authority_base_sha"])}:
        return False,"contract publication ordered graph"
    authority_base=parents[0]
    candidate=parents[1]
    scoped,why=r15_contract_candidate_scope(repo,candidate)
    if not scoped: return False,why
    candidate_commit=r15_git(repo,"cat-file","-p",candidate)
    candidate_parents=[line.split(" ",1)[1] for line in candidate_commit.stdout.splitlines()
                       if line.startswith("parent ")]
    if candidate_commit.returncode or candidate_parents!=[authority_base]:
        return False,"contract publication/candidate state mismatch"
    publication_tree=r15_git(repo,"rev-parse",f"{publication_sha}^{{tree}}")
    candidate_tree=r15_git(repo,"rev-parse",f"{candidate}^{{tree}}")
    if (publication_tree.returncode or candidate_tree.returncode
            or publication_tree.stdout.strip()!=candidate_tree.stdout.strip()):
        return False,"contract publication tree"
    expected_paths=list(sorted(H035_R15_TEST_AUTHOR_PATHS))
    successor=H035_R26_SUCCESSOR
    judge_lanes=None
    if judge_fixture_artifacts:
        evidence_dir=review_path.parent
        if (not review_path.is_absolute() or not receipt_path.is_absolute()
                or receipt_path.parent!=evidence_dir
                or ".." in review_path.parts or ".." in receipt_path.parts):
            return False,"judge fixture artifact directory substitution"
        if authority_base==H035_R15_BASE:
            expected_review_path=evidence_dir/"h035-r15-contract-review.json"
            expected_receipt_path=evidence_dir/"h035-r15-contract-publication.json"
        else:
            expected_review_path=evidence_dir/"h035-r26-dual-gate-review.json"
            expected_receipt_path=evidence_dir/"h035-r26-contract-publication.json"
            judge_lanes=[
                {"lane":"A","path":str(evidence_dir/"h035-r26-gate-review-a.json")},
                {"lane":"B","path":str(evidence_dir/"h035-r26-gate-review-b.json")},
            ]
        if review_path!=expected_review_path or receipt_path!=expected_receipt_path:
            return False,"judge fixture artifact name substitution"
    elif authority_base==H035_R15_BASE:
        if (review_path!=H035_R15_CONTRACT_REVIEW_PATH
                or receipt_path!=H035_R15_CONTRACT_RECEIPT_PATH):
            return False,"historical contract artifact path substitution"
    elif (str(review_path)!=successor["aggregate_review_path"]
            or str(receipt_path)!=successor["publication_receipt_path"]):
        return False,"successor contract artifact path substitution"
    try:
        review,_review_raw,review_sha=r15_safe_artifact(review_path)
        receipt,_receipt_raw,_receipt_sha=r15_safe_artifact(receipt_path)
    except (OSError,ValueError,Rig) as exc:
        return False,f"contract publication artifact: {exc}"
    if authority_base==H035_R15_BASE:
        expected_review={
            "schema_version":1,"record_type":"nortropic_independent_h035_r15_contract_review",
            "role":"GATE_REVIEWER","result":"PASS","task":"h-035",
            "authority_base_sha":H035_R15_BASE,"contract_candidate_sha":candidate,
            "contract_candidate_tree":candidate_tree.stdout.strip(),"blocking_findings":[],
        }
        review_ok=(set(review)==set(H035_R15_CONTRACT_REVIEW_FIELDS)
                   and r15_json_equal(review,expected_review))
        phase="H035_R15_GUARDED_CONTRACT_PUBLICATION"
    else:
        leaves=[]
        try:
            selected_lanes=(judge_lanes if judge_fixture_artifacts
                            else successor["review_lanes"])
            for lane in selected_lanes:
                lane_path=Path(str(lane["path"]))
                leaf,_leaf_raw,leaf_sha=r15_safe_artifact(lane_path)
                leaves.append((leaf,leaf_sha))
        except (OSError,ValueError,Rig,KeyError,TypeError) as exc:
            return False,f"successor independent gate review: {exc}"
        if judge_fixture_artifacts:
            review_ok=r26_dual_review_values(
                review,leaves,authority_base,candidate,candidate_tree.stdout.strip(),
                expected_paths,review_lanes=judge_lanes)
        else:
            review_ok=r26_dual_review_values(
                review,leaves,authority_base,candidate,candidate_tree.stdout.strip(),
                expected_paths)
        phase="H035_R26_GUARDED_CONTRACT_PUBLICATION"
    expected_receipt={
        "schema_version":1,"record_type":"nortropic_publication_receipt",
        "phase":phase,"repository":origin,
        "task_id":"h-035","base_sha":authority_base,"candidate_sha":candidate,
        "candidate_tree":candidate_tree.stdout.strip(),"merge_sha":publication_sha,
        "merge_tree":candidate_tree.stdout.strip(),
        "ordered_parents":[authority_base,candidate],
        "independent_review_path":str(review_path),
        "independent_review_sha256":review_sha,"force":False,"history_rewrite":False,
    }
    if (not review_ok or set(receipt) != set(H035_R15_CONTRACT_RECEIPT_FIELDS)
            or not r15_json_equal(receipt,expected_receipt)):
        return False,"contract review/receipt binding"
    return True,candidate


def r15_test_author_identity() -> tuple[bool, str]:
    shape_ok, why = r15_repository_shape(ROOT)
    if not shape_ok: return False, why
    head = r15_git(ROOT, "rev-parse", "--verify", "HEAD")
    if head.returncode or not r15_lower_hex(head.stdout.strip(), 40):
        return False, "cannot derive exact contract candidate HEAD"
    candidate_sha = head.stdout.strip()
    scoped,why=r15_contract_candidate_scope(ROOT,candidate_sha)
    if not scoped: return False,why
    physical_ok, physical_why = r15_physical_checkout_exact(ROOT, candidate_sha)
    if not physical_ok: return False, physical_why
    expected = tuple(sorted(H035_R15_TEST_AUTHOR_PATHS))
    authority_base=str(H035_R26_SUCCESSOR["authority_base_sha"])
    names = r15_git(ROOT, "diff", "--name-only", "--no-renames", "--no-ext-diff",
                    "--no-textconv", authority_base, candidate_sha)
    states = r15_git(ROOT, "diff", "--name-status", "--no-renames", "--no-ext-diff",
                     "--no-textconv", authority_base, candidate_sha)
    if names.returncode or tuple(names.stdout.splitlines()) != expected:
        return False, "contract candidate does not change exact five TEST_AUTHOR files"
    if states.returncode or states.stdout.splitlines() != [f"M\t{path}" for path in expected]:
        return False, "contract candidate contains rename/add/delete/type substitution"
    tree = r15_git(ROOT, "--literal-pathspecs", "ls-tree", candidate_sha,
                   "--", *expected)
    observed: dict[str, tuple[str, str]] = {}
    for line in tree.stdout.splitlines():
        fields=line.split(None, 3)
        if len(fields) == 4:
            observed[fields[3]] = (fields[0], fields[1])
    expected_modes = {path:("100755" if path == "verify/bin/h-035-exit" else "100644", "blob")
                      for path in expected}
    if tree.returncode or observed != expected_modes:
        return False, "contract candidate five-file modes/types mismatch"
    for relative, local in (("specs/tasks.spec.json", SPEC),
                            ("verify/bin/h-035-exit", Path(__file__))):
        if r15_git_object_bytes(ROOT, candidate_sha, relative) != local.read_bytes():
            return False, f"executing contract byte mismatch: {relative}"
    return True, candidate_sha


def r15_ast_sha256(node: ast.AST) -> str:
    return hashlib.sha256(ast.dump(
        node, annotate_fields=True, include_attributes=False).encode("utf-8")).hexdigest()


def r15_ast_interpreter_validate(authority_path: Path, authority_sha256: str,
                                 authority_version: tuple[int, int, int],
                                 observed_executable: str,
                                 observed_version: tuple[int, int, int]) -> tuple[bool, str]:
    """Bind AST meaning to one exact no-follow executable, never caller selection."""
    fd = -1
    try:
        if (not authority_path.is_absolute()
                or authority_path.resolve(strict=True) != authority_path):
            return False, "AST interpreter canonical path"
        if observed_version != authority_version:
            return False, "AST interpreter exact version"
        if Path(os.path.realpath(observed_executable)) != authority_path:
            return False, "AST interpreter executing path"
        before = os.lstat(authority_path)
        identity = lambda value: (
            value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_nlink,
            value.st_size,value.st_mtime_ns,value.st_ctime_ns)
        if (not stat.S_ISREG(before.st_mode) or not before.st_mode & 0o111
                or before.st_nlink != 1 or before.st_size < 1
                or before.st_size > H035_R15_AST_PYTHON_MAX_BYTES):
            return False, "AST interpreter regular executable identity"
        fd = os.open(authority_path,
                     os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        opened = os.fstat(fd)
        if identity(opened) != identity(before):
            return False, "AST interpreter open identity"
        chunks=[]; offset=0
        while offset < opened.st_size:
            chunk=os.pread(fd,min(65536,opened.st_size-offset),offset)
            if not chunk: return False, "AST interpreter short read"
            chunks.append(chunk); offset += len(chunk)
        if os.pread(fd,1,opened.st_size) != b"":
            return False, "AST interpreter oversized read"
        after = os.fstat(fd); named = os.lstat(authority_path)
        if identity(after) != identity(opened) or identity(named) != identity(opened):
            return False, "AST interpreter final identity"
        if hashlib.sha256(b"".join(chunks)).hexdigest() != authority_sha256:
            return False, "AST interpreter exact digest"
    except (OSError, RuntimeError, ValueError) as exc:
        return False, "AST interpreter validation: " + str(exc)
    finally:
        if fd >= 0: os.close(fd)
    return True, "exact canonical Python 3.12.13 AST interpreter"


def r15_require_ast_interpreter() -> None:
    ok,why=r15_ast_interpreter_validate(
        H035_R15_AST_PYTHON,H035_R15_AST_PYTHON_SHA256,
        H035_R15_AST_PYTHON_VERSION,sys.executable,tuple(sys.version_info[:3]))
    if not ok: raise Rig(why)


def r15_gate_definition_row(node: ast.AST) -> dict[str, object]:
    return {"kind":type(node).__name__,"name":node.name,
            "ast_sha256":r15_ast_sha256(node)}


def r15_gate_definition_aggregate(nodes: list[ast.AST]) -> str:
    rows=[r15_gate_definition_row(node) for node in nodes]
    return hashlib.sha256(json.dumps(
        rows,sort_keys=True,separators=(",",":")).encode("utf-8")).hexdigest()


def r15_gate_nondefinition_digest(nodes: list[ast.AST]) -> str:
    rows=[r15_ast_sha256(node) for node in nodes]
    return hashlib.sha256(json.dumps(
        rows,separators=(",",":")).encode("utf-8")).hexdigest()


def r15_gate_call_name(statement: ast.stmt) -> str | None:
    if (not isinstance(statement,ast.Expr) or not isinstance(statement.value,ast.Call)
            or not isinstance(statement.value.func,ast.Name)):
        return None
    return statement.value.func.id


def r15_gate_nested_function(node: ast.AST, name: str) -> ast.FunctionDef | None:
    hits=[value for value in ast.walk(node)
          if isinstance(value,ast.FunctionDef) and value.name==name]
    return hits[0] if len(hits)==1 else None


def r15_gate_regular_branch(node: ast.AST) -> ast.If | None:
    hits=[value for value in ast.walk(node) if isinstance(value,ast.If)
          and ast.unparse(value.test)=="stat.S_ISREG(info.st_mode)"]
    return hits[0] if len(hits)==1 else None


def r15_gate_module_binding_events(module: ast.Module) -> tuple[list[str],list[str]]:
    bindings=[]; deletions=[]
    def pattern(value: ast.AST) -> None:
        if isinstance(value,ast.MatchAs):
            if value.pattern is not None: pattern(value.pattern)
            if value.name is not None: bindings.append(value.name)
        elif isinstance(value,ast.MatchStar):
            if value.name is not None: bindings.append(value.name)
        elif isinstance(value,ast.MatchMapping):
            for item in value.patterns: pattern(item)
            if value.rest is not None: bindings.append(value.rest)
        elif isinstance(value,ast.MatchSequence):
            for item in value.patterns: pattern(item)
        elif isinstance(value,ast.MatchClass):
            for item in value.patterns+value.kwd_patterns: pattern(item)
        elif isinstance(value,ast.MatchOr):
            for item in value.patterns: pattern(item)
    def visit(value: ast.AST, module_scope: bool=True, target: bool=False) -> None:
        if isinstance(value,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)):
            if module_scope: bindings.append(value.name)
            for item in value.decorator_list: visit(item,module_scope)
            if isinstance(value,(ast.FunctionDef,ast.AsyncFunctionDef)):
                for item in value.args.defaults+value.args.kw_defaults:
                    if item is not None: visit(item,module_scope)
                if value.returns is not None: visit(value.returns,module_scope)
            else:
                for item in value.bases: visit(item,module_scope)
                for item in value.keywords: visit(item.value,module_scope)
            return
        if isinstance(value,ast.Lambda): return
        if isinstance(value,(ast.ListComp,ast.SetComp,ast.GeneratorExp,ast.DictComp)):
            for generator in value.generators:
                visit(generator.iter,module_scope)
                for condition in generator.ifs: visit(condition,module_scope)
            if isinstance(value,ast.DictComp):
                visit(value.key,module_scope); visit(value.value,module_scope)
            else: visit(value.elt,module_scope)
            return
        if isinstance(value,ast.Name):
            if module_scope and isinstance(value.ctx,ast.Store): bindings.append(value.id)
            if module_scope and isinstance(value.ctx,ast.Del): deletions.append(value.id)
            return
        if isinstance(value,(ast.Import,ast.ImportFrom)):
            if module_scope:
                bindings.extend(item.asname or (item.name.split(".",1)[0]
                    if isinstance(value,ast.Import) else item.name) for item in value.names)
            return
        if isinstance(value,ast.ExceptHandler):
            if module_scope and value.name is not None: bindings.append(value.name)
            if value.type is not None: visit(value.type,module_scope)
            for item in value.body: visit(item,module_scope)
            return
        if isinstance(value,ast.match_case):
            if module_scope: pattern(value.pattern)
            if value.guard is not None: visit(value.guard,module_scope)
            for item in value.body: visit(item,module_scope)
            return
        for child in ast.iter_child_nodes(value): visit(child,module_scope,target)
    for statement in module.body: visit(statement)
    return bindings,deletions


def r15_gate_direct_alias(value: ast.AST, inherited: set[str]) -> bool:
    if isinstance(value,ast.Name): return value.id in inherited
    if isinstance(value,ast.Attribute):
        root=value.value
        while isinstance(root,(ast.Attribute,ast.Subscript)): root=root.value
        return isinstance(root,ast.Name) and root.id in inherited
    if isinstance(value,(ast.Tuple,ast.List,ast.Set)):
        return any(r15_gate_direct_alias(item,inherited) for item in value.elts)
    if isinstance(value,ast.Dict):
        return any(item is not None and r15_gate_direct_alias(item,inherited)
                   for item in value.keys+value.values)
    return False


def r15_gate_definition_time_surface(node: ast.AST) -> list[ast.AST]:
    if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef)):
        values=[*node.decorator_list,*node.args.defaults,
                *(value for value in node.args.kw_defaults if value is not None)]
        values.extend(value.annotation for value in (
            *node.args.posonlyargs,*node.args.args,*node.args.kwonlyargs)
                      if value.annotation is not None)
        if node.args.vararg is not None and node.args.vararg.annotation is not None:
            values.append(node.args.vararg.annotation)
        if node.args.kwarg is not None and node.args.kwarg.annotation is not None:
            values.append(node.args.kwarg.annotation)
        if node.returns is not None: values.append(node.returns)
        values.extend(node.type_params)
        return values
    if isinstance(node,ast.ClassDef):
        return [*node.decorator_list,*node.bases,
                *(value.value for value in node.keywords),*node.type_params,
                *(value for value in node.body
                  if not isinstance(value,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)))]
    return []


def r15_gate_closed_mutation_family(top: ast.AST,
                                    inherited: set[str]) -> tuple[bool,str]:
    if (isinstance(top,ast.FunctionDef) and top.name=="r15_gate_import_callable_identity"
            and r15_ast_sha256(top)==H035_R15_IMPORT_ORACLE_AST_SHA256):
        return True,"exact closed import identity oracle"
    if (isinstance(top,ast.FunctionDef)
            and r15_ast_sha256(top)==H035_R15_PROCESS_STATE_REVIEWED_AST_SHA256.get(top.name)):
        return True,"exact closed child process-state preexec"
    if (isinstance(top,ast.FunctionDef)
            and r15_ast_sha256(top)==H035_R15_CODE_CONSUMER_AST_SHA256.get(top.name)):
        return True,"exact closed compiled-code consumer"
    if isinstance(top,(ast.Expr,ast.If,ast.For,ast.AsyncFor,ast.While,ast.With,
                       ast.AsyncWith,ast.Try,ast.Match,ast.Raise,ast.Assert)):
        return False,"unreviewed module-level executable statement"
    if isinstance(top,(ast.Assign,ast.AnnAssign,ast.AugAssign)):
        exact_legacy_tasks=ast.unparse(top)==(
            "H035_R15_LEGACY_TASKS = tuple((f'h-{number:03d}' for number in range(1, 18)))")
        if not exact_legacy_tasks and any(isinstance(value,(ast.Lambda,ast.NamedExpr,ast.ListComp,ast.SetComp,
                                 ast.DictComp,ast.GeneratorExp,ast.Await,ast.Yield,
                                 ast.YieldFrom)) for value in ast.walk(top)):
            return False,"unreviewed active module assignment surface"
        allowed_calls={
            "os.environ.get('SSH_AUTH_SOCK', '')","os.confstr(65537)",
            "Path(os.confstr(65537))","Path(os.confstr(65537)).resolve(strict=True)",
            "Path('/opt/homebrew/Cellar/python@3.12/3.12.13_4/Frameworks/Python.framework/Versions/3.12/bin/python3.12')",
            "Path('/Users/elinhaggstrom/nortropic/evidence/bootstrap-supervisor/evidence/h035-r15-contract-review.json')",
            "Path('/Users/elinhaggstrom/nortropic/evidence/bootstrap-supervisor/evidence/h035-r15-contract-publication.json')",
            "str(H035_R15_AST_PYTHON)","range(1, 18)",
            "tuple((f'h-{number:03d}' for number in range(1, 18)))",
            "'\\n## H-035 R15 — owner-publication lifecycle drift boundary\\n'.encode('utf-8')",
        }
        if any(ast.unparse(value) not in allowed_calls for value in ast.walk(top)
               if isinstance(value,ast.Call)):
            return False,"unreviewed module-level assignment capability"
    if (isinstance(top,ast.FunctionDef)
            and top.name in H035_R15_ENV_REVIEWED_AST_SHA256
            and r15_ast_sha256(top)!=H035_R15_ENV_REVIEWED_AST_SHA256[top.name]):
        return False,"unbalanced or unreviewed parent environment mutation"
    if isinstance(top,ast.ClassDef) and top.name!="R15DefinitionSurface":
        return False,"unreviewed new class/protocol authority"
    process_state={
        "chdir","fchdir","umask","settrace","setprofile","set_coroutine_origin_tracking_depth",
        "setswitchinterval","setdlopenflags","setrecursionlimit","set_asyncgen_hooks",
        "signal","alarm","setitimer","setrlimit","setdefaulttimeout","setlocale","tzset",
        "addaudithook","register_at_fork",
    }
    if any(isinstance(value,ast.Call) and isinstance(value.func,ast.Attribute)
           and value.func.attr in {"find_spec","module_from_spec","create_module",
                                   "exec_module","load_module"} for value in ast.walk(top)):
        return False,"unreviewed dynamic module recovery"
    if any(isinstance(value,ast.Call) and isinstance(value.func,ast.Attribute)
           and value.func.attr in process_state for value in ast.walk(top)):
        expected=H035_R15_PROCESS_STATE_REVIEWED_AST_SHA256.get(
            top.name if isinstance(top,ast.FunctionDef) else "")
        if expected is None or r15_ast_sha256(top)!=expected:
            return False,"unreviewed parent-process state mutation"
    if any(isinstance(value,ast.ClassDef) and value is not top for value in ast.walk(top)):
        return False,"unreviewed nested class/protocol authority"
    parents={id(child):value for value in ast.walk(top)
             for child in ast.iter_child_nodes(value)}
    name_assignments={}
    for value in ast.walk(top):
        if isinstance(value,(ast.Assign,ast.AnnAssign)):
            targets=value.targets if isinstance(value,ast.Assign) else [value.target]
            for target in targets:
                if isinstance(target,ast.Name):
                    name_assignments.setdefault(target.id,[]).append(value.value)
    fresh_names={name for name,values in name_assignments.items() if len(values)==1
                 and isinstance(values[0],(ast.Dict,ast.List,ast.Set))
                 and not list(ast.iter_child_nodes(values[0]))}
    if (isinstance(top,ast.FunctionDef) and top.name=="r15_gate_import_callable_identity"
            and len(name_assignments.get("namespace",[]))==1):
        fresh_names.add("namespace")
    env_operations=[]; env_call_ids=set(); final_nodes=set()
    for value in ast.walk(top):
        if isinstance(value,ast.Try):
            final_nodes.update(id(item) for statement in value.finalbody for item in ast.walk(statement))
        if (isinstance(value,ast.Call) and isinstance(value.func,ast.Attribute)
                and ast.unparse(value.func.value)=="os.environ"
                and value.func.attr in {"update","pop","clear","popitem","setdefault",
                                        "__setitem__","__delitem__","__ior__"}):
            env_operations.append((ast.unparse(value),id(value) in final_nodes))
            env_call_ids.add(id(value))
        if (isinstance(value,ast.Call) and isinstance(value.func,ast.Attribute)
                and isinstance(value.func.value,ast.Name)
                and value.func.value.id in {"dict","os._Environ"}
                and value.func.attr in {"update","pop","clear","popitem","setdefault",
                                        "__setitem__","__delitem__","__ior__"}
                and value.args and ast.unparse(value.args[0])=="os.environ"):
            env_operations.append((ast.unparse(value),id(value) in final_nodes))
            env_call_ids.add(id(value))
        if (isinstance(value,ast.Subscript) and isinstance(value.ctx,(ast.Store,ast.Del))
                and ast.unparse(value.value)=="os.environ"):
            env_operations.append(("TARGET:"+ast.unparse(value),id(value) in final_nodes))
        if isinstance(value,ast.AugAssign) and ast.unparse(value.target)=="os.environ":
            env_operations.append(("AUG:"+ast.unparse(value),id(value) in final_nodes))
    expected_env={
        "r15_remote_boundary_selftests":sorted([
            ("os.environ.update({key: '/hostile/caller/value' for key in hostile_keys})",False),
            ("os.environ.pop(key, None)",True),("TARGET:os.environ[key]",True),
            ("TARGET:os.environ['SSH_AUTH_SOCK']",False),
            ("os.environ.pop('SSH_AUTH_SOCK', None)",True),
            ("TARGET:os.environ['SSH_AUTH_SOCK']",True)]),
        "r15_product_scope_selftests":sorted([
            ("os.environ.update(hostile)",False),("os.environ.pop(key, None)",True),
            ("TARGET:os.environ[key]",True)]),
    }
    env_verified=False
    if env_operations:
        name=top.name if isinstance(top,ast.FunctionDef) else ""
        if sorted(env_operations)!=expected_env.get(name):
            return False,"unbalanced or unreviewed parent environment mutation"
        env_verified=True
    sensitive={"globals","locals","vars","setattr","delattr","eval","exec",
               "__import__","__builtins__","import_module","_getframe","currentframe",
               "f_globals","f_locals","f_builtins","__closure__","cell_contents","__class__","__globals__",
               "__defaults__","__kwdefaults__","__dict__","modules","putenv","unsetenv","environb",
               "__getattribute__","__setattr__","__delattr__"}
    for value in ast.walk(top):
        token=value.id if isinstance(value,ast.Name) else (
            value.attr if isinstance(value,ast.Attribute) else None)
        if token not in sensitive: continue
        allowed=(isinstance(top,ast.FunctionDef)
                 and top.name=="r15_gate_import_callable_identity"
                 and isinstance(value,ast.Attribute) and isinstance(value.ctx,ast.Load)
                 and value.attr in {"__defaults__","__kwdefaults__"})
        if isinstance(value,ast.Name) and value.id=="vars":
            call=parents.get(id(value)); consumer=parents.get(id(call)) if call is not None else None
            if (isinstance(call,ast.Call) and isinstance(consumer,ast.Call)
                    and isinstance(consumer.func,ast.Name) and consumer.func.id=="len"
                    and consumer.args==[call]):
                allowed=True
        if isinstance(value,ast.Name) and value.id=="exec":
            call=parents.get(id(value))
            if (isinstance(top,ast.FunctionDef)
                    and top.name=="r15_gate_import_callable_identity"
                    and isinstance(call,ast.Call)
                    and ast.unparse(call)==
                        "exec(compile(text, '<h035-hr01-import-oracle>', 'exec'), namespace, namespace)"
                    and len(name_assignments.get("namespace",[]))==1
                    and ast.unparse(name_assignments["namespace"][0])==
                        "{'__name__': '_h035_hr01_identity_oracle', '__file__': str(Path(__file__))}"):
                allowed=True
        if not allowed: return False,"closed sensitive reflection/mutation surface"
    active=(ast.Call,ast.NamedExpr,ast.Lambda,ast.ListComp,ast.SetComp,
            ast.DictComp,ast.GeneratorExp,ast.Await,ast.Yield,ast.YieldFrom)
    definitions=[value for value in ast.walk(top)
                 if isinstance(value,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))]
    if any(isinstance(value,active)
           for definition in definitions
           for surface in r15_gate_definition_time_surface(definition)
           for value in ast.walk(surface)):
        return False,"definition-time executable/alias surface"
    if any(isinstance(value,ast.Attribute)
           and ast.unparse(value.value)=="os.environ"
           and value.attr in {"update","clear","pop","popitem","setdefault",
                              "__setitem__","__delitem__","__ior__"}
           for definition in definitions
           for surface in r15_gate_definition_time_surface(definition)
           for value in ast.walk(surface)):
        return False,"definition-time parent-environment capability capture"
    def scoped_nodes(statements: list[ast.stmt]):
        pending=list(statements)
        while pending:
            value=pending.pop()
            yield value
            if isinstance(value,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef,ast.Lambda)):
                continue
            pending.extend(ast.iter_child_nodes(value))
    functions=[value for value in ast.walk(top)
               if isinstance(value,(ast.FunctionDef,ast.AsyncFunctionDef))]
    for function in functions:
        parameters={argument.arg for argument in (
            *function.args.posonlyargs,*function.args.args,*function.args.kwonlyargs)}
        if function.args.vararg is not None: parameters.add(function.args.vararg.arg)
        if function.args.kwarg is not None: parameters.add(function.args.kwarg.arg)
        for value in scoped_nodes(function.body):
            if (isinstance(value,ast.Subscript) and isinstance(value.ctx,(ast.Store,ast.Del))
                    and isinstance(value.value,ast.Name) and value.value.id in parameters):
                locally_fresh=any(isinstance(item,ast.Assign)
                    and any(isinstance(target,ast.Name) and target.id==value.value.id
                            for target in item.targets)
                    and isinstance(item.value,ast.Dict) and not item.value.keys
                    for item in scoped_nodes(function.body))
                if locally_fresh: continue
                if (function is top and isinstance(top,ast.FunctionDef)
                        and top.name=="r15_dispatch_controls"
                        and value.value.id=="context" and isinstance(value.slice,ast.Constant)
                        and value.slice.value in {"dispatch_legacy_attest_trace_ok",
                                                  "dispatch_legacy_authority_taskval_trace_ok"}
                        and isinstance(value.ctx,ast.Store)):
                    continue
                return False,"parameter capability mapping mutation"
            if (isinstance(value,ast.Call) and isinstance(value.func,ast.Attribute)
                    and value.func.attr in {"update","clear","pop","popitem","setdefault",
                                             "__setitem__","__delitem__"}
                    and isinstance(value.func.value,ast.Name)
                    and value.func.value.id in parameters):
                return False,"parameter capability mapping mutation"
    aliases=set(); protected_aliases=set(inherited); protected_helpers=set()
    local_callable_names={value.name for value in ast.walk(top)
                          if isinstance(value,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
    reflective_names={"globals","locals","vars","getattr"}
    reflective_attrs={"__globals__","__defaults__","__kwdefaults__"}
    reflective_helpers=set(); process_helpers=set()
    for value in ast.walk(top):
        if isinstance(value,(ast.FunctionDef,ast.AsyncFunctionDef)) and value is not top:
            if any(isinstance(item,ast.Name) and item.id in reflective_names
                   or isinstance(item,ast.Attribute) and item.attr in {
                       "_getframe","currentframe","f_globals","f_locals","f_builtins",
                       "__globals__","__getattribute__"} for item in ast.walk(value)):
                reflective_helpers.add(value.name)
            if any(isinstance(item,ast.Attribute) and (
                    item.attr in process_state
                    or ast.unparse(item.value) in {"sys.path","sys.meta_path","sys.path_hooks",
                                                   "sys.path_importer_cache","sys.argv"})
                   for item in ast.walk(value)):
                process_helpers.add(value.name)
        if isinstance(value,(ast.Assign,ast.AnnAssign)):
            assigned=value.value
            targets=value.targets if isinstance(value,ast.Assign) else [value.target]
            if (isinstance(assigned,ast.Lambda)
                    and any(isinstance(item,ast.Name) and item.id in reflective_names
                            for item in ast.walk(assigned))):
                reflective_helpers.update(item.id for target in targets for item in ast.walk(target)
                                          if isinstance(item,ast.Name) and isinstance(item.ctx,ast.Store))
    def lexical_scope(value: ast.AST) -> int:
        current=value
        while id(current) in parents:
            current=parents[id(current)]
            if isinstance(current,(ast.FunctionDef,ast.AsyncFunctionDef,ast.Lambda,ast.ClassDef)):
                return id(current)
        return id(top)
    def locally_bound(value: ast.Name) -> bool:
        scope=lexical_scope(value)
        owner=next((item for item in ast.walk(top) if id(item)==scope),None)
        if isinstance(owner,(ast.FunctionDef,ast.AsyncFunctionDef,ast.Lambda)):
            arguments={item.arg for item in (*owner.args.posonlyargs,*owner.args.args,
                                             *owner.args.kwonlyargs)}
            if value.id in arguments: return True
        return any(isinstance(item,ast.Name) and isinstance(item.ctx,ast.Store)
                   and item.id==value.id and lexical_scope(item)==scope for item in ast.walk(top))
    def tainted(value: ast.AST) -> bool:
        if isinstance(value,ast.Name):
            return value.id in aliases|reflective_helpers|process_helpers \
                or value.id=="compile" and not locally_bound(value)
        if isinstance(value,ast.Call):
            if (isinstance(value.func,ast.Name)
                    and value.func.id in reflective_names|reflective_helpers|process_helpers):
                return True
            if (isinstance(value.func,ast.Name) and value.func.id=="type"
                    and value.args and (protected(value.args[0])
                                        or isinstance(value.args[0],ast.Lambda)
                                        or isinstance(value.args[0],ast.Name)
                                           and value.args[0].id in local_callable_names)):
                return True
            if tainted(value.func): return True
            if (isinstance(value.func,ast.Attribute)
                    and value.func.attr=="__getattribute__" and value.args
                    and isinstance(value.args[0],ast.Constant)
                    and value.args[0].value in reflective_attrs|{"__code__"}):
                return True
            return False
        if isinstance(value,ast.Attribute):
            return (value.attr in reflective_attrs|process_state
                    or (value.attr in {"append","extend","insert","remove","clear","pop",
                                       "__setitem__","__delitem__","update"}
                        and ast.unparse(value.value) in {"sys.path","sys.meta_path",
                            "sys.path_hooks","sys.path_importer_cache","sys.argv"})
                    or value.attr=="modules" and isinstance(value.value,ast.Name)
                        and value.value.id=="sys"
                    or ast.unparse(value.value)=="os.environ" and value.attr in {
                        "update","clear","pop","popitem","setdefault","__setitem__",
                        "__delitem__","__ior__"}
                    or tainted(value.value))
        if isinstance(value,ast.Subscript): return tainted(value.value)
        if isinstance(value,(ast.Tuple,ast.List,ast.Set)):
            return any(tainted(item) for item in value.elts)
        if isinstance(value,ast.Dict):
            return any(item is not None and tainted(item)
                       for item in value.keys+value.values)
        if isinstance(value,ast.NamedExpr): return tainted(value.value)
        if isinstance(value,(ast.BoolOp,ast.IfExp,ast.Starred,ast.BinOp,ast.UnaryOp,
                             ast.ListComp,ast.SetComp,ast.DictComp,ast.GeneratorExp)):
            return any(tainted(child) for child in ast.iter_child_nodes(value))
        if isinstance(value,ast.comprehension):
            return any(tainted(child) for child in ast.iter_child_nodes(value))
        return False
    scoped_rhs={}
    for assignment in ast.walk(top):
        if isinstance(assignment,ast.Assign):
            pairs=[(target,assignment.value) for target in assignment.targets]
        elif isinstance(assignment,ast.AnnAssign) and assignment.value is not None:
            pairs=[(assignment.target,assignment.value)]
        elif isinstance(assignment,ast.NamedExpr): pairs=[(assignment.target,assignment.value)]
        else: pairs=[]
        for target,rhs in pairs:
            for item in ast.walk(target):
                if isinstance(item,ast.Name) and isinstance(item.ctx,ast.Store):
                    scoped_rhs.setdefault((lexical_scope(item),item.id),[]).append(rhs)
    resolving=set()
    def protected(value: ast.AST) -> bool:
        if isinstance(value,ast.Name):
            key=(lexical_scope(value),value.id)
            if key in scoped_rhs and key not in resolving:
                resolving.add(key)
                answer=any(protected(rhs) for rhs in scoped_rhs[key])
                resolving.remove(key)
                return answer
            return value.id in protected_aliases|protected_helpers
        if isinstance(value,(ast.Attribute,ast.Subscript)): return protected(value.value)
        if isinstance(value,(ast.Tuple,ast.List,ast.Set)):
            return any(protected(item) for item in value.elts)
        if isinstance(value,ast.Dict):
            return any(item is not None and protected(item)
                       for item in value.keys+value.values)
        if (isinstance(value,ast.Call) and isinstance(value.func,ast.Name)
                and value.func.id=="type" and value.args):
            return protected(value.args[0])
        if (isinstance(value,ast.Call) and isinstance(value.func,ast.Name)
                and value.func.id in protected_helpers):
            return True
        if (isinstance(value,ast.Call) and isinstance(value.func,ast.Name)
                and value.func.id in {"next","list","tuple","set","dict"}
                and any(protected(item) for item in value.args)):
            return True
        if (isinstance(value,ast.Call) and isinstance(value.func,ast.Name)
                and value.func.id=="iter" and any(protected(item) for item in value.args)):
            return True
        if (isinstance(value,ast.Call) and isinstance(value.func,ast.Lambda)
                and any(protected(item) for item in value.args)):
            return True
        if isinstance(value,ast.Call) and isinstance(value.func,ast.Call) \
                and protected(value.func):
            return True
        if isinstance(value,(ast.BoolOp,ast.IfExp,ast.Starred,ast.BinOp,ast.UnaryOp,
                             ast.ListComp,ast.SetComp,ast.DictComp,ast.GeneratorExp)):
            return any(protected(child) for child in ast.iter_child_nodes(value))
        if isinstance(value,ast.comprehension):
            return any(protected(child) for child in ast.iter_child_nodes(value))
        if isinstance(value,ast.Lambda): return protected(value.body)
        return tainted(value)
    helper_changed=True
    while helper_changed:
        helper_changed=False
        for function in functions:
            returns=[value.value for value in scoped_nodes(function.body)
                     if isinstance(value,(ast.Return,ast.Yield,ast.YieldFrom))
                     and value.value is not None]
            if any(protected(value) for value in returns) and function.name not in protected_helpers:
                protected_helpers.add(function.name);helper_changed=True
        for assignment in ast.walk(top):
            if isinstance(assignment,ast.Assign) and isinstance(assignment.value,ast.Name) \
                    and assignment.value.id in protected_helpers:
                for target in assignment.targets:
                    for item in ast.walk(target):
                        if (isinstance(item,ast.Name) and isinstance(item.ctx,ast.Store)
                                and item.id not in protected_helpers):
                            protected_helpers.add(item.id);helper_changed=True
        for assignment in ast.walk(top):
            if isinstance(assignment,ast.Assign) and isinstance(assignment.value,ast.Lambda) \
                    and protected(assignment.value.body):
                for target in assignment.targets:
                    for item in ast.walk(target):
                        if (isinstance(item,ast.Name) and isinstance(item.ctx,ast.Store)
                                and item.id not in protected_helpers):
                            protected_helpers.add(item.id);helper_changed=True
    assignments=[]
    for value in ast.walk(top):
        if isinstance(value,ast.Assign):
            assignments.extend((target,value.value) for target in value.targets)
        elif isinstance(value,ast.AnnAssign) and value.value is not None:
            assignments.append((value.target,value.value))
        elif isinstance(value,ast.NamedExpr): assignments.append((value.target,value.value))
    changed=True
    while changed:
        changed=False
        for target,value in assignments:
            if tainted(value):
                for name in (item.id for item in ast.walk(target)
                             if isinstance(item,ast.Name) and isinstance(item.ctx,ast.Store)):
                    if name not in aliases: aliases.add(name); changed=True
            if protected(value):
                for name in (item.id for item in ast.walk(target)
                             if isinstance(item,ast.Name) and isinstance(item.ctx,ast.Store)):
                    if name not in protected_aliases:
                        protected_aliases.add(name); changed=True
    for definition in definitions:
        capture=[]
        if isinstance(definition,(ast.FunctionDef,ast.AsyncFunctionDef)):
            capture=[*definition.decorator_list,*definition.args.defaults,
                     *(value for value in definition.args.kw_defaults if value is not None)]
        elif isinstance(definition,ast.ClassDef):
            capture=[*definition.decorator_list,*definition.bases,
                     *(item.value for item in definition.keywords)]
        exact_root_default=(isinstance(definition,ast.FunctionDef)
                            and definition.name in {"r15_prepare_published_fixture",
                                                    "r15_connected_matrix"}
                            and len(definition.args.kw_defaults)==1
                            and isinstance(definition.args.kw_defaults[0],ast.Name)
                            and definition.args.kw_defaults[0].id=="ROOT")
        if any(protected(value) for value in capture) and not exact_root_default:
            return False,"definition-time protected capability capture"
    magic={"__code__","__globals__","__defaults__","__kwdefaults__"}
    for value in ast.walk(top):
        if isinstance(value,ast.Attribute) and isinstance(value.ctx,(ast.Store,ast.Del)):
            if value.attr in magic or tainted(value.value) or protected(value.value):
                return False,"reflective inherited-object mutation"
        if (isinstance(value,ast.Subscript) and isinstance(value.ctx,(ast.Store,ast.Del))
                and isinstance(value.value,ast.Name) and value.value.id in fresh_names):
            parent=parents.get(id(value))
            if isinstance(parent,(ast.Assign,ast.AnnAssign)):
                rhs=parent.value
                if tainted(rhs) or protected(rhs):
                    return False,"protected capability insertion into fresh namespace"
        if isinstance(value,ast.Subscript) and isinstance(value.ctx,(ast.Store,ast.Del)) \
                and (tainted(value.value) or protected(value.value)):
            if (isinstance(value.value,ast.Name) and value.value.id in fresh_names
                    and not tainted(value.value)):
                parent=parents.get(id(value))
                if isinstance(parent,(ast.Assign,ast.AnnAssign)):
                    rhs=parent.value
                    if tainted(rhs) or protected(rhs):
                        return False,"protected capability insertion into fresh namespace"
                continue
            if (isinstance(value.value,ast.Attribute)
                    and isinstance(value.value.value,ast.Name)
                    and value.value.value.id=="os" and value.value.attr=="environ"):
                allowed_top=isinstance(top,ast.FunctionDef) and top.name in {
                    "r15_remote_boundary_selftests","r15_product_scope_selftests"}
                allowed_key=(isinstance(value.slice,ast.Constant)
                             and value.slice.value=="SSH_AUTH_SOCK"
                             or isinstance(value.slice,ast.Name) and value.slice.id=="key")
                if allowed_top and allowed_key: continue
            return False,"reflective namespace mapping mutation"
        if isinstance(value,ast.Call):
            name=ast.unparse(value.func)
            transferred=[*value.args,*(item.value for item in value.keywords)]
            readonly_vars=(isinstance(value.func,ast.Name) and value.func.id=="len"
                           and len(value.args)==1 and isinstance(value.args[0],ast.Call)
                           and isinstance(value.args[0].func,ast.Name)
                           and value.args[0].func.id=="vars")
            if any(any(isinstance(item,ast.Name) and item.id in reflective_helpers
                       for item in ast.walk(argument)) for argument in transferred):
                return False,"reflective helper capability transfer"
            if any(tainted(argument) for argument in transferred) and not readonly_vars:
                return False,"reflective helper capability transfer"
            if any(isinstance(argument,ast.Lambda) and any(
                    isinstance(item,ast.Name) and item.id in reflective_names
                    or isinstance(item,ast.Attribute) and item.attr in {
                        "_getframe","currentframe","f_globals","f_locals","f_builtins",
                        "__globals__","__getattribute__"}
                    for item in ast.walk(argument)) for argument in transferred):
                return False,"reflective callback capability transfer"
            exact_status_hmac=(isinstance(top,ast.FunctionDef)
                               and top.name=="r15_cli_runpy_fault"
                               and ast.unparse(value) in {
                                   "hmac.new(status_key, canonical_json_bytes(unsigned), hashlib.sha256)",
                                   "hmac.new(status_key, canonical_json_bytes(unsigned), hashlib.sha256).hexdigest()",
                                   "hmac.compare_digest(terminal['mac'], expected_mac)"})
            if (tainted(value.func) and not exact_status_hmac
                    and not (env_verified and id(value) in env_call_ids)):
                return False,"reflective recovered capability invocation"
            if (isinstance(value.func,ast.Attribute)
                    and value.func.attr in {"__setattr__","__delattr__"}
                    and (protected(value.func.value)
                         or isinstance(value.func.value,ast.Call)
                            and isinstance(value.func.value.func,ast.Name)
                            and value.func.value.func.id=="type"
                            and value.func.value.args
                            and protected(value.func.value.args[0]))):
                return False,"reflective inherited-object mutation"
            if (isinstance(value.func,ast.Call) and isinstance(value.func.func,ast.Name)
                    and value.func.func.id=="type" and value.func.args
                    and (protected(value.func.args[0])
                         or isinstance(value.func.args[0],ast.Lambda))):
                return False,"reflective dynamic callable construction"
            if (isinstance(value.func,ast.Call)
                    and isinstance(value.func.func,ast.Name)
                    and value.func.func.id=="getattr" and len(value.func.args)>=2
                    and protected(value.func.args[0])
                    and isinstance(value.func.args[1],ast.Constant)
                    and value.func.args[1].value in {"__setattr__","__delattr__"}):
                return False,"reflective inherited-object mutation"
            if (isinstance(value.func,ast.Attribute)
                    and isinstance(value.func.value,ast.Name)
                    and value.func.value.id in {"dict","object"}
                    and value.func.attr in {"update","clear","pop","popitem","setdefault",
                                            "__setitem__","__delitem__","__setattr__",
                                            "__delattr__"} and value.args
                    and (tainted(value.args[0]) or protected(value.args[0]))):
                return False,"reflective descriptor mutation"
            if name in {"setattr","delattr","object.__setattr__"} and value.args:
                attribute=value.args[1].value if len(value.args)>1 \
                    and isinstance(value.args[1],ast.Constant) else None
                if (tainted(value.args[0]) or protected(value.args[0])
                        or attribute in magic or name=="object.__setattr__"):
                    return False,"reflective inherited-object mutation"
            if isinstance(value.func,ast.Attribute) and value.func.attr in {
                    "update","clear","pop","popitem","setdefault","__setitem__",
                    "__delitem__","__ior__"} and (tainted(value.func.value)
                        or protected(value.func.value)):
                if (isinstance(value.func.value,ast.Name)
                        and value.func.value.id in fresh_names
                        and not tainted(value.func.value)):
                    continue
                if (isinstance(value.func.value,ast.Attribute)
                        and isinstance(value.func.value.value,ast.Name)
                        and value.func.value.value.id=="os"
                        and value.func.value.attr=="environ"):
                    allowed_top=isinstance(top,ast.FunctionDef) and top.name in {
                        "r15_remote_boundary_selftests","r15_product_scope_selftests"}
                    allowed_call=(value.func.attr=="update" and len(value.args)==1
                                  and not value.keywords
                                  and (isinstance(value.args[0],ast.DictComp)
                                       or isinstance(value.args[0],ast.Name)
                                          and value.args[0].id=="hostile")
                                  or value.func.attr=="pop" and len(value.args)==2
                                     and not value.keywords
                                     and (isinstance(value.args[0],ast.Name)
                                          and value.args[0].id=="key"
                                          or isinstance(value.args[0],ast.Constant)
                                             and value.args[0].value=="SSH_AUTH_SOCK"))
                    if allowed_top and allowed_call: continue
                return False,"reflective namespace mapping mutation"
            if (isinstance(value.func,ast.Attribute)
                    and value.func.attr in {"append","extend","insert","remove","clear","pop",
                                            "__setitem__","__delitem__","update"}
                    and isinstance(value.func.value,ast.Attribute)
                    and value.func.value.attr in {"path","meta_path","path_hooks",
                                                   "path_importer_cache","argv"}
                    and protected(value.func.value.value)):
                return False,"reflective namespace mapping mutation"
            if (isinstance(value.func,ast.Attribute)
                    and value.func.attr in {"append","extend","insert","remove","clear",
                                            "pop","__setitem__","__delitem__","update"}
                    and isinstance(value.func.value,ast.Attribute)
                    and isinstance(value.func.value.value,ast.Name)
                    and value.func.value.value.id=="sys"
                    and value.func.value.attr in {"path","meta_path","path_hooks",
                                                   "path_importer_cache","argv"}):
                return False,"unreviewed parent-process state mutation"
    return True,"closed mutation/alias and definition-time family"


def r15_gate_normalized_altered_definition(base: ast.AST,
                                           candidate: ast.AST) -> tuple[ast.AST | None,str]:
    name=base.name
    normalized=copy.deepcopy(candidate)
    r17_exact={
        "observe_provider":"2cf7339a3e21d6cb3b3909fc8e39594ffea02a54759f341df32b6f4eb75f70c8",
        "observe_provider_lifetime":"9742c720051314888c579510023e6aeee57be0ab4c552aef1ee4070280326e38",
        "observer_selftests":"7ae21d4c1ff74f326ca76c56190e9a2bcbbf0936c2f6380c359ad65e1e81a36a",
        "loop_fixture":"1e68b71f70ec3ba7cee44332413a2082b947eea641e2f78ced4104a9e9c68dbf",
        "real_routing":"23ba354b6f09d158e806314a595440f49ebec8ce899a77db15ab3a789d739265",
        "owner_acceptance":"9d0d2c11282ee802228dfa9e49b684ce304ef87926972909784cb2d24d9c9b86",
    }
    if name in r17_exact:
        if r15_ast_sha256(normalized)!=r17_exact[name]:
            return None,"R17 exact reviewed island AST"
        return copy.deepcopy(base),"exact reviewed inherited-definition island"
    if name=="strict_json_bytes":
        if (not isinstance(normalized,ast.FunctionDef) or len(normalized.body)!=5
                or not isinstance(normalized.body[0],ast.FunctionDef)
                or normalized.body[0].name!="pairs"):
            return None,"strict JSON reviewed island shape"
        normalized.body=[normalized.body[0],copy.deepcopy(base.body[-1])]
    elif name=="filesystem_snapshot":
        base_visit=r15_gate_nested_function(base,"visit")
        normalized_visit=r15_gate_nested_function(normalized,"visit")
        if (base_visit is None or normalized_visit is None
                or len(base_visit.body)<3 or len(normalized_visit.body)<3):
            return None,"filesystem snapshot visit island shape"
        base_regular=r15_gate_regular_branch(base_visit)
        normalized_regular=r15_gate_regular_branch(normalized_visit)
        if base_regular is None or normalized_regular is None or len(base_regular.body)!=2:
            return None,"filesystem snapshot regular island shape"
        expected=copy.deepcopy(base)
        expected_visit=r15_gate_nested_function(expected,"visit")
        expected_regular=r15_gate_regular_branch(expected_visit) if expected_visit else None
        if expected_visit is None or expected_regular is None:
            return None,"filesystem snapshot immutable base shape"
        expected_visit.body[1]=ast.parse(
            'metadata = (f"mode={stat.S_IMODE(info.st_mode):04o}:uid={info.st_uid}:gid={info.st_gid}"\n'
            '            f":dev={info.st_dev}:ino={info.st_ino}:nlink={info.st_nlink}")').body[0]
        cache=ast.parse(
            'cache_key=(str(item),info.st_dev,info.st_ino,info.st_size,info.st_mtime_ns,info.st_ctime_ns)\n'
            'digest=R15_SNAPSHOT_DIGEST_CACHE.get(cache_key)\n'
            'if digest is None:\n'
            ' digest=hashlib.sha256(item.read_bytes()).hexdigest()\n'
            ' R15_SNAPSHOT_DIGEST_CACHE[cache_key]=digest').body
        expected_regular.body=cache+[copy.deepcopy(expected_regular.body[-1])]
        ast.fix_missing_locations(expected)
        if ast.dump(normalized,annotate_fields=True,include_attributes=False)!=ast.dump(
                expected,annotate_fields=True,include_attributes=False):
            return None,"filesystem snapshot exact physical metadata and cache AST"
        return copy.deepcopy(base),"exact reviewed inherited-definition island"
    elif name=="snapshot_selftests":
        if not isinstance(normalized,ast.FunctionDef) or not isinstance(base,ast.FunctionDef):
            return None,"snapshot selftests island type"
        expected=copy.deepcopy(base)
        if len(expected.body)!=2 or not isinstance(expected.body[1],ast.With):
            return None,"snapshot selftests immutable base shape"
        body=expected.body[1].body
        cleanup=body[11].value.args[0]
        if not isinstance(cleanup,ast.Compare) or not isinstance(cleanup.comparators[0],ast.List):
            return None,"snapshot selftests immutable cleanup shape"
        cleanup.comparators[0].elts.insert(0,ast.Constant("."))
        body.insert(17,ast.parse("link_baseline = filesystem_snapshot(root)").body[0])
        body[21]=ast.parse(ast.unparse(body[21]).replace(
            "snapshot_delta(baseline, changed_link)",
            "snapshot_delta(link_baseline, changed_link)")).body[0]
        body.insert(24,ast.parse("mode_baseline = filesystem_snapshot(root)").body[0])
        body[27]=ast.parse(ast.unparse(body[27]).replace(
            "snapshot_delta(baseline, changed_mode)",
            "snapshot_delta(mode_baseline, changed_mode)")).body[0]
        baseline_index=next(index for index,value in enumerate(body)
            if isinstance(value,ast.Assign) and any(isinstance(target,ast.Name)
                and target.id=="baseline" for target in value.targets))
        leaf_projection=ast.parse(
            'payload_info=os.lstat(payload)\n'
            'check(r15_json_equal(r15_leaf_state(payload),{\n'
            ' "dev":payload_info.st_dev,"ino":payload_info.st_ino,\n'
            ' "mode":payload_info.st_mode,"uid":payload_info.st_uid,\n'
            ' "gid":payload_info.st_gid,"nlink":payload_info.st_nlink,\n'
            ' "size":payload_info.st_size,\n'
            ' "sha256":hashlib.sha256(payload.read_bytes()).hexdigest()}),\n'
            ' "J_R15_GLOBAL_LEAF_STATE_EXACT_REGULAR_PROJECTION")').body
        body[baseline_index+1:baseline_index+1]=leaf_projection
        ast.fix_missing_locations(expected)
        if ast.dump(normalized,annotate_fields=True,include_attributes=False)!=ast.dump(
                expected,annotate_fields=True,include_attributes=False):
            return None,"snapshot selftests exact reviewed AST"
        return copy.deepcopy(base),"exact reviewed inherited-definition island"
    elif name=="frozen_checks":
        if not isinstance(normalized,ast.FunctionDef):
            return None,"frozen checks island type"
        wrapper_calls=[]
        for statement in normalized.body:
            for value in ast.walk(statement):
                if (isinstance(value,ast.Call) and isinstance(value.func,ast.Name)
                        and value.func.id=="r29_bpam_document"):
                    wrapper_calls.append((statement,value))
        if ([ast.unparse(statement) for statement,_call in wrapper_calls]!=[
                "bpam_ok, bpam_why, bpam_contract = r29_bpam_document(delegation_raw)",
                "if bpam_ok and isinstance(bpam_contract, dict):\n"
                "    r29_bpam_document(delegation_raw, bpam_contract)\n"
                "else:\n"
                "    check(False, 'J_BPAM_MACHINE_CONTRACT_POSITIVE', bpam_why)"]):
            return None,"frozen checks exact R29 BPAM wrapper island"
        wrapper_calls[0][1].func.id="bpam_document"
        wrapper_calls[1][1].func.id="bpam_selftests"
        anchors=[index for index,statement in enumerate(normalized.body)
                 if r15_gate_call_name(statement)=="r14_contract_selftests"]
        if len(anchors)!=1: return None,"R14 selftest anchor cardinality"
        start=anchors[0]+1;r29_island=normalized.body[start:start+3]
        if (len(r29_island)!=3 or not isinstance(r29_island[0],ast.Assign)
                or [r15_gate_call_name(value) for value in r29_island[1:]]!=[
                    "check","r29_contract_selftests"]):
            return None,"frozen checks exact R29 island"
        r29_targets=[value.id for target in r29_island[0].targets
                     for value in ast.walk(target)
                     if isinstance(value,ast.Name) and isinstance(value.ctx,ast.Store)]
        if r29_targets!=["r29_contract"]:
            return None,"frozen checks R29 contract binding"
        del normalized.body[start:start+3]
        r33_island=normalized.body[start:start+3]
        if (len(r33_island)!=3 or not isinstance(r33_island[0],ast.Assign)
                or [r15_gate_call_name(value) for value in r33_island[1:]]!=[
                    "check","r33_contract_selftests"]):
            return None,"frozen checks exact R33 island"
        r33_targets=[value.id for target in r33_island[0].targets
                     for value in ast.walk(target)
                     if isinstance(value,ast.Name) and isinstance(value.ctx,ast.Store)]
        if r33_targets!=["r33_contract"]:
            return None,"frozen checks R33 contract binding"
        del normalized.body[start:start+3]
        island=normalized.body[start:start+6]
        if (len(island)!=6 or not isinstance(island[0],ast.Assign)
                or [r15_gate_call_name(value) for value in island[1:]] != [
                    "r15_contract_selftests","r15_document_append_selftests",
                    "r15_parallel_cli_selftests","r15_schema_selftests",
                    "r15_h036_derivation_selftests"]):
            return None,"frozen checks exact R15 island"
        targets=[value.id for target in island[0].targets for value in ast.walk(target)
                 if isinstance(value,ast.Name) and isinstance(value.ctx,ast.Store)]
        if targets != ["r15_contract"]:
            return None,"frozen checks R15 contract binding"
        del normalized.body[start:start+6]
    elif name=="main":
        if (not isinstance(normalized,ast.FunctionDef) or not normalized.body
                or not isinstance(normalized.body[0],ast.Try)
                or not isinstance(base,ast.FunctionDef) or not base.body
                or not isinstance(base.body[0],ast.Try)):
            return None,"main reviewed island shape"
        body=normalized.body[0].body; base_body=base.body[0].body
        if not body or r15_gate_call_name(body[0])!="r15_require_ast_interpreter":
            return None,"main interpreter authority must be first"
        del body[0]
        owner_indices=[index for index,statement in enumerate(body)
                       if isinstance(statement,ast.If)
                       and any(isinstance(value,ast.Constant)
                               and value.value=="--owner-acceptance"
                               for value in ast.walk(statement.test))]
        base_owner=[statement for statement in base_body if isinstance(statement,ast.If)
                    and any(isinstance(value,ast.Constant)
                            and value.value=="--owner-acceptance"
                            for value in ast.walk(statement.test))]
        exact_owner=ast.parse(
            'if len(sys.argv) == 4 and sys.argv[1] == "--owner-acceptance":\n'
            ' return owner_acceptance(sys.argv[2], Path(sys.argv[3]))').body[0]
        if (len(owner_indices)!=1 or len(base_owner)!=1
                or r15_ast_sha256(body[owner_indices[0]])!=r15_ast_sha256(exact_owner)):
            return None,"main exact unresolved owner artifact path"
        body[owner_indices[0]]=copy.deepcopy(base_owner[0])
        r15_indices=[index for index,statement in enumerate(body)
                     if isinstance(statement,ast.If)
                     and any(isinstance(value,ast.Constant)
                             and value.value=="--r15-owner-product-lifecycle"
                             for value in ast.walk(statement.test))]
        if len(r15_indices)!=1: return None,"main R15 dispatch cardinality"
        del body[r15_indices[0]]
        r29_indices=[index for index,statement in enumerate(body)
                     if isinstance(statement,ast.If)
                     and any(isinstance(value,ast.Constant)
                             and value.value=="--r29-registry-migration"
                             for value in ast.walk(statement.test))]
        if len(r29_indices)!=1:return None,"main R29 dispatch cardinality"
        del body[r29_indices[0]]
        r33_indices=[index for index,statement in enumerate(body)
                     if isinstance(statement,ast.If)
                     and any(isinstance(value,ast.Constant)
                             and value.value=="--r33-registry-migration"
                             for value in ast.walk(statement.test))]
        if len(r33_indices)!=1:return None,"main R33 dispatch cardinality"
        del body[r33_indices[0]]
        base_usage=[statement for statement in base_body if isinstance(statement,ast.If)
                    and ast.unparse(statement.test)=="len(sys.argv) != 1"]
        usage_indices=[index for index,statement in enumerate(body)
                       if isinstance(statement,ast.If)
                       and ast.unparse(statement.test)=="len(sys.argv) != 1"]
        if len(base_usage)!=1 or len(usage_indices)!=1:
            return None,"main base usage normalization"
        body[usage_indices[0]]=copy.deepcopy(base_usage[0])
    else:
        return None,"unexpected altered inherited definition"
    return normalized,"exact reviewed inherited-definition island"


def r15_gate_historical_floor(candidate: ast.Module,
                              manifest: dict[str, object]) -> tuple[bool,str]:
    definitions=[node for node in candidate.body if isinstance(node,ast.FunctionDef)
                 and node.name=="r15_historical_regression_floor"]
    if len(definitions)!=1: return False,"historical floor definition cardinality"
    floor=definitions[0]
    expected_calls=[
        "path_selftests","observer_selftests","snapshot_selftests",
        "r14_registry_migration_controls","real_routing","production_matrix",
        "remediation_matrix","r6_remediation_matrix","r9_task_gate_matrix",
        "publication_contract_controls"]
    if (len(floor.body)!=11 or not isinstance(floor.body[0],ast.Expr)
            or not isinstance(floor.body[0].value,ast.Constant)
            or floor.body[0].value.value !=
                "The complete historical H035/R14 floor shared by both R15 modes."
            or [r15_gate_call_name(value) for value in floor.body[1:]]!=expected_calls
            or any(not isinstance(value,ast.Expr) for value in floor.body[1:])):
        return False,"historical floor direct ordered calls only"
    for index,statement in enumerate(floor.body[1:]):
        call=statement.value
        if (index<3 and (call.args or call.keywords)) or (index>=3 and (
                len(call.args)!=1 or not isinstance(call.args[0],ast.Name)
                or call.args[0].id!="tmp" or call.keywords)):
            return False,"historical floor exact arguments"
    expected=manifest.get("historical_floor",{})
    if (not isinstance(expected,dict)
            or expected.get("ast_sha256")!=r15_ast_sha256(floor)
            or expected.get("ordered_calls")!=expected_calls):
        return False,"historical floor manifest"
    return True,"exact inherited H035/R14 historical floor"


def r15_gate_main_dominance(candidate: ast.Module) -> tuple[bool,str]:
    mains=[node for node in candidate.body if isinstance(node,ast.FunctionDef)
           and node.name=="main"]
    if len(mains)!=1 or not mains[0].body or not isinstance(mains[0].body[0],ast.Try):
        return False,"main dominance shape"
    calls=[node for node in ast.walk(mains[0]) if isinstance(node,ast.Call)
           and isinstance(node.func,ast.Name)
           and node.func.id=="r15_historical_regression_floor"]
    if len(calls)!=1: return False,"historical floor main call cardinality"
    if (len(calls[0].args)!=1 or ast.unparse(calls[0].args[0])!="lanes['historical']"
            or calls[0].keywords):
        return False,"historical floor exact effect-free main argument"
    body=mains[0].body[0].body
    r15=[statement for statement in body if isinstance(statement,ast.If)
         and any(isinstance(value,ast.Constant)
                 and value.value=="--r15-owner-product-lifecycle"
                 for value in ast.walk(statement.test))]
    if len(r15)!=1: return False,"R15 main branch cardinality"
    withs=[value for value in r15[0].body if isinstance(value,ast.With)]
    if len(withs)!=1: return False,"R15 main retained fixture scope"
    inner=withs[0].body
    frozen=[index for index,value in enumerate(inner)
            if r15_gate_call_name(value)=="frozen_checks"]
    floor=[index for index,value in enumerate(inner)
           if r15_gate_call_name(value)=="r15_historical_regression_floor"]
    references=[index for index,value in enumerate(inner)
                if any(isinstance(call,ast.Call) and isinstance(call.func,ast.Name)
                       and call.func.id=="r15_reference_satisfiability"
                       for call in ast.walk(value))]
    product=[index for index,value in enumerate(inner)
             if isinstance(value,ast.If) and isinstance(value.test,ast.Name)
             and value.test.id=="product_bound"]
    if len(frozen)!=1 or len(floor)!=1 or len(references)!=1 or len(product)!=1:
        return False,"frozen checks/floor/reference/product dominance"
    frozen_call=inner[frozen[0]].value if isinstance(inner[frozen[0]],ast.Expr) else None
    if not isinstance(frozen_call,ast.Call) or frozen_call.args or frozen_call.keywords:
        return False,"frozen checks exact effect-free call"
    if (floor[0]!=frozen[0]+1 or not (floor[0]<references[0]<product[0])
            or not product[0]<len(inner) or r15[0].orelse):
        return False,"frozen checks/floor/reference/product dominance"
    if any(isinstance(value,(ast.Global,ast.Nonlocal,ast.Return,ast.Try))
           for value in ast.walk(calls[0])):
        return False,"historical floor call wrapper"
    for value in ast.walk(r15[0]):
        if isinstance(value,ast.Name) and isinstance(value.ctx,(ast.Store,ast.Del)) \
                and value.id in {"passed","failed","failed_labels"}:
            return False,"R15 branch failure-counter reset"
    return True,"frozen checks and complete floor dominate both R15 arms"


def r15_contract_pin_source_node(node: ast.AST) -> ast.AST:
    value=copy.deepcopy(node)
    if (isinstance(value,ast.Assign) and len(value.targets)==1
            and isinstance(value.targets[0],ast.Name)
            and value.targets[0].id=="H035_R15_CONTRACT_SHA256"
            and isinstance(value.value,ast.Constant) and isinstance(value.value.value,str)):
        value.value.value="<H035_R15_CONTRACT_SHA256_AUTHORITY_V1>"
    return value


def r15_gate_top_level_projection(base: ast.Module,
                                  candidate: ast.Module) -> tuple[list[dict[str,object]],list[str]]:
    base_defs=[node for node in base.body
               if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))]
    base_nondefs=[node for node in base.body
                  if not isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))]
    def_by_name={node.name:index for index,node in enumerate(base_defs)}
    nondef_by_hash={r15_ast_sha256(node):index for index,node in enumerate(base_nondefs)}
    new=[]; layout=[]
    for index,node in enumerate(candidate.body):
        projected=r15_contract_pin_source_node(node)
        if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)) \
                and node.name in def_by_name:
            layout.append("BASE_DEF:"+str(def_by_name[node.name]))
        elif r15_ast_sha256(projected) in nondef_by_hash:
            layout.append("BASE_NONDEF:"+str(nondef_by_hash[r15_ast_sha256(projected)]))
        else:
            row={"module_index":index,"kind":type(node).__name__,
                 "binding_names":list(r15_binding_names(node)),
                 "ast_sha256":r15_ast_sha256(projected)}
            layout.append("NEW:"+str(len(new))); new.append(row)
    return new,layout


def r15_gate_definition_inheritance(base_defs: list[ast.AST],
                                    candidate_defs: list[ast.AST]) -> tuple[bool,str]:
    candidate_by_name={}
    for node in candidate_defs: candidate_by_name.setdefault(node.name,[]).append(node)
    positions=[]
    for base_node in base_defs:
        hits=candidate_by_name.get(base_node.name,[])
        if len(hits)!=1: return False,"inherited definition missing/duplicate: "+base_node.name
        node=hits[0]; positions.append(candidate_defs.index(node))
        if base_node.name not in H035_R15_GATE_ALTERED_DEFINITIONS:
            if r15_ast_sha256(node)!=r15_ast_sha256(base_node):
                return False,"inherited definition changed: "+base_node.name
        else:
            normalized,why=r15_gate_normalized_altered_definition(base_node,node)
            if normalized is None or r15_ast_sha256(normalized)!=r15_ast_sha256(base_node):
                return False,base_node.name+" retained-statement normalization: "+why
    if positions!=sorted(positions): return False,"inherited definition reorder"
    return True,"all inherited definitions exact"


def r15_gate_inheritance_bytes(base_raw: bytes, candidate_raw: bytes,
                               manifest: object) -> tuple[bool,str]:
    interpreter_ok,interpreter_why=r15_ast_interpreter_validate(
        H035_R15_AST_PYTHON,H035_R15_AST_PYTHON_SHA256,
        H035_R15_AST_PYTHON_VERSION,sys.executable,tuple(sys.version_info[:3]))
    if not interpreter_ok: return False,interpreter_why
    if (not base_raw.startswith(b'#!/usr/bin/env python3\n"""')
            or not candidate_raw.startswith(("#!"+str(H035_R15_AST_PYTHON)+"\n\"\"\"").encode("utf-8"))
            or any(re.search(br"coding\s*[:=]",line) is not None
                   for line in candidate_raw.splitlines()[:2])):
        return False,"exact UTF-8 Python source preamble"
    if not isinstance(manifest,dict): return False,"gate inheritance manifest type"
    policy=manifest.get("policy")
    if not isinstance(policy,dict) or not exact_value(policy,r15_gate_expected_policy()):
        return False,"exact complete gate inheritance policy"
    normalization_policy={
        "manifest_independent_admitted_definition_count":154,
        "manifest_independent_admitted_definition_aggregate_sha256":H035_R15_GATE_ADMITTED_DEFINITION_AGGREGATE,
        "manifest_independent_admitted_nondefinition_count":82,
        "manifest_independent_admitted_nondefinition_aggregate_sha256":H035_R15_GATE_ADMITTED_NONDEFINITION_AGGREGATE,
        "manifest_independent_complete_ordered_module_body_aggregate_sha256":H035_R15_GATE_ADMITTED_BODY_AGGREGATE,
        "complete_body_aggregate_normalizes_exactly_body_nondefinition_and_contract_digest_anchor_literals":True,
        "aggregate_anchor_literal_equals_trusted_runtime_constant_and_position_is_bound":True,
        "contract_digest_source_normalization_sentinel":"<H035_R15_CONTRACT_SHA256_AUTHORITY_V1>",
        "contract_digest_normalization_sites":[
            "admitted_new_top_level_ast_and_layout_projection",
            "manifest_independent_admitted_nondefinition_aggregate",
            "manifest_independent_complete_ordered_module_body_aggregate"],
        "contract_digest_normalizes_only_exact_one_simple_top_level_assignment_literal":True,
        "contract_digest_raw_binding_position_syntax_lowerhex_and_runtime_value_separately_exact":True,
        "contract_digest_literal_equals_full_owner_lifecycle_canonical_json_sha256":True,
    }
    if (not isinstance(policy,dict)
            or not exact_value({key:value for key,value in policy.items()
                if key in normalization_policy or key.startswith("manifest_independent_")
                or key.startswith("contract_digest_")
                or key.startswith("complete_body_aggregate_")
                or key.startswith("aggregate_anchor_literal_")},normalization_policy)):
        return False,"exact contract digest normalization policy"
    try:
        base_text=base_raw.decode("utf-8",errors="strict")
        candidate_text=candidate_raw.decode("utf-8",errors="strict")
        if "\x00" in base_text or "\x00" in candidate_text:
            return False,"gate inheritance source NUL"
        base=ast.parse(base_text,filename="base h035 gate",mode="exec")
        candidate=ast.parse(candidate_text,filename="candidate h035 gate",mode="exec")
    except (UnicodeDecodeError,SyntaxError,ValueError) as exc:
        return False,"gate inheritance strict Python AST: "+str(exc)
    contract_pins=[(index,node) for index,node in enumerate(candidate.body)
        if isinstance(node,ast.Assign) and len(node.targets)==1
        and isinstance(node.targets[0],ast.Name)
        and node.targets[0].id=="H035_R15_CONTRACT_SHA256"]
    pin_bindings,pin_deletions=r15_gate_module_binding_events(candidate)
    if (len(contract_pins)!=1 or contract_pins[0][0]!=83
            or pin_bindings.count("H035_R15_CONTRACT_SHA256")!=1
            or "H035_R15_CONTRACT_SHA256" in pin_deletions
            or not isinstance(contract_pins[0][1].value,ast.Constant)
            or type(contract_pins[0][1].value.value) is not str
            or re.fullmatch(r"[0-9a-f]{64}",contract_pins[0][1].value.value) is None
            or contract_pins[0][1].value.value!=H035_R15_CONTRACT_SHA256
            or contract_pins[0][1].lineno!=contract_pins[0][1].end_lineno
            or candidate_text.splitlines()[contract_pins[0][1].lineno-1]
                !=f'H035_R15_CONTRACT_SHA256 = "{H035_R15_CONTRACT_SHA256}"'):
        return False,"exact contract digest source authority binding"
    base_defs=[node for node in base.body
               if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))]
    candidate_defs=[node for node in candidate.body
                    if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))]
    base_nondefs=[node for node in base.body
                  if not isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))]
    unchanged=[node for node in base_defs if node.name not in H035_R15_GATE_ALTERED_DEFINITIONS]
    base_authority=manifest.get("base_gate_authority")
    expected_base={
        "commit":H035_R15_BASE,"path":"verify/bin/h-035-exit",
        "blob_oid":H035_R15_GATE_BASE_BLOB_OID,"sha256":H035_R15_GATE_BASE_SHA256,
        "top_level_def_or_class_count":64,
        "all_definition_rows_sha256":H035_R15_GATE_BASE_DEF_AGGREGATE,
        "ordered_definition_name_sha256":H035_R15_GATE_BASE_DEF_NAME_DIGEST,
        "unchanged_definition_count":53,
        "unchanged_definition_rows_sha256":H035_R15_GATE_UNCHANGED_DEF_AGGREGATE,
        "top_level_nondefinition_count":52,
        "nondefinition_ast_list_sha256":H035_R15_GATE_BASE_NONDEF_DIGEST,
        "definition_rows":[r15_gate_definition_row(node) for node in base_defs],
        "nondefinition_ast_sha256":[r15_ast_sha256(node) for node in base_nondefs]}
    names=[node.name for node in base_defs]
    if (hashlib.sha256(base_raw).hexdigest()!=H035_R15_GATE_BASE_SHA256
            or len(base_defs)!=64 or len(base_nondefs)!=52
            or r15_gate_definition_aggregate(base_defs)!=H035_R15_GATE_BASE_DEF_AGGREGATE
            or hashlib.sha256(json.dumps(names,separators=(",",":")).encode()).hexdigest()
                != H035_R15_GATE_BASE_DEF_NAME_DIGEST
            or r15_gate_definition_aggregate(unchanged)!=H035_R15_GATE_UNCHANGED_DEF_AGGREGATE
            or r15_gate_nondefinition_digest(base_nondefs)!=H035_R15_GATE_BASE_NONDEF_DIGEST
            or not exact_value(base_authority,expected_base)):
        return False,"exact inherited base gate authority/manifest"
    definitions_ok,definitions_why=r15_gate_definition_inheritance(base_defs,candidate_defs)
    if not definitions_ok: return False,definitions_why
    candidate_by_name={}
    for node in candidate_defs: candidate_by_name.setdefault(node.name,[]).append(node)
    base_non_hashes=[r15_ast_sha256(node) for node in base_nondefs]
    candidate_hashes=[r15_ast_sha256(node) for node in candidate.body]
    nondef_positions=[]
    for digest in base_non_hashes:
        hits=[index for index,value in enumerate(candidate_hashes) if value==digest]
        if len(hits)!=1: return False,"base nondefinition missing/duplicate"
        nondef_positions.append(hits[0])
    if nondef_positions!=sorted(nondef_positions):
        return False,"base nondefinition reorder"
    if (candidate_hashes[-1]!=base_non_hashes[-1]
            or not isinstance(candidate.body[-1],ast.If)):
        return False,"exact terminal inherited main guard"
    base_bindings,base_deletions=r15_gate_module_binding_events(base)
    candidate_bindings,candidate_deletions=r15_gate_module_binding_events(candidate)
    candidate_definition_counts={name:len(nodes) for name,nodes in candidate_by_name.items()}
    for name,count in candidate_definition_counts.items():
        if candidate_bindings.count(name)!=count or name in candidate_deletions:
            return False,"admitted definition/class binding cardinality"
    inherited=set(base_bindings)
    if base_deletions or inherited.intersection(candidate_deletions):
        return False,"inherited top-level binding deletion"
    for name in set(base_bindings):
        if candidate_bindings.count(name)!=base_bindings.count(name):
            return False,"inherited top-level binding mutation: "+name
    base_def_names={node.name for node in base_defs}
    inherited_authority=set(base_def_names)
    for node in base.body:
        if isinstance(node,ast.Import):
            inherited_authority.update(item.asname or item.name.split(".",1)[0]
                                       for item in node.names)
        elif isinstance(node,ast.ImportFrom):
            inherited_authority.update(item.asname or item.name for item in node.names)
    base_imports={(type(node).__name__,item.name) for node in base.body
                  if isinstance(node,(ast.Import,ast.ImportFrom)) for item in node.names}
    candidate_import_rows=[(type(node).__name__,node.module if isinstance(node,ast.ImportFrom)
                            else None,tuple((item.name,item.asname) for item in node.names))
                           for node in candidate.body if isinstance(node,(ast.Import,ast.ImportFrom))]
    if sum(isinstance(node,(ast.Import,ast.ImportFrom)) for node in ast.walk(candidate)) \
            != len(candidate_import_rows):
        return False,"nested or conditional import capability"
    base_import_rows=[(type(node).__name__,node.module if isinstance(node,ast.ImportFrom)
                       else None,tuple((item.name,item.asname) for item in node.names))
                      for node in base.body if isinstance(node,(ast.Import,ast.ImportFrom))]
    new_import_rows=[row for row in candidate_import_rows if row not in base_import_rows]
    expected_new_imports=[("Import",None,((name,None),)) for name in (
        "ast","base64","copy","fcntl","hmac")]+[
        ("Import",None,(("importlib._bootstrap_external","bootstrap_external"),)),
        ("Import",None,(("importlib.util",None),)),
    ]+[("Import",None,((name,None),)) for name in (
        "pwd","resource","select","signal","socket","sqlite3")]
    if new_import_rows!=expected_new_imports:
        return False,"exact closed new import capability surface"
    for top in candidate.body:
        inherited_exact=(isinstance(top,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))
                         and top.name in base_def_names
                         and top.name not in H035_R15_GATE_ALTERED_DEFINITIONS)
        r17_exact_island=(isinstance(top,ast.FunctionDef) and top.name in {
            "observe_provider","observe_provider_lifetime","observer_selftests",
            "loop_fixture","real_routing","owner_acceptance"})
        if (inherited_exact or r17_exact_island
                or r15_ast_sha256(top) in set(base_non_hashes)):
            continue
        closed,closed_why=r15_gate_closed_mutation_family(top,inherited_authority)
        if not closed: return False,closed_why
        values=[]
        if isinstance(top,ast.Assign): values=[top.value]
        elif isinstance(top,ast.AnnAssign) and top.value is not None: values=[top.value]
        elif isinstance(top,ast.NamedExpr): values=[top.value]
        if any(r15_gate_direct_alias(value,inherited) for value in values):
            return False,"inherited top-level value alias"
        if (isinstance(top,(ast.Import,ast.ImportFrom))
                and any((type(top).__name__,item.name) in base_imports for item in top.names)):
            return False,"inherited import capability alias"
        for node in ast.walk(top):
            if isinstance(node,(ast.Global,ast.Nonlocal)) and inherited.intersection(node.names):
                return False,"inherited global/nonlocal rebinding"
            if isinstance(node,ast.Attribute) and isinstance(node.ctx,(ast.Store,ast.Del)):
                root=node.value
                while isinstance(root,ast.Attribute): root=root.value
                if (node.attr=="__code__" or isinstance(root,ast.Name)
                        and root.id in inherited):
                    return False,"inherited module/__code__ attribute mutation"
            if (isinstance(node,ast.Subscript) and isinstance(node.ctx,(ast.Store,ast.Del))
                    and isinstance(node.value,ast.Call) and isinstance(node.value.func,ast.Name)
                    and node.value.func.id=="globals"):
                return False,"inherited globals mutation"
            if (isinstance(node,ast.Subscript) and isinstance(node.ctx,(ast.Store,ast.Del))
                    and isinstance(node.value,ast.Call) and isinstance(node.value.func,ast.Name)
                    and node.value.func.id=="vars" and node.value.args
                    and isinstance(node.value.args[0],ast.Name)
                    and node.value.args[0].id in inherited):
                return False,"inherited module attribute mapping mutation"
            if (isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
                    and node.func.id in {"setattr","delattr"} and node.args
                    and isinstance(node.args[0],ast.Name)
                    and node.args[0].id in inherited):
                return False,"inherited module/__code__ attribute mutation"
    floor_ok,floor_why=r15_gate_historical_floor(candidate,manifest)
    if not floor_ok: return False,floor_why
    dominance_ok,dominance_why=r15_gate_main_dominance(candidate)
    if not dominance_ok: return False,dominance_why
    islands=manifest.get("reviewed_islands")
    if not isinstance(islands,dict): return False,"reviewed island manifest type"
    for name in H035_R15_GATE_ALTERED_DEFINITIONS:
        rows=candidate_by_name.get(name,[]); island=islands.get(name)
        base_node=next(node for node in base_defs if node.name==name)
        if (len(rows)!=1 or not isinstance(island,dict)
                or island.get("candidate_ast_sha256")!=r15_ast_sha256(rows[0])
                or island.get("normalized_base_ast_sha256")!=r15_ast_sha256(base_node)):
            return False,"reviewed island exact AST manifest: "+name
    new,layout=r15_gate_top_level_projection(base,candidate)
    if (manifest.get("admitted_new_top_level")!=new
            or manifest.get("top_level_layout_sha256")!=hashlib.sha256(json.dumps(
                layout,separators=(",",":")).encode("utf-8")).hexdigest()):
        return False,"admitted new top-level AST manifest"
    unchanged_names={node.name for node in unchanged}
    admitted_definitions=[node for node in candidate_defs if node.name not in unchanged_names]
    if (len(admitted_definitions)
            != policy["manifest_independent_admitted_definition_count"]
            or r15_gate_definition_aggregate(admitted_definitions)
            != H035_R15_GATE_ADMITTED_DEFINITION_AGGREGATE):
        return False,"exact manifest-independent admitted definition authority"
    admitted_nondefinitions=[]
    base_nondefinition_set=set(base_non_hashes)
    nondef_authority_nodes=[node for node in candidate.body
        if isinstance(node,ast.Assign) and len(node.targets)==1
        and isinstance(node.targets[0],ast.Name)
        and node.targets[0].id=="H035_R15_GATE_ADMITTED_NONDEFINITION_AGGREGATE"]
    if (len(nondef_authority_nodes)!=1
            or not isinstance(nondef_authority_nodes[0].value,ast.Constant)
            or not isinstance(nondef_authority_nodes[0].value.value,str)
            or re.fullmatch(r"[0-9a-f]{64}",nondef_authority_nodes[0].value.value) is None):
        return False,"exact nondefinition aggregate authority binding"
    body_authority_nodes=[node for node in candidate.body
        if isinstance(node,ast.Assign) and len(node.targets)==1
        and isinstance(node.targets[0],ast.Name)
        and node.targets[0].id=="H035_R15_GATE_ADMITTED_BODY_AGGREGATE"]
    if (len(body_authority_nodes)!=1
            or not isinstance(body_authority_nodes[0].value,ast.Constant)
            or not isinstance(body_authority_nodes[0].value.value,str)
            or re.fullmatch(r"[0-9a-f]{64}",body_authority_nodes[0].value.value) is None
            or body_authority_nodes[0].value.value!=H035_R15_GATE_ADMITTED_BODY_AGGREGATE
            or nondef_authority_nodes[0].value.value
                !=H035_R15_GATE_ADMITTED_NONDEFINITION_AGGREGATE):
        return False,"exact ordered-body aggregate authority binding"
    for node in candidate.body:
        if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)):
            continue
        projected=r15_contract_pin_source_node(node)
        if r15_ast_sha256(projected) in base_nondefinition_set:
            continue
        if node is nondef_authority_nodes[0]:
            continue
        admitted_nondefinitions.append({"kind":type(node).__name__,
                                        "ast_sha256":r15_ast_sha256(projected)})
    nondef_digest=hashlib.sha256(json.dumps(admitted_nondefinitions,
        sort_keys=True,separators=(",",":")).encode("utf-8")).hexdigest()
    if (len(admitted_nondefinitions)
            != policy["manifest_independent_admitted_nondefinition_count"]
            or nondef_digest!=H035_R15_GATE_ADMITTED_NONDEFINITION_AGGREGATE):
        return False,"exact manifest-independent admitted nondefinition authority"
    normalized_body=copy.deepcopy(candidate.body)
    anchors={"H035_R15_GATE_ADMITTED_BODY_AGGREGATE":"<BODY_AUTHORITY>",
             "H035_R15_GATE_ADMITTED_NONDEFINITION_AGGREGATE":"<NONDEF_AUTHORITY>",
             "H035_R15_CONTRACT_SHA256":"<H035_R15_CONTRACT_SHA256_AUTHORITY_V1>"}
    seen={name:0 for name in anchors}
    for node in normalized_body:
        if (isinstance(node,ast.Assign) and len(node.targets)==1
                and isinstance(node.targets[0],ast.Name)
                and node.targets[0].id in anchors
                and isinstance(node.value,ast.Constant)
                and isinstance(node.value.value,str)):
            name=node.targets[0].id; seen[name]+=1
            node.value.value=anchors[name]
    if seen!={name:1 for name in anchors}:
        return False,"exact ordered-body aggregate anchors"
    body_digest=hashlib.sha256(ast.dump(ast.Module(
        body=normalized_body,type_ignores=[]),annotate_fields=True,
        include_attributes=False).encode("utf-8")).hexdigest()
    if body_digest!=H035_R15_GATE_ADMITTED_BODY_AGGREGATE:
        return False,"exact manifest-independent ordered module body authority"
    return True,"exact inherited H035/R14 gate plus reviewed R15 islands"


def r15_gate_inheritance_scope(repo: Path, base_sha: str,
                               candidate_sha: str) -> tuple[bool,str]:
    if base_sha!=H035_R15_BASE: return False,"gate inheritance base authority"
    oid=r15_git(repo,"rev-parse",f"{H035_R15_BASE}:verify/bin/h-035-exit")
    if oid.returncode or oid.stdout.strip()!=H035_R15_GATE_BASE_BLOB_OID:
        return False,"gate inheritance base blob oid"
    base_raw=r15_git_object_bytes(repo,H035_R15_BASE,"verify/bin/h-035-exit")
    candidate_raw=r15_git_object_bytes(repo,candidate_sha,"verify/bin/h-035-exit")
    spec_raw=r15_git_object_bytes(repo,candidate_sha,"specs/tasks.spec.json")
    if base_raw is None or candidate_raw is None or spec_raw is None:
        return False,"gate inheritance Git object missing"
    try:
        spec=strict_json_bytes(spec_raw)
        rows=[row for row in spec.get("tasks",[]) if isinstance(row,dict)
              and row.get("id")=="h-035"] if isinstance(spec,dict) else []
        contract=rows[0].get("r15_owner_product_lifecycle") if len(rows)==1 else None
        manifest=contract.get("gate_inheritance_scope") if isinstance(contract,dict) else None
    except (AttributeError,TypeError,ValueError,UnicodeError) as exc:
        return False,"gate inheritance manifest parse: "+str(exc)
    return r15_gate_inheritance_bytes(base_raw,candidate_raw,manifest)


def r15_gate_import_callable_identity(raw: bytes, name: str) -> str:
    text=raw.decode("utf-8",errors="strict")
    namespace={"__name__":"_h035_hr01_identity_oracle","__file__":str(Path(__file__))}
    exec(compile(text,"<h035-hr01-import-oracle>","exec"),namespace,namespace)
    value=namespace.get(name)
    code=getattr(value,"__code__",None)
    if not callable(value) or code is None: return "NOT_CALLABLE"
    def constant(item: object) -> object:
        if hasattr(item,"co_code") and hasattr(item,"co_consts"):
            return {"code":item.co_code.hex(),"consts":[constant(value)
                    for value in item.co_consts],"names":list(item.co_names),
                    "vars":list(item.co_varnames),"argcount":item.co_argcount,
                    "kwonly":item.co_kwonlyargcount,"flags":item.co_flags}
        if isinstance(item,(str,int,float,bool,bytes,type(None))):
            return item.hex() if isinstance(item,bytes) else item
        if isinstance(item,tuple): return [constant(value) for value in item]
        return type(item).__name__
    payload={"name":value.__name__,"qualname":value.__qualname__,
             "defaults":constant(value.__defaults__),
             "kwdefaults":constant(value.__kwdefaults__),"code":constant(code)}
    return hashlib.sha256(json.dumps(payload,sort_keys=True,separators=(",",":"),
        ensure_ascii=False).encode("utf-8")).hexdigest()


def r15_gate_mutant_source(candidate_raw: bytes, mutant: str) -> bytes:
    tree=ast.parse(candidate_raw.decode("utf-8",errors="strict"),mode="exec")
    def definition(name: str) -> ast.FunctionDef:
        hits=[node for node in tree.body if isinstance(node,ast.FunctionDef)
              and node.name==name]
        if len(hits)!=1: raise Rig("HR01 mutant definition "+name)
        return hits[0]
    def insert_before_guard(node: ast.stmt) -> None:
        if not tree.body or not isinstance(tree.body[-1],ast.If):
            raise Rig("HR01 mutant terminal guard")
        tree.body.insert(len(tree.body)-1,node)
    if mutant=="PRIOR_FLOOR_RETURN_NONE":
        floor=definition("r15_historical_regression_floor")
        floor.body=[floor.body[0],ast.Return(value=ast.Constant(None))]
    elif mutant=="UNCHANGED_DELETE":
        target=definition("path_selftests"); tree.body.remove(target)
    elif mutant=="UNCHANGED_DUPLICATE":
        target=definition("path_selftests")
        tree.body.insert(tree.body.index(target)+1,copy.deepcopy(target))
    elif mutant=="UNCHANGED_REORDER":
        left=definition("path_selftests"); right=definition("synchronized_provider_script")
        li,ri=tree.body.index(left),tree.body.index(right)
        tree.body[li],tree.body[ri]=tree.body[ri],tree.body[li]
    elif mutant=="UNCHANGED_ALTER":
        definition("synchronized_provider_script").body.append(ast.Pass())
    elif mutant=="ISLAND_STRICT_JSON":
        definition("strict_json_bytes").body.append(ast.Pass())
    elif mutant=="ISLAND_FILESYSTEM":
        definition("filesystem_snapshot").body.insert(-1,ast.Pass())
    elif mutant.startswith("ISLAND_FILESYSTEM_"):
        node=definition("filesystem_snapshot")
        visit=r15_gate_nested_function(node,"visit")
        regular=r15_gate_regular_branch(visit) if visit else None
        if visit is None or regular is None: raise Rig("HR01 filesystem mutant shape")
        metadata=next(value for value in visit.body if isinstance(value,ast.Assign)
                      and any(isinstance(target,ast.Name) and target.id=="metadata"
                              for target in value.targets))
        if mutant in {"ISLAND_FILESYSTEM_DROP_DEV","ISLAND_FILESYSTEM_DROP_INO",
                      "ISLAND_FILESYSTEM_DROP_NLINK"}:
            token={"ISLAND_FILESYSTEM_DROP_DEV":":dev={info.st_dev}",
                   "ISLAND_FILESYSTEM_DROP_INO":":ino={info.st_ino}",
                   "ISLAND_FILESYSTEM_DROP_NLINK":":nlink={info.st_nlink}"}[mutant]
            replacement=ast.parse(ast.unparse(metadata).replace(token,"" )).body[0]
            visit.body[visit.body.index(metadata)]=replacement
        else:
            cache_key=next(value for value in regular.body if isinstance(value,ast.Assign)
                           and any(isinstance(target,ast.Name) and target.id=="cache_key"
                                   for target in value.targets))
            if mutant in {"ISLAND_FILESYSTEM_CACHE_DROP_INO","ISLAND_FILESYSTEM_CACHE_DROP_MTIME"}:
                attr={"ISLAND_FILESYSTEM_CACHE_DROP_INO":"st_ino",
                      "ISLAND_FILESYSTEM_CACHE_DROP_MTIME":"st_mtime_ns"}[mutant]
                cache_key.value.elts=[value for value in cache_key.value.elts
                                      if not isinstance(value,ast.Attribute) or value.attr!=attr]
            elif mutant=="ISLAND_FILESYSTEM_DIGEST_READ":
                call=next(value for value in ast.walk(regular)
                          if isinstance(value,ast.Call) and isinstance(value.func,ast.Attribute)
                          and value.func.attr=="read_bytes")
                call.func=ast.Attribute(ast.Constant(b""),"hex",ast.Load())
            elif mutant=="ISLAND_FILESYSTEM_CACHE_STORE":
                branch=next(value for value in regular.body if isinstance(value,ast.If))
                branch.body.pop()
    elif mutant=="ISLAND_SNAPSHOT":
        definition("snapshot_selftests").body.append(ast.Pass())
    elif mutant.startswith("ISLAND_SNAPSHOT_"):
        node=definition("snapshot_selftests")
        scope=next(value for value in node.body if isinstance(value,ast.With))
        if mutant=="ISLAND_SNAPSHOT_EXTRA_EFFECT":
            scope.body.append(ast.parse("root.touch()").body[0])
        elif mutant=="ISLAND_SNAPSHOT_BASELINE_MOVED":
            index=next(i for i,value in enumerate(scope.body) if isinstance(value,ast.Assign)
                       and isinstance(value.targets[0],ast.Name)
                       and value.targets[0].id=="link_baseline")
            scope.body.insert(index+2,scope.body.pop(index))
        elif mutant=="ISLAND_SNAPSHOT_BASELINE_OMITTED":
            scope.body=[value for value in scope.body if not (isinstance(value,ast.Assign)
                and isinstance(value.targets[0],ast.Name)
                and value.targets[0].id=="mode_baseline")]
        elif mutant=="ISLAND_SNAPSHOT_BASELINE_CROSS_USED":
            target=next(value for value in ast.walk(node) if isinstance(value,ast.Name)
                        and isinstance(value.ctx,ast.Load) and value.id=="mode_baseline")
            target.id="link_baseline"
        elif mutant=="ISLAND_SNAPSHOT_CHECK_DISABLED":
            call=next(value for value in ast.walk(node) if isinstance(value,ast.Call)
                      and isinstance(value.func,ast.Name) and value.func.id=="check")
            call.args[0]=ast.Constant(True)
        elif mutant=="ISLAND_SNAPSHOT_MUTATION_CHANGED":
            call=next(value for value in ast.walk(node) if isinstance(value,ast.Call)
                      and isinstance(value.func,ast.Attribute) and value.func.attr=="chmod")
            call.args=[ast.Constant(0o644)]
        elif mutant=="ISLAND_SNAPSHOT_CLEANUP_FILTER":
            compare=next(value for value in ast.walk(node) if isinstance(value,ast.Compare)
                         and isinstance(value.comparators[0],ast.List)
                         and any(isinstance(item,ast.Constant) and item.value=="."
                                 for item in value.comparators[0].elts))
            compare.comparators[0].elts=[ast.Constant("state.db")]
    elif mutant in {
            "ISLAND_OBSERVE_PROVIDER","ISLAND_OBSERVE_PROVIDER_LIFETIME",
            "ISLAND_OBSERVER_SELFTESTS","ISLAND_LOOP_FIXTURE",
            "ISLAND_REAL_ROUTING","ISLAND_OWNER_ACCEPTANCE"}:
        target={
            "ISLAND_OBSERVE_PROVIDER":"observe_provider",
            "ISLAND_OBSERVE_PROVIDER_LIFETIME":"observe_provider_lifetime",
            "ISLAND_OBSERVER_SELFTESTS":"observer_selftests",
            "ISLAND_LOOP_FIXTURE":"loop_fixture",
            "ISLAND_REAL_ROUTING":"real_routing",
            "ISLAND_OWNER_ACCEPTANCE":"owner_acceptance",
        }[mutant]
        definition(target).body.append(ast.Pass())
    elif mutant=="ISLAND_FROZEN":
        node=definition("frozen_checks")
        anchor=next(index for index,value in enumerate(node.body)
                    if r15_gate_call_name(value)=="r14_contract_selftests")
        node.body.insert(anchor+1,ast.Pass())
    elif mutant=="ISLAND_MAIN":
        definition("main").body.append(ast.Pass())
    elif mutant=="ISLAND_MAIN_OWNER_RESOLVE_RESTORED":
        node=definition("main")
        call=next(value for value in ast.walk(node) if isinstance(value,ast.Call)
                  and isinstance(value.func,ast.Name)
                  and value.func.id=="owner_acceptance")
        call.args[1]=ast.Call(ast.Attribute(call.args[1],"resolve",ast.Load()),[],[])
    elif mutant=="INHERITED_ASSIGNMENT":
        insert_before_guard(ast.Assign(targets=[ast.Name("run",ast.Store())],
                                       value=ast.Name("check",ast.Load())))
    elif mutant=="INHERITED_IMPORT_ALIAS":
        insert_before_guard(ast.Import(names=[ast.alias(name="os",asname="run")]))
    elif mutant=="INHERITED_VALUE_ALIAS":
        insert_before_guard(ast.Assign(targets=[ast.Name("_hr01_run_alias",ast.Store())],
                                       value=ast.Name("run",ast.Load())))
    elif mutant=="INHERITED_IMPORT_CAPABILITY_ALIAS":
        insert_before_guard(ast.Import(names=[ast.alias(name="os",asname="_hr01_os_alias")]))
    elif mutant=="INHERITED_DELETE":
        insert_before_guard(ast.Delete(targets=[ast.Name("run",ast.Del())]))
    elif mutant=="INHERITED_FOR_BINDING":
        insert_before_guard(ast.For(target=ast.Name("run",ast.Store()),
            iter=ast.Tuple([],ast.Load()),body=[ast.Pass()],orelse=[]))
    elif mutant=="INHERITED_WITH_BINDING":
        insert_before_guard(ast.With(items=[ast.withitem(
            context_expr=ast.Call(ast.Name("cm",ast.Load()),[],[]),
            optional_vars=ast.Name("run",ast.Store()))],body=[ast.Pass()]))
    elif mutant=="INHERITED_GLOBAL":
        insert_before_guard(ast.FunctionDef(
            name="_hr01_global",args=ast.arguments(posonlyargs=[],args=[],kwonlyargs=[],
                kw_defaults=[],defaults=[]),body=[ast.Global(names=["run"]),ast.Pass()],
            decorator_list=[]))
    elif mutant=="INHERITED_CODE":
        insert_before_guard(ast.FunctionDef(
            name="_hr01_code",args=ast.arguments(posonlyargs=[],args=[],kwonlyargs=[],
                kw_defaults=[],defaults=[]),body=[ast.Assign(
                    targets=[ast.Attribute(ast.Name("run",ast.Load()),"__code__",ast.Store())],
                    value=ast.Attribute(ast.Name("check",ast.Load()),"__code__",ast.Load()))],
            decorator_list=[]))
    elif mutant=="INHERITED_GLOBALS":
        insert_before_guard(ast.FunctionDef(
            name="_hr01_globals",args=ast.arguments(posonlyargs=[],args=[],kwonlyargs=[],
                kw_defaults=[],defaults=[]),body=[ast.Assign(targets=[ast.Subscript(
                    value=ast.Call(ast.Name("globals",ast.Load()),[],[]),
                    slice=ast.Constant("run"),ctx=ast.Store())],
                    value=ast.Name("check",ast.Load()))],decorator_list=[]))
    elif mutant=="INHERITED_MODULE_ATTRIBUTE":
        insert_before_guard(ast.FunctionDef(
            name="_hr01_module",args=ast.arguments(posonlyargs=[],args=[],kwonlyargs=[],
                kw_defaults=[],defaults=[]),body=[ast.Assign(targets=[ast.Attribute(
                    ast.Name("os",ast.Load()),"path",ast.Store())],value=ast.Constant(None))],
            decorator_list=[]))
    elif mutant=="INHERITED_SETATTR":
        insert_before_guard(ast.FunctionDef(
            name="_hr01_setattr",args=ast.arguments(posonlyargs=[],args=[],kwonlyargs=[],
                kw_defaults=[],defaults=[]),body=[ast.Expr(ast.Call(ast.Name("setattr",ast.Load()),
                    [ast.Name("os",ast.Load()),ast.Constant("path"),ast.Constant(None)],[]))],
            decorator_list=[]))
    elif mutant=="MODULE_EXECUTABLE_CALL":
        insert_before_guard(ast.Expr(ast.Call(ast.Name("check",ast.Load()),
                                              [ast.Constant(True),ast.Constant("FORGED")],[])))
    elif mutant in {"ADMITTED_DEF_REBIND_LAMBDA","ADMITTED_DEF_REBIND_BOOL",
                    "HISTORICAL_FLOOR_REBIND_LAMBDA"}:
        name="r15_historical_regression_floor" if mutant=="HISTORICAL_FLOOR_REBIND_LAMBDA" \
            else "r15_gate_inheritance_bytes"
        value=(ast.Lambda(ast.arguments(posonlyargs=[],args=[],kwonlyargs=[],kw_defaults=[],
                                       defaults=[]),ast.Constant(None))
               if mutant!="ADMITTED_DEF_REBIND_BOOL" else
               ast.BoolOp(ast.Or(),[ast.Constant(None),ast.Name("run",ast.Load())]))
        insert_before_guard(ast.Assign([ast.Name(name,ast.Store())],value))
    elif mutant in {"BASE_CONSTANT_REBIND","BASE_SHA_CONSTANT_REBIND",
                    "AGGREGATE_CONSTANT_REBIND","DOUBLE_NONDEF_AUTHORITY_REBIND"}:
        name={"BASE_CONSTANT_REBIND":"H035_R15_BASE",
              "BASE_SHA_CONSTANT_REBIND":"H035_R15_GATE_BASE_SHA256",
              "AGGREGATE_CONSTANT_REBIND":"H035_R15_GATE_ADMITTED_DEFINITION_AGGREGATE",
              "DOUBLE_NONDEF_AUTHORITY_REBIND":"H035_R15_BASE"}[mutant]
        insert_before_guard(ast.Assign([ast.Name(name,ast.Store())],ast.Constant("0"*40)))
        if mutant=="DOUBLE_NONDEF_AUTHORITY_REBIND":
            insert_before_guard(ast.Assign([ast.Name(
                "H035_R15_GATE_ADMITTED_NONDEFINITION_AGGREGATE",ast.Store())],
                ast.Constant("0"*64)))
    elif mutant=="ENV_PERSISTENT_MUTATION":
        definition("r15_remote_boundary_selftests").body.insert(-1,ast.Assign(
            targets=[ast.Subscript(ast.Attribute(ast.Name("os",ast.Load()),"environ",ast.Load()),
                                   ast.Constant("PATH"),ast.Store())],
            value=ast.Constant("/hostile")))
    elif mutant in {"ENV_SETDEFAULT","ENV_IOR","ENV_AUGASSIGN","ENV_DICT_DESCRIPTOR",
                    "ENV_RESTORE_DATAFLOW"}:
        source={
            "ENV_SETDEFAULT":'os.environ.setdefault("NORTROPIC_PERSIST","1")',
            "ENV_IOR":'os.environ.__ior__({"NORTROPIC_PERSIST":"1"})',
            "ENV_AUGASSIGN":'os.environ |= {"NORTROPIC_PERSIST":"1"}',
            "ENV_DICT_DESCRIPTOR":'dict.update(os.environ,{"NORTROPIC_PERSIST":"1"})',
            "ENV_RESTORE_DATAFLOW":'prior={key:"/persistent" for key in hostile_keys}',
        }[mutant]
        definition("r15_remote_boundary_selftests").body.insert(
            -1,ast.parse(source,mode="exec").body[0])
    elif mutant in {"OPERATOR_ATTRGETTER","FUNCTOOLS_PARTIAL_REFLECTION"}:
        module="operator" if mutant=="OPERATOR_ATTRGETTER" else "functools"
        insert_before_guard(ast.Import(names=[ast.alias(module)]))
        source=('def _hr01_probe():\n '
                'operator.attrgetter("f_globals")(operator.attrgetter("_getframe")(sys)())["failed"]=0'
                if mutant=="OPERATOR_ATTRGETTER" else
                'def _hr01_probe():\n functools.partial(getattr,sys)("_getframe")')
        insert_before_guard(ast.parse(source,mode="exec").body[0])
    elif mutant in {
            "DEFINITION_GLOBALS_UPDATE","FUNCTION_GLOBALS_SETITEM",
            "OBJECT_SETATTR_CODE","VARS_UPDATE","DEFAULTS_MUTATION",
            "KWDEFAULTS_MUTATION","TRANSITIVE_GLOBALS_ALIAS","GETATTR_MAPPING",
            "DEFAULT_WALRUS_ALIAS","SYS_MODULES_SETATTR",
            "PARAMETER_MAPPING_MUTATION","INDIRECT_COUNTER_RESET",
            "BOUND_DUNDER_SETATTR","TYPE_DUNDER_SETATTR","GETATTR_DUNDER_SETATTR",
