#!/usr/bin/env python3
"""Frozen H-035 real-effect gate. 0=PASS, 1=product RED, 2=rig error.

J_* checks are judge self-tests.  A_*/N_*/P_* invoke operational controller
entrypoints against disposable repositories/state; they are acceptance.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
SPEC = ROOT / "specs/tasks.spec.json"
REG = ROOT / "specs/owner-production-paths.v1.json"
LOOP = ROOT / "controller/loop/cli"
AUTH = ROOT / "controller/authority/cli"
REGISTER = ROOT / "controller/verify/register.json"
passed = failed = 0


class Rig(Exception):
    pass


def check(ok: bool, name: str, detail: str = "") -> None:
    global passed, failed
    if ok:
        passed += 1
        print(f"PASS {name}")
    else:
        failed += 1
        print(f"FAIL {name}: {detail}")


def run(argv: list[str], *, cwd: Path = ROOT, env: dict[str, str] | None = None,
        stdin: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(argv, cwd=cwd, env=env, input=stdin, text=True,
                          capture_output=True, shell=False, timeout=45)


def parse_path(raw: object) -> tuple[str, bool]:
    if not isinstance(raw, str) or "\x00" in raw:
        raise ValueError("type/NUL")
    p = raw.replace("\\", "/")
    if not p or p.startswith("/") or re.match(r"^[A-Za-z]:", p):
        raise ValueError("absolute/drive/empty")
    if p.startswith("./") or p.endswith("/") or "//" in p:
        raise ValueError("separator")
    recursive = p.endswith("/**")
    core = p[:-3] if recursive else p
    if not core or any(x in ("", ".", "..") for x in core.split("/")):
        raise ValueError("segment")
    if any(c in core for c in "*?[]{}"):
        raise ValueError("unsupported glob")
    return core, recursive


def overlap(a: object, b: object) -> bool:
    ap, ax = parse_path(a); bp, bx = parse_path(b)
    return ((not ax and not bx and ap == bp)
            or (ax and (bp == ap or bp.startswith(ap + "/")))
            or (bx and (ap == bp or ap.startswith(bp + "/"))))


def strict_load(path: Path) -> object:
    def pairs(items: list[tuple[str, object]]) -> dict[str, object]:
        out: dict[str, object] = {}
        for k, v in items:
            if k in out:
                raise ValueError(f"duplicate key {k}")
            out[k] = v
        return out
    return json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=pairs)


REG_KEYS = {
    "schema_version", "path_grammar", "authority_source", "self_digest_is_authority",
    "owner_production_paths", "prospective_ordinary_protected_paths",
    "owner_author_global_denied_paths",
}
REQUIRED_OWNER = {
    "controller/h034-native/**", "verify/h034/kernel",
    "verify/h034/build-recipe.json", "verify/h034/identity-manifest.json",
}


def validate_registry(doc: object) -> tuple[bool, str]:
    if not isinstance(doc, dict): return False, "top-level type"
    if set(doc) != REG_KEYS: return False, "top-level membership"
    if doc.get("schema_version") != 1: return False, "schema version"
    if doc.get("path_grammar") != "repo-tree-exact-or-terminal-recursive-prefix-v1": return False, "grammar"
    if doc.get("authority_source") != "git-candidate-plus-independent-gate-review-plus-owner-final-freeze": return False, "authority source"
    if doc.get("self_digest_is_authority") is not False: return False, "self digest"
    for key in ("owner_production_paths", "prospective_ordinary_protected_paths", "owner_author_global_denied_paths"):
        value = doc.get(key)
        if not isinstance(value, list) or not value or not all(isinstance(x, str) for x in value):
            return False, f"{key} type/empty"
        try: canon = [parse_path(x) for x in value]
        except ValueError as e: return False, f"{key} path {e}"
        if len(canon) != len(set(canon)): return False, f"{key} duplicate"
    if set(doc["owner_production_paths"]) != REQUIRED_OWNER: return False, "required H034 membership"
    return True, "ok"


def registry_selftests(good: dict[str, object]) -> None:
    ok, why = validate_registry(good); check(ok, "J_REGISTRY_POSITIVE", why)
    mutants: list[tuple[str, object]] = []
    for name, mutate in (
        ("MISSING_KEY", lambda d: d.pop("path_grammar")),
        ("UNEXPECTED_KEY", lambda d: d.update(extra=[])),
        ("WRONG_VERSION", lambda d: d.update(schema_version=2)),
        ("WRONG_LIST_TYPE", lambda d: d.update(owner_production_paths={})),
        ("EMPTY_LIST", lambda d: d.update(owner_production_paths=[])),
        ("DUPLICATE_PATH", lambda d: d.update(owner_production_paths=list(d["owner_production_paths"])+[d["owner_production_paths"][0]])),
        ("MALFORMED_PATH", lambda d: d.update(owner_production_paths=["../escape"])),
        ("REQUIRED_REMOVED", lambda d: d.update(owner_production_paths=list(d["owner_production_paths"])[1:])),
        ("REQUIRED_ALTERED", lambda d: d.update(owner_production_paths=["controller/h034-native/*", *list(d["owner_production_paths"])[1:]])),
    ):
        copy = json.loads(json.dumps(good)); mutate(copy); mutants.append((name, copy))
    for name, mutant in mutants:
        accepted, _ = validate_registry(mutant)
        check(not accepted, f"J_REGISTRY_{name}")
    try:
        json.loads('{"schema_version":1,"schema_version":1}', object_pairs_hook=lambda p: (_ for _ in ()).throw(ValueError("duplicate")) if len({k for k,_ in p}) != len(p) else dict(p))
        duplicate_rejected = False
    except ValueError: duplicate_rejected = True
    check(duplicate_rejected, "J_REGISTRY_DUPLICATE_KEY")


def path_selftests() -> None:
    bad = ["", "/x", "C:/x", "./x", "x//y", "x/../y", "x/./y", "x/", "x/*", "x/**/y", "../x"]
    check(all(_bad_path(x) for x in bad), "J_PATH_REJECT_FAMILY")
    check(parse_path(r"a\b\c") == ("a/b/c", False), "J_PATH_BACKSLASH_NORMALIZED")
    check(overlap("controller/**", "controller/h034-native/kernel.c"), "J_PATH_PARENT")
    check(overlap("controller/h034-native/**", "controller/h034-native/kernel.c"), "J_PATH_CHILD")
    check(not overlap("safe/**", "controller/h034-native/**"), "J_PATH_SIBLING")
    # Predicted outcome: each superficial implementation is rejected by real acceptance below.
    for mutant, guard in (
        ("HARDCODE_PROBE_NAMES", "A_OWNER_ROUTE"),
        ("PERMISSIVE_REGISTRY_CONSUMER", "N_REGISTRY_RUNTIME"),
        ("DOCS_IMPACT_ESCALATION", "N_DOCS_IMPACT"),
        ("RESTART_LAUNCHES_BUILDER", "A_OWNER_RESTART"),
        ("REVIEW_AUTO_PUBLISH", "N_REVIEW_PUBLICATION"),
        ("AUTOPILOT_OLD_MATCHER", "N_PATH_CONSISTENCY"),
    ):
        print(f"MUTANT={mutant} PREDICTED=REJECT GUARD={guard}")


def _bad_path(value: str) -> bool:
    try: parse_path(value); return False
    except ValueError: return True


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")


def git(cwd: Path, *args: str) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd=cwd)


def init_repo(path: Path) -> str:
    path.mkdir()
    for args in (("init", "-q"), ("config", "user.name", "H035 Fixture"), ("config", "user.email", "fixture@example.invalid")):
        p = git(path, *args)
        if p.returncode: raise Rig(p.stderr)
    (path / "seed.txt").write_text("seed\n")
    for args in (("add", "seed.txt"), ("commit", "-qm", "seed")):
        p = git(path, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(path, "rev-parse", "HEAD").stdout.strip()


def candidate(repo: Path, base: str, path: str, serial: int) -> str:
    p = git(repo, "checkout", "-q", base)
    if p.returncode: raise Rig(p.stderr)
    target = repo / path; target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(f"h035 fixture candidate {serial}\n")
    for args in (("add", "--", path), ("commit", "-qm", f"candidate-{serial}")):
        p = git(repo, *args)
        if p.returncode: raise Rig(p.stderr)
    return git(repo, "rev-parse", "HEAD").stdout.strip()


def registry_candidate(tmp: Path, name: str, raw: str) -> tuple[Path, str, str]:
    repo = tmp / f"registry-{name}"; base = init_repo(repo)
    target = repo / "specs/owner-production-paths.v1.json"; target.parent.mkdir()
    target.write_text(raw)
    for args in (("add", str(target.relative_to(repo))), ("commit", "-qm", name)):
        p = git(repo, *args)
        if p.returncode: raise Rig(p.stderr)
    return repo, base, git(repo, "rev-parse", "HEAD").stdout.strip()


def task_candidate(tmp: Path, name: str, version: str, task: dict[str, object]) -> tuple[Path, str, str]:
    repo = tmp / f"task-{name}"; base = init_repo(repo)
    (repo / "specs").mkdir()
    write_json(repo / "specs/tasks.spec.json", {"spec_version":version,"defaults":{"denied_write":[]},"tasks":[{"id":"fixture-task","depends_on":[],**task}]})
    (repo / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    p = git(repo, "add", "specs")
    if p.returncode: raise Rig(p.stderr)
    p = git(repo, "commit", "-qm", name)
    if p.returncode: raise Rig(p.stderr)
    return repo, base, git(repo, "rev-parse", "HEAD").stdout.strip()


def path_candidate(tmp: Path, name: str, pattern: str) -> tuple[Path, str, str]:
    repo = tmp / f"path-{name}"; init_repo(repo)
    (repo / "specs").mkdir()
    write_json(repo / "specs/tasks.spec.json", {"spec_version":"2.0.0", "defaults":{"denied_write":[]},
        "tasks":[{"id":"fixture-task", "authority_class":"ordinary", "allowed_write":[pattern],
                  "docs_impact":[], "depends_on":[]}]})
    (repo / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    git(repo, "add", "specs"); git(repo, "commit", "-qm", "canonical authority")
    base = git(repo, "rev-parse", "HEAD").stdout.strip()
    target = repo / "safe/x"; target.parent.mkdir(); target.write_text("effect\n")
    git(repo, "add", "safe/x"); git(repo, "commit", "-qm", "candidate")
    return repo, base, git(repo, "rev-parse", "HEAD").stdout.strip()


def process_snapshot() -> tuple[str, list[dict[str, object]], str]:
    argv = ["ps", "-ww", "-axo", "pid=,ppid=,pgid=,comm=,args="]
    try:
        p = subprocess.run(argv, text=True, capture_output=True, check=False)
    except (OSError, PermissionError) as e:
        return "ODÖMBART", [], f"{type(e).__name__}: {e}"
    if p.returncode != 0:
        return "ODÖMBART", [], f"ps exit {p.returncode}: {p.stderr.strip()[:200]}"
    rows: list[dict[str, object]] = []
    for line in p.stdout.splitlines():
        fields = line.strip().split(None, 4)
        if len(fields) == 5 and all(fields[i].isdigit() for i in range(3)):
            rows.append({"pid":int(fields[0]), "ppid":int(fields[1]), "pgid":int(fields[2]),
                         "comm":fields[3], "args":fields[4]})
    return "OK", rows, ""


def observe_provider(rows: list[dict[str, object]], *, loop_pid: int, provider: Path,
                     nonce: str) -> tuple[dict[str, object] | None, list[dict[str, object]]]:
    by_pid = {int(r["pid"]): r for r in rows}
    provider_text = str(provider.resolve())
    token = re.compile(rf"(?:^|\s){re.escape(nonce)}(?:\s|$)")
    path_token = re.compile(rf"(?:^|\s){re.escape(provider_text)}(?:\s|$)")
    required = [str(LOOP), str(ROOT/"controller/brytare/cli"),
                str(ROOT/"controller/utforare/cli"), str(ROOT/"controller/launch/cli")]
    for row in rows:
        args = str(row["args"]); comm = str(row["comm"])
        if (comm.endswith("sandbox-exec") or not comm.endswith(("/sh", "sh"))
                or not path_token.search(args) or not token.search(args)):
            continue
        chain = [row]; seen = {int(row["pid"])}; parent = int(row["ppid"])
        while parent in by_pid and parent not in seen:
            ancestor = by_pid[parent]; chain.append(ancestor); seen.add(parent)
            if parent == loop_pid: break
            parent = int(ancestor["ppid"])
        if not chain or int(chain[-1]["pid"]) != loop_pid:
            continue
        ancestor_args = [str(r["args"]) for r in reversed(chain)]
        cursor = 0
        for expected in required:
            while cursor < len(ancestor_args) and expected not in ancestor_args[cursor]: cursor += 1
            if cursor == len(ancestor_args): break
            cursor += 1
        else:
            return row, chain
    return None, []


def observer_selftests() -> None:
    provider = Path("/private/tmp/h035-provider"); nonce = "a" * 32
    def row(pid: int, ppid: int, comm: str, args: str) -> dict[str, object]:
        return {"pid":pid,"ppid":ppid,"pgid":60,"comm":comm,"args":args}
    chain = [row(10,1,"Python",str(LOOP)+" run cfg"),
             row(20,10,"Python",str(ROOT/"controller/brytare/cli")+" kor"),
             row(30,20,"Python",str(ROOT/"controller/utforare/cli")+" kor"),
             row(40,30,"Python",str(ROOT/"controller/launch/cli")+" run"),
             row(60,40,"/bin/sh",f"/bin/sh {provider} {nonce}")]
    check(observe_provider(chain, loop_pid=10, provider=provider, nonce=nonce)[0] is not None,
          "J_OBSERVER_POSITIVE")
    mutants = {"A_DISABLED_OLD_MARKER":chain[:-1],
      "B_DISABLED_EXPECTED_JSON":chain[:-1]+[row(61,40,"Python",'{"observed":true}')],
      "C_STALE_NONCE":chain[:-1]+[row(62,40,"/bin/sh",f"/bin/sh {provider} {'b'*32}")],
      "D_SAME_BASENAME":chain[:-1]+[row(63,40,"/bin/sh",f"/bin/sh /private/other/{provider.name} {nonce}")],
      "E_FAKE_PID":chain[:-1],
      "F_NEVER_EXECUTES":chain[:-1]+[row(64,40,"sandbox-exec",f"/usr/bin/sandbox-exec {provider} {nonce}")],
      "G_OUTSIDE_NORMAL_ANCESTRY":[chain[0],row(65,10,"/bin/sh",f"/bin/sh {provider} {nonce}")]}
    for name, rows in mutants.items():
        print(f"MUTANT={name} PREDICTED=REJECT GUARD=J_OBSERVER_{name}")
        check(observe_provider(rows, loop_pid=10, provider=provider, nonce=nonce)[0] is None,
              f"J_OBSERVER_{name}")


def loop_fixture(tmp: Path, authority: str, *, restart: bool = False,
                 observe: bool = False) -> tuple[subprocess.CompletedProcess, str, str, bool, dict[str, object]]:
    """Execute the real normal loop entrypoint; only external boundaries are fixtures."""
    # Current workspace/loop resolves the repository from its installed ROOT.
    # The only repository effect is a disposable worktree under workspace_rot.
    repo = ROOT; base = git(ROOT, "rev-parse", "HEAD").stdout.strip()
    worker = tmp / f"provider-{authority}-{int(restart)}.sh"
    nonce = secrets.token_hex(16)
    worker.write_text("#!/bin/sh\nsleep 2\nprintf '%s\\n' 'fixture provider refusal' >&2\nexit 7\n")
    worker.chmod(0o700)
    allowed = ["safe/**"] if authority == "ordinary" else []
    owner_allowed = ["controller/h034-native/**"] if authority == "owner_authority" else []
    task = {"id":"fixture-task", "authority_class":authority, "allowed_write":allowed,
            "owner_author_allowed_write":owner_allowed, "docs_impact":[], "depends_on":[],
            "exit_test":"verify/bin/fixture-red", "max_changed_files":5, "max_added_lines":20}
    spec = tmp / f"spec-{authority}-{int(restart)}.json"
    write_json(spec, {"spec_version":"2.0.0", "defaults":{"denied_write":[]}, "tasks":[task]})
    state = tmp / f"state-{authority}-{int(restart)}"; attest = tmp / f"attest-{authority}-{int(restart)}"
    state_init = run([str(ROOT / "controller/state/cli"), "init", str(state)])
    if state_init.returncode: raise Rig(state_init.stderr or state_init.stdout)
    attest.mkdir()
    cfg = tmp / f"config-{authority}-{int(restart)}.json"
    write_json(cfg, {"spec":str(spec), "attest_dir":str(attest), "state_dir":str(state),
        "lease_dir":str(tmp/f"lease-{authority}-{int(restart)}"), "lease_resurs":"fixture",
        "workspace_rot":str(tmp/f"workspaces-{authority}-{int(restart)}"), "base_sha":base,
        "verifier_id":"h035-fixture-unregistered", "run_id":f"h035-{authority}-{int(restart)}",
        "brytare_rot":str(tmp/f"breaker-{authority}-{int(restart)}"), "budget":1, "troskel":1,
        "worker_cmd":[str(worker), nonce], "timeout_s":5})
    def observed_run() -> tuple[subprocess.CompletedProcess, str, dict[str, object]]:
        proc = subprocess.Popen([str(LOOP), "run", str(cfg)], cwd=repo,
                                text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        verdict = "FAIL"; evidence: dict[str, object] = {"nonce":nonce,"samples":0}
        deadline = time.monotonic() + 12
        while proc.poll() is None and time.monotonic() < deadline:
            status, rows, why = process_snapshot() if observe else ("OK", [], "")
            evidence["samples"] = int(evidence["samples"]) + 1
            if status == "ODÖMBART":
                verdict = "ODÖMBART"; evidence["observer_error"] = why; break
            hit, chain = observe_provider(rows, loop_pid=proc.pid, provider=worker, nonce=nonce)
            if hit is not None:
                verdict = "PASS"; evidence["provider"] = hit; evidence["ancestry"] = chain; break
            time.sleep(0.03)
        stdout, stderr = proc.communicate(timeout=10)
        if not observe: verdict = "NOT_OBSERVED"
        evidence.update({"loop_pid":proc.pid,"provider_path":str(worker),
                         "ps_fields":["pid","ppid","pgid","comm","args"]})
        return subprocess.CompletedProcess(proc.args, proc.returncode, stdout, stderr), verdict, evidence
    first, verdict, evidence = observed_run()
    if restart:
        second, second_verdict, second_evidence = observed_run()
        if second_verdict == "PASS" or verdict != "PASS": verdict, evidence = second_verdict, second_evidence
        result = second
    else: result = first
    events = state / "events.jsonl"
    text = events.read_text(errors="replace") if events.exists() else ""
    done = '"status": "done"' in text or '"status":"done"' in text
    return result, verdict, text, done, evidence


def real_routing(tmp: Path) -> None:
    ordinary, _verdict, _, _, _ = loop_fixture(tmp, "ordinary")
    print("OWNER_ACCEPTANCE_OBSERVATION=DEFERRED_TO_OWNER_TERMINAL_V2")
    print("OWNER_ACCEPTANCE_REQUIRED=YES")
    owner, verdict, state, done, _ = loop_fixture(tmp, "owner_authority")
    owner_required = "OWNER_ACTION_REQUIRED" in state
    check(verdict == "NOT_OBSERVED" and owner_required and not done, "A_OWNER_ROUTE_REAL_EFFECT",
          f"rc={owner.returncode} verdict={verdict} state={state[-300:]!r}")
    restarted, verdict, state, done, _ = loop_fixture(tmp, "owner_authority", restart=True)
    check(verdict == "NOT_OBSERVED" and "OWNER_ACTION_REQUIRED" in state and not done,
          "A_OWNER_RESTART_REAL_RECONSTRUCTION",
          f"rc={restarted.returncode} verdict={verdict} state={state[-300:]!r}")


def owner_acceptance(candidate_sha: str, artifact: Path) -> int:
    """Candidate-bound owner-terminal subgate over the same normal loop route."""
    actual = git(ROOT, "rev-parse", "HEAD").stdout.strip()
    if not re.fullmatch(r"[0-9a-f]{40}", candidate_sha) or actual != candidate_sha:
        raise Rig(f"candidate mismatch requested={candidate_sha} actual={actual}")
    if git(ROOT, "status", "--porcelain").stdout.strip():
        raise Rig("owner acceptance requires clean immutable candidate")
    with tempfile.TemporaryDirectory(prefix="h035-owner-effect-") as raw:
        result, verdict, _state, _done, evidence = loop_fixture(Path(raw), "ordinary", observe=True)
    record = {
        "acceptance_mode": "H035_OWNER_PROVIDER_EXEC_V2",
        "task": "h-035", "candidate_sha": candidate_sha,
        "gate_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "spec_sha256": hashlib.sha256(SPEC.read_bytes()).hexdigest(),
        "normal_entrypoint": "controller/loop/cli run",
        "observer": "gate-side ps pid/ppid/pgid/comm/args nonce-and-normal-ancestry observer",
        "observer_verdict": verdict,
        "provider_process_execution_observed": verdict == "PASS",
        "raw_process_evidence": evidence,
        "loop_exit": result.returncode,
    }
    artifact.parent.mkdir(parents=True, exist_ok=True)
    artifact.write_text(json.dumps(record, sort_keys=True, indent=2) + "\n")
    print(json.dumps(record, sort_keys=True))
    return {"PASS":0, "FAIL":1, "ODÖMBART":2}.get(verdict, 2)


def authority_call(tmp: Path, command: str, request: dict[str, object]) -> tuple[int, dict[str, object], str]:
    if not AUTH.is_file(): return 127, {}, f"missing operational entrypoint {AUTH}"
    p = run([str(AUTH), command], cwd=tmp, stdin=json.dumps(request))
    try: out = json.loads(p.stdout)
    except ValueError: out = {}
    return p.returncode, out, (p.stderr or p.stdout)[-500:]


def tree_digest(path: Path) -> str:
    h = hashlib.sha256()
    if not path.exists(): return "ABSENT"
    for item in sorted(path.rglob("*")):
        if item.is_file():
            h.update(str(item.relative_to(path)).encode()); h.update(item.read_bytes())
    return h.hexdigest()


def remote_refs(remote: Path) -> str:
    p = run(["git", "for-each-ref", "--format=%(refname) %(objectname)"], cwd=remote)
    if p.returncode: raise Rig(p.stderr)
    return p.stdout


def persisted_state(state_dir: Path) -> str:
    texts = []
    if state_dir.exists():
        for item in sorted(state_dir.rglob("*")):
            if item.is_file(): texts.append(item.read_text(errors="replace"))
    return "\n".join(texts)


def expect_auth(tmp: Path, name: str, command: str, request: dict[str, object], accepted: bool,
                *, state_after: str | None = None, state_changes: bool | None = None,
                workspace_changes: bool | None = None, refs_change: bool | None = None,
                **diagnostics: object) -> None:
    state_dir = Path(str(request["state_dir"])); workspace = Path(str(request["workspace_root"]))
    remote = Path(str(request["remote"]))
    before_state, before_ws, before_refs = tree_digest(state_dir), tree_digest(workspace), remote_refs(remote)
    rc, out, detail = authority_call(tmp, command, request)
    ok = ((rc == 0) == accepted) and out.get("accepted") is accepted
    after_state, after_ws, after_refs = tree_digest(state_dir), tree_digest(workspace), remote_refs(remote)
    for key, value in diagnostics.items(): ok = ok and out.get(key) == value
    if state_after is not None: ok = ok and state_after in persisted_state(state_dir)
    if state_changes is not None: ok = ok and ((before_state != after_state) is state_changes)
    if workspace_changes is not None: ok = ok and ((before_ws != after_ws) is workspace_changes)
    if refs_change is not None: ok = ok and ((before_refs != after_refs) is refs_change)
    check(ok, name, detail or repr(out))


def production_matrix(tmp: Path) -> None:
    """Future operational CLI contract; every case is black-box, never a named probe."""
    repo = tmp / "authority-repo"; base = init_repo(repo)
    bare = tmp / "origin.git"; run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
    spec_digest = hashlib.sha256(SPEC.read_bytes()).hexdigest()
    reg_digest = hashlib.sha256(REG.read_bytes()).hexdigest()
    gate_digest = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    common: dict[str, object] = {"repo":str(repo), "task_id":"h-035", "base_sha":base,
        "main_sha":base, "spec_sha256":spec_digest, "registry_sha256":reg_digest,
        "gate_path":"verify/bin/h-035-exit", "gate_sha256":gate_digest,
        "state_dir":str(tmp/"authority-state"), "workspace_root":str(tmp/"authority-ws"),
        "remote":str(bare)}
    write_json(Path(str(common["state_dir"])) / "current.json",
               {"task":"h-035", "state":"OWNER_ACTION_REQUIRED", "base_sha":base})
    def req(**kw: object) -> dict[str, object]: return {**common, **kw}
    # Actual task/schema/authority consumer matrix (N01-N18, N36-N41; P01-P05).
    invalid = [
      ("N01_EXACT_OWNER", "2.0.0", dict(authority_class="ordinary",allowed_write=["verify/h034/kernel"])),
      ("N02_PARENT_OWNER", "2.0.0", dict(authority_class="ordinary",allowed_write=["verify/**"])),
      ("N03_WILDCARD_OWNER", "2.0.0", dict(authority_class="ordinary",allowed_write=["controller/**"])),
      ("N09_ORDINARY_BOTH", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],owner_author_allowed_write=["controller/h034-native/**"])),
      ("N10_OWNER_NONEMPTY_ORDINARY", "2.0.0", dict(authority_class="owner_authority",allowed_write=["safe/**"],owner_author_allowed_write=["controller/h034-native/**"])),
      ("N10B_OWNER_EMPTY_OWNER", "2.0.0", dict(authority_class="owner_authority",allowed_write=["safe/**"],owner_author_allowed_write=[])),
      ("N11_EMPTY_CLASS", "2.0.0", dict(authority_class="",allowed_write=["safe/**"])),
      ("N12_UPPER_CLASS", "2.0.0", dict(authority_class="OWNER",allowed_write=["safe/**"])),
      ("N13_MIXED_CLASS", "2.0.0", dict(authority_class="OwNeR",allowed_write=["safe/**"])),
      ("N14_V1_OWNER_FIELD", "1.0.0", dict(allowed_write=["safe/**"],owner_author_allowed_write=["controller/h034-native/**"])),
      ("N15_DOCS_EXACT", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=["verify/h034/kernel"])),
      ("N16_DOCS_PARENT", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=["verify/**"])),
      ("N16B_OWNER_DOCS_GATE", "2.0.0", dict(authority_class="owner_authority",allowed_write=[],owner_author_allowed_write=["safe-owner/**"],docs_impact=["verify/bin/h-035-exit"])),
    ]
    for name, version, task in invalid:
        trepo, tbase, tsha = task_candidate(tmp, name, version, task)
        expect_auth(tmp, name, "validate-task", {**common,"repo":str(trepo),"base_sha":tbase,"candidate_sha":tsha,"task_id":"fixture-task"}, False)
    for name, version, task in (
      ("P01_V1_ORDINARY", "1.0.0", dict(allowed_write=["safe/**"],docs_impact=[])),
      ("P02_V2_ORDINARY", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=[])),
      ("P04_DOCS_LEGITIMATE", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=["safe/docs/**"])),
    ):
        trepo, tbase, tsha = task_candidate(tmp, name, version, task)
        expect_auth(tmp, name, "validate-task", {**common,"repo":str(trepo),"base_sha":tbase,"candidate_sha":tsha,"task_id":"fixture-task"}, True)
    trepo, tbase, tsha = task_candidate(tmp, "HOSTILE_AUTHORITY_INPUTS", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=[]))
    canonical = {**common,"repo":str(trepo),"base_sha":tbase,"candidate_sha":tsha,"task_id":"fixture-task"}
    expect_auth(tmp, "N17_ROLE_SELF_CLAIM", "validate-task", {**canonical,"claimed_role":"OWNER_AUTHORITY_AUTHOR"}, True, authority_class="ordinary")
    alt = tmp / "alternate.json"; write_json(alt, {"tasks":[{"id":"fixture-task","authority_class":"owner_authority","owner_author_allowed_write":["controller/h034-native/**"]}]})
    expect_auth(tmp, "N18_ALTERNATE_SPEC", "validate-task", {**canonical,"alternate_spec":str(alt)}, True, authority_class="ordinary")
    freeze_common = req(review_result="PASS",candidate_sha=base,review_identity="review-1")
    rrepo, rbase, rsha = registry_candidate(tmp, "P05_REGISTRY_RUNTIME", REG.read_text())
    expect_auth(tmp, "P05_REGISTRY_RUNTIME", "validate-registry", {**common,"repo":str(rrepo),"base_sha":rbase,"candidate_sha":rsha}, True)
    good_reg = strict_load(REG)
    malformed: list[tuple[str, str]] = [
      ("N36_DUPLICATE_KEY", REG.read_text().replace('"schema_version": 1,', '"schema_version": 1,\n  "schema_version": 1,')),
      ("N37_UNEXPECTED_KEY", json.dumps({**good_reg, "unexpected": []})),
      ("N38_MISSING_KEY", json.dumps({k:v for k,v in good_reg.items() if k != "path_grammar"})),
      ("N39_DUPLICATE_PATH", json.dumps({**good_reg, "owner_production_paths":[*good_reg["owner_production_paths"], good_reg["owner_production_paths"][0]]})),
      ("N40_REQUIRED_REMOVED", json.dumps({**good_reg, "owner_production_paths":good_reg["owner_production_paths"][1:]})),
      ("N_REG_WRONG_VERSION", json.dumps({**good_reg, "schema_version":2})),
      ("N_REG_WRONG_TOP_TYPE", "[]"),
      ("N_REG_MALFORMED_PATH", json.dumps({**good_reg, "owner_production_paths":["../escape"]})),
    ]
    for name, raw in malformed:
        rrepo, rbase, rsha = registry_candidate(tmp, name, raw)
        mutant_req = {**common,"repo":str(rrepo),"base_sha":rbase,"candidate_sha":rsha}
        expect_auth(tmp, f"{name}_VALIDATOR", "validate-registry", mutant_req, False)
        expect_auth(tmp, f"{name}_POLICY", "check-candidate", {**mutant_req,"actor":"ordinary"}, False)
        expect_auth(tmp, f"{name}_OWNER_TRANSITION", "owner-author", mutant_req, False,
                    state_changes=False, workspace_changes=False, refs_change=False)
    # Mechanical actor/candidate scope uses Git changed files, not reported lists.
    scope_neg = [
      ("N04_OWNER_ARTIFACT", "controller/h034-native/kernel.c", "ordinary"),
      ("N05_SCHEMA", "specs/tasks.spec.json", "ordinary"), ("N06_REGISTRY", "specs/owner-production-paths.v1.json", "ordinary"),
      ("N07_POLICY", "controller/policy/cli", "ordinary"), ("N08_AUTOPILOT", "scripts/nortropic-codex-autopilot.py", "ordinary"),
      ("N23_TEST_AUTHOR_OWNER", "controller/h034-native/kernel.c", "test_author"),
      ("N24_OWNER_SPEC", "specs/tasks.spec.json", "owner_authority"), ("N25_OWNER_REGISTRY", "specs/owner-production-paths.v1.json", "owner_authority"),
      ("N26_OWNER_GATE", "verify/bin/h-035-exit", "owner_authority"), ("N27_OWNER_OUTSIDE", "README.md", "owner_authority"),
    ]
    serial = 0
    for name, path, actor in scope_neg:
        serial += 1; sha = candidate(repo, base, path, serial)
        expect_auth(tmp, name, "check-candidate", req(actor=actor,candidate_sha=sha,reported_changed_files=[]), False)
    serial += 1; sha = candidate(repo, base, "controller/h034-native/kernel.c", serial)
    expect_auth(tmp, "P07_OWNER_EXACT_SURFACE", "check-candidate", req(actor="owner_authority",candidate_sha=sha), True)
    serial += 1; sha = candidate(repo, base, "controller/h034-native/alternative.c", serial)
    expect_auth(tmp, "P08_OWNER_ALT_BYTES", "check-candidate", req(actor="owner_authority",candidate_sha=sha), True)
    serial += 1; sha = candidate(repo, base, "controller/h034-native/kernel.c", serial)
    expect_auth(tmp, "N31_REPORTED_FILES_NOT_AUTHORITY", "check-candidate", req(actor="ordinary",candidate_sha=sha,reported_changed_files=["safe/x"]), False)
    # Explicit operational owner transitions and publication guard.
    expect_auth(tmp, "N_OWNER_AUTHOR_MISSING_BINDING", "owner-author", req(candidate_sha="0"*40), False,
                state_changes=False, workspace_changes=False, refs_change=False)
    expect_auth(tmp, "P06_OWNER_AUTHOR_EXPLICIT", "owner-author", req(candidate_sha=base), True,
                state_after="OWNER_CANDIDATE_REVIEW_REQUIRED", state_changes=True,
                workspace_changes=True, refs_change=False)
    # Recovery reads persisted state; a caller-supplied state is never authority.
    expect_auth(tmp, "N_NORMAL_ROUTE_OWNER_AUTHOR", "recover", req(state="OWNER_ACTION_REQUIRED"), True,
                state_after="OWNER_CANDIDATE_REVIEW_REQUIRED", workspace_changes=False,
                refs_change=False, owner_author_process_launched=False)
    state_file = Path(str(common["state_dir"])) / "current.json"
    write_json(state_file, {"task":"h-035", "state":"UNKNOWN_FUTURE_STATE", "base_sha":base})
    expect_auth(tmp, "N_UNKNOWN_STATE", "recover", req(state="OWNER_ACTION_REQUIRED"), False,
                state_after="UNKNOWN_FUTURE_STATE", workspace_changes=False, refs_change=False,
                builder_launched=False)
    write_json(state_file, {"task":"h-035", "state":"OWNER_CANDIDATE_REVIEW_REQUIRED", "base_sha":base,
                            "candidate_sha":base, "review_identity":"review-1"})
    expect_auth(tmp, "N32_REVIEW_PUBLICATION", "record-review", req(review_result="PASS",candidate_sha=base,review_identity="review-1"), True,
                state_after="OWNER_FINAL_FREEZE_REQUIRED", state_changes=True, refs_change=False,
                published=False, merged=False)
    for name, extra in (
      ("N33_WRONG_CANDIDATE", dict(candidate_sha="1"*40)), ("N34_WRONG_REVIEW", dict(review_identity="wrong")),
      ("N35_WRONG_BASE", dict(base_sha="2"*40)), ("N35B_WRONG_MAIN", dict(main_sha="3"*40)),
      ("N28_WRONG_SPEC_DIGEST", dict(spec_sha256="4"*64)), ("N29_WRONG_REGISTRY_DIGEST", dict(registry_sha256="5"*64)),
      ("N_FREEZE_MISSING_PASS", dict(review_result="FAIL")),
    ): expect_auth(tmp, name, "owner-freeze", {**freeze_common, **extra}, False,
                   state_changes=False, workspace_changes=False, refs_change=False)
    # Repeat review is idempotent in external state and still cannot publish.
    expect_auth(tmp, "P10_REVIEW_TO_FINAL", "record-review", req(review_result="PASS",candidate_sha=base,review_identity="review-1"), True,
                state_after="OWNER_FINAL_FREEZE_REQUIRED", refs_change=False, published=False)
    expect_auth(tmp, "P11_EXACT_OWNER_FREEZE", "owner-freeze", req(review_result="PASS",candidate_sha=base,review_identity="review-1"), True,
                state_after="OWNER_FROZEN", state_changes=True, refs_change=False)
    # Identical corpus through real validation and real Git-scope policy consumers.
    corpus = [("EXACT", "safe/x", True), ("PARENT", "safe/**", True),
              ("CHILD", "safe/x/child", False), ("SIBLING", "sibling/**", False),
              ("UNSUPPORTED", "safe/*", False), ("BACKSLASH", r"safe\x", True),
              ("DOTDOT", "../safe/x", False), ("DOT", "./safe/x", False),
              ("REPEATED", "safe//x", False), ("ROOT", "**", False)]
    for name, pattern, permits in corpus:
        prepo, pbase, psha = path_candidate(tmp, name, pattern)
        preq = {**common, "repo":str(prepo), "base_sha":pbase, "candidate_sha":psha,
                "task_id":"fixture-task"}
        expect_auth(tmp, f"PATH_VALIDATE_{name}", "validate-task", preq, permits)
        expect_auth(tmp, f"PATH_POLICY_{name}", "check-candidate", {**preq, "actor":"ordinary"}, permits)


def frozen_checks() -> None:
    spec = strict_load(SPEC); reg = strict_load(REG)
    if not isinstance(spec, dict) or not isinstance(reg, dict): raise Rig("frozen JSON top-level")
    tasks = spec.get("tasks", []); hits = [t for t in tasks if isinstance(t, dict) and t.get("id") == "h-035"]
    check(spec.get("spec_version") == "2.0.0", "F_SCHEMA_V2")
    check(len(hits) == 1 and hits[0].get("depends_on") == ["h-017"], "F_H035_ID_DEP")
    forbidden = {"specs/tasks.spec.json", "specs/owner-production-paths.v1.json", "verify/bin/h-035-exit"}
    check(len(hits) == 1 and not forbidden.intersection(hits[0].get("allowed_write", [])), "F_BUILDER_CANNOT_EDIT_GATE")
    check(not any(isinstance(t, dict) and t.get("id") == "h-034" for t in tasks), "F_H034_TASK_ABSENT")
    ok, why = validate_registry(reg); check(ok, "F_REGISTRY_STRICT", why)
    registry_selftests(reg)
    h034 = [p for p in ROOT.glob("controller/h034-native/**/*") if p.is_file()] + [p for p in ROOT.glob("verify/h034/**/*") if p.is_file()]
    check(not h034, "F_H034_BYTES_ABSENT", repr(h034))


def main() -> int:
    try:
        if len(sys.argv) == 4 and sys.argv[1] == "--owner-acceptance":
            return owner_acceptance(sys.argv[2], Path(sys.argv[3]).resolve())
        if len(sys.argv) != 1:
            raise Rig("usage: h-035-exit [--owner-acceptance CANDIDATE_SHA ARTIFACT_PATH]")
        frozen_checks(); path_selftests(); observer_selftests()
        with tempfile.TemporaryDirectory(prefix="h035-real-effect-") as raw:
            tmp = Path(raw)
            real_routing(tmp)
            production_matrix(tmp)
    except (OSError, subprocess.SubprocessError, ValueError, Rig) as e:
        print(f"RIG_ERROR: {e}", file=sys.stderr)
        return 2
    print(f"H035_GATE_SUMMARY={passed} PASS {failed} FAIL")
    if failed:
        print("H035_GATE_RESULT=EXPECTED_RED")
        return 1
    print("H035_GATE_RESULT=PASS")
    return 0


if __name__ == "__main__":
    sys.exit(main())
