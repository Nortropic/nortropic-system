  if _full(held)!=want or _full(named)!=want or fdbytes(fd,262144)!=raw:raise Stop("retained manifest replacement")
def retained_raw(context,path,mode,limit,identity):
 _validate_context(context);rootfd=context["statefd"] if path.parent==context["state"] else context["attestfd"];name=path.name
 a=os.stat(name,dir_fd=rootfd,follow_symlinks=False)
