def r15_frozen_contract_candidate(repo: Path,
                                  contract_merge: str | None = None) -> str:
    if contract_merge is not None:
        if not r15_lower_hex(contract_merge,40):
            raise Rig("frozen R15 contract merge identity")
        commit=r15_git(repo,"cat-file","-p",contract_merge)
        parents=[line.split(" ",1)[1] for line in commit.stdout.splitlines()
                 if line.startswith("parent ")]
        if commit.returncode or len(parents)!=2:
            raise Rig("frozen R15 contract merge graph")
        candidate=parents[1]
        candidate_commit=r15_git(repo,"cat-file","-p",candidate)
        candidate_parents=[line.split(" ",1)[1]
                           for line in candidate_commit.stdout.splitlines()
                           if line.startswith("parent ")]
        ok,_=r15_contract_candidate_scope(repo,candidate)
        candidate_tree=r15_git(repo,"rev-parse",f"{candidate}^{{tree}}")
        merge_tree=r15_git(repo,"rev-parse",f"{contract_merge}^{{tree}}")
        if (candidate_commit.returncode or len(candidate_parents)!=1
                or parents!=[candidate_parents[0],candidate]
                or not ok or candidate_tree.returncode or merge_tree.returncode
                or candidate_tree.stdout.strip()!=merge_tree.stdout.strip()):
            raise Rig("frozen R15 contract merge/candidate binding")
        return candidate
    head=r15_git(repo,"rev-parse","--verify","HEAD")
    if not head.returncode and r15_lower_hex(head.stdout.strip(),40):
        candidate=head.stdout.strip()
        ok,_=r15_contract_candidate_scope(repo,candidate)
        if ok:return candidate
    children=r15_git(repo,"rev-list","--all","--children")
    if children.returncode: raise Rig("cannot locate frozen R15 contract candidate")
    candidates=[]
    for line in children.stdout.splitlines():
        fields=line.split()
        if fields and fields[0]==H035_R15_BASE:
            for child in fields[1:]:
                ok,_=r15_contract_candidate_scope(repo,child)
                if ok: candidates.append(child)
    candidates=sorted(set(candidates))
    if len(candidates)!=1: raise Rig(f"R15 contract candidate cardinality {candidates!r}")
    return candidates[0]


def r15_reference_product(repo: Path, contract_merge: str,
                          label: str, sources: tuple[str,str,str]) -> str:
    checkout=git(repo,"checkout","--detach","-q",contract_merge)
    if checkout.returncode: raise Rig(checkout.stderr)
    for relative,source in zip(H035_R15_PRODUCT_PATHS,sources):
        path=repo/relative; path.write_text(source,encoding="utf-8"); path.chmod(0o755)
    candidate=commit_paths(repo,label,*H035_R15_PRODUCT_PATHS)
    ok,why=r15_product_diff_scope(repo,contract_merge,candidate,sources)
    if not ok: raise Rig(label+": "+why)
    return candidate


def r15_reference_satisfiability(
        tmp: Path, contract_merge_hint: str | None = None) -> tuple[bool,str,int]:
    """Canonical connected witness plus nine pre-matrix source-capability rejections."""
    try:
        contract_candidate=r15_frozen_contract_candidate(ROOT,contract_merge_hint)
        repo=tmp/"source"
        cloned=run(["/usr/bin/git","clone","--no-hardlinks","-q",str(ROOT),str(repo)],cwd=tmp)
        if cloned.returncode: raise Rig(cloned.stderr)
        for key,value in (("user.name","H035 R15 Reference"),("user.email","reference@example.invalid")):
            configured=git(repo,"config",key,value)
            if configured.returncode: raise Rig(configured.stderr)
        contract_tree=r15_git(repo,"rev-parse",f"{contract_candidate}^{{tree}}").stdout.strip()
        candidate_record=r15_git(repo,"cat-file","-p",contract_candidate)
        candidate_parents=[line.split(" ",1)[1]
                           for line in candidate_record.stdout.splitlines()
                           if line.startswith("parent ")]
        if candidate_record.returncode or len(candidate_parents)!=1:
            raise Rig("R15 reference contract candidate graph")
        authority_base=candidate_parents[0]
        if authority_base not in {H035_R15_BASE,
                str(H035_R26_SUCCESSOR["authority_base_sha"])}:
            raise Rig("R15 reference contract authority state")
        if contract_merge_hint is None:
            contract_merge=r15_commit_tree(
                repo,contract_tree,[authority_base,contract_candidate],
                "R15 judge-only guarded state-matched contract publication")
        else:
            contract_merge=contract_merge_hint
            merge_tree=r15_git(repo,"rev-parse",f"{contract_merge}^{{tree}}")
            merge_record=r15_git(repo,"cat-file","-p",contract_merge)
            merge_parents=[line.split(" ",1)[1]
                           for line in merge_record.stdout.splitlines()
                           if line.startswith("parent ")]
            if (merge_tree.returncode or merge_record.returncode
                    or merge_tree.stdout.strip()!=contract_tree
                    or merge_parents!=[authority_base,contract_candidate]):
                raise Rig("R15 reference supplied contract publication")
        mixed_parent=(str(H035_R26_SUCCESSOR["authority_base_sha"])
                      if authority_base==H035_R15_BASE else H035_R15_BASE)
        mixed_contract=r15_commit_tree(
            repo,contract_tree,[mixed_parent,contract_candidate],
            "R23 mixed-state contract publication mutant")
        try:
            r15_frozen_contract_candidate(repo,mixed_contract)
        except Rig as exc:
            mixed_rejection=str(exc)
        else:
            mixed_rejection="ACCEPTED"
        check(mixed_rejection=="frozen R15 contract merge/candidate binding",
              "J_R23_FROZEN_CONTRACT_SELECTOR_MIXED_FIRST_PARENT_REJECTS_CAUSAL",
              mixed_rejection)
        source_origin=tmp/"source-origin.git"
        made=run(["/usr/bin/git","init","--bare","-q",str(source_origin)],cwd=tmp)
        if made.returncode: raise Rig(made.stderr)
        configured=git(repo,"remote","set-url","origin",str(source_origin.resolve()))
        if configured.returncode: raise Rig(configured.stderr)
        set_remote_main(source_origin,repo,contract_merge)
        reference_sources=r15_reference_sources(repo,contract_merge)
        reference=r15_reference_product(
            repo,contract_merge,"R15 executable reference product",reference_sources)
        measured=r15_git(repo,"diff","--numstat","--no-renames","--no-ext-diff",
                         "--no-textconv",contract_merge,reference,"--",
                         *H035_R15_PRODUCT_PATHS)
        measured_rows={}
        for line in measured.stdout.splitlines():
            fields=line.split("\t")
            if len(fields)!=3 or not fields[0].isdigit() or not fields[1].isdigit():
                raise Rig("R15 reference numstat shape")
            measured_rows[fields[2]]=(int(fields[0]),int(fields[1]))
        measured_pairs=[measured_rows.get(path,(None,None))
                        for path in H035_R15_PRODUCT_PATHS]
        check(measured.returncode==0 and measured_pairs==[(1757,0),(142,0),(154,0)]
              and sum(row[0] for row in measured_pairs)==2053
              and sum(row[1] for row in measured_pairs)==0,
              "J_R15_REFERENCE_TRANSFORM_NUMSTAT_EXACT_2053_PLUS_18_RESERVE",
              measured.stdout)
        branch=git(repo,"branch","-f","r15-reference-product",reference)
        if branch.returncode: raise Rig(branch.stderr)
        ok,why,count=r15_connected_matrix(
            tmp/"passing",contract_merge,reference,source_repo=repo)
        check(ok and count>0,"J_R15_REFERENCE_FULL_CONNECTED_MATRIX_POSITIVE",why)

        zero="#!/usr/bin/env python3.12\nimport sys\nsys.exit(0)\n"
        canned_authority=("#!/usr/bin/env python3.12\nimport json\n"
                          "print(json.dumps({'accepted':True,'state':'OWNER_FROZEN'}))\n"
                          "raise SystemExit(0)\n")
        canned_taskval="#!/usr/bin/env python3.12\nimport sys\nsys.exit(0)\n"
        canned_attest=("#!/usr/bin/env python3.12\nimport json\n"
                       "print(json.dumps({'task':'h-036','stale':False}))\n"
                       "raise SystemExit(0)\n")
        nominal_attest=r'''#!/usr/bin/env python3.12
import json,sys
from pathlib import Path
p=Path(sys.argv[1])
if sys.argv[2]=='write':
 p.mkdir(parents=True,exist_ok=True);(p/'attestations.json').write_text(json.dumps({'attestations':{},'omtest_ko':[],'invalidated_shas':[]}));sys.exit(0)
sys.exit(0)
'''
        nominal_authority=("#!/usr/bin/env python3.12\nimport json\n"
                           "print(json.dumps({'accepted':True,'state':'OWNER_FROZEN'}))\n")
        nominal_taskval=r'''#!/usr/bin/env python3.12
import sys
from pathlib import Path
if sys.argv[1]=='bootstrap-serialized':
 Path(sys.argv[3]).mkdir(parents=True,exist_ok=True);Path(sys.argv[4]).mkdir(parents=True,exist_ok=True)
sys.exit(0)
'''
        authority_call='''runtime=_r15_runtime()
                try:return runtime["authority_value"](argv,value)
                finally:_r15_os.close(runtime["_r15_installed_attest_fd"])'''
        authority_double='''runtime=_r15_runtime()
                try:
                    original=runtime["authority_value"]
                    result=original(argv,value)
                    saved=sys.stdout;sys.stdout=sys.stderr
                    try:original(argv,value)
                    finally:sys.stdout=saved
                    return result
                finally:_r15_os.close(runtime["_r15_installed_attest_fd"])'''
        authority_double_load='''if set(value)=={"h035_r15_request"}:
                    older=_r15_runtime();newer=_r15_runtime()
                    try:
                        result=older["authority_value"](argv,value)
                        saved=sys.stdout;sys.stdout=sys.stderr
                        try:newer["authority_value"](argv,value)
                        finally:sys.stdout=saved
                        return result
                    finally:
                        _r15_os.close(older["_r15_installed_attest_fd"])
                        _r15_os.close(newer["_r15_installed_attest_fd"])
                runtime=_r15_runtime()
                try:return runtime["authority_value"](argv,value)
                finally:_r15_os.close(runtime["_r15_installed_attest_fd"])'''
        authority_eval_load='''if set(value)=={"h035_r15_request"}:
                    globals()["_r15_eval_mode"]=True
                    older=_r15_runtime()
                    globals()["_r15_eval_mode"]=False
                    newer=_r15_runtime()
                    try:
                        result=older["authority_value"](argv,value)
                        saved=sys.stdout;sys.stdout=sys.stderr
                        try:newer["authority_value"](argv,value)
                        finally:sys.stdout=saved
                        return result
                    finally:
                        globals().pop("_r15_eval_mode",None)
                        _r15_os.close(older["_r15_installed_attest_fd"])
                        _r15_os.close(newer["_r15_installed_attest_fd"])
                runtime=_r15_runtime()
                try:return runtime["authority_value"](argv,value)
                finally:_r15_os.close(runtime["_r15_installed_attest_fd"])'''
        authority_wrong_name_load=authority_eval_load.replace(
            "_r15_eval_mode","_r15_wrong_name_mode")
        if reference_sources[1].count(authority_call)!=1:
            raise Rig("R15 double export mutant anchor")
        double_authority=reference_sources[1].replace(authority_call,authority_double,1)
        double_load_authority=reference_sources[1].replace(
            authority_call,authority_double_load,1)
        engine_exec='exec(compile(payload,"<h035-r15-retained-attest-engine>","exec",dont_inherit=True,optimize=0),ns,ns)'
        engine_eval='(eval if globals().get("_r15_eval_mode") else exec)(compile(payload,"<h035-r15-retained-attest-engine>","exec",dont_inherit=True,optimize=0),ns,ns)'
        engine_wrong_name='exec(compile(payload,("<h035-r15-retained-attest-engine-wrong>" if globals().get("_r15_wrong_name_mode") else "<h035-r15-retained-attest-engine>"),"exec",dont_inherit=True,optimize=0),ns,ns)'
        if reference_sources[1].count(engine_exec)!=1:
            raise Rig("R15 eval engine mutant anchor")
        eval_load_authority=reference_sources[1].replace(
            engine_exec,engine_eval,1).replace(authority_call,authority_eval_load,1)
        wrong_name_load_authority=reference_sources[1].replace(
            engine_exec,engine_wrong_name,1).replace(
                authority_call,authority_wrong_name_load,1)
        legacy_return='    return _r15_legacy_main(argv)\n'
        legacy_parallel='''    if len(argv)==5 and argv[2]=="read" and argv[4]=="--require-valid":
        saved=sys.stdout;sys.stdout=sys.stderr
        try:_r15_legacy_main(argv[:-1])
        finally:sys.stdout=saved
        return kmd_read(Path(argv[1]),argv[3],True)
    return _r15_legacy_main(argv)
'''
        if reference_sources[0].count(legacy_return)!=1:
            raise Rig("R15 legacy argument mutant anchor")
        wrong_legacy_attest=reference_sources[0].replace(
            legacy_return,legacy_parallel,1)
        legacy_taskval=r15_git_object_bytes(repo,H035_R15_BASE,"controller/taskval/cli")
        if legacy_taskval is None:raise Rig("R15 copied legacy mutant base")
        legacy_taskval_text=legacy_taskval.decode("utf-8",errors="strict")
        start=legacy_taskval_text.find("def attesterad_giltig(")
        if start<0:raise Rig("R15 copied legacy mutant call anchor")
        finish=legacy_taskval_text.find("\n\ndef ",start)
        if finish<start:raise Rig("R15 copied legacy mutant call extent")
        copied=("_r15_saved_attesterad_giltig=attesterad_giltig\n"+legacy_taskval_text[start:finish]
                +"\n_r15_same_name_attesterad_giltig=attesterad_giltig\nattesterad_giltig=_r15_saved_attesterad_giltig\n")
        if reference_sources[2].count("_r15_loader_root=ROT\n")!=1:
            raise Rig("R15 copied legacy mutant insertion anchor")
        copied_taskval=reference_sources[2].replace(
            "_r15_loader_root=ROT\n",copied+"_r15_loader_root=ROT\n",1)
        def additive_shim(legacy: str, shim: str) -> str:
            tree=ast.parse(legacy); insertion=1
            for node in tree.body:
                module_doc=(isinstance(node,ast.Expr) and isinstance(node.value,ast.Constant)
                            and isinstance(node.value.value,str))
                future=(isinstance(node,ast.ImportFrom) and node.module=="__future__")
                if not (module_doc or future):break
                insertion=max(insertion,node.end_lineno or insertion)
            _shim_first,shim_rest=shim.split("\n",1);lines=legacy.splitlines(keepends=True)
            return "".join(lines[:insertion])+shim_rest+"".join(lines[insertion:])
        mutants=(
            ("EXIT_ZERO_NO_EFFECT",tuple(additive_shim(value,zero) for value in reference_sources)),
            ("CANNED_SUCCESS_OUTPUT",tuple(additive_shim(value,shim) for value,shim in zip(
                reference_sources,(canned_attest,canned_authority,canned_taskval)))),
            ("NOMINAL_FILES_NO_VALIDATION",tuple(additive_shim(value,shim) for value,shim in zip(
                reference_sources,(nominal_attest,nominal_authority,nominal_taskval)))),
            ("EXACT_EXPORT_DOUBLE_EXECUTION",
             (reference_sources[0],double_authority,reference_sources[2])),
            ("TWO_RETAINED_LOADS_OLDER_CALL_PLUS_CURRENT_CALL",
             (reference_sources[0],double_load_authority,reference_sources[2])),
            ("EVAL_EXEC_CODE_OLDER_PLUS_EXEC_CURRENT",
             (reference_sources[0],eval_load_authority,reference_sources[2])),
            ("WRONG_FILENAME_ENGINE_OLDER_PLUS_CURRENT",
             (reference_sources[0],wrong_name_load_authority,reference_sources[2])),
            ("COPIED_SAME_NAME_LEGACY_CALLABLE",
             (reference_sources[0],reference_sources[1],copied_taskval)),
            ("LEGACY_WRONG_ARGS_PARALLEL_READ",
            (wrong_legacy_attest,reference_sources[1],reference_sources[2])),
        )
        superficial_exact={
            "EXIT_ZERO_NO_EFFECT":([1759,144,156],2059,
                "candidate capability signature differs: controller/attest/cli"),
            "CANNED_SUCCESS_OUTPUT":([1760,145,156],2061,
                "candidate capability signature differs: controller/attest/cli"),
            "NOMINAL_FILES_NO_VALIDATION":([1763,144,159],2066,
                "candidate capability signature differs: controller/attest/cli"),
            "EXACT_EXPORT_DOUBLE_EXECUTION":([1757,148,154],2059,
                "candidate capability signature differs: controller/authority/cli"),
            "TWO_RETAINED_LOADS_OLDER_CALL_PLUS_CURRENT_CALL":([1757,153,154],2064,
                "candidate capability signature differs: controller/authority/cli"),
            "EVAL_EXEC_CODE_OLDER_PLUS_EXEC_CURRENT":([1757,157,154],2068,
                "candidate controller/authority/cli: reflection/observer recovery name: eval"),
            "WRONG_FILENAME_ENGINE_OLDER_PLUS_CURRENT":([1757,157,154],2068,
                "candidate controller/authority/cli: reflection/observer recovery name: globals"),
            "COPIED_SAME_NAME_LEGACY_CALLABLE":([1757,142,172],2071,
                "candidate controller/taskval/cli: base definition missing/duplicate/substituted"),
            "LEGACY_WRONG_ARGS_PARALLEL_READ":([1762,142,154],2058,
                "candidate capability signature differs: controller/attest/cli"),
        }
        for serial,(label,sources) in enumerate(mutants):
            checkout=git(repo,"checkout","--detach","-q",contract_merge)
            if checkout.returncode:raise Rig(checkout.stderr)
            for relative,source in zip(H035_R15_PRODUCT_PATHS,sources):
                path=repo/relative;path.write_text(source,encoding="utf-8");path.chmod(0o755)
            candidate=commit_paths(repo,"R15 source-envelope mutant "+label,*H035_R15_PRODUCT_PATHS)
            structural_ok,structural_why=r15_product_diff_scope(repo,contract_merge,candidate,None)
            numstat=r15_git(repo,"diff","--numstat","--no-renames","--no-ext-diff",
                "--no-textconv",contract_merge,candidate,"--",*H035_R15_PRODUCT_PATHS)
            rows=[line.split("\t") for line in numstat.stdout.splitlines()]
            additions=[int(row[0]) for row in rows if len(row)==3 and row[0].isdigit()]
            canonical_ok,canonical_why=r15_product_diff_scope(
                repo,contract_merge,candidate,reference_sources)
            exact_reason=superficial_exact[label][2]
            exact_counts=(additions==superficial_exact[label][0]
                          and sum(additions)==superficial_exact[label][1])
            check(structural_ok and numstat.returncode==0 and len(rows)==3
                  and all(len(row)==3 and row[0].isdigit() and row[1]=="0"
                          and row[2]==path for row,path in zip(rows,H035_R15_PRODUCT_PATHS))
                  and exact_counts and not canonical_ok and canonical_why==exact_reason,
                  "J_R15_REFERENCE_REJECTS_"+label,
                  structural_why+" | "+canonical_why+" rows="+repr(rows))
            git(repo,"branch","-f",f"r15-reference-mutant-{serial}",candidate)
        marker='REQUEST_MARKER={"record_type":"h035_r15_authority_request_v1","schema_version":1}'
        if reference_sources[0].count(marker)!=1:
            raise Rig("R20 exact-line source-continuity mutant anchor")
        nonreference_sources=(reference_sources[0].replace(
            marker,marker.replace('"schema_version":1','"schema_version":2'),1),
            reference_sources[1],reference_sources[2])
        checkout=git(repo,"checkout","--detach","-q",contract_merge)
        if checkout.returncode:raise Rig(checkout.stderr)
        for relative,source in zip(H035_R15_PRODUCT_PATHS,nonreference_sources):
            path=repo/relative;path.write_text(source,encoding="utf-8");path.chmod(0o755)
        nonreference=commit_paths(
            repo,"R20 exact-numstat nonreference refreeze mutant",*H035_R15_PRODUCT_PATHS)
        branch=git(repo,"branch","-f","r20-nonreference-refreeze-mutant",nonreference)
        if branch.returncode:raise Rig(branch.stderr)
        structural_ok,structural_why=r15_product_diff_scope(
            repo,contract_merge,nonreference,None)
        canonical_ok,canonical_why=r15_product_diff_scope(
            repo,contract_merge,nonreference,reference_sources)
        gap_tmp=tmp/"nonreference-refreeze"
        gap_tmp.mkdir(mode=0o700)
        gap_fixture=r15_prepare_published_fixture(
            gap_tmp,contract_merge,nonreference,source_repo=repo)
        refreeze_ok,refreeze_why=r15_h038_refreeze_proof(
            gap_fixture["repo"],Path(str(gap_fixture["contract_review_path"])),
            Path(str(gap_fixture["contract_receipt_path"])))
        check(structural_ok and not canonical_ok and not refreeze_ok
              and canonical_why=="candidate capability signature differs: controller/attest/cli"
              and refreeze_why=="R15_H035_PRODUCT_GRAPH_SCOPE",
              "J_R20_H038_EXACT_NUMSTAT_NONREFERENCE_PRODUCT_REJECTS_CAUSAL",
              structural_why+" | "+canonical_why+" | "+refreeze_why)
        return ok,why,count
    except (OSError,subprocess.SubprocessError,ValueError,Rig) as exc:
        return False,str(exc),0


def main() -> int:
    try:
        r15_require_ast_interpreter()
        if len(sys.argv) == 4 and sys.argv[1] == "--owner-acceptance":
            return owner_acceptance(sys.argv[2], Path(sys.argv[3]))
        if (sys.argv[1:2] == ["--r14-registry-migration"]
                and len(sys.argv) in (2, 4)):
            product_bound = len(sys.argv) == 4
            frozen_checks()
            with tempfile.TemporaryDirectory(prefix="h035-r14-registry-") as raw:
                r14_registry_migration_controls(Path(raw))
            if product_bound:
                ok, why = r14_product_identity(sys.argv[2], sys.argv[3])
                check(ok, "A_R14_PRODUCT_EXACT_CORE_ONLY_DIFF_AND_CANDIDATE_IDENTITY", why)
            print(f"H035_R14_TARGET_SUMMARY={passed} PASS {failed} FAIL")
            if failed:
                expected = H035_R14_TWO_STATE_REGISTRY["preproduct_evidence"]
                exact_red = False
                if not product_bound and len(failed_labels) == 1:
                    label, detail = failed_labels[0]
                    try: payload = json.loads(detail)
                    except (TypeError, ValueError): payload = None
                    exact_red = (label == expected["expected_red_label"]
                        and isinstance(payload, dict)
                        and payload.get("reason") == expected["expected_reason"]
                        and exact_value(payload.get("failure_signature"),
                                        expected["expected_failure_signature"]))
                if exact_red:
                    print(f"H035_R14_TARGET_REASON={expected['expected_reason']}")
                    print("H035_R14_TARGET_RESULT=EXPECTED_PREPRODUCT_RED")
                    return 1
                print("H035_R14_TARGET_RESULT=UNEXPECTED_RED")
                return 2
            if not product_bound:
                print("H035_R14_TARGET_RESULT=PRODUCT_IDENTITY_REQUIRED")
                return 2
            print("H035_R14_TARGET_RESULT=PASS")
            return 0
        if (sys.argv[1:2] == ["--r29-registry-migration"]
                and len(sys.argv) in (2,4)):
            product_bound=len(sys.argv)==4
            frozen_checks()
            if not product_bound:
                identity_ok,identity_why=r29_test_author_identity()
                check(identity_ok,
                      "A_R29_TEST_AUTHOR_EXACT_SIX_FILE_DIRECT_CHILD_IDENTITY",
                      identity_why)
            with tempfile.TemporaryDirectory(prefix="h035-r29-registry-") as raw:
                tmp=Path(raw)
                r14_registry_migration_controls(tmp)
                r29_registry_migration_controls(tmp)
            if product_bound:
                ok,why=r14_product_identity(sys.argv[2],sys.argv[3])
                check(ok,"A_R29_PRODUCT_EXACT_CORE_ONLY_DIFF_AND_CANDIDATE_IDENTITY",why)
            print(f"H035_R29_TARGET_SUMMARY={passed} PASS {failed} FAIL")
            if failed:
                expected=H035_R29_THREE_STATE_REGISTRY["preproduct_evidence"]
                exact_red=False
                if not product_bound and len(failed_labels)==1:
                    label,detail=failed_labels[0]
                    try:payload=json.loads(detail)
                    except (TypeError,ValueError):payload=None
                    exact_red=(label==expected["expected_red_label"]
                        and isinstance(payload,dict)
                        and payload.get("reason")==expected["expected_reason"]
                        and exact_value(payload.get("failure_signature"),
                                        expected["expected_failure_signature"]))
                if exact_red:
                    print(f"H035_R29_TARGET_REASON={expected['expected_reason']}")
                    print("H035_R29_TARGET_RESULT=EXPECTED_PREPRODUCT_RED")
                    return 1
                print("H035_R29_TARGET_RESULT=UNEXPECTED_RED")
                return 2
            if not product_bound:
                print("H035_R29_TARGET_RESULT=PRODUCT_IDENTITY_REQUIRED")
                return 2
            print("H035_R29_TARGET_RESULT=PASS")
            return 0
        if (sys.argv[1:2] == ["--r33-registry-migration"]
                and len(sys.argv) in (2,4)):
            product_bound=len(sys.argv)==4
            frozen_checks()
            if not product_bound:
                identity_ok,identity_why=r33_test_author_identity()
                check(identity_ok,
                      "A_R33_TEST_AUTHOR_EXACT_SIX_FILE_DIRECT_CHILD_IDENTITY",
                      identity_why)
            with tempfile.TemporaryDirectory(prefix="h035-r33-registry-") as raw:
                tmp=Path(raw)
                r33_source_oracle_selftests()
                r14_registry_migration_controls(tmp)
                r29_registry_migration_controls(tmp,r33=True)
            if product_bound:
                ok,why=r33_product_identity(sys.argv[2],sys.argv[3])
                check(ok,"A_R33_PRODUCT_EXACT_CORE_AND_CLI_DIFF_AND_CANDIDATE_IDENTITY",why)
                source_ok,source_why=r33_product_source_oracle(ROOT,sys.argv[2],sys.argv[3])
                check(source_ok,"A_R33_PRODUCT_NO_AMBIENT_REGISTRY_AUTHORITY",source_why)
            print(f"H035_R33_TARGET_SUMMARY={passed} PASS {failed} FAIL")
            if failed:
                expected=H035_R33_REQUEST_BOUND_REGISTRY["preproduct_evidence"]
                exact_red=False
                if not product_bound and len(failed_labels)==1:
                    label,detail=failed_labels[0]
                    try:payload=json.loads(detail)
                    except (TypeError,ValueError):payload=None
                    exact_red=(label==expected["expected_red_label"]
                        and isinstance(payload,dict)
                        and payload.get("reason")==expected["expected_reason"]
                        and exact_value(payload.get("failure_signature"),
                                        expected["expected_failure_signature"]))
                if exact_red:
                    print(f"H035_R33_TARGET_REASON={expected['expected_reason']}")
                    print("H035_R33_TARGET_RESULT=EXPECTED_PREPRODUCT_RED")
                    return 1
                print("H035_R33_TARGET_RESULT=UNEXPECTED_RED")
                return 2
            if not product_bound:
                print("H035_R33_TARGET_RESULT=PRODUCT_IDENTITY_REQUIRED")
                return 2
            print("H035_R33_TARGET_RESULT=PASS")
            return 0
        if (sys.argv[1:2] == ["--r15-owner-product-lifecycle"]
                and len(sys.argv) in (2,4)):
            product_bound=len(sys.argv)==4
            with tempfile.TemporaryDirectory(prefix="h035-r15-owner-lifecycle-") as raw:
                tmp=Path(raw).resolve(strict=True)
                lanes={name:tmp/name for name in (
                    "historical","inheritance","product-scope","remote-boundary",
                    "reference","actual")}
                for lane in lanes.values(): lane.mkdir(mode=0o700)
                frozen_checks()
                r15_historical_regression_floor(lanes["historical"])
                r15_gate_inheritance_selftests()
                r15_gate_inheritance_git_controls(
                    lanes["inheritance"],sys.argv[2] if product_bound else None)
                r15_product_scope_selftests(lanes["product-scope"])
                r15_source_capability_selftests()
                r15_remote_boundary_selftests(lanes["remote-boundary"])
                # The executable reference witness is a judge-only satisfiability
                # proof and can never contribute candidate acceptance credit.
                reference_ok,reference_why,reference_count=r15_reference_satisfiability(
                    lanes["reference"],sys.argv[2] if product_bound else None)
                reference_verified=(reference_ok and reference_count>0)
                check(reference_verified,
                      "J_R15_EXECUTABLE_REFERENCE_THREE_CLI_FULL_MATRIX_SATISFIABLE",
                      reference_why)
                if product_bound:
                    identity_ok,identity_why=r15_product_identity(sys.argv[2],sys.argv[3])
                    check(identity_ok,
                          "A_R15_PRODUCT_EXACT_PUBLISHED_BASE_DIRECT_CHILD_THREE_CLI_IDENTITY",
                          identity_why)
                    if r15_matrix_authorized(reference_ok,reference_count,identity_ok,failed):
                        matrix_ok,matrix_why,matrix_count=r15_connected_matrix(
                            lanes["actual"],sys.argv[2],sys.argv[3])
                        check(matrix_ok and matrix_count==reference_count,
                              H035_R15_EXPECTED_LABEL,matrix_why)
                    else:
                        check(False,H035_R15_EXPECTED_LABEL,
                              "NON_CREDIT_MATRIX_PREREQUISITE_REJECTED")
                else:
                    identity_ok,identity_why=r15_test_author_identity()
                    check(identity_ok,"A_R15_TEST_AUTHOR_EXACT_FIVE_FILE_DIRECT_CHILD_IDENTITY",
                          identity_why)
                    signature=r15_preproduct_absence_probes(tmp)
                    check(False,H035_R15_EXPECTED_LABEL,json.dumps({
                        "reason":H035_R15_EXPECTED_REASON,
                        "failure_signature":list(signature),
                    },sort_keys=True,separators=(",",":")))
            print("MATERIAL_PROPERTIES_JUDGE_ONLY=NONE")
            print(f"H035_R15_TARGET_SUMMARY={passed} PASS {failed} FAIL")
            if failed:
                expected_red=False
                if not product_bound and len(failed_labels)==1:
                    label,detail=failed_labels[0]
                    try: payload=json.loads(detail)
                    except (TypeError,ValueError): payload=None
                    expected_red=(label==H035_R15_EXPECTED_LABEL
                                  and isinstance(payload,dict)
                                  and payload.get("reason")==H035_R15_EXPECTED_REASON
                                  and r15_json_equal(payload.get("failure_signature"),
                                                    list(H035_R15_FAILURE_SIGNATURE)))
                if expected_red:
                    print(f"H035_R15_TARGET_REASON={H035_R15_EXPECTED_REASON}")
                    print("H035_R15_TARGET_RESULT=EXPECTED_PREPRODUCT_RED")
                    return 1
                print("H035_R15_TARGET_RESULT=UNEXPECTED_RED")
                return 2
            if not product_bound:
                print("H035_R15_TARGET_RESULT=UNEXPECTED_PREPRODUCT_GREEN")
                return 2
            print("H035_R15_TARGET_RESULT=PASS")
            return 0
        if len(sys.argv) != 1:
            raise Rig("usage: h-035-exit [--owner-acceptance CANDIDATE_SHA ARTIFACT_PATH|--r14-registry-migration [BASE_SHA CANDIDATE_SHA]|--r29-registry-migration [BASE_SHA CANDIDATE_SHA]|--r33-registry-migration [BASE_SHA CANDIDATE_SHA]|--r15-owner-product-lifecycle [BASE_SHA CANDIDATE_SHA]]")
        frozen_checks(); path_selftests(); observer_selftests(); snapshot_selftests()
        with tempfile.TemporaryDirectory(prefix="h035-real-effect-") as raw:
            tmp = Path(raw)
            r14_registry_migration_controls(tmp)
            real_routing(tmp)
            production_matrix(tmp)
            remediation_matrix(tmp)
            r6_remediation_matrix(tmp)
            r9_task_gate_matrix(tmp)
            publication_contract_controls(tmp)
    except (OSError, subprocess.SubprocessError, ValueError, Rig) as e:
        print(f"RIG_ERROR: {e}", file=sys.stderr)
        return 2
    print("MATERIAL_PROPERTIES_JUDGE_ONLY=NONE")
    print(f"H035_GATE_SUMMARY={passed} PASS {failed} FAIL")
    if failed:
        print("H035_GATE_RESULT=EXPECTED_RED")
        return 1
    print("H035_GATE_RESULT=PASS")
    return 0


def r15_finalizer_agent_projection(repository_identity: str,
                                   initial_agent: str,
                                   live_agent: str) -> dict[str,str]:
    if repository_identity!="git@github.com:Nortropic/nortropic-system.git":return {}
    if not initial_agent or live_agent!=initial_agent:
        raise Rig("R15 finalizer SSH initial-agent authority")
    return {"SSH_AUTH_SOCK":initial_agent}


def r29_bpam_document(raw: bytes,contract: dict[str,object] | None=None
                      ) -> tuple[bool,str,object | None] | None:
    if (raw.count(R29_OWNER_EXCEPTION_BEGIN)!=1
            or raw.count(R29_OWNER_EXCEPTION_END)!=1):
        base=None;why="owner exception marker count"
    else:
        base,tail=raw.split(R29_OWNER_EXCEPTION_BEGIN,1)
        body,trailing=tail.split(R29_OWNER_EXCEPTION_END,1)
        why="owner exception exact trailing section"
        decision=r33_owner_decision_split(trailing)
        if (decision is None or decision[0]!=b"" or not base.endswith(BPAM_SOURCE_END)
                or hashlib.sha256(body).hexdigest()!=R29_OWNER_EXCEPTION_BODY_SHA256):
            base=None
    if contract is None:
        return bpam_document(base) if base is not None else (False,why,None)
    check(base is not None,"J_R29_BPAM_EXACT_TRAILING_OWNER_EXCEPTION",why)
    if base is not None:bpam_selftests(base,contract)
    return None


if __name__ == "__main__":
    sys.exit(main())
