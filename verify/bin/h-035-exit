    check(all(not exact_value(mutant,H035_R14_TWO_STATE_REGISTRY) for mutant in top_mutants),
          "J_R14_MISSING_EXTRA_TOP_LEVEL_REJECT")
    bp_mutants=[]
    for index in range(14):
        mutant=clone(); del mutant["bp01_bp14_bindings"][index]; bp_mutants.append(mutant)
    for action in ("duplicate","substitute","reorder","type"):
        mutant=clone(); rows=mutant["bp01_bp14_bindings"]
        if action == "duplicate": rows[1]=dict(rows[0])
        elif action == "substitute": rows[0]["binding"]="MODEL_CLAIM"
        elif action == "reorder": rows[0],rows[1]=rows[1],rows[0]
        else: rows[0]["id"]=1
        bp_mutants.append(mutant)
    check(all(not exact_value(mutant,H035_R14_TWO_STATE_REGISTRY) for mutant in bp_mutants),
          "J_R14_BP01_BP14_MISSING_DUPLICATE_SUBSTITUTE_ORDER_TYPE_REJECT")
    state_mutants=[]
