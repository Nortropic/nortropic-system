def r15_gate_inheritance_git_controls(
        tmp: Path, contract_merge_hint: str | None = None) -> None:
    base_raw=r15_git_object_bytes(ROOT,H035_R15_BASE,"verify/bin/h-035-exit")
    current_gate=Path(__file__).read_bytes(); current_spec=strict_json_bytes(SPEC.read_bytes())
    rows=[row for row in current_spec.get("tasks",[]) if isinstance(row,dict)
          and row.get("id")=="h-035"] if isinstance(current_spec,dict) else []
    contract=rows[0].get("r15_owner_product_lifecycle") if len(rows)==1 else None
    manifest=contract.get("gate_inheritance_scope") if isinstance(contract,dict) else None
    if base_raw is None or not isinstance(manifest,dict): raise Rig("HR01 Git manifest")
    alias_admin=tmp/"r17-source-admin";alias_admin.mkdir()
    alias_path=tmp/"r17-source-admin-alias";alias_path.symlink_to(alias_admin,target_is_directory=True)
    gitfile_source=tmp/"r17-gitfile-source";gitfile_source.mkdir()
    (gitfile_source/".git").write_text("gitdir: "+str(alias_path)+"\n",encoding="utf-8")
    commondir_source=tmp/"r17-commondir-source";commondir_source.mkdir()
    (commondir_source/".git").mkdir()
    (commondir_source/".git/commondir").write_text(".\n",encoding="utf-8")
    unsafe_mode_source=tmp/"r17-unsafe-mode-source";unsafe_mode_source.mkdir()
    (unsafe_mode_source/".git").mkdir(mode=0o700)
    (unsafe_mode_source/".git").chmod(0o777)
    standalone_rejections=[]
    for source_root,expected in (
            (gitfile_source,"source must be standalone .git directory"),
            (commondir_source,"source standalone commondir forbidden"),
            (unsafe_mode_source,"source standalone .git mode")):
        try:r17_standalone_source_topology(source_root)
        except Rig as exc:standalone_rejections.append(expected in str(exc))
        else:standalone_rejections.append(False)
    check(standalone_rejections==[True,True,True],
          "J_R17_SOURCE_GITFILE_SYMLINK_ALIAS_COMMONDIR_AND_UNSAFE_MODE_REJECT")
    cases=(("POSITIVE",None),("PRIOR_RETURN","PRIOR_FLOOR_RETURN_NONE"),
           ("UNCHANGED_DEF","UNCHANGED_ALTER"),("RETAINED_ISLAND","ISLAND_FROZEN"),
           ("INHERITED_REBIND","INHERITED_ASSIGNMENT"),
           ("INHERITED_DELETE","INHERITED_DELETE"),
           ("FLOOR_ONE_ARM","FLOOR_ONLY_PRODUCT_ARM"),
           ("FLOOR_PREPRODUCT_ARM","FLOOR_ONLY_PREPRODUCT_ARM"),
           ("DEFINITION_TIME_EFFECT","DEFINITION_GLOBALS_UPDATE"),
           ("BOUND_DUNDER_MUTATION","BOUND_DUNDER_SETATTR"),
           ("DESCRIPTOR_NAMESPACE_MUTATION","DICT_DESCRIPTOR_UPDATE"),
           ("FRAME_NAMESPACE_MUTATION","FRAME_GLOBALS"),
           ("NESTED_DEFINITION_EFFECT","NESTED_DEFAULT_EFFECT"),
           ("PERSISTENT_PARENT_ENVIRONMENT","ENV_PERSISTENT_MUTATION"),
           ("BODY_ANCHOR_LITERAL_DRIFT","BODY_ANCHOR_LITERAL_DRIFT"),
           ("BODY_ANCHOR_POSITION","BODY_ANCHOR_POSITION"),
           ("CROSS_FAMILY_TOP_LEVEL_INTERLEAVE","CROSS_FAMILY_TOP_LEVEL_INTERLEAVE"),
           ("FLOOR_EFFECT_ARGUMENT","FLOOR_EFFECT_ARGUMENT"),
           ("FAILURE_RESET","FLOOR_FAILURE_RESET"))
    positive_repo: Path | None=None;positive_candidate_sha=""
    for label,mutant_name in cases:
        repo=tmp/label.lower()
        cloned=run(["/usr/bin/git","clone","--no-hardlinks","-q",str(ROOT),str(repo)],cwd=tmp)
        if cloned.returncode: raise Rig(cloned.stderr)
        for args in (("config","user.name","H035 HR01"),
                     ("config","user.email","hr01@example.invalid"),
                     ("checkout","--detach","-q",H035_R15_BASE)):
            result=git(repo,*args)
            if result.returncode: raise Rig(result.stderr)
        gate=current_gate if mutant_name is None else r15_gate_mutant_source(current_gate,mutant_name)
        spec=json.loads(json.dumps(current_spec))
        if mutant_name is not None:
            task=next(row for row in spec["tasks"] if row.get("id")=="h-035")
            task["r15_owner_product_lifecycle"]["gate_inheritance_scope"]=r15_gate_repin_manifest(
                base_raw,gate,manifest)
        for relative in H035_R15_TEST_AUTHOR_PATHS:
            target=repo/relative
            if relative=="verify/bin/h-035-exit": target.write_bytes(gate)
            elif relative=="specs/tasks.spec.json": write_json(target,spec)
            else: target.write_bytes((ROOT/relative).read_bytes())
            target.chmod(0o755 if relative=="verify/bin/h-035-exit" else 0o644)
        candidate_sha=commit_paths(repo,"HR01 "+label,*H035_R15_TEST_AUTHOR_PATHS)
        changed=git(repo,"diff","--name-only",H035_R15_BASE,candidate_sha).stdout.splitlines()
        accepted,why=r15_gate_inheritance_scope(repo,H035_R15_BASE,candidate_sha)
        exact=tuple(sorted(changed))==tuple(sorted(H035_R15_TEST_AUTHOR_PATHS))
        if mutant_name=="DEFINITION_GLOBALS_UPDATE":
            exact=exact and r15_gate_import_callable_identity(gate,"path_selftests") \
                != r15_gate_import_callable_identity(base_raw,"path_selftests")
        check(exact and (accepted if mutant_name is None else not accepted),
              "J_R15_GATE_INHERITANCE_GIT_EXACT_FIVE_"+label,why)
        if mutant_name is None:
            positive_repo=repo
    if positive_repo is None:
        raise Rig("R17 owner artifact alias positive fixture")
    positive_candidate_sha=r15_frozen_contract_candidate(ROOT,contract_merge_hint)
    current_scoped,current_why=r15_contract_candidate_scope(ROOT,positive_candidate_sha)
    checkout=git(positive_repo,"checkout","--detach","-q",positive_candidate_sha)
    copied_scoped,copied_why=r15_contract_candidate_scope(
        positive_repo,positive_candidate_sha)
    copied_status=git(positive_repo,"status","--porcelain=v1","--untracked-files=all")
    if (not current_scoped or checkout.returncode or not copied_scoped
            or copied_status.returncode or copied_status.stderr or copied_status.stdout):
        raise Rig("R21 owner artifact alias successor scope: "
                  +current_why+" | "+copied_why+" | "+checkout.stderr
                  +copied_status.stderr)
    alias_program=r'''import json,os,runpy,stat,sys
from pathlib import Path
gate=Path(sys.argv[1]);candidate=sys.argv[2]
namespace=runpy.run_path(str(gate),run_name="h035_r17_owner_artifact_alias_control")
root=namespace["ROOT"];root_info=os.stat(root,follow_symlinks=False)
case_alias=None
for index,value in enumerate(root.name):
    if value.isascii() and value.isalpha():
        alternate=value.swapcase()
        candidate_alias=root.with_name(root.name[:index]+alternate+root.name[index+1:])
        try:alias_info=os.stat(candidate_alias,follow_symlinks=False)
        except OSError:continue
        if ((alias_info.st_dev,alias_info.st_ino)==(root_info.st_dev,root_info.st_ino)
                and candidate_alias!=root):
            case_alias=candidate_alias;break
data_prefix=Path("/System/Volumes/Data")
data_alias=(Path("/")/Path(*root.parts[4:]) if root.parts[:4]==("/","System","Volumes","Data")
            else data_prefix/Path(*root.parts[1:]))
aliases=(case_alias,data_alias)
alias_identities=[]
for alias in aliases:
    if alias is None:
        alias_identities.append(None);continue
    try:info=os.stat(alias,follow_symlinks=False)
    except OSError:alias_identities.append(None)
    else:alias_identities.append([info.st_dev,info.st_ino])
before,_unused=namespace["r15_loop_repository_state"](candidate)
calls=[]
def sentinel(*args,**kwargs):
    calls.append([len(args),sorted(kwargs)])
    raise namespace["Rig"]("owner artifact alias loop sentinel")
owner_globals=namespace["owner_acceptance"].__globals__
original=owner_globals["loop_fixture"];owner_globals["loop_fixture"]=sentinel
leaves=[];rejections=[]
try:
    for index,alias in enumerate(aliases):
        if alias is None:
            rejections.append("");leaves.append("");continue
        leaf=alias/(".h035-r17-owner-artifact-alias-negative-"+str(index))
        canonical=root/leaf.name
        if os.path.lexists(leaf) or os.path.lexists(canonical):
            raise namespace["Rig"]("owner artifact alias control leaf preexists")
        try:namespace["owner_acceptance"](candidate,leaf)
        except namespace["Rig"] as exc:rejections.append(str(exc))
        else:rejections.append("ACCEPTED")
        leaves.append(str(leaf))
finally:
    owner_globals["loop_fixture"]=original
after,_unused=namespace["r15_loop_repository_state"](candidate)
absent=all(not os.path.lexists(value) and not os.path.lexists(root/Path(value).name)
           for value in leaves if value)
print(json.dumps({"root_identity":[root_info.st_dev,root_info.st_ino],
    "alias_identities":alias_identities,"sentinel_calls":calls,
    "rejections":rejections,"artifact_leaves_absent":absent,
    "source_unchanged":before==after},sort_keys=True,separators=(",",":")))
'''
    alias_env={"HOME":"/private/var/empty","XDG_CONFIG_HOME":"/private/var/empty",
               "PATH":"/usr/bin:/bin","LANG":"C","LC_ALL":"C",
               "TMPDIR":str(tmp),
               "PYTHONDONTWRITEBYTECODE":"1","GIT_CONFIG_NOSYSTEM":"1",
               "GIT_CONFIG_GLOBAL":"/dev/null","GIT_CONFIG_SYSTEM":"/dev/null",
               "GIT_ATTR_NOSYSTEM":"1","GIT_TERMINAL_PROMPT":"0",
               "GIT_PAGER":"cat","GIT_OPTIONAL_LOCKS":"0"}
    alias_result=subprocess.run(
        [str(H035_R15_AST_PYTHON),"-I","-S","-B","-c",alias_program,
         str(positive_repo/"verify/bin/h-035-exit"),positive_candidate_sha],
        cwd=positive_repo,env=alias_env,text=True,capture_output=True,shell=False,
        check=False,timeout=120)
    try:alias_evidence=json.loads(alias_result.stdout)
    except ValueError:alias_evidence={}
    expected_identity=alias_evidence.get("root_identity")
    check(alias_result.returncode==0 and alias_result.stderr==""
          and isinstance(expected_identity,list) and len(expected_identity)==2
          and alias_evidence.get("alias_identities")==[expected_identity,expected_identity]
          and alias_evidence.get("sentinel_calls")==[]
          and alias_evidence.get("rejections")==[
              "owner artifact overlaps authenticated source physical authority",
              "owner artifact overlaps authenticated source physical authority"]
          and alias_evidence.get("artifact_leaves_absent") is True
          and alias_evidence.get("source_unchanged") is True,
          "J_R17_OWNER_ARTIFACT_PHYSICAL_ALIAS_PRE_EFFECT_REJECT_NO_RESIDUE",
          alias_result.stderr or alias_result.stdout)


def r15_import_token(node: ast.Import | ast.ImportFrom, item: ast.alias) -> str:
    suffix = ":" + item.asname if item.asname else ""
    if isinstance(node, ast.Import):
        return "I:" + item.name + suffix
    return f"F:{node.level}:{node.module or ''}:{item.name}{suffix}"


def r15_subtracted_multiset(candidate: list[str], baseline: list[str]) -> tuple[str, ...] | None:
    remaining: dict[str, int] = {}
    for item in candidate: remaining[item] = remaining.get(item, 0) + 1
    for item in baseline:
        if remaining.get(item, 0) < 1: return None
        remaining[item] -= 1
    return tuple(sorted(item for item, count in remaining.items() for _ in range(count)))


class R15DefinitionSurface(ast.NodeTransformer):
    """Hash everything executed while a module defines itself, not function bodies."""
    def visit_FunctionDef(self, node: ast.FunctionDef) -> ast.AST:
        node.decorator_list = [self.visit(value) for value in node.decorator_list]
        node.args = self.visit(node.args)
        node.returns = self.visit(node.returns) if node.returns is not None else None
        node.body = [ast.Pass()]
        return node

    def visit_AsyncFunctionDef(self, node: ast.AsyncFunctionDef) -> ast.AST:
        return self.visit_FunctionDef(node)  # type: ignore[arg-type]

    def visit_Lambda(self, node: ast.Lambda) -> ast.AST:
        node.args = self.visit(node.args)
        node.body = ast.Constant(None)
        return node


def r15_binding_names(node: ast.stmt) -> tuple[str, ...]:
    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
        return (node.name,)
    if isinstance(node, ast.Import):
        return tuple(item.asname or item.name.split(".", 1)[0] for item in node.names)
    if isinstance(node, ast.ImportFrom):
        return tuple(item.asname or item.name for item in node.names)
    targets: list[ast.AST] = []
    if isinstance(node, ast.Assign): targets.extend(node.targets)
    elif isinstance(node, ast.AnnAssign): targets.append(node.target)
    elif isinstance(node, ast.AugAssign): targets.append(node.target)
    else: return ()
    return tuple(value.id for target in targets for value in ast.walk(target)
                 if isinstance(value, ast.Name) and isinstance(value.ctx, ast.Store))


def r15_call_name(call: ast.Call) -> str:
    def expression(value: ast.AST) -> str:
        if isinstance(value, ast.Name): return value.id
        if isinstance(value, ast.Attribute): return expression(value.value) + "." + value.attr
        if isinstance(value, ast.Call): return expression(value.func) + "()"
        if isinstance(value, ast.Subscript): return expression(value.value) + "[]"
        return type(value).__name__
    return expression(call.func)


def r15_source_capability_signature(path: str, baseline_raw: bytes,
                                    candidate_raw: bytes,
                                    manifest: dict[str, object]) -> tuple[dict[str, object] | None, str]:
    interpreter_ok,interpreter_why=r15_ast_interpreter_validate(
        H035_R15_AST_PYTHON,H035_R15_AST_PYTHON_SHA256,
        H035_R15_AST_PYTHON_VERSION,sys.executable,tuple(sys.version_info[:3]))
    if not interpreter_ok:
        return None, interpreter_why
    try:
        baseline_text = baseline_raw.decode("utf-8", errors="strict")
        candidate_text = candidate_raw.decode("utf-8", errors="strict")
        if "\x00" in baseline_text or "\x00" in candidate_text:
            return None, "source contains NUL"
        baseline = ast.parse(baseline_text, filename=path, mode="exec")
        candidate = ast.parse(candidate_text, filename=path, mode="exec")
    except (UnicodeDecodeError, SyntaxError, ValueError, TypeError) as exc:
        return None, "strict UTF-8 AST parse: " + str(exc)

    expected_blob = manifest.get("blob_sha256")
    expected_defs = manifest.get("ordered_top_level_ast_sha256")
    bindings = manifest.get("bindings")
    base_defs = [node for node in baseline.body
                 if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))]
    base_hashes = [r15_ast_sha256(node) for node in base_defs]
    if (hashlib.sha256(baseline_raw).hexdigest() != expected_blob
            or base_hashes != expected_defs or not isinstance(bindings, dict)
            or bindings.get("top_level_def_or_class_count") != len(base_defs)):
        return None, "baseline Git blob/ordered AST authority"

    candidate_defs = [node for node in candidate.body
                      if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))]
    candidate_hashes = [r15_ast_sha256(node) for node in candidate_defs]
    matched: list[ast.AST] = []
    positions: list[int] = []
    for base_node, digest in zip(base_defs, base_hashes):
        hits = [index for index, node in enumerate(candidate_defs)
                if node.name == base_node.name and candidate_hashes[index] == digest]
        if len(hits) != 1: return None, "base definition missing/duplicate/substituted"
        positions.append(hits[0]); matched.append(candidate_defs[hits[0]])
    if positions != sorted(positions): return None, "base definition order"

    top_bindings = [name for node in candidate.body for name in r15_binding_names(node)]
    for node in base_defs:
        wanted = 2 if node.name == "main" else 1
        if top_bindings.count(node.name) != wanted:
            return None, "base definition binding cardinality: " + node.name
    captures = [index for index, node in enumerate(candidate.body)
                if isinstance(node, ast.Assign) and len(node.targets) == 1
                and isinstance(node.targets[0], ast.Name)
                and node.targets[0].id == "_r15_legacy_main"
                and isinstance(node.value, ast.Name) and node.value.id == "main"]
    old_main = next((index for index, node in enumerate(candidate.body)
                     if node is matched[-1]), -1)
    dispatch = [index for index, node in enumerate(candidate.body)
                if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
                and node.name == "main" and node is not matched[-1]]
    if (captures.__len__() != 1 or dispatch.__len__() != 1
            or not old_main < captures[0] < dispatch[0]
            or top_bindings.count("_r15_legacy_main") != 1):
        return None, "base-main capture/dispatch pattern"

    legacy_ids = {id(value) for root in matched for value in ast.walk(root)}
    parents = {id(child): parent for parent in ast.walk(candidate)
               for child in ast.iter_child_nodes(parent)}
    imports: list[str] = []
    baseline_imports: list[str] = []
    for tree, output in ((candidate, imports), (baseline, baseline_imports)):
        tree_parents = {id(child): parent for parent in ast.walk(tree)
                        for child in ast.iter_child_nodes(parent)}
        for node in ast.walk(tree):
            if isinstance(node, (ast.Import, ast.ImportFrom)):
                if not isinstance(tree_parents.get(id(node)), ast.Module):
                    return None, "nested or conditional import"
                output.extend(r15_import_token(node, item) for item in node.names)
    new_imports = r15_subtracted_multiset(imports, baseline_imports)
    if new_imports is None: return None, "base import substitution"

    imported_modules = {item.asname or item.name.split(".",1)[0]
                        for node in candidate.body if isinstance(node,ast.Import)
                        for item in node.names
                        if item.name in {"os","subprocess","ctypes","sqlite3","fcntl","pwd",
                                         "sys","socket","runpy","importlib","shutil"}}
    sensitive_attributes = {
        "run","Popen","call","check_call","check_output","system","posix_spawn",
        "fork","forkpty","CDLL","PyDLL","syscall","socket","create_connection",
        "unlink","remove","rmdir","removedirs","rename","replace","renames","rmtree",
        "run_path","run_module","import_module","modules"}
    def transferred(value: ast.AST) -> bool:
        if isinstance(value,ast.Name): return value.id in imported_modules
        if isinstance(value,ast.Attribute):
            root=value
            while isinstance(root,ast.Attribute): root=root.value
            return (isinstance(root,ast.Name) and root.id in imported_modules
                    and value.attr in sensitive_attributes)
        if isinstance(value,(ast.List,ast.Tuple,ast.Set)):
            return any(transferred(item) for item in value.elts)
        if isinstance(value,ast.Dict):
            return any(transferred(item) for item in (*value.keys,*value.values)
                       if item is not None)
        return False
    for node in ast.walk(candidate):
        if id(node) in legacy_ids: continue
        if isinstance(node,(ast.Assign,ast.AnnAssign,ast.NamedExpr)):
            value=node.value
            exact_rename_lookup=(isinstance(value,ast.Call)
                and isinstance(value.func,ast.Name) and value.func.id=="getattr"
                and len(value.args)==3 and isinstance(value.args[0],ast.Call)
                and r15_call_name(value.args[0])=="ctypes.CDLL"
                and isinstance(value.args[1],ast.Constant)
                and value.args[1].value=="renameatx_np")
            if transferred(value) and not exact_rename_lookup:
                return None,"unknown capability alias/container transfer"
        if isinstance(node,ast.Return) and node.value is not None and transferred(node.value):
            return None,"unknown capability return transfer"

    forbidden_names = {
        "__builtins__","__import__","breakpoint","eval","globals","locals","vars",
        "setattr","delattr","gettrace","settrace","getprofile","setprofile"}
    forbidden_attributes = {
        "gettrace","settrace","getprofile","setprofile","monitoring","_getframe",
        "currentframe","f_trace","f_trace_lines","f_trace_opcodes","f_back",
        "f_builtins","f_globals","f_locals","gi_frame","cr_frame","ag_frame",
        "modules","load_module","exec_module","module_from_spec","find_spec",
        "__dict__","__mro__","__subclasses__"}
    for node in ast.walk(candidate):
        if id(node) in legacy_ids: continue
        if isinstance(node, (ast.Global, ast.Nonlocal)):
            return None, "global/nonlocal capability rebinding"
        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load) \
                and node.id in forbidden_names:
            return None, "reflection/observer recovery name: " + node.id
        if isinstance(node, ast.Attribute) and node.attr in forbidden_attributes:
            return None, "reflection/observer recovery attribute: " + node.attr
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) \
                and node.func.id == "getattr":
            flag = (len(node.args) == 3 and isinstance(node.args[0], ast.Name)
                    and node.args[0].id in {"os","_r15_os"}
                    and isinstance(node.args[1], ast.Constant)
                    and node.args[1].value in {"O_CLOEXEC","O_DIRECTORY","O_NOFOLLOW","O_NONBLOCK"}
                    and isinstance(node.args[2], ast.Constant) and node.args[2].value == 0)
            rename = (len(node.args) == 3 and isinstance(node.args[0], ast.Call)
                      and r15_call_name(node.args[0]) == "ctypes.CDLL"
                      and isinstance(node.args[1], ast.Constant)
                      and node.args[1].value == "renameatx_np"
                      and isinstance(node.args[2], ast.Constant)
                      and node.args[2].value is None)
            if not (flag or rename): return None, "dynamic getattr/proxy"

    stripped = ast.parse(candidate_text, filename=path, mode="exec")
    R15DefinitionSurface().visit(stripped); ast.fix_missing_locations(stripped)
    call_rows: list[tuple[str, str, str]] = []
    functions: list[ast.AST] = [candidate]
    functions.extend(node for node in ast.walk(candidate)
                     if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)))
    function_names = {id(candidate):"<module>"}
    serial: dict[str, int] = {}
    for node in functions[1:]:
        name = node.name if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) else "<lambda>"
        serial[name] = serial.get(name, 0) + 1
        function_names[id(node)] = f"{name}#{serial[name]}"
    def owner(node: ast.AST) -> str:
        cursor: ast.AST | None = node
        while cursor is not None:
            if id(cursor) in function_names: return function_names[id(cursor)]
            cursor = parents.get(id(cursor))
        return "<module>"
    new_calls = [node for node in ast.walk(candidate)
                 if isinstance(node, ast.Call) and id(node) not in legacy_ids]
    for node in new_calls:
        call_rows.append((owner(node), r15_call_name(node), r15_ast_sha256(node)))

    def count(name: str) -> int:
        return sum(r15_call_name(node) == name for node in new_calls)
    pathname_delete = {"unlink","remove","rmdir","removedirs","rename","renames","rmtree","move"}
    process_names = {"subprocess.Popen","subprocess.call","subprocess.check_call",
                     "subprocess.check_output","os.system","os.posix_spawn","os.fork","os.forkpty"}
    network_names = {"socket.socket","socket.create_connection","socket.socketpair"}
    forbidden_process = [node for node in new_calls
                         if r15_call_name(node) in process_names
                         or r15_call_name(node).startswith(("os.spawn","os.exec"))]
    forbidden_network = [node for node in new_calls
                         if r15_call_name(node) in network_names
                         or r15_call_name(node).startswith("socket.")
                         or "socket()." in r15_call_name(node)
                         or (isinstance(node.func, ast.Attribute)
                             and node.func.attr in {"send","sendall","sendto","bind","listen","accept"})]
    forbidden_ffi = [node for node in new_calls
                     if (r15_call_name(node).startswith("ctypes.")
                         and r15_call_name(node) not in {"ctypes.CDLL","ctypes.get_errno"})
                     or r15_call_name(node).startswith(("cffi.","_ctypes."))]
    forbidden_dynamic = [node for node in new_calls
                         if r15_call_name(node).startswith(("runpy.","importlib."))
                         or r15_call_name(node) in {"__import__","eval"}]
    forbidden_delete = [node for node in new_calls
                        if ((isinstance(node.func, ast.Attribute)
                             and node.func.attr in pathname_delete - {"rename"})
                            or r15_call_name(node) in {"os.rename","os.replace","Path.rename","Path.replace"})]
    reviewed_cleanup_calls={
        ("known_open#1","os.rmdir(dname, dir_fd=tfd)"),
        ("known_open#1","os.unlink('known_hosts', dir_fd=dfd)"),
        ("known_close#1","os.rmdir(h['dname'], dir_fd=h['tfd'])"),
        ("known_close#1","os.unlink(h['cname'], dir_fd=h['dfd'])"),
    } if path=="controller/attest/cli" else set()
    unexpected_delete=[node for node in forbidden_delete
                       if (owner(node),ast.unparse(node)) not in reviewed_cleanup_calls]
    def definition_time(node: ast.AST) -> bool:
        cursor=node
        while (parent:=parents.get(id(cursor))) is not None:
            if isinstance(parent,(ast.FunctionDef,ast.AsyncFunctionDef)):
                return not any(cursor is statement or any(value is cursor for value in ast.walk(statement))
                               for statement in parent.body)
            if isinstance(parent,ast.Lambda): return cursor is not parent.body
            cursor=parent
        return True
    dangerous_definition_calls=(forbidden_process+forbidden_network+forbidden_ffi
                                +unexpected_delete+forbidden_dynamic)
    if any(definition_time(node) for node in dangerous_definition_calls):
        return None,"definition-time capability effect"
    if forbidden_process: return None,"alternate process capability"
    if forbidden_network: return None,"direct socket/network capability"
    if forbidden_ffi: return None,"alternate FFI/native capability"
    if unexpected_delete: return None,"new pathname delete/rename capability"
    if forbidden_dynamic: return None,"dynamic import/eval capability"

    rename_calls = [node for node in new_calls if r15_call_name(node) == "renameat"]
    swap = sum(any(isinstance(value, ast.Name) and value.id == "RENAME_SWAP"
                   for value in ast.walk(node)) for node in rename_calls)
    excl = sum(any(isinstance(value, ast.Name) and value.id == "RENAME_EXCL"
                   for value in ast.walk(node)) for node in rename_calls)
    memory = [node for node in new_calls if r15_call_name(node) == "sqlite3.connect"
              and len(node.args) == 1 and isinstance(node.args[0], ast.Constant)
              and node.args[0].value == ":memory:"]
    cdll = [node for node in new_calls if r15_call_name(node) == "ctypes.CDLL"
            and len(node.args) == 1 and isinstance(node.args[0], ast.Constant)
            and node.args[0].value is None and len(node.keywords) == 1
            and node.keywords[0].arg == "use_errno"
            and isinstance(node.keywords[0].value, ast.Constant)
            and node.keywords[0].value.value is True]
    finalizers = [node.value.value for node in candidate.body if isinstance(node, ast.Assign)
                  and any(isinstance(target, ast.Name) and target.id == "FINALIZER_FD_LOADER"
                          for target in node.targets)
                  and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str)]
    finalizer_sha: str | None = None
    finalizer_pairs = 0
    if finalizers:
        if len(finalizers) != 1: return None, "finalizer loader cardinality"
        try: finalizer_tree = ast.parse(finalizers[0], filename="<r15-finalizer-loader>")
        except (SyntaxError, ValueError, TypeError): return None, "finalizer loader AST"
        finalizer_sha = hashlib.sha256(finalizers[0].encode("utf-8")).hexdigest()
        finalizer_exec = sum(isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
                             and node.func.id == "exec" for node in ast.walk(finalizer_tree))
        finalizer_compile = sum(isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
                                and node.func.id == "compile" for node in ast.walk(finalizer_tree))
        finalizer_pairs = 1 if finalizer_exec == finalizer_compile == 1 else -1
        if any(isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load)
               and node.id in forbidden_names for node in ast.walk(finalizer_tree)):
            return None, "finalizer reflection/dynamic recovery"

    wrapper_exec = count("exec"); wrapper_compile = count("compile")
    sinks = {
        "attest_subprocess_run":count("subprocess.run"),
        "attest_git":count("git"),"attest_gitb":count("gitb"),
        "attest_g":count("g"),"attest_blob":count("blob"),
        "attest_config_origin":count("config_origin"),
        "attest_remote_main":count("remote_main"),
        "sqlite_memory_connect":len(memory),
        "ctypes_cdll_none_use_errno_true":len(cdll),
        "ctypes_get_errno":count("ctypes.get_errno"),
        "renameatx_np_same_root":len(rename_calls),
        "renameatx_np_swap":swap,"renameatx_np_excl":excl,
        "wrapper_compile_exec_pairs":wrapper_exec if wrapper_exec == wrapper_compile else -1,
        "finalizer_compile_exec_pairs":finalizer_pairs,
        "new_path_delete_or_rename":len(forbidden_delete),
        "direct_socket_or_network":len(forbidden_network),
    }
    return {
        "normalized_ast_sha256":r15_ast_sha256(candidate),
        "definition_surface_sha256":r15_ast_sha256(stripped),
        "new_semantic_import_multiset":new_imports,
        "new_sink_multiset":sinks,
        "critical_call_graph_sha256":hashlib.sha256(json.dumps(
            sorted(call_rows), separators=(",",":"), ensure_ascii=False).encode("utf-8")).hexdigest(),
        "finalizer_loader_sha256":finalizer_sha,
    }, "exact source capability signature"


def r15_source_capability_scope(repo: Path, base: str, candidate_sha: str,
                                reference_sources: tuple[str, str, str]) -> tuple[bool, str]:
    try:
        raw_spec = r15_git_object_bytes(repo, base, "specs/tasks.spec.json")
        spec = strict_json_bytes(raw_spec or b"")
        rows = [row for row in spec.get("tasks", [])
                if isinstance(row, dict) and row.get("id") == "h-035"]
        contract = rows[0].get("r15_owner_product_lifecycle") if len(rows) == 1 else None
        envelope = (contract.get("product_acceptance", {}).get("source_capability_envelope")
                    if isinstance(contract, dict) else None)
        if not exact_value(envelope, H035_R15_SOURCE_CAPABILITY_ENVELOPE):
            return False, "frozen source capability envelope mismatch"
        paths = H035_R15_SOURCE_CAPABILITY_ENVELOPE["baseline"]["paths"]
        expected_imports = H035_R15_SOURCE_CAPABILITY_ENVELOPE["reference"]["new_semantic_import_multiset"]
        expected_sinks = H035_R15_SOURCE_CAPABILITY_ENVELOPE["reference"]["new_sink_multiset"]
        expected_loader = H035_R15_SOURCE_CAPABILITY_ENVELOPE["reference"]["finalizer_loader_sha256"]
        aggregate_sinks = {key:0 for key in expected_sinks}
        observed_loader = None
        for relative, reference_text in zip(H035_R15_PRODUCT_PATHS, reference_sources):
            baseline_raw = r15_git_object_bytes(repo, H035_R15_BASE, relative)
            candidate_raw = r15_git_object_bytes(repo, candidate_sha, relative)
            if baseline_raw is None or candidate_raw is None:
                return False, "source capability Git blob missing"
            reference, why = r15_source_capability_signature(
                relative, baseline_raw, reference_text.encode("utf-8"), paths[relative])
            if reference is None: return False, "trusted reference " + relative + ": " + why
            actual, why = r15_source_capability_signature(
                relative, baseline_raw, candidate_raw, paths[relative])
            if actual is None: return False, "candidate " + relative + ": " + why
            if actual != reference:
                return False, "candidate capability signature differs: " + relative
            if tuple(reference["new_semantic_import_multiset"]) != tuple(sorted(expected_imports[relative])):
                return False, "trusted reference import inventory: " + relative
            for key in aggregate_sinks:
                aggregate_sinks[key] += reference["new_sink_multiset"][key]
            if reference["finalizer_loader_sha256"] is not None:
                if observed_loader is not None: return False, "multiple finalizer loaders"
                observed_loader = reference["finalizer_loader_sha256"]
        if aggregate_sinks != expected_sinks:
            return False, "trusted reference aggregate sink inventory"
        if observed_loader != expected_loader:
            return False, "trusted finalizer loader digest"
    except (KeyError, AttributeError, TypeError, ValueError, UnicodeError) as exc:
        return False, "source capability envelope invalid: " + str(exc)
    return True, "exact Git-object-derived line-insensitive source capability envelope"


def r15_source_capability_selftests() -> None:
    interpreter_ok,interpreter_why=r15_ast_interpreter_validate(
        H035_R15_AST_PYTHON,H035_R15_AST_PYTHON_SHA256,
        H035_R15_AST_PYTHON_VERSION,sys.executable,tuple(sys.version_info[:3]))
    interpreter_mutants=(
        r15_ast_interpreter_validate(
            H035_R15_AST_PYTHON,H035_R15_AST_PYTHON_SHA256,(3,9,6),
            sys.executable,tuple(sys.version_info[:3])),
        r15_ast_interpreter_validate(
            H035_R15_AST_PYTHON,"0"*64,H035_R15_AST_PYTHON_VERSION,
            sys.executable,tuple(sys.version_info[:3])),
        r15_ast_interpreter_validate(
            H035_R15_AST_PYTHON,H035_R15_AST_PYTHON_SHA256,
            H035_R15_AST_PYTHON_VERSION,"/usr/bin/python3",tuple(sys.version_info[:3])),
    )
    check(interpreter_ok and all(not result[0] for result in interpreter_mutants),
          "J_R15_SOURCE_CAPABILITY_EXACT_PYTHON_3_12_13_PATH_VERSION_DIGEST",
          interpreter_why + " / " + repr(interpreter_mutants))
    sources = r15_reference_sources(ROOT, H035_R15_BASE)
    paths = H035_R15_SOURCE_CAPABILITY_ENVELOPE["baseline"]["paths"]
    signatures: list[dict[str, object]] = []
    reasons=[]
    for relative, source in zip(H035_R15_PRODUCT_PATHS, sources):
        baseline = r15_git_object_bytes(ROOT, H035_R15_BASE, relative)
        signature, why = r15_source_capability_signature(
            relative, baseline or b"", source.encode("utf-8"), paths[relative])
        reasons.append(why)
        if signature is not None: signatures.append(signature)
    expected_imports=H035_R15_SOURCE_CAPABILITY_ENVELOPE["reference"]["new_semantic_import_multiset"]
    expected_sinks=H035_R15_SOURCE_CAPABILITY_ENVELOPE["reference"]["new_sink_multiset"]
    aggregate={key:sum(signature["new_sink_multiset"][key] for signature in signatures)
               for key in expected_sinks} if len(signatures)==3 else {}
    attest_tree=ast.parse(sources[0]);attest_defs={node.name:node for node in attest_tree.body
        if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef))}
    mutation_node=attest_defs.get("mutation_preflight");recovery_node=attest_defs.get("recovery_rows")
    mutation_owners=sorted(node.name for node in attest_tree.body
        if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef)) and any(
            isinstance(call,ast.Call) and isinstance(call.func,ast.Name)
            and call.func.id=="mutation_preflight" for call in ast.walk(node)))
    mutation_rows=[call for call in ast.walk(mutation_node) if isinstance(call,ast.Call)
        and isinstance(call.func,ast.Name) and call.func.id=="recovery_rows"] if mutation_node else []
    mutation_mutators=[call for call in ast.walk(mutation_node) if isinstance(call,ast.Call)
        and ((isinstance(call.func,ast.Attribute) and call.func.attr in ("ftruncate","fsync","write","replace","rename"))
             or isinstance(call.func,ast.Name) and call.func.id in ("fdwrite","fdappend","renameat"))] if mutation_node else []
    recovery_truncators=[node.name for node in attest_tree.body
        if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef)) for call in ast.walk(node)
        if isinstance(call,ast.Call) and isinstance(call.func,ast.Attribute)
        and isinstance(call.func.value,ast.Name) and call.func.value.id=="os"
        and call.func.attr=="ftruncate" and call.args and isinstance(call.args[0],ast.Name)
        and call.args[0].id=="recovery"]
    strict_tail=ast.parse("if raw and not raw.endswith(b'\\n'):raise Stop('INDETERMINATE incomplete recovery tail')").body[0]
    reference_recovery_contract=(mutation_owners==["finalize","record_publication"]
        and len(mutation_rows)==1 and ast.unparse(mutation_rows[0].args[0])=="complete"
        and not mutation_mutators and recovery_truncators==["atomic"]
        and recovery_node is not None and recovery_node.body
        and ast.dump(recovery_node.body[0],include_attributes=False)
            == ast.dump(strict_tail,include_attributes=False))
    check(len(signatures)==3 and aggregate==expected_sinks
          and all(tuple(signature["new_semantic_import_multiset"])
                  == tuple(sorted(expected_imports[relative]))
                  for relative,signature in zip(H035_R15_PRODUCT_PATHS,signatures))
          and signatures[0]["finalizer_loader_sha256"]
              == H035_R15_SOURCE_CAPABILITY_ENVELOPE["reference"]["finalizer_loader_sha256"]
          and reference_recovery_contract,
          "J_R15_SOURCE_CAPABILITY_TRUSTED_REFERENCE_EXACT_SIGNATURE",
          repr((reasons,mutation_owners,recovery_truncators,len(mutation_mutators))))
    if len(signatures)!=3: return

    def analyzed(index: int, mutated: str) -> tuple[dict[str,object] | None,str]:
        relative=H035_R15_PRODUCT_PATHS[index]
        baseline=r15_git_object_bytes(ROOT,H035_R15_BASE,relative)
        return r15_source_capability_signature(
            relative,baseline or b"",mutated.encode("utf-8"),paths[relative])

    def rejected(index: int, mutated: str) -> bool:
        value,_why=analyzed(index,mutated)
        return value is None or value!=signatures[index]

    def semantic_rejected(index: int, mutated: str, reason: str | None = None) -> bool:
        value,why=analyzed(index,mutated)
        if value is None: return reason is None or reason in why
        if reason is not None:return False
        expected=dict(signatures[index]);actual=dict(value)
        expected.pop("normalized_ast_sha256",None);actual.pop("normalized_ast_sha256",None)
        return actual!=expected

    dead_composite = sources[1] + r'''
import socket,runpy
def _r15_dead_composite_escape():
 subprocess.run(['/usr/bin/true']);os.posix_spawn('/usr/bin/true',['/usr/bin/true'],{})
 socket.socket().connect('/tmp/escape');__import__('ctypes').CDLL(None).system(b'/usr/bin/true')
 runpy.run_path('/tmp/escape');sys.modules['escape']=object();Path('/tmp/escape').unlink();os.rename('/tmp/a','/tmp/b')
'''
    proxy = sources[1] + r'''
def _r15_dead_proxy_escape():
 module=subprocess;runner=module.run;box=[runner]
 return box[0](['/usr/bin/true'])
'''
    definition = sources[1] + r'''
def _r15_definition_escape(value=subprocess.run(['/usr/bin/true'])):return value
_r15_lambda_escape=lambda value=os.system('/usr/bin/true'):value
_r15_comprehension_escape=[subprocess.run(['/usr/bin/true']) for _ in ()]
'''
    trace = sources[1].replace(
        "runtime=_r15_runtime()",
        "prior=sys.gettrace();sys.settrace(None);older=_r15_runtime();sys.settrace(prior);runtime=_r15_runtime()",1)
    profile = sources[1].replace(
        "runtime=_r15_runtime()",
        "prior=sys.getprofile();sys.setprofile(None);older=_r15_runtime();sys.setprofile(prior);runtime=_r15_runtime()",1)
    frame = sources[1] + r'''
def _r15_frame_recovery_escape():
 frame=sys._getframe();frame.f_trace=None
 return frame.f_globals['__builtins__']
'''
    alternate = (
        sources[1]+"\ndef _r15_process_escape():return subprocess.Popen(['/usr/bin/true'])\n",
        sources[1]+"\nimport socket\ndef _r15_network_escape():return socket.socket().send(b'x')\n",
        sources[1]+"\nimport ctypes\ndef _r15_ffi_escape():return ctypes.CDLL(None).system(b'/usr/bin/true')\n",
        sources[1]+"\ndef _r15_delete_escape():return os.unlink('/tmp/x')\n",
        sources[1]+"\nimport runpy\ndef _r15_dynamic_escape():return runpy.run_path('/tmp/x')\n",
    )
    check(semantic_rejected(1,dead_composite,"reflection/observer recovery"),
          "J_R15_SOURCE_CAPABILITY_DEAD_COMPOSITE_PROCESS_NETWORK_FFI_DYNAMIC_DELETE_REJECT")
    check(semantic_rejected(1,proxy,"unknown capability alias/container transfer"),
          "J_R15_SOURCE_CAPABILITY_ALIAS_RETURN_CONTAINER_PROXY_REJECT")
    check(semantic_rejected(1,definition,"definition-time capability effect"),
          "J_R15_SOURCE_CAPABILITY_DECORATOR_DEFAULT_LAMBDA_COMPREHENSION_EFFECT_REJECT")
    check(all(semantic_rejected(1,value,"reflection/observer recovery")
              for value in (trace,profile,frame)),
          "J_R15_SOURCE_CAPABILITY_TRACE_PROFILE_FRAME_DISABLE_RECOVERY_REJECT")
    check(all(semantic_rejected(1,value,reason) for value,reason in zip(alternate,(
              "alternate process capability","direct socket/network capability",
              "alternate FFI/native capability","new pathname delete/rename capability",
              "dynamic import/eval capability"))),
          "J_R15_SOURCE_CAPABILITY_ALTERNATE_PROCESS_NETWORK_FFI_DELETE_DYNAMIC_SINK_REJECT")
    cleanup_mutants=(
        sources[0].replace('os.unlink("known_hosts",dir_fd=dfd)',
                           'os.unlink("/tmp/known_hosts")',1),
        sources[0].replace('os.unlink("known_hosts",dir_fd=dfd)',
                           'os.unlink("known_hosts",dir_fd=tfd)',1),
        sources[0].replace('os.rmdir(h["dname"],dir_fd=h["tfd"])',
                           'os.rmdir(h["dname"],dir_fd=h["dfd"])',1),
        sources[0]+'\ndef _r15_extra_cleanup():return os.unlink("known_hosts",dir_fd=dfd)\n',
    )
    check(all(value!=sources[0] for value in cleanup_mutants[:3])
          and all(semantic_rejected(0,value,"new pathname delete/rename capability")
                  for value in cleanup_mutants[:3])
          and semantic_rejected(0,cleanup_mutants[3]),
          "J_R19_EXACT_DESCRIPTOR_RELATIVE_CLEANUP_WRONG_PATH_DIRFD_AND_DUPLICATE_REJECT")

    duplicate = sources[0] + "\ndef fel(text):return 0\n"
    capture = sources[0].replace("_r15_legacy_main = main","_r15_legacy_main = lambda argv: main(argv)",1)
    nested_import = sources[1]+"\ndef _r15_nested_import():\n import socket\n return socket\n"
    check(semantic_rejected(0,duplicate,"base definition binding cardinality")
          and semantic_rejected(0,capture,"base-main capture/dispatch pattern"),
          "J_R15_SOURCE_CAPABILITY_BASE_DEF_DUPLICATE_AND_MAIN_CAPTURE_REJECT")
    check(semantic_rejected(1,nested_import,"nested or conditional import"),
          "J_R15_SOURCE_CAPABILITY_NESTED_IMPORT_REJECT")
    sink_argv=sources[0].replace("pass_fds=(finalizer_fd,),close_fds=True",
                                 "pass_fds=(finalizer_fd,),close_fds=False",1)
    loader=sources[0].replace("dont_inherit=True,optimize=0",
                              "dont_inherit=False,optimize=0",1)
    check(sink_argv!=sources[0] and loader!=sources[0]
          and semantic_rejected(0,sink_argv) and semantic_rejected(0,loader),
          "J_R15_SOURCE_CAPABILITY_PROCESS_AND_DYNAMIC_SIGNATURE_PERTURBATION_REJECT")
    check(all(not rejected(index,source+"\n# line-insensitive capability comment\n")
              for index,source in enumerate(sources)),
          "J_R15_SOURCE_CAPABILITY_COMMENT_AND_LINE_NUMBER_INSENSITIVE_POSITIVE")
    status_forges=(
        sources[1]+"\ndef _r15_status_forge():return sys._getframe().f_back.f_globals\n",
        sources[1]+"\ndef _r15_status_forge():return authority_value.__globals__\n",
        sources[1]+"\ndef _r15_status_forge():return _r15_runtime.__closure__[0].cell_contents\n",
        sources[1]+"\ndef _r15_status_forge():return authority_value.__getattribute__('__globals__')\n",
        sources[1]+"\ndef _r15_status_forge():return sys._current_frames()\n",
        sources[1]+"\ndef _r15_status_forge(exc):return exc.__traceback__.tb_frame.f_globals,exc.__traceback__.tb_next\n",
        sources[1]+"\nimport gc\ndef _r15_status_forge():return gc.get_objects()\n",
        sources[1]+"\nimport inspect\ndef _r15_status_forge():return inspect.currentframe()\n",
        sources[1]+"\nimport hmac\ndef _r15_status_forge():return hmac.new(b'x',b'y','sha256')\n",
        sources[1]+"\ndef _r15_status_forge():return os.environ.get('R15_STATUS_FD')\n",
        sources[1]+"\ndef _r15_status_forge():return os.write(3,b'forged')\n",
        sources[1]+"\ndef _r15_status_forge():return os.close(3)\n",
        sources[1]+"\ndef _r15_status_forge():return [os.read(fd,1) for fd in range(3,256)]\n",
        sources[1]+"\ndef _r15_status_forge():sys.settrace(None);sys.setprofile(None)\n",
    )
    check(all(rejected(1,mutant) for mutant in status_forges),
          "J_R15_FAULT_STATUS_FRAME_GLOBALS_CLOSURE_GC_HMAC_ENV_FD_TRACE_FORGES_REJECT_PRE_MATRIX")
    route_rows=[{"domain":"export","name":"authority_value","code_sha256":"1"*64}]
    route_result=subprocess.CompletedProcess([],1,
        '{"accepted":false,"reason":"closed route rejection"}',"")
    route_result.r15_judge_status=[{"branch":"route_fixture","events":[
        {"primitive":"changed_stat","identity":[11,12]},
        {"primitive":"route_call","identity":route_rows[0]}]}]
    route_error=subprocess.CompletedProcess([],1,"","closed route rejection\n")
    route_error.r15_judge_status=list(route_result.r15_judge_status)
    route_mutants=[]
    for events in (
        list(reversed(route_result.r15_judge_status[0]["events"])),
        route_result.r15_judge_status[0]["events"][:-1],
        route_result.r15_judge_status[0]["events"]+[dict(route_result.r15_judge_status[0]["events"][-1])],
        [{"primitive":"changed_stat","identity":[11,13]},
         {"primitive":"route_call","identity":route_rows[0]}],
        [{"primitive":"changed_stat","identity":[11,12]},
         {"primitive":"route_call","identity":{**route_rows[0],"name":"legacy_main"}}],
    ):
        mutant=subprocess.CompletedProcess([],1,route_result.stdout,"")
        mutant.r15_judge_status=[{"branch":"route_fixture","events":events}]
        route_mutants.append(mutant)
    check(r15_fault_answer(route_result,None)
          and r15_fault_error(route_error,None)
          and r15_fault_event_exact(route_result,"route_fixture","changed_stat",[11,12],route_rows)
          and all(not r15_fault_event_exact(mutant,"route_fixture","changed_stat",[11,12],route_rows)
                  for mutant in route_mutants),
          "J_R15_ROUTE_AUDIT_EXACT_ORDER_IDENTITY_CARDINALITY_AND_CLOSED_ENVELOPE")
    def store_count(node: ast.AST | None, name: str) -> int:
        return (sum(1 for item in ast.walk(node)
                    if isinstance(item,ast.Name) and isinstance(item.ctx,ast.Store)
                    and item.id==name) if node is not None else -1)
    main_node=next((node for node in ast.parse(Path(__file__).read_text(encoding="utf-8")).body
                    if isinstance(node,ast.FunctionDef) and node.name=="main"),None)
    gate_nodes=ast.parse(Path(__file__).read_text(encoding="utf-8")).body
    identity_node=next((node for node in gate_nodes if isinstance(node,ast.FunctionDef)
                        and node.name=="r15_product_identity"),None)
    identity_source=ast.unparse(identity_node) if identity_node is not None else ""
    identity_reference_assign="reference_sources = r15_reference_sources(ROOT, base)"
    identity_scope_assign="ok, why = r15_product_diff_scope(ROOT, base, candidate_sha, reference_sources)"
    identity_reference_nodes=[node for node in ast.walk(identity_node)
                              if isinstance(node,ast.Assign)
                              and ast.unparse(node)==identity_reference_assign] if identity_node else []
    identity_scope_nodes=[node for node in ast.walk(identity_node)
                          if isinstance(node,ast.Assign)
                          and ast.unparse(node)==identity_scope_assign] if identity_node else []
    identity_reference_calls=[node for node in ast.walk(identity_node)
                              if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
                              and node.func.id=="r15_reference_sources"] if identity_node else []
    identity_scope_calls=[node for node in ast.walk(identity_node)
                          if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
                          and node.func.id=="r15_product_diff_scope"] if identity_node else []
    identity_fail_index=(identity_node.body.index(identity_scope_nodes[0])+1
                         if identity_node and len(identity_scope_nodes)==1
                         and identity_scope_nodes[0] in identity_node.body else -1)
    identity_fail_node=(identity_node.body[identity_fail_index]
                        if identity_node and 0<=identity_fail_index<len(identity_node.body) else None)
    main_calls=[node.func.id for node in ast.walk(main_node)
                if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)] if main_node else []
    inheritance_control_calls=[node for node in ast.walk(main_node)
                               if isinstance(node,ast.Call)
                               and isinstance(node.func,ast.Name)
                               and node.func.id=="r15_gate_inheritance_git_controls"
                               and ast.dump(node,include_attributes=False)==ast.dump(
                                   ast.parse("r15_gate_inheritance_git_controls(lanes['inheritance'], sys.argv[2] if product_bound else None)",
                                             mode="eval").body,
                                   include_attributes=False)] if main_node else []
    identity_positions=[index for index,name in enumerate(main_calls) if name=="r15_product_identity"]
    matrix_positions=[index for index,name in enumerate(main_calls) if name=="r15_connected_matrix"]
    check(len(inheritance_control_calls)==1,
          "J_R22_INHERITANCE_ALIAS_CONTRACT_STATE_EXPLICIT_MODE_BOUND_CAUSAL")
    check(len(identity_positions)==1 and len(matrix_positions)>=1
          and identity_positions[0]<max(matrix_positions)
          and "r15_source_capability_selftests" in main_calls
          and main_calls.index("r15_source_capability_selftests")
              < main_calls.index("r15_reference_satisfiability")
          and identity_source.count(identity_reference_assign)==1
          and identity_source.count(identity_scope_assign)==1
          and identity_source.index(identity_reference_assign)<identity_source.index(identity_scope_assign)
          and len(identity_reference_nodes)==len(identity_scope_nodes)==1
          and len(identity_reference_calls)==len(identity_scope_calls)==1
          and store_count(identity_node,"reference_sources")==1
          and store_count(identity_node,"ok")==1 and store_count(identity_node,"why")==1
          and isinstance(identity_fail_node,ast.If)
          and ast.unparse(identity_fail_node)=="if not ok:\n    return (ok, why)",
          "J_R15_FAULT_STATUS_CREDIT_ONLY_AFTER_EXACT_SOURCE_OR_GATE_OWNED_REFERENCE_ORDER")
    authorization_inputs=(
        (True,1,True,0),(False,1,True,0),(True,0,True,0),
        (True,1,False,0),(True,1,True,1),(True,1,True,False),
        (1,1,True,0),(True,True,True,0),(True,-1,True,0),
        (True,1,1,0),(True,1,True,-1),(True,1,True,None))
    authorization_rows=[r15_matrix_authorized(*row) for row in authorization_inputs]
    matrix_sentinel=[]
    for row in authorization_inputs:
        if r15_matrix_authorized(*row): matrix_sentinel.append(row)
    main_source=ast.unparse(main_node) if main_node is not None else ""
    authorization_ifs=[node for node in ast.walk(main_node)
                       if isinstance(node,ast.If) and isinstance(node.test,ast.Call)
                       and isinstance(node.test.func,ast.Name)
                       and node.test.func.id=="r15_matrix_authorized"] if main_node else []
    authorization_if=authorization_ifs[0] if len(authorization_ifs)==1 else None
    authorization_test=(ast.dump(authorization_if.test,include_attributes=False)
                        if authorization_if is not None else "")
    expected_test=ast.dump(ast.parse(
        "r15_matrix_authorized(reference_ok,reference_count,identity_ok,failed)",
        mode="eval").body,include_attributes=False)
    body_matrix_calls=[node for node in ast.walk(ast.Module(body=authorization_if.body,
                                                             type_ignores=[]))
                       if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
                       and node.func.id=="r15_connected_matrix"] if authorization_if else []
    else_noncredit=[node for node in ast.walk(ast.Module(body=authorization_if.orelse,
                                                          type_ignores=[]))
                    if isinstance(node,ast.Constant)
                    and node.value=="NON_CREDIT_MATRIX_PREREQUISITE_REJECTED"] if authorization_if else []
    reference_assignments=[node for node in ast.walk(main_node)
                           if isinstance(node,ast.Assign)
                           and len(node.targets)==1
                           and isinstance(node.targets[0],ast.Tuple)
                           and [item.id for item in node.targets[0].elts
                                if isinstance(item,ast.Name)]==[
                                    "reference_ok","reference_why","reference_count"]
                           and isinstance(node.value,ast.Call)
                           and isinstance(node.value.func,ast.Name)
                           and node.value.func.id=="r15_reference_satisfiability"
                           and ast.dump(node.value,include_attributes=False)==ast.dump(
                               ast.parse("r15_reference_satisfiability(lanes['reference'], sys.argv[2] if product_bound else None)",
                                         mode="eval").body,include_attributes=False)] if main_node else []
    canonical_reference_calls=[node for node in ast.walk(main_node)
                               if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
                               and node.func.id=="r15_reference_satisfiability"] if main_node else []
    product_ifs=[node for node in ast.walk(main_node) if isinstance(node,ast.If)
                 and isinstance(node.test,ast.Name) and node.test.id=="product_bound"
                 and any(isinstance(item,ast.Call) and isinstance(item.func,ast.Name)
                         and item.func.id=="r15_connected_matrix"
                         for item in ast.walk(node))] if main_node else []
    product_body=ast.Module(body=product_ifs[0].body,type_ignores=[]) if len(product_ifs)==1 else None
    all_direct_matrix=[node for node in ast.walk(main_node)
                       if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
                       and node.func.id=="r15_connected_matrix"] if main_node else []
    identity_assignments=[node for node in ast.walk(product_body)
                          if isinstance(node,ast.Assign) and len(node.targets)==1
                          and isinstance(node.targets[0],ast.Tuple)
                          and [item.id for item in node.targets[0].elts
                               if isinstance(item,ast.Name)]==["identity_ok","identity_why"]
                          and isinstance(node.value,ast.Call)
                          and isinstance(node.value.func,ast.Name)
                          and node.value.func.id=="r15_product_identity"
                          and ast.dump(node.value,include_attributes=False)==ast.dump(
                              ast.parse("r15_product_identity(sys.argv[2],sys.argv[3])",
                                        mode="eval").body,include_attributes=False)] if product_body else []
    matrix_assignments=[node for node in ast.walk(product_body)
                        if isinstance(node,ast.Assign) and len(node.targets)==1
                        and isinstance(node.targets[0],ast.Tuple)
                        and [item.id for item in node.targets[0].elts
                             if isinstance(item,ast.Name)]==[
                                 "matrix_ok","matrix_why","matrix_count"]
                        and node.value in all_direct_matrix] if product_body else []
    matrix_loads=[node for node in ast.walk(main_node) if isinstance(node,ast.Name)
                  and isinstance(node.ctx,ast.Load) and node.id=="r15_connected_matrix"] if main_node else []
    expected_matrix_check=ast.dump(ast.parse(
        "check(matrix_ok and matrix_count==reference_count,H035_R15_EXPECTED_LABEL,matrix_why)",
        mode="eval").body,include_attributes=False)
    matrix_credit_checks=[node for node in ast.walk(product_body)
                          if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
                          and node.func.id=="check"
                          and ast.dump(node,include_attributes=False)==expected_matrix_check] if product_body else []
    def exact_guard_shape(source: str) -> bool:
        try: module=ast.parse(source)
        except SyntaxError: return False
        guards=[node for node in ast.walk(module) if isinstance(node,ast.If)
                and isinstance(node.test,ast.Call) and isinstance(node.test.func,ast.Name)
                and node.test.func.id=="r15_matrix_authorized"]
        if len(guards)!=1 or ast.dump(guards[0].test,include_attributes=False)!=expected_test:
            return False
        all_matrix=[node for node in ast.walk(module) if isinstance(node,ast.Call)
                    and isinstance(node.func,ast.Name) and node.func.id=="r15_connected_matrix"]
        body_matrix=[node for node in ast.walk(ast.Module(body=guards[0].body,type_ignores=[]))
                     if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
                     and node.func.id=="r15_connected_matrix"]
        else_matrix=[node for node in ast.walk(ast.Module(body=guards[0].orelse,type_ignores=[]))
                     if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
                     and node.func.id=="r15_connected_matrix"]
        return len(all_matrix)==len(body_matrix)==1 and not else_matrix and bool(guards[0].orelse)
    guard_positive="""if r15_matrix_authorized(reference_ok,reference_count,identity_ok,failed):
 r15_connected_matrix(actual,base,candidate)
else:
 reject('NON_CREDIT_MATRIX_PREREQUISITE_REJECTED')
"""
    guard_mutants=(
        guard_positive.replace("):\n r15_connected_matrix",") or True:\n r15_connected_matrix",1),
        guard_positive.replace("if r15_matrix_authorized","try:\n if r15_matrix_authorized",1)
                      .replace("else:\n reject"," else:\n  reject",1)+"except Exception:\n r15_connected_matrix(actual,base,candidate)\n",
        guard_positive+"r15_connected_matrix(actual,base,candidate)\n",
    )
    check(authorization_rows==[True]+[False]*(len(authorization_inputs)-1)
          and matrix_sentinel==[(True,1,True,0)]
          and authorization_test==expected_test
          and len(body_matrix_calls)==1 and len(all_direct_matrix)==1
          and body_matrix_calls[0] is all_direct_matrix[0] and len(else_noncredit)==1
          and len(canonical_reference_calls)==1 and len(reference_assignments)==1
          and store_count(main_node,"reference_ok")==1
          and store_count(main_node,"reference_count")==1
          and store_count(product_body,"identity_ok")==1
          and len(identity_assignments)==1 and len(matrix_assignments)==1
          and len(matrix_credit_checks)==1
          and len(matrix_loads)==1 and matrix_loads[0] is all_direct_matrix[0].func
          and main_source.count("r15_connected_matrix(lanes['actual'], sys.argv[2], sys.argv[3])")==1,
          "J_R15_ACTUAL_MATRIX_STRICT_REFERENCE_AND_IDENTITY_DOMINANCE_CAUSAL")
    check(exact_guard_shape(guard_positive)
          and all(not exact_guard_shape(mutant) for mutant in guard_mutants),
          "J_R15_ACTUAL_MATRIX_UNCONDITIONAL_CAUGHT_ELSE_REACHABILITY_MUTANTS_REJECT")


def r15_numstat_budget(additions: int, deletions: int, *, max_added: int = 2071,
                       max_deleted: int = 0, max_total: int = 2071) -> tuple[bool,str]:
    if deletions > max_deleted:
        return False, f"product deletion/minification forbidden: deleted={deletions}"
    if additions > max_added:
        return False, f"product added-line budget exceeded: added={additions} cap={max_added}"
    if additions+deletions > max_total:
        return False, (f"product total-changed-line budget exceeded: "
                       f"total={additions+deletions} cap={max_total}")
    return True,"strict additive budget"


def r15_product_diff_scope(repo: Path, base: str,
                           candidate_sha: str,
                           reference_sources: tuple[str, str, str] | None = None) -> tuple[bool, str]:
    shape_ok, shape_why = r15_repository_shape(repo)
    if not shape_ok: return False, shape_why
    if not all(re.fullmatch(r"[0-9a-f]{40}", value or "")
                   for value in (base, candidate_sha)):
        return False, "base/candidate must be exact lowercase commit identities"
    for identity in (base, candidate_sha):
        resolved = r15_git(repo, "cat-file", "-t", identity)
        if resolved.returncode or resolved.stdout.strip() != "commit":
            return False, f"unknown exact commit {identity}"
    commit = r15_git(repo, "cat-file", "-p", candidate_sha)
    parents = [line.split(" ", 1)[1] for line in commit.stdout.splitlines()
               if line.startswith("parent ")]
    if commit.returncode or parents != [base]:
        return False, "candidate must have exactly the reviewed base as its single parent"
    names = r15_git(repo, "diff", "--name-only", "--no-renames", "--no-ext-diff",
                    "--no-textconv", base, candidate_sha)
    if names.returncode or tuple(names.stdout.splitlines()) != H035_R15_PRODUCT_PATHS:
        return False, f"product changed set is not the exact three CLIs: {names.stdout.splitlines()!r}"
    status = r15_git(repo, "diff", "--name-status", "--no-renames", "--no-ext-diff",
                     "--no-textconv", base, candidate_sha)
    if status.returncode or status.stdout.splitlines() != [f"M\t{path}" for path in H035_R15_PRODUCT_PATHS]:
        return False, "product paths must be modifications without rename/type substitution"
    tree = r15_git(repo, "--literal-pathspecs", "ls-tree", candidate_sha,
                   "--", *H035_R15_PRODUCT_PATHS)
    rows = [line.split(None, 3) for line in tree.stdout.splitlines()]
    if (tree.returncode or len(rows) != 3
            or [row[0] for row in rows] != ["100755"] * 3
            or [row[1] for row in rows] != ["blob"] * 3
            or [row[3].split("\t", 1)[-1] for row in rows] != list(H035_R15_PRODUCT_PATHS)):
        return False, "product paths must remain exact executable regular Git blobs"
    numstat = r15_git(repo, "diff", "--numstat", "--no-renames", "--no-ext-diff",
                  "--no-textconv", base, candidate_sha,
                  "--", *H035_R15_PRODUCT_PATHS)
    additions = 0; deletions = 0
    numstat_lines=numstat.stdout.splitlines()
    if numstat.returncode:
        return False, "product numstat observation failed"
    if len(numstat_lines)!=3:
        return False, "product numstat must have exact three rows"
    for index,line in enumerate(numstat_lines):
        fields = line.split("\t")
        if len(fields) != 3 or not fields[0].isdigit() or not fields[1].isdigit():
            return False, "binary or malformed product numstat"
        if fields[2]!=H035_R15_PRODUCT_PATHS[index]:
            return False, "product numstat path/order mismatch"
        additions += int(fields[0])
        deletions += int(fields[1])
    budget_ok,budget_why=r15_numstat_budget(additions,deletions)
    if not budget_ok: return False,budget_why
    for relative in ("specs/tasks.spec.json", "verify/bin/h-035-exit"):
        if r15_git_object_bytes(repo, base, relative) != r15_git_object_bytes(repo, candidate_sha, relative):
            return False, f"frozen R15 contract bytes changed: {relative}"
    if reference_sources is not None:
        capability_ok, capability_why = r15_source_capability_scope(
            repo, base, candidate_sha, reference_sources)
        if not capability_ok: return False, capability_why
    return True, f"exact three-CLI direct child with {additions} added lines"


def r15_product_identity(base: str, candidate_sha: str) -> tuple[bool, str]:
    try: reference_sources = r15_reference_sources(ROOT, base)
    except (OSError, ValueError, Rig) as exc: return False, "trusted reference generation: " + str(exc)
    ok, why = r15_product_diff_scope(ROOT, base, candidate_sha, reference_sources)
    if not ok: return ok, why
    shape_ok, shape_why = r15_repository_shape(ROOT)
    if not shape_ok: return False, shape_why
    head = r15_git(ROOT, "rev-parse", "--verify", "HEAD")
    if head.returncode or head.stdout.strip() != candidate_sha:
        return False, "checked-out HEAD is not exact product candidate"
    contract_commit=r15_git(ROOT,"cat-file","-p",base)
    contract_parents=[line.split(" ",1)[1] for line in contract_commit.stdout.splitlines()
                      if line.startswith("parent ")]
    if (not contract_commit.returncode and len(contract_parents)==2
            and contract_parents[0]==str(H035_R26_SUCCESSOR["authority_base_sha"])):
        review_path=Path(str(H035_R26_SUCCESSOR["aggregate_review_path"]))
        receipt_path=Path(str(H035_R26_SUCCESSOR["publication_receipt_path"]))
    else:
        review_path=H035_R15_CONTRACT_REVIEW_PATH
        receipt_path=H035_R15_CONTRACT_RECEIPT_PATH
    publication_ok,publication_why=r15_contract_publication_proof(
        ROOT,base,review_path,receipt_path,
        observe_remote=True)
    if not publication_ok: return False,publication_why
    physical_ok, physical_why = r15_physical_checkout_exact(ROOT, candidate_sha)
    if not physical_ok: return False, physical_why
    for relative, local in (("specs/tasks.spec.json", SPEC),
                            ("verify/bin/h-035-exit", Path(__file__))):
        if r15_git_object_bytes(ROOT, candidate_sha, relative) != local.read_bytes():
            return False, f"candidate contract bytes mismatch: {relative}"
    return True, why


def r15_product_scope_selftests(tmp: Path) -> None:
    repo = tmp / "r15-product-scope"; init_repo(repo)
    bare=tmp/"r15-product-scope-origin.git"
    made=run(["/usr/bin/git","init","--bare","-q",str(bare)],cwd=tmp)
    if made.returncode: raise Rig(made.stderr)
    configured=git(repo,"remote","add","origin",str(bare.resolve()))
    if configured.returncode: raise Rig(configured.stderr)
    for path in H035_R15_PRODUCT_PATHS:
        target=repo/path; target.parent.mkdir(parents=True,exist_ok=True)
        target.write_text("#!/usr/bin/env python3\nprint('base')\n"); target.chmod(0o755)
    (repo/"specs").mkdir(); (repo/"verify/bin").mkdir(parents=True)
    (repo/"specs/tasks.spec.json").write_text("{}\n")
    (repo/"verify/bin/h-035-exit").write_text("#!/bin/sh\nexit 1\n")
    base=commit_paths(repo,"r15 product base",*H035_R15_PRODUCT_PATHS,
                      "specs/tasks.spec.json","verify/bin/h-035-exit")

    def build(parent: str, label: str, *, lines: int = 1,
              extra: str | None = None, mode: int = 0o755) -> str:
        p=git(repo,"checkout","-q",parent)
        if p.returncode: raise Rig(p.stderr)
        for index,path in enumerate(H035_R15_PRODUCT_PATHS):
            target=repo/path
            target.write_text(target.read_text() + "".join(
                f"# {label}-{index}-{number}\n" for number in range(lines)))
            target.chmod(mode if index == 0 else 0o755)
        paths=list(H035_R15_PRODUCT_PATHS)
        if extra is not None:
            target=repo/extra; target.parent.mkdir(parents=True,exist_ok=True)
            target.write_text("extra\n"); paths.append(extra)
        return commit_paths(repo,label,*paths)

    good=build(base,"good",lines=2)
    extra=build(base,"extra",lines=1,extra="controller/authority/neighbor")
    over=build(base,"over",lines=700)
    wrong_mode=build(base,"mode",lines=1,mode=0o644)
    stacked=build(good,"stacked",lines=3)

    def additive(label: str, additions: tuple[int,int,int], *, delete_first: bool=False) -> str:
        p=git(repo,"checkout","-q",base)
        if p.returncode: raise Rig(p.stderr)
        for index,path in enumerate(H035_R15_PRODUCT_PATHS):
            target=repo/path; original=target.read_text().splitlines(keepends=True)
            if index==0 and delete_first: original=original[:1]
            target.write_text("".join(original)+"".join(
                f"# {label}-{index}-{number}\n" for number in range(additions[index])))
            target.chmod(0o755)
        return commit_paths(repo,label,*H035_R15_PRODUCT_PATHS)

    exact_cap=additive("exact-cap",(2069,1,1))
    cap_plus_one=additive("cap-plus-one",(2070,1,1))
    deletion=additive("deletion",(2010,1,1),delete_first=True)
    exact_ok,exact_why=r15_product_diff_scope(repo,base,exact_cap)
    over_ok,over_why=r15_product_diff_scope(repo,base,cap_plus_one)
    deletion_ok,deletion_why=r15_product_diff_scope(repo,base,deletion)
    baseline = (r15_product_diff_scope(repo,base,good)[0]
          and not r15_product_diff_scope(repo,base,extra)[0]
          and not r15_product_diff_scope(repo,base,over)[0]
          and not r15_product_diff_scope(repo,base,wrong_mode)[0]
          and not r15_product_diff_scope(repo,base,stacked)[0])
    check(baseline,
          "J_R15_PRODUCT_IDENTITY_SCOPE_MODE_BUDGET_STACK_MUTANTS")
    check(exact_ok and "2071 added lines" in exact_why
          and not over_ok and "added-line budget exceeded" in over_why
          and not deletion_ok and "deletion/minification forbidden" in deletion_why
          and not r15_numstat_budget(2072,0,max_total=3000)[0]
          and "added-line" in r15_numstat_budget(2072,0,max_total=3000)[1]
          and not r15_numstat_budget(2071,1,max_deleted=1)[0]
          and "total-changed-line" in r15_numstat_budget(2071,1,max_deleted=1)[1],
          "J_R15_PRODUCT_STRICT_ADDITIVE_EXACT_CAP_PLUS_ONE_DELETION_DERIVED_TOTAL_CAUSAL")

    fake = tmp / "r15-fake-path"; fake.mkdir()
    fake_git = fake / "git"; fake_git.write_text("#!/bin/sh\nexit 0\n"); fake_git.chmod(0o755)
    hostile = {
        "PATH":str(fake), "GIT_REPLACE_REF_BASE":"refs/replace/",
        "GIT_DIR":"/nonexistent/git-dir", "GIT_WORK_TREE":"/nonexistent/worktree",
        "GIT_INDEX_FILE":"/nonexistent/index", "GIT_OBJECT_DIRECTORY":"/nonexistent/objects",
        "GIT_ALTERNATE_OBJECT_DIRECTORIES":"/nonexistent/alternate",
        "GIT_SHALLOW_FILE":"/nonexistent/shallow", "GIT_CONFIG_GLOBAL":"/nonexistent/config",
        "GIT_CONFIG_COUNT":"1", "GIT_CONFIG_KEY_0":"alias.diff",
        "GIT_CONFIG_VALUE_0":"!exit 0", "LD_PRELOAD":"/nonexistent/loader",
        "DYLD_INSERT_LIBRARIES":"/nonexistent/loader",
    }
    prior = {key:os.environ.get(key) for key in hostile}
    os.environ.update(hostile)
    try: ambient_closed = r15_product_diff_scope(repo,base,good)[0]
    finally:
        for key,value in prior.items():
            if value is None: os.environ.pop(key,None)
            else: os.environ[key]=value
    check(ambient_closed,
          "J_R15_PRODUCT_IDENTITY_ABSOLUTE_NO_REPLACE_CLOSED_GIT_ENV_PATH_LOADER_POSITIVE")

    replace = git(repo,"replace",stacked,good)
    replace_rejected = replace.returncode == 0 and not r15_product_diff_scope(repo,base,stacked)[0]
    if replace.returncode == 0: git(repo,"replace","-d",stacked)
    git_dir = Path(git(repo,"rev-parse","--git-dir").stdout.strip())
    if not git_dir.is_absolute(): git_dir = repo / git_dir
    graft = git_dir / "info/grafts"; graft.parent.mkdir(parents=True,exist_ok=True)
    graft.write_text(f"{stacked} {base}\n")
    graft_rejected = not r15_product_diff_scope(repo,base,stacked)[0]
    graft.unlink()
    graft.symlink_to("missing-graft-target")
    dangling_graft_rejected = not r15_product_diff_scope(repo,base,good)[0]
    graft.unlink()
    shallow = git_dir / "shallow"; shallow.write_text(base+"\n")
    shallow_rejected = not r15_product_diff_scope(repo,base,good)[0]
    shallow.unlink()
    check(replace_rejected and graft_rejected and dangling_graft_rejected and shallow_rejected,
          "J_R15_PRODUCT_IDENTITY_REPLACE_GRAFT_SHALLOW_REPOSITORY_MUTANTS_REJECT")
    checkout=git(repo,"checkout","-q",good)
    physical_positive = checkout.returncode == 0 and r15_physical_checkout_exact(repo,good)[0]
    skip=git(repo,"update-index","--skip-worktree","specs/tasks.spec.json")
    (repo/"specs/tasks.spec.json").write_text('{"hidden":"dirty"}\n')
    status_hidden=git(repo,"status","--porcelain=v1").stdout == ""
    physical_reject=not r15_physical_checkout_exact(repo,good)[0]
    git(repo,"update-index","--no-skip-worktree","specs/tasks.spec.json")
    (repo/"specs/tasks.spec.json").write_bytes(
        r15_git_object_bytes(repo,good,"specs/tasks.spec.json") or b"")
    check(physical_positive and skip.returncode == 0 and status_hidden and physical_reject,
          "J_R15_PHYSICAL_TREE_REJECTS_INDEX_SKIP_WORKTREE_HIDDEN_DIRTY_BYTES")

    config_mutants=[]
    for key,value in (
        ("include.path",str(repo/"hostile.inc")),
        ("url.file:///nonexistent/.insteadOf",str(repo.resolve())),
        ("core.sshCommand","/bin/false"),("credential.helper","!false"),
        ("core.attributesFile",str(repo/"hostile.attributes")),
        ("core.excludesFile",str(repo/"hostile.excludes")),
        ("core.gitProxy","/hostile/proxy-command"),
        ("fetch.bundleURI","file:///hostile.bundle"),
        ("gc.recentObjectsHook","/hostile/recent-command"),
        ("remote.origin.uploadpack","/bin/false"),
    ):
        set_value=git(repo,"config","--local",key,value)
        config_mutants.append(set_value.returncode == 0
                              and not r15_product_diff_scope(repo,base,good)[0])
        cleaned=run(["/usr/bin/git","config","--no-includes","--file",
                     str(repo/".git/config"),"--unset-all",key],cwd=repo)
        if cleaned.returncode: raise Rig(cleaned.stderr)
    check(all(config_mutants),
          "J_R15_LOCAL_INCLUDE_URL_SSH_CREDENTIAL_ATTRIBUTE_REMOTE_HELPER_CONFIG_REJECT")
    hostile_excludes=tmp/"hostile.excludes"; hidden=repo/"hidden-by-external-ignore"
    hostile_excludes.write_text("hidden-by-external-ignore\n"); hidden.write_text("untracked\n")
    set_excludes=git(repo,"config","--local","core.excludesFile",str(hostile_excludes))
    externally_hidden=(set_excludes.returncode==0
                       and git(repo,"status","--porcelain=v1").stdout=="")
    excludes_rejected=not r15_product_diff_scope(repo,base,good)[0]
    restored=run(["/usr/bin/git","config","--no-includes","--file",str(repo/".git/config"),
                  "--unset-all","core.excludesFile"],cwd=repo)
    hidden.unlink(); hostile_excludes.unlink()
    if restored.returncode: raise Rig(restored.stderr)
    check(externally_hidden and excludes_rejected,
          "J_R15_CORE_EXCLUDES_FILE_EXTERNAL_READ_HIDDEN_UNTRACKED_REJECT")
    enabled=git(repo,"config","--local","extensions.worktreeConfig","true")
    worktree_config=repo/".git/config.worktree"
    worktree_config.write_text("[core]\n\tsshCommand = /hostile/unreviewed-ssh-command\n")
    extension_rejected=(enabled.returncode==0
                        and not r15_product_diff_scope(repo,base,good)[0])
    worktree_config.unlink()
    disabled=run(["/usr/bin/git","config","--no-includes","--file",
                  str(repo/".git/config"),"--unset-all","extensions.worktreeConfig"],cwd=repo)
    if disabled.returncode: raise Rig(disabled.stderr)
    worktree_config.write_text("[core]\n\tsshCommand = /hostile/latent-command\n")
    latent_rejected=not r15_product_diff_scope(repo,base,good)[0]
    worktree_config.unlink(); worktree_config.symlink_to("missing-hostile-config")
    symlink_rejected=not r15_product_diff_scope(repo,base,good)[0]
    worktree_config.unlink()
    extension_mutants=[]
    partial_no_odb_effect=False
    config_path=repo/".git/config"; config_baseline=config_path.read_bytes()
    for name in ("noop","objectFormat","compatObjectFormat","partialClone",
                 "preciousObjects","refStorage","relativeWorktrees",
                 "worktreeConfig","unknownAuthority"):
        key="extensions."+name
        set_extension=git(repo,"config","--local",key,"true")
        before_objects=filesystem_snapshot(repo/".git/objects") if name=="partialClone" else None
        extension_mutants.append(set_extension.returncode==0
                                 and not r15_product_diff_scope(repo,base,good)[0])
        if name=="partialClone":
            partial_no_odb_effect=(before_objects==filesystem_snapshot(repo/".git/objects"))
        config_path.write_bytes(config_baseline)
    format_one=git(repo,"config","--local","core.repositoryFormatVersion","1")
    format_one_rejected=(format_one.returncode==0
                         and not r15_product_diff_scope(repo,base,good)[0])
    restored_format=git(repo,"config","--local","core.repositoryFormatVersion","0")
    if restored_format.returncode: raise Rig(restored_format.stderr)
    linked=tmp/"r15-linked-worktree"
    added=git(repo,"worktree","add","--detach","-q",str(linked),good)
    linked_positive=(added.returncode==0 and r15_product_diff_scope(linked,base,good)[0])
    linked_git=Path(git(linked,"rev-parse","--absolute-git-dir").stdout.strip())
    linked_config=linked_git/"config.worktree"
    common_config=repo/".git/config.worktree"
    common_config.write_text("[core]\n\tsshCommand = /hostile/common-linked-command\n")
    common_linked_rejected=not r15_product_diff_scope(linked,base,good)[0]
    common_config.unlink()
    linked_config.write_text("[core]\n\tsshCommand = /hostile/linked-command\n")
    linked_rejected=not r15_product_diff_scope(linked,base,good)[0]
    linked_config.unlink()
    removed=git(repo,"worktree","remove","--force",str(linked))
    if removed.returncode: raise Rig(removed.stderr)
    check(extension_rejected and latent_rejected and symlink_rejected
          and all(extension_mutants) and format_one_rejected and linked_positive
          and partial_no_odb_effect and common_linked_rejected and linked_rejected,
          "J_R15_EXTENSIONS_AND_ACTIVE_CONFIG_WORKTREE_STANDALONE_LINKED_LATENT_TYPE_REJECT")

    dot_git=repo/".git"; real_git=repo/".git-r15-real"
    dot_git.rename(real_git); dot_git.symlink_to(real_git.name)
    try: gitfile_substitution=not r15_product_diff_scope(repo,base,good)[0]
    finally:
        dot_git.unlink(); real_git.rename(dot_git)
    check(gitfile_substitution,
          "J_R15_DOT_GIT_SYMLINK_SUBSTITUTION_REJECT")

    authority_baseline=r15_repository_authority_snapshot(repo,bare)
    local_object=run(["/usr/bin/git","-C",str(repo),"hash-object","-w","--stdin"],
                     cwd=repo,stdin="r15-local-orphan-object\n")
    local_object_changed=(local_object.returncode==0
                          and r15_repository_authority_snapshot(repo,bare)!=authority_baseline)
    local_sha=local_object.stdout.strip()
    local_git=Path(git(repo,"rev-parse","--git-dir").stdout.strip())
    if not local_git.is_absolute(): local_git=repo/local_git
    local_loose=local_git/"objects"/local_sha[:2]/local_sha[2:]
    if local_loose.exists(): local_loose.unlink()
    authority_baseline=r15_repository_authority_snapshot(repo,bare)
    remote_object=run(["/usr/bin/git","-C",str(bare),"hash-object","-w","--stdin"],
                      cwd=repo,stdin="r15-remote-orphan-object\n")
    remote_object_changed=(remote_object.returncode==0
                           and r15_repository_authority_snapshot(repo,bare)!=authority_baseline)
    remote_sha=remote_object.stdout.strip(); remote_loose=bare/"objects"/remote_sha[:2]/remote_sha[2:]
    if remote_loose.exists(): remote_loose.unlink()
    authority_baseline=r15_repository_authority_snapshot(repo,bare)
    remote_config=bare/"config"; remote_config_raw=remote_config.read_bytes()
    remote_config.write_bytes(remote_config_raw+b"\n# r15 hostile config-only mutation\n")
    remote_config_changed=r15_repository_authority_snapshot(repo,bare)!=authority_baseline
    remote_config.write_bytes(remote_config_raw)
    authority_baseline=r15_repository_authority_snapshot(repo,bare)
    remote_head=bare/"HEAD"; remote_head_raw=remote_head.read_bytes()
    remote_head.write_bytes(b"ref: refs/heads/hostile\n")
    remote_head_changed=r15_repository_authority_snapshot(repo,bare)!=authority_baseline
    remote_head.write_bytes(remote_head_raw)
    check(local_object_changed and remote_object_changed
          and remote_config_changed and remote_head_changed,
          "J_R15_LOCAL_REMOTE_OBJECT_CONFIG_HEAD_ONLY_MUTATIONS_REJECT_UNCHANGED_CREDIT")


def r15_cli(repo: Path, relative: str, *args: str, stdin: str | None = None,
            env_extra: dict[str,str] | None = None,
            timeout: float = 30, cwd: Path | None = None) -> subprocess.CompletedProcess:
    env=os.environ.copy(); env.pop("PYTHONDONTWRITEBYTECODE",None); env.pop("PYTHONPYCACHEPREFIX",None)
    if env_extra: env.update(env_extra)
    try:
        return subprocess.run([sys.executable,str(repo/relative),*args],cwd=(repo if cwd is None else cwd),env=env,
                              input=stdin,text=True,capture_output=True,shell=False,
                              check=False,timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        return subprocess.CompletedProcess(exc.cmd,124,exc.stdout or "",exc.stderr or "timeout")


def r15_cli_zero_file_limit(repo: Path, relative: str, *args: str,
                            stdin: str | None = None) -> subprocess.CompletedProcess:
    def limit() -> None:
        signal.signal(signal.SIGXFSZ,signal.SIG_IGN)
        resource.setrlimit(resource.RLIMIT_FSIZE,(0,0))
    env=os.environ.copy(); env.pop("PYTHONDONTWRITEBYTECODE",None); env.pop("PYTHONPYCACHEPREFIX",None)
    return subprocess.run([sys.executable,str(repo/relative),*args],cwd=repo,env=env,
                          input=stdin,text=True,capture_output=True,shell=False,
                          check=False,timeout=30,preexec_fn=limit)


def r15_code_fingerprint(code: object) -> str:
    code_type=type((lambda:None).__code__)
    def constant(value: object) -> object:
        if isinstance(value,code_type):return ["code",shape(value)]
        if isinstance(value,bytes):return ["bytes",value.hex()]
        if isinstance(value,tuple):return ["tuple",[constant(item) for item in value]]
        if isinstance(value,frozenset):
            rows=[constant(item) for item in value]
            return ["frozenset",sorted(rows,key=lambda item:json.dumps(item,sort_keys=True))]
        if value is None or type(value) in (bool,int,float,str):return [type(value).__name__,value]
        return [type(value).__name__,repr(value)]
    def shape(value: object) -> object:
        return [value.co_argcount,value.co_posonlyargcount,value.co_kwonlyargcount,
                value.co_nlocals,value.co_flags,value.co_code.hex(),list(value.co_names),
                list(value.co_varnames),list(value.co_freevars),list(value.co_cellvars),
                [constant(item) for item in value.co_consts]]
    raw=json.dumps(shape(code),ensure_ascii=False,sort_keys=True,
                   separators=(",",":"),allow_nan=False).encode("utf-8")
    return hashlib.sha256(raw).hexdigest()


def r15_legacy_code_fingerprints(repo: Path, relative: str) -> dict[str,str]:
    wanted={
        "controller/attest/cli":("main",),
        "controller/authority/cli":("owner_author","check_candidate","record_review","owner_freeze"),
        "controller/taskval/cli":("main","valj","kmd_claim"),
    }.get(relative,())
    raw=r15_git_object_bytes(repo,H035_R15_BASE,relative)
    if raw is None:raise Rig("R15 legacy trace base blob")
    try:top=compile(raw.decode("utf-8",errors="strict"),relative,"exec",
                    dont_inherit=True,optimize=0)
    except (UnicodeError,SyntaxError) as exc:raise Rig("R15 legacy trace compile") from exc
    code_type=type(top);found={name:[] for name in wanted}
    def walk(code: object) -> None:
        if code.co_name in found:found[code.co_name].append(r15_code_fingerprint(code))
        for value in code.co_consts:
            if isinstance(value,code_type):walk(value)
    walk(top)
    if any(len(values)!=1 for values in found.values()):
        raise Rig("R15 legacy trace callable cardinality")
    expected={name:values[0] for name,values in found.items()}
    try:candidate=compile((repo/relative).read_text(encoding="utf-8"),relative,"exec",
                          dont_inherit=True,optimize=0)
    except (OSError,UnicodeError,SyntaxError) as exc:
        raise Rig("R15 legacy trace candidate compile") from exc
    candidate_found={name:[] for name in wanted}
    def candidate_walk(code: object) -> None:
        if code.co_name in candidate_found:
            candidate_found[code.co_name].append(r15_code_fingerprint(code))
        for value in code.co_consts:
            if isinstance(value,code_type):candidate_walk(value)
    candidate_walk(candidate)
    if any(values.count(expected[name])!=1 for name,values in candidate_found.items()):
        raise Rig("R15 legacy trace unique candidate callable")
    return expected


def r15_runtime_export_fingerprints(repo: Path) -> dict[str,str]:
    try:raw=(repo/"controller/attest/cli").read_bytes()
    except OSError as exc:raise Rig("R15 export trace attest read") from exc
    begin=b"# H035_R15_RETAINED_ENGINE_BEGIN_V1\n"
    end=b"# H035_R15_RETAINED_ENGINE_END_V1\n"
    if raw.count(begin)!=1 or raw.count(end)!=1:raise Rig("R15 export trace markers")
    first=raw.find(begin)+len(begin);last=raw.find(end)
    if first<len(begin) or last<first:raise Rig("R15 export trace marker order")
    try:top=compile(raw[first:last].decode("utf-8",errors="strict"),
                    "<h035-r15-retained-attest-engine>","exec",
                    dont_inherit=True,optimize=0)
    except (UnicodeError,SyntaxError) as exc:raise Rig("R15 export trace compile") from exc
    code_type=type(top);wanted=("authority_value","taskval_main","attest_main")
    found={name:[] for name in wanted}
    def walk(code: object) -> None:
        if code.co_name in found:found[code.co_name].append(r15_code_fingerprint(code))
        for value in code.co_consts:
            if isinstance(value,code_type):walk(value)
    walk(top)
    if any(len(values)!=1 for values in found.values()):
        raise Rig("R15 export trace callable cardinality")
    return {"__engine_module__":r15_code_fingerprint(top),
            **{name:values[0] for name,values in found.items()}}


def r15_expected_export_trace(export: str, argv: list[str], *,
                               stdin: str | None, result: object,
                               request: dict[str,object] | None = None) -> list[dict[str,object]]:
    base={"export":export,"argv":argv,
          "request_sha256":canonical_json_sha256(request) if request is not None else None,
          "stdin_sha256":hashlib.sha256(stdin.encode("utf-8")).hexdigest()
              if stdin is not None else None,
          "keyword_names":[]}
    return [{**base,"phase":"CALL"},{**base,"phase":"RETURN","result":result}]


def r15_expected_legacy_trace(name: str, digest: str, result: object,
                               arguments: dict[str,object]
                               ) -> list[dict[str,object]]:
    binding="_r15_legacy_main" if name=="main" else name
    base={"legacy":name,"code_sha256":digest,"binding":binding,
          "arguments":arguments}
    return [{**base,"phase":"CALL"},{**base,"phase":"RETURN","result":result}]


def r15_cli_runpy_fault(repo: Path, relative: str, args: list[str], *,
                        stdin: str | None, fault: str,
                        target: Path | None = None,
                        replacement: bytes = b"",
                        substitute: Path | None = None,
                        env_extra: dict[str,str] | None = None,
                        route_audit: bool = False) -> subprocess.CompletedProcess:
    reserved={"R15_STATUS_FD","R15_STATUS_KEY_FD","R15_STATUS_NONCE","R15_STATUS_CALL","R15_FAULT",
              "R15_ROUTE_AUDIT",
