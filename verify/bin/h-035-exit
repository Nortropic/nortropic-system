 try:
  b=os.fstat(fd)
  if _full(a)!=_full(b):raise Stop("retained leaf open race")
  raw=fdbytes(fd,limit);c=os.fstat(fd);named=os.stat(name,dir_fd=rootfd,follow_symlinks=False)
  if _full(b)!=_full(c) or _full(b)!=_full(named):raise Stop("retained leaf replacement")
  _validate_context(context);return (raw,F(raw),_full(b)) if identity else (raw,F(raw))
 finally:os.close(fd)
