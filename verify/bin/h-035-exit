            "task":task_value,"request_sha256":request_sha,"manifest_sha256":manifest_sha,
            "attest_root_dev_ino":manifest["attest_root_dev_ino"],
            "attest_manifest_dev_ino":manifest["attest_manifest_dev_ino"],
            "attest_lock_dev_ino":manifest["attest_lock_dev_ino"],
            "attestation_store_slot_dev_inos":manifest["attestation_store_slot_dev_inos"],
            "attest_recovery_log_dev_ino":manifest["attest_recovery_log_dev_ino"],
            "pending_sequence":sequence,"old_store_sha256":old_sha,"new_store_sha256":new_sha}
        pending={"record_type":"h035_r15_attest_recovery_v1","schema_version":1,
            "sequence":sequence,"phase":"PENDING","command":request["command"],"task":task_value,
            "manifest_sha256":manifest_sha,"operation_identity":canonical_json_sha256(operation),
            "request_sha256":request_sha,"old_store_sha256":old_sha,"new_store_sha256":new_sha,
            "previous_record_sha256":hashlib.sha256(lines[-1] if lines else b"").hexdigest()}
        committed={**pending,"sequence":sequence+1,"phase":"COMMITTED",
            "previous_record_sha256":hashlib.sha256(canonical_json_bytes(pending)+b"\n").hexdigest()}
        return pending,committed
