def _r15_selector_alias(path):
    path=Path(path);proof=None
    if path.is_absolute() and len(path.parts)>1 and path.parts[1] in ("var","tmp"):
        alias="/"+path.parts[1];target="private/"+path.parts[1];root_before=_r15_os.stat("/",follow_symlinks=False);before=_r15_os.lstat(alias)
        if _r15_stat.S_ISLNK(before.st_mode):
            if before.st_uid!=0 or before.st_nlink!=1 or _r15_os.readlink(alias)!=target:raise RuntimeError("R15 selector system alias")
            after=_r15_os.lstat(alias);root_after=_r15_os.stat("/",follow_symlinks=False)
            root_meta=lambda value:(value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_nlink)
            if _r15_meta(before)!=_r15_meta(after) or root_meta(root_before)!=root_meta(root_after):raise RuntimeError("R15 selector system alias race")
            proof=(alias,target,_r15_meta(before),root_meta(root_before));path=Path("/private")/path.parts[1]/Path(*path.parts[2:])
    return path,proof
def _r15_selector_alias_recheck(proof):
    if proof is None:return
    alias,target,want,want_root=proof;value=_r15_os.lstat(alias);root=_r15_os.stat("/",follow_symlinks=False)
    if _r15_meta(value)!=want or (root.st_dev,root.st_ino,root.st_mode,root.st_uid,root.st_nlink)!=want_root or _r15_os.readlink(alias)!=target:raise RuntimeError("R15 selector system alias changed")
def _r15_selector_raw(path,limit=8*1024*1024):
    path,alias_proof=_r15_selector_alias(Path(path));parts=path.parts;directory_flags=_r15_os.O_RDONLY|getattr(_r15_os,"O_DIRECTORY",0)|getattr(_r15_os,"O_NOFOLLOW",0)|getattr(_r15_os,"O_CLOEXEC",0);fds=[];leaf=-1;observed=False
    if not parts:return None
    if path.is_absolute():start=path.anchor;names=parts[1:]
    else:
        if any(name in ("",".","..") for name in parts):raise RuntimeError("R15 selector relative path")
        start=".";names=parts
    if not names:return None
    try:
        fds.append(_r15_os.open(start,directory_flags))
        for name in names[:-1]:
            before=_r15_os.stat(name,dir_fd=fds[-1],follow_symlinks=False);child=_r15_os.open(name,directory_flags,dir_fd=fds[-1]);opened=_r15_os.fstat(child)
            if not _r15_stat.S_ISDIR(opened.st_mode) or (before.st_dev,before.st_ino,before.st_mode,before.st_uid)!=(opened.st_dev,opened.st_ino,opened.st_mode,opened.st_uid):raise RuntimeError("R15 selector ancestor")
            fds.append(child)
        before=_r15_os.stat(names[-1],dir_fd=fds[-1],follow_symlinks=False);observed=True
        if not _r15_stat.S_ISREG(before.st_mode) or before.st_uid!=_r15_os.getuid() or before.st_nlink!=1 or before.st_size>limit:raise RuntimeError("R15 selector leaf")
        leaf=_r15_os.open(names[-1],_r15_os.O_RDONLY|getattr(_r15_os,"O_NOFOLLOW",0)|getattr(_r15_os,"O_CLOEXEC",0)|getattr(_r15_os,"O_NONBLOCK",0),dir_fd=fds[-1]);opened=_r15_os.fstat(leaf);raw=b"";offset=0
        if _r15_meta(before)!=_r15_meta(opened):raise RuntimeError("R15 selector open race")
        while offset<opened.st_size:
            part=_r15_os.pread(leaf,min(65536,opened.st_size-offset),offset)
            if not part:raise RuntimeError("R15 selector short read")
            raw+=part;offset+=len(part)
        if _r15_meta(_r15_os.fstat(leaf))!=_r15_meta(opened) or _r15_meta(_r15_os.stat(names[-1],dir_fd=fds[-1],follow_symlinks=False))!=_r15_meta(opened):raise RuntimeError("R15 selector leaf replacement")
        for index,name in enumerate(names[:-1],1):
            held=_r15_os.fstat(fds[index]);named=_r15_os.stat(name,dir_fd=fds[index-1],follow_symlinks=False)
            if (held.st_dev,held.st_ino,held.st_mode,held.st_uid)!=(named.st_dev,named.st_ino,named.st_mode,named.st_uid):raise RuntimeError("R15 selector ancestor replacement")
        _r15_selector_alias_recheck(alias_proof);return raw
    except FileNotFoundError:
        if observed:raise RuntimeError("R15 selector disappeared after observation")
        _r15_selector_alias_recheck(alias_proof)
        return None
    finally:
        if leaf>=0:_r15_os.close(leaf)
        for descriptor in reversed(fds):_r15_os.close(descriptor)
