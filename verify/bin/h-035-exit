def known_close(h):
 if not h:return
 errors=[]
 try:
  co=os.fstat(h["cfd"])
  try:cn=os.stat(h["cname"],dir_fd=h["dfd"],follow_symlinks=False)
  except FileNotFoundError:
   if co.st_nlink!=0:errors.append("copy missing while linked")
  else:
   if (cn.st_dev,cn.st_ino)!=(co.st_dev,co.st_ino):errors.append("copy cleanup identity")
   else:
    os.unlink(h["cname"],dir_fd=h["dfd"]);os.fsync(h["dfd"])
    if os.fstat(h["cfd"]).st_nlink!=0:errors.append("copy retained links")
 except OSError as exc:errors.append("copy unlink:"+str(exc))
 try:os.close(h["cfd"])
 except OSError as exc:errors.append("copy fd close:"+str(exc))
 try:
  dn=os.stat(h["dname"],dir_fd=h["tfd"],follow_symlinks=False);do=os.fstat(h["dfd"])
  if (dn.st_dev,dn.st_ino)!=(do.st_dev,do.st_ino):errors.append("copy dir cleanup identity")
  elif os.listdir(h["dfd"]):errors.append("copy dir cleanup entries")
  else:os.rmdir(h["dname"],dir_fd=h["tfd"])
 except OSError as exc:errors.append("copy dir remove:"+str(exc))
 try:os.close(h["dfd"])
 except OSError as exc:errors.append("copy dir fd close:"+str(exc))
 for x in reversed(h["tfds"]):
  try:os.close(x)
  except OSError as exc:errors.append("copy root fd close:"+str(exc))
 if os.path.lexists(h["cpath"]):errors.append("copy residue")
 if os.path.lexists(h["dpath"]):errors.append("copy dir residue")
 try:os.close(h["fd"])
 except OSError as exc:errors.append("source fd close:"+str(exc))
 for x in reversed(h["fds"]):
  try:os.close(x)
  except OSError as exc:errors.append("source ancestor close:"+str(exc))
 if errors:raise Stop("known-host cleanup failure:"+" | ".join(errors))
def remote_main(repo,origin):
