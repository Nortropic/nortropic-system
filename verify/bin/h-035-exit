class Rig(Exception):
    pass


def check(ok: bool, name: str, detail: str = "") -> None:
    global passed, failed
    if ok:
        passed += 1
        print(f"PASS {name}")
    else:
        failed += 1
        failed_labels.append((name, detail))
        print(f"FAIL {name}: {detail}")


def run(argv: list[str], *, cwd: Path = ROOT, env: dict[str, str] | None = None,
        stdin: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(argv, cwd=cwd, env=env, input=stdin, text=True,
                          capture_output=True, shell=False, timeout=45)


def parse_path(raw: object) -> tuple[str, bool]:
    if not isinstance(raw, str) or "\x00" in raw:
        raise ValueError("type/NUL")
    p = raw.replace("\\", "/")
    if not p or p.startswith("/") or re.match(r"^[A-Za-z]:", p):
        raise ValueError("absolute/drive/empty")
    if p.startswith("./") or p.endswith("/") or "//" in p:
        raise ValueError("separator")
    recursive = p.endswith("/**")
    core = p[:-3] if recursive else p
    if not core or any(x in ("", ".", "..") for x in core.split("/")):
        raise ValueError("segment")
    if any(c in core for c in "*?[]{}"):
        raise ValueError("unsupported glob")
    return core, recursive


def overlap(a: object, b: object) -> bool:
    ap, ax = parse_path(a); bp, bx = parse_path(b)
    return ((not ax and not bx and ap == bp)
            or (ax and (bp == ap or bp.startswith(ap + "/")))
            or (bx and (ap == bp or ap.startswith(bp + "/"))))


def strict_load(path: Path) -> object:
    def pairs(items: list[tuple[str, object]]) -> dict[str, object]:
        out: dict[str, object] = {}
        for k, v in items:
            if k in out:
                raise ValueError(f"duplicate key {k}")
            out[k] = v
        return out
    return json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=pairs)


