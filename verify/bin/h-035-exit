 db=sqlite3.connect(":memory:")
 try:
  db.execute("CREATE TABLE task_state (task TEXT PRIMARY KEY,status TEXT NOT NULL)")
  db.executemany("INSERT INTO task_state(task,status) VALUES(?,?)",sorted(table.items()));db.commit();return db.serialize()
 finally:db.close()
def db_table(raw):
