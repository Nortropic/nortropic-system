   or stat.S_IMODE(held.st_mode)!=0o600 or devino(held)!=devino(current)
   or current.st_nlink!=1 or stat.S_IMODE(current.st_mode)!=0o600):raise Stop("bound slot name identity")
  seen.append(devino(held))
 if sorted(seen)!=want:raise Stop("bound slot pair identity")
def fdbytes(fd,limit=8*1024*1024):
 size=os.fstat(fd).st_size
 if size>limit:raise Stop("bound leaf size")
 raw=b"";offset=0
 while offset<size:
  part=os.pread(fd,min(65536,size-offset),offset)
  if not part:raise Stop("short retained read")
  raw+=part;offset+=len(part)
 return raw
def fdwrite(fd,raw):
 os.ftruncate(fd,0);offset=0
 while offset<len(raw):
  wrote=os.pwrite(fd,raw[offset:],offset)
  if wrote<=0:raise Stop("short retained write")
  offset+=wrote
 os.fsync(fd)
 if fdbytes(fd)!=raw:raise Stop("retained write mismatch")
def fdappend(fd,raw):
 offset=os.fstat(fd).st_size;start=offset
 while offset-start<len(raw):
  wrote=os.pwrite(fd,raw[offset-start:],offset)
  if wrote<=0:raise Stop("short retained append")
  offset+=wrote
def renameat(rootfd,a,b,flags):
 if flags not in (RENAME_SWAP|RENAME_NOFOLLOW_ANY|RENAME_RESOLVE_BENEATH,RENAME_EXCL|RENAME_NOFOLLOW_ANY|RENAME_RESOLVE_BENEATH):raise Stop("renameatx flags")
 fn=getattr(ctypes.CDLL(None,use_errno=True),"renameatx_np",None)
 if fn is None:raise Stop("renameatx_np unavailable")
 fn.argtypes=[ctypes.c_int,ctypes.c_char_p,ctypes.c_int,ctypes.c_char_p,ctypes.c_uint];fn.restype=ctypes.c_int
 if fn(rootfd,os.fsencode(a),rootfd,os.fsencode(b),flags)!=0:raise OSError(ctypes.get_errno(),"renameatx_np")
