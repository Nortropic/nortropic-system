def workspace_open(path,create=False):
 path=Path(path)
 if not path.is_absolute() or Path(os.path.normpath(str(path)))!=path or str(path).startswith("//"):raise Stop("workspace path")
 flags=os.O_RDONLY|getattr(os,"O_DIRECTORY",0)|getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_CLOEXEC",0);fds=[];links=[];created=False;installed=False;tempname="";leaf=-1
 try:
  current=Path(path.anchor);fd=os.open(path.anchor,flags);fds.append(fd);root=os.fstat(fd)
  if not stat.S_ISDIR(root.st_mode):raise Stop("workspace root type")
  links.append((None,"",fd,(root.st_dev,root.st_ino,root.st_mode,root.st_uid),str(current)))
  for part in path.parts[1:-1]:
   before=os.stat(part,dir_fd=fd,follow_symlinks=False);child=os.open(part,flags,dir_fd=fd);opened=os.fstat(child);current/=part
   if not stat.S_ISDIR(opened.st_mode) or (before.st_dev,before.st_ino,before.st_mode,before.st_uid)!=(opened.st_dev,opened.st_ino,opened.st_mode,opened.st_uid):raise Stop("workspace ancestor open race")
   links.append((fd,part,child,(opened.st_dev,opened.st_ino,opened.st_mode,opened.st_uid),str(current)));fds.append(child);fd=child
  parent=os.fstat(fd)
  if parent.st_uid!=os.getuid() or stat.S_IMODE(parent.st_mode)!=0o700:raise Stop("workspace parent authority")
  name=path.name
  if create:
   prefix=".r15-owner-workspace-"+F(str(path).encode("utf-8"))+"-"
   if any(entry.startswith(prefix) for entry in os.listdir(fd)):raise Stop("workspace retained poison")
   try:os.stat(path.name,dir_fd=fd,follow_symlinks=False)
   except FileNotFoundError:pass
   else:raise Stop("workspace final already exists")
   for _ in range(128):
    candidate=prefix+secrets.token_hex(32)
    try:os.mkdir(candidate,0o700,dir_fd=fd);tempname=candidate;break
    except FileExistsError:continue
   if not tempname:raise Stop("workspace temp allocation")
   name=tempname
  before=os.stat(name,dir_fd=fd,follow_symlinks=False);leaf=os.open(name,flags,dir_fd=fd);opened=os.fstat(leaf);fds.append(leaf)
  if (not stat.S_ISDIR(opened.st_mode) or opened.st_uid!=os.getuid() or stat.S_IMODE(opened.st_mode)!=0o700
   or (before.st_dev,before.st_ino,before.st_mode,before.st_uid,before.st_nlink)!=(opened.st_dev,opened.st_ino,opened.st_mode,opened.st_uid,opened.st_nlink)
   or os.listdir(leaf)):raise Stop("workspace identity/emptiness")
  if create:
   named=os.stat(tempname,dir_fd=fd,follow_symlinks=False)
   if _full(named)!=_full(opened):raise Stop("workspace temp replacement")
   renameat(fd,tempname,path.name,RENAME_EXCL|RENAME_NOFOLLOW_ANY|RENAME_RESOLVE_BENEATH);installed=True;created=True
   named=os.stat(path.name,dir_fd=fd,follow_symlinks=False);after=os.fstat(leaf)
   if (devino(after)!=devino(opened) or _full(named)!=_full(after) or not stat.S_ISDIR(after.st_mode)
    or after.st_uid!=os.getuid() or stat.S_IMODE(after.st_mode)!=0o700 or after.st_nlink!=opened.st_nlink or os.listdir(leaf)):raise Indeterminate("INDETERMINATE_PRESERVED workspace publication replacement")
   opened=after
  identity=D({"record_type":"owner_workspace_v1","workspace_root":str(path),"ancestors":[[item[4],*item[3]] for item in links],"leaf":[opened.st_dev,opened.st_ino,opened.st_mode,opened.st_uid,opened.st_nlink]})
  return {"path":path,"fds":fds,"links":links,"parentfd":fd,"leaf":leaf,"leaf_identity":_full(opened),"identity":identity,"created":created}
 except Exception as problem:
  cleanup=(Indeterminate("INDETERMINATE_PRESERVED workspace object retained after publication failure: "+str(problem)) if installed or tempname else None)
  for descriptor in reversed(fds):
   try:os.close(descriptor)
   except OSError:pass
  if cleanup is not None:raise cleanup from problem
  raise
def workspace_revalidate(context):
 path=context["path"]
 for parentfd,name,fd,want,_spelling in context["links"]:
  held=os.fstat(fd)
  if (held.st_dev,held.st_ino,held.st_mode,held.st_uid)!=want:raise Stop("workspace ancestor held replacement")
  if parentfd is not None:
   named=os.stat(name,dir_fd=parentfd,follow_symlinks=False)
   if (named.st_dev,named.st_ino,named.st_mode,named.st_uid)!=want:raise Stop("workspace ancestor name replacement")
 held=os.fstat(context["leaf"]);named=os.stat(path.name,dir_fd=context["parentfd"],follow_symlinks=False)
 if _full(held)!=context["leaf_identity"] or _full(named)!=context["leaf_identity"] or os.listdir(context["leaf"]):raise Stop("workspace leaf replacement/nonempty")
 if D({"record_type":"owner_workspace_v1","workspace_root":str(path),"ancestors":[[item[4],*item[3]] for item in context["links"]],"leaf":[held.st_dev,held.st_ino,held.st_mode,held.st_uid,held.st_nlink]})!=context["identity"]:raise Stop("workspace identity drift")
def workspace_close(context,remove=False):
 try:
  workspace_revalidate(context)
  if remove:
   raise Indeterminate("INDETERMINATE_PRESERVED workspace retained because inode-CAS directory removal is unavailable")
 finally:
  for descriptor in reversed(context["fds"]):
   try:os.close(descriptor)
   except OSError:pass
def workspace_validate(path,want):
 context=workspace_open(Path(path))
 try:
  if not isinstance(want,str) or not HEX64.fullmatch(want) or context["identity"]!=want:raise Stop("workspace persisted identity")
  workspace_revalidate(context);return want
 finally:workspace_close(context)
