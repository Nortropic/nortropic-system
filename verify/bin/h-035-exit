        ==r15_expected_export_trace("attest_main",direct_finalizer_argv,
                                   stdin=direct_finalizer_stdin,result=0))
    try:
        direct_store=strict_json_bytes((attest/"attestations.json").read_bytes())
        direct_record=direct_store["attestations"][task]
        direct_ok=(direct_good.returncode==0 and direct_finalizer_export
                   and r15_json_equal(direct_record,expected_record)
                   and r15_owner_publication_valid(
                       direct_record,task=task,
                       repository_identity=str(context["repository_identity"]))[0]
                   and direct_positive_before==(
                       filesystem_snapshot(state),filesystem_snapshot(workspace),
                       r15_repository_authority_snapshot(repo,remote)))
    except (OSError,ValueError,KeyError,TypeError) as exc:
        direct_ok=False; direct_good=subprocess.CompletedProcess([],1,"",str(exc))
    record("DIRECT_FINALIZER_INDEPENDENT_VALIDATION_OBJECT_ORDER_INSENSITIVE_POSITIVE",
           direct_ok,direct_good.stderr)
    reset_store(preissue_store)

    # A crashed finalizer is the one public mutation whose exact authority
    # replay must be able to finish its durable PENDING pair.  Build both
    # manifest-admitted slot orientations independently from the canonical
    # request/operation domains; every different request remains byte-exactly
    # blocked and the outer authority accepts only one appended COMMITTED row.
    def install_finalizer_pending(active_new: bool) -> tuple[bytes,bytes,bytes,dict[str,object]]:
        reset_store(preissue_store)
        old=(attest/"attestations.json").read_bytes();value=strict_json_bytes(old)
        if not isinstance(value,dict):raise Rig("R15 pending finalizer store")
        value["attestations"][task]=expected_record
        value["omtest_ko"]=[item for item in value["omtest_ko"] if item!=task]
        new=canonical_json_bytes(value)+b"\n"
        recovery_path=attest/".r15-attest-recovery.jsonl"
        recovery=recovery_path.read_bytes();lines=recovery.splitlines(keepends=True)
        sequence=len(lines)+1
        if sequence%2!=1:raise Rig("R15 pending finalizer sequence")
        manifest_raw=(attest/"bootstrap-manifest.json").read_bytes()
        manifest=strict_json_bytes(manifest_raw)
        if not isinstance(manifest,dict):raise Rig("R15 pending finalizer manifest")
        request={"record_type":"h035_r15_attest_request_v1",
                 "command":"finalize-owner-publication","argv":[],"stdin":direct_request}
        request_sha=canonical_json_sha256(request)
        old_sha=hashlib.sha256(old).hexdigest();new_sha=hashlib.sha256(new).hexdigest()
        manifest_sha=hashlib.sha256(manifest_raw).hexdigest()
        operation={
            "record_type":"h035_r15_attest_operation_v1",
            "command":"finalize-owner-publication","task":task,
            "request_sha256":request_sha,"manifest_sha256":manifest_sha,
            "attest_root_dev_ino":manifest["attest_root_dev_ino"],
            "attest_manifest_dev_ino":manifest["attest_manifest_dev_ino"],
            "attest_lock_dev_ino":manifest["attest_lock_dev_ino"],
            "attestation_store_slot_dev_inos":manifest["attestation_store_slot_dev_inos"],
            "attest_recovery_log_dev_ino":manifest["attest_recovery_log_dev_ino"],
            "pending_sequence":sequence,"old_store_sha256":old_sha,
            "new_store_sha256":new_sha,
        }
        pending={
            "record_type":"h035_r15_attest_recovery_v1","schema_version":1,
            "sequence":sequence,"phase":"PENDING",
            "command":"finalize-owner-publication","task":task,
            "manifest_sha256":manifest_sha,
            "operation_identity":canonical_json_sha256(operation),
            "request_sha256":request_sha,"old_store_sha256":old_sha,
            "new_store_sha256":new_sha,
            "previous_record_sha256":hashlib.sha256(lines[-1]).hexdigest()
                if lines else hashlib.sha256(b"").hexdigest(),
        }
        recovery_path.write_bytes(recovery+canonical_json_bytes(pending)+b"\n")
        (attest/"attestations.json").write_bytes(new if active_new else old)
        (attest/".r15-attest-shadow").write_bytes(old if active_new else new)
        return old,new,recovery,pending
    pending_results=[]
    for active_new in (False,True):
        old,new,recovery_prefix,_pending=install_finalizer_pending(active_new)
        pending_snapshot=tuple((attest/name).read_bytes() for name in (
            "attestations.json",".r15-attest-shadow",".r15-attest-recovery.jsonl"))
