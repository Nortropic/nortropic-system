  or devino(bh)!=context["manifest"]["bundle_root_dev_ino"] or devino(sh)!=context["manifest"]["state_root_dev_ino"] or devino(ah)!=context["manifest"]["attest_root_dev_ino"]
  or any(not stat.S_ISDIR(x.st_mode) or x.st_uid!=os.getuid() or stat.S_IMODE(x.st_mode)!=0o700 for x in (bh,sh,ah))):raise Stop("retained bundle/root replacement")
