def r15_gate_repin_manifest(base_raw: bytes, candidate_raw: bytes,
                            manifest: dict[str,object]) -> dict[str,object]:
    value=json.loads(json.dumps(manifest))
    base=ast.parse(base_raw.decode("utf-8",errors="strict"),mode="exec")
    candidate=ast.parse(candidate_raw.decode("utf-8",errors="strict"),mode="exec")
    base_defs={node.name:node for node in base.body
               if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
    candidate_defs={node.name:node for node in candidate.body
                    if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
    for name in H035_R15_GATE_ALTERED_DEFINITIONS:
        if name in candidate_defs:
            value["reviewed_islands"].setdefault(name,{})
            value["reviewed_islands"][name]["candidate_ast_sha256"]=r15_ast_sha256(
                candidate_defs[name])
            value["reviewed_islands"][name]["normalized_base_ast_sha256"]=r15_ast_sha256(
                base_defs[name])
    floor=candidate_defs.get("r15_historical_regression_floor")
    if floor is not None: value["historical_floor"]["ast_sha256"]=r15_ast_sha256(floor)
    new,layout=r15_gate_top_level_projection(base,candidate)
    value["admitted_new_top_level"]=new
    value["top_level_layout_sha256"]=hashlib.sha256(json.dumps(
        layout,separators=(",",":")).encode("utf-8")).hexdigest()
    return value


def r15_gate_inheritance_selftests() -> None:
    base_raw=r15_git_object_bytes(ROOT,H035_R15_BASE,"verify/bin/h-035-exit")
    candidate_raw=Path(__file__).read_bytes()
    spec=strict_json_bytes(SPEC.read_bytes())
    rows=[row for row in spec.get("tasks",[]) if isinstance(row,dict)
          and row.get("id")=="h-035"] if isinstance(spec,dict) else []
    contract=rows[0].get("r15_owner_product_lifecycle") if len(rows)==1 else None
    manifest=contract.get("gate_inheritance_scope") if isinstance(contract,dict) else None
    if base_raw is None or not isinstance(manifest,dict):
        check(False,"J_R15_GATE_INHERITANCE_EXACT_BASE_AND_CURRENT_POSITIVE","manifest")
        return
    positive,positive_why=r15_gate_inheritance_bytes(base_raw,candidate_raw,manifest)
    check(positive,"J_R15_GATE_INHERITANCE_EXACT_BASE_AND_CURRENT_POSITIVE",positive_why)
    renderer_guards=[]
    for name in ("RENDERER_WRONG_LITERAL","RENDERER_DUPLICATE","RENDERER_MOVED",
                 "RENDERER_MULTIPLE_LINE"):
        try: r15_gate_mutant_source(candidate_raw,name)
        except Rig: renderer_guards.append(name)
    check(len(renderer_guards)==4,"J_R15_GATE_MUTANT_RENDERER_PIN_CARDINALITY_LITERAL_INDEX_GUARDS")
    canonical_pin=(f'H035_R15_CONTRACT_SHA256 = "{H035_R15_CONTRACT_SHA256}"').encode()
    adjacent_pin=(f'H035_R15_CONTRACT_SHA256 = "{H035_R15_CONTRACT_SHA256[:32]}" '
                  f'"{H035_R15_CONTRACT_SHA256[32:]}"').encode()
    escaped_pin=(f'H035_R15_CONTRACT_SHA256 = "\\x{ord(H035_R15_CONTRACT_SHA256[0]):02x}'
                 f'{H035_R15_CONTRACT_SHA256[1:]}"').encode()
    nfkc_pin=(f'Ｈ035_R15_CONTRACT_SHA256 = "{H035_R15_CONTRACT_SHA256}"').encode()
    lexical_mutants=[candidate_raw.replace(canonical_pin,value,1)
                     for value in (adjacent_pin,escaped_pin,nfkc_pin)]
    check(all(r15_gate_inheritance_bytes(base_raw,value,
              r15_gate_repin_manifest(base_raw,value,manifest))[0] is False
              for value in lexical_mutants),
          "J_R15_GATE_INHERITANCE_CONTRACT_DIGEST_SINGLE_CANONICAL_STRING_TOKEN_REJECT")
    encoding_mutant=candidate_raw.replace(b"\n",b"\n# coding: latin-1\n",1)
    encoding_manifest=r15_gate_repin_manifest(base_raw,encoding_mutant,manifest)
    check(r15_gate_inheritance_bytes(base_raw,encoding_mutant,encoding_manifest)==
          (False,"exact UTF-8 Python source preamble"),
          "J_R15_GATE_INHERITANCE_PEP263_ENCODING_DIFFERENTIAL_REJECT")
    base_identity=r15_gate_import_callable_identity(base_raw,"path_selftests")
    candidate_identity=r15_gate_import_callable_identity(candidate_raw,"path_selftests")
    check(base_identity==candidate_identity and base_identity!="NOT_CALLABLE",
          "J_R15_GATE_INHERITANCE_IMPORT_PRESERVES_INHERITED_CALLABLE_IDENTITY")
    fresh_shadow=ast.parse(
        "def probe():\n path_selftests={}\n path_selftests['ok']=True",mode="exec").body[0]
    fresh_exec=ast.parse(
        "def probe():\n namespace={}\n exec(compile('x=1','<x>','exec'),namespace,namespace)",
        mode="exec").body[0]
    sibling_shadow=ast.parse(
        "def probe():\n def a():\n  value=subprocess\n def b():\n  value={}\n  value['safe']=1",
        mode="exec").body[0]
    fresh_comprehension=ast.parse(
        "def probe():\n values=[item for item in [1,2,3]]\n values.append(4)",
        mode="exec").body[0]
    fresh_parameter_shadow=ast.parse(
        "def probe(subprocess):\n subprocess={}\n subprocess['safe']=1",
        mode="exec").body[0]
    fresh_compile_shadow=ast.parse(
        "def probe():\n compile=lambda value:value\n result=compile('safe')",
        mode="exec").body[0]
    readonly_vars=ast.parse(
        "def probe(module):\n count=len(vars(module))",
        mode="exec").body[0]
    check(r15_gate_closed_mutation_family(fresh_shadow,{"path_selftests"})[0],
          "J_R15_GATE_INHERITANCE_FRESH_LOCAL_SHADOW_MUTATION_POSITIVE")
    check(not r15_gate_closed_mutation_family(fresh_exec,{"path_selftests"})[0],
          "J_R15_GATE_INHERITANCE_ONLY_EXACT_IMPORT_ORACLE_EXEC_ADMITTED")
    check(r15_gate_closed_mutation_family(sibling_shadow,{"subprocess"})[0],
          "J_R15_GATE_INHERITANCE_LEXICAL_SIBLING_SHADOW_POSITIVE")
    check(r15_gate_closed_mutation_family(fresh_comprehension,{"subprocess"})[0],
          "J_R15_GATE_INHERITANCE_FRESH_DATA_COMPREHENSION_POSITIVE")
    check(r15_gate_closed_mutation_family(fresh_parameter_shadow,{"subprocess"})[0],
          "J_R15_GATE_INHERITANCE_FRESH_PARAMETER_SHADOW_POSITIVE")
    check(r15_gate_closed_mutation_family(fresh_compile_shadow,{"compile"})[0],
          "J_R15_GATE_INHERITANCE_LOCAL_COMPILE_SHADOW_POSITIVE")
    check(r15_gate_closed_mutation_family(readonly_vars,{"module"})[0],
          "J_R15_GATE_INHERITANCE_READONLY_VARS_LENGTH_POSITIVE")
    base_tree=ast.parse(base_raw.decode("utf-8",errors="strict"),mode="exec")
    candidate_tree=ast.parse(candidate_raw.decode("utf-8",errors="strict"),mode="exec")
    base_defs=[node for node in base_tree.body
               if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))]
    candidate_defs=[node for node in candidate_tree.body
                    if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))]
    unchanged=[node for node in base_defs if node.name not in H035_R15_GATE_ALTERED_DEFINITIONS]
    inherited_candidate_defs=[node for node in candidate_defs
                              if node.name in {value.name for value in base_defs}]
    exhaustive=[]
    for index,base_node in enumerate(unchanged):
        position=next(i for i,node in enumerate(inherited_candidate_defs)
                      if node.name==base_node.name)
        deleted=inherited_candidate_defs[:position]+inherited_candidate_defs[position+1:]
        duplicated=inherited_candidate_defs[:position+1]+[
            copy.deepcopy(inherited_candidate_defs[position])]+inherited_candidate_defs[position+1:]
        altered=copy.deepcopy(inherited_candidate_defs); altered_node=altered[position]
        altered_node.body.append(ast.Pass())
        peer=unchanged[(index+1)%len(unchanged)]
        peer_position=next(i for i,node in enumerate(inherited_candidate_defs)
                           if node.name==peer.name)
        reordered=copy.deepcopy(inherited_candidate_defs)
        reordered[position],reordered[peer_position]=reordered[peer_position],reordered[position]
        exhaustive.extend((
            r15_gate_definition_inheritance(base_defs,deleted),
            r15_gate_definition_inheritance(base_defs,duplicated),
            r15_gate_definition_inheritance(base_defs,altered),
            r15_gate_definition_inheritance(base_defs,reordered)))
    check(len(exhaustive)==212 and all(not result[0] for result in exhaustive),
          "J_R15_GATE_INHERITANCE_ALL_53_DELETE_DUPLICATE_ALTER_REORDER_REJECT")
    cases={
        "PRIOR_FLOOR_RETURN_NONE":"historical floor direct ordered calls only",
