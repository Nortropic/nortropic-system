 for rootfd,name,want in fixed:
  member=os.stat(name,dir_fd=rootfd,follow_symlinks=False)
  if not stat.S_ISREG(member.st_mode) or member.st_uid!=os.getuid() or member.st_nlink!=1 or stat.S_IMODE(member.st_mode)!=0o600 or devino(member)!=want:raise Stop("retained fixed-leaf identity")
 for rootfd,names,want in ((context["statefd"],(DB,DBSHADOW),ma["state_db_slot_dev_inos"]),(context["attestfd"],(STORE,ASHADOW),ma["attestation_store_slot_dev_inos"])):
  members=[os.stat(name,dir_fd=rootfd,follow_symlinks=False) for name in names]
  if sorted(devino(member) for member in members)!=want or any(not stat.S_ISREG(member.st_mode) or member.st_uid!=os.getuid() or member.st_nlink!=1 or stat.S_IMODE(member.st_mode)!=0o600 for member in members):raise Stop("retained slot-pair identity")
