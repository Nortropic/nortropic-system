    mutant=clone(); mutant["operational_matrix"]["list_entry_rejection_effects"]="REASON_ONLY"; scope_mutants.append(mutant)
    for key in ("member_one_defect_count", "additional_membership_hostile_count",
                "version_type_cross_count", "non_owner_semantic_defect_count"):
        mutant=clone(); mutant["operational_matrix"][key] += 1; scope_mutants.append(mutant)
    mutant=clone(); mutant["preproduct_evidence"]["expected_failure_signature"].pop(); scope_mutants.append(mutant)
    check(all(not exact_value(mutant,H035_R14_TWO_STATE_REGISTRY) for mutant in scope_mutants),
          "J_R14_TEST_AUTHOR_BUILDER_AND_REGISTRY_OWNER_SCOPE_REJECT")
