R15_REFERENCE_MAIN_ANCHOR = (
    '\nif __name__ == "__main__":\n'
    '    sys.exit(main(sys.argv))\n'
)


def r15_reference_insert(base: str, injected: str, label: str,
                         main_argument: str = "sys.argv") -> str:
    """One exact additive transform; published legacy code remains byte-for-byte."""
    anchor=(f'\nif __name__ == "__main__":\n'
            f'    sys.exit(main({main_argument}))\n')
    if base.count(anchor) != 1:
        raise Rig(f"R15 {label} legacy main anchor cardinality")
    return base.replace(
        anchor,
        "\n" + injected.rstrip() + anchor,
        1)


def r15_reference_sources(repo: Path, contract_merge: str) -> tuple[str,str,str]:
    base_sources=[]
    for relative in H035_R15_PRODUCT_PATHS:
        raw=r15_git_object_bytes(repo,contract_merge,relative)
        if raw is None:
            raise Rig("R15 reference legacy blob missing: "+relative)
        try: base_sources.append(raw.decode("utf-8",errors="strict"))
        except UnicodeDecodeError as exc: raise Rig("R15 reference legacy UTF-8") from exc

    contract_commit=r15_git(repo,"cat-file","-p",contract_merge)
    contract_parents=[line.split(" ",1)[1]
                      for line in contract_commit.stdout.splitlines()
                      if line.startswith("parent ")]
    contract_tree_result=r15_git(repo,"rev-parse",f"{contract_merge}^{{tree}}")
    if contract_commit.returncode or contract_tree_result.returncode:
        raise Rig("R15 reference bound contract identity")
    bound_authority=contract_parents[0] if len(contract_parents)==2 else "0"*40
    bound_candidate=contract_parents[1] if len(contract_parents)==2 else "0"*40
    candidate_tree_result=r15_git(repo,"rev-parse",f"{bound_candidate}^{{tree}}")
    bound_candidate_tree=(candidate_tree_result.stdout.strip()
                          if not candidate_tree_result.returncode else "0"*40)
    contract_spec=strict_json_bytes(
        r15_git_object_bytes(repo,contract_merge,"specs/tasks.spec.json") or b"")
    contract_rows=[row for row in contract_spec.get("tasks",[])
                   if isinstance(row,dict) and row.get("id")=="h-035"]
    contract_manifest=(contract_rows[0].get("r15_owner_product_lifecycle")
                       if len(contract_rows)==1 else None)
    bound_manifest=(canonical_json_sha256(contract_manifest)
                    if isinstance(contract_manifest,dict) else "0"*64)
    contract_gate=r15_git_object_bytes(repo,contract_merge,"verify/bin/h-035-exit")
    if contract_gate is None: raise Rig("R15 reference bound contract gate")
    bound_contract={
        "authority_base_sha":bound_authority,
        "candidate_sha":bound_candidate,
        "candidate_tree":bound_candidate_tree,
        "contract_tree":contract_tree_result.stdout.strip(),
        "gate_sha256":hashlib.sha256(contract_gate).hexdigest(),
        "manifest_sha256":bound_manifest,"merge_sha":contract_merge,
    }
    engine=R15_REFERENCE_ATTEST_SOURCE
    bound_token="<R15_BOUND_CONTRACT_V1>"
    if engine.count(bound_token)!=1:
        raise Rig("R15 reference bound contract token cardinality")
