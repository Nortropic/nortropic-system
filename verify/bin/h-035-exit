    mutant=clone();mutant["product_acceptance"]["source_capability_oracle"]="NEGATIVE_BLACKLIST";mutants.append(mutant)
    mutant=clone();mutant["product_acceptance"]["source_islands"]["changed_function_bodies"]="OPEN_ISLAND";mutants.append(mutant)
    mutant=clone();mutant["product_acceptance"]["interpreter_sensitive_preamble"]["controller/authority/cli"][0]="#!/usr/bin/env -S python3.12 -c\n";mutants.append(mutant)
