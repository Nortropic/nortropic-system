          "J_R14_SERIAL_HARD_STOP_FORBIDDEN_FAIL_CLOSED_REJECT")


def r33_owner_decision_split(raw: bytes) -> tuple[bytes,bytes] | None:
    if (raw.count(R33_OWNER_DECISION_BEGIN)!=1
            or raw.count(R33_OWNER_DECISION_END)!=1):
        return None
    prefix,tail=raw.split(R33_OWNER_DECISION_BEGIN,1)
    body,trailing=tail.split(R33_OWNER_DECISION_END,1)
    if trailing or hashlib.sha256(body).hexdigest()!=R33_OWNER_DECISION_BODY_SHA256:
        return None
    return prefix,body


