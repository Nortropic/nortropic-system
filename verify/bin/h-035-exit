                                "invalidated_shas":["nested"]}},"omtest_ko":[]})+b"\n"
    (attest/"attestations.json").write_bytes(wrong_context_store)
    context_write=r15_cli(repo,"controller/attest/cli",str(attest),"write",
                          "dispatch-context-second","3"*40)
    context_select=r15_cli(repo,"controller/taskval/cli","select",str(legacy_spec),str(attest),str(state))
    context_request=legacy_request(state,tmp/"dispatch-wrong-context-workspace")
    context_check=r15_cli(repo,"controller/authority/cli","check-candidate",
                          stdin=json.dumps(context_request,sort_keys=True,separators=(",",":")))
    try:context_check_value=strict_json_bytes(context_check.stdout.encode())
    except (ValueError,UnicodeError):context_check_value={}
    collision_results.append(context_write.returncode==0 and context_select.returncode==0
                             and context_select.stdout=="dispatch-owner\n"
                             and context_check.returncode==0
                             and isinstance(context_check_value,dict)
                             and context_check_value.get("accepted") is True)
    root,state,attest=new_legacy_roots("legacy-spec-token-collision")
    token_spec_value=strict_json_bytes(legacy_spec.read_bytes())
    if not isinstance(token_spec_value,dict):raise Rig("R15 dispatch legacy token spec")
    token_spec_value["note"]="h035_r15_published_authority"
    token_spec=tmp/"dispatch-legacy-token-spec.json"
    token_spec.write_bytes(canonical_json_bytes(token_spec_value)+b"\n")
    selected=r15_cli(repo,"controller/taskval/cli","select",str(token_spec),str(attest),str(state))
    collision_results.append(selected.returncode==0 and selected.stdout=="dispatch-owner\n")
    member_spec_value=strict_json_bytes(legacy_spec.read_bytes())
    if not isinstance(member_spec_value,dict) or not isinstance(member_spec_value.get("tasks"),list):
        raise Rig("R15 dispatch legacy member spec")
    member_spec_value["tasks"][0]["h035_r15_published_authority"]={"record_type":"unrelated"}
    member_spec=tmp/"dispatch-legacy-wrong-row-member-spec.json"
    member_spec.write_bytes(canonical_json_bytes(member_spec_value)+b"\n")
    member_selected=r15_cli(repo,"controller/taskval/cli","select",str(member_spec),str(attest),str(state))
    collision_results.append(member_selected.returncode==0
                             and member_selected.stdout=="dispatch-owner\n")
    record("DISPATCH_LEGACY_EVENT_DB_TASK_GRIND_AND_WRONG_CONTEXT_TOKENS_STAY_LEGACY",
           all(collision_results),repr(collision_results))

    # Reserved request keys are disjoint by exact schema.  Any malformed value
    # still routes to R15, then fails exact validation; it never falls legacy.
    marker_results=[]
    for label,marker in (
        ("WRONG_RECORD",{"record_type":"wrong","schema_version":1}),
        ("BOOL_VERSION",{"record_type":"h035_r15_authority_request_v1","schema_version":True}),
        ("FLOAT_VERSION",{"record_type":"h035_r15_authority_request_v1","schema_version":1.0}),
        ("EXTRA_KEY",{"record_type":"h035_r15_authority_request_v1","schema_version":1,"extra":None}),
    ):
        root,state,attest=new_legacy_roots("malformed-request-marker-"+label.lower())
        request=legacy_request(state,tmp/("dispatch-malformed-marker-workspace-"+label.lower()))
        request["h035_r15_request"]=marker;before=filesystem_snapshot(root)
        trace=tmp/("dispatch-trace-authority-marker-"+label.lower()+".jsonl")
        stdin_value=json.dumps(request,sort_keys=True,separators=(",",":"))
        malformed=r15_cli_runpy_fault(
            repo,"controller/authority/cli",["check-candidate"],
            stdin=stdin_value,
            fault="trace_runtime_exports",target=trace)
        traced=(trace_rows(trace)==r15_expected_export_trace(
            "authority_value",["check-candidate"],stdin=stdin_value,result=1,
            request=request))
        discriminator_trace_results.append(traced)
        marker_results.append(malformed.returncode!=0 and traced
                              and filesystem_snapshot(root)==before)
    record("DISPATCH_AUTHORITY_MALFORMED_BOOL_FLOAT_EXTRA_RESERVED_REQUEST_REJECT_UNCHANGED",
           all(marker_results),repr(marker_results))

    taskval_partial_results=[]
    partial_specs={
        "MALFORMED_BINDING":canonical_json_bytes({
            "spec_version":"2.0.0","tasks":[{
                "id":"h-038","authority_class":"owner_authority","allowed_write":[],
                "owner_author_allowed_write":["controller/h034-native/**"],
                "docs_impact":[],"depends_on":[],"exit_test":"verify/bin/h-035-exit",
                "h035_r15_published_authority":{"record_type":"wrong"}}]})+b"\n",
        "DUPLICATE_BINDING":(b'{"spec_version":"2.0.0","tasks":[{"id":"h-038",'
                             b'"authority_class":"owner_authority","allowed_write":[],'
                             b'"owner_author_allowed_write":["controller/h034-native/**"],'
                             b'"docs_impact":[],"depends_on":[],"exit_test":"verify/bin/h-035-exit",'
                             b'"h035_r15_published_authority":{},'
                             b'"h035_r15_published_authority":null}]}\n'),
    }
    for label,raw in partial_specs.items():
        root,state,attest=new_legacy_roots("taskval-partial-"+label.lower())
        partial_spec=tmp/("dispatch-taskval-partial-"+label.lower()+".json")
        partial_spec.write_bytes(raw);before=filesystem_snapshot(root)
        trace=tmp/("dispatch-trace-taskval-partial-"+label.lower()+".jsonl")
        taskval_argv=["select",str(partial_spec),str(attest),str(state)]
        result=r15_cli_runpy_fault(
            repo,"controller/taskval/cli",taskval_argv,
            stdin=None,fault="trace_runtime_exports",target=trace)
        traced=(trace_rows(trace)==r15_expected_export_trace(
            "taskval_main",taskval_argv,stdin=None,result=1))
        discriminator_trace_results.append(traced)
        taskval_partial_results.append(result.returncode!=0
                                       and traced
                                       and result.stdout!="dispatch-owner\n"
                                       and filesystem_snapshot(root)==before)
    record("DISPATCH_TASKVAL_STRUCTURAL_MALFORMED_AND_DUPLICATE_BINDING_R15_REJECT",
           all(taskval_partial_results),repr(taskval_partial_results))
    record("DISPATCH_ALL_RESERVED_DISCRIMINATOR_REJECTIONS_ENGINE_ONCE_LEGACY_ZERO",
           all(early_discriminator_trace_results)
           and all(discriminator_trace_results),
           repr(early_discriminator_trace_results)+" | "+repr(discriminator_trace_results))

    r15_trace_results=[]
    marker_only={"h035_r15_request":dict(R15_AUTHORITY_REQUEST_MARKER)}
    for command in ("owner-author","check-candidate","record-review","owner-freeze",
                    "record-publication"):
        trace=tmp/("dispatch-r15-authority-"+command+".jsonl")
        stdin_value=json.dumps(marker_only,sort_keys=True,separators=(",",":"))
        result=r15_cli_runpy_fault(repo,"controller/authority/cli",[command],
            stdin=stdin_value,
            fault="trace_runtime_exports",target=trace)
        r15_trace_results.append(trace_rows(trace)==r15_expected_export_trace(
            "authority_value",[command],stdin=stdin_value,result=1,
            request=marker_only))
    record("DISPATCH_RESERVED_AUTHORITY_COMMAND_SURFACE_ENGINE_EXACT_CALL_AND_OUTCOME",
           all(r15_trace_results),repr(r15_trace_results))
    record("DISPATCH_MARKERLESS_LEGACY_AUTHORITY_TASKVAL_FROZEN_CALLABLES_EXACT",
           context.get("dispatch_legacy_authority_taskval_trace_ok") is True,
           repr(context.get("dispatch_legacy_authority_taskval_trace_ok")))

    # A reserved leaf published only after the first classification must be
    # observed by the second classification and prevent legacy fallthrough.
    swap_results=[]
    root,state,attest=new_legacy_roots("swap-authority")
    swap_workspace=tmp/"dispatch-swap-authority-workspace"
    request=legacy_request(state,swap_workspace);swap_target=state/".r15-owner.lock"
    swap_parent=os.lstat(swap_target.parent)
    swap_absent=not swap_target.exists() and not swap_target.is_symlink()
    swap_boundary=selector_boundary(root,swap_target);swap_workspace_before=filesystem_snapshot(swap_workspace)
    result=r15_cli_runpy_fault(repo,"controller/authority/cli",["check-candidate"],
        stdin=json.dumps(request,sort_keys=True,separators=(",",":")),
        fault="selector_reserved_after_first",target=swap_target,route_audit=True)
    swap_created=os.lstat(swap_target)
    swap_results.append(swap_absent and r15_fault_answer(result,"R15 authority appeared after legacy selection")
                        and r15_fault_event_exact(result,"selector_reserved_after_first",
                                                  "selector_reserved_publish",
                                                  {"parent":[state.stat().st_dev,state.stat().st_ino],
                                                  "created":[swap_created.st_dev,swap_created.st_ino]},[])
                        and stat.S_ISREG(swap_created.st_mode)
                        and stat.S_IMODE(swap_created.st_mode)==0o600
                        and swap_created.st_uid==os.getuid() and swap_created.st_gid==swap_parent.st_gid
                        and swap_created.st_nlink==1 and swap_created.st_size==0
                        and swap_target.read_bytes()==b""
                        and not (state/"current.json").exists()
                        and selector_boundary(root,swap_target)==swap_boundary
                        and filesystem_snapshot(swap_workspace)==swap_workspace_before)
    root,state,attest=new_legacy_roots("swap-taskval")
    event_before=(state/"events.jsonl").read_bytes();swap_target=state/".r15-owner.lock"
    swap_parent=os.lstat(swap_target.parent)
    swap_absent=not swap_target.exists() and not swap_target.is_symlink()
    swap_boundary=selector_boundary(root,swap_target)
    result=r15_cli_runpy_fault(repo,"controller/taskval/cli",
        ["select",str(legacy_spec),str(attest),str(state)],stdin=None,
        fault="selector_reserved_after_first",target=swap_target,route_audit=True)
    swap_created=os.lstat(swap_target)
    swap_results.append(swap_absent and r15_fault_error(result,"R15 taskval appeared after legacy selection")
                        and r15_fault_event_exact(result,"selector_reserved_after_first",
                                                  "selector_reserved_publish",
                                                  {"parent":[state.stat().st_dev,state.stat().st_ino],
                                                  "created":[swap_created.st_dev,swap_created.st_ino]},[])
                        and stat.S_ISREG(swap_created.st_mode)
                        and stat.S_IMODE(swap_created.st_mode)==0o600
                        and swap_created.st_uid==os.getuid() and swap_created.st_gid==swap_parent.st_gid
                        and swap_created.st_nlink==1 and swap_created.st_size==0
                        and swap_target.read_bytes()==b""
                        and (state/"events.jsonl").read_bytes()==event_before
                        and selector_boundary(root,swap_target)==swap_boundary)
    root,state,attest=new_legacy_roots("swap-attest")
    swap_target=attest/".r15-attest.lock";swap_absent=not swap_target.exists() and not swap_target.is_symlink()
    swap_parent=os.lstat(swap_target.parent)
    swap_boundary=selector_boundary(root,swap_target)
    result=r15_cli_runpy_fault(repo,"controller/attest/cli",
        [str(attest),"write","dispatch-ordinary","d"*40],stdin=None,
        fault="selector_reserved_after_first",target=swap_target,route_audit=True)
    swap_created=os.lstat(swap_target)
    swap_results.append(swap_absent and r15_fault_error(result,"R15 attest appeared after legacy selection")
                        and r15_fault_event_exact(result,"selector_reserved_after_first",
                                                  "selector_reserved_publish",
                                                  {"parent":[attest.stat().st_dev,attest.stat().st_ino],
                                                  "created":[swap_created.st_dev,swap_created.st_ino]},[])
                        and stat.S_ISREG(swap_created.st_mode)
                        and stat.S_IMODE(swap_created.st_mode)==0o600
                        and swap_created.st_uid==os.getuid() and swap_created.st_gid==swap_parent.st_gid
                        and swap_created.st_nlink==1 and swap_created.st_size==0
                        and swap_target.read_bytes()==b""
                        and not (attest/"attestations.json").exists()
                        and selector_boundary(root,swap_target)==swap_boundary)
    record("DISPATCH_ALL_WRAPPERS_RESERVED_RESIDUE_APPEARS_AFTER_FIRST_SELECTION_REJECT",
           all(swap_results),repr(swap_results))

    # Structural evidence can appear without any reserved filename.  The
    # second stable classifier must read it too; checking only fixed residue
    # names would let these swaps fall through to legacy.
    structural_swap_results=[];legacy_store=canonical_json_bytes({"attestations":{},"omtest_ko":[]})+b"\n"
    root,state,attest=new_legacy_roots("swap-structural-authority")
    target=attest/"attestations.json";target.write_bytes(legacy_store);target.chmod(0o600)
    structural_original=r15_leaf_state(target)
    structural_workspace=tmp/"dispatch-swap-structural-authority-workspace"
    request=legacy_request(state,structural_workspace)
    structural_identity=os.lstat(target);structural_boundary=selector_boundary(root,target,Path(str(target)+".r15-before"));structural_workspace_before=filesystem_snapshot(structural_workspace)
    result=r15_cli_runpy_fault(repo,"controller/authority/cli",["check-candidate"],
        stdin=json.dumps(request,sort_keys=True,separators=(",",":")),
        fault="selector_structural_after_first",target=target,
        replacement=semantic_stores["SCHEMA_ONLY"],route_audit=True)
    structural_swap_results.append(r15_fault_answer(result,"R15 authority appeared after legacy selection")
                                   and r15_fault_event_exact(result,"selector_structural_after_first",
                                       "selector_structural_replace",
                                       [structural_identity.st_dev,structural_identity.st_ino],[])
                                   and target.read_bytes()==semantic_stores["SCHEMA_ONLY"]
                                   and exact_replaced_leaf(target,Path(str(target)+".r15-before"),
                                                           structural_original,semantic_stores["SCHEMA_ONLY"])
                                   and selector_boundary(root,target,Path(str(target)+".r15-before"))==structural_boundary
                                   and filesystem_snapshot(structural_workspace)==structural_workspace_before)
    root,state,attest=new_legacy_roots("swap-structural-attest")
    target=attest/"attestations.json";target.write_bytes(legacy_store);target.chmod(0o600)
    structural_original=r15_leaf_state(target)
    structural_identity=os.lstat(target);structural_boundary=selector_boundary(root,target,Path(str(target)+".r15-before"))
    result=r15_cli_runpy_fault(repo,"controller/attest/cli",
        [str(attest),"write","dispatch-ordinary","2"*40],stdin=None,
        fault="selector_structural_after_first",target=target,
        replacement=semantic_stores["OWNER_ONLY"],route_audit=True)
    structural_swap_results.append(r15_fault_error(
        result,"R15 attest appeared after legacy selection")
        and r15_fault_event_exact(result,"selector_structural_after_first",
                                  "selector_structural_replace",
                                  [structural_identity.st_dev,structural_identity.st_ino],[])
        and target.read_bytes()==semantic_stores["OWNER_ONLY"]
        and exact_replaced_leaf(target,Path(str(target)+".r15-before"),
                                structural_original,semantic_stores["OWNER_ONLY"])
        and selector_boundary(root,target,Path(str(target)+".r15-before"))==structural_boundary)
    root,state,attest=new_legacy_roots("swap-structural-taskval")
    target=tmp/"dispatch-swap-structural-spec.json";target.write_bytes(legacy_spec.read_bytes());target.chmod(0o600)
    structural_original=r15_leaf_state(target)
    structural_identity=os.lstat(target);structural_boundary=selector_boundary(root)
    structural_external=external_boundary(target,Path(str(target)+".r15-before"))
    result=r15_cli_runpy_fault(repo,"controller/taskval/cli",
        ["select",str(target),str(attest),str(state)],stdin=None,
        fault="selector_structural_after_first",target=target,
        replacement=partial_specs["MALFORMED_BINDING"],route_audit=True)
    structural_swap_results.append(r15_fault_error(result,"R15 selector open race")
                                   and r15_fault_event_exact(result,"selector_structural_after_first",
                                       "selector_structural_replace",
                                       [structural_identity.st_dev,structural_identity.st_ino],[])
                                   and target.read_bytes()==partial_specs["MALFORMED_BINDING"]
                                   and exact_replaced_leaf(target,Path(str(target)+".r15-before"),
                                       structural_original,partial_specs["MALFORMED_BINDING"])
                                   and selector_boundary(root)==structural_boundary
                                   and external_boundary(target,Path(str(target)+".r15-before"))==structural_external
                                   )
    record("DISPATCH_STRUCTURAL_STORE_AND_SPEC_APPEAR_AFTER_FIRST_SELECTION_REJECT",
           all(structural_swap_results),repr(structural_swap_results))

    # Once a selector has opened/read a reserved structural leaf, loss or
    # replacement of that exact object is sticky rejection, never a new
    # opportunity to classify the replacement as legacy.
    sticky_results=[];legacy_store=canonical_json_bytes({"attestations":{},"omtest_ko":[]})+b"\n"
    root,state,attest=new_legacy_roots("sticky-authority-store")
    target=attest/"attestations.json";target.write_bytes(semantic_stores["SCHEMA_ONLY"]);target.chmod(0o600)
    sticky_original=r15_leaf_state(target)
    sticky_workspace=tmp/"dispatch-sticky-authority-workspace"
    request=legacy_request(state,sticky_workspace)
    sticky_identity=os.lstat(target);sticky_boundary=selector_boundary(root,target,Path(str(target)+".r15-observed"));sticky_workspace_before=filesystem_snapshot(sticky_workspace)
    result=r15_cli_runpy_fault(repo,"controller/authority/cli",["check-candidate"],
        stdin=json.dumps(request,sort_keys=True,separators=(",",":")),
        fault="selector_replace_after_read",target=target,replacement=legacy_store,route_audit=True)
    sticky_results.append(r15_fault_answer(result,None)
                          and r15_fault_event_exact(result,"selector_replace_after_read",
                              "fstat_replace_after_read",[sticky_identity.st_dev,sticky_identity.st_ino],route("authority_value"))
                          and target.read_bytes()==legacy_store
                          and Path(str(target)+".r15-observed").read_bytes()==semantic_stores["SCHEMA_ONLY"]
                          and exact_replaced_leaf(target,Path(str(target)+".r15-observed"),
                                                  sticky_original,legacy_store)
                          and selector_boundary(root,target,Path(str(target)+".r15-observed"))==sticky_boundary
                          and filesystem_snapshot(sticky_workspace)==sticky_workspace_before)
    root,state,attest=new_legacy_roots("sticky-attest-store")
    target=attest/"attestations.json";target.write_bytes(semantic_stores["OWNER_ONLY"]);target.chmod(0o600)
    sticky_original=r15_leaf_state(target)
    sticky_identity=os.lstat(target);sticky_boundary=selector_boundary(root,target,Path(str(target)+".r15-observed"))
    result=r15_cli_runpy_fault(repo,"controller/attest/cli",
        [str(attest),"write","dispatch-ordinary","3"*40],stdin=None,
        fault="selector_replace_after_read",target=target,replacement=legacy_store,route_audit=True)
    sticky_results.append(r15_fault_error(
        result,None)
                          and r15_fault_event_exact(result,"selector_replace_after_read",
                              "fstat_replace_after_read",[sticky_identity.st_dev,sticky_identity.st_ino],route("attest_main"))
                          and target.read_bytes()==legacy_store
                          and Path(str(target)+".r15-observed").read_bytes()==semantic_stores["OWNER_ONLY"]
                          and exact_replaced_leaf(target,Path(str(target)+".r15-observed"),
                                                  sticky_original,legacy_store)
                          and selector_boundary(root,target,Path(str(target)+".r15-observed"))==sticky_boundary)
    root,state,attest=new_legacy_roots("sticky-taskval-spec")
    target=tmp/"dispatch-sticky-taskval-spec.json"
    target.write_bytes(partial_specs["MALFORMED_BINDING"]);target.chmod(0o600)
    sticky_original=r15_leaf_state(target)
    sticky_identity=os.lstat(target);sticky_boundary=selector_boundary(root)
    sticky_external=external_boundary(target,Path(str(target)+".r15-observed"))
    result=r15_cli_runpy_fault(repo,"controller/taskval/cli",
        ["select",str(target),str(attest),str(state)],stdin=None,
        fault="selector_replace_after_read",target=target,replacement=legacy_spec.read_bytes(),route_audit=True)
    sticky_results.append(r15_fault_error(result,"R15 selector leaf replacement")
                          and r15_fault_event_exact(result,"selector_replace_after_read",
                              "fstat_replace_after_read",[sticky_identity.st_dev,sticky_identity.st_ino],[])
                          and Path(str(target)+".r15-observed").read_bytes()==partial_specs["MALFORMED_BINDING"]
                          and target.read_bytes()==legacy_spec.read_bytes()
                          and exact_replaced_leaf(target,Path(str(target)+".r15-observed"),
                                                  sticky_original,legacy_spec.read_bytes())
                          and (state/"events.jsonl").read_bytes()==b""
                          and selector_boundary(root)==sticky_boundary
                          and external_boundary(target,Path(str(target)+".r15-observed"))==sticky_external)
    record("DISPATCH_OPENED_RESERVED_LEAF_REPLACED_AFTER_READ_STICKY_REJECT_ALL_WRAPPERS",
           all(sticky_results),repr(sticky_results))
    sticky_identity_variants=[]
    root,state,attest=new_legacy_roots("sticky-same-byte-inode")
    target=attest/"attestations.json";target.write_bytes(semantic_stores["SCHEMA_ONLY"]);target.chmod(0o600)
    original_state=r15_leaf_state(target);boundary=selector_boundary(root,target,Path(str(target)+".r15-observed"))
    result=r15_cli_runpy_fault(repo,"controller/attest/cli",
        [str(attest),"write","dispatch-ordinary","4"*40],stdin=None,
        fault="selector_replace_after_read",target=target,
        replacement=semantic_stores["SCHEMA_ONLY"],route_audit=True)
    sticky_identity_variants.append(
        r15_fault_error(result,None)
        and r15_fault_event_exact(result,"selector_replace_after_read",
            "fstat_replace_after_read",[original_state["dev"],original_state["ino"]],route("attest_main"))
        and exact_replaced_leaf(target,Path(str(target)+".r15-observed"),
            original_state,semantic_stores["SCHEMA_ONLY"])
        and selector_boundary(root,target,Path(str(target)+".r15-observed"))==boundary)
    root,state,attest=new_legacy_roots("sticky-same-inode-chmod")
    target=attest/"attestations.json";target.write_bytes(semantic_stores["SCHEMA_ONLY"]);target.chmod(0o600)
    original_state=r15_leaf_state(target);boundary=selector_boundary(root,target)
    result=r15_cli_runpy_fault(repo,"controller/attest/cli",
        [str(attest),"write","dispatch-ordinary","5"*40],stdin=None,
        fault="selector_chmod_after_read",target=target,route_audit=True)
    changed_state=r15_leaf_state(target)
    sticky_identity_variants.append(
        r15_fault_error(result,None)
        and r15_fault_event_exact(result,"selector_chmod_after_read",
            "fstat_chmod_after_read",[original_state["dev"],original_state["ino"]],route("attest_main"))
        and (changed_state["dev"],changed_state["ino"])==(original_state["dev"],original_state["ino"])
        and stat.S_ISREG(int(original_state["mode"])) and stat.S_ISREG(int(changed_state["mode"]))
        and stat.S_IMODE(int(original_state["mode"]))==0o600
        and int(changed_state["mode"])==(int(original_state["mode"]) & ~0o777)|0o644
        and all(changed_state[key]==original_state[key]
                for key in ("uid","gid","nlink","size","sha256"))
        and selector_boundary(root,target)==boundary)
    record("DISPATCH_STICKY_SAME_BYTES_NEW_INODE_AND_SAME_INODE_CHMOD_REJECT",
           sticky_identity_variants==[True,True],repr(sticky_identity_variants))


def r15_connected_matrix(tmp: Path, product_base: str,
                         product_candidate: str, *,
                         source_repo: Path = ROOT) -> tuple[bool,str,int]:
    """Single connected lifecycle oracle used without branching by J and A lanes."""
    tmp.mkdir(parents=True,exist_ok=True,mode=0o700)
    cases: list[tuple[str,bool,str]]=[]
    try:
        fixture=r15_prepare_published_fixture(
            tmp,product_base,product_candidate,source_repo=source_repo)
        r15_h038_rendered_gate_controls(fixture,cases)
        context=r15_bootstrap_claim_controls(tmp,fixture,cases)
        r15_loader_controls(tmp,context,cases)
        r15_dispatch_controls(tmp,context,cases)
        r15_owner_transition_controls(tmp,context,cases)
    except (OSError,subprocess.SubprocessError,ValueError,KeyError,TypeError,Rig) as exc:
        return False,str(exc),len(cases)
    failed_cases=[name+":"+detail[:160] for name,ok,detail in cases if not ok]
    return not failed_cases," | ".join(failed_cases),len(cases)


