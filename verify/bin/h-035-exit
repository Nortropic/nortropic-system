        ("current_state",0,"controller/**"),
        ("prospective_state",4,"controller/launch/**"),
        ("prospective_state",5,"controller/launch/runtime_snapshot.py/**"),
    ):
        mutant=clone(); mutant[key]["owner_production_paths"][index]=value; state_mutants.append(mutant)
    mutant=clone(); mutant["prospective_state"]["owner_production_paths"].pop(); state_mutants.append(mutant)
    mutant=clone(); mutant["prospective_state"]["owner_production_paths"].append(H036_OWNER_PATHS[0]); state_mutants.append(mutant)
    mutant=clone(); mutant["h034_task_owner_author_allowed_write_after_v2"].append(H036_OWNER_PATHS[0]); state_mutants.append(mutant)
