  if not isinstance(record.get("invalidates_on"),list) or len(record["invalidates_on"])!=len(set(record["invalidates_on"])) or not all(isinstance(x,str) and HEX40.fullmatch(x) for x in record["invalidates_on"]):raise Stop("attestation invalidation schema")
  invalid=any(x in v["invalidated_shas"] for x in record["invalidates_on"])
  if record["stale"] is not invalid:raise Stop("attestation stale history schema")
  if record["stale"]:stale_tasks.append(task)
