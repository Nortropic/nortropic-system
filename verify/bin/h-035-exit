    "specs/**",
    "tests/**",
    "vendored-skills/**",
    "verify/bin/**",
    "workflows/**",
)
FROZEN_BUILDER_DENIED = {
    "specs/tasks.spec.json",
    "specs/owner-production-paths.v1.json",
    "verify/bin/h-035-exit",
    "docs/loop/owner-author-workflow-v1.md",
}
REGISTRY_KEYS = {
    "schema_version",
    "path_grammar",
    "authority_source",
    "runtime_override_allowed",
    "owner_production_allocations",
    "owner_author_global_denied_paths",
}
TASK_AUTHORITY = {
    "classes": ["ordinary", "owner_authority"],
    "owner_production_registry": "specs/owner-production-paths.v1.json",
    "schema_v1_authority_class": "ordinary",
    "schema_v1_owner_authority_inference": False,
}
SHA40 = re.compile(r"^[0-9a-f]{40}$")
CONTROL = re.compile(r"[\x00-\x1f\x7f]")
DRIVE = re.compile(r"^[A-Za-z]:")
GLOB_META = set("*?[]{}")


class Rig(RuntimeError):
    """The harness cannot distinguish the required effect."""


class FixtureError(RuntimeError):
    """The disposable reference fixture could not be constructed."""


@dataclass
class Results:
    label: str
    passed: int = 0
    failed: int = 0

    def check(self, name: str, condition: bool, detail: str = "") -> bool:
        if condition:
            self.passed += 1
            print(f"PASS {self.label}:{name}")
            return True
        self.failed += 1
        print(f"FAIL {self.label}:{name} — {detail}")
        return False

    def predicted(self, mutant: str, hypothesis: str, effect: str) -> None:
        print(f"MUTANT={mutant}")
        print(f"HYPOTHESIS={hypothesis}")
        print(f"PREDICTED_EFFECT={effect}")


def command(
    argv: Iterable[object],
    *,
    cwd: Path,
    stdin: str | bytes | None = None,
    timeout: float = 60,
    env: dict[str, str] | None = None,
    text: bool = True,
) -> subprocess.CompletedProcess:
    args = [str(value) for value in argv]
    try:
        return subprocess.run(
            args,
            cwd=str(cwd),
            input=stdin,
            capture_output=True,
            text=text,
            shell=False,
            timeout=timeout,
            env=env,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Rig(f"command could not complete: {args!r}: {exc}") from exc


def git(repo: Path, *args: object, timeout: float = 60) -> subprocess.CompletedProcess:
    env = {
        "PATH": "/usr/bin:/bin:/opt/homebrew/bin",
        "HOME": "/var/empty",
        "XDG_CONFIG_HOME": "/var/empty",
        "LANG": "C",
        "LC_ALL": "C",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_SYSTEM": "/dev/null",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_COUNT": "0",
        "GIT_TERMINAL_PROMPT": "0",
    }
    return command(
        ["/usr/bin/git", "--no-replace-objects", "-C", repo, *args],
        cwd=repo,
        timeout=timeout,
        env=env,
    )


def git_ok(repo: Path, *args: object) -> str:
    result = git(repo, *args)
    if result.returncode != 0:
        raise FixtureError(
            f"git {' '.join(str(x) for x in args)} failed: {(result.stderr or result.stdout)[-800:]}"
        )
    return result.stdout.strip()


def git_show_bytes(repo: Path, sha: str, rel: str) -> bytes:
    result = git(repo, "show", f"{sha}:{rel}")
    if result.returncode != 0:
        raise FixtureError(f"git show failed for {sha}:{rel}: {result.stderr[-500:]}")
    return result.stdout.encode("utf-8")


def digest_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def digest_file(path: Path) -> str:
    return digest_bytes(path.read_bytes())


def duplicate_aware(items: list[tuple[str, Any]]) -> dict[str, Any]:
    output: dict[str, Any] = {}
    for key, value in items:
        if key in output:
            raise ValueError(f"duplicate JSON key: {key}")
        output[key] = value
    return output


def strict_json(raw: bytes | str) -> Any:
    if isinstance(raw, str):
        raw = raw.encode("utf-8")
    return json.loads(raw.decode("utf-8"), object_pairs_hook=duplicate_aware)


def strict_file(path: Path) -> Any:
    return strict_json(path.read_bytes())


def canonical_json(value: Any) -> bytes:
    return (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8")


def parse_path(raw: object, *, pattern: bool = True) -> tuple[str, bool]:
    """Strict shared grammar; invalid spellings are never normalized."""
    if type(raw) is not str or not raw:
        raise ValueError("path must be an exact non-empty string")
    if unicodedata.normalize("NFC", raw) != raw:
        raise ValueError("path is not NFC")
    if CONTROL.search(raw):
        raise ValueError("control byte")
    if raw.startswith("/") or DRIVE.match(raw):
        raise ValueError("absolute or drive-prefixed path")
    if "\\" in raw:
        raise ValueError("alternate separator")
    if raw.startswith("./") or raw.endswith("/") or "//" in raw:
        raise ValueError("non-canonical separator")
    recursive = raw.endswith("/**")
    if recursive and not pattern:
        raise ValueError("owner allocation must be exact")
    core = raw[:-3] if recursive else raw
    if not core:
        raise ValueError("root-covering pattern")
    parts = core.split("/")
    if any(part in ("", ".", "..", ".git") for part in parts):
        raise ValueError("forbidden segment")
    if any(char in GLOB_META for char in core):
        raise ValueError("unsupported glob")
    return core, recursive


def overlaps(left: object, right: object) -> bool:
    lpath, lprefix = parse_path(left)
    rpath, rprefix = parse_path(right)
    # An exact owner-production file also reserves every parent/child spelling.
    # A path like "kernel.py/child" cannot be used as a second namespace that
    # becomes reachable when the exact protected file is absent or replaced.
    if lpath == rpath or lpath.startswith(rpath + "/") or rpath.startswith(lpath + "/"):
        return True
    if lprefix and (rpath == lpath or rpath.startswith(lpath + "/")):
        return True
    if rprefix and (lpath == rpath or lpath.startswith(rpath + "/")):
        return True
    return False


def permits(pattern: object, path: object) -> bool:
    p, recursive = parse_path(pattern)
    actual, actual_recursive = parse_path(path, pattern=False)
    if actual_recursive:
        raise ValueError("actual Git path cannot be recursive")
    return actual == p if not recursive else actual == p or actual.startswith(p + "/")


def validate_registry(document: object) -> tuple[bool, str]:
    if type(document) is not dict:
        return False, "registry top-level must be object"
    if set(document) != REGISTRY_KEYS:
        return False, "registry exact key membership"
    if type(document.get("schema_version")) is not int or document["schema_version"] != 1:
        return False, "registry schema_version"
    if document.get("path_grammar") != "repo-relative-exact-or-terminal-recursive-prefix-v1":
        return False, "registry path grammar"
    if document.get("authority_source") != "canonical-git-tree-plus-explicit-owner-action":
        return False, "registry authority source"
    if document.get("runtime_override_allowed") is not False:
        return False, "runtime registry override"
    allocations = document.get("owner_production_allocations")
    denied = document.get("owner_author_global_denied_paths")
    if type(allocations) is not list or len(allocations) != 1:
        return False, "registry must contain exactly one v1 allocation"
    allocation = allocations[0]
    if type(allocation) is not dict or set(allocation) != {
        "task_id", "owner_author_allowed_write"
    }:
        return False, "allocation exact shape"
    if allocation.get("task_id") != "h-034":
        return False, "allocation task"
    paths = allocation.get("owner_author_allowed_write")
    if type(paths) is not list or any(type(path) is not str for path in paths):
        return False, "allocation path list type"
    if tuple(paths) != EXPECTED_OWNER_PATHS:
        return False, "allocation exact current membership/order"
    try:
        parsed = [parse_path(path, pattern=False) for path in paths]
    except ValueError as exc:
        return False, f"allocation path: {exc}"
    if len(parsed) != len(set(parsed)):
        return False, "duplicate allocation path"
    if type(denied) is not list or not denied or any(type(path) is not str for path in denied):
        return False, "global denied path list type/empty"
    if tuple(denied) != EXPECTED_GLOBAL_DENIED:
        return False, "global denied authority membership/order"
    try:
        denied_parsed = [parse_path(path) for path in denied]
    except ValueError as exc:
        return False, f"global denied path: {exc}"
    if len(denied_parsed) != len(set(denied_parsed)):
        return False, "duplicate global denied path"
    if any(overlaps(owner, block) for owner in paths for block in denied):
        return False, "owner allocation intersects global denied authority"
    return True, "ok"


def registry_allocations(registry: dict[str, Any]) -> dict[str, list[str]]:
    return {
        entry["task_id"]: list(entry["owner_author_allowed_write"])
        for entry in registry["owner_production_allocations"]
    }


def exact_string_list(value: object, name: str, *, empty: bool = True) -> list[str]:
    if type(value) is not list or any(type(item) is not str or not item for item in value):
        raise ValueError(f"{name} must be a list of non-empty exact strings")
    if not empty and not value:
        raise ValueError(f"{name} must be non-empty")
    return list(value)


def validate_task_document(
    document: object, task_id: str, registry: dict[str, Any]
) -> tuple[bool, str, dict[str, Any] | None]:
    """Independent judge oracle. Production acceptance invokes real consumers."""
    try:
        if type(document) is not dict or type(document.get("tasks")) is not list:
            raise ValueError("task document shape")
        version = document.get("spec_version")
        if version not in ("1.0.0", "2.0.0"):
            raise ValueError("unsupported spec version")
        tasks = document["tasks"]
        ids = [task.get("id") for task in tasks if type(task) is dict]
        if len(ids) != len(tasks) or any(type(item) is not str or not item for item in ids):
            raise ValueError("task id type")
        if len(ids) != len(set(ids)):
            raise ValueError("duplicate task id")
        hits = [task for task in tasks if task["id"] == task_id]
        if len(hits) != 1:
            raise ValueError("task identity count")
        task = hits[0]
        if version == "1.0.0":
            if task.get("authority_class", "ordinary") != "ordinary":
                raise ValueError("v1 cannot select owner authority")
            if "owner_author_allowed_write" in task:
                raise ValueError("v1 owner surface is never authority")
            authority_class = "ordinary"
        else:
            if document.get("task_authority") != TASK_AUTHORITY:
                raise ValueError("v2 task_authority contract")
            authority_class = task.get("authority_class")
            if type(authority_class) is not str or authority_class not in (
                "ordinary", "owner_authority"
            ):
                raise ValueError("authority_class exact enum")

        allowed = exact_string_list(task.get("allowed_write"), "allowed_write")
        docs = exact_string_list(task.get("docs_impact", []), "docs_impact")
        owner_allocations = registry_allocations(registry)
        all_owner = [path for values in owner_allocations.values() for path in values]

        if authority_class == "ordinary":
            if not allowed:
                raise ValueError("ordinary allowed_write must be non-empty")
            if "owner_author_allowed_write" in task:
                raise ValueError("ordinary task received owner surface")
            surface = allowed
            for pattern in surface:
                parse_path(pattern)
                if any(overlaps(pattern, owner) for owner in all_owner):
                    raise ValueError("ordinary surface overlaps owner production")
        else:
            if allowed != []:
                raise ValueError("owner task has ordinary write surface")
            owner = exact_string_list(
                task.get("owner_author_allowed_write"),
                "owner_author_allowed_write",
                empty=False,
            )
            expected = owner_allocations.get(task_id)
            if expected is None or owner != expected:
                raise ValueError("owner surface differs from exact registry allocation")
            for path in owner:
                parse_path(path, pattern=False)
                if any(overlaps(path, block) for block in registry["owner_author_global_denied_paths"]):
                    raise ValueError("owner surface intersects authority-control deny")
            surface = owner

        for doc_path in docs:
            parse_path(doc_path, pattern=False)
            if not any(permits(pattern, doc_path) for pattern in surface):
                raise ValueError("docs_impact outside applicable surface")
        projected = dict(task)
        projected["effective_authority_class"] = authority_class
        projected["applicable_write"] = list(surface)
        return True, "ok", projected
    except (KeyError, TypeError, ValueError) as exc:
        return False, str(exc), None


def frozen_checks(results: Results) -> bool:
    try:
        spec = strict_file(SPEC)
        registry = strict_file(REGISTRY)
    except (OSError, UnicodeError, ValueError) as exc:
        results.check("F00_FROZEN_JSON", False, str(exc))
        return False
    ok_registry, why_registry = validate_registry(registry)
    results.check("F01_REGISTRY_EXACT", ok_registry, why_registry)
    results.check("F02_SCHEMA_V2", type(spec) is dict and spec.get("spec_version") == "2.0.0")
    results.check("F03_TASK_AUTHORITY", type(spec) is dict and spec.get("task_authority") == TASK_AUTHORITY)
    tasks = spec.get("tasks", []) if type(spec) is dict else []
    ids = [task.get("id") for task in tasks if type(task) is dict]
    results.check("F04_UNIQUE_TASK_IDS", len(ids) == len(tasks) == len(set(ids)))
    results.check("F05_H034_TASK_ABSENT", "h-034" not in ids)
    h035 = [task for task in tasks if type(task) is dict and task.get("id") == "h-035"]
    results.check("F06_H035_SINGLE", len(h035) == 1)
    if len(h035) == 1:
        task = h035[0]
        results.check("F07_H035_ORDINARY", task.get("authority_class") == "ordinary")
        results.check("F08_H035_DEPENDENCY", task.get("depends_on") == ["h-017"])
        results.check(
            "F09_H035_ALLOWED_EXACT",
            tuple(task.get("allowed_write", [])) == EXPECTED_H035_ALLOWED,
            repr(task.get("allowed_write")),
        )
        results.check(
            "F10_H035_FREEZE_OUTSIDE_BUILDER",
            not FROZEN_BUILDER_DENIED.intersection(task.get("allowed_write", [])),
        )
        results.check("F11_H035_NO_OWNER_FIELD", "owner_author_allowed_write" not in task)
        valid, reason, _projection = validate_task_document(spec, "h-035", registry)
        results.check("F12_H035_SCHEMA_VALID", valid, reason)
    existing = [f"h-{number:03d}" for number in range(1, 18)]
    existing_ok = all(
        len([task for task in tasks if task.get("id") == task_id]) == 1
        and [task for task in tasks if task.get("id") == task_id][0].get("authority_class") == "ordinary"
        for task_id in existing
    )
    results.check("F13_LEGACY_CLASSES_EXPLICIT", existing_ok)
    results.check("F14_CONTRACT_PRESENT", CONTRACT.is_file())
    results.check("F15_GATE_CANONICAL", Path(__file__).resolve() == ROOT / "verify/bin/h-035-exit")
    return results.failed == 0


# This disposable implementation is deliberately small and provider-neutral. It is
# generated only under the gate's temporary root and is never a production candidate.
REFERENCE_MODEL = r'''from __future__ import annotations
import hashlib, json, os, re, subprocess, unicodedata
from pathlib import Path

EXPECTED_AUTHORITY = {
    "classes": ["ordinary", "owner_authority"],
    "owner_production_registry": "specs/owner-production-paths.v1.json",
    "schema_v1_authority_class": "ordinary",
    "schema_v1_owner_authority_inference": False,
}
EXPECTED_DENIED = [".agents/**", ".github/**", "AGENTS.md", "AUTOPILOT", "agents/**", "config/**", "controller/**", "docs/**", "scripts/**", "skills/**", "specs/**", "tests/**", "vendored-skills/**", "verify/bin/**", "workflows/**"]
REGISTRY_KEYS = {"schema_version", "path_grammar", "authority_source", "runtime_override_allowed", "owner_production_allocations", "owner_author_global_denied_paths"}
CONTROL = re.compile(r"[\x00-\x1f\x7f]")
DRIVE = re.compile(r"^[A-Za-z]:")

class Refusal(ValueError): pass

def strict(raw):
    def pairs(items):
        out = {}
        for key, value in items:
            if key in out: raise Refusal("duplicate key " + key)
            out[key] = value
        return out
    if isinstance(raw, str): raw = raw.encode()
    return json.loads(raw.decode("utf-8"), object_pairs_hook=pairs)

def run(argv, cwd, stdin=None):
    return subprocess.run([str(x) for x in argv], cwd=str(cwd), input=stdin,
                          text=True, capture_output=True, shell=False)

def git(root, *args):
    p = run(["/usr/bin/git", "--no-replace-objects", "-C", root, *args], root)
    if p.returncode: raise Refusal("git: " + (p.stderr or p.stdout)[-300:])
    return p.stdout.strip()

def show(root, sha, rel):
    p = run(["/usr/bin/git", "--no-replace-objects", "-C", root, "show", f"{sha}:{rel}"], root)
    if p.returncode: raise Refusal("missing canonical Git bytes " + rel)
    return p.stdout.encode()

def digest(raw): return hashlib.sha256(raw).hexdigest()

def path(raw, pattern=True):
    if type(raw) is not str or not raw: raise Refusal("path type")
    if unicodedata.normalize("NFC", raw) != raw or CONTROL.search(raw): raise Refusal("path encoding")
    if raw.startswith("/") or DRIVE.match(raw) or "\\" in raw: raise Refusal("path absolute/alternate")
    if raw.startswith("./") or raw.endswith("/") or "//" in raw: raise Refusal("path separator")
    recursive = raw.endswith("/**")
    if recursive and not pattern: raise Refusal("allocation pattern")
    core = raw[:-3] if recursive else raw
    if not core: raise Refusal("root pattern")
    bits = core.split("/")
    if any(x in ("", ".", "..", ".git") for x in bits): raise Refusal("path segment")
    if any(x in core for x in "*?[]{}"): raise Refusal("path glob")
    return core, recursive

def overlap(a, b):
    ap, ax = path(a); bp, bx = path(b)
    return ((ap == bp or ap.startswith(bp + "/") or bp.startswith(ap + "/"))
            or (ax and (bp == ap or bp.startswith(ap + "/")))
            or (bx and (ap == bp or ap.startswith(bp + "/"))))

def permit(pattern, actual):
    pp, px = path(pattern); aa, ax = path(actual, False)
    return (aa == pp) if not px else (aa == pp or aa.startswith(pp + "/"))

def registry(root, sha):
    value = strict(show(root, sha, "specs/owner-production-paths.v1.json"))
    if type(value) is not dict or set(value) != REGISTRY_KEYS: raise Refusal("registry keys")
    if type(value.get("schema_version")) is not int or value["schema_version"] != 1: raise Refusal("registry version")
    if value.get("path_grammar") != "repo-relative-exact-or-terminal-recursive-prefix-v1": raise Refusal("registry grammar")
    if value.get("authority_source") != "canonical-git-tree-plus-explicit-owner-action": raise Refusal("registry source")
    if value.get("runtime_override_allowed") is not False: raise Refusal("registry override")
    allocations = value.get("owner_production_allocations")
    denied = value.get("owner_author_global_denied_paths")
    if type(allocations) is not list or len(allocations) != 1: raise Refusal("registry allocations")
    item = allocations[0]
    if type(item) is not dict or set(item) != {"task_id", "owner_author_allowed_write"}: raise Refusal("allocation shape")
    if item.get("task_id") != "h-034": raise Refusal("allocation task")
    expected = ["verify/h034/kernel.py", "verify/h034/plan.json", "verify/h034/identity.json"]
    if item.get("owner_author_allowed_write") != expected: raise Refusal("allocation membership")
    if denied != EXPECTED_DENIED: raise Refusal("denied membership/order")
    parsed = [path(x) for x in denied]
    if len(parsed) != len(set(parsed)): raise Refusal("denied duplicate")
    for owner in expected:
        path(owner, False)
        if any(overlap(owner, block) for block in denied): raise Refusal("allocation denied")
    return value

def task(root, sha, task_id):
    reg = registry(root, sha)
    doc = strict(show(root, sha, "specs/tasks.spec.json"))
    if type(doc) is not dict or type(doc.get("tasks")) is not list: raise Refusal("spec shape")
    version = doc.get("spec_version")
    if version not in ("1.0.0", "2.0.0"): raise Refusal("spec version")
    ids = []
    for item in doc["tasks"]:
        if type(item) is not dict or type(item.get("id")) is not str or not item["id"]: raise Refusal("task id")
        ids.append(item["id"])
    if len(ids) != len(set(ids)): raise Refusal("duplicate task")
    hits = [x for x in doc["tasks"] if x["id"] == task_id]
    if len(hits) != 1: raise Refusal("task count")
    item = hits[0]
    if version == "1.0.0":
        if item.get("authority_class", "ordinary") != "ordinary" or "owner_author_allowed_write" in item: raise Refusal("v1 owner inference")
        cls = "ordinary"
    else:
        if doc.get("task_authority") != EXPECTED_AUTHORITY: raise Refusal("task authority")
        cls = item.get("authority_class")
        if type(cls) is not str or cls not in ("ordinary", "owner_authority"): raise Refusal("authority class")
    allowed = item.get("allowed_write")
    docs = item.get("docs_impact", [])
    if type(allowed) is not list or any(type(x) is not str or not x for x in allowed): raise Refusal("ordinary surface type")
    if type(docs) is not list or any(type(x) is not str or not x for x in docs): raise Refusal("docs type")
    allocation = reg["owner_production_allocations"][0]["owner_author_allowed_write"]
    if cls == "ordinary":
        if not allowed or "owner_author_allowed_write" in item: raise Refusal("ordinary surface")
        for pattern in allowed:
            path(pattern)
            if any(overlap(pattern, owner) for owner in allocation): raise Refusal("ordinary owner overlap")
        surface = allowed
    else:
        if allowed != []: raise Refusal("owner ordinary surface")
        owner = item.get("owner_author_allowed_write")
        if task_id != "h-034" or owner != allocation: raise Refusal("owner allocation")
        for exact in owner: path(exact, False)
        surface = owner
    for docpath in docs:
        path(docpath, False)
        if not any(permit(pattern, docpath) for pattern in surface): raise Refusal("docs outside")
    out = dict(item); out["effective_authority_class"] = cls; out["applicable_write"] = list(surface)
    return out

def changed(root, base, candidate):
    if not re.fullmatch(r"[0-9a-f]{40}", base or "") or not re.fullmatch(r"[0-9a-f]{40}", candidate or ""): raise Refusal("sha form")
    git(root, "cat-file", "-e", base + "^{commit}"); git(root, "cat-file", "-e", candidate + "^{commit}")
    raw = git(root, "diff", "--name-only", "--no-renames", base, candidate)
    files = [x for x in raw.splitlines() if x]
    for item in files: path(item, False)
    return files

def check_candidate(root, authority_sha, task_id, base, candidate):
    item = task(root, authority_sha, task_id)
    files = changed(root, base, candidate)
    if not files: raise Refusal("empty candidate")
    if any(not any(permit(pattern, filename) for pattern in item["applicable_write"]) for filename in files): raise Refusal("candidate outside surface")
    return item, files

def state_path(state_dir): return Path(state_dir) / "owner-authority.json"

def read_state(state_dir):
    target = state_path(state_dir)
    if not target.exists(): return None
    value = strict(target.read_bytes())
    if type(value) is not dict: raise Refusal("state shape")
    return value

def write_state(state_dir, value):
    root = Path(state_dir); root.mkdir(parents=True, exist_ok=True)
    temp = root / "owner-authority.json.new"
    temp.write_text(json.dumps(value, sort_keys=True, indent=2) + "\n")
    temp.replace(state_path(root))
    log = root / "events.jsonl"
    with log.open("a") as stream:
        stream.write(json.dumps({"task": value["task_id"], "status": value["state"], "owner_authority": value}, sort_keys=True, separators=(",", ":")) + "\n")

def canonical_binding(root, req):
    required = {"authority_sha", "task_id", "action_id", "attempt_id", "author_identity", "base_sha", "current_main_sha", "spec_sha256", "registry_sha256", "gate_path", "gate_sha256", "state_dir", "attest_dir"}
    if set(req) != required: raise Refusal("owner action request keys")
    for key in required:
        if type(req[key]) is not str or not req[key]: raise Refusal("owner action string " + key)
    if req["authority_sha"] != req["base_sha"]: raise Refusal("authority/base binding")
    item = task(root, req["authority_sha"], req["task_id"])
    if item["effective_authority_class"] != "owner_authority": raise Refusal("not owner task")
    current = git(root, "rev-parse", "refs/remotes/origin/main")
    if current != req["current_main_sha"] or current != req["base_sha"]: raise Refusal("current main")
    spec_raw = show(root, req["authority_sha"], "specs/tasks.spec.json")
    reg_raw = show(root, req["authority_sha"], "specs/owner-production-paths.v1.json")
    if digest(spec_raw) != req["spec_sha256"] or digest(reg_raw) != req["registry_sha256"]: raise Refusal("spec/registry digest")
    if item.get("exit_test") != req["gate_path"]: raise Refusal("gate path")
    gate_raw = show(root, req["authority_sha"], req["gate_path"])
    if digest(gate_raw) != req["gate_sha256"]: raise Refusal("gate digest")
    return item
'''


REFERENCE_AUTHORITY = r'''#!/usr/bin/env python3.12
from __future__ import annotations
import hashlib, json, os, shutil, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "controller/authority"))
import model

def reply(accepted, **fields):
    print(json.dumps({"accepted": accepted, **fields}, sort_keys=True))

def request():
    raw = sys.stdin.buffer.read()
    if not raw: raise model.Refusal("missing JSON request")
    value = model.strict(raw)
    if type(value) is not dict: raise model.Refusal("request object")
    return value

def exact(req, keys):
    if set(req) != set(keys): raise model.Refusal("request keys")

def validate_task(req):
    exact(req, {"authority_sha", "task_id"})
    item = model.task(ROOT, req["authority_sha"], req["task_id"])
    reply(True, authority_class=item["effective_authority_class"], applicable_write=item["applicable_write"])

def validate_registry(req):
    exact(req, {"authority_sha"})
    reg = model.registry(ROOT, req["authority_sha"])
    reply(True, registry_sha256=model.digest(model.show(ROOT, req["authority_sha"], "specs/owner-production-paths.v1.json")), allocations=reg["owner_production_allocations"])

def check_candidate(req):
    exact(req, {"authority_sha", "task_id", "base_sha", "candidate_sha"})
    item, files = model.check_candidate(ROOT, req["authority_sha"], req["task_id"], req["base_sha"], req["candidate_sha"])
    reply(True, authority_class=item["effective_authority_class"], candidate_sha=req["candidate_sha"], actual_changed_files=files)

def owner_action(req):
    model.canonical_binding(ROOT, req)
    state = model.read_state(req["state_dir"])
    if state is None or state.get("state") != "OWNER_ACTION_REQUIRED": raise model.Refusal("owner action state")
    for key in ("task_id", "authority_sha", "base_sha", "current_main_sha", "spec_sha256", "registry_sha256", "gate_path", "gate_sha256", "attest_dir"):
        if state.get(key) != req[key]: raise model.Refusal("owner action state binding " + key)
    state.update({"action_id": req["action_id"], "attempt_id": req["attempt_id"], "author_identity": req["author_identity"]})
    model.write_state(req["state_dir"], state)
    reply(True, state="OWNER_ACTION_REQUIRED", action_persisted=True)

def record_review(req):
    keys = {"state_dir", "task_id", "candidate_sha", "review_id", "reviewer_identity", "review_artifact", "review_worktree"}
    exact(req, keys)
    state = model.read_state(req["state_dir"])
    if state is None or state.get("state") != "OWNER_CANDIDATE_REVIEW_REQUIRED": raise model.Refusal("review state")
    for key in keys:
        if type(req[key]) is not str or not req[key]: raise model.Refusal("review request string")
    if state.get("task_id") != req["task_id"] or state.get("candidate_sha") != req["candidate_sha"]: raise model.Refusal("review candidate")
    if req["reviewer_identity"] == state.get("author_identity"): raise model.Refusal("reviewer is author")
    artifact_path = Path(req["review_artifact"]).resolve()
    review_root = Path(req["review_worktree"]).resolve()
    if not artifact_path.is_file() or not review_root.is_dir(): raise model.Refusal("review evidence missing")
    artifact_raw = artifact_path.read_bytes(); artifact = model.strict(artifact_raw)
    expected = {
        "schema_version": 1, "role": "REVIEWER", "verdict": "PASS",
        "task_id": req["task_id"], "candidate_sha": req["candidate_sha"],
        "base_sha": state["base_sha"], "review_id": req["review_id"],
        "reviewer_identity": req["reviewer_identity"],
    }
    if artifact != expected: raise model.Refusal("review artifact binding/verdict")
    if model.git(review_root, "rev-parse", "HEAD") != req["candidate_sha"]: raise model.Refusal("review worktree head")
    if model.git(review_root, "status", "--porcelain=v1", "--untracked-files=all"): raise model.Refusal("review worktree dirty")
    if str(review_root) == state.get("author_workspace"): raise model.Refusal("review workspace reused author workspace")
    state.update({"state": "OWNER_FINAL_FREEZE_REQUIRED", "review_id": req["review_id"],
                  "reviewer_identity": req["reviewer_identity"], "review_sha256": model.digest(artifact_raw)})
    model.write_state(req["state_dir"], state)
    reply(True, state="OWNER_FINAL_FREEZE_REQUIRED", review_sha256=state["review_sha256"], published=False)

def run_frozen_gate(state):
    root = Path(tempfile.mkdtemp(prefix="h035-reference-gate-", dir=str(Path(state["state_dir"]).parent)))
    target = root / "candidate"
    try:
        model.git(ROOT, "worktree", "add", "--detach", str(target), state["candidate_sha"])
        gate = ROOT / state["gate_path"]
        result = subprocess.run(["/bin/bash", str(gate), str(target)], cwd=str(ROOT), capture_output=True, text=True, shell=False, timeout=20)
        if result.returncode != 0: raise model.Refusal("frozen gate not PASS")
    finally:
        subprocess.run(["/usr/bin/git", "--no-replace-objects", "-C", str(ROOT), "worktree", "remove", "--force", str(target)], capture_output=True)
        shutil.rmtree(root, ignore_errors=True)

def owner_final(req):
    keys = {"state_dir", "attest_dir", "task_id", "owner_final_id", "candidate_sha", "review_id", "review_sha256", "base_sha", "current_main_sha", "spec_sha256", "registry_sha256", "gate_path", "gate_sha256"}
    exact(req, keys)
    state = model.read_state(req["state_dir"])
    if state is None or state.get("state") != "OWNER_FINAL_FREEZE_REQUIRED": raise model.Refusal("owner final state/review missing")
    for key in keys:
        if type(req[key]) is not str or not req[key]: raise model.Refusal("owner final string")
    for key in ("attest_dir", "task_id", "candidate_sha", "review_id", "review_sha256", "base_sha", "current_main_sha", "spec_sha256", "registry_sha256", "gate_path", "gate_sha256"):
        if state.get(key) != req[key]: raise model.Refusal("owner final binding " + key)
    if model.git(ROOT, "rev-parse", "refs/remotes/origin/main") != req["current_main_sha"]: raise model.Refusal("owner final current main")
    _item, files = model.check_candidate(ROOT, state["authority_sha"], state["task_id"], state["base_sha"], state["candidate_sha"])
    if files != state.get("actual_changed_files"): raise model.Refusal("owner final Git file identity")
    state["state_dir"] = req["state_dir"]
    run_frozen_gate(state)
    record = {
        "task_id": state["task_id"], "authority_class": "owner_authority",
        "action_id": state["action_id"], "attempt_id": state["attempt_id"],
        "base_sha": state["base_sha"], "current_main_sha": state["current_main_sha"],
        "candidate_sha": state["candidate_sha"], "actual_changed_files": files,
        "spec_sha256": state["spec_sha256"], "registry_sha256": state["registry_sha256"],
        "gate_path": state["gate_path"], "gate_sha256": state["gate_sha256"],
        "review_id": state["review_id"], "review_sha256": state["review_sha256"],
        "owner_final_id": req["owner_final_id"], "stale": False,
    }
    attest_dir = Path(req["attest_dir"]); attest_dir.mkdir(parents=True, exist_ok=True)
    attest = attest_dir / "attestations.json"; temp = attest_dir / "attestations.json.new"
    temp.write_text(json.dumps({"attestations": {state["task_id"]: record}, "omtest_ko": []}, sort_keys=True, indent=2) + "\n")
    temp.replace(attest)
    state.update({"state": "OWNER_PUBLICATION_ELIGIBLE", "owner_final_id": req["owner_final_id"]})
    model.write_state(req["state_dir"], state)
    reply(True, state="OWNER_PUBLICATION_ELIGIBLE", candidate_sha=state["candidate_sha"], published=False)

def read_state(req):
    exact(req, {"state_dir", "task_id"})
    state = model.read_state(req["state_dir"])
    if state is None or state.get("task_id") != req["task_id"]: raise model.Refusal("state absent")
    reply(True, record=state)

COMMANDS = {"validate-task": validate_task, "validate-registry": validate_registry,
            "check-candidate": check_candidate, "owner-action": owner_action,
            "record-review": record_review, "owner-final": owner_final,
            "read-state": read_state}

try:
    if len(sys.argv) != 2 or sys.argv[1] not in COMMANDS: raise model.Refusal("usage")
    COMMANDS[sys.argv[1]](request())
except Exception as exc:
    reply(False, reason=str(exc))
    raise SystemExit(1)
'''


REFERENCE_LOOP = r'''#!/usr/bin/env python3.12
from __future__ import annotations
import json, os, shutil, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "controller/authority"))
import model

def run(argv, cwd, stdin=None, env=None):
    return subprocess.run([str(x) for x in argv], cwd=str(cwd), input=stdin, text=True,
                          capture_output=True, shell=False, env=env, timeout=30)

def load_config(path):
    value = model.strict(Path(path).read_bytes())
    required = {"spec", "task_id", "state_dir", "attest_dir", "lease_dir", "lease_resurs", "workspace_rot", "base_sha", "current_main_sha", "verifier_id", "run_id", "brytare_rot", "budget", "troskel", "worker_cmd", "timeout_s"}
    if type(value) is not dict or set(value) != required: raise model.Refusal("config exact shape")
    for key in required - {"worker_cmd", "timeout_s", "budget", "troskel"}:
        if type(value[key]) is not str or not value[key]: raise model.Refusal("config string " + key)
    if type(value["worker_cmd"]) is not list or not value["worker_cmd"] or any(type(x) is not str or not x for x in value["worker_cmd"]): raise model.Refusal("provider argv")
    if type(value["timeout_s"]) not in (int, float) or value["timeout_s"] <= 0: raise model.Refusal("provider timeout")
    if type(value["budget"]) is not int or type(value["troskel"]) is not int: raise model.Refusal("budget type")
    return value

def append_status(cfg, task_id, status, owner=None):
    state_dir = Path(cfg["state_dir"]); state_dir.mkdir(parents=True, exist_ok=True)
    event = {"task": task_id, "status": status}
    if owner is not None: event["owner_authority"] = owner
    with (state_dir / "events.jsonl").open("a") as stream:
        stream.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")

def provider(cfg, workspace, envelope):
    env = dict(os.environ)
    env["NORTROPIC_KUVERT"] = str(envelope)
    return subprocess.run(cfg["worker_cmd"], cwd=str(workspace), env=env,
                          input=envelope.read_bytes(), stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, start_new_session=True,
                          timeout=cfg["timeout_s"], shell=False)

def write_owner_required(cfg, item, spec_raw, registry_raw, gate_raw):
    existing = model.read_state(cfg["state_dir"])
    if existing is not None:
        if existing.get("state") not in ("OWNER_ACTION_REQUIRED", "OWNER_CANDIDATE_REVIEW_REQUIRED", "OWNER_FINAL_FREEZE_REQUIRED", "OWNER_PUBLICATION_ELIGIBLE"):
            raise model.Refusal("unknown persisted owner state")
        return existing
    value = {
        "state": "OWNER_ACTION_REQUIRED", "task_id": cfg["task_id"],
        "authority_class": "owner_authority", "authority_sha": cfg["base_sha"],
        "base_sha": cfg["base_sha"], "current_main_sha": cfg["current_main_sha"],
        "spec_sha256": model.digest(spec_raw), "registry_sha256": model.digest(registry_raw),
        "gate_path": item["exit_test"], "gate_sha256": model.digest(gate_raw),
        "attest_dir": cfg["attest_dir"],
    }
    model.write_state(cfg["state_dir"], value)
    return value

def materialize_candidate(cfg, item, owner_state, workspace):
    envelope = Path(cfg["state_dir"]) / "owner-envelope.json"
    envelope.write_text(json.dumps({"run_id": cfg["run_id"], "task_id": cfg["task_id"], "base_sha": cfg["base_sha"], "authority_class": "owner_authority", "owner_author_allowed_write": item["applicable_write"]}, sort_keys=True))
    result = provider(cfg, workspace, envelope)
    if result.returncode != 0: raise model.Refusal("owner provider failure")
    if model.git(workspace, "rev-parse", "HEAD") != cfg["base_sha"]: raise model.Refusal("provider moved HEAD")
    dirty = model.git(workspace, "status", "--porcelain=v1", "--untracked-files=all")
    if not dirty: raise model.Refusal("provider made no owner candidate")
    model.git(workspace, "add", "-A")
    model.git(workspace, "-c", "user.name=nortropic-owner-author", "-c", "user.email=owner-author@nortropic", "-c", "commit.gpgsign=false", "commit", "-qm", "owner candidate")
    candidate = model.git(workspace, "rev-parse", "HEAD")
    _checked, files = model.check_candidate(ROOT, cfg["base_sha"], cfg["task_id"], cfg["base_sha"], candidate)
    owner_state.update({"state": "OWNER_CANDIDATE_REVIEW_REQUIRED", "candidate_sha": candidate,
                        "actual_changed_files": files, "author_workspace": str(workspace),
                        "provider_exit": result.returncode})
    model.write_state(cfg["state_dir"], owner_state)
    print(json.dumps({"state": owner_state["state"], "candidate_sha": candidate, "actual_changed_files": files}, sort_keys=True))

def run_loop(cfg):
    if Path(cfg["spec"]).resolve() != ROOT / "specs/tasks.spec.json": raise model.Refusal("caller-selected spec")
    current = model.git(ROOT, "rev-parse", "refs/remotes/origin/main")
    if current != cfg["current_main_sha"] or current != cfg["base_sha"]: raise model.Refusal("current main/base")
    spec_raw = model.show(ROOT, cfg["base_sha"], "specs/tasks.spec.json")
    registry_raw = model.show(ROOT, cfg["base_sha"], "specs/owner-production-paths.v1.json")
    item = model.task(ROOT, cfg["base_sha"], cfg["task_id"])
    for path in (cfg["state_dir"], cfg["attest_dir"], cfg["lease_dir"], cfg["brytare_rot"], cfg["workspace_rot"]):
        Path(path).mkdir(parents=True, exist_ok=True)
    lease = Path(cfg["lease_dir"]) / (cfg["run_id"] + ".lease")
    lease.write_text(str(os.getpid()) + "\n")
    try:
        if item["effective_authority_class"] == "owner_authority":
            gate_raw = model.show(ROOT, cfg["base_sha"], item["exit_test"])
            state = write_owner_required(cfg, item, spec_raw, registry_raw, gate_raw)
            if state["state"] == "OWNER_ACTION_REQUIRED" and "action_id" not in state:
                print("OWNER_ACTION_REQUIRED")
                return 0
            if state["state"] in ("OWNER_CANDIDATE_REVIEW_REQUIRED", "OWNER_FINAL_FREEZE_REQUIRED", "OWNER_PUBLICATION_ELIGIBLE"):
                print(state["state"])
                return 0
        else:
            state = None
        workspace_root = Path(cfg["workspace_rot"])
        workspace = workspace_root / (cfg["run_id"] + "-attempt")
        model.git(ROOT, "worktree", "add", "--detach", str(workspace), cfg["base_sha"])
        try:
            envelope = Path(cfg["state_dir"]) / "ordinary-envelope.json"
            if item["effective_authority_class"] == "ordinary":
                envelope.write_text(json.dumps({"run_id": cfg["run_id"], "task_id": cfg["task_id"], "base_sha": cfg["base_sha"], "authority_class": "ordinary", "allowed_write": item["applicable_write"]}, sort_keys=True))
                result = provider(cfg, workspace, envelope)
                if result.returncode != 0: raise model.Refusal("ordinary provider failure")
                if not model.git(workspace, "status", "--porcelain=v1", "--untracked-files=all"): raise model.Refusal("ordinary provider made no candidate")
                model.git(workspace, "add", "-A")
                model.git(workspace, "-c", "user.name=nortropic-ordinary", "-c", "user.email=ordinary@nortropic", "-c", "commit.gpgsign=false", "commit", "-qm", "ordinary candidate")
                candidate = model.git(workspace, "rev-parse", "HEAD")
                model.check_candidate(ROOT, cfg["base_sha"], cfg["task_id"], cfg["base_sha"], candidate)
                append_status(cfg, cfg["task_id"], "claimed")
                print("ORDINARY_PROVIDER_EXECUTED " + candidate)
                return 0
            materialize_candidate(cfg, item, state, workspace)
            return 0
        finally:
            subprocess.run(["/usr/bin/git", "--no-replace-objects", "-C", str(ROOT), "worktree", "remove", "--force", str(workspace)], capture_output=True)
            shutil.rmtree(workspace, ignore_errors=True)
    finally:
        lease.unlink(missing_ok=True)

try:
    if len(sys.argv) != 3 or sys.argv[1] != "run": raise model.Refusal("usage: run <config>")
    raise SystemExit(run_loop(load_config(sys.argv[2])))
except model.Refusal as exc:
    print("loop refusal: " + str(exc), file=sys.stderr)
    raise SystemExit(1)
'''


REFERENCE_AUTOPILOT = r'''#!/usr/bin/env python3.12
from __future__ import annotations
import json, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

def main():
    if len(sys.argv) != 4 or sys.argv[1] != "scope-check":
        print("usage", file=sys.stderr); return 2
    task_id, candidate = sys.argv[2], sys.argv[3]
    base = subprocess.run(["/usr/bin/git", "--no-replace-objects", "-C", str(ROOT), "rev-parse", "refs/remotes/origin/main"], text=True, capture_output=True).stdout.strip()
    req = {"authority_sha": base, "task_id": task_id, "base_sha": base, "candidate_sha": candidate}
    p = subprocess.run([str(ROOT / "controller/authority/cli"), "check-candidate"], cwd=str(ROOT), input=json.dumps(req), text=True, capture_output=True)
    sys.stdout.write(p.stdout); sys.stderr.write(p.stderr); return p.returncode

raise SystemExit(main())
