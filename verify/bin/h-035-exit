def status_emit(kind,**fields):
    status_sequence[0]+=1
    row={"schema":1,"nonce":status_nonce,"call":status_call,"seq":status_sequence[0],
         "kind":kind,"branch":status_branch,**fields}
    unsigned=status_json_dumps(row,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode()
    row["mac"]=status_hmac_new(status_key,unsigned,hashlib.sha256).hexdigest()
    raw=(status_json_dumps(row,sort_keys=True,separators=(",",":"))+"\n").encode()
    if len(raw)>4096:raise RuntimeError("R15 judge status oversized")
    offset=0
    while offset<len(raw):offset+=status_os_write(status_fd,raw[offset:])
def status_protocol_raw(row,correct_mac=True,newline=True):
    unsigned=status_json_dumps(row,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode()
    row=dict(row);row["mac"]=status_hmac_new(status_key,unsigned,hashlib.sha256).hexdigest()
    if not correct_mac:row["mac"]="0"*64
    raw=(status_json_dumps(row,sort_keys=True,separators=(",",":"))+("\n" if newline else "")).encode()
    offset=0
    while offset<len(raw):offset+=status_os_write(status_fd,raw[offset:])
def status_fire(primitive,identity=None):
