    version_variants: list[tuple[str, object]] = [
        ("INT_0", 0), ("INT_3", 3), ("STRING_1", "1"), ("STRING_2", "2"),
        ("BOOL_FALSE", False), ("BOOL_TRUE", True),
        ("FLOAT_1", 1.0), ("FLOAT_2", 2.0),
