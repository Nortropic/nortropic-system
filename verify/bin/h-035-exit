    publication_calls=[node for node in ast.walk(gate_tree)
        if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
        and node.func.id=="r15_contract_publication_proof"]
    dual_definition=next((node for node in gate_tree.body
        if isinstance(node,ast.FunctionDef)
        and node.name=="r26_dual_review_values"),None)
    dual_calls=[node for node in ast.walk(gate_tree)
        if isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
        and node.func.id=="r26_dual_review_values"]
    lane_override_calls=[node for node in dual_calls
        if any(keyword.arg=="review_lanes" for keyword in node.keywords)]
    judge_calls=[node for node in publication_calls
        if any(keyword.arg=="judge_fixture_artifacts" for keyword in node.keywords)]
    def enclosing_name(node: ast.AST) -> str:
        cursor=gate_parents.get(id(node))
        while cursor is not None:
            if isinstance(cursor,(ast.FunctionDef,ast.AsyncFunctionDef)):return cursor.name
            cursor=gate_parents.get(id(cursor))
        return ""
    def guarded_by_name(node: ast.AST, name: str) -> bool:
        cursor=gate_parents.get(id(node))
        while cursor is not None:
            if (isinstance(cursor,ast.If) and isinstance(cursor.test,ast.Name)
                    and cursor.test.id==name): return True
            cursor=gate_parents.get(id(cursor))
        return False
    judge_keyword=(next((keyword.value for keyword in judge_calls[0].keywords
                         if keyword.arg=="judge_fixture_artifacts"),None)
                   if len(judge_calls)==1 else None)
    check(isinstance(publication_definition,ast.FunctionDef)
          and [value.arg for value in publication_definition.args.kwonlyargs]
              == ["observe_remote","judge_fixture_artifacts"]
          and len(publication_definition.args.kw_defaults)==2
          and publication_definition.args.kw_defaults[0] is None
          and isinstance(publication_definition.args.kw_defaults[1],ast.Constant)
          and publication_definition.args.kw_defaults[1].value is False
          and len(judge_calls)==1
          and enclosing_name(judge_calls[0])=="r15_h038_refreeze_proof"
          and isinstance(judge_keyword,ast.Constant) and judge_keyword.value is True
          and all(enclosing_name(call)!="r15_product_identity" or call not in judge_calls
                  for call in publication_calls)
          and isinstance(dual_definition,ast.FunctionDef)
          and [value.arg for value in dual_definition.args.kwonlyargs]==["review_lanes"]
          and len(dual_definition.args.kw_defaults)==1
          and isinstance(dual_definition.args.kw_defaults[0],ast.Constant)
          and dual_definition.args.kw_defaults[0].value is None
          and len(lane_override_calls)==5
          and sum(enclosing_name(call)=="r15_contract_publication_proof"
                  and guarded_by_name(call,"judge_fixture_artifacts")
                  for call in lane_override_calls)==1,
          "J_R26_JUDGE_FIXTURE_DEFAULT_FALSE_EXACT_TWO_STATE_AND_PRODUCT_UNREACHABLE")
    h038_rows=[row for row in tasks if isinstance(row,dict) and row.get("id")=="h-038"]
    r29_base_h038=[row for row in r29_base_spec.get("tasks",[])
        if isinstance(row,dict) and row.get("id")=="h-038"] \
        if isinstance(r29_base_spec,dict) else []
    check(len(h038_rows)==len(r29_base_h038)==1
          and exact_value(h038_rows[0],r29_base_h038[0]),
          "F_R15_CURRENT_H038_UNCHANGED_UNTIL_SEPARATE_REFREEZE")
    check(hashlib.sha256(base64.b64decode(R15_H036_REVIEW_B64)).hexdigest()
              == R15_H036["review_sha256"]
          and hashlib.sha256(base64.b64decode(R15_H036_RECEIPT_B64)).hexdigest()
              == R15_H036["receipt_sha256"],
          "J_R15_H036_HISTORICAL_ARTIFACT_BYTES_EXACT")


def r15_lower_hex(value: object, size: int) -> bool:
    return isinstance(value, str) and re.fullmatch(f"[0-9a-f]{{{size}}}", value) is not None


def r15_candidate_identity(task: str, base: str, candidate_sha: str,
                           candidate_tree: str, changed_files_value: list[str],
                           transition_identity: str, review_identity: str,
                           review_result: str = "PASS",
                           reviewer_role: str = "PRODUCT_REVIEWER") -> str:
    return canonical_json_sha256({
        "record_type":"owner_candidate_v1", "task":task, "base_sha":base,
        "candidate_sha":candidate_sha, "candidate_tree":candidate_tree,
        "changed_files":changed_files_value,
        "transition_identity":transition_identity,
        "review_identity":review_identity, "review_result":review_result,
        "reviewer_role":reviewer_role,
    })


def r15_transition_object(task: str, base: str, spec_sha256: str,
                          registry_sha256: str, gate_path: str, gate_sha256: str,
                          repository_identity: str,
                          dependency_sha256: str) -> dict[str, object]:
    return {
        "record_type":"owner_transition_v1", "task":task,
        "authority_class":"owner_authority", "base_sha":base, "main_sha":base,
        "spec_path":"specs/tasks.spec.json", "spec_sha256":spec_sha256,
        "registry_path":"specs/owner-production-paths.v1.json",
        "registry_sha256":registry_sha256, "gate_path":gate_path,
        "gate_sha256":gate_sha256, "repository_identity":repository_identity,
        "dependency_attestations_sha256":dependency_sha256,
    }


def r15_claim_event(task: str, base: str, spec_sha256: str,
                    registry_sha256: str, gate_path: str, gate_sha256: str,
                    repository_identity: str, dependency_sha256: str) -> dict[str, object]:
    binding = r15_transition_object(
        task, base, spec_sha256, registry_sha256, gate_path, gate_sha256,
        repository_identity, dependency_sha256)
    return {key:value for key,value in (
        ("task",task), ("status","OWNER_ACTION_REQUIRED"),
        ("authority_class","owner_authority"), ("base_sha",base),
        ("main_sha",base), ("spec_path","specs/tasks.spec.json"),
        ("spec_sha256",spec_sha256),
        ("registry_path","specs/owner-production-paths.v1.json"),
        ("registry_sha256",registry_sha256), ("gate_path",gate_path),
        ("gate_sha256",gate_sha256), ("repository_identity",repository_identity),
        ("dependency_attestations_sha256",dependency_sha256),
        ("transition_identity",canonical_json_sha256(binding)),
    )}


def r15_provisional_event(claim: dict[str,object], workspace_root: Path) -> dict[str,object]:
    value={key:claim[key] for key in R15_CLAIM_FIELDS}
    value["status"]="OWNER_CANDIDATE_REVIEW_REQUIRED"
    value["candidate_sha"]=claim["base_sha"]
    value["workspace_root"]=str(workspace_root)
    value["workspace_identity"]=r15_workspace_identity(workspace_root)
    return value


def r15_checked_event(claim: dict[str,object], *, candidate_sha: str,
                      candidate_tree: str, changed_files_value: list[str],
                      workspace_root: Path) -> dict[str,object]:
    value={key:claim[key] for key in R15_CLAIM_FIELDS}
    value["status"]="OWNER_CANDIDATE_CHECKED"
    value.update({"candidate_sha":candidate_sha,"candidate_tree":candidate_tree,
                  "changed_files":changed_files_value,"workspace_root":str(workspace_root),
                  "workspace_identity":r15_workspace_identity(workspace_root)})
    return value


def r15_adopted_event(claim: dict[str,object], *, candidate_sha: str,
                      candidate_tree: str, changed_files_value: list[str],
                      candidate_identity: str, review_path: Path,
                      review_stat_identity: str, review_identity: str,
                      workspace_root: Path, status_value: str) -> dict[str,object]:
    value={key:claim[key] for key in R15_CLAIM_FIELDS}
    value["status"]=status_value
    value.update({
        "candidate_sha":candidate_sha,"candidate_tree":candidate_tree,
        "changed_files":changed_files_value,"candidate_identity":candidate_identity,
        "review_path":str(review_path),"review_stat_identity":review_stat_identity,
        "review_identity":review_identity,"review_result":"PASS",
        "reviewer_role":"PRODUCT_REVIEWER","workspace_root":str(workspace_root),
        "workspace_identity":r15_workspace_identity(workspace_root),
    })
    return value


def r15_owner_publication_valid(value: object, *, task: str,
                                repository_identity: str) -> tuple[bool, str]:
    if not isinstance(value, dict) or set(value) != set(R15_OWNER_PUBLICATION_FIELDS):
        return False, "field membership"
    if (value.get("record_type") != "owner_publication_v1"
            or type(value.get("schema_version")) is not int
            or value.get("schema_version") != 1
            or value.get("authority_class") != "owner_authority"
            or value.get("task") != task
            or value.get("repository_identity") != repository_identity
            or value.get("review_result") != "PASS"
            or value.get("stale") is not False):
        return False, "constant/task/repository/validity"
    for key in ("base_sha", "candidate_sha", "candidate_tree", "publication_sha"):
        if not r15_lower_hex(value.get(key), 40): return False, key
    for key in ("spec_sha256", "registry_sha256", "gate_sha256",
                "dependency_attestations_sha256", "transition_identity",
                "candidate_identity", "review_identity"):
        if not r15_lower_hex(value.get(key), 64): return False, key
    if value.get("spec_path") != "specs/tasks.spec.json": return False, "spec path"
    if value.get("registry_path") != "specs/owner-production-paths.v1.json":
        return False, "registry path"
    try: parse_path(value.get("gate_path"))
    except ValueError: return False, "gate path"
    if value.get("invalidates_on") != [value.get("candidate_sha"), value.get("publication_sha")]:
        return False, "invalidates_on"
    files = value.get("changed_files")
    if (not isinstance(files, list) or not files
            or files != sorted(set(files))
            or not all(isinstance(item, str) and not _bad_path(item) for item in files)):
        return False, "changed_files"
    if task == "h-036":
        pinned = all(value.get(key) == R15_H036[key] for key in (
            "base_sha", "candidate_sha", "candidate_tree", "publication_sha",
            "spec_sha256", "registry_sha256", "gate_path", "gate_sha256"))
        pinned = (pinned
                  and value.get("dependency_attestations_sha256")
                      == R15_H036["dependency_attestations_sha256"]
                  and value.get("review_identity") == R15_H036["review_sha256"]
                  and files == [row[0] for row in R15_H036_PATHS_MODES])
        if not pinned: return False, "historical h036 pins"
        expected_transition = canonical_json_sha256(
            r15_h036_transition_object(repository_identity))
    else:
        expected_transition = canonical_json_sha256(r15_transition_object(
            task, str(value["base_sha"]), str(value["spec_sha256"]),
            str(value["registry_sha256"]), str(value["gate_path"]),
            str(value["gate_sha256"]), repository_identity,
            str(value["dependency_attestations_sha256"])))
    if value.get("transition_identity") != expected_transition:
        return False, "transition identity"
    expected_candidate = r15_candidate_identity(
        task, str(value["base_sha"]), str(value["candidate_sha"]),
        str(value["candidate_tree"]), files, str(value["transition_identity"]),
        str(value["review_identity"]), str(value["review_result"]))
    if value.get("candidate_identity") != expected_candidate:
        return False, "candidate identity"
    return True, "ok"


def r15_schema_selftests() -> None:
    transition = canonical_json_sha256(r15_transition_object(
        "h-038", "1"*40, "5"*64, "6"*64, "verify/bin/h-038-exit",
        "7"*64, "fixture-origin", "9"*64))
    changed = ["controller/launch/cli"]
    record: dict[str, object] = {
        "record_type":"owner_publication_v1", "schema_version":1,
        "authority_class":"owner_authority", "task":"h-038",
        "base_sha":"1"*40, "candidate_sha":"2"*40,
        "candidate_tree":"3"*40, "publication_sha":"4"*40,
        "invalidates_on":["2"*40,"4"*40],
        "spec_path":"specs/tasks.spec.json", "spec_sha256":"5"*64,
        "registry_path":"specs/owner-production-paths.v1.json",
        "registry_sha256":"6"*64, "gate_path":"verify/bin/h-038-exit",
        "gate_sha256":"7"*64, "dependency_attestations_sha256":"9"*64,
        "transition_identity":transition,
        "candidate_identity":r15_candidate_identity(
            "h-038", "1"*40, "2"*40, "3"*40, changed, transition, "8"*64),
        "changed_files":changed, "review_identity":"8"*64,
        "review_result":"PASS", "repository_identity":"fixture-origin",
        "stale":False,
    }
    ok, why = r15_owner_publication_valid(
        record, task="h-038", repository_identity="fixture-origin")
    check(ok, "J_R15_OWNER_PUBLICATION_V1_SCHEMA_POSITIVE", why)
    mutants: list[dict[str, object]] = []
    for key in record:
        mutant=json.loads(json.dumps(record)); mutant.pop(key); mutants.append(mutant)
    mutant=json.loads(json.dumps(record)); mutant["extra"]="authority"; mutants.append(mutant)
    for key,value in (
        ("record_type","ordinary"), ("schema_version",True),
        ("authority_class","ordinary"), ("task","h-036"),
        ("repository_identity","copied-origin"), ("review_result","READY"),
        ("stale",True), ("candidate_sha","A"*40),
        ("candidate_tree",3.0), ("spec_path","./specs/tasks.spec.json"),
        ("registry_path","specs/other.json"), ("gate_path","../gate"),
    ):
        mutant=json.loads(json.dumps(record)); mutant[key]=value; mutants.append(mutant)
    for invalidates in ([record["publication_sha"],record["candidate_sha"]],
                        [record["candidate_sha"]],
                        [record["candidate_sha"],record["publication_sha"],record["publication_sha"]]):
        mutant=json.loads(json.dumps(record)); mutant["invalidates_on"]=invalidates; mutants.append(mutant)
    for files in ([], ["controller/launch/cli","controller/launch/cli"],
                  ["../escape"], ["z","a"]):
        mutant=json.loads(json.dumps(record)); mutant["changed_files"]=files; mutants.append(mutant)
    mutant=json.loads(json.dumps(record)); mutant["candidate_identity"]="9"*64; mutants.append(mutant)
    check(all(not r15_owner_publication_valid(
                  mutant, task="h-038", repository_identity="fixture-origin")[0]
              for mutant in mutants),
          "J_R15_OWNER_PUBLICATION_MISSING_EXTRA_TYPE_STALE_COPY_TASK_ORDER_IDENTITY_REJECT")

    h035={"task":"h-035","candidate_sha":"a"*40,
          "invalidates_on":["a"*40],"stale":False}
    h036=r15_h036_owner_publication("fixture-origin")
    ordered=[
        {"task":"h-035","authority_class":"ordinary","attestation":h035},
        {"task":"h-036","authority_class":"owner_authority","attestation":h036},
    ]
    digest=canonical_json_sha256(ordered)
    reversed_entries=list(reversed(ordered))
    wrong_class=json.loads(json.dumps(ordered)); wrong_class[0]["authority_class"]="owner_authority"
    reordered_objects=json.loads(json.dumps(ordered), object_pairs_hook=lambda pairs: dict(reversed(pairs)))
    check(digest != canonical_json_sha256(reversed_entries)
          and digest != canonical_json_sha256(wrong_class)
          and digest == canonical_json_sha256(reordered_objects),
          "J_R15_DEPENDENCY_DIGEST_BINDS_ORDER_AND_H035_ORDINARY_CLASS_NOT_OBJECT_MEMBER_ORDER")


def r15_h036_transition_object(repository_identity: str) -> dict[str, object]:
    return {
        "record_type":"historical_h036_transition_v1", "task":"h-036",
        "authority_class":"owner_authority", "base_sha":R15_H036["base_sha"],
        "main_sha":R15_H036["base_sha"],
        "candidate_sha":R15_H036["candidate_sha"],
        "candidate_tree":R15_H036["candidate_tree"],
        "publication_sha":R15_H036["publication_sha"],
        "ordered_parents":[R15_H036["base_sha"],R15_H036["candidate_sha"]],
        "spec_path":"specs/tasks.spec.json", "spec_sha256":R15_H036["spec_sha256"],
        "registry_path":"specs/owner-production-paths.v1.json",
        "registry_sha256":R15_H036["registry_sha256"],
        "gate_path":R15_H036["gate_path"], "gate_sha256":R15_H036["gate_sha256"],
        "changed_paths_and_modes":[list(row) for row in R15_H036_PATHS_MODES],
        "review_identity":R15_H036["review_sha256"],
        "review_artifact_path":R15_H036_REVIEW_PATH,
        "review_artifact_result":"READY", "reviewer_role":"PRODUCT_REVIEWER",
        "blocking_findings":[], "publication_receipt_sha256":R15_H036["receipt_sha256"],
        "publication_receipt_path":R15_H036_RECEIPT_PATH,
        "repository_identity":repository_identity,
        "dependency_attestations_sha256":R15_H036["dependency_attestations_sha256"],
    }


def r15_h036_owner_publication(repository_identity: str) -> dict[str, object]:
    transition = canonical_json_sha256(r15_h036_transition_object(repository_identity))
    changed = [row[0] for row in R15_H036_PATHS_MODES]
    candidate = r15_candidate_identity(
        "h-036", str(R15_H036["base_sha"]), str(R15_H036["candidate_sha"]),
        str(R15_H036["candidate_tree"]), changed, transition,
        str(R15_H036["review_sha256"]), "PASS", "PRODUCT_REVIEWER")
    return {
        "record_type":"owner_publication_v1", "schema_version":1,
        "authority_class":"owner_authority", "task":"h-036",
        "base_sha":R15_H036["base_sha"], "candidate_sha":R15_H036["candidate_sha"],
        "candidate_tree":R15_H036["candidate_tree"],
        "publication_sha":R15_H036["publication_sha"],
        "invalidates_on":[R15_H036["candidate_sha"],R15_H036["publication_sha"]],
        "spec_path":"specs/tasks.spec.json", "spec_sha256":R15_H036["spec_sha256"],
        "registry_path":"specs/owner-production-paths.v1.json",
        "registry_sha256":R15_H036["registry_sha256"],
        "gate_path":R15_H036["gate_path"], "gate_sha256":R15_H036["gate_sha256"],
        "dependency_attestations_sha256":R15_H036["dependency_attestations_sha256"],
        "transition_identity":transition, "candidate_identity":candidate,
        "changed_files":changed, "review_identity":R15_H036["review_sha256"],
        "review_result":"PASS", "repository_identity":repository_identity,
        "stale":False,
    }


def r15_h036_derivation_selftests() -> None:
    repository_identity = "/fixture/origin.git"
    review,_,_=r15_safe_artifact(Path(R15_H036_REVIEW_PATH))
    receipt,_,_=r15_safe_artifact(Path(R15_H036_RECEIPT_PATH))
    record = r15_h036_owner_publication(repository_identity)
    ok, why = r15_owner_publication_valid(
        record, task="h-036", repository_identity=repository_identity)
    check(ok
          and isinstance(review, dict) and review.get("role") == "PRODUCT_REVIEWER"
          and review.get("outcome") == "READY" and review.get("blocking_findings") == []
          and review.get("base_sha") == R15_H036["base_sha"]
          and review.get("candidate_sha") == R15_H036["candidate_sha"]
          and review.get("candidate_tree") == R15_H036["candidate_tree"]
          and isinstance(receipt, dict) and receipt.get("task_id") == "h-036"
          and receipt.get("merge_sha") == R15_H036["publication_sha"]
          and receipt.get("ordered_parents")
              == [R15_H036["base_sha"],R15_H036["candidate_sha"]],
          "J_R15_H036_FIXED_READY_REVIEW_RECEIPT_AND_GENERIC_RICH_DERIVATION", why)
    mutants=[]
    for key,value in (
        ("publication_sha", "0"*40), ("review_identity", "0"*64),
        ("repository_identity", "/copied/origin.git"),
        ("dependency_attestations_sha256", "0"*64),
    ):
        transition=r15_h036_transition_object(repository_identity); transition[key]=value
        mutants.append(canonical_json_sha256(transition))
    check(all(value != record["transition_identity"] for value in mutants)
          and record["candidate_identity"] == r15_candidate_identity(
              "h-036", str(record["base_sha"]), str(record["candidate_sha"]),
              str(record["candidate_tree"]), list(record["changed_files"]),
              str(record["transition_identity"]), str(record["review_identity"])),
          "J_R15_H036_DOMAIN_PINS_AND_GENERIC_CANDIDATE_IDENTITY_MUTANTS_REJECT")
    h038_oid=r15_git(ROOT,"rev-parse",
        f"{H035_R15_BASE}:verify/bin/h-038-exit")
    h038_raw=r15_git_object_bytes(ROOT,H035_R15_BASE,"verify/bin/h-038-exit")
    try:
        h038_tree=ast.parse((h038_raw or b"").decode("utf-8",errors="strict"))
    except (SyntaxError,UnicodeError):
        h038_tree=ast.Module(body=[],type_ignores=[])
    derived={}
    for node in h038_tree.body:
        if (isinstance(node,ast.Assign) and len(node.targets)==1
                and isinstance(node.targets[0],ast.Name)
                and node.targets[0].id in {"PRODUCT_PATHS","PRODUCT_MODES","H036_TASK_SHA256",
                    "OLD_PRODUCT_SHA256","PINNED_UNCHANGED","PUBLISHED_H036_PRODUCT",
                    "PUBLISHED_H036_PRODUCT_TREE","PUBLISHED_H036_MERGE",
                    "PUBLISHED_H036_MERGE_PARENTS"}):
            try: derived[node.targets[0].id]=ast.literal_eval(node.value)
            except (TypeError,ValueError):
                if (node.targets[0].id=="PUBLISHED_H036_MERGE_PARENTS"
                        and isinstance(node.value,ast.List)):
                    derived[node.targets[0].id]=[
                        item.value if isinstance(item,ast.Constant)
                        else derived.get("PUBLISHED_H036_PRODUCT")
                        for item in node.value.elts]
                else: derived[node.targets[0].id]=None
    candidate_parents=r15_git(ROOT,"show","-s","--format=%P",
                              str(R15_H036["candidate_sha"]))
    candidate_tree=r15_git(ROOT,"show","-s","--format=%T",
                           str(R15_H036["candidate_sha"]))
    publication_parents=r15_git(ROOT,"show","-s","--format=%P",
                                str(R15_H036["publication_sha"]))
    publication_tree=r15_git(ROOT,"show","-s","--format=%T",
                             str(R15_H036["publication_sha"]))
    graph={"base":R15_H036["base_sha"],
           "product":derived.get("PUBLISHED_H036_PRODUCT"),
           "product_tree":derived.get("PUBLISHED_H036_PRODUCT_TREE"),
           "merge":derived.get("PUBLISHED_H036_MERGE"),
           "parents":derived.get("PUBLISHED_H036_MERGE_PARENTS"),
           "actual_product_parents":candidate_parents.stdout.split(),
           "actual_product_tree":candidate_tree.stdout.strip(),
           "actual_merge_parents":publication_parents.stdout.split(),
           "actual_merge_tree":publication_tree.stdout.strip()}
    expected_graph={"base":R15_H036["base_sha"],
        "product":R15_H036["candidate_sha"],"product_tree":R15_H036["candidate_tree"],
        "merge":R15_H036["publication_sha"],
        "parents":[R15_H036["base_sha"],R15_H036["candidate_sha"]],
        "actual_product_parents":[R15_H036["base_sha"]],
        "actual_product_tree":R15_H036["candidate_tree"],
        "actual_merge_parents":[R15_H036["base_sha"],R15_H036["candidate_sha"]],
        "actual_merge_tree":R15_H036["candidate_tree"]}
    graph_commands=(h038_oid,candidate_parents,candidate_tree,
                    publication_parents,publication_tree)
    check(all(value.returncode==0 and value.stderr=="" for value in graph_commands)
          and h038_oid.stdout.strip()==R15_H036_H038_GATE_BLOB_OID
          and graph==expected_graph,
          "J_R15_H036_IMMUTABLE_H038_GATE_AND_GIT_GRAPH_DERIVATION")
    product_paths=derived.get("PRODUCT_PATHS")
    product_modes=derived.get("PRODUCT_MODES")
    product_digests=derived.get("OLD_PRODUCT_SHA256")
    unchanged=derived.get("PINNED_UNCHANGED")
    diff=r15_git(ROOT,"diff","--name-status","--no-renames",
                 str(R15_H036["base_sha"]),str(R15_H036["candidate_sha"]))
    tree_rows=r15_git(ROOT,"ls-tree",str(R15_H036["candidate_sha"]),"--",*product_paths)
    observed_modes={row.split("\t",1)[1]:row.split()[0]
                    for row in tree_rows.stdout.splitlines() if "\t" in row}
    observed_digests={path:hashlib.sha256(r15_git_object_bytes(
        ROOT,str(R15_H036["candidate_sha"]),path) or b"").hexdigest()
        for path in product_paths}
    historical={path:{sha:hashlib.sha256(r15_git_object_bytes(ROOT,sha,path)
                    or b"").hexdigest() for sha in (str(R15_H036["base_sha"]),
                    str(R15_H036["publication_sha"]))}
        for path in ("specs/tasks.spec.json","specs/owner-production-paths.v1.json",
                     "verify/bin/h-036-exit")}
    historical_spec=strict_json_bytes(r15_git_object_bytes(
        ROOT,str(R15_H036["base_sha"]),"specs/tasks.spec.json") or b"")
    historical_h036_rows=[row for row in historical_spec.get("tasks",[])
                          if isinstance(row,dict) and row.get("id")=="h-036"]
    task_row_sha=(canonical_json_sha256(historical_h036_rows[0])
                  if len(historical_h036_rows)==1 else "")
    expected_diff=[("M" if path=="controller/launch/cli" else "A")+"\t"+path
                   for path in sorted(product_paths)]
    bridge_facts={"paths":product_paths,"modes":product_modes,
        "digests":product_digests,"diff":diff.stdout.splitlines(),
        "observed_modes":observed_modes,"observed_digests":observed_digests,
        "historical":historical,"unchanged":unchanged,
        "task_row_sha":task_row_sha,"derived_task_row_sha":derived.get("H036_TASK_SHA256")}
    def bridge_valid(value: object) -> bool:
        return (isinstance(value,dict) and value.get("paths")==[
            "controller/launch/cli","controller/launch/runtime_snapshot.py",
            "config/python-runtime-authority-v2.json"]
            and value.get("modes")==dict(R15_H036_PATHS_MODES)
            and value.get("digests")==value.get("observed_digests")
            and value.get("diff")==expected_diff
            and value.get("observed_modes")==value.get("modes")
            and value.get("historical")=={
                "specs/tasks.spec.json":{str(R15_H036["base_sha"]):R15_H036["spec_sha256"],
                    str(R15_H036["publication_sha"]):R15_H036["spec_sha256"]},
                "specs/owner-production-paths.v1.json":{
                    str(R15_H036["base_sha"]):R15_H036["registry_sha256"],
                    str(R15_H036["publication_sha"]):R15_H036["registry_sha256"]},
                "verify/bin/h-036-exit":{str(R15_H036["base_sha"]):R15_H036["gate_sha256"],
                    str(R15_H036["publication_sha"]):R15_H036["gate_sha256"]}}
            and value.get("task_row_sha")==value.get("derived_task_row_sha")
            and value.get("task_row_sha")=="8d3742bbf6d791872c8f9173b3ff20afca9b6139615b64397498e05bda61826f"
            and value.get("unchanged")=={
                "verify/bin/h-035-exit":"cae895110129f5066be9ae7f770e7f4e96594698ef5500d586820fea472d27e2",
                "verify/bin/h-036-exit":R15_H036["gate_sha256"],
                "verify/bin/h-037-exit":"814deb69fbc6e34e57ebc89b62bf7d54281bc95a4207332ff94792d90d0e6dc3",
                "specs/owner-production-paths.v1.json":R15_H036["registry_sha256"],
                "docs/loop/remaining-bootstrap-delegation-v1.md":"0ad4cbc03b3b70c6b61ef6adc76a31decd4300f2b6a8a2b9f632c3f6719ac36f",
                "docs/07-konstitution.md":"2e7f04cca9eb00d24b264b91a0678aaee68c97441d79846d81aeff2f8d7b4432"})
    check(diff.returncode==tree_rows.returncode==0 and diff.stderr==tree_rows.stderr==""
          and bridge_valid(bridge_facts),
          "J_R15_H036_H038_DERIVED_SCOPE_MODES_BLOBS_AND_HISTORICAL_IDENTITIES")
    bridge_mutants=[]
    for key in bridge_facts:
        mutant=copy.deepcopy(bridge_facts)
        if isinstance(mutant[key],list): mutant[key]=list(reversed(mutant[key]))+["extra"]
        elif isinstance(mutant[key],dict): mutant[key]["alias"]="0"*64
        else: mutant[key]="0"*64
        bridge_mutants.append(mutant)
    check(all(not bridge_valid(value) for value in bridge_mutants),
          "J_R15_H036_REAL_BRIDGE_SCOPE_MODE_BYTE_PATH_ALIAS_MUTANTS_REJECT")
    review_value,review_raw,review_sha=r15_safe_artifact(Path(R15_H036_REVIEW_PATH))
    receipt_value,receipt_raw,receipt_sha=r15_safe_artifact(Path(R15_H036_RECEIPT_PATH))
    check(review_sha==R15_H036["review_sha256"]
          and receipt_sha==R15_H036["receipt_sha256"]
          and isinstance(review_value,dict) and isinstance(receipt_value,dict)
          and review_value.get("base_sha")==R15_H036["base_sha"]
          and review_value.get("candidate_sha")==R15_H036["candidate_sha"]
          and review_value.get("candidate_tree")==R15_H036["candidate_tree"]
          and receipt_value.get("base_sha")==R15_H036["base_sha"]
          and receipt_value.get("candidate_sha")==R15_H036["candidate_sha"]
          and receipt_value.get("candidate_tree")==R15_H036["candidate_tree"]
          and receipt_value.get("merge_sha")==R15_H036["publication_sha"]
          and receipt_value.get("ordered_parents")==expected_graph["parents"]
          and receipt_value.get("task_spec_sha256")==R15_H036["spec_sha256"]
          and receipt_value.get("gate_sha256")==R15_H036["gate_sha256"]
          and receipt_value.get("product_paths")==product_paths
          and receipt_value.get("independent_review_path")==R15_H036_REVIEW_PATH
          and receipt_value.get("independent_review_sha256")==R15_H036["review_sha256"]
          and [row.get("path") for row in review_value.get("changed_files",[])]
              ==sorted(product_paths)
          and {row.get("path"):row.get("mode_after")
               for row in review_value.get("changed_files",[])}==product_modes
          and {row.get("path"):row.get("sha256")
               for row in review_value.get("changed_files",[])}==product_digests,
          "J_R15_H036_FIXED_EXTERNAL_REVIEW_RECEIPT_RETAINED_IDENTITY")
    artifact_expected=[]
    for artifact,digest in ((Path(R15_H036_REVIEW_PATH),R15_H036["review_sha256"]),
                            (Path(R15_H036_RECEIPT_PATH),R15_H036["receipt_sha256"])):
        info=os.lstat(artifact)
        artifact_expected.append({"path":str(artifact),"digest":digest,
            "regular":stat.S_ISREG(info.st_mode),"mode":stat.S_IMODE(info.st_mode),
            "uid":info.st_uid,"nlink":info.st_nlink})
    artifact_mutants=[]
    for index in range(2):
        for key,value in (("path","/relocated"),("digest","0"*64),("regular",False),
                          ("mode",0o600),("uid",os.getuid()+1),("nlink",2)):
            mutant=copy.deepcopy(artifact_expected);mutant[index][key]=value
            artifact_mutants.append(mutant)
    check(all(row["regular"] and row["mode"]==0o644
              and row["uid"]==os.getuid() and row["nlink"]==1
              for row in artifact_expected)
          and all(value!=artifact_expected for value in artifact_mutants),
          "J_R15_H036_ARTIFACT_PATH_DIGEST_TYPE_MODE_UID_NLINK_MUTANTS_REJECT")
    material_rejects=[]
    with tempfile.TemporaryDirectory(prefix="h035-hr02-artifact-",dir="/private/tmp") as raw:
        root=Path(raw).resolve(); good=root/"good.json";good.write_bytes(b"{}\n");good.chmod(0o644)
        hard=root/"hard.json";os.link(good,hard)
        symlink=root/"symlink.json";symlink.symlink_to(good)
        directory=root/"directory.json";directory.mkdir(mode=0o700)
        wrong_mode=root/"mode.json";wrong_mode.write_bytes(b"{}\n");wrong_mode.chmod(0o600)
        for path in (hard,symlink,directory,wrong_mode,Path("relative.json")):
            try: r15_stable_regular_bytes(path,modes=(0o644,)); material_rejects.append(False)
            except Rig: material_rejects.append(True)
    check(material_rejects==[True]*5,
          "J_R15_H036_MATERIAL_ARTIFACT_HARDLINK_SYMLINK_TYPE_MODE_ALIAS_REJECT")
    current=strict_json_bytes(SPEC.read_bytes())
    h035=next(row for row in current["tasks"] if row.get("id")=="h-035")
    bridge=h035["r15_owner_product_lifecycle"]["historical_h036_import"]
    sentinel=bridge.get("owner_dependency_migration_binding")
    expected_sentinel=[{"attestation_state":"PRE_OWNER_PUBLICATION_V1_HISTORICAL_MIGRATION",
        "authority_class":"owner_authority",
        "published_h036_receipt_sha256":R15_H036["receipt_sha256"],"task":"h-034"}]
    check(sentinel==expected_sentinel and len(sentinel)==1
          and canonical_json_sha256(sentinel)==R15_H036["dependency_attestations_sha256"],
          "J_R15_H036_EXACT_ONE_HISTORICAL_MIGRATION_DEPENDENCY_SENTINEL")
    graph_mutants=[]
    for key in expected_graph:
