def strict_json_bytes(raw: bytes) -> object:
    def pairs(items: list[tuple[str, object]]) -> dict[str, object]:
        out: dict[str, object] = {}
        for key, value in items:
            if key in out: raise ValueError(f"duplicate key {key}")
            out[key] = value
        return out
    return json.loads(raw.decode("utf-8", errors="strict"), object_pairs_hook=pairs)


def exact_value(actual: object, expected: object) -> bool:
    if type(actual) is not type(expected): return False
    if isinstance(expected, dict): return tuple(actual) == tuple(expected) and all(exact_value(actual[key],value) for key,value in expected.items())
    if isinstance(expected, list):
        return len(actual) == len(expected) and all(exact_value(a,b) for a,b in zip(actual,expected))
    return actual == expected


def validate_bpam_contract(doc: object) -> tuple[bool, str]:
    keys = (
        "schema_version","contract_id","source_sha256","scope","condition_operator",
        "hard_stop_precedence","incomplete_proof_result","owner_decision_required","delegation_predicate",
        "legacy_stop_boundary_precedence","conditions",
        "bp05_exact_dimensions","authorized_internal_migrations","authorized_migrations_require",
        "true_human_hard_stops","required_serial_transitions","sequence_rule",
        "downstream_rebind_rule","review_binding","preproduct_red_rule","forbidden_authorities",
        "activation_condition","fail_closed",
    )
    if not isinstance(doc, dict) or tuple(doc) != keys: return False, "top-level keys/order"
    scalars = (
        type(doc["schema_version"]) is int and doc["schema_version"] == 1,
        doc["contract_id"] == "BOUNDED_PREREQUISITE_AUTHORITY_MIGRATION",
        doc["source_sha256"] == BPAM_SECTION_DIGESTS["source"],
        doc["scope"] == "REMAINING_NORTROPIC_BOOTSTRAP_INSIDE_ALREADY_APPROVED_OBJECTIVES",
        doc["condition_operator"] == "ALL",
        doc["hard_stop_precedence"] == "BEFORE_DELEGATED_AUTHORITY",
        doc["incomplete_proof_result"] == "NO_DELEGATED_AUTHORITY",
        doc["owner_decision_required"] == "INTERNAL_ARCHITECT_ORCHESTRATOR_SIGNAL_ONLY_WHEN_HARD_STOP_MATCHES_NO_AND_ALL_CONDITIONS_HOLD",
        doc["delegation_predicate"] == "HARD_STOP_MATCHES=NO_AND_BP01_THROUGH_BP14=ALL_TRUE_IMPLIES_OWNER_DECISION_REQUIRED=INTERNAL_ARCHITECT_ORCHESTRATOR_SIGNAL",
        doc["authorized_migrations_require"] == "HARD_STOP_MATCHES_NO_AND_BP01_THROUGH_BP14_ALL_TRUE",
        doc["sequence_rule"] == "STRICT_HAPPENS_BEFORE_WITH_ADDITIONAL_REMEDIATION_STEPS_PERMITTED",
        doc["downstream_rebind_rule"] == "CHANGED_DOWNSTREAM_REBIND_MUST_BE_GUARDEDLY_PUBLISHED_BEFORE_CONTINUATION",
        doc["review_binding"] == "INDEPENDENT_EXACT_IMMUTABLE_CANDIDATE_IDENTITY_NO_SAME_SUBJECT_REVIEW",
        doc["preproduct_red_rule"] == "ONLY_EXACT_FROZEN_GATE_LABEL_AND_REASON_MAY_AUTHORIZE_EXPLICIT_PREPRODUCT_RED",
        type(doc["fail_closed"]) is bool and doc["fail_closed"] is True,
    )
    if not all(scalars): return False, "scalar contract"
    precedence = {"superseded_terms":["PROVEN_ARCHITECTURAL_IMPOSSIBILITY","NOVEL_MATERIAL_AUTHORITY_EXPANSION"],
        "superseded_only_when":"HARD_STOP_MATCHES_NO_AND_BP01_THROUGH_BP14_ALL_TRUE",
        "remaining_human_stops":["OBJECTIVE_LEVEL_IMPOSSIBILITY","AUTHORITY_EXPANSION_BEYOND_APPROVED_OBJECTIVE_REQUIREMENTS"]}
    if not exact_value(doc["legacy_stop_boundary_precedence"],precedence): return False, "legacy stop precedence"
    rows = doc["conditions"]
    if not isinstance(rows, list) or any(not isinstance(row, dict) or tuple(row) != ("id","requirement") for row in rows):
        return False, "condition shape"
    if tuple((row["id"],row["requirement"]) for row in rows) != BPAM_CONDITIONS: return False, "conditions"
    if doc["bp05_exact_dimensions"] != ["TASK_IDENTITY","DEPENDENCY_CHANGE","FILE_PATH_AUTHORITY",
        "ALLOWED_WRITE_SURFACE","AUTHORITY_TRANSITION","EXPECTED_EFFECTS"]: return False, "BP05 dimensions"
    if tuple(doc["authorized_internal_migrations"]) != BPAM_MIGRATIONS: return False, "migrations"
    if tuple(doc["true_human_hard_stops"]) != BPAM_HARD_STOPS: return False, "hard stops"
    if tuple(doc["required_serial_transitions"]) != BPAM_TRANSITIONS: return False, "transitions"
    if tuple(doc["forbidden_authorities"]) != BPAM_FORBIDDEN: return False, "forbidden authority"
    activation = doc["activation_condition"]
    expected_activation = {"trigger":"VERIFIED_CANONICAL_PUBLICATION", "candidate_bytes_activate":False,
        "required_evidence":["EXACT_CANONICAL_COMMIT","EXACT_CANONICAL_TREE",
                             "EXACT_DELEGATION_DOCUMENT_SHA256","POSTPUBLICATION_GATE_VERIFICATION"],
        "report":"BOUNDED_PREREQUISITE_AUTHORITY_MIGRATION=ACTIVE", "report_only_after_evidence":True}
    if activation != expected_activation or any(type(activation[k]) is not bool for k in ("candidate_bytes_activate","report_only_after_evidence")):
        return False, "activation"
    return True, "ok"


def bpam_document(raw: bytes) -> tuple[bool, str, object | None]:
    markers = (BPAM_AMENDMENT,BPAM_CONTRACT_BEGIN,BPAM_CONTRACT_END,BPAM_SOURCE_BEGIN,BPAM_SOURCE_END)
    if any(raw.count(marker) != 1 for marker in markers): return False, "marker count", None
    prefix, tail = raw.split(BPAM_AMENDMENT, 1); preamble, tail = tail.split(BPAM_CONTRACT_BEGIN, 1)
    contract_raw, tail = tail.split(BPAM_CONTRACT_END, 1); bridge, tail = tail.split(BPAM_SOURCE_BEGIN, 1)
    source, trailing = tail.split(BPAM_SOURCE_END, 1)
    sections = {"prefix":prefix,"preamble":preamble,"contract":contract_raw,"bridge":bridge,"source":source}
    if trailing: return False, "trailing bytes", None
    if any(hashlib.sha256(value).hexdigest() != BPAM_SECTION_DIGESTS[name] for name,value in sections.items()):
        return False, "section digest", None
    try: contract = strict_json_bytes(contract_raw)
    except (UnicodeError, ValueError, json.JSONDecodeError) as exc: return False, f"contract parse {exc}", None
    ok, why = validate_bpam_contract(contract)
    return ok, why, contract


def bpam_selftests(raw: bytes, contract: dict[str, object]) -> None:
    def clone() -> dict[str, object]: return json.loads(json.dumps(contract))
    def reject(doc: object) -> bool: return not validate_bpam_contract(doc)[0]
    check(validate_bpam_contract(contract) == (True,"ok"), "J_BPAM_MACHINE_CONTRACT_POSITIVE")
    missing = []
    for key in tuple(contract): mutant=clone(); mutant.pop(key); missing.append(mutant)
    check(all(reject(mutant) for mutant in missing), "J_BPAM_EACH_TOP_LEVEL_KEY_REQUIRED")
    mutant=clone(); mutant["extra"]=True
    check(reject(mutant), "J_BPAM_EXTRA_TOP_LEVEL_KEY_REJECT")
    condition_mutants = []
    for index in range(len(BPAM_CONDITIONS)):
        mutant=clone(); del mutant["conditions"][index]; condition_mutants.append(mutant)
    for action in ("duplicate","substitute","reorder","type"):
        mutant=clone()
        if action == "duplicate": mutant["conditions"][1] = dict(mutant["conditions"][0])
        elif action == "substitute": mutant["conditions"][0]["requirement"] = "MODEL_JUDGMENT"
        elif action == "reorder": mutant["conditions"][0],mutant["conditions"][1] = mutant["conditions"][1],mutant["conditions"][0]
        else: mutant["conditions"][0]["id"] = 1
        condition_mutants.append(mutant)
    check(all(reject(mutant) for mutant in condition_mutants), "J_BPAM_BP01_BP14_MISSING_DUPLICATE_SUBSTITUTE_ORDER_TYPE_REJECT")
    def vector_mutants(key: str) -> list[dict[str, object]]:
        rows=[]
        for index in range(len(contract[key])):
            mutant=clone(); del mutant[key][index]; rows.append(mutant)
        for index in range(len(contract[key])-1):
            mutant=clone(); mutant[key][index],mutant[key][index+1] = mutant[key][index+1],mutant[key][index]; rows.append(mutant)
        for action in ("extra","duplicate","substitute","type"):
            mutant=clone(); value=mutant[key]
            if action == "extra": value.append("EXTRA")
            elif action == "duplicate": value[1] = value[0]
            elif action == "substitute": value[0] = "SUBSTITUTE"
            else: mutant[key] = {"wrong":"type"}
            rows.append(mutant)
        return rows
    for key,label in (("bp05_exact_dimensions","BP05_DIMENSIONS"),("authorized_internal_migrations","MIGRATIONS"),
                      ("true_human_hard_stops","HARD_STOPS"),("required_serial_transitions","TRANSITIONS"),
                      ("forbidden_authorities","FORBIDDEN_AUTHORITY")):
        check(all(reject(mutant) for mutant in vector_mutants(key)), f"J_BPAM_{label}_EXACT_VECTOR_REJECT")
    qualifier_mutants=[]
    for key,index,value in (
        ("true_human_hard_stops",4,"MATERIALLY_BROADEN_FILESYSTEM_PROCESS_NETWORK_OR_CREDENTIAL_AUTHORITY"), ("true_human_hard_stops",7,"PROVISION_OR_CHANGE_EXTERNAL_CREDENTIAL_SECRET_GITHUB_IDENTITY_OR_TRUST_ROOT"),
        ("forbidden_authorities",4,"FILESYSTEM_PROCESS_NETWORK_OR_CREDENTIAL_BROADENING"), ("forbidden_authorities",5,"EXTERNAL_CREDENTIAL_SECRET_GITHUB_IDENTITY_OR_TRUST_ROOT_PROVISIONING")):
        mutant=clone(); mutant[key][index]=value; qualifier_mutants.append(mutant)
    check(all(reject(mutant) for mutant in qualifier_mutants), "J_BPAM_OBJECTIVE_AND_HUMAN_CEREMONY_QUALIFIERS_REQUIRED")
    precedence_mutants=[]
    mutant=clone(); mutant.pop("legacy_stop_boundary_precedence"); precedence_mutants.append(mutant)
    mutant=clone(); mutant["legacy_stop_boundary_precedence"]["superseded_only_when"]="OBJECTIVE_LEVEL_IMPOSSIBILITY"; precedence_mutants.append(mutant)
    mutant=clone(); mutant["legacy_stop_boundary_precedence"]["remaining_human_stops"].reverse(); precedence_mutants.append(mutant)
    check(all(reject(mutant) for mutant in precedence_mutants), "J_BPAM_SCOPED_LEGACY_STOP_PRECEDENCE_REQUIRED")
    scalar_mutants=[]
    for key,value in (("scope","EXPANDED_OBJECTIVE"),("condition_operator","ANY"),
                      ("condition_operator","THRESHOLD_13"),("condition_operator","OPTIONAL"),
                      ("hard_stop_precedence","AFTER_DELEGATED_AUTHORITY"),("incomplete_proof_result","PARTIAL_AUTHORITY"),
                      ("owner_decision_required","HUMAN_STOP"),("delegation_predicate","ANY_BP_IMPLIES_AUTHORITY"),
                      ("authorized_migrations_require","CALLER_SELECTED"),("sequence_rule","OPTIONAL"),
                      ("downstream_rebind_rule","SILENT_INHERITANCE"),("review_binding","SAME_SUBJECT"),
                      ("preproduct_red_rule","MODEL_PROSE"),("fail_closed",False)):
        mutant=clone(); mutant[key]=value; scalar_mutants.append(mutant)
    for key,value in (("candidate_bytes_activate",True),("report_only_after_evidence",False),
                      ("trigger","CANDIDATE_BYTES"),("report","ACTIVE_BEFORE_PUBLICATION")):
        mutant=clone(); mutant["activation_condition"][key]=value; scalar_mutants.append(mutant)
    for index in range(4):
        mutant=clone(); del mutant["activation_condition"]["required_evidence"][index]; scalar_mutants.append(mutant)
    check(all(reject(mutant) for mutant in scalar_mutants), "J_BPAM_GRANT_REVIEW_RED_ACTIVATION_FAIL_CLOSED_REJECT")
    duplicate = raw.replace(b'{\n  "schema_version": 1,', b'{\n  "schema_version": 1,\n  "schema_version": 1,', 1)
    duplicate_contract = duplicate.split(BPAM_CONTRACT_BEGIN,1)[1].split(BPAM_CONTRACT_END,1)[0]
    try: strict_json_bytes(duplicate_contract); duplicate_rejected=False
    except ValueError: duplicate_rejected=True
    check(duplicate_rejected and not bpam_document(duplicate)[0], "J_BPAM_DUPLICATE_JSON_KEY_REJECT")
    binding_mutants=[]
    for key,value in (("candidate_bytes_activate",0),("fail_closed",1),("true_human_hard_stop_count",13.0)):
        mutant=json.loads(json.dumps(BPAM_SPEC_BINDING)); mutant[key]=value; binding_mutants.append(mutant)
    check(all(not exact_value(mutant,BPAM_SPEC_BINDING) for mutant in binding_mutants), "J_BPAM_TASK_BINDING_REJECTS_BOOL_INT_FLOAT_EQUALITY")
    for label,mutant in (("PREFIX",b"X"+raw),("PREAMBLE",raw.replace(b"inactive in candidate form",b"active in candidate form",1)),
                         ("SOURCE",raw.replace(b"I am adding a standing owner-delegation",b"I am altering a standing owner-delegation",1)),
                         ("TRAILING",raw+b"claim\n")):
        check(not bpam_document(mutant)[0], f"J_BPAM_{label}_MUTATION_REJECT")


