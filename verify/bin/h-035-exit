            written=os.write(key_write,status_key[key_offset:])
            if written<=0:raise Rig("R15 runpy fault status key write")
            key_offset+=written
    except BaseException:
        os.close(key_write);os.close(key_read);os.close(status_write);os.close(status_read);raise
    os.close(key_write)
    os.set_inheritable(status_write,True)
    os.set_inheritable(key_read,True)
    program=r'''import base64, builtins, hashlib, hmac, json, os, runpy, stat, sys
