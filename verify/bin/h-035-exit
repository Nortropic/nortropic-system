                              and set(committed_row)==recovery_keys
                              and [row.get("phase") for row in trace_delta_rows]==[
                                  "PENDING","COMMITTED"]
                              and all(pending_row.get(field)==committed_row.get(field)
                                      for field in shared_recovery_fields)
                              and pending_row.get("record_type")=="h035_r15_attest_recovery_v1"
                              and type(pending_row.get("schema_version")) is int
                              and pending_row.get("schema_version")==1
                              and type(committed_row.get("schema_version")) is int
                              and committed_row.get("schema_version")==1
                              and type(pending_row.get("sequence")) is int
                              and type(committed_row.get("sequence")) is int
                              and pending_row.get("sequence")==pending_sequence
                              and committed_row.get("sequence")==pending_sequence+1
                              and pending_sequence%2==1 and committed_row.get("sequence")%2==0
                              and pending_row.get("command")=="finalize-owner-publication"
                              and pending_row.get("task")==task
                              and pending_row.get("manifest_sha256")==traced_manifest_sha
                              and pending_row.get("request_sha256")==traced_request_sha
                              and pending_row.get("old_store_sha256")==hashlib.sha256(preissue_store).hexdigest()
                              and pending_row.get("new_store_sha256")==hashlib.sha256(traced_store_raw).hexdigest()
                              and pending_row.get("operation_identity")==canonical_json_sha256(expected_operation)
                              and pending_row.get("previous_record_sha256")==hashlib.sha256(
                                  prior_recovery_lines[-1] if prior_recovery_lines else b"").hexdigest()
                              and committed_row.get("previous_record_sha256")==hashlib.sha256(
                                  canonical_json_bytes(pending_row)+b"\n").hexdigest())
    except (OSError,ValueError,UnicodeError):
        traced_answer={};exact_recovery_delta=False
    record("AUTHORITY_RECORD_PUBLICATION_EXACT_ATTEST_FINALIZER_DELEGATION",
           traced.returncode==0 and traced.stderr==""
           and r15_json_equal(traced_answer,{"accepted":True,"merged":True,"published":True})
           and r15_fault_event_exact(
               traced,"trace_attest","attest_subprocess",trace_subject_identity)
           and len(trace_rows)==1 and exact_trace and traced_readback
           and exact_recovery_delta
           and trace_shadow_before==b"" and preissue_store!=b""
           and (attest/".r15-attest-shadow").read_bytes()==b""
           and attest_static_snapshot()==trace_static_before,traced.stderr)
    publication_dispatch_before=filesystem_snapshot(bundle)
    publication_dispatch=traced_authority(
        "record-publication",publication_request,"record-publication")
    authority_dispatch_ok=(publication_dispatch[0]==0
        and publication_dispatch_before==filesystem_snapshot(bundle)
        and set(authority_dispatch_traces)=={
            "owner-author","check-candidate","record-review","owner-freeze","record-publication"}
        and all(rows==authority_dispatch_expected[label]
                for label,rows in authority_dispatch_traces.items()))
    record("DISPATCH_VALID_FULL_AUTHORITY_LIFECYCLE_RETAINED_EXPORT_EXACTLY_ONCE",
           authority_dispatch_ok,repr(authority_dispatch_traces))
    reset_store(preissue_store)
    refs_before=remote_refs(remote)
    raced=r15_parallel_cli(repo,[
        ("controller/authority/cli",["record-publication"],correct_stdin),
        ("controller/authority/cli",["record-publication"],wrong_stdin),
    ],held_lock=state/".r15-owner.lock")
    try:
        store=strict_json_bytes((attest/"attestations.json").read_bytes())
        owner_record=store.get("attestations",{}).get(task) if isinstance(store,dict) else None
        publication_ok=(sorted(result.returncode for result in raced)==[0,1]
                        and set(owner_record)==set(R15_OWNER_PUBLICATION_FIELDS)
                        and r15_json_equal(owner_record,expected_record)
                        and r15_owner_publication_valid(
                            owner_record,task=task,
                            repository_identity=str(context["repository_identity"]))[0]
                        and remote_refs(remote)==refs_before
                        and r15_events(state/"events.jsonl")[-1].get("status")=="OWNER_FROZEN")
    except (OSError,ValueError,KeyError,TypeError) as exc:
        publication_ok=False; expected_record={}; detail=str(exc)
    record("GUARDED_PUBLICATION_FINALIZE_ONE_WAY_RICH_ATTEST_NO_REF_MUTATION",
           publication_ok,detail)

    exact_replay_before=(filesystem_snapshot(attest),filesystem_snapshot(state),
                         filesystem_snapshot(workspace),
                         r15_repository_authority_snapshot(repo,remote))
    exact_replay_diagnostics=[]
    exact_replays=r15_parallel_cli(repo,[
        ("controller/authority/cli",["record-publication"],correct_stdin),
        ("controller/authority/cli",["record-publication"],correct_stdin),
    ],held_lock=state/".r15-owner.lock",diagnostics=exact_replay_diagnostics)
    exact_replay_after=(filesystem_snapshot(attest),filesystem_snapshot(state),
                        filesystem_snapshot(workspace),
                        r15_repository_authority_snapshot(repo,remote))
    exact_replay_detail=json.dumps({
        "children":[{
            "returncode":result.returncode,"stdout":result.stdout,
            "stderr":result.stderr,"timing":exact_replay_diagnostics[index]}
            for index,result in enumerate(exact_replays)],
        "durable_unchanged":exact_replay_after==exact_replay_before,
        "held_lock_both_blocked":len(exact_replay_diagnostics)==2
            and all(row["blocked_before_release"] for row in exact_replay_diagnostics),
    },sort_keys=True,separators=(",",":"))
    record("CONCURRENT_IDENTICAL_FINALIZERS_EXACT_IDEMPOTENCE",
           all(result.returncode==0 for result in exact_replays)
           and len(exact_replay_diagnostics)==2
           and all(row["blocked_before_release"] for row in exact_replay_diagnostics)
           and exact_replay_after==exact_replay_before,
           exact_replay_detail)
    store_before=(attest/"attestations.json").read_bytes()
    raw=r15_cli(repo,"controller/attest/cli",str(attest),"write-owner-publication",
                stdin=json.dumps(expected_record))
    record("PUBLIC_RAW_OWNER_WRITER_ABSENT",
           raw.returncode!=0 and (attest/"attestations.json").read_bytes()==store_before,
           raw.stderr)
    legacy=r15_cli(repo,"controller/attest/cli",str(attest),"write",task,"0"*40)
    record("LEGACY_WRITE_CANNOT_REPLACE_RICH_OWNER_RECORD",
           legacy.returncode!=0 and (attest/"attestations.json").read_bytes()==store_before,
           legacy.stderr)

    # Bootstrap is the sole H036 admission; the public command only revalidates
    # and replays that exact current nonstale record with zero store/log effect.
    h036_replay_store=(attest/"attestations.json").read_bytes()
    h036_replay_log=(attest/".r15-attest-recovery.jsonl").read_bytes()
    set_remote_main(remote,repo,str(R15_H036["base_sha"]))
    ancestry_bad=r15_cli(repo,"controller/attest/cli",str(attest),
                          "import-h036-owner-publication")
    set_remote_main(remote,repo,publication)
    record("H036_REPLAY_REQUIRES_RAW_FIRST_PARENT_CURRENT_MAIN_ANCESTRY",
           ancestry_bad.returncode!=0
           and (attest/"attestations.json").read_bytes()==h036_replay_store
           and (attest/".r15-attest-recovery.jsonl").read_bytes()==h036_replay_log,
           ancestry_bad.stderr)
    substitute=tmp/"h036-review-substitute.json"
    substitute.write_bytes(base64.b64decode(R15_H036_REVIEW_B64)+b" "); substitute.chmod(0o600)
    h036_artifact_before=(filesystem_snapshot(attest),filesystem_snapshot(state),
                          filesystem_snapshot(workspace),r15_repository_authority_snapshot(repo,remote),
                          filesystem_snapshot(Path(R15_H036_REVIEW_PATH).parent),
                          filesystem_snapshot(substitute.parent),
                          r15_leaf_state(Path(R15_H036_REVIEW_PATH)),r15_leaf_state(substitute))
    h036_review_identity=os.lstat(R15_H036_REVIEW_PATH);h036_substitute_identity=os.lstat(substitute)
    artifact_bad=r15_cli_runpy_fault(
        repo,"controller/attest/cli",[str(attest),"import-h036-owner-publication"],
        stdin=None,fault="path_substitute",target=Path(R15_H036_REVIEW_PATH),
        substitute=substitute)
    record("H036_REPLAY_FIXED_REVIEW_STABLE_OPEN_SUBSTITUTION_REJECT",
           r15_fault_error(artifact_bad,"file open race")
           and r15_fault_event_exact(artifact_bad,"path_substitute","open_redirect",
                                     {"target":[h036_review_identity.st_dev,h036_review_identity.st_ino],
                                      "substitute":[h036_substitute_identity.st_dev,h036_substitute_identity.st_ino],
                                      "opened":[h036_substitute_identity.st_dev,h036_substitute_identity.st_ino]})
           and (attest/"attestations.json").read_bytes()==h036_replay_store
           and (attest/".r15-attest-recovery.jsonl").read_bytes()==h036_replay_log
           and h036_artifact_before==(
               filesystem_snapshot(attest),filesystem_snapshot(state),filesystem_snapshot(workspace),
               r15_repository_authority_snapshot(repo,remote),
               filesystem_snapshot(Path(R15_H036_REVIEW_PATH).parent),
               filesystem_snapshot(substitute.parent),r15_leaf_state(Path(R15_H036_REVIEW_PATH)),
               r15_leaf_state(substitute)),
           artifact_bad.stderr)
    exact_mode_rejects=[]
    for label,target,raw_bytes in (
        ("REVIEW",Path(R15_H036_REVIEW_PATH),base64.b64decode(R15_H036_REVIEW_B64)),
        ("RECEIPT",Path(R15_H036_RECEIPT_PATH),base64.b64decode(R15_H036_RECEIPT_B64))):
        same_bytes=tmp/("h036-"+label.lower()+"-mode0600.json")
        same_bytes.write_bytes(raw_bytes);same_bytes.chmod(0o600)
        target_identity=os.lstat(target)
        same_identity=os.lstat(same_bytes)
        mode_before=(filesystem_snapshot(attest),filesystem_snapshot(state),
                     filesystem_snapshot(workspace),r15_repository_authority_snapshot(repo,remote),
                     filesystem_snapshot(target.parent),filesystem_snapshot(same_bytes.parent),
                     r15_leaf_state(target),r15_leaf_state(same_bytes))
        result=r15_cli_runpy_fault(repo,"controller/attest/cli",
            [str(attest),"import-h036-owner-publication"],stdin=None,
            fault="path_substitute",target=target,substitute=same_bytes)
        exact_mode_rejects.append(r15_fault_error(result,"file open race")
                                  and r15_fault_event_exact(
                                      result,"path_substitute","open_redirect",
                                      {"target":[target_identity.st_dev,target_identity.st_ino],
                                       "substitute":[same_identity.st_dev,same_identity.st_ino],
                                       "opened":[same_identity.st_dev,same_identity.st_ino]})
                                  and mode_before==(filesystem_snapshot(attest),filesystem_snapshot(state),
                                      filesystem_snapshot(workspace),r15_repository_authority_snapshot(repo,remote),
                                      filesystem_snapshot(target.parent),filesystem_snapshot(same_bytes.parent),
                                      r15_leaf_state(target),r15_leaf_state(same_bytes)))
    record("H036_REPLAY_REVIEW_RECEIPT_SAME_BYTES_MODE0600_REJECT",
           exact_mode_rejects==[True,True]
           and (attest/"attestations.json").read_bytes()==h036_replay_store
           and (attest/".r15-attest-recovery.jsonl").read_bytes()==h036_replay_log,
           repr(exact_mode_rejects))
    direct_import_trace=tmp/"dispatch-r15-attest-import-h036.jsonl"
    replayed=r15_cli_runpy_fault(
        repo,"controller/attest/cli",[str(attest),"import-h036-owner-publication"],
        stdin=None,fault="trace_runtime_exports",target=direct_import_trace)
    direct_import_export=(runtime_trace_rows(direct_import_trace)
        ==r15_expected_export_trace(
            "attest_main",[str(attest),"import-h036-owner-publication"],
            stdin=None,result=0))
    arbitrary=r15_cli(repo,"controller/attest/cli",str(attest),
                      "import-h036-owner-publication","h-037")
    record("FIXED_NO_ARG_H036_EXISTING_RECORD_REPLAY_ONLY_AND_NEIGHBOR_REJECT",
           replayed.returncode==0 and direct_import_export and arbitrary.returncode!=0
           and (attest/"attestations.json").read_bytes()==h036_replay_store
           and (attest/".r15-attest-recovery.jsonl").read_bytes()==h036_replay_log,
           replayed.stderr+arbitrary.stderr)
    record("DISPATCH_DIRECT_ATTEST_LEGACY_VS_R15_ROUTE_MUTUAL_EXCLUSION",
           context.get("dispatch_legacy_attest_trace_ok") is True
           and direct_finalizer_export and direct_import_export,
           repr((context.get("dispatch_legacy_attest_trace_ok"),
                 runtime_trace_rows(direct_finalizer_trace),
                 runtime_trace_rows(direct_import_trace))))

    # RLIMIT_FSIZE reaches the temp-write boundary without making the valid 0700 root unsafe.
    attest_before=filesystem_snapshot(attest)
    failed_write=r15_cli_zero_file_limit(
        repo,"controller/attest/cli",str(attest),"write","h-003","1"*40)
    record("ATTEST_PRE_RENAME_TEMP_WRITE_FAILURE_NO_PARTIAL_STORE_OR_TEMP",
           failed_write.returncode!=0 and filesystem_snapshot(attest)==attest_before,
           failed_write.stderr)
    fsync_before=(attest/"attestations.json").read_bytes()
    fsync_shadow_before=(attest/".r15-attest-shadow").read_bytes()
    fsync_recovery_before=(attest/".r15-attest-recovery.jsonl").read_bytes()
    fsync_static_before=attest_static_snapshot()
    fsync_directory_identity=os.lstat(attest)
    fsync_fault=r15_cli_runpy_fault(
        repo,"controller/attest/cli",[str(attest),"write","h-004","3"*40],
        stdin=None,fault="directory_fsync")
    fsync_after=(attest/"attestations.json").read_bytes()
    try:
        fsync_store=strict_json_bytes(fsync_after)
        expected_fsync_store=strict_json_bytes(fsync_before)
        expected_fsync_store["attestations"]["h-004"]={
            "task":"h-004","candidate_sha":"3"*40,
            "invalidates_on":["3"*40],"stale":False}
        expected_fsync_raw=canonical_json_bytes(expected_fsync_store)+b"\n"
        fsync_present=(r15_json_equal(fsync_store,expected_fsync_store)
                       and fsync_after==expected_fsync_raw)
    except (ValueError,KeyError,TypeError): fsync_present=False
    fsync_pending_shadow=(attest/".r15-attest-shadow").read_bytes()
    fsync_pending_recovery=(attest/".r15-attest-recovery.jsonl").read_bytes()
    fsync_pending_static=attest_static_snapshot()
    fsync_replay=r15_cli(repo,"controller/attest/cli",str(attest),"write","h-004","3"*40)
    try:
        fsync_recovery_after=(attest/".r15-attest-recovery.jsonl").read_bytes()
        fsync_delta=[strict_json_bytes(line) for line in
                     fsync_recovery_after[len(fsync_recovery_before):].splitlines()]
        fsync_prefix_lines=fsync_recovery_before.splitlines(keepends=True)
        fsync_sequence=len(fsync_prefix_lines)+1
        fsync_manifest_raw=(attest/"bootstrap-manifest.json").read_bytes()
        fsync_manifest=strict_json_bytes(fsync_manifest_raw)
        fsync_manifest_sha=hashlib.sha256(fsync_manifest_raw).hexdigest()
        fsync_request_sha=canonical_json_sha256({
            "record_type":"h035_r15_attest_request_v1","command":"write",
            "argv":["h-004","3"*40],"stdin":None})
        fsync_old_sha=hashlib.sha256(fsync_before).hexdigest()
        fsync_new_sha=hashlib.sha256(expected_fsync_raw).hexdigest()
        fsync_operation=canonical_json_sha256({
            "record_type":"h035_r15_attest_operation_v1","command":"write","task":"h-004",
            "request_sha256":fsync_request_sha,"manifest_sha256":fsync_manifest_sha,
            "attest_root_dev_ino":fsync_manifest["attest_root_dev_ino"],
            "attest_manifest_dev_ino":fsync_manifest["attest_manifest_dev_ino"],
            "attest_lock_dev_ino":fsync_manifest["attest_lock_dev_ino"],
            "attestation_store_slot_dev_inos":fsync_manifest["attestation_store_slot_dev_inos"],
            "attest_recovery_log_dev_ino":fsync_manifest["attest_recovery_log_dev_ino"],
            "pending_sequence":fsync_sequence,"old_store_sha256":fsync_old_sha,
            "new_store_sha256":fsync_new_sha})
        fsync_keys={"record_type","schema_version","sequence","phase","command","task",
                    "manifest_sha256","operation_identity","request_sha256",
                    "old_store_sha256","new_store_sha256","previous_record_sha256"}
        fsync_pending_delta=[strict_json_bytes(line) for line in
            fsync_pending_recovery[len(fsync_recovery_before):].splitlines()]
        fsync_pending_exact=(fsync_pending_recovery.startswith(fsync_recovery_before)
            and len(fsync_pending_delta)==1 and set(fsync_pending_delta[0])==fsync_keys
            and fsync_pending_delta[0].get("phase")=="PENDING"
            and type(fsync_pending_delta[0].get("schema_version")) is int
            and fsync_pending_delta[0].get("schema_version")==1
            and type(fsync_pending_delta[0].get("sequence")) is int
            and fsync_pending_delta[0].get("sequence")==fsync_sequence
            and fsync_sequence%2==1
            and fsync_pending_delta[0].get("command")=="write"
            and fsync_pending_delta[0].get("task")=="h-004"
            and fsync_pending_delta[0].get("manifest_sha256")==fsync_manifest_sha
            and fsync_pending_delta[0].get("request_sha256")==fsync_request_sha
            and fsync_pending_delta[0].get("old_store_sha256")==fsync_old_sha
            and fsync_pending_delta[0].get("new_store_sha256")==fsync_new_sha
            and fsync_pending_delta[0].get("operation_identity")==fsync_operation
            and fsync_pending_delta[0].get("previous_record_sha256")==hashlib.sha256(
                fsync_prefix_lines[-1] if fsync_prefix_lines else b"").hexdigest()
            and fsync_pending_shadow==fsync_before
            and fsync_pending_static==fsync_static_before)
        fsync_recovery_exact=(fsync_recovery_after.startswith(fsync_recovery_before)
            and len(fsync_delta)==2
            and all(set(row)==fsync_keys for row in fsync_delta)
            and [row.get("phase") for row in fsync_delta]==["PENDING","COMMITTED"]
            and all(type(row.get("schema_version")) is int and row.get("schema_version")==1
                    for row in fsync_delta)
            and [row.get("sequence") for row in fsync_delta]==[fsync_sequence,fsync_sequence+1]
            and fsync_sequence%2==1 and (fsync_sequence+1)%2==0
            and all(row.get("task")=="h-004" and row.get("command")=="write"
                    for row in fsync_delta)
            and all(row.get("manifest_sha256")==fsync_manifest_sha
                    and row.get("request_sha256")==fsync_request_sha
                    and row.get("old_store_sha256")==fsync_old_sha
                    and row.get("new_store_sha256")==fsync_new_sha
                    and row.get("operation_identity")==fsync_operation for row in fsync_delta)
            and fsync_delta[0].get("previous_record_sha256")==hashlib.sha256(
                fsync_prefix_lines[-1] if fsync_prefix_lines else b"").hexdigest()
            and fsync_delta[1].get("previous_record_sha256")==hashlib.sha256(
                canonical_json_bytes(fsync_delta[0])+b"\n").hexdigest())
    except (OSError,ValueError,TypeError):fsync_recovery_exact=False
    record("ATTEST_POST_RENAME_DIRECTORY_FSYNC_INDETERMINATE_EXACT_REPLAY",
           r15_fault_error(fsync_fault,"INDETERMINATE_PRESERVED attest mutation: [Errno 5] R15 injected directory fsync failure")
           and r15_fault_event_exact(fsync_fault,"directory_fsync","directory_fsync",
                                     [fsync_directory_identity.st_dev,fsync_directory_identity.st_ino])
           and fsync_after!=fsync_before and fsync_present
           and fsync_pending_exact
           and fsync_replay.returncode==0
           and (attest/"attestations.json").read_bytes()==fsync_after
           and (attest/".r15-attest-shadow").read_bytes()==b""
           and fsync_shadow_before==b""
           and fsync_recovery_exact
           and attest_static_snapshot()==fsync_static_before,
           fsync_fault.stderr+fsync_replay.stderr)

    def direct_finalize() -> subprocess.CompletedProcess:
        return r15_cli(repo,"controller/attest/cli",str(attest),
                       "finalize-owner-publication",
                       stdin=json.dumps(direct_request,sort_keys=True,separators=(",",":")))

    # Both serial lock orders are explicit oracles; the concurrent case must equal one.
    reset_store(preissue_store)
    finalize_first=direct_finalize()
    invalidate_second=r15_cli(repo,"controller/attest/cli",str(attest),"invalidate",good)
    try:
        finalized_then_invalidated=strict_json_bytes((attest/"attestations.json").read_bytes())
        order_one=(finalize_first.returncode==0 and invalidate_second.returncode==0
                   and finalized_then_invalidated["attestations"][task]["stale"] is True
                   and good in finalized_then_invalidated["invalidated_shas"])
    except (ValueError,KeyError,TypeError): order_one=False
    reset_store(preissue_store)
    invalidate_first=r15_cli(repo,"controller/attest/cli",str(attest),"invalidate",good)
    finalize_second=direct_finalize()
    try:
        invalidated_then_finalized=strict_json_bytes((attest/"attestations.json").read_bytes())
        order_two=(invalidate_first.returncode==0 and finalize_second.returncode!=0
                   and task not in invalidated_then_finalized["attestations"]
                   and good in invalidated_then_finalized["invalidated_shas"])
    except (ValueError,KeyError,TypeError): order_two=False
    record("FINALIZE_INVALIDATE_BOTH_SERIAL_LOCK_ORDERS_ONE_WAY",
           order_one and order_two,
           finalize_first.stderr+invalidate_second.stderr+invalidate_first.stderr+finalize_second.stderr)
    reset_store(preissue_store)
    finalize_invalidate=r15_parallel_cli(repo,[
        ("controller/attest/cli",[str(attest),"finalize-owner-publication"],
         json.dumps(direct_request,sort_keys=True,separators=(",",":"))),
        ("controller/attest/cli",[str(attest),"invalidate",good],None),
    ],held_lock=attest/".r15-attest.lock")
    try:
        final_race_store=strict_json_bytes((attest/"attestations.json").read_bytes())
        race_record=final_race_store["attestations"].get(task)
        final_race_ok=(finalize_invalidate[1].returncode==0
                       and finalize_invalidate[0].returncode in (0,1)
                       and good in final_race_store["invalidated_shas"]
                       and (race_record is None or race_record.get("stale") is True))
    except (ValueError,KeyError,TypeError): final_race_ok=False
    record("CONCURRENT_FINALIZE_INVALIDATE_LINEARIZES_TO_A_PROVEN_SERIAL_ORDER",
           final_race_ok," | ".join(result.stderr for result in finalize_invalidate))

    reset_store(preissue_store)
    ordinary_first=r15_cli(repo,"controller/attest/cli",str(attest),"write",task,"4"*40)
    ordinary_bytes=(attest/"attestations.json").read_bytes()
    owner_after_ordinary=direct_finalize()
    owner_after_bytes=(attest/"attestations.json").read_bytes()
    reset_store(preissue_store)
    owner_first=direct_finalize()
    ordinary_after_owner=r15_cli(repo,"controller/attest/cli",str(attest),"write",task,"4"*40)
    try:
        owner_first_store=strict_json_bytes((attest/"attestations.json").read_bytes())
        owner_first_ok=r15_json_equal(owner_first_store["attestations"][task],expected_record)
    except (ValueError,KeyError,TypeError): owner_first_ok=False
    record("ORDINARY_WRITE_OWNER_ISSUE_BOTH_SERIAL_ORDERS_NO_OVERWRITE",
           ordinary_first.returncode!=0 and ordinary_bytes==preissue_store
           and owner_after_ordinary.returncode==0 and owner_after_bytes!=preissue_store
           and owner_first.returncode==0
           and ordinary_after_owner.returncode!=0 and owner_first_ok,
           ordinary_first.stderr+owner_after_ordinary.stderr+owner_first.stderr+ordinary_after_owner.stderr)
    reset_store(preissue_store)
    ordinary_owner_race=r15_parallel_cli(repo,[
        ("controller/attest/cli",[str(attest),"finalize-owner-publication"],
         json.dumps(direct_request,sort_keys=True,separators=(",",":"))),
        ("controller/attest/cli",[str(attest),"write",task,"4"*40],None),
    ],held_lock=attest/".r15-attest.lock")
    try:
        ordinary_owner_store=strict_json_bytes((attest/"attestations.json").read_bytes())
        ordinary_owner_record=ordinary_owner_store["attestations"][task]
        ordinary_owner_ok=(sorted(result.returncode for result in ordinary_owner_race)==[0,1]
                           and r15_json_equal(ordinary_owner_record,expected_record))
    except (ValueError,KeyError,TypeError): ordinary_owner_ok=False
    record("CONCURRENT_ORDINARY_WRITE_OWNER_ISSUE_ONE_RECORD_NO_LOST_UPDATE",
           ordinary_owner_ok," | ".join(result.stderr for result in ordinary_owner_race))

    reset_store(preissue_store)
    lock_blocked,lock_order=r15_state_attest_lock_order_probe(
        repo,state/".r15-owner.lock",attest/".r15-attest.lock",
        [str(attest),"finalize-owner-publication"],
        json.dumps(direct_request,sort_keys=True,separators=(",",":")),
        json.dumps(freeze_request,sort_keys=True,separators=(",",":")))
    record("STATE_THEN_ATTEST_GLOBAL_LOCK_ORDER_NO_DEADLOCK",
           lock_blocked and len(lock_order)==2
           and lock_order[0].returncode==0 and lock_order[1].returncode==1
           and "remote main drift" in lock_order[1].stderr,
           f"blocked={lock_blocked} count={len(lock_order)} "
           +" | ".join(f"rc={result.returncode} out={result.stdout} err={result.stderr}"
                        for result in lock_order))

    # Different-task mutation and invalidation race must not lose either effect.
    races=r15_parallel_cli(repo,[
        ("controller/attest/cli",[str(attest),"write","h-002","1"*40],None),
        ("controller/attest/cli",[str(attest),"invalidate",good],None),
    ])
    try:
        raced_store=strict_json_bytes((attest/"attestations.json").read_bytes())
        h038_after=raced_store["attestations"][task]
        race_ok=(all(result.returncode==0 for result in races)
                 and raced_store["attestations"]["h-002"]
                     == {"task":"h-002","candidate_sha":"1"*40,
                         "invalidates_on":["1"*40],"stale":False}
                 and h038_after.get("stale") is True
                 and good in raced_store.get("invalidated_shas",[]))
    except (OSError,ValueError,KeyError,TypeError): race_ok=False
    record("CONCURRENT_DIFFERENT_TASK_WRITE_INVALIDATE_NO_LOST_UPDATE",race_ok,
           " | ".join(result.stderr for result in races))
    stale_bytes=(attest/"attestations.json").read_bytes()
    finalize_after_stale=r15_authority(repo,"record-publication",publication_request)
    revive=r15_cli(repo,"controller/attest/cli",str(attest),"write",task,"2"*40)
    record("STALE_OWNER_PUBLICATION_CANNOT_FINALIZE_OR_LEGACY_REVIVE",
           finalize_after_stale[0]!=0 and revive.returncode!=0
           and (attest/"attestations.json").read_bytes()==stale_bytes,
           finalize_after_stale[2]+revive.stderr)

    h036_candidate=str(R15_H036["candidate_sha"])
    reset_store(preissue_store)
    import_first=r15_cli(repo,"controller/attest/cli",str(attest),
                         "import-h036-owner-publication")
    h036_invalidate_second=r15_cli(repo,"controller/attest/cli",str(attest),
                                   "invalidate",h036_candidate)
    try:
        import_then_invalidate=strict_json_bytes((attest/"attestations.json").read_bytes())
        h036_order_one=(import_first.returncode==0 and h036_invalidate_second.returncode==0
                        and import_then_invalidate["attestations"]["h-036"]["stale"] is True
                        and h036_candidate in import_then_invalidate["invalidated_shas"])
    except (ValueError,KeyError,TypeError): h036_order_one=False
    reset_store(preissue_store)
    h036_invalidate_first=r15_cli(repo,"controller/attest/cli",str(attest),
                                  "invalidate",h036_candidate)
    import_second=r15_cli(repo,"controller/attest/cli",str(attest),
                          "import-h036-owner-publication")
    try:
        invalidate_then_import=strict_json_bytes((attest/"attestations.json").read_bytes())
        h036_order_two=(h036_invalidate_first.returncode==0 and import_second.returncode!=0
                        and invalidate_then_import["attestations"]["h-036"]["stale"] is True
                        and h036_candidate in invalidate_then_import["invalidated_shas"])
    except (ValueError,KeyError,TypeError): h036_order_two=False
    record("H036_IMPORT_INVALIDATE_BOTH_SERIAL_ORDERS_ONE_WAY",
           h036_order_one and h036_order_two,
           import_first.stderr+h036_invalidate_second.stderr
           +h036_invalidate_first.stderr+import_second.stderr)
    reset_store(preissue_store)
    h036_race=r15_parallel_cli(repo,[
        ("controller/attest/cli",[str(attest),"import-h036-owner-publication"],None),
        ("controller/attest/cli",[str(attest),"invalidate",h036_candidate],None),
    ],held_lock=attest/".r15-attest.lock")
    try:
        post_h036=strict_json_bytes((attest/"attestations.json").read_bytes())
        post_h036_record=post_h036["attestations"].get("h-036")
        h036_stale=(h036_candidate in post_h036.get("invalidated_shas",[])
                    and (post_h036_record is None
                         or post_h036_record.get("stale") is True))
    except (OSError,ValueError,KeyError,TypeError): h036_stale=False
    reimport=r15_cli(repo,"controller/attest/cli",str(attest),"import-h036-owner-publication")
    record("H036_IMPORT_INVALIDATE_RACE_LINEARIZES_STALE_NO_REIMPORT",
           h036_race[1].returncode==0 and h036_race[0].returncode in (0,1)
           and h036_stale and reimport.returncode!=0,
           " | ".join(result.stderr for result in h036_race)+reimport.stderr)


def r14_registry_migration_controls(tmp: Path) -> None:
    """Effect-bound two-state parser migration; one causal aggregate RED."""
    canonical = strict_load(REG)
    if not isinstance(canonical, dict):
        raise Rig("R14 current registry is not an object")
    current = json.loads(json.dumps(canonical))
    current["schema_version"] = 1
    current["owner_production_paths"] = list(H034_OWNER_PATHS)
    prospective = json.loads(json.dumps(canonical))
    prospective["schema_version"] = 2
    prospective["owner_production_paths"] = [*H034_OWNER_PATHS, *H036_OWNER_PATHS]

    observations: list[tuple[str, bool, str, str]] = []

    def record(name: str, ok: bool, reason: str, detail: object) -> None:
        observations.append((name, ok, reason,
                             detail if isinstance(detail, str) else repr(detail)))

    def clone_case(name: str, registry: object, owner_surface: list[str],
                   protected_paths: list[str] | None = None,
                   global_denied_paths: list[str] | None = None) -> tuple[Path, str, str, Path]:
        protected_paths = (list(protected_paths) if protected_paths is not None
                           else [H036_OWNER_PATHS[0]])
        global_denied_paths = (list(global_denied_paths)
                               if global_denied_paths is not None else [])
        if not protected_paths:
            raise Rig("R14 protected positive-control paths must be non-empty")
        repo = tmp / ("r14-case-" + name.lower().replace("_", "-"))
        init_repo(repo)
        (repo / "specs").mkdir()
        registry_path = repo / "specs/owner-production-paths.v1.json"
        if isinstance(registry, dict):
            write_json(registry_path, registry)
        elif isinstance(registry, str):
            registry_path.write_text(registry + ("" if registry.endswith("\n") else "\n"))
        else:
            raise Rig("R14 registry fixture must be an object or raw JSON string")
        write_json(repo / "specs/tasks.spec.json", {
            "spec_version":"2.0.0",
            "defaults":{"denied_write":[], "max_changed_files":10,
                        "max_added_lines":100},
            "tasks":[],
        })
        commit_paths(repo, "r14 registry activation without future fixture tasks",
                     "specs/tasks.spec.json", "specs/owner-production-paths.v1.json")

        core_path = repo / "controller/authority/core.py"
        core_path.parent.mkdir(parents=True)
        core_path.write_bytes((ROOT / "controller/authority/core.py").read_bytes())
        policy_path = repo / "controller/policy/cli"
        policy_path.parent.mkdir(parents=True)
        policy_path.write_bytes((ROOT / "controller/policy/cli").read_bytes())
        policy_path.chmod(0o755)
        gate_path = repo / "verify/bin/h-035-exit"
        gate_path.parent.mkdir(parents=True)
        gate_path.write_bytes(Path(__file__).read_bytes())
        gate_path.chmod(0o755)
        tasks = [
            ordinary_task("r14-safe", ["tests/r14-safe/**"]),
            owner_task("r14-owner", owner_surface),
        ]
        tasks.extend(ordinary_task(f"r14-protected-{index}", [path])
                     for index, path in enumerate(protected_paths))
        tasks.extend(owner_task(f"r14-global-denied-{index}", [path])
                     for index, path in enumerate(global_denied_paths))
        write_json(repo / "specs/tasks.spec.json", {
            "spec_version":"2.0.0",
            "defaults":{"denied_write":[], "max_changed_files":10,
                        "max_added_lines":100},
            "tasks":tasks,
        })
        base = commit_paths(repo, "r14 material registry case",
                            "controller/authority/core.py", "controller/policy/cli",
                            "verify/bin/h-035-exit", "specs/tasks.spec.json")
        safe_candidate = candidate(repo, base, "tests/r14-safe/effect.txt", 1420)
        bare = tmp / ("r14-origin-" + name.lower().replace("_", "-") + ".git")
        p = run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
        if p.returncode: raise Rig(p.stderr)
        set_remote_main(bare, repo, base)
        return repo, base, safe_candidate, bare

    def call_unchanged(case: str, repo: Path, base: str, candidate_sha: str,
                       bare: Path, command: str, fields: dict[str, object],
                       *, accept: bool, reason: str | None = None,
                       seed: bool = False) -> tuple[bool, str]:
        suffix = command.replace("-", "-") + "-" + str(len(observations))
        state = tmp / f"r14-{case.lower()}-{suffix}-state"
        workspace = tmp / f"r14-{case.lower()}-{suffix}-workspace"
        request = transition_request(repo, base, str(fields.get("task_id", "r14-owner")),
                                     state, workspace, bare,
                                     candidate_sha=candidate_sha)
        request.update(fields)
        if seed:
            seed_owner_command_state(state, command, request)
        before = (filesystem_snapshot(state), filesystem_snapshot(workspace),
                  remote_refs(bare))
        rc, out, detail = authority_call(tmp, command, request)
        after = (filesystem_snapshot(state), filesystem_snapshot(workspace),
                 remote_refs(bare))
        accepted = rc == 0 and out.get("accepted") is True
        rejected = rc != 0 and out.get("accepted") is False
        reason_ok = reason is None or (rc == 1 and out.get("reason") == reason)
        unchanged = before == after
        ok = (accepted if accept else rejected and unchanged) and reason_ok
        return ok, repr({"rc":rc, "out":out, "unchanged":unchanged,
                         "detail":detail})

    def full_owner_chain(case: str, repo: Path, base: str,
                         bare: Path) -> tuple[bool, str]:
        state = tmp / f"r14-{case.lower()}-chain-state"
        workspace = tmp / f"r14-{case.lower()}-chain-workspace"
        write_json(state / "current.json", {
            "task":"r14-owner", "state":"OWNER_ACTION_REQUIRED", "base_sha":base})
        request = transition_request(repo, base, "r14-owner", state, workspace, bare)
        refs_before = remote_refs(bare)
        results = []
        for command, fields in (
            ("owner-author", {}),
            ("check-candidate", {"actor":"owner_authority"}),
            ("record-review", {"review_result":"PASS",
                               "review_identity":f"r14-{case}-review"}),
            ("owner-freeze", {"review_result":"PASS",
                              "review_identity":f"r14-{case}-review"}),
        ):
            rc, out, detail = authority_call(tmp, command, {**request, **fields})
            results.append((command, rc, out, detail))
        ok = (all(rc == 0 and out.get("accepted") is True
                  for _command, rc, out, _detail in results)
              and "OWNER_FROZEN" in persisted_state(state)
              and workspace.is_dir() and remote_refs(bare) == refs_before)
        return ok, repr(results)

    def policy_probe(repo: Path, base: str, candidate_sha: str,
                     task_id: str, *, accept: bool,
                     reason_fragment: str = "",
                     reason_exact: str = "") -> tuple[bool, str]:
        state = tmp / f"r14-policy-{task_id}-{candidate_sha}-state"
        workspace = tmp / f"r14-policy-{task_id}-{candidate_sha}-workspace"
        bare = tmp / f"r14-policy-{task_id}-{candidate_sha}-origin.git"
        p = run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
        if p.returncode: raise Rig(p.stderr)
        set_remote_main(bare, repo, base)
        before = (filesystem_snapshot(state), filesystem_snapshot(workspace),
                  remote_refs(bare))
        p = run([str(repo / "controller/policy/cli"), "check", task_id,
                 base, candidate_sha], cwd=repo, env=ordinary_python_env())
        after = (filesystem_snapshot(state), filesystem_snapshot(workspace),
                 remote_refs(bare))
        accepted = p.returncode == 0
        ok = (accepted is accept and before == after
              and (not reason_fragment or reason_fragment in (p.stdout + p.stderr))
              and (not reason_exact or (p.returncode == 4
                                        and p.stdout == reason_exact + "\n"
                                        and not p.stderr)))
        return ok, repr({"rc":p.returncode, "unchanged":before == after,
                         "output":(p.stdout or p.stderr)[-500:]})

    def concrete_path(pattern: str, serial: int) -> str:
        core, recursive = parse_path(pattern)
        return f"{core}/r14-{serial}.txt" if recursive else core

    def guarded_candidate(repo: Path, base: str, pattern: str, serial: int) -> str:
        """Touch one guarded path without corrupting canonical JSON consumers."""
        path = concrete_path(pattern, serial)
        if path not in {"specs/tasks.spec.json",
                        "specs/owner-production-paths.v1.json"}:
            return candidate(repo, base, path, serial)
        p = git(repo, "checkout", "-q", base)
        if p.returncode: raise Rig(p.stderr)
        target = repo / path
        target.write_bytes(target.read_bytes() + b"\n")
        return commit_paths(repo, f"candidate-{serial}", path)

    def path_permitted(path: str, guards: tuple[str, ...]) -> bool:
        target, target_recursive = parse_path(path)
        for guard in guards:
            parent, parent_recursive = parse_path(guard)
            if target_recursive:
                if parent_recursive and (target == parent
                                         or target.startswith(parent + "/")):
                    return True
            elif target == parent or (parent_recursive
                                      and target.startswith(parent + "/")):
                return True
        return False

    def require_distinguishing_entries(
            family: str, paths: list[str], *, owner_relation: str) -> None:
        for index, path in enumerate(paths):
            material = concrete_path(path, 1700 + index)
            if not overlap(material, path):
                raise Rig(f"R14 {family} entry {index} does not guard its probe")
            owner_paths = (*H034_OWNER_PATHS, *H036_OWNER_PATHS)
            if owner_relation == "disjoint":
                if any(overlap(path, owner) or overlap(material, owner)
                       for owner in owner_paths):
                    raise Rig(f"R14 {family} entry {index} is masked by owner production")
            elif owner_relation == "permitted":
                if not (path_permitted(path, owner_paths)
                        and path_permitted(material, owner_paths)):
                    raise Rig(f"R14 {family} entry {index} lacks owner-production control")
            else:
                raise Rig(f"R14 {family} unknown owner relation")
            for other_index, other in enumerate(paths):
                if index != other_index and (overlap(path, other)
                                             or overlap(material, other)):
                    raise Rig(f"R14 {family} entry {index} is masked by {other_index}")

    def positive_material(name: str, registry: dict[str, object],
                          owner_surface: list[str], owner_changes: list[str],
                          protected_paths: list[str],
                          global_denied_paths: list[str] | None = None,
                          *, require_protected_entry_independence: bool = False,
                          require_global_denied_entry_independence: bool = False,
                          global_denied_entries_owner_permitted: bool = False
                          ) -> tuple[bool, dict[str, str], tuple[Path, str, str, Path, str]]:
        global_denied_paths = (list(global_denied_paths)
                               if global_denied_paths is not None else [])
        if require_protected_entry_independence:
            require_distinguishing_entries(
                "prospective protected", protected_paths, owner_relation="disjoint")
        if require_global_denied_entry_independence:
            require_distinguishing_entries(
                "owner global deny", global_denied_paths,
                owner_relation=("permitted" if global_denied_entries_owner_permitted
                                else "disjoint"))
        repo, base, safe_candidate, bare = clone_case(
            name, registry, owner_surface, protected_paths, global_denied_paths)
        details: dict[str, str] = {}
        checks: list[bool] = []
        for label, command, candidate_sha, fields in (
            ("registry", "validate-registry", safe_candidate, {}),
            ("task", "validate-task", base, {"task_id":"r14-owner"}),
            ("candidate", "check-candidate", safe_candidate,
             {"task_id":"r14-safe", "actor":"ordinary"}),
        ):
            ok, detail = call_unchanged(name, repo, base, candidate_sha, bare,
                                        command, fields, accept=True)
            checks.append(ok); details[label] = detail
        ok, detail = full_owner_chain(name, repo, base, bare)
        checks.append(ok); details["base_owner_chain"] = detail
        changed_owner = candidate_paths(
            repo, base,
            [concrete_path(path, 1421 + index)
             for index, path in enumerate(owner_changes)],
            1421)
        ok, detail = call_unchanged(name + "-changed", repo, base, changed_owner,
                                    bare, "check-candidate",
                                    {"task_id":"r14-owner", "actor":"owner_authority"},
                                    accept=True)
        checks.append(ok); details["changed_owner_candidate"] = detail
        ok, detail = policy_probe(repo, base, safe_candidate, "r14-safe", accept=True)
        checks.append(ok); details["policy"] = detail
        for index, protected_path in enumerate(protected_paths):
            protected_task_id = f"r14-protected-{index}"
            ok, detail = call_unchanged(
                name + f"-protected-task-{index}", repo, base, base, bare,
                "validate-task", {"task_id":protected_task_id}, accept=False,
                reason="ordinary surface overlaps protected authority")
            checks.append(ok); details[f"protected_validate_task_{index}"] = detail
            protected_candidate = guarded_candidate(
                repo, base, protected_path, 1500 + index)
            ok, detail = call_unchanged(
                name + f"-protected-candidate-{index}", repo, base,
                protected_candidate, bare, "check-candidate",
                {"task_id":protected_task_id, "actor":"ordinary"},
                accept=False, reason="ordinary candidate overlaps protected authority")
            checks.append(ok); details[f"protected_check_candidate_{index}"] = detail
            ok, detail = policy_probe(repo, base, protected_candidate,
                                      protected_task_id, accept=False,
                                      reason_exact=(f"ordinary task {protected_task_id} "
                                                    "överlappar skyddad authority-yta"))
            checks.append(ok); details[f"ordinary_policy_protection_{index}"] = detail
        for index, global_denied_path in enumerate(global_denied_paths):
            global_task_id = f"r14-global-denied-{index}"
            ok, detail = call_unchanged(
                name + f"-global-denied-task-{index}", repo, base, base, bare,
                "validate-task", {"task_id":global_task_id}, accept=False,
                reason="owner surface overlaps global deny")
            checks.append(ok); details[f"global_denied_validate_task_{index}"] = detail
            denied_candidate = guarded_candidate(
                repo, base, global_denied_path, 1600 + index)
            ok, detail = call_unchanged(
                name + f"-global-denied-candidate-{index}", repo, base,
                denied_candidate, bare, "check-candidate",
                {"task_id":global_task_id, "actor":"owner_authority"},
                accept=False, reason="owner candidate changed global deny")
            checks.append(ok); details[f"global_denied_check_candidate_{index}"] = detail
        return all(checks), details, (repo, base, safe_candidate, bare, changed_owner)

    current_reordered = json.loads(json.dumps(current))
    current_reordered["owner_production_paths"] = list(
        reversed(current_reordered["owner_production_paths"]))
    prospective_reordered = json.loads(json.dumps(prospective))
    prospective_reordered["owner_production_paths"] = list(
        reversed(prospective_reordered["owner_production_paths"]))

    v1_ok, v1_detail, v1_case = positive_material(
        "V1_EXACT", current, list(H034_OWNER_PATHS), list(H034_OWNER_PATHS),
        list(H034_OWNER_PATHS))
    v1_reordered_ok, v1_reordered_detail, _ = positive_material(
        "V1_REORDERED", current_reordered, list(H034_OWNER_PATHS),
        list(H034_OWNER_PATHS), list(H034_OWNER_PATHS))
    _v1_repo, _v1_base, _v1_safe, _v1_bare, _v1_changed = v1_case
    v1_h036_repo, v1_h036_base = authority_repo(
        tmp, "r14-v1-h036-owner-denied",
        [owner_task("r14-h036-owner", list(H036_OWNER_PATHS))],
        registry=current)
    v1_h036_bare = tmp / "r14-v1-h036-owner-denied-origin.git"
    p = run(["git", "init", "--bare", "-q", str(v1_h036_bare)], cwd=tmp)
    if p.returncode: raise Rig(p.stderr)
    set_remote_main(v1_h036_bare, v1_h036_repo, v1_h036_base)
    v1_h036_ok, v1_h036_detail = call_unchanged(
        "V1-H036-DENIED", v1_h036_repo, v1_h036_base, v1_h036_base,
        v1_h036_bare, "validate-task", {"task_id":"r14-h036-owner"},
        accept=False, reason="owner surface outside owner production")
    record("V1_EXACT_AND_REORDERED_COMPATIBILITY", v1_ok and v1_reordered_ok
           and v1_h036_ok, "V1_COMPATIBILITY_REGRESSION",
           {"exact":v1_detail, "reordered":v1_reordered_detail,
            "h036_denied":v1_h036_detail})

    def registry_path_values(document: dict[str, object], key: str) -> list[str]:
        value = document.get(key)
        if (not isinstance(value, list) or not value
                or not all(isinstance(item, str) for item in value)):
            raise Rig(f"R14 {key} positive fixture is not a non-empty string list")
        return list(value)

    def canonical_list_entry_controls(
            state_name: str, template: dict[str, object]
            ) -> tuple[bool, dict[str, str]]:
        ok, detail, _ = positive_material(
            f"{state_name}_CANONICAL_LIST_ENTRIES", template,
            list(H034_OWNER_PATHS), [H034_OWNER_PATHS[1]],
            registry_path_values(template, "prospective_ordinary_protected_paths"),
            registry_path_values(template, "owner_author_global_denied_paths"),
            require_protected_entry_independence=True,
            require_global_denied_entry_independence=True)
        return ok, detail

    def non_owner_list_positives(
            state_name: str, template: dict[str, object]
            ) -> tuple[bool, dict[str, dict[str, str]]]:
        cases: list[tuple[str, str, list[str], bool]] = [
            ("PROSPECTIVE_DISTINGUISHING", "prospective_ordinary_protected_paths",
             ["r14-causal/protected/exact-a.txt",
              "r14-causal/protected/tree-b/**",
              "r14-causal/protected/exact-c.txt"], True),
            ("GLOBAL_DENIED_DISTINGUISHING", "owner_author_global_denied_paths",
             ["controller/h034-native/r14-causal-deny/exact-a.txt",
              "controller/h034-native/r14-causal-deny/tree-b/**",
              "controller/h034-native/r14-causal-deny/exact-c.txt"], True),
            ("PROSPECTIVE_OVERLAPPING", "prospective_ordinary_protected_paths",
             ["alternate/protected/**", "alternate/protected/child"], False),
            ("PROSPECTIVE_REORDERED", "prospective_ordinary_protected_paths", [
              "r14-causal/protected/exact-c.txt",
              "r14-causal/protected/tree-b/**",
              "r14-causal/protected/exact-a.txt"], True),
            ("GLOBAL_DENIED_OVERLAPPING", "owner_author_global_denied_paths",
             ["controller/h034-native/r14-overlap-deny/**",
              "controller/h034-native/r14-overlap-deny/child"], False),
            ("GLOBAL_DENIED_REORDERED", "owner_author_global_denied_paths", [
              "controller/h034-native/r14-causal-deny/exact-c.txt",
              "controller/h034-native/r14-causal-deny/tree-b/**",
              "controller/h034-native/r14-causal-deny/exact-a.txt"], True),
            ("PROSPECTIVE_BACKSLASH", "prospective_ordinary_protected_paths",
             ["r14-causal\\protected-backslash\\**"], True),
            ("GLOBAL_DENIED_BACKSLASH", "owner_author_global_denied_paths",
             ["controller\\h034-native\\r14-backslash-deny\\**"], True),
        ]
        results: list[bool] = []
        details: dict[str, dict[str, str]] = {}
        for label, field, values, distinguishing in cases:
            registry = json.loads(json.dumps(template)); registry[field] = values
            is_prospective = field == "prospective_ordinary_protected_paths"
            ok, detail, _ = positive_material(
                f"{state_name}_{label}", registry,
                (list(H034_OWNER_PATHS) if is_prospective
                 else [H034_OWNER_PATHS[1]]),
                [H034_OWNER_PATHS[1]],
                values if is_prospective else [H034_OWNER_PATHS[1]],
                [] if is_prospective else values,
                require_protected_entry_independence=(distinguishing and is_prospective),
                require_global_denied_entry_independence=(distinguishing and not is_prospective),
                global_denied_entries_owner_permitted=(distinguishing and not is_prospective))
            results.append(ok); details[label] = detail
        return all(results), details

    v1_canonical_lists_ok, v1_canonical_lists_detail = canonical_list_entry_controls(
        "V1", current)
    non_owner_positive_ok, non_owner_positive_detail = non_owner_list_positives(
        "V1_NON_OWNER", current)
    record("V1_NON_OWNER_LIST_VALUES_REMAIN_REGISTRY_AUTHORITY",
           v1_canonical_lists_ok and non_owner_positive_ok,
           "NON_OWNER_LIST_VALUES_WERE_INCORRECTLY_PINNED",
           {"canonical_every_entry":v1_canonical_lists_detail,
            "alternative_values":non_owner_positive_detail})

    v2_ok, v2_detail, v2_case = positive_material(
        "V2_EXACT", prospective, list(H036_OWNER_PATHS), list(H036_OWNER_PATHS),
        list(H036_OWNER_PATHS))
    v2_reordered_ok, v2_reordered_detail, _ = positive_material(
        "V2_REORDERED", prospective_reordered, list(H036_OWNER_PATHS),
        list(H036_OWNER_PATHS), list(H036_OWNER_PATHS))
    v2_h034_ok, v2_h034_detail, _ = positive_material(
        "V2_RETAINED_H034_EXACT", prospective, list(H034_OWNER_PATHS),
        list(H034_OWNER_PATHS), list(H034_OWNER_PATHS))
    v2_h034_reordered_ok, v2_h034_reordered_detail, _ = positive_material(
        "V2_RETAINED_H034_REORDERED", prospective_reordered,
        list(H034_OWNER_PATHS), list(H034_OWNER_PATHS), list(H034_OWNER_PATHS))
    v2_canonical_lists_ok, v2_canonical_lists_detail = canonical_list_entry_controls(
        "V2", prospective)
    v2_non_owner_ok, v2_non_owner_detail = non_owner_list_positives(
        "V2_NON_OWNER", prospective)
    record("V2_EXACT_POSITIVE_MATERIAL_CONSUMERS",
           v2_ok and v2_reordered_ok and v2_h034_ok and v2_h034_reordered_ok
           and v2_canonical_lists_ok and v2_non_owner_ok,
           "V1_ONLY_REJECTS_SCHEMA_V2",
           {"h036_exact":v2_detail, "h036_reordered":v2_reordered_detail,
            "retained_h034_exact":v2_h034_detail,
            "retained_h034_reordered":v2_h034_reordered_detail,
            "canonical_every_list_entry":v2_canonical_lists_detail,
            "non_owner_lists":v2_non_owner_detail})

    v2_repo, v2_base, _v2_safe, v2_bare, v2_changed = v2_case
    causal_checks: list[bool] = []
    causal_detail: dict[str, str] = {}
    for label, actor, task_id, reason in (
        ("ordinary_changed", "ordinary", "r14-safe",
         "ordinary candidate overlaps protected authority"),
        ("test_author_changed", "test_author", "r14-owner",
         "test author changed owner production"),
    ):
        ok, detail = call_unchanged(
            "V2-CAUSAL-" + label, v2_repo, v2_base, v2_changed, v2_bare,
            "check-candidate", {"task_id":task_id, "actor":actor},
            accept=False, reason=reason)
        causal_checks.append(ok); causal_detail[label] = detail
    for label, surface, authority, reason in (
        ("ordinary_surface", [H036_OWNER_PATHS[0]], "ordinary",
         "ordinary surface overlaps protected authority"),
        ("owner_neighbor", ["controller/launch/other.py"], "owner",
         "owner surface outside owner production"),
        ("owner_parent", ["controller/launch/**"], "owner",
         "owner surface outside owner production"),
    ):
        task = (ordinary_task("r14-negative", surface) if authority == "ordinary"
                else owner_task("r14-negative", surface))
        repo, base = authority_repo(tmp, "r14-causal-" + label, [task],
                                    registry=prospective)
        bare = tmp / ("r14-causal-" + label + "-origin.git")
        p = run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
        if p.returncode: raise Rig(p.stderr)
        set_remote_main(bare, repo, base)
        ok, detail = call_unchanged(
            "V2-CAUSAL-" + label, repo, base, base, bare, "validate-task",
            {"task_id":"r14-negative"}, accept=False, reason=reason)
        causal_checks.append(ok); causal_detail[label] = detail
    protected_candidate = candidate(v2_repo, v2_base, H036_OWNER_PATHS[0], 1422)
    ok, detail = policy_probe(v2_repo, v2_base, protected_candidate,
                              "r14-protected-0", accept=False,
                              reason_exact=("ordinary task r14-protected-0 "
                                            "överlappar skyddad authority-yta"))
    causal_checks.append(ok); causal_detail["policy_protected"] = detail
    record("V2_CAUSAL_NEGATIVE_CONTROLS", all(causal_checks),
           "V1_ONLY_REJECTS_SCHEMA_V2_BEFORE_REQUIRED_CAUSAL_REASON",
           causal_detail)

    member_descriptors = [
        ("H034_NATIVE", H034_OWNER_PATHS[0], "controller/h034-other/**", "controller/**"),
        ("H034_KERNEL", H034_OWNER_PATHS[1], "verify/h034/other-kernel", "verify/h034/**"),
        ("H034_RECIPE", H034_OWNER_PATHS[2], "verify/h034/other-build-recipe.json", "verify/h034/**"),
        ("H034_MANIFEST", H034_OWNER_PATHS[3], "verify/h034/other-identity-manifest.json", "verify/h034/**"),
        ("H036_CLI", H036_OWNER_PATHS[0], "controller/launch/other", "controller/launch/**"),
        ("H036_SNAPSHOT", H036_OWNER_PATHS[1], "controller/launch/other.py", "controller/launch/**"),
        ("H036_RUNTIME_CONFIG", H036_OWNER_PATHS[2], "config/python-runtime-authority-v3.json", "config/**"),
    ]

    member_mutants: list[tuple[str, object]] = []
    for state_name, template, descriptors in (
        ("V1", current, member_descriptors[:len(H034_OWNER_PATHS)]),
        ("V2", prospective, member_descriptors),
    ):
        for member_name, path, substitute, broader in descriptors:
            index = template["owner_production_paths"].index(path)
            for defect, replacement in (
                ("OMISSION", None),
                ("SUBSTITUTION", substitute),
                ("BACKSLASH_ALIAS", path.replace("/", "\\")),
                ("LEADING_DOT_ALIAS", "./" + path),
                ("BROADER_PREFIX", broader),
            ):
                mutant = json.loads(json.dumps(template))
                if replacement is None:
                    del mutant["owner_production_paths"][index]
                else:
                    mutant["owner_production_paths"][index] = replacement
                member_mutants.append((f"{state_name}_{member_name}_{defect}", mutant))
            mutant = json.loads(json.dumps(template))
            mutant["owner_production_paths"].append(path)
            member_mutants.append((f"{state_name}_{member_name}_DUPLICATE", mutant))
    member_one_defect_count = len(member_mutants)
    for name, template, members in (
        ("V1_ARBITRARY_ADDITION", current, "safe/arbitrary"),
        ("V2_ARBITRARY_ADDITION", prospective, "verify/h036/neighbor"),
        ("V2_NEW_ONLY", prospective, list(H036_OWNER_PATHS)),
        ("V2_PARTIAL_PLUS_ONE", prospective,
         [*H034_OWNER_PATHS, H036_OWNER_PATHS[0]]),
    ):
        mutant = json.loads(json.dumps(template))
        if isinstance(members, list):
            mutant["owner_production_paths"] = members
        else:
            mutant["owner_production_paths"].append(members)
        member_mutants.append((name, mutant))

    version_variants: list[tuple[str, object]] = [
        ("INT_0", 0), ("INT_3", 3), ("STRING_1", "1"), ("STRING_2", "2"),
        ("BOOL_FALSE", False), ("BOOL_TRUE", True),
        ("FLOAT_1", 1.0), ("FLOAT_2", 2.0),
        ("NULL", None), ("LIST", [1]), ("OBJECT", {"version":1}),
    ]
    version_mutants: list[tuple[str, object]] = []
    for membership_name, template in (("OLD4", current), ("UNION7", prospective)):
        for version_name, version in version_variants:
            mutant = json.loads(json.dumps(template)); mutant["schema_version"] = version
            name = f"VERSION_{version_name}_WITH_{membership_name}"
            if membership_name == "OLD4" and version_name == "BOOL_TRUE":
                name = "V1_BOOL_VERSION"
            elif membership_name == "OLD4" and version_name == "FLOAT_1":
                name = "V1_FLOAT_VERSION"
            version_mutants.append((name, mutant))
    mutant = json.loads(json.dumps(prospective)); mutant["schema_version"] = 1
    version_mutants.append(("V1_WITH_UNION7", mutant))
    mutant = json.loads(json.dumps(current)); mutant["schema_version"] = 2
    version_mutants.append(("V2_WITH_OLD4", mutant))

    def duplicate_registry_key(document: dict[str, object], key: str) -> str:
        raw = json.dumps(document, indent=2)
        marker = f'  "{key}": '
        duplicate = marker + json.dumps(document[key], ensure_ascii=False) + ",\n" + marker
        if raw.count(marker) != 1:
            raise Rig(f"R14 duplicate-key fixture marker count for {key}")
        return raw.replace(marker, duplicate, 1)

    non_owner_mutants: list[tuple[str, object]] = []
    for state_name, state_template in (("V1", current), ("V2", prospective)):
        for field, wrong in (
            ("path_grammar", "repo-tree-exact-or-terminal-recursive-prefix-v2"),
            ("authority_source", "caller-selected-registry"),
        ):
            for defect, value in (("TYPE", []), ("EMPTY", ""), ("VALUE", wrong)):
                mutant = json.loads(json.dumps(state_template)); mutant[field] = value
                non_owner_mutants.append(
                    (f"{state_name}_NON_OWNER_{field.upper()}_{defect}", mutant))
            non_owner_mutants.append(
                (f"{state_name}_NON_OWNER_{field.upper()}_DUPLICATE_KEY",
                 duplicate_registry_key(state_template, field)))

        for defect, value in (("TYPE_INT", 0), ("TYPE_STRING", "false"),
                              ("VALUE_TRUE", True)):
            mutant = json.loads(json.dumps(state_template))
            mutant["self_digest_is_authority"] = value
            non_owner_mutants.append(
                (f"{state_name}_NON_OWNER_SELF_DIGEST_{defect}", mutant))
        non_owner_mutants.append(
            (f"{state_name}_NON_OWNER_SELF_DIGEST_DUPLICATE_KEY",
             duplicate_registry_key(state_template, "self_digest_is_authority")))
        for field in ("prospective_ordinary_protected_paths",
                      "owner_author_global_denied_paths"):
            original = state_template[field]
            for defect, value in (
                ("TYPE", {}), ("EMPTY", []),
                ("MALFORMED", ["../escape", *original[1:]]),
                ("VALUE_TYPE", [7, *original[1:]]),
                ("DUPLICATE", [*original, original[0]]),
                ("CANONICAL_ALIAS_DUPLICATE",
                 [*original, str(original[0]).replace("/", "\\")]),
            ):
                mutant = json.loads(json.dumps(state_template)); mutant[field] = value
                non_owner_mutants.append(
                    (f"{state_name}_NON_OWNER_{field.upper()}_{defect}", mutant))
            non_owner_mutants.append(
                (f"{state_name}_NON_OWNER_{field.upper()}_DUPLICATE_KEY",
                 duplicate_registry_key(state_template, field)))

    check(member_one_defect_count == 66 and len(member_mutants) == 70
          and len(version_mutants) == 24 and len(non_owner_mutants) == 52,
          "J_R14_EXHAUSTIVE_MATRIX_CARDINALITY",
          repr({"member_one_defect":member_one_defect_count,
                "member_total":len(member_mutants),
                "version":len(version_mutants),
                "non_owner":len(non_owner_mutants)}))

    def hostile_material(name: str, registry: object) -> tuple[bool, dict[str, str]]:
        repo, base, safe_candidate, bare = clone_case(
            "HOSTILE_" + name, registry, list(H034_OWNER_PATHS))
        checks: list[bool] = []
        details: dict[str, str] = {}
        for label, command, candidate_sha, fields, seed in (
            ("validate_registry", "validate-registry", safe_candidate, {}, False),
            ("validate_task", "validate-task", safe_candidate,
             {"task_id":"r14-safe"}, False),
            ("check_candidate", "check-candidate", safe_candidate,
             {"task_id":"r14-safe", "actor":"ordinary"}, False),
            ("owner_author", "owner-author", base, {"task_id":"r14-owner"}, True),
            ("record_review", "record-review", base,
             {"task_id":"r14-owner", "review_result":"PASS",
              "review_identity":"r14-hostile-review"}, True),
            ("owner_freeze", "owner-freeze", base,
             {"task_id":"r14-owner", "review_result":"PASS",
              "review_identity":"r9-review"}, True),
        ):
            ok, detail = call_unchanged(
                "HOSTILE-" + name + "-" + label, repo, base, candidate_sha,
                bare, command, fields, accept=False, seed=seed)
            checks.append(ok); details[label] = detail
        ok, detail = policy_probe(repo, base, safe_candidate, "r14-safe",
                                  accept=False,
                                  reason_fragment="ogiltig authority contract")
        checks.append(ok); details["policy"] = detail
        return all(checks), details

    def run_hostile_matrix(cases: list[tuple[str, object]]) -> dict[str, tuple[bool, dict[str, str]]]:
        results: dict[str, tuple[bool, dict[str, str]]] = {}
        for name, mutant in cases:
            if name in results:
                raise Rig(f"duplicate R14 hostile case name: {name}")
            results[name] = hostile_material(name, mutant)
        return results

    member_results = run_hostile_matrix(member_mutants)
    record("EVERY_OLD4_NEW3_MEMBER_ONE_DEFECT_MATERIAL_CONSUMERS",
           all(ok for ok, _detail in member_results.values()),
           "MEMBER_ONE_DEFECT_REACHED_INCONSISTENT_CONSUMER",
           {name:detail for name, (ok, detail) in member_results.items() if not ok})

    version_results = run_hostile_matrix(version_mutants)
    bool_ok, bool_detail = version_results.pop("V1_BOOL_VERSION")
    float_ok, float_detail = version_results.pop("V1_FLOAT_VERSION")
    record("V1_BOOL_HOSTILE_MATERIAL_CONSUMERS", bool_ok,
           "NUMERIC_ALIAS_ACCEPTED", bool_detail)
    record("V1_FLOAT_HOSTILE_MATERIAL_CONSUMERS", float_ok,
           "NUMERIC_ALIAS_ACCEPTED", float_detail)
    record("VERSION_TYPE_WITH_BOTH_LEGAL_MEMBERSHIPS_MATERIAL_CONSUMERS",
           all(ok for ok, _detail in version_results.values()),
           "VERSION_MEMBERSHIP_CROSS_CASE_REACHED_INCONSISTENT_CONSUMER",
           {name:detail for name, (ok, detail) in version_results.items() if not ok})

    non_owner_results = run_hostile_matrix(non_owner_mutants)
    record("EVERY_RETAINED_NON_OWNER_REGISTRY_SEMANTIC_MATERIAL_CONSUMERS",
           all(ok for ok, _detail in non_owner_results.values()),
           "NON_OWNER_REGISTRY_SEMANTIC_REACHED_INCONSISTENT_CONSUMER",
           {name:detail for name, (ok, detail) in non_owner_results.items() if not ok})

    r14_product_scope_selftests(tmp)
    failures = [{"observation":name, "reason":reason}
                for name, ok, reason, _detail in observations if not ok]
    expected = H035_R14_TWO_STATE_REGISTRY["preproduct_evidence"][
        "expected_failure_signature"]
    expected_reason = H035_R14_TWO_STATE_REGISTRY["preproduct_evidence"][
        "expected_reason"]
    detail = json.dumps({
        "reason":expected_reason if exact_value(failures, expected)
                 else "UNEXPECTED_R14_FAILURE_SIGNATURE",
        "failure_signature":failures,
        "diagnostics":{name:value for name, ok, _reason, value in observations if not ok},
    }, sort_keys=True)
    check(not failures, "A_R14_EXACT_TWO_STATE_REGISTRY_OPERATIONAL", detail)


def r29_registry_migration_controls(tmp: Path,*,r33: bool=False) -> None:
    """Incremental v3 matrix; R14 remains the complete v1/v2 floor."""
    canonical=strict_load(REG)
    if (not isinstance(canonical,dict)
            or canonical.get("schema_version")!=2
            or set(canonical.get("owner_production_paths",[]))!=PROSPECTIVE_OWNER):
        raise Rig("R29 canonical registry must remain exact schema v2 union7")
    v3=json.loads(json.dumps(canonical))
    v3["schema_version"]=3
    v3["owner_production_paths"]=[*H034_OWNER_PATHS,*H036_OWNER_PATHS,
                                  *H039_OWNER_PATHS]
    h039_disjoint_ordinary_paths=tuple(H035_R29_THREE_STATE_REGISTRY[
        "operational_matrix"]["h039_exact_file_disjoint_positive_paths"])
    h039_forbidden_owner_prefixes=tuple(H035_R29_THREE_STATE_REGISTRY[
        "operational_matrix"]["h039_forbidden_owner_broad_prefixes"])
    observations: list[tuple[str,bool,str,object]]=[]

    def record(name: str,ok: bool,reason: str,detail: object) -> None:
        observations.append((name,ok,reason,detail))

    def clone_case(name: str,registry: object,owner_surface: list[str],
                   protected_paths: list[str]|None=None,
                   global_denied_paths: list[str]|None=None,
                   ordinary_positive_paths: list[str]|None=None,
                   owner_rejected_paths: list[str]|None=None
                   ) -> tuple[Path,str,str,Path]:
        protected_paths=(list(protected_paths) if protected_paths is not None
                         else list(H039_OWNER_PATHS))
        global_denied_paths=(list(global_denied_paths)
                             if global_denied_paths is not None else [])
        ordinary_positive_paths=(list(ordinary_positive_paths)
                                 if ordinary_positive_paths is not None else [])
        owner_rejected_paths=(list(owner_rejected_paths)
                              if owner_rejected_paths is not None else [])
        repo=tmp/("r29-case-"+name.lower().replace("_","-"));init_repo(repo)
        (repo/"specs").mkdir()
        registry_path=repo/"specs/owner-production-paths.v1.json"
        if isinstance(registry,dict):write_json(registry_path,registry)
        elif isinstance(registry,str):registry_path.write_text(
            registry+("" if registry.endswith("\n") else "\n"),encoding="utf-8")
        else:raise Rig("R29 registry fixture type")
        write_json(repo/"specs/tasks.spec.json",{
            "spec_version":"2.0.0",
            "defaults":{"denied_write":[],"max_changed_files":10,
                        "max_added_lines":100},"tasks":[]})
        commit_paths(repo,"r29 registry activation without future fixture tasks",
            "specs/tasks.spec.json","specs/owner-production-paths.v1.json")
        gate=repo/"verify/bin/h-035-exit";gate.parent.mkdir(parents=True)
        gate.write_bytes(Path(__file__).read_bytes());gate.chmod(0o755)
        core=repo/"controller/authority/core.py";core.parent.mkdir(parents=True)
        core.write_bytes((ROOT/"controller/authority/core.py").read_bytes())
        policy=repo/"controller/policy/cli";policy.parent.mkdir(parents=True)
        policy.write_bytes((ROOT/"controller/policy/cli").read_bytes());policy.chmod(0o755)
        tasks=[ordinary_task("r29-safe",["tests/r29-safe/**"]),
               owner_task("r29-owner",owner_surface)]
        tasks.extend(ordinary_task(f"r29-protected-{index}",[path])
                     for index,path in enumerate(protected_paths))
        tasks.extend(owner_task(f"r29-global-denied-{index}",[path])
                     for index,path in enumerate(global_denied_paths))
        tasks.extend(ordinary_task(f"r29-disjoint-{index}",[path])
                     for index,path in enumerate(ordinary_positive_paths))
        tasks.extend(owner_task(f"r29-owner-prefix-{index}",[path])
                     for index,path in enumerate(owner_rejected_paths))
        write_json(repo/"specs/tasks.spec.json",{
            "spec_version":"2.0.0",
            "defaults":{"denied_write":[],"max_changed_files":10,
                        "max_added_lines":100},"tasks":tasks})
        base=commit_paths(repo,"r29 material registry case",
            "specs/tasks.spec.json","verify/bin/h-035-exit",
            "controller/authority/core.py","controller/policy/cli")
        safe=candidate(repo,base,"tests/r29-safe/effect.txt",2700)
        bare=tmp/("r29-origin-"+name.lower().replace("_","-")+".git")
        p=run(["git","init","--bare","-q",str(bare)],cwd=tmp)
        if p.returncode:raise Rig(p.stderr)
        set_remote_main(bare,repo,base)
        return repo,base,safe,bare

    def unchanged_call(case: str,repo: Path,base: str,candidate_sha: str,
                       bare: Path,command: str,fields: dict[str,object],
                       *,accept: bool,reason: str|None=None,
                       seed: bool=False,
                       accept_effect_mutant: str|None=None) -> tuple[bool,str]:
        serial=len(list(tmp.glob("r29-*-state")))
        state=tmp/f"r29-{case.lower()}-{serial}-state"
        workspace=tmp/f"r29-{case.lower()}-{serial}-workspace"
        request=transition_request(repo,base,str(fields.get("task_id","r29-owner")),
                                   state,workspace,bare,candidate_sha=candidate_sha)
        request.update(fields)
        if seed:seed_owner_command_state(state,command,request)
        before=(filesystem_snapshot(state),filesystem_snapshot(workspace),
                remote_refs(bare))
        rc,out,detail=authority_call(tmp,command,request)
        if accept_effect_mutant=="STATE":
            write_json(state/"r29-accept-effect-mutant.json",{"effect":"state"})
        elif accept_effect_mutant=="WORKSPACE":
            write_json(workspace/"r29-accept-effect-mutant.json",{"effect":"workspace"})
        elif accept_effect_mutant=="REMOTE_REFS":
            effect=git(bare,"update-ref","refs/heads/r29-accept-effect-mutant",base)
            if effect.returncode:raise Rig(effect.stderr)
        elif accept_effect_mutant is not None:
            raise Rig("R29 unknown accept-effect mutant")
        after=(filesystem_snapshot(state),filesystem_snapshot(workspace),
               remote_refs(bare))
        accepted=rc==0 and out.get("accepted") is True
        rejected=rc!=0 and out.get("accepted") is False
        reason_ok=reason is None or rc==1 and out.get("reason")==reason
        ok=(accepted if accept else rejected) and before==after and reason_ok
        return ok,repr({"rc":rc,"out":out,"unchanged":before==after,
                        "detail":detail})

    def policy_probe(repo: Path,base: str,candidate_sha: str,task_id: str,
                     bare: Path,*,accept: bool,reason: str="") -> tuple[bool,str]:
        state=tmp/f"r29-policy-{task_id}-{candidate_sha}-state"
        workspace=tmp/f"r29-policy-{task_id}-{candidate_sha}-workspace"
        before=(filesystem_snapshot(state),filesystem_snapshot(workspace),
                remote_refs(bare))
        p=run([str(repo/"controller/policy/cli"),"check",task_id,base,candidate_sha],
              cwd=repo,env=ordinary_python_env())
        after=(filesystem_snapshot(state),filesystem_snapshot(workspace),
               remote_refs(bare))
        output=p.stdout+p.stderr
        return ((p.returncode==0) is accept and before==after
                and (not reason or reason in output)),repr({
                    "rc":p.returncode,"unchanged":before==after,
                    "output":output[-500:]})

    def concrete_path(pattern: str,serial: int) -> str:
        core,recursive=parse_path(pattern)
        return f"{core}/r29-{serial}.txt" if recursive else core

    def guarded_candidate(repo: Path,base: str,pattern: str,serial: int) -> str:
        path=concrete_path(pattern,serial)
        if path not in {"specs/tasks.spec.json",
                        "specs/owner-production-paths.v1.json"}:
            return candidate(repo,base,path,serial)
        checkout=git(repo,"checkout","-q",base)
        if checkout.returncode:raise Rig(checkout.stderr)
        target=repo/path;target.write_bytes(target.read_bytes()+b"\n")
        return commit_paths(repo,f"r29 candidate-{serial}",path)

    def path_permitted(path: str,guards: tuple[str,...]) -> bool:
        target,target_recursive=parse_path(path)
        for guard in guards:
            parent,parent_recursive=parse_path(guard)
            if target_recursive:
                if parent_recursive and (target==parent
                                         or target.startswith(parent+"/")):
                    return True
            elif target==parent or (parent_recursive
                                    and target.startswith(parent+"/")):
                return True
        return False

    def require_distinguishing_entries(
            family: str,paths: list[str],*,owner_relation: str) -> None:
        owner_paths=(*H034_OWNER_PATHS,*H036_OWNER_PATHS,*H039_OWNER_PATHS)
        for index,path in enumerate(paths):
            material=concrete_path(path,2800+index)
            if not overlap(material,path):
                raise Rig(f"R29 {family} entry {index} does not guard its probe")
            if owner_relation=="disjoint":
                if any(overlap(path,owner) or overlap(material,owner)
                       for owner in owner_paths):
                    raise Rig(f"R29 {family} entry {index} is masked by owner production")
            elif owner_relation=="permitted":
                if not (path_permitted(path,owner_paths)
                        and path_permitted(material,owner_paths)):
                    raise Rig(f"R29 {family} entry {index} lacks owner-production control")
            else:raise Rig(f"R29 {family} unknown owner relation")
            for other_index,other in enumerate(paths):
                if index!=other_index and (overlap(path,other)
                                           or overlap(material,other)):
                    raise Rig(f"R29 {family} entry {index} is masked by {other_index}")

    def positive_material(name: str,registry: dict[str,object],
                          owner_surface: list[str],
                          owner_changes: list[str]|None=None,
                          protected_paths: list[str]|None=None,
                          global_denied_paths: list[str]|None=None,
                          *,require_protected_entry_independence: bool=False,
                          require_global_denied_entry_independence: bool=False,
                          global_denied_entries_owner_permitted: bool=False
                          ) -> tuple[bool,dict[str,str]]:
        protected_paths=(list(protected_paths) if protected_paths is not None
                         else list(H039_OWNER_PATHS))
        owner_changes=(list(owner_changes) if owner_changes is not None
                       else list(owner_surface))
        global_denied_paths=(list(global_denied_paths)
                             if global_denied_paths is not None else [])
        if require_protected_entry_independence:
            require_distinguishing_entries(
                "prospective protected",protected_paths,owner_relation="disjoint")
        if require_global_denied_entry_independence:
            require_distinguishing_entries(
                "owner global deny",global_denied_paths,
                owner_relation=("permitted" if global_denied_entries_owner_permitted
                                else "disjoint"))
        repo,base,safe,bare=clone_case(name,registry,owner_surface,
            protected_paths,global_denied_paths)
        detail: dict[str,str]={};checks=[]
        for label,command,candidate_sha,fields in (
            ("registry","validate-registry",safe,{}),
            ("task","validate-task",base,{"task_id":"r29-owner"}),
            ("candidate","check-candidate",safe,
             {"task_id":"r29-safe","actor":"ordinary"})):
            ok,why=unchanged_call(name,repo,base,candidate_sha,bare,command,
                                  fields,accept=True)
            checks.append(ok);detail[label]=why
        state=tmp/f"r29-{name.lower()}-chain-state"
        workspace=tmp/f"r29-{name.lower()}-chain-workspace"
        write_json(state/"current.json",{
            "task":"r29-owner","state":"OWNER_ACTION_REQUIRED","base_sha":base})
        request=transition_request(repo,base,"r29-owner",state,workspace,bare)
        refs_before=remote_refs(bare);chain=[]
        for command,fields in (
            ("owner-author",{}),
            ("check-candidate",{"actor":"owner_authority"}),
            ("record-review",{"review_result":"PASS",
                              "review_identity":"r29-"+name+"-review"}),
            ("owner-freeze",{"review_result":"PASS",
                             "review_identity":"r29-"+name+"-review"})):
            rc,out,why=authority_call(tmp,command,{**request,**fields})
            chain.append((rc,out,why))
        chain_ok=(all(rc==0 and out.get("accepted") is True
                      for rc,out,_why in chain)
                  and "OWNER_FROZEN" in persisted_state(state)
                  and remote_refs(bare)==refs_before)
        checks.append(chain_ok);detail["owner_chain"]=repr(chain)
        changed_owner=candidate_paths(repo,base,[
            concrete_path(path,2820+index)
            for index,path in enumerate(owner_changes)],2820)
        ok,why=unchanged_call(name+"-changed-owner",repo,base,changed_owner,
            bare,"check-candidate",{"task_id":"r29-owner",
            "actor":"owner_authority"},accept=True)
        checks.append(ok);detail["changed_owner_candidate"]=why
        ok,why=policy_probe(repo,base,safe,"r29-safe",bare,accept=True)
        checks.append(ok);detail["ordinary_policy"]=why
        for index,path in enumerate(protected_paths):
            protected_task_id=f"r29-protected-{index}"
            ok,why=unchanged_call(name+f"-protected-task-{index}",repo,base,
                base,bare,"validate-task",{"task_id":protected_task_id},
                accept=False,reason="ordinary surface overlaps protected authority")
            checks.append(ok);detail[f"protected_validate_task_{index}"]=why
            protected=candidate(repo,base,path,2750+index)
            ok,why=unchanged_call(name+f"-protected-{index}",repo,base,
                protected,bare,"check-candidate",
                {"task_id":protected_task_id,"actor":"ordinary"},accept=False,
                reason="ordinary candidate overlaps protected authority")
            checks.append(ok);detail[f"protected_candidate_{index}"]=why
            ok,why=policy_probe(repo,base,protected,protected_task_id,bare,accept=False,
                reason=(f"ordinary task {protected_task_id} "
                        "överlappar skyddad authority-yta"))
            checks.append(ok);detail[f"protected_policy_{index}"]=why
        for index,path in enumerate(global_denied_paths):
            global_task_id=f"r29-global-denied-{index}"
            ok,why=unchanged_call(name+f"-global-denied-task-{index}",repo,
                base,base,bare,"validate-task",{"task_id":global_task_id},
                accept=False,reason="owner surface overlaps global deny")
            checks.append(ok);detail[f"global_denied_validate_task_{index}"]=why
            denied=guarded_candidate(repo,base,path,2850+index)
            ok,why=unchanged_call(name+f"-global-denied-{index}",repo,base,
                denied,bare,"check-candidate",
                {"task_id":global_task_id,"actor":"owner_authority"},
                accept=False,reason="owner candidate changed global deny")
            checks.append(ok);detail[f"global_denied_candidate_{index}"]=why
        return all(checks),detail

    def h039_exact_neighbor_disjointness_positive(
            registry: dict[str,object]) -> tuple[bool,dict[str,str]]:
        owner_paths=(*H034_OWNER_PATHS,*H036_OWNER_PATHS,*H039_OWNER_PATHS)
        if (len(h039_disjoint_ordinary_paths)!=2*len(H039_OWNER_PATHS)
                or len(set(h039_disjoint_ordinary_paths))
                   !=len(h039_disjoint_ordinary_paths)):
            raise Rig("R29 H039 exact neighbor positive cardinality")
        for index,owner in enumerate(H039_OWNER_PATHS):
            neighbor=h039_disjoint_ordinary_paths[2*index]
            descendant=h039_disjoint_ordinary_paths[2*index+1]
            if (neighbor.rsplit("/",1)[0]!=owner.rsplit("/",1)[0]
                    or descendant.rsplit("/",1)[0]!=owner
                    or any(overlap(value,guard) for value in (neighbor,descendant)
                           for guard in owner_paths)):
                raise Rig(f"R29 H039 member {index} neighbor/descendant not exact-disjoint")
        repo,base,safe,bare=clone_case(
            "V3_H039_EXACT_DISJOINT",registry,list(H039_OWNER_PATHS),
            protected_paths=[],
            ordinary_positive_paths=list(h039_disjoint_ordinary_paths),
            owner_rejected_paths=list(h039_forbidden_owner_prefixes))
        checks=[];detail={}
        ok,why=unchanged_call("V3-H039-DISJOINT-REGISTRY",repo,base,safe,
            bare,"validate-registry",{},accept=True)
        checks.append(ok);detail["validate_registry"]=why
        for index,path in enumerate(h039_disjoint_ordinary_paths):
            task_id=f"r29-disjoint-{index}"
            ok,why=unchanged_call(f"V3-H039-DISJOINT-TASK-{index}",repo,
                base,base,bare,"validate-task",{"task_id":task_id},accept=True)
            checks.append(ok);detail[f"validate_task_{index}"]=why
            ordinary=guarded_candidate(repo,base,path,2880+index)
            ok,why=unchanged_call(f"V3-H039-DISJOINT-CANDIDATE-{index}",
                repo,base,ordinary,bare,"check-candidate",
                {"task_id":task_id,"actor":"ordinary"},accept=True)
            checks.append(ok);detail[f"check_candidate_{index}"]=why
            ok,why=policy_probe(repo,base,ordinary,task_id,bare,accept=True)
            checks.append(ok);detail[f"ordinary_policy_{index}"]=why
        for index,path in enumerate(h039_forbidden_owner_prefixes):
            task_id=f"r29-owner-prefix-{index}"
            ok,why=unchanged_call(f"V3-H039-OWNER-PREFIX-TASK-{index}",repo,
                base,base,bare,"validate-task",{"task_id":task_id},
                accept=False,reason="owner surface outside owner production")
            checks.append(ok);detail[f"owner_prefix_validate_task_{index}"]=why
            broad=guarded_candidate(repo,base,path,2910+index)
            ok,why=unchanged_call(f"V3-H039-OWNER-PREFIX-CANDIDATE-{index}",
                repo,base,broad,bare,"check-candidate",
                {"task_id":task_id,"actor":"owner_authority"},accept=False,
                reason="owner surface outside owner production")
            checks.append(ok);detail[f"owner_prefix_candidate_{index}"]=why
        return all(checks),detail

    def v3_non_owner_list_positives(
            template: dict[str,object]) -> tuple[bool,dict[str,object]]:
        cases: list[tuple[str,str,list[str],bool]]=[
            ("PROSPECTIVE_DISTINGUISHING","prospective_ordinary_protected_paths",
             ["r29-causal/protected/exact-a.txt",
              "r29-causal/protected/tree-b/**",
              "r29-causal/protected/exact-c.txt"],True),
            ("GLOBAL_DENIED_DISTINGUISHING","owner_author_global_denied_paths",
             ["controller/h034-native/r29-causal-deny/exact-a.txt",
              "controller/h034-native/r29-causal-deny/tree-b/**",
              "controller/h034-native/r29-causal-deny/exact-c.txt"],True),
            ("PROSPECTIVE_OVERLAPPING","prospective_ordinary_protected_paths",
             ["alternate/protected/**","alternate/protected/child"],False),
            ("PROSPECTIVE_REORDERED","prospective_ordinary_protected_paths",
             ["r29-causal/protected/exact-c.txt",
              "r29-causal/protected/tree-b/**",
              "r29-causal/protected/exact-a.txt"],True),
            ("GLOBAL_DENIED_OVERLAPPING","owner_author_global_denied_paths",
             ["controller/h034-native/r29-overlap-deny/**",
              "controller/h034-native/r29-overlap-deny/child"],False),
            ("GLOBAL_DENIED_REORDERED","owner_author_global_denied_paths",
             ["controller/h034-native/r29-causal-deny/exact-c.txt",
              "controller/h034-native/r29-causal-deny/tree-b/**",
              "controller/h034-native/r29-causal-deny/exact-a.txt"],True),
            ("PROSPECTIVE_BACKSLASH","prospective_ordinary_protected_paths",
             ["r29-causal\\protected-backslash\\**"],True),
            ("GLOBAL_DENIED_BACKSLASH","owner_author_global_denied_paths",
             ["controller\\h034-native\\r29-backslash-deny\\**"],True),
        ]
        results=[];details={};component_ok={}
        for label,field,values,distinguishing in cases:
            registry=json.loads(json.dumps(template));registry[field]=values
            prospective=field=="prospective_ordinary_protected_paths"
            ok,detail=positive_material(
                "V3_NON_OWNER_"+label,registry,
                (list(H039_OWNER_PATHS) if prospective
                 else [H034_OWNER_PATHS[1]]),
                owner_changes=(list(H039_OWNER_PATHS) if prospective
                               else [H034_OWNER_PATHS[1]]),
                protected_paths=(values if prospective else [H039_OWNER_PATHS[0]]),
                global_denied_paths=([] if prospective else values),
                require_protected_entry_independence=(distinguishing and prospective),
                require_global_denied_entry_independence=(distinguishing and not prospective),
                global_denied_entries_owner_permitted=(distinguishing and not prospective))
            results.append(ok);details[label]=detail;component_ok[label]=ok
        details["_component_ok"]=component_ok
        return all(results),details

    def r33_fresh_remote(label: str,repo: Path,base: str,serial: int) -> Path:
        bare=tmp/f"r33-{label.lower()}-{serial}-origin.git"
        p=run(["git","init","--bare","-q",str(bare)],cwd=tmp)
        if p.returncode:raise Rig(p.stderr)
        set_remote_main(bare,repo,base)
        return bare

    def r33_exact_json_directory(root: Path,
                                 expected: dict[str,dict[str,object]]) -> bool:
        try:
            if (not root.is_dir()
                    or sorted(item.name for item in root.iterdir())!=sorted(expected)):
                return False
            for name,value in expected.items():
                path=root/name;info=os.lstat(path)
                if (not stat.S_ISREG(info.st_mode) or info.st_nlink!=1
                        or stat.S_IMODE(info.st_mode)!=0o600
                        or path.read_bytes()!=(json.dumps(
                            value,sort_keys=True,indent=2)+"\n").encode("utf-8")):
                    return False
            return True
        except (OSError,UnicodeError,ValueError,TypeError):
            return False

    def r33_positive_effects(command: str,request: dict[str,object],
                             state: Path,workspace: Path,
                             before: tuple[dict[str,str],dict[str,str],str],
                             after: tuple[dict[str,str],dict[str,str],str]) -> bool:
        if before[2]!=after[2]:return False
        if command in {"validate-task","check-candidate"}:return before==after
        context={"task":request["task_id"],"base_sha":request["base_sha"],
            "main_sha":request["main_sha"],"spec_sha256":request["spec_sha256"],
            "registry_sha256":request["registry_sha256"],
            "gate_path":request["gate_path"],"gate_sha256":request["gate_sha256"],
            "authority_class":"owner_authority"}
        candidate_sha=request["candidate_sha"]
        if command=="owner-author":
            value={**context,"state":"OWNER_CANDIDATE_REVIEW_REQUIRED",
                   "candidate_sha":candidate_sha,"authority_class":"owner_authority"}
            value["transition_identity"]=hashlib.sha256(json.dumps(
                value,sort_keys=True,separators=(",",":")).encode("utf-8")).hexdigest()
            return (r33_exact_json_directory(state,{"current.json":value})
                    and r33_exact_json_directory(workspace,{"owner-attempt.json":value}))
        if command=="record-review":
            value={"task":request["task_id"],
                "state":"OWNER_CANDIDATE_REVIEW_REQUIRED",
                "base_sha":request["base_sha"],"candidate_sha":candidate_sha}
            value={**value,**context,"state":"OWNER_FINAL_FREEZE_REQUIRED",
                   "candidate_sha":candidate_sha,
                   "review_identity":request["review_identity"],"review_result":"PASS"}
            return (r33_exact_json_directory(state,{"current.json":value})
                    and not workspace.exists())
        if command=="owner-freeze":
            value={"task":request["task_id"],"state":"OWNER_FROZEN",
                "base_sha":request["base_sha"],"main_sha":request["main_sha"],
                "candidate_sha":candidate_sha,"spec_sha256":request["spec_sha256"],
                "registry_sha256":request["registry_sha256"],
                "gate_path":request["gate_path"],"gate_sha256":request["gate_sha256"],
                "review_identity":"r9-review","review_result":"PASS"}
            return (r33_exact_json_directory(state,{"current.json":value})
                    and not workspace.exists())
        return False

    def r33_owner_surface_cell(version: int,label: str,surface: list[str],
                               accept: bool) -> tuple[bool,dict[str,str]]:
        registry=json.loads(json.dumps(canonical))
        registry["schema_version"]=version
        registry["owner_production_paths"]=(list(H034_OWNER_PATHS) if version==1
            else [*H034_OWNER_PATHS,*H036_OWNER_PATHS] if version==2
            else [*H034_OWNER_PATHS,*H036_OWNER_PATHS,*H039_OWNER_PATHS])
        repo,base,_safe,initial_bare=clone_case(
            f"R33_V{version}_{label}",registry,surface,protected_paths=[])
        if version==3 and label=="BROAD_CONTROLLER":
            material_paths=[H039_OWNER_PATHS[0]]
        elif version==3 and label=="BROAD_VERIFY":
            material_paths=[H039_OWNER_PATHS[2]]
        else:
            material_paths=[concrete_path(path,3000+index)
                            for index,path in enumerate(surface)]
        material=candidate_paths(repo,base,material_paths,3000+version)
        checks=[];details={}
        commands=(
            ("validate-task",base,{"task_id":"r29-owner"},False),
            ("check-candidate-empty",base,{"task_id":"r29-owner",
                                            "actor":"owner_authority"},False),
            ("check-candidate-material",material,{"task_id":"r29-owner",
                                                   "actor":"owner_authority"},False),
            ("owner-author",base,{"task_id":"r29-owner"},True),
            ("record-review",material,{"task_id":"r29-owner",
                "review_result":"PASS","review_identity":"r33-review"},True),
            ("owner-freeze",material,{"task_id":"r29-owner",
                "review_result":"PASS","review_identity":"r9-review"},True),
        )
        for serial,(case,candidate_sha,fields,seed) in enumerate(commands):
            command=case.split("-empty",1)[0].split("-material",1)[0]
            bare=(initial_bare if serial==0 else
                  r33_fresh_remote(f"v{version}-{label}-{case}",repo,base,serial))
            state=tmp/f"r33-v{version}-{label.lower()}-{case}-{serial}-state"
            workspace=tmp/f"r33-v{version}-{label.lower()}-{case}-{serial}-workspace"
            request=transition_request(repo,base,"r29-owner",state,workspace,bare,
                                       candidate_sha=candidate_sha)
            request.update(fields)
            request.update({
                "registry_schema_version":99,
                "registry_owner_production_paths":["controller/**"],
                "reported_changed_files":[],
            })
            if seed:seed_owner_command_state(state,command,request)
            before=(filesystem_snapshot(state),filesystem_snapshot(workspace),remote_refs(bare))
            rc,out,detail=authority_call(tmp,command,request)
            after=(filesystem_snapshot(state),filesystem_snapshot(workspace),remote_refs(bare))
            if accept:
                ok=(rc==0 and out.get("accepted") is True
                    and r33_positive_effects(command,request,state,workspace,before,after))
            else:
                ok=(rc==1 and out.get("accepted") is False
                    and out.get("reason")=="owner surface outside owner production"
                    and before==after)
            checks.append(ok);details[case]=repr({"rc":rc,"out":out,
                "unchanged":before==after,"detail":detail})
        return all(checks),details

    def r33_cross_product() -> tuple[bool,dict[str,object]]:
        surfaces=(
            ("H034",list(H034_OWNER_PATHS)),
            ("H036",list(H036_OWNER_PATHS)),
            ("H039",list(H039_OWNER_PATHS)),
            ("BROAD_CONTROLLER",["controller/runtime-cleanup/**"]),
            ("BROAD_VERIFY",["verify/h039/**"]),
        )
        allowed={1:{"H034"},2:{"H034","H036"},3:{"H034","H036","H039"}}
        results=[];details={};component_ok={}
        for version in (1,2,3):
            for label,surface in surfaces:
                ok,detail=r33_owner_surface_cell(
                    version,label,surface,label in allowed[version])
                results.append(ok);details[f"V{version}_{label}"]=detail
        return all(results),details

    def r33_path_transport() -> tuple[bool,dict[str,str]]:
        path='controller/h034-native/r33-line\nquote"back\\slash.txt'
        repo,base,_safe,bare=clone_case("R33_PATH_TRANSPORT",canonical,[path],
                                        protected_paths=[])
        material=candidate(repo,base,path,3030)
        state=tmp/"r33-path-positive-state";workspace=tmp/"r33-path-positive-workspace"
        request=transition_request(repo,base,"r29-owner",state,workspace,bare,
                                   candidate_sha=material)
        request.update({"actor":"owner_authority","reported_changed_files":[]})
        rc,out,why=authority_call(tmp,"check-candidate",request)
        positive=rc==0 and out.get("accepted") is True \
            and out.get("changed_files")==[path.replace("\\","/")]
        raw_relative=b"controller/h034-native/r33-invalid-\xff.txt"
        fixture_env=os.environ.copy();fixture_env["GIT_INDEX_FILE"]=str(
            tmp/"r33-invalid-utf8.index")
        read_tree=subprocess.run(["git","-C",str(repo),"read-tree",base],
            env=fixture_env,capture_output=True,check=False)
        blob=subprocess.run(["git","-C",str(repo),"hash-object","-w","--stdin"],
            input=b"invalid UTF-8 fixture\n",capture_output=True,check=False)
        oid=blob.stdout.strip()
        update=subprocess.run([b"git",b"-C",os.fsencode(repo),b"update-index",
            b"-z",b"--index-info"],env=fixture_env,
            input=b"100644 "+oid+b"\t"+raw_relative+b"\0",
            capture_output=True,check=False)
        tree=subprocess.run(["git","-C",str(repo),"write-tree"],env=fixture_env,
            text=True,capture_output=True,check=False)
        commit=subprocess.run(["git","-C",str(repo),"commit-tree",tree.stdout.strip(),
            "-p",base],env=fixture_env,input="R33 invalid UTF-8 fixture\n",
            text=True,capture_output=True,check=False)
        if (read_tree.returncode or blob.returncode or update.returncode
                or tree.returncode or commit.returncode
                or re.fullmatch(r"[0-9a-f]{40}",commit.stdout.strip()) is None):
            raise Rig("R33 invalid UTF-8 Git-plumbing fixture")
        invalid=commit.stdout.strip()
        invalid_bare=r33_fresh_remote("invalid-utf8",repo,base,0)
        invalid_request=transition_request(repo,base,"r29-owner",
            tmp/"r33-invalid-utf8-state",tmp/"r33-invalid-utf8-workspace",invalid_bare,
            candidate_sha=invalid)
        invalid_request.update({"actor":"owner_authority","reported_changed_files":[]})
        before=(filesystem_snapshot(Path(str(invalid_request["state_dir"]))),
                filesystem_snapshot(Path(str(invalid_request["workspace_root"]))),
                remote_refs(invalid_bare))
        rc2,out2,why2=authority_call(tmp,"check-candidate",invalid_request)
        after=(filesystem_snapshot(Path(str(invalid_request["state_dir"]))),
               filesystem_snapshot(Path(str(invalid_request["workspace_root"]))),
               remote_refs(invalid_bare))
        invalid_ok=(rc2==1 and out2.get("accepted") is False and before==after
                    and "UTF-8" in str(out2.get("reason")))
        alias_paths=["controller/h034-native/r33-alias.txt",
                     "controller\\h034-native\\r33-alias.txt"]
        alias_candidate=candidate_paths(repo,base,alias_paths,3031)
        alias_bare=r33_fresh_remote("canonical-alias-duplicate",repo,base,1)
        alias_request=transition_request(repo,base,"r29-owner",
            tmp/"r33-alias-state",tmp/"r33-alias-workspace",alias_bare,
            candidate_sha=alias_candidate)
        alias_request.update({"actor":"owner_authority","reported_changed_files":[]})
        alias_before=(filesystem_snapshot(Path(str(alias_request["state_dir"]))),
                      filesystem_snapshot(Path(str(alias_request["workspace_root"]))),
                      remote_refs(alias_bare))
        rc3,out3,why3=authority_call(tmp,"check-candidate",alias_request)
        alias_after=(filesystem_snapshot(Path(str(alias_request["state_dir"]))),
                     filesystem_snapshot(Path(str(alias_request["workspace_root"]))),
                     remote_refs(alias_bare))
        alias_ok=(rc3==1 and out3=={"accepted":False,
                    "reason":"duplicate changed path"} and alias_before==alias_after)
        fault_cases=[
            {"label":"EMPTY","raw":"","ok":True,"value":[]},
            {"label":"SPECIAL","raw":base64.b64encode(
                (path+"\0").encode("utf-8")).decode("ascii"),"ok":True,
             "value":[path.replace("\\","/")]},
            {"label":"UNTERMINATED","raw":base64.b64encode(
                b"controller/h034-native/r33-unterminated").decode("ascii"),
             "ok":False,"reason":"malformed NUL-delimited Git changed files"},
            {"label":"EMPTY_RECORD","raw":base64.b64encode(
                b"controller/h034-native/r33-empty\0\0").decode("ascii"),
             "ok":False,"reason":"malformed NUL-delimited Git changed files"},
            {"label":"INVALID_UTF8","raw":base64.b64encode(
                b"controller/h034-native/r33-invalid-\xff\0").decode("ascii"),
             "ok":False,"reason":"Git changed path is not UTF-8"},
            {"label":"CANONICAL_DUPLICATE","raw":base64.b64encode(
                b"controller/h034-native/r33-dupe\0controller\\h034-native\\r33-dupe\0").decode("ascii"),
             "ok":False,"reason":"duplicate changed path"},
        ]
        cases_path=tmp/"r33-path-fault-cases.json";write_json(cases_path,fault_cases)
        harness=tmp/"r33-path-fault-harness.py"
        harness.write_text(
            "import base64,importlib.machinery,importlib.util,json,sys,types\n"
            "loader=importlib.machinery.SourceFileLoader('r33_core_fault',sys.argv[1])\n"
            "spec=importlib.util.spec_from_loader(loader.name,loader)\n"
            "module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)\n"
            "module.exact_commit=lambda repo,value:value\n"
            "cases=json.load(open(sys.argv[2],encoding='utf-8'));rows=[]\n"
            "for case in cases:\n"
            " raw=base64.b64decode(case['raw'])\n"
            " module.subprocess.run=lambda *a,**k:types.SimpleNamespace(returncode=0,stdout=raw,stderr=b'')\n"
            " try:rows.append({'label':case['label'],'ok':True,'value':module.changed_files(module.Path('.'),'0'*40,'1'*40)})\n"
            " except Exception as exc:rows.append({'label':case['label'],'ok':False,'reason':str(exc)})\n"
            "print(json.dumps(rows,sort_keys=True))\n",encoding="utf-8")
        p=run([str(H035_R15_AST_PYTHON),"-I","-S","-B",str(harness),
               str(ROOT/"controller/authority/core.py"),str(cases_path)],cwd=tmp,
              env=ordinary_python_env())
        try:fault_rows=json.loads(p.stdout)
        except ValueError:fault_rows=[]
        faults_ok=(p.returncode==0 and len(fault_rows)==len(fault_cases)
                   and all(row=={key:value for key,value in case.items()
                                 if key not in {"raw"}}
                           for row,case in zip(fault_rows,fault_cases)))
        return positive and invalid_ok and alias_ok and faults_ok,{
            "positive":repr((rc,out,why)),
            "invalid":repr((rc2,out2,why2,before==after)),
            "actual_alias_duplicate":repr((rc3,out3,why3,alias_before==alias_after)),
            "causal_fault_rows":repr({"rc":p.returncode,"rows":fault_rows,
                                       "stderr":p.stderr[-500:]})}

    def r33_candidate_object_decoys() -> tuple[bool,dict[str,str]]:
        def registry(version: int) -> dict[str,object]:
            value=json.loads(json.dumps(canonical));value["schema_version"]=version
            value["owner_production_paths"]=(list(H034_OWNER_PATHS) if version==1
                else [*H034_OWNER_PATHS,*H036_OWNER_PATHS] if version==2
                else [*H034_OWNER_PATHS,*H036_OWNER_PATHS,*H039_OWNER_PATHS])
            return value
        commands=("validate-task","check-candidate","owner-author",
                  "record-review","owner-freeze")
        results=[];details={};component_ok={}
        for serial,command in enumerate(commands):
            initial_version=3 if command in {"owner-author","check-candidate"} else 1
            repo,base,_safe,bare=clone_case(
                "R33_DECOY_POSITIVE_"+command,registry(initial_version),
                list(H039_OWNER_PATHS),protected_paths=[])
            if command in {"owner-author","check-candidate"}:
                candidate_sha=base
            else:
                checkout=git(repo,"checkout","-q",base)
                if checkout.returncode:raise Rig(checkout.stderr)
                write_json(repo/"specs/owner-production-paths.v1.json",registry(3))
                changed=["specs/owner-production-paths.v1.json"]
                if command in {"check-candidate","record-review","owner-freeze"}:
                    for path in H039_OWNER_PATHS:
                        target=repo/path;target.parent.mkdir(parents=True,exist_ok=True)
                        target.write_text(f"r33 positive decoy {command}\n")
                    changed.extend(H039_OWNER_PATHS)
                candidate_sha=commit_paths(repo,"R33 positive v3 candidate",*changed)
                checkout=git(repo,"checkout","-q",base)
                if checkout.returncode:raise Rig(checkout.stderr)
            write_json(repo/"specs/owner-production-paths.v1.json",registry(1))
            state=tmp/f"r33-decoy-positive-{command}-state"
            workspace=tmp/f"r33-decoy-positive-{command}-workspace"
            request=transition_request(repo,base,"r29-owner",state,workspace,bare,
                                       candidate_sha=candidate_sha)
            request.update({"registry_schema_version":1,
                "registry_owner_production_paths":list(H034_OWNER_PATHS),
                "reported_changed_files":[]})
            if command=="check-candidate":request["actor"]="owner_authority"
            elif command=="record-review":request.update(
                {"review_result":"PASS","review_identity":"r33-review"})
            elif command=="owner-freeze":request.update(
                {"review_result":"PASS","review_identity":"r9-review"})
            if command in {"owner-author","record-review","owner-freeze"}:
                seed_owner_command_state(state,command,request)
            before=(filesystem_snapshot(state),filesystem_snapshot(workspace),remote_refs(bare))
            rc,out,why=authority_call(tmp,command,request)
            after=(filesystem_snapshot(state),filesystem_snapshot(workspace),remote_refs(bare))
            ok=(rc==0 and out.get("accepted") is True
                and r33_positive_effects(command,request,state,workspace,before,after))
            key=f"POSITIVE_V3_OVER_V1_{command}"
            results.append(ok);component_ok[key]=ok;details[key]=repr(
                {"rc":rc,"out":out,"effects_exact":ok,
                 "base_decoy":command!="owner-author","detail":why})
        for version in (1,2):
            for serial,command in enumerate(commands):
                repo,base,_safe,bare=clone_case(
                    f"R33_DECOY_INVERSE_V{version}_"+command,registry(3),
                    list(H039_OWNER_PATHS),protected_paths=[])
                checkout=git(repo,"checkout","-q",base)
                if checkout.returncode:raise Rig(checkout.stderr)
                write_json(repo/"specs/owner-production-paths.v1.json",registry(version))
                changed=["specs/owner-production-paths.v1.json"]
                if command in {"check-candidate","record-review","owner-freeze"}:
                    for path in H039_OWNER_PATHS:
                        target=repo/path;target.parent.mkdir(parents=True,exist_ok=True)
                        target.write_text(f"r33 inverse v{version} {command}\n")
                    changed.extend(H039_OWNER_PATHS)
                candidate_sha=commit_paths(repo,f"R33 inverse v{version} candidate",*changed)
                write_json(repo/"specs/owner-production-paths.v1.json",registry(3))
                state=tmp/f"r33-decoy-inverse-v{version}-{command}-state"
                workspace=tmp/f"r33-decoy-inverse-v{version}-{command}-workspace"
                request=transition_request(repo,base,"r29-owner",state,workspace,bare,
                                           candidate_sha=candidate_sha)
                request.update({"registry_schema_version":3,
                    "registry_owner_production_paths":[*H034_OWNER_PATHS,
                        *H036_OWNER_PATHS,*H039_OWNER_PATHS],
                    "reported_changed_files":[]})
                if command=="check-candidate":request["actor"]="owner_authority"
                elif command=="record-review":request.update(
                    {"review_result":"PASS","review_identity":"r33-review"})
                elif command=="owner-freeze":request.update(
                    {"review_result":"PASS","review_identity":"r9-review"})
                if command in {"owner-author","record-review","owner-freeze"}:
                    seed_owner_command_state(state,command,request)
                before=(filesystem_snapshot(state),filesystem_snapshot(workspace),remote_refs(bare))
                rc,out,why=authority_call(tmp,command,request)
                after=(filesystem_snapshot(state),filesystem_snapshot(workspace),remote_refs(bare))
                expected_reason=("owner candidate changed global deny"
                                 if command=="check-candidate"
                                 else "owner surface outside owner production")
                ok=(rc==1 and out=={"accepted":False,
                        "reason":expected_reason}
                    and before==after)
                key=f"INVERSE_V{version}_OVER_V3_{command}"
                results.append(ok);component_ok[key]=ok;details[key]=repr(
                    {"rc":rc,"out":out,"unchanged":before==after,"detail":why})
        details["_component_ok"]=component_ok
        return all(results),details

    def r33_closed_candidate_base_decoys() -> tuple[bool,dict[str,str]]:
        def registry(version: int) -> dict[str,object]:
            value=json.loads(json.dumps(canonical));value["schema_version"]=version
            value["owner_production_paths"]=(list(H034_OWNER_PATHS) if version==1
                else [*H034_OWNER_PATHS,*H036_OWNER_PATHS])
            return value
        caller_v3=[*H034_OWNER_PATHS,*H036_OWNER_PATHS,*H039_OWNER_PATHS]
        commands=("validate-task","check-candidate","owner-author",
                  "record-review","owner-freeze")
        results=[];details={};component_ok={}
        for version in (1,2):
            for surface_label,surface,accept in (
                    ("H039",list(H039_OWNER_PATHS),False),
                    ("H034",list(H034_OWNER_PATHS),True)):
                for serial,command in enumerate(commands):
                    label=f"V{version}_{surface_label}_{command}"
                    repo,base,_safe,bare=clone_case(
                        "R33_CLOSED_BASE_"+label,registry(version),surface,
                        protected_paths=[])
                    # The exact Git candidate object and configured remote both
                    # remain B.  Only ambient checkout and caller claims widen.
                    write_json(repo/"specs/owner-production-paths.v1.json",v3)
                    state=tmp/f"r33-closed-base-{label.lower()}-{serial}-state"
                    workspace=tmp/f"r33-closed-base-{label.lower()}-{serial}-workspace"
                    request=transition_request(repo,base,"r29-owner",state,workspace,
                                               bare,candidate_sha=base)
                    request.update({"registry_schema_version":3,
                        "registry_owner_production_paths":caller_v3,
                        "reported_changed_files":[]})
                    if command=="check-candidate":
                        request["actor"]="owner_authority"
                    elif command=="record-review":
                        request.update({"review_result":"PASS",
                                        "review_identity":"r33-closed-review"})
                    elif command=="owner-freeze":
                        request.update({"review_result":"PASS",
                                        "review_identity":"r9-review"})
                    if command in {"owner-author","record-review","owner-freeze"}:
                        seed_owner_command_state(state,command,request)
                    before=(filesystem_snapshot(state),
                            filesystem_snapshot(workspace),remote_refs(bare))
                    rc,out,why=authority_call(tmp,command,request)
                    after=(filesystem_snapshot(state),
                           filesystem_snapshot(workspace),remote_refs(bare))
                    if accept:
                        ok=(rc==0 and out.get("accepted") is True
                            and r33_positive_effects(
                                command,request,state,workspace,before,after))
                    else:
                        ok=(rc==1 and out=={"accepted":False,
                                "reason":"owner surface outside owner production"}
                            and before==after)
                    results.append(ok);component_ok[label]=ok;details[label]=repr({
                        "candidate_equals_base":request["candidate_sha"]==base,
                        "candidate_registry_version":version,
                        "checkout_registry_version":3,
                        "caller_registry_version":request["registry_schema_version"],
                        "configured_remote_main":remote_refs(bare),
                        "rc":rc,"out":out,
                        "effects_exact":ok if accept else before==after,
                        "detail":why})
        details["_component_ok"]=component_ok
        return len(results)==20 and all(results),details

    def r33_same_process_sequence() -> tuple[bool,object]:
        def registry(version: int) -> dict[str,object]:
            value=json.loads(json.dumps(canonical));value["schema_version"]=version
            value["owner_production_paths"]=(list(H034_OWNER_PATHS) if version==1
                else [*H034_OWNER_PATHS,*H036_OWNER_PATHS] if version==2
                else [*H034_OWNER_PATHS,*H036_OWNER_PATHS,*H039_OWNER_PATHS])
            return value
        cases=[]
        for serial,(label,version,surface,command,accept) in enumerate((
            ("V3_H039",3,list(H039_OWNER_PATHS),"check-candidate",True),
            ("V1_H039",1,list(H039_OWNER_PATHS),"check-candidate",False),
            ("V2_H036",2,list(H036_OWNER_PATHS),"validate-task",True),
            ("V2_H039",2,list(H039_OWNER_PATHS),"owner-author",False),
            ("V3_H039_FINAL",3,list(H039_OWNER_PATHS),"owner-author",True),
        )):
            repo,base,_safe,bare=clone_case("R33_SEQUENCE_"+label,registry(version),
                                            surface,protected_paths=[])
            candidate_sha=(candidate_paths(repo,base,[concrete_path(path,3100+index)
                           for index,path in enumerate(surface)],3100+serial)
                           if command=="check-candidate" else base)
            state=tmp/f"r33-sequence-{serial}-state"
            workspace=tmp/f"r33-sequence-{serial}-workspace"
            request=transition_request(repo,base,"r29-owner",state,workspace,bare,
                                       candidate_sha=candidate_sha)
            if command=="check-candidate":request["actor"]="owner_authority"
            if command=="owner-author":seed_owner_command_state(state,command,request)
            request.update({"registry_schema_version":99,
                            "registry_owner_production_paths":["controller/**"]})
            cases.append({"label":label,"command":command,"request":request,
                          "accept":accept,
                          "reason":None if accept else
                                   "owner surface outside owner production"})
        malformed=json.loads(json.dumps(canonical));malformed["schema_version"]=False
        repo,base,_safe,bare=clone_case("R33_SEQUENCE_MALFORMED",malformed,
                                        list(H034_OWNER_PATHS),protected_paths=[])
        malformed_request=transition_request(repo,base,"r29-owner",
            tmp/"r33-sequence-malformed-state",tmp/"r33-sequence-malformed-workspace",bare)
        cases.insert(3,{"label":"MALFORMED","command":"validate-task",
                        "request":malformed_request,"accept":False,"reason":None})
        cases_path=tmp/"r33-same-process-cases.json";write_json(cases_path,cases)
        harness=tmp/"r33-same-process.py"
        harness.write_text(
            "import contextlib,importlib.machinery,importlib.util,io,json,sys\n"
            "loader=importlib.machinery.SourceFileLoader('r33_authority_cli',sys.argv[1])\n"
            "spec=importlib.util.spec_from_loader(loader.name,loader)\n"
            "module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)\n"
            "cases=json.load(open(sys.argv[2],encoding='utf-8'));rows=[]\n"
            "for case in cases:\n"
            " stream=io.StringIO()\n"
            " try:\n"
            "  with contextlib.redirect_stdout(stream):rc=module.COMMANDS[case['command']](case['request'])\n"
            "  out=json.loads(stream.getvalue().splitlines()[-1])\n"
            " except Exception as exc:rc=1;out={'accepted':False,'reason':str(exc)}\n"
            " rows.append({'label':case['label'],'rc':rc,'out':out})\n"
            "print(json.dumps(rows,sort_keys=True))\n",encoding="utf-8")
        env=ordinary_python_env();env["PYTHONDONTWRITEBYTECODE"]="1"
        p=run([str(H035_R15_AST_PYTHON),"-I","-S","-B",str(harness),str(AUTH),
               str(cases_path)],cwd=tmp,env=env)
        try:rows=json.loads(p.stdout)
        except ValueError:rows=[]
        ok=p.returncode==0 and isinstance(rows,list) and len(rows)==len(cases)
        if ok:
            for case,row in zip(cases,rows):
                expected=case["accept"]
                ok=ok and (row.get("rc")==0)==expected \
                    and row.get("out",{}).get("accepted") is expected
                if case["reason"] is not None:
                    ok=ok and row.get("out",{}).get("reason")==case["reason"]
        return ok,{"rc":p.returncode,"rows":rows,"stderr":p.stderr[-500:]}

    def r33_nested_concurrent_interleave() -> tuple[bool,object]:
        def registry(version: int) -> dict[str,object]:
            value=json.loads(json.dumps(canonical));value["schema_version"]=version
            value["owner_production_paths"]=(list(H034_OWNER_PATHS) if version==1
                else [*H034_OWNER_PATHS,*H036_OWNER_PATHS,*H039_OWNER_PATHS])
            return value
        requests={};roots=[];refs=[]
        for label,version in (("nested_outer_v1",1),("nested_inner_v3",3),
                              ("concurrent_v1",1),("concurrent_v3",3)):
            repo,base,_safe,bare=clone_case("R33_INTERLEAVE_"+label,
                registry(version),list(H039_OWNER_PATHS),protected_paths=[])
            material=candidate_paths(repo,base,list(H039_OWNER_PATHS),3200+version)
            state=tmp/f"r33-interleave-{label}-state"
            workspace=tmp/f"r33-interleave-{label}-workspace"
            request=transition_request(repo,base,"r29-owner",state,workspace,bare,
                                       candidate_sha=material)
            request.update({"actor":"owner_authority","registry_schema_version":99,
                            "registry_owner_production_paths":["controller/**"]})
            requests[label]=request;roots.extend((state,workspace));refs.append(bare)
        before=([filesystem_snapshot(path) for path in roots],
                [remote_refs(path) for path in refs])
        requests_path=tmp/"r33-interleave-requests.json";write_json(requests_path,requests)
        harness=tmp/"r33-interleave-harness.py"
        harness.write_text(
            "import contextlib,importlib.machinery,importlib.util,io,json,sys,threading\n"
            "loader=importlib.machinery.SourceFileLoader('r33_interleave_cli',sys.argv[1])\n"
            "spec=importlib.util.spec_from_loader(loader.name,loader)\n"
            "module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)\n"
            "requests=json.load(open(sys.argv[2],encoding='utf-8'))\n"
            "def invoke(request):\n"
            " try:return {'rc':module.check_candidate(request),'accepted':True}\n"
            " except Exception as exc:return {'rc':1,'accepted':False,'reason':str(exc)}\n"
            "original=module.task_authority;inside=False;nested={}\n"
            "def reentrant(*args,**kwargs):\n"
            " global inside\n"
            " if not inside:\n"
            "  inside=True\n"
            "  try:nested['inner']=invoke(requests['nested_inner_v3'])\n"
            "  finally:inside=False\n"
            " return original(*args,**kwargs)\n"
            "module.task_authority=reentrant\n"
            "with contextlib.redirect_stdout(io.StringIO()):nested['outer']=invoke(requests['nested_outer_v1'])\n"
            "module.task_authority=original\n"
            "local=threading.local();v1_at=threading.Event();v3_at=threading.Event();v1_done=threading.Event();concurrent={}\n"
            "def interleaved(*args,**kwargs):\n"
            " label=local.label\n"
            " if label=='v1':\n"
            "  v1_at.set()\n"
            "  if not v3_at.wait(10):raise RuntimeError('concurrent v3 did not reach task authority')\n"
            " else:\n"
            "  if not v1_at.wait(10):raise RuntimeError('concurrent v1 did not reach task authority')\n"
            "  v3_at.set()\n"
            "  if not v1_done.wait(10):raise RuntimeError('concurrent v1 did not complete')\n"
            " return original(*args,**kwargs)\n"
            "module.task_authority=interleaved\n"
            "def worker(label):\n"
            " local.label=label\n"
            " try:concurrent[label]=invoke(requests['concurrent_'+label])\n"
            " finally:\n"
            "  if label=='v1':v1_done.set()\n"
            "threads=[threading.Thread(target=worker,args=(label,)) for label in ('v1','v3')]\n"
            "with contextlib.redirect_stdout(io.StringIO()):\n"
            " [value.start() for value in threads];[value.join(12) for value in threads]\n"
            "print(json.dumps({'nested':nested,'concurrent':concurrent,\n"
            " 'alive':[value.is_alive() for value in threads]},sort_keys=True))\n",
            encoding="utf-8")
        env=ordinary_python_env();env["PYTHONDONTWRITEBYTECODE"]="1"
        p=run([str(H035_R15_AST_PYTHON),"-I","-S","-B",str(harness),str(AUTH),
               str(requests_path)],cwd=tmp,env=env)
        try:result=json.loads(p.stdout)
        except ValueError:result={}
        reject={"rc":1,"accepted":False,
                "reason":"owner surface outside owner production"}
        accept={"rc":0,"accepted":True}
        ok=(p.returncode==0 and result.get("alive")==[False,False]
            and result.get("nested")=={"inner":accept,"outer":reject}
            and result.get("concurrent")=={"v1":reject,"v3":accept})
        after=([filesystem_snapshot(path) for path in roots],
               [remote_refs(path) for path in refs])
        return ok and before==after,{"rc":p.returncode,"result":result,
                                    "unchanged":before==after,"stderr":p.stderr[-500:]}

    causal_repo,causal_base,causal_safe,causal_bare=clone_case(
        "ACCEPT_EFFECT_CAUSAL",canonical,list(H036_OWNER_PATHS),
        protected_paths=[])
    causal_results=[];causal_details={}
    for effect in ("STATE","WORKSPACE","REMOTE_REFS"):
        ok,why=unchanged_call("ACCEPT-EFFECT-"+effect,causal_repo,
            causal_base,causal_safe,causal_bare,"validate-registry",{},
            accept=True,accept_effect_mutant=effect)
        causal_results.append(not ok and "'unchanged': False" in why)
        causal_details[effect]=why
    record("ACCEPT_SIDE_UNCHANGED_STATE_WORKSPACE_REFS_CAUSAL",
           all(causal_results),"ACCEPT_SIDE_MUTATION_ORACLE_NOT_CAUSAL",
           causal_details)

    v3_reordered=json.loads(json.dumps(v3))
    v3_reordered["owner_production_paths"]=list(reversed(
        v3_reordered["owner_production_paths"]))
    positives=[];positive_details={};positive_component_ok={}
    for label,registry,surface in (
        ("H034",v3,list(H034_OWNER_PATHS)),
        ("H036",v3,list(H036_OWNER_PATHS)),
        ("H039",v3,list(H039_OWNER_PATHS)),
        ("H039_REORDERED",v3_reordered,list(H039_OWNER_PATHS))):
        ok,detail=positive_material("V3_"+label,registry,surface)
        positives.append(ok);positive_details[label]=detail
        positive_component_ok[label]=ok
    neighbor_ok,neighbor_detail=h039_exact_neighbor_disjointness_positive(v3)
    non_owner_ok,non_owner_detail=v3_non_owner_list_positives(v3)
    positives.extend((neighbor_ok,non_owner_ok))
    positive_component_ok["H039_EXACT_NEIGHBOR_DISJOINTNESS"]=neighbor_ok
    positive_component_ok["V3_NON_OWNER_LIST_ALTERNATIVES"]=non_owner_ok
    positive_details["_component_ok"]=positive_component_ok
    positive_details["H039_EXACT_NEIGHBOR_DISJOINTNESS"]=neighbor_detail
    positive_details["V3_NON_OWNER_LIST_ALTERNATIVES"]=non_owner_detail
    record("V3_EXACT_POSITIVE_MATERIAL_CONSUMERS",all(positives),
           "V2_ONLY_CORE_REJECTS_EXACT_SCHEMA_V3",positive_details)

    def duplicate_key(document: dict[str,object],key: str) -> str:
        raw=json.dumps(document,indent=2)
        marker=f'  "{key}": '
        replacement=marker+json.dumps(document[key],ensure_ascii=False)+",\n"+marker
        if raw.count(marker)!=1:raise Rig("R29 duplicate-key anchor")
        return raw.replace(marker,replacement,1)

    descriptors=(
        (H034_OWNER_PATHS[0],"controller/h034-other/**","controller/**"),
        (H034_OWNER_PATHS[1],"verify/h034/other-kernel","verify/h034/**"),
        (H034_OWNER_PATHS[2],"verify/h034/other-recipe.json","verify/h034/**"),
        (H034_OWNER_PATHS[3],"verify/h034/other-manifest.json","verify/h034/**"),
        (H036_OWNER_PATHS[0],"controller/launch/other","controller/launch/**"),
        (H036_OWNER_PATHS[1],"controller/launch/other.py","controller/launch/**"),
        (H036_OWNER_PATHS[2],"config/python-runtime-authority-v3.json","config/**"),
        (H039_OWNER_PATHS[0],"controller/runtime-cleanup/other","controller/runtime-cleanup/**"),
        (H039_OWNER_PATHS[1],"controller/runtime-cleanup/native/other.c","controller/runtime-cleanup/**"),
        (H039_OWNER_PATHS[2],"verify/h039/other-mediator","verify/h039/**"),
        (H039_OWNER_PATHS[3],"verify/h039/other-recipe.json","verify/h039/**"),
        (H039_OWNER_PATHS[4],"verify/h039/other-manifest.json","verify/h039/**"),
    )
    hostile: list[tuple[str,object]]=[]
    for index,(path,substitute,broader) in enumerate(descriptors):
        member_index=v3["owner_production_paths"].index(path)
        for defect,replacement in (
            ("OMISSION",None),("SUBSTITUTION",substitute),
            ("BACKSLASH_ALIAS",path.replace("/","\\")),
            ("LEADING_DOT_ALIAS","./"+path),("BROADER_PREFIX",broader)):
            mutant=json.loads(json.dumps(v3))
            if replacement is None:del mutant["owner_production_paths"][member_index]
            else:mutant["owner_production_paths"][member_index]=replacement
            hostile.append((f"MEMBER_{index}_{defect}",mutant))
        mutant=json.loads(json.dumps(v3));mutant["owner_production_paths"].append(path)
        hostile.append((f"MEMBER_{index}_DUPLICATE",mutant))
    for name,members in (
        ("ARBITRARY_ADDITION",[*v3["owner_production_paths"],"safe/arbitrary"]),
        ("H039_NEW_ONLY",list(H039_OWNER_PATHS)),
        ("H039_PARTIAL_PREFIX",[*H034_OWNER_PATHS,*H036_OWNER_PATHS,H039_OWNER_PATHS[0]]),
        ("H039_PARTIAL_NONPREFIX",[*H034_OWNER_PATHS,*H036_OWNER_PATHS,
                                    H039_OWNER_PATHS[1],H039_OWNER_PATHS[4]]),
        ("V3_WITH_V1_OLD4",list(H034_OWNER_PATHS)),
        ("V3_WITH_V2_UNION7",[*H034_OWNER_PATHS,*H036_OWNER_PATHS])):
        mutant=json.loads(json.dumps(v3));mutant["owner_production_paths"]=members
        hostile.append((name,mutant))
    for key in tuple(v3):
        mutant=json.loads(json.dumps(v3));mutant.pop(key)
        hostile.append(("TOP_LEVEL_MISSING_"+key,mutant))
    mutant=json.loads(json.dumps(v3));mutant["extra_authority"]=True
    hostile.append(("TOP_LEVEL_EXTRA",mutant))
    mutant=json.loads(json.dumps(v3));mutant["owner_production_paths"]={}
    hostile.append(("OWNER_MEMBERSHIP_TYPE",mutant))
    hostile.append(("OWNER_MEMBERSHIP_DUPLICATE_KEY",
                    duplicate_key(v3,"owner_production_paths")))
    hostile.append(("SCHEMA_VERSION_DUPLICATE_KEY",
                    duplicate_key(v3,"schema_version")))
    invalid_versions=(0,4,"1","2","3",False,True,1.0,2.0,3.0,None,[3],{"v":3})
    for index,value in enumerate(invalid_versions):
        mutant=json.loads(json.dumps(v3));mutant["schema_version"]=value
        hostile.append((f"VERSION_TYPE_{index}",mutant))
    for version in (1,2):
        mutant=json.loads(json.dumps(v3));mutant["schema_version"]=version
        hostile.append((f"VERSION_{version}_WITH_UNION12",mutant))
    for field,wrong in (("path_grammar","grammar-v2"),
                        ("authority_source","caller-selected")):
        for defect,value in (("TYPE",[]),("EMPTY",""),("VALUE",wrong)):
            mutant=json.loads(json.dumps(v3));mutant[field]=value
            hostile.append((f"NON_OWNER_{field}_{defect}",mutant))
        hostile.append((f"NON_OWNER_{field}_DUPLICATE_KEY",duplicate_key(v3,field)))
    for defect,value in (("TYPE_INT",0),("TYPE_STRING","false"),("VALUE_TRUE",True)):
        mutant=json.loads(json.dumps(v3));mutant["self_digest_is_authority"]=value
        hostile.append((f"NON_OWNER_SELF_DIGEST_{defect}",mutant))
    hostile.append(("NON_OWNER_SELF_DIGEST_DUPLICATE_KEY",
                    duplicate_key(v3,"self_digest_is_authority")))
    for field in ("prospective_ordinary_protected_paths",
                  "owner_author_global_denied_paths"):
        original=v3[field]
        for defect,value in (
            ("TYPE",{}),("EMPTY",[]),("MALFORMED",["../escape",*original[1:]]),
            ("VALUE_TYPE",[7,*original[1:]]),("DUPLICATE",[*original,original[0]]),
            ("ALIAS_DUPLICATE",[*original,str(original[0]).replace("/","\\")])):
            mutant=json.loads(json.dumps(v3));mutant[field]=value
            hostile.append((f"NON_OWNER_{field}_{defect}",mutant))
        hostile.append((f"NON_OWNER_{field}_DUPLICATE_KEY",duplicate_key(v3,field)))
    check(len(descriptors)*6==72,"J_R29_EXACT_MEMBER_DEFECT_CARDINALITY")

    def hostile_material(name: str,registry: object) -> tuple[bool,dict[str,str]]:
        repo,base,safe,bare=clone_case("HOSTILE_"+name,registry,
                                      list(H039_OWNER_PATHS))
        details={};checks=[]
        for label,command,candidate_sha,fields,seed in (
            ("validate_registry","validate-registry",safe,{},False),
            ("validate_task","validate-task",base,{"task_id":"r29-safe"},False),
            ("check_candidate","check-candidate",safe,
             {"task_id":"r29-safe","actor":"ordinary"},False),
            ("owner_author","owner-author",base,{"task_id":"r29-owner"},True),
            ("record_review","record-review",base,{"task_id":"r29-owner",
             "review_result":"PASS","review_identity":"r29-hostile-review"},True),
            ("owner_freeze","owner-freeze",base,{"task_id":"r29-owner",
             "review_result":"PASS","review_identity":"r9-review"},True)):
            ok,why=unchanged_call("HOSTILE-"+name+"-"+label,repo,base,
                candidate_sha,bare,command,fields,accept=False,seed=seed)
            checks.append(ok);details[label]=why
        ok,why=policy_probe(repo,base,safe,"r29-safe",bare,accept=False,
                            reason="ogiltig authority contract")
        checks.append(ok);details["ordinary_policy"]=why
        return all(checks),details

    hostile_results={}
    for name,registry in hostile:
        if name in hostile_results:raise Rig("duplicate R29 hostile case "+name)
        hostile_results[name]=hostile_material(name,registry)
    record("V3_ALL_MEMBERS_VERSION_MEMBERSHIP_AND_NON_OWNER_HOSTILES_REJECT",
           all(ok for ok,_detail in hostile_results.values()),
           "V3_HOSTILE_REACHED_INCONSISTENT_CONSUMER",
           {name:detail for name,(ok,detail) in hostile_results.items() if not ok})

    failures=[{"observation":name,"reason":reason}
              for name,ok,reason,_detail in observations if not ok]
    if r33:
        r33_product_scope_selftests(tmp)
        cross_ok,cross_detail=r33_cross_product()
        path_ok,path_detail=r33_path_transport()
        decoy_ok,decoy_detail=r33_candidate_object_decoys()
        closed_decoy_ok,closed_decoy_detail=r33_closed_candidate_base_decoys()
        sequence_ok,sequence_detail=r33_same_process_sequence()
        interleave_ok,interleave_detail=r33_nested_concurrent_interleave()
        complete=(not failures and cross_ok and path_ok and decoy_ok and closed_decoy_ok
                  and sequence_ok and interleave_ok)
        expected=H035_R33_REQUEST_BOUND_REGISTRY["preproduct_evidence"]
        core_raw=(ROOT/"controller/authority/core.py").read_bytes()
        cli_raw=(ROOT/"controller/authority/cli").read_bytes()
        exact_legacy=(hashlib.sha256(core_raw).hexdigest()==expected["core_sha256"]
            and hashlib.sha256(cli_raw).hexdigest()==expected["cli_sha256"]
            and exact_value(failures,H035_R29_THREE_STATE_REGISTRY[
                "preproduct_evidence"]["expected_failure_signature"])
            and not cross_ok and not path_ok and not decoy_ok and not closed_decoy_ok
            and not sequence_ok and not interleave_ok)
        signature=[] if complete else [{
            "observation":"R33_COMPLETE_R29_PLUS_REQUEST_BOUND_AND_NUL_MATRIX",
            "reason":expected["expected_reason"] if exact_legacy
                     else "UNEXPECTED_R33_FAILURE_SIGNATURE"}]
        detail=json.dumps({
            "reason":expected["expected_reason"] if exact_legacy
                     else "UNEXPECTED_R33_FAILURE_SIGNATURE",
            "failure_signature":signature,
            "diagnostics":{"r29_failures":failures,
                "r29_failure_diagnostics":{name:value for name,ok,_reason,value
                    in observations if not ok},"cross_product":cross_detail,
                "path_transport":path_detail,"candidate_object_decoys":decoy_detail,
                "closed_candidate_base_decoys":closed_decoy_detail,
                "same_process_sequence":sequence_detail,
                "nested_concurrent_interleave":interleave_detail}},sort_keys=True)
        check(complete,"A_R33_REQUEST_BOUND_REGISTRY_AND_NUL_PATH_OPERATIONAL",detail)
        return
    expected=H035_R29_THREE_STATE_REGISTRY["preproduct_evidence"]
    detail=json.dumps({
        "reason":expected["expected_reason"] if exact_value(
            failures,expected["expected_failure_signature"])
            else "UNEXPECTED_R29_FAILURE_SIGNATURE",
        "failure_signature":failures,
        "diagnostics":{name:value for name,ok,_reason,value in observations if not ok},
    },sort_keys=True)
    check(not failures,"A_R29_EXACT_THREE_STATE_REGISTRY_OPERATIONAL",detail)


def production_matrix(tmp: Path) -> None:
    """Future operational CLI contract; every case is black-box, never a named probe."""
    repo, base = authority_repo(tmp, "authority-repo", [
        ordinary_task("fixture-ordinary", ["safe/**"]),
        owner_task("fixture-owner", ["controller/h034-native/**"]),
    ])
    bare = tmp / "origin.git"; run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
    set_remote_main(bare, repo, base)
    spec_digest = hashlib.sha256((repo / "specs/tasks.spec.json").read_bytes()).hexdigest()
    reg_digest = hashlib.sha256((repo / "specs/owner-production-paths.v1.json").read_bytes()).hexdigest()
    gate_digest = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    common: dict[str, object] = {"repo":str(repo), "task_id":"fixture-owner", "base_sha":base,
        "main_sha":base, "spec_sha256":spec_digest, "registry_sha256":reg_digest,
        "gate_path":"verify/bin/h-035-exit", "gate_sha256":gate_digest,
        "state_dir":str(tmp/"authority-state"), "workspace_root":str(tmp/"authority-ws"),
        "remote":str(bare)}
    write_json(Path(str(common["state_dir"])) / "current.json",
               {"task":"fixture-owner", "state":"OWNER_ACTION_REQUIRED", "base_sha":base})
    def req(**kw: object) -> dict[str, object]: return {**common, **kw}
    # Actual task/schema/authority consumer matrix (N01-N18, N36-N41; P01-P05).
    invalid = [
      ("N01_EXACT_OWNER", "2.0.0", dict(authority_class="ordinary",allowed_write=["verify/h034/kernel"])),
      ("N02_PARENT_OWNER", "2.0.0", dict(authority_class="ordinary",allowed_write=["verify/**"])),
      ("N03_WILDCARD_OWNER", "2.0.0", dict(authority_class="ordinary",allowed_write=["controller/**"])),
      ("N09_ORDINARY_BOTH", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],owner_author_allowed_write=["controller/h034-native/**"])),
      ("N10_OWNER_NONEMPTY_ORDINARY", "2.0.0", dict(authority_class="owner_authority",allowed_write=["safe/**"],owner_author_allowed_write=["controller/h034-native/**"])),
      ("N10B_OWNER_EMPTY_OWNER", "2.0.0", dict(authority_class="owner_authority",allowed_write=["safe/**"],owner_author_allowed_write=[])),
      ("N11_EMPTY_CLASS", "2.0.0", dict(authority_class="",allowed_write=["safe/**"])),
      ("N12_UPPER_CLASS", "2.0.0", dict(authority_class="OWNER",allowed_write=["safe/**"])),
      ("N13_MIXED_CLASS", "2.0.0", dict(authority_class="OwNeR",allowed_write=["safe/**"])),
      ("N14_V1_OWNER_FIELD", "1.0.0", dict(allowed_write=["safe/**"],owner_author_allowed_write=["controller/h034-native/**"])),
      ("N15_DOCS_EXACT", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=["verify/h034/kernel"])),
      ("N16_DOCS_PARENT", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=["verify/**"])),
      ("N16B_OWNER_DOCS_GATE", "2.0.0", dict(authority_class="owner_authority",allowed_write=[],owner_author_allowed_write=["safe-owner/**"],docs_impact=["verify/bin/h-035-exit"])),
    ]
    for name, version, task in invalid:
        trepo, tbase, tsha = task_candidate(tmp, name, version, task)
        expect_auth(tmp, name, "validate-task", {**common,"repo":str(trepo),"base_sha":tbase,"candidate_sha":tsha,"task_id":"fixture-task"}, False)
    for name, version, task in (
      ("P01_V1_ORDINARY", "1.0.0", dict(allowed_write=["safe/**"],docs_impact=[])),
      ("P02_V2_ORDINARY", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=[])),
      ("P04_DOCS_LEGITIMATE", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=["safe/docs/**"])),
    ):
        trepo, tbase, tsha = task_candidate(tmp, name, version, task)
        expect_auth(tmp, name, "validate-task", {**common,"repo":str(trepo),"base_sha":tbase,"candidate_sha":tsha,"task_id":"fixture-task"}, True)
    trepo, tbase, tsha = task_candidate(tmp, "HOSTILE_AUTHORITY_INPUTS", "2.0.0", dict(authority_class="ordinary",allowed_write=["safe/**"],docs_impact=[]))
    canonical = {**common,"repo":str(trepo),"base_sha":tbase,"candidate_sha":tsha,"task_id":"fixture-task"}
    expect_auth(tmp, "N17_ROLE_SELF_CLAIM", "validate-task", {**canonical,"claimed_role":"OWNER_AUTHORITY_AUTHOR"}, True, authority_class="ordinary")
    alt = tmp / "alternate.json"; write_json(alt, {"tasks":[{"id":"fixture-task","authority_class":"owner_authority","owner_author_allowed_write":["controller/h034-native/**"]}]})
    expect_auth(tmp, "N18_ALTERNATE_SPEC", "validate-task", {**canonical,"alternate_spec":str(alt)}, True, authority_class="ordinary")
    freeze_common = req(review_result="PASS",candidate_sha=base,review_identity="review-1")
    rrepo, rbase, rsha = registry_candidate(tmp, "P05_REGISTRY_RUNTIME", REG.read_text())
    expect_auth(tmp, "P05_REGISTRY_RUNTIME", "validate-registry", {**common,"repo":str(rrepo),"base_sha":rbase,"candidate_sha":rsha}, True)
    good_reg = strict_load(REG)
    malformed: list[tuple[str, str]] = [
      ("N36_DUPLICATE_KEY", REG.read_text().replace('"schema_version":', '"schema_version": 1,\n  "schema_version":', 1)),
      ("N37_UNEXPECTED_KEY", json.dumps({**good_reg, "unexpected": []})),
      ("N38_MISSING_KEY", json.dumps({k:v for k,v in good_reg.items() if k != "path_grammar"})),
      ("N39_DUPLICATE_PATH", json.dumps({**good_reg, "owner_production_paths":[*good_reg["owner_production_paths"], good_reg["owner_production_paths"][0]]})),
      ("N40_REQUIRED_REMOVED", json.dumps({**good_reg, "owner_production_paths":good_reg["owner_production_paths"][1:]})),
      ("N_REG_WRONG_VERSION", json.dumps({**good_reg, "schema_version":3})),
      ("N_REG_WRONG_TOP_TYPE", "[]"),
      ("N_REG_MALFORMED_PATH", json.dumps({**good_reg, "owner_production_paths":["../escape"]})),
    ]
    for name, raw in malformed:
        rrepo, rbase, rsha = registry_candidate(tmp, name, raw)
        mutant_req = {**common,"repo":str(rrepo),"base_sha":rbase,"candidate_sha":rsha}
        expect_auth(tmp, f"{name}_VALIDATOR", "validate-registry", mutant_req, False)
        expect_auth(tmp, f"{name}_POLICY", "check-candidate", {**mutant_req,"actor":"ordinary"}, False)
        expect_auth(tmp, f"{name}_OWNER_TRANSITION", "owner-author", mutant_req, False,
                    state_changes=False, workspace_changes=False, refs_change=False)
    # Mechanical actor/candidate scope uses Git changed files, not reported lists.
    scope_neg = [
      ("N04_OWNER_ARTIFACT", "controller/h034-native/kernel.c", "ordinary"),
      ("N05_SCHEMA", "specs/tasks.spec.json", "ordinary"), ("N06_REGISTRY", "specs/owner-production-paths.v1.json", "ordinary"),
      ("N07_POLICY", "controller/policy/cli", "ordinary"), ("N08_AUTOPILOT", "scripts/nortropic-codex-autopilot.py", "ordinary"),
      ("N23_TEST_AUTHOR_OWNER", "controller/h034-native/kernel.c", "test_author"),
      ("N24_OWNER_SPEC", "specs/tasks.spec.json", "owner_authority"), ("N25_OWNER_REGISTRY", "specs/owner-production-paths.v1.json", "owner_authority"),
      ("N26_OWNER_GATE", "verify/bin/h-035-exit", "owner_authority"), ("N27_OWNER_OUTSIDE", "README.md", "owner_authority"),
    ]
    serial = 0
    for name, path, actor in scope_neg:
        serial += 1; sha = candidate(repo, base, path, serial)
        task_id = "fixture-ordinary" if actor == "ordinary" else "fixture-owner"
        expect_auth(tmp, name, "check-candidate", req(actor=actor,candidate_sha=sha,
                    task_id=task_id,reported_changed_files=[]), False)
    serial += 1; sha = candidate(repo, base, "controller/h034-native/kernel.c", serial)
    expect_auth(tmp, "P07_OWNER_EXACT_SURFACE", "check-candidate", req(actor="owner_authority",candidate_sha=sha), True)
    serial += 1; sha = candidate(repo, base, "controller/h034-native/alternative.c", serial)
    expect_auth(tmp, "P08_OWNER_ALT_BYTES", "check-candidate", req(actor="owner_authority",candidate_sha=sha), True)
    serial += 1; sha = candidate(repo, base, "controller/h034-native/kernel.c", serial)
    expect_auth(tmp, "N31_REPORTED_FILES_NOT_AUTHORITY", "check-candidate",
                req(actor="ordinary",task_id="fixture-ordinary",candidate_sha=sha,
                    reported_changed_files=["safe/x"]), False)
    # Explicit operational owner transitions and publication guard.
    expect_auth(tmp, "N_OWNER_AUTHOR_MISSING_BINDING", "owner-author", req(candidate_sha="0"*40), False,
                state_changes=False, workspace_changes=False, refs_change=False)
    expect_auth(tmp, "P06_OWNER_AUTHOR_EXPLICIT", "owner-author", req(candidate_sha=base), True,
                state_after="OWNER_CANDIDATE_REVIEW_REQUIRED", state_changes=True,
                workspace_changes=True, refs_change=False)
    # Recovery reads persisted state; a caller-supplied state is never authority.
    expect_auth(tmp, "N_NORMAL_ROUTE_OWNER_AUTHOR", "recover", req(state="OWNER_ACTION_REQUIRED"), True,
                state_after="OWNER_CANDIDATE_REVIEW_REQUIRED", workspace_changes=False,
                refs_change=False, owner_author_process_launched=False)
    state_file = Path(str(common["state_dir"])) / "current.json"
    write_json(state_file, {"task":"fixture-owner", "state":"UNKNOWN_FUTURE_STATE", "base_sha":base})
    expect_auth(tmp, "N_UNKNOWN_STATE", "recover", req(state="OWNER_ACTION_REQUIRED"), False,
                state_after="UNKNOWN_FUTURE_STATE", workspace_changes=False, refs_change=False,
                builder_launched=False)
    write_json(state_file, {"task":"fixture-owner", "state":"OWNER_CANDIDATE_REVIEW_REQUIRED", "base_sha":base,
                            "candidate_sha":base, "review_identity":"review-1"})
    expect_auth(tmp, "N32_REVIEW_PUBLICATION", "record-review", req(review_result="PASS",candidate_sha=base,review_identity="review-1"), True,
                state_after="OWNER_FINAL_FREEZE_REQUIRED", state_changes=True, refs_change=False,
                published=False, merged=False)
    for name, extra in (
      ("N33_WRONG_CANDIDATE", dict(candidate_sha="1"*40)), ("N34_WRONG_REVIEW", dict(review_identity="wrong")),
      ("N35_WRONG_BASE", dict(base_sha="2"*40)), ("N35B_WRONG_MAIN", dict(main_sha="3"*40)),
      ("N28_WRONG_SPEC_DIGEST", dict(spec_sha256="4"*64)), ("N29_WRONG_REGISTRY_DIGEST", dict(registry_sha256="5"*64)),
      ("N_FREEZE_MISSING_PASS", dict(review_result="FAIL")),
    ): expect_auth(tmp, name, "owner-freeze", {**freeze_common, **extra}, False,
                   state_changes=False, workspace_changes=False, refs_change=False)
    # Repeat review is idempotent in external state and still cannot publish.
    expect_auth(tmp, "P10_REVIEW_TO_FINAL", "record-review", req(review_result="PASS",candidate_sha=base,review_identity="review-1"), True,
                state_after="OWNER_FINAL_FREEZE_REQUIRED", refs_change=False, published=False)
    expect_auth(tmp, "P11_EXACT_OWNER_FREEZE", "owner-freeze", req(review_result="PASS",candidate_sha=base,review_identity="review-1"), True,
                state_after="OWNER_FROZEN", state_changes=True, refs_change=False)
    # Identical corpus through real validation and real Git-scope policy consumers.
    corpus = [("EXACT", "safe/x", True), ("PARENT", "safe/**", True),
              ("CHILD", "safe/x/child", False), ("SIBLING", "sibling/**", False),
              ("UNSUPPORTED", "safe/*", False), ("BACKSLASH", r"safe\x", True),
              ("DOTDOT", "../safe/x", False), ("DOT", "./safe/x", False),
              ("REPEATED", "safe//x", False), ("ROOT", "**", False)]
    for name, pattern, permits in corpus:
        prepo, pbase, psha = path_candidate(tmp, name, pattern)
        preq = {**common, "repo":str(prepo), "base_sha":pbase, "candidate_sha":psha,
                "task_id":"fixture-task"}
        expect_auth(tmp, f"PATH_VALIDATE_{name}", "validate-task", preq, permits)
        expect_auth(tmp, f"PATH_POLICY_{name}", "check-candidate", {**preq, "actor":"ordinary"}, permits)


def transition_request(repo: Path, base: str, task_id: str, state: Path,
                       workspace: Path, remote: Path, **extra: object) -> dict[str, object]:
    identity_sha = extra.get("candidate_sha", base)
    if not isinstance(identity_sha, str):
        raise Rig("fixture candidate identity must be a string")
    spec_raw = git_object_bytes(repo, identity_sha, "specs/tasks.spec.json")
    registry_raw = git_object_bytes(repo, identity_sha, "specs/owner-production-paths.v1.json")
    if spec_raw is None or registry_raw is None:
        raise Rig("fixture canonical authority documents missing")
    spec = json.loads(spec_raw)
    hits = [task for task in spec.get("tasks", [])
            if isinstance(task, dict) and task.get("id") == task_id]
    canonical_gate = hits[0].get("exit_test") if len(hits) == 1 else None
    request_gate = extra.get("gate_path", canonical_gate)
    gate_raw = (git_object_bytes(repo, identity_sha, canonical_gate)
                if isinstance(canonical_gate, str) else None)
    gate_digest = (extra.get("gate_sha256") if "gate_sha256" in extra
                   else hashlib.sha256(gate_raw).hexdigest() if gate_raw is not None
                   else "0" * 64)
    return {"repo":str(repo), "task_id":task_id, "base_sha":base,
        "candidate_sha":base, "main_sha":base,
        "spec_sha256":hashlib.sha256(spec_raw).hexdigest(),
        "registry_sha256":hashlib.sha256(registry_raw).hexdigest(),
        "gate_path":request_gate, "gate_sha256":gate_digest,
        "state_dir":str(state), "workspace_root":str(workspace), "remote":str(remote),
        **extra}


def remediation_matrix(tmp: Path) -> None:
    """Black-box guards for H035-IR-01..07 from independent builder review."""
    # IR-01: normal task selection's authoritative event state must be the
    # state consumed by the explicit owner transition. No judge-written
    # current.json bridge is permitted in this path.
    repo, base = authority_repo(tmp, "ir01-repo", [
        owner_task("owner-ir01", ["controller/h034-native/**"])])
    state, attest, workspace = tmp / "ir01-state", tmp / "ir01-attest", tmp / "ir01-ws"
    init_state(state); attest.mkdir()
    claim = run([str(TASKVAL), "claim", str(repo / "specs/tasks.spec.json"),
                 str(attest), str(state)])
    rebuilt = run([str(STATE), "rebuild", str(state)])
    bare = tmp / "ir01-origin.git"; run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
    set_remote_main(bare, repo, base)
    refs_before = remote_refs(bare)
    request = transition_request(repo, base, "owner-ir01", state, workspace, bare)
    rc, out, detail = authority_call(tmp, "owner-author", request)
    check(claim.returncode == 0 and not claim.stdout.strip()
          and "OWNER_ACTION_REQUIRED" in rebuilt.stdout
          and rc == 0 and out.get("accepted") is True
          and "OWNER_CANDIDATE_REVIEW_REQUIRED" in persisted_state(state)
          and workspace.is_dir() and remote_refs(bare) == refs_before,
          "A_IR01_NORMAL_EVENTLOG_OWNER_AUTHOR_HANDOFF", detail or repr(out))

    # IR-02: persisted caller-hostile state can never change the canonical
    # class of an ordinary task.
    repo, base = authority_repo(tmp, "ir02-repo", [ordinary_task("ordinary-ir02", ["safe/**"])])
    bare = tmp / "ir02-origin.git"; run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
    set_remote_main(bare, repo, base)
    state, workspace = tmp / "ir02-state", tmp / "ir02-ws"
    write_json(state / "current.json",
               {"task":"ordinary-ir02", "state":"OWNER_ACTION_REQUIRED", "base_sha":base})
    expect_auth(tmp, "A_IR02_ORDINARY_OWNER_AUTHOR_ESCALATION_REJECT", "owner-author",
                transition_request(repo, base, "ordinary-ir02", state, workspace, bare), False,
                state_changes=False, workspace_changes=False, refs_change=False)

    # IR-03: the task's exact owner surface is narrower than the registry's
    # global owner family. Both negative and legitimate exact-file controls
    # use the actual Git-derived candidate check.
    repo, base = authority_repo(tmp, "ir03-repo", [
        owner_task("owner-ir03", ["controller/h034-native/kernel.c"])])
    bare = tmp / "ir03-origin.git"; run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
    set_remote_main(bare, repo, base)
    request = transition_request(repo, base, "owner-ir03", tmp/"ir03-state", tmp/"ir03-ws", bare)
    alt = candidate(repo, base, "controller/h034-native/alternative.c", 301)
    rc, out, detail = authority_call(tmp, "check-candidate",
                                     {**request, "candidate_sha":alt, "actor":"owner_authority"})
    check(rc != 0 and out.get("accepted") is False,
          "A_IR03_TASK_SPECIFIC_OWNER_SURFACE_REJECT", detail or repr(out))
    exact = candidate(repo, base, "controller/h034-native/kernel.c", 302)
    rc, out, detail = authority_call(tmp, "check-candidate",
                                     {**request, "candidate_sha":exact, "actor":"owner_authority"})
    check(rc == 0 and out.get("accepted") is True,
          "A_IR03_TASK_SPECIFIC_OWNER_SURFACE_POSITIVE", detail or repr(out))

    # IR-04: execute the exact policy CLI used by controller/loop/cli in a
    # disposable clone. The task exists before its candidate; this is the
    # prospective post-bootstrap ordinary route, not H-035's exception.
    clone = tmp / "ir04-normal-policy-repo"
    p = run(["git", "clone", "-q", "--no-hardlinks", str(ROOT), str(clone)], cwd=tmp)
    if p.returncode: raise Rig(p.stderr)
    write_json(clone / "specs/tasks.spec.json", {
        "spec_version":"2.0.0",
        "defaults":{"denied_write":[], "max_changed_files":10, "max_added_lines":100},
        "tasks":[ordinary_task("future-ordinary", ["controller/authority/**"])]})
    policy_base = commit_paths(clone, "future ordinary task allocated", "specs/tasks.spec.json")
    protected = candidate(clone, policy_base, "controller/authority/ir04-fixture.txt", 401)
    p = run([str(clone / "controller/policy/cli"), "check", "future-ordinary",
             policy_base, protected, str(clone / "specs/tasks.spec.json")], cwd=clone)
    check(p.returncode != 0, "A_IR04_NORMAL_LOOP_POLICY_PROSPECTIVE_PROTECTION_REJECT",
          (p.stdout or p.stderr)[-500:])
    write_json(clone / "specs/tasks.spec.json", {
        "spec_version":"2.0.0",
        "defaults":{"denied_write":[], "max_changed_files":10, "max_added_lines":100},
        "tasks":[ordinary_task("future-safe", ["tests/h035safe/**"])]})
    safe_base = commit_paths(clone, "future safe task allocated", "specs/tasks.spec.json")
    safe = candidate(clone, safe_base, "tests/h035safe/effect.txt", 402)
    p = run([str(clone / "controller/policy/cli"), "check", "future-safe",
             safe_base, safe, str(clone / "specs/tasks.spec.json")], cwd=clone)
    check(p.returncode == 0, "A_IR04_NORMAL_LOOP_POLICY_SAFE_POSITIVE",
          (p.stdout or p.stderr)[-500:])

    # IR-05: final freeze derives current main from the configured remote.
    # Advancing the real bare ref after review must invalidate stale A.
    repo, base = authority_repo(tmp, "ir05-repo", [
        owner_task("owner-ir05", ["controller/h034-native/**"])])
    bare = tmp / "ir05-origin.git"; run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
    set_remote_main(bare, repo, base)
    state, workspace = tmp / "ir05-state", tmp / "ir05-ws"
    write_json(state / "current.json",
               {"task":"owner-ir05", "state":"OWNER_ACTION_REQUIRED", "base_sha":base})
    request = transition_request(repo, base, "owner-ir05", state, workspace, bare)
    rc1, _, d1 = authority_call(tmp, "owner-author", request)
    rc2, _, d2 = authority_call(tmp, "record-review",
        {**request, "review_result":"PASS", "review_identity":"ir05-review"})
    advanced = candidate(repo, base, "advance-main.txt", 501)
    set_remote_main(bare, repo, advanced)
    state_before, refs_before = filesystem_snapshot(state), remote_refs(bare)
    rc3, out3, d3 = authority_call(tmp, "owner-freeze",
        {**request, "review_result":"PASS", "review_identity":"ir05-review"})
    check(rc1 == 0 and rc2 == 0 and rc3 != 0 and out3.get("accepted") is False
          and filesystem_snapshot(state) == state_before and remote_refs(bare) == refs_before
          and advanced in refs_before,
          "A_IR05_ACTUAL_REMOTE_CURRENT_MAIN_ADVANCE_REJECT",
          " | ".join(x for x in (d1, d2, d3, repr(out3)) if x))

    # IR-06: operational commands never borrow installed authority bytes.
    missing = tmp / "ir06-both-missing"; seed = init_repo(missing)
    rc, out, detail = authority_call(tmp, "validate-registry",
                                     {"repo":str(missing), "base_sha":seed, "candidate_sha":seed})
    check(rc != 0 and out.get("accepted") is False,
          "A_IR06_CANONICAL_SPEC_AND_REGISTRY_MISSING_REJECT", detail or repr(out))
    spec_only = tmp / "ir06-spec-only"; base0 = init_repo(spec_only); (spec_only/"specs").mkdir()
    write_json(spec_only / "specs/tasks.spec.json", {
        "spec_version":"2.0.0", "defaults":{"denied_write":[]},
        "tasks":[ordinary_task("ordinary-ir06", ["safe/**"])]})
    spec_sha = commit_paths(spec_only, "spec only", "specs/tasks.spec.json")
    rc, out, detail = authority_call(tmp, "validate-registry",
        {"repo":str(spec_only), "base_sha":base0, "candidate_sha":spec_sha})
    check(rc != 0 and out.get("accepted") is False,
          "A_IR06_CANONICAL_REGISTRY_MISSING_REJECT", detail or repr(out))
    reg_only = tmp / "ir06-registry-only"; base0 = init_repo(reg_only); (reg_only/"specs").mkdir()
    (reg_only / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    reg_sha = commit_paths(reg_only, "registry only", "specs/owner-production-paths.v1.json")
    rc, out, detail = authority_call(tmp, "validate-registry",
        {"repo":str(reg_only), "base_sha":base0, "candidate_sha":reg_sha})
    check(rc != 0 and out.get("accepted") is False,
          "A_IR06_CANONICAL_SPEC_MISSING_REJECT", detail or repr(out))

    # IR-07: malformed owner surfaces are rejected by taskval, the actual
    # normal routing consumer, before any owner handoff event is appended.
    malformed: list[tuple[str, object]] = [
        ("EMPTY", ""), ("ABSOLUTE", "/x"), ("DRIVE", "C:/x"),
        ("LEADING_DOT", "./x"), ("REPEATED_SEPARATOR", "x//y"),
        ("TRAILING_SEPARATOR", "x/"), ("DOT_SEGMENT", "x/./y"),
        ("DOTDOT_SEGMENT", "x/../y"), ("GLOB", "x/*"),
        ("NONTERMINAL_RECURSIVE", "x/**/y"), ("ROOT_RECURSIVE", "**"),
        ("NON_STRING", None), ("NUL", "x\x00y"),
    ]
    for name, path in malformed:
        state, attest = tmp / f"ir07-state-{name}", tmp / f"ir07-attest-{name}"
        init_state(state); attest.mkdir()
        spec = tmp / f"ir07-{name}.json"
        write_json(spec, {"spec_version":"2.0.0", "tasks":[
            owner_task("owner-ir07", [path])]})
        p = run([str(TASKVAL), "claim", str(spec), str(attest), str(state)])
        rebuilt = run([str(STATE), "rebuild", str(state)])
        check(p.returncode != 0 and rebuilt.returncode == 0
              and json.loads(rebuilt.stdout) == [],
              f"A_IR07_NORMAL_TASKVAL_MALFORMED_{name}_REJECT",
              (p.stderr or p.stdout)[-500:])
    state, attest = tmp / "ir07-state-positive", tmp / "ir07-attest-positive"
    init_state(state); attest.mkdir()
    spec = tmp / "ir07-positive.json"
    write_json(spec, {"spec_version":"2.0.0", "tasks":[
        owner_task("owner-ir07", [r"controller\h034-native\**"])]})
    p = run([str(TASKVAL), "claim", str(spec), str(attest), str(state)])
    rebuilt = run([str(STATE), "rebuild", str(state)])
    check(p.returncode == 0 and "OWNER_ACTION_REQUIRED" in rebuilt.stdout,
          "A_IR07_NORMAL_TASKVAL_BACKSLASH_NORMALIZATION_POSITIVE",
          (p.stderr or p.stdout)[-500:])


def r6_remediation_matrix(tmp: Path) -> None:
    """Black-box guards for independent findings H035-R5-RV-01..02."""
    # RV-01 predicted effect: after normal taskval has persisted the owner
    # handoff, force the existing SQLite projection to reject its next write.
    # A rejected owner-author must leave authoritative event bytes, projection,
    # bounded workspace and remote refs byte-identical. The successful IR-01
    # case remains the legitimate positive storage variant.
    repo, base = authority_repo(tmp, "r6-atomic-repo", [
        owner_task("owner-r6-atomic", ["controller/h034-native/**"])])
    state, attest, workspace = (tmp / "r6-atomic-state", tmp / "r6-atomic-attest",
                                tmp / "r6-atomic-workspace")
    init_state(state); attest.mkdir()
    claim = run([str(TASKVAL), "claim", str(repo / "specs/tasks.spec.json"),
                 str(attest), str(state)])
    rebuilt_before = run([str(STATE), "rebuild", str(state)])
    database = state / "state.db"
    database.unlink(); database.mkdir()
    bare = tmp / "r6-atomic-origin.git"
    p = run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
    if p.returncode: raise Rig(p.stderr)
    set_remote_main(bare, repo, base)
    request = transition_request(repo, base, "owner-r6-atomic", state, workspace, bare)
    state_before = filesystem_snapshot(state)
    workspace_before = filesystem_snapshot(workspace)
    refs_before = remote_refs(bare)
    rc, out, detail = authority_call(tmp, "owner-author", request)
    rebuilt_after = run([str(STATE), "rebuild", str(state)])
    state_after = filesystem_snapshot(state)
    workspace_after = filesystem_snapshot(workspace)
    refs_after = remote_refs(bare)
    check(claim.returncode == 0 and "OWNER_ACTION_REQUIRED" in rebuilt_before.stdout
          and rc != 0 and out.get("accepted") is False
          and state_after == state_before
          and workspace_after == workspace_before
          and refs_after == refs_before
          and rebuilt_after.stdout == rebuilt_before.stdout,
          "A_R6_RV01_REJECTED_OWNER_AUTHOR_ATOMIC_ON_PROJECTION_FAILURE",
          f"rc={rc} accepted={out.get('accepted')!r} "
          f"state_delta={snapshot_delta(state_before, state_after)!r} "
          f"workspace_delta={snapshot_delta(workspace_before, workspace_after)!r} "
          f"refs_changed={refs_after != refs_before} "
          f"rebuilt_changed={rebuilt_after.stdout != rebuilt_before.stdout} "
          f"detail={detail!r}")

    # RV-02 predicted effect: normal task selection and policy are executed
    # with no bytecode-control environment. Expected state/candidate effects
    # are outside the observed repository tree; no cache or other local byte
    # may appear. Fresh clones keep the two production consumers attributable.
    taskval_repo = tmp / "r6-taskval-hygiene-repo"
    p = run(["git", "clone", "-q", "--no-hardlinks", str(ROOT), str(taskval_repo)], cwd=tmp)
    if p.returncode: raise Rig(p.stderr)
    taskval_state, taskval_attest = tmp / "r6-taskval-state", tmp / "r6-taskval-attest"
    p = run([str(taskval_repo / "controller/state/cli"), "init", str(taskval_state)],
            cwd=taskval_repo, env=ordinary_python_env())
    if p.returncode: raise Rig(p.stderr or p.stdout)
    taskval_attest.mkdir()
    taskval_spec = tmp / "r6-taskval-spec.json"
    write_json(taskval_spec, {"spec_version":"2.0.0", "tasks":[
        ordinary_task("ordinary-r6-hygiene", ["tests/h035-hygiene/**"])]})
    taskval_before = repository_snapshot(taskval_repo)
    p = run([str(taskval_repo / "controller/taskval/cli"), "claim", str(taskval_spec),
             str(taskval_attest), str(taskval_state)], cwd=taskval_repo,
            env=ordinary_python_env())
    taskval_after = repository_snapshot(taskval_repo)
    rebuilt = run([str(taskval_repo / "controller/state/cli"), "rebuild", str(taskval_state)],
                  cwd=taskval_repo, env=ordinary_python_env())
    taskval_delta = snapshot_delta(taskval_before, taskval_after)
    check(p.returncode == 0 and p.stdout.strip() == "ordinary-r6-hygiene"
          and "claimed" in rebuilt.stdout and not taskval_delta,
          "A_R6_RV02_NORMAL_TASKVAL_REPOSITORY_HYGIENE",
          f"rc={p.returncode} delta={taskval_delta!r} stderr={p.stderr[-300:]!r}")

    policy_repo = tmp / "r6-policy-hygiene-repo"
    p = run(["git", "clone", "-q", "--no-hardlinks", str(ROOT), str(policy_repo)], cwd=tmp)
    if p.returncode: raise Rig(p.stderr)
    policy_base = git(policy_repo, "rev-parse", "HEAD").stdout.strip()
    policy_candidate = candidate(policy_repo, policy_base,
                                 "tests/h035-hygiene/effect.txt", 602)
    policy_spec = tmp / "r6-policy-spec.json"
    write_json(policy_spec, {"spec_version":"2.0.0",
        "defaults":{"denied_write":[], "max_changed_files":5, "max_added_lines":20},
        "tasks":[ordinary_task("ordinary-r6-hygiene", ["tests/h035-hygiene/**"])]})
    policy_before = repository_snapshot(policy_repo)
    p = run([str(policy_repo / "controller/policy/cli"), "check", "ordinary-r6-hygiene",
             policy_base, policy_candidate, str(policy_spec)], cwd=policy_repo,
            env=ordinary_python_env())
    policy_after = repository_snapshot(policy_repo)
    policy_delta = snapshot_delta(policy_before, policy_after)
    check(p.returncode == 0 and "accepterad:" in p.stdout and not policy_delta,
          "A_R6_RV02_NORMAL_POLICY_REPOSITORY_HYGIENE",
          f"rc={p.returncode} delta={policy_delta!r} output={(p.stdout or p.stderr)[-300:]!r}")


def malformed_task_gate_repo(tmp: Path, name: str, kind: str,
                             gate_path: str) -> tuple[Path, str]:
    """Create a canonical owner task whose exit_test is absent or not a regular blob."""
    repo = tmp / f"r9-{name}-repo"; init_repo(repo)
    (repo / "specs").mkdir()
    write_json(repo / "specs/tasks.spec.json", {
        "spec_version":"2.0.0", "defaults":{"denied_write":[]},
        "tasks":[owner_task("owner-r9-a", ["controller/h034-native/**"], gate_path)]})
    (repo / "specs/owner-production-paths.v1.json").write_bytes(REG.read_bytes())
    target = repo / gate_path
    if kind == "tree":
        target.mkdir(parents=True)
        (target / "payload").write_text("not a regular gate\n")
    elif kind == "symlink":
        target.parent.mkdir(parents=True, exist_ok=True)
        (target.parent / "r9-symlink-target").write_text("#!/bin/sh\nexit 1\n")
        target.symlink_to("r9-symlink-target")
    elif kind != "missing":
        raise Rig(f"unknown malformed task gate fixture: {kind}")
    p = git(repo, "add", "-A")
    if p.returncode: raise Rig(p.stderr)
    p = git(repo, "commit", "-qm", f"canonical {kind} gate authority")
    if p.returncode: raise Rig(p.stderr)
    return repo, git(repo, "rev-parse", "HEAD").stdout.strip()


def seed_owner_command_state(state: Path, command: str,
                             request: dict[str, object]) -> None:
    task = request["task_id"]; base = request["base_sha"]
    candidate_sha = request["candidate_sha"]
    if command == "owner-author":
        value = {"task":task, "state":"OWNER_ACTION_REQUIRED", "base_sha":base}
    elif command == "record-review":
        value = {"task":task, "state":"OWNER_CANDIDATE_REVIEW_REQUIRED",
                 "base_sha":base, "candidate_sha":candidate_sha}
    elif command == "owner-freeze":
        value = {"task":task, "state":"OWNER_FINAL_FREEZE_REQUIRED",
                 "base_sha":base, "main_sha":request["main_sha"],
                 "candidate_sha":candidate_sha,
                 "spec_sha256":request["spec_sha256"],
                 "registry_sha256":request["registry_sha256"],
                 "gate_path":request["gate_path"],
                 "gate_sha256":request["gate_sha256"],
                 "review_identity":"r9-review", "review_result":"PASS"}
    else:
        return
    write_json(state / "current.json", value)


def positive_owner_gate_chain(tmp: Path, label: str, repo: Path, base: str,
                              task_id: str, remote: Path,
                              *, revision: str = "R10") -> None:
    """Exercise every material owner consumer as one independent positive chain."""
    state = tmp / f"r10-{label}-state"
    workspace = tmp / f"r10-{label}-workspace"
    write_json(state / "current.json",
               {"task":task_id, "state":"OWNER_ACTION_REQUIRED", "base_sha":base})
    request = transition_request(repo, base, task_id, state, workspace, remote)
    refs_before = remote_refs(remote)
    rc1, out1, d1 = authority_call(tmp, "owner-author", request)
    rc2, out2, d2 = authority_call(tmp, "check-candidate",
                                   {**request, "actor":"owner_authority"})
    rc3, out3, d3 = authority_call(tmp, "record-review",
        {**request, "review_result":"PASS", "review_identity":f"r10-{label}-review"})
    rc4, out4, d4 = authority_call(tmp, "owner-freeze",
        {**request, "review_result":"PASS", "review_identity":f"r10-{label}-review"})
    check(all(rc == 0 and out.get("accepted") is True for rc, out in
              ((rc1,out1),(rc2,out2),(rc3,out3),(rc4,out4)))
          and "OWNER_FROZEN" in persisted_state(state)
          and workspace.is_dir() and remote_refs(remote) == refs_before,
          f"A_{revision}_{label.upper()}_FULL_OWNER_GATE_CHAIN_POSITIVE",
          " | ".join((d1,d2,d3,d4,repr((out1,out2,out3,out4)))))


def set_hostile_checkout_gate(target: Path, kind: str, canonical: bytes) -> None:
    """Change only disposable mutable checkout state, never its Git object."""
    hostile_target = target.parent / "r10-hostile-target"
    if target.is_symlink() or target.is_file():
        target.unlink()
    elif target.is_dir():
        for child in sorted(target.rglob("*"), reverse=True):
            if child.is_symlink() or child.is_file(): child.unlink()
            elif child.is_dir(): child.rmdir()
        target.rmdir()
    if hostile_target.exists() or hostile_target.is_symlink(): hostile_target.unlink()
    if kind == "regular-bytes":
        target.write_bytes(b"#!/bin/sh\nprintf 'hostile mutable checkout bytes\\n'\nexit 0\n")
    elif kind == "directory":
        target.mkdir(); (target / "payload").write_text("hostile directory\n")
    elif kind == "symlink":
        hostile_target.write_bytes(b"#!/bin/sh\nexit 0\n")
        target.symlink_to(hostile_target.name)
    elif kind == "restore":
        target.write_bytes(canonical); target.chmod(0o755)
    elif kind != "missing":
        raise Rig(f"unknown hostile checkout kind: {kind}")


def r9_task_gate_matrix(tmp: Path) -> None:
    """Operational task-specific gate binding for H035-H034-INTEGRATION-01."""
    gate_a = "verify/bin/r9-owner-a-exit"
    gate_b = "verify/bin/r9-owner-b-exit"
    gate_literal = ":(literal)verify/bin/r11-owner-literal-exit"
    gate_top = ":(top)verify/bin/r11-owner-top-exit"
    gate_utf8 = "verify/bin/r12 owner-β-exit"
    bytes_a = b"#!/bin/sh\nprintf 'r9 owner a red\\n' >&2\nexit 1\n"
    bytes_b = b"#!/bin/sh\nprintf 'r9 owner b red\\n' >&2\nexit 1\n"
    bytes_literal = b"#!/bin/sh\nprintf 'r11 literal owner red\\n' >&2\nexit 1\n"
    bytes_top = b"#!/bin/sh\nprintf 'r11 top owner red\\n' >&2\nexit 1\n"
    bytes_utf8 = b"#!/bin/sh\nprintf 'r12 utf8 space owner red\\n' >&2\nexit 1\n"
    repo, base = authority_repo(tmp, "r9-canonical-repo", [
        owner_task("owner-r9-a", ["controller/h034-native/**"], gate_a),
        owner_task("owner-r9-b", ["controller/h034-native/**"], gate_b),
        owner_task("owner-r11-literal", ["controller/h034-native/**"], gate_literal),
        owner_task("owner-r11-top", ["controller/h034-native/**"], gate_top),
        owner_task("owner-r12-utf8-space", ["controller/h034-native/**"], gate_utf8),
    ], gates={gate_a:bytes_a, gate_b:bytes_b,
              gate_literal:bytes_literal, gate_top:bytes_top,
              gate_utf8:bytes_utf8}, gate_modes={gate_utf8:0o644})
    bare = tmp / "r9-canonical-origin.git"
    p = run(["git", "init", "--bare", "-q", str(bare)], cwd=tmp)
    if p.returncode: raise Rig(p.stderr)
    set_remote_main(bare, repo, base)
    refs_before = remote_refs(bare)

    # Two independent full positive chains forbid a superficial implementation
    # that special-cases the first task. Each task selects its own distinct
    # canonical gate path and bytes from the exact same candidate object.
    positive_owner_gate_chain(tmp, "task_a", repo, base, "owner-r9-a", bare)
    positive_owner_gate_chain(tmp, "task_b_distinct", repo, base, "owner-r9-b", bare)
    positive_owner_gate_chain(tmp, "pathspec_literal", repo, base,
                              "owner-r11-literal", bare, revision="R11")
    positive_owner_gate_chain(tmp, "pathspec_top", repo, base,
                              "owner-r11-top", bare, revision="R11")
    positive_owner_gate_chain(tmp, "utf8_space_100644", repo, base,
                              "owner-r12-utf8-space", bare, revision="R12")

    # R12 composes pathspec syntax with immutable candidate-object authority.
    # Predicted before execution: a generic literal candidate-tree resolver
    # accepts every chain; a narrow `:(...)` mutable-checkout fallback fails.
    # Each checkout has one hostile property while candidate_sha remains exact.
    for label, target, kind, canonical, task_id in (
        ("pathspec_literal_checkout_regular_bytes", repo/gate_literal,
         "regular-bytes", bytes_literal, "owner-r11-literal"),
        ("pathspec_literal_checkout_directory", repo/gate_literal,
         "directory", bytes_literal, "owner-r11-literal"),
        ("pathspec_top_checkout_symlink", repo/gate_top,
         "symlink", bytes_top, "owner-r11-top"),
        ("pathspec_top_checkout_missing", repo/gate_top,
         "missing", bytes_top, "owner-r11-top"),
    ):
        set_hostile_checkout_gate(target, kind, canonical)
        positive_owner_gate_chain(tmp, label, repo, base, task_id, bare,
                                  revision="R12")
    set_hostile_checkout_gate(repo/gate_literal, "restore", bytes_literal)
    set_hostile_checkout_gate(repo/gate_top, "restore", bytes_top)
    check(not git(repo, "status", "--porcelain").stdout.strip(),
          "A_R12_PATHSPEC_HOSTILE_MUTABLE_CHECKOUT_FIXTURE_CLEANUP")

    # Candidate-object authority is invariant to the mutable checkout. Four
    # one-defect checkout variants change gate bytes/type/link/existence while
    # candidate_sha stays byte-identical. Every legitimate Git-object reader
    # accepts; a mutable Path-based authority implementation rejects or hashes
    # the hostile bytes and is caught. Each variant uses a fresh complete chain.
    checkout_gate = repo / gate_a
    for label, kind in (("checkout_regular_bytes", "regular-bytes"),
                        ("checkout_directory", "directory"),
                        ("checkout_symlink", "symlink"),
                        ("checkout_missing", "missing")):
        set_hostile_checkout_gate(checkout_gate, kind, bytes_a)
        positive_owner_gate_chain(tmp, label, repo, base, "owner-r9-a", bare)
    set_hostile_checkout_gate(checkout_gate, "restore", bytes_a)
    check(not git(repo, "status", "--porcelain").stdout.strip(),
          "A_R10_HOSTILE_MUTABLE_CHECKOUT_FIXTURE_CLEANUP")

    digest_a = hashlib.sha256(bytes_a).hexdigest()
    digest_b = hashlib.sha256(bytes_b).hexdigest()
    canonical_request = transition_request(repo, base, "owner-r9-a",
        tmp/"r9-unused-state", tmp/"r9-unused-workspace", bare)

    # Predicted before execution: every mutant below rejects. The check is
    # repeated through all four operational consumers; rejected commands must
    # preserve state, bounded workspace, and real bare-remote refs byte-for-byte.
    cases: list[tuple[str, Path, str, str, dict[str, object]]] = [
        ("WRONG_GATE_PATH", repo, base, base,
         {**canonical_request, "gate_path":"verify/bin/r9-not-canonical-exit",
          "gate_sha256":digest_a}),
        ("WRONG_GATE_DIGEST", repo, base, base,
         {**canonical_request, "gate_sha256":"a" * 64}),
        ("ANOTHER_TASK_GATE", repo, base, base,
         {**canonical_request, "gate_path":gate_b, "gate_sha256":digest_b}),
        ("CALLER_GATE_OVERRIDE", repo, base, base,
         {**canonical_request, "exit_test_override":gate_b,
          "exit_test_override_sha256":digest_b}),
    ]

    for label, kind in (("MISSING_GATE", "missing"),
                        ("NONREGULAR_GATE", "tree"),
                        ("SYMLINK_GATE", "symlink")):
        bad_repo, bad_base = malformed_task_gate_repo(
            tmp, label.lower(), kind, f"verify/bin/r9-{kind}-exit")
        bad_bare = tmp / f"r9-{kind}-origin.git"
        p = run(["git", "init", "--bare", "-q", str(bad_bare)], cwd=tmp)
        if p.returncode: raise Rig(p.stderr)
        set_remote_main(bad_bare, bad_repo, bad_base)
        bad_request = transition_request(bad_repo, bad_base, "owner-r9-a",
            tmp/f"r9-unused-{kind}-state", tmp/f"r9-unused-{kind}-workspace", bad_bare)
        cases.append((label, bad_repo, bad_base, bad_base, bad_request))

    changed = candidate(repo, base, gate_a, 901)
    changed_request = transition_request(repo, base, "owner-r9-a",
        tmp/"r9-unused-changed-state", tmp/"r9-unused-changed-workspace", bare,
        candidate_sha=changed)
    cases.append(("OWNER_CHANGED_OWN_GATE", repo, base, changed, changed_request))

    # The inverse control: checkout and candidate both contain altered gate
    # bytes, while the request repeats the prior candidate's digest. By making
    # the altered commit both base and candidate, no changed-file or owner-
    # author base check can independently explain rejection.
    mismatch_repo, mismatch_old = authority_repo(tmp, "r10-object-mismatch-repo", [
        owner_task("owner-r9-a", ["controller/h034-native/**"], gate_a)],
        gates={gate_a:bytes_a})
    mismatch_candidate = candidate(mismatch_repo, mismatch_old, gate_a, 1001)
    mismatch_bare = tmp / "r10-object-mismatch-origin.git"
    p = run(["git", "init", "--bare", "-q", str(mismatch_bare)], cwd=tmp)
    if p.returncode: raise Rig(p.stderr)
    set_remote_main(mismatch_bare, mismatch_repo, mismatch_candidate)
    mismatch_request = transition_request(
        mismatch_repo, mismatch_candidate, "owner-r9-a",
        tmp/"r10-unused-object-mismatch-state",
        tmp/"r10-unused-object-mismatch-workspace", mismatch_bare,
        gate_sha256=digest_a)
    cases.append(("CANDIDATE_GATE_OBJECT_MISMATCH", mismatch_repo,
                  mismatch_candidate, mismatch_candidate, mismatch_request))

    # Inverse R12 control: the checkout and exact candidate both contain
    # changed bytes at a literal pathspec-looking filename, while the request
    # repeats the prior candidate digest. All four consumers must reject with
    # state, bounded workspace and refs unchanged.
    literal_mismatch_repo, literal_mismatch_old = authority_repo(
        tmp, "r12-literal-object-mismatch-repo", [
            owner_task("owner-r11-literal", ["controller/h034-native/**"],
                       gate_literal)], gates={gate_literal:bytes_literal})
    literal_mismatch_candidate = candidate(
        literal_mismatch_repo, literal_mismatch_old, gate_literal, 1201)
    literal_mismatch_bare = tmp / "r12-literal-object-mismatch-origin.git"
    p = run(["git", "init", "--bare", "-q", str(literal_mismatch_bare)], cwd=tmp)
    if p.returncode: raise Rig(p.stderr)
    set_remote_main(literal_mismatch_bare, literal_mismatch_repo,
                    literal_mismatch_candidate)
    literal_mismatch_request = transition_request(
        literal_mismatch_repo, literal_mismatch_candidate, "owner-r11-literal",
        tmp/"r12-unused-literal-object-mismatch-state",
        tmp/"r12-unused-literal-object-mismatch-workspace", literal_mismatch_bare,
        gate_sha256=hashlib.sha256(bytes_literal).hexdigest())
    cases.append(("PATHSPEC_LITERAL_CANDIDATE_GATE_OBJECT_MISMATCH",
                  literal_mismatch_repo, literal_mismatch_candidate,
                  literal_mismatch_candidate, literal_mismatch_request))

    for label, _case_repo, _case_base, _case_candidate, template in cases:
        for command in ("owner-author", "check-candidate", "record-review", "owner-freeze"):
            state = tmp / f"r9-{label.lower()}-{command}-state"
            workspace = tmp / f"r9-{label.lower()}-{command}-workspace"
            request = {**template, "state_dir":str(state),
                       "workspace_root":str(workspace)}
            if command == "check-candidate":
                request["actor"] = "owner_authority"
            else:
                request["review_result"] = "PASS"
                request["review_identity"] = "r9-review"
            seed_owner_command_state(state, command, request)
            if label == "CANDIDATE_GATE_OBJECT_MISMATCH":
                revision = "R10"
            elif label == "PATHSPEC_LITERAL_CANDIDATE_GATE_OBJECT_MISMATCH":
                revision = "R12"
            else:
                revision = "R9"
            expect_auth(tmp, f"A_{revision}_{label}_{command.upper().replace('-', '_')}_REJECT",
                        command, request, False, state_changes=False,
                        workspace_changes=False, refs_change=False)


def r15_document_append_selftests() -> None:
    doc_appends={path:(int(row[0]),str(row[1]),str(row[2]).encode("utf-8"))
                 for path,row in dict(H035_R26_SUCCESSOR["doc_appends"]).items()}
    authority_base=str(H035_R26_SUCCESSOR["authority_base_sha"])
    r26_candidate=str(H035_R29_THREE_STATE_REGISTRY[
        "historical_r26_contract_candidate_sha"])
    r29_base=str(H035_R29_THREE_STATE_REGISTRY["preproduct_evidence"]["base_sha"])
    def valid(path: str, base: bytes, candidate: bytes) -> bool:
        size,digest,marker=doc_appends[path]
        if not candidate.startswith(base): return False
        suffix=candidate[len(base):]
        return (len(suffix)==size and hashlib.sha256(suffix).hexdigest()==digest
                and suffix.startswith(marker) and suffix.endswith(b"\n"))
    positives=[]; mutants=[]
    for path in doc_appends:
        base=r15_git_object_bytes(ROOT,authority_base,path)
        published=r15_git_object_bytes(ROOT,r26_candidate,path)
        positives.append(base is not None and published is not None
                         and valid(path,base,published))
        if base is None: continue
        suffix=published[len(base):] if published is not None \
            and published.startswith(base) else b""
        mutants.extend((
            (path,base,b"hostile rewrite\n"),
            (path,base,base[:-1]+suffix),
            (path,base,b"hostile prefix\n"+base+suffix),
            (path,base,base+suffix+b"generic delegation\n"),
            (path,base,base+suffix.replace(b"R24",b"RXX",1)),
        ))
    check(len(positives)==3 and all(positives),
          "F_R26_THREE_DOCUMENTS_EXACT_SUCCESSOR_BASE_BLOB_PLUS_BOUNDED_APPEND")
    check(len(mutants)==15 and all(not valid(path,base,candidate)
                                  for path,base,candidate in mutants),
          "J_R26_DOCUMENT_REWRITE_TRUNCATE_PREFIX_EXTRA_CONTRADICTION_REJECT")
    r29_appends={path:(int(row[0]),str(row[1]),str(row[2]).encode("utf-8"))
        for path,row in dict(H035_R29_THREE_STATE_REGISTRY["document_appends"]).items()}
    def r29_valid(path: str,base: bytes,candidate: bytes) -> bool:
        size,digest,marker=r29_appends[path]
        if not candidate.startswith(base):return False
        suffix=candidate[len(base):]
        return (len(suffix)==size and hashlib.sha256(suffix).hexdigest()==digest
                and suffix.startswith(marker) and suffix.endswith(b"\n"))
    r29_positives=[];r29_mutants=[]
    for path,(_size,_digest,marker) in r29_appends.items():
        base=r15_git_object_bytes(ROOT,r29_base,path)
        published=r15_git_object_bytes(
            ROOT,str(H035_R33_REQUEST_BOUND_REGISTRY["preproduct_evidence"]["base_sha"]),path)
        suffix=published[len(base):] if base is not None and published is not None \
            and published.startswith(base) else b""
        r29_positives.append(base is not None and published is not None
                             and r29_valid(path,base,published))
        if base is None:continue
        r29_mutants.extend(((path,base,base+suffix+b"extra\n"),
                            (path,base,base+suffix[:-1]),
                            (path,base,base[:-1]+suffix),
                            (path,base,b"rewrite\n"+base+suffix),
                            (path,base,base+suffix.replace(
                                marker,b"substitute",1))))
    check(len(r29_positives)==4 and all(r29_positives),
          "F_R29_FOUR_DOCUMENTS_EXACT_BASE_C161_PLUS_HASH_BOUND_APPEND")
    check(len(r29_mutants)==20 and all(not r29_valid(path,base,candidate)
          for path,base,candidate in r29_mutants),
          "J_R29_DOCUMENT_REWRITE_TRUNCATE_PREFIX_EXTRA_SUBSTITUTE_REJECT")
    r33_base=str(H035_R33_REQUEST_BOUND_REGISTRY["preproduct_evidence"]["base_sha"])
    r33_appends={path:(int(row[0]),str(row[1]),str(row[2]).encode("utf-8"))
        for path,row in H035_R33_REQUEST_BOUND_REGISTRY["document_appends"].items()}
    def r33_valid(path: str,base: bytes,candidate: bytes) -> bool:
        size,digest,marker=r33_appends[path]
        if not candidate.startswith(base):return False
        suffix=candidate[len(base):]
        return (len(suffix)==size and hashlib.sha256(suffix).hexdigest()==digest
                and suffix.startswith(marker) and suffix.endswith(b"\n"))
    positives=[];mutants=[]
    for path,(_size,_digest,marker) in r33_appends.items():
        base=r15_git_object_bytes(ROOT,r33_base,path)
        try:current=(ROOT/path).read_bytes()
        except OSError:current=b""
        suffix=current[len(base):] if base is not None and current.startswith(base) else b""
        positives.append(base is not None and r33_valid(path,base,current))
        if base is None:continue
        mutants.extend(((path,base,base+suffix+b"extra\n"),
                        (path,base,base+suffix[:-1]),
                        (path,base,base[:-1]+suffix),
                        (path,base,b"rewrite\n"+base+suffix),
                        (path,base,base+suffix.replace(marker,b"substitute",1))))
    check(len(positives)==4 and all(positives),
          "F_R33_FOUR_DOCUMENTS_EXACT_FF375_BASE_PLUS_HASH_BOUND_APPEND")
    check(len(mutants)==20 and all(not r33_valid(path,base,candidate)
          for path,base,candidate in mutants),
          "J_R33_DOCUMENT_REWRITE_TRUNCATE_PREFIX_EXTRA_SUBSTITUTE_REJECT")


def r15_parallel_cli_selftests() -> None:
    with tempfile.TemporaryDirectory(prefix="h035-r26-parallel-") as raw:
        root=Path(raw).resolve();worker=root/"worker.py";lock=root/"held.lock";lock.touch()
        worker_source=(
            "import fcntl,json,os,sys,time\n"
            "mode=sys.argv[1]\n"
            "if mode=='mark-sleep':open(sys.argv[2],'w').write(str(os.getpid()));time.sleep(3)\n"
            "elif mode=='exit':raise SystemExit(0)\n"
            "elif mode=='exit-after':\n"
            " stop=time.monotonic()+2;peer=-1\n"
            " while time.monotonic()<stop:\n"
            "  if os.path.exists(sys.argv[2]):\n"
            "   try:peer=int(open(sys.argv[3]).read())\n"
            "   except (OSError,ValueError):peer=-1\n"
            "   if peer>1:break\n"
            "  time.sleep(.01)\n"
            " if peer<=1:raise SystemExit(2)\n"
            " raise SystemExit(0)\n"
            "elif mode=='invalid':open(sys.argv[2],'w').write(str(os.getpid()));os.write(1,bytes([255]));time.sleep(3)\n"
            "elif mode=='lock':\n"
            " open(sys.argv[3],'w').write(str(os.getpid()));fd=os.open(sys.argv[2],os.O_RDWR);fcntl.flock(fd,fcntl.LOCK_EX);open(sys.argv[4],'w').write('released');time.sleep(3)\n"
            "elif mode=='lock-ready':\n"
            " with open(sys.argv[3],'w') as stream:stream.write(str(os.getpid()))\n"
            " open(sys.argv[4],'x').close();fd=os.open(sys.argv[2],os.O_RDWR);fcntl.flock(fd,fcntl.LOCK_EX);open(sys.argv[5],'w').write('released');time.sleep(3)\n"
            "elif mode=='delay-lock':\n"
            " time.sleep(float(sys.argv[3]));fd=os.open(sys.argv[2],os.O_RDWR);fcntl.flock(fd,fcntl.LOCK_EX);open(sys.argv[4],'w').write('acquired')\n"
            "elif mode=='fork-exit':\n"
            " child=os.fork()\n"
            " if child==0:\n"
            "  stop=time.monotonic()+3\n"
            "  while time.monotonic()<stop:open(sys.argv[3],'a').write('x');time.sleep(.01)\n"
            "  raise SystemExit(0)\n"
            " open(sys.argv[2],'w').write(json.dumps({'leader':os.getpid(),'child':child,'pgid':os.getpgrp()}));raise SystemExit(0)\n")
        worker.write_text(worker_source,encoding="utf-8")
        def dead(pid: int) -> bool:
            try: os.kill(pid,0)
            except ProcessLookupError:return True
            return False
        descendant_marker=root/"descendant.json";descendant_canary=root/"descendant.ticks"
        peer_marker=root/"peer.pid";after=root/"after-release"
        try:
            r15_parallel_cli(root,[
                ("worker.py",["fork-exit",str(descendant_marker),str(descendant_canary)],None),
                ("worker.py",["lock",str(lock),str(peer_marker),str(after)],None),
            ],held_lock=lock)
            descendant_error="NO_REJECTION"
        except Rig as exc:descendant_error=str(exc)
        try:descendant=json.loads(descendant_marker.read_text(encoding="utf-8"))
        except (OSError,ValueError):descendant={}
        child=int(descendant.get("child",-1));deadline=time.monotonic()+2
        while child>1 and not dead(child) and time.monotonic()<deadline:time.sleep(.02)
        try:before=descendant_canary.stat().st_size
        except OSError:before=-1
        time.sleep(.15)
        try:after_size=descendant_canary.stat().st_size
        except OSError:after_size=-2
        try:peer=int(peer_marker.read_text(encoding="utf-8"))
        except (OSError,ValueError):peer=-1
        check("exact held-lock attempt barrier" in descendant_error
              and descendant.get("leader")==descendant.get("pgid") and child>1 and dead(child)
              and before==after_size and peer>1 and dead(peer) and not after.exists(),
              "J_R26_PRE_RELEASE_EXITED_LEADER_DESCENDANT_GROUP_KILLED_BEFORE_LOCK_RELEASE",
              descendant_error)
        zombie_peer=root/"zombie-peer.pid";zombie_ready=root/"zombie-peer.ready"
        zombie_after=root/"zombie-after"
        try:
            r15_parallel_cli(root,[
                ("worker.py",["exit-after",str(zombie_ready),str(zombie_peer)],None),
                ("worker.py",["lock-ready",str(lock),str(zombie_peer),
                              str(zombie_ready),str(zombie_after)],None),
            ],held_lock=lock)
            zombie_error="NO_REJECTION"
        except Rig as exc:zombie_error=str(exc)
        try:zombie_peer_pid=int(zombie_peer.read_text(encoding="utf-8"))
        except (OSError,ValueError):zombie_peer_pid=-1
        zombie_deadline=time.monotonic()+1
        while zombie_peer_pid>1 and not dead(zombie_peer_pid) and time.monotonic()<zombie_deadline:
            time.sleep(.01)
        check("bounded concurrent cleanup failed: killpg[0]=" in zombie_error
              and zombie_ready.is_file() and zombie_peer_pid>1
              and dead(zombie_peer_pid) and not zombie_after.exists(),
              "J_R26_ZOMBIE_ONLY_GROUP_EPERM_RIG_AND_ALL_PEERS_CLEANED",zombie_error)
        delayed_markers=[root/"delayed-a",root/"delayed-b"];barrier_diagnostics=[]
        delayed_results=r15_parallel_cli(root,[
            ("worker.py",["delay-lock",str(lock),"0.30",str(delayed_markers[0])],None),
            ("worker.py",["delay-lock",str(lock),"0.60",str(delayed_markers[1])],None),
        ],held_lock=lock,diagnostics=barrier_diagnostics)
        check([result.returncode for result in delayed_results]==[0,0]
              and all(path.read_text(encoding="utf-8")=="acquired"
                      for path in delayed_markers)
              and [row["index"] for row in barrier_diagnostics]==[0,1]
              and all(row["blocked_before_release"] is True
                      for row in barrier_diagnostics)
              and barrier_diagnostics[1]["launch_to_release_ms"]>=500,
              "J_R26_EXACT_LOCK_ATTEMPT_EFFECT_BARRIER_REJECTS_LIVENESS_ONLY_CREDIT",
              repr(barrier_diagnostics))
        launch_marker=root/"launch.pid"
        try:
            r15_parallel_cli(root,[
                ("worker.py",["mark-sleep",str(launch_marker)],None),
                ("worker.py",["\x00"],None),
            ],stagger_first=True)
            launch_error="NO_REJECTION"
        except (OSError,ValueError,Rig) as exc:launch_error=str(exc)
        try:launch_pid=int(launch_marker.read_text(encoding="utf-8"))
        except (OSError,ValueError):launch_pid=-1
        check(launch_error!="NO_REJECTION" and launch_pid>1 and dead(launch_pid),
              "J_R26_SECOND_POPEN_FAILURE_CLEANS_REGISTERED_GROUP",launch_error)
    source=ast.parse(Path(__file__).read_text(encoding="utf-8"),mode="exec")
    function=next((node for node in source.body if isinstance(node,ast.FunctionDef)
                   and node.name=="r15_parallel_cli"),None)
    timeout_values=[ast.unparse(keyword.value) for call in ast.walk(function)
                    if isinstance(call,ast.Call) for keyword in call.keywords
                    if keyword.arg=="timeout"] if function is not None else []
    check(timeout_values.count("max(0.0, cleanup_deadline - time.monotonic())")==3
          and timeout_values.count(
              "min(0.05, max(0.0, deadline - time.monotonic()))")==1
          and all("0.001" not in value for value in timeout_values),
          "J_R26_EXHAUSTED_COMMON_DEADLINES_GRANT_ZERO_POSITIVE_FLOOR",
          repr(timeout_values))
    short_function=copy.deepcopy(function) if function is not None else None
    deadline_sites=[node for node in ast.walk(short_function)
                    if isinstance(node,ast.Assign)
                    and any(isinstance(target,ast.Name) and target.id=="deadline"
                            for target in node.targets)
                    and isinstance(node.value,ast.BinOp)
                    and isinstance(node.value.op,ast.Add)
                    and isinstance(node.value.right,ast.Constant)
                    and node.value.right.value==60] if short_function is not None else []
    reverse_ok=False;decode_ok=False;post_reap_pipe_ok=False;reverse_detail=""
    if isinstance(short_function,ast.FunctionDef) and len(deadline_sites)==1:
        short_function.name="r15_parallel_cli_short_deadline"
        deadline_sites[0].value.right=ast.Constant(0.35)
        ast.fix_missing_locations(short_function)
        short_namespace={
            "__name__":"r26_short_deadline","Path":Path,"Rig":Rig,
            "fcntl":fcntl,"os":os,"select":select,"signal":signal,"stat":stat,
            "subprocess":subprocess,"sys":sys,"time":time,
        }
        try:
            exec(compile(ast.Module(body=[short_function],type_ignores=[]),
                         "<r26-short-deadline>","exec"),short_namespace,short_namespace)
            short_parallel=short_namespace["r15_parallel_cli_short_deadline"]
            with tempfile.TemporaryDirectory(prefix="h035-r26-short-deadline-") as short_raw:
                short_root=Path(short_raw).resolve()
                (short_root/"worker.py").write_text(worker_source,encoding="utf-8")
                reverse_rows=[]
                for serial,slow_first in enumerate((True,False)):
                    marker=short_root/f"reverse-slow-{serial}.pid";short_diagnostics=[]
                    slow=("worker.py",["mark-sleep",str(marker)],None)
                    fast=("worker.py",["exit"],None)
                    short_results=short_parallel(
                        short_root,[slow,fast] if slow_first else [fast,slow],
                        diagnostics=short_diagnostics)
                    marker_pid=int(marker.read_text(encoding="utf-8"))
                    reverse_rows.append((
                        [result.returncode for result in short_results],
                        [row["timed_out"] for row in short_diagnostics],
                        [row["actual_returncode"] for row in short_diagnostics],
                        dead(marker_pid)))
                reverse_ok=(reverse_rows[0][0]==[124,0]
                            and reverse_rows[0][1]==[True,False]
                            and reverse_rows[1][0]==[0,124]
                            and reverse_rows[1][1]==[False,True]
                            and all(row[2] in ([-signal.SIGKILL,0],[0,-signal.SIGKILL])
                                    and row[3] for row in reverse_rows))
                invalid_marker=short_root/"invalid.pid"
                decode_peer=short_root/"decode-peer.pid"
                try:
                    short_parallel(short_root,[
                        ("worker.py",["invalid",str(invalid_marker)],None),
                        ("worker.py",["mark-sleep",str(decode_peer)],None),
                    ])
                    decode_error="NO_REJECTION"
                except Rig as exc:decode_error=str(exc)
                decode_ok=(decode_error.count("pipe_drain[0]=")==1
                           and "cleanup reentry" not in decode_error
                           and dead(int(invalid_marker.read_text(encoding="utf-8")))
                           and dead(int(decode_peer.read_text(encoding="utf-8"))))
                fault_rows=[]
                for exception_type in (OSError,ValueError):
                    fault_processes=[];fault_signals=[]
                    class FaultProcess:
                        def __init__(self,index: int,argv: list[str]):
                            self.index=index;self.pid=6101+index;self.args=argv
                            self.returncode=None;self.stdin=None;self.stdout=None;self.stderr=None
                            self.communicate_calls=0
                        def communicate(self,timeout: float):
                            self.communicate_calls+=1
                            if self.index==0 and self.communicate_calls==1:
                                self.returncode=0;raise exception_type("post-reap")
                            if self.returncode is None:raise FaultTimeoutExpired()
                            return "",""
                        def poll(self):return self.returncode
                        def kill(self):self.returncode=-signal.SIGKILL
                        def wait(self,timeout: float):return self.returncode
                    class FaultTimeoutExpired(Exception):pass
                    class FaultSubprocess:
                        PIPE=object();DEVNULL=object();TimeoutExpired=FaultTimeoutExpired
                        CompletedProcess=subprocess.CompletedProcess
                        @staticmethod
                        def Popen(argv: list[str],**_kwargs: object) -> FaultProcess:
                            process=FaultProcess(len(fault_processes),argv)
                            fault_processes.append(process);return process
                    class FaultOS:
                        environ=os.environ
                        @staticmethod
                        def killpg(pid: int,requested_signal: int) -> None:
                            fault_signals.append((pid,requested_signal))
                            process=next(item for item in fault_processes if item.pid==pid)
                            process.returncode=-requested_signal
                    fault_function=copy.deepcopy(function)
                    fault_function.name="r15_parallel_cli_post_reap_fault"
                    ast.fix_missing_locations(fault_function)
                    fault_namespace={
                        "__name__":"r26_post_reap_fault","Path":Path,"Rig":Rig,
                        "fcntl":fcntl,"os":FaultOS,"select":select,"signal":signal,"stat":stat,
                        "subprocess":FaultSubprocess,"sys":sys,"time":time,
                    }
                    exec(compile(ast.Module(body=[fault_function],type_ignores=[]),
                                 "<r26-post-reap-fault>","exec"),fault_namespace,fault_namespace)
                    try:
                        fault_namespace["r15_parallel_cli_post_reap_fault"](
                            root,[("unused-a",[],None),("unused-b",[],None)])
                        fault_error="NO_REJECTION"
                    except Rig as exc:fault_error=str(exc)
                    fault_rows.append((exception_type.__name__,fault_error,list(fault_signals),
                                       [item.communicate_calls for item in fault_processes],
                                       [item.returncode for item in fault_processes]))
                post_reap_pipe_ok=all(
                    row[1].count("pipe_drain[0]=post-reap")==1
                    and "cleanup reentry" not in row[1]
                    and row[2]==[(6102,signal.SIGKILL)]
                    and row[3]==[1,1] and row[4]==[0,-signal.SIGKILL]
                    for row in fault_rows)
                reverse_detail=repr((reverse_rows,decode_error,fault_rows))
        except (OSError,ValueError,TypeError,KeyError,Rig) as exc:
            reverse_detail=str(exc)
    check(reverse_ok,
          "J_R26_POST_RELEASE_REVERSE_COMPLETION_ORDER_STABLE_TIMEOUT_AND_DIAGNOSTICS",
          reverse_detail)
    check(decode_ok,
          "J_R26_CLEANUP_DECODE_FAILURE_SINGLE_EPOCH_NO_REAPED_PGID_RESIGNAL",
          reverse_detail)
    check(post_reap_pipe_ok,
          "J_R26_POST_REAP_OSERROR_VALUEERROR_EXCLUDE_RELEASED_PGID_FROM_CLEANUP",
          reverse_detail)


