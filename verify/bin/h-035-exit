    mutant=clone(); mutant["operational_matrix"]["global_denied_list_entry_consumers"]="VALIDATE_TASK_ONLY"; scope_mutants.append(mutant)
    mutant=clone(); mutant["operational_matrix"]["non_owner_list_causal_isolation"]="OVERLAPPING_FIXTURES"; scope_mutants.append(mutant)
