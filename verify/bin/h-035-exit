def validate_registry(doc: object) -> tuple[bool, str]:
    if not isinstance(doc, dict): return False, "top-level type"
    if set(doc) != REG_KEYS: return False, "top-level membership"
    version = doc.get("schema_version")
    if type(version) is not int or version not in (1, 2): return False, "schema version"
    if doc.get("path_grammar") != "repo-tree-exact-or-terminal-recursive-prefix-v1": return False, "grammar"
    if doc.get("authority_source") != "git-candidate-plus-independent-gate-review-plus-owner-final-freeze": return False, "authority source"
    if doc.get("self_digest_is_authority") is not False: return False, "self digest"
    for key in ("owner_production_paths", "prospective_ordinary_protected_paths", "owner_author_global_denied_paths"):
        value = doc.get(key)
        if not isinstance(value, list) or not value or not all(isinstance(x, str) for x in value):
            return False, f"{key} type/empty"
        try: canon = [parse_path(x) for x in value]
        except ValueError as e: return False, f"{key} path {e}"
        if len(canon) != len(set(canon)): return False, f"{key} duplicate"
    required = REQUIRED_OWNER if version == 1 else PROSPECTIVE_OWNER
    if set(doc["owner_production_paths"]) != required: return False, "version-bound owner membership"
    return True, "ok"


def registry_selftests(good: dict[str, object]) -> None:
    ok, why = validate_registry(good); check(ok, "J_REGISTRY_POSITIVE", why)
    current = json.loads(json.dumps(good))
    current["schema_version"] = 1
    current["owner_production_paths"] = list(H034_OWNER_PATHS)
    prospective = json.loads(json.dumps(good))
    prospective["schema_version"] = 2
    prospective["owner_production_paths"] = [*H034_OWNER_PATHS, *H036_OWNER_PATHS]
    current_reordered = json.loads(json.dumps(current))
    current_reordered["owner_production_paths"] = list(reversed(current_reordered["owner_production_paths"]))
    reordered = json.loads(json.dumps(prospective))
    reordered["owner_production_paths"] = list(reversed(reordered["owner_production_paths"]))
    ok, why = validate_registry(current); check(ok, "J_R14_REGISTRY_V1_CURRENT_POSITIVE", why)
    ok, why = validate_registry(current_reordered); check(ok, "J_R14_REGISTRY_V1_REORDERED_EXACT_SET_POSITIVE", why)
    ok, why = validate_registry(prospective); check(ok, "J_R14_REGISTRY_V2_PROSPECTIVE_POSITIVE", why)
    ok, why = validate_registry(reordered); check(ok, "J_R14_REGISTRY_V2_REORDERED_EXACT_SET_POSITIVE", why)
    mutants: list[tuple[str, object]] = []
    for name, mutate in (
        ("MISSING_KEY", lambda d: d.pop("path_grammar")),
        ("UNEXPECTED_KEY", lambda d: d.update(extra=[])),
        ("WRONG_VERSION_STATE_PAIR", lambda d: d.update(schema_version=2)),
        ("WRONG_LIST_TYPE", lambda d: d.update(owner_production_paths={})),
        ("EMPTY_LIST", lambda d: d.update(owner_production_paths=[])),
        ("DUPLICATE_PATH", lambda d: d.update(owner_production_paths=list(d["owner_production_paths"])+[d["owner_production_paths"][0]])),
        ("MALFORMED_PATH", lambda d: d.update(owner_production_paths=["../escape"])),
        ("REQUIRED_REMOVED", lambda d: d.update(owner_production_paths=list(d["owner_production_paths"])[1:])),
        ("REQUIRED_ALTERED", lambda d: d.update(owner_production_paths=["controller/h034-native/*", *list(d["owner_production_paths"])[1:]])),
    ):
        copy = json.loads(json.dumps(current)); mutate(copy); mutants.append((name, copy))
    for name, mutant in mutants:
        accepted, _ = validate_registry(mutant)
        check(not accepted, f"J_REGISTRY_{name}")
    try:
        json.loads('{"schema_version":1,"schema_version":1}', object_pairs_hook=lambda p: (_ for _ in ()).throw(ValueError("duplicate")) if len({k for k,_ in p}) != len(p) else dict(p))
        duplicate_rejected = False
    except ValueError: duplicate_rejected = True
    check(duplicate_rejected, "J_REGISTRY_DUPLICATE_KEY")
    r14_mutants: list[dict[str, object]] = []
    for index in range(len(H036_OWNER_PATHS)):
        mutant = json.loads(json.dumps(prospective)); del mutant["owner_production_paths"][len(H034_OWNER_PATHS) + index]
        r14_mutants.append(mutant)
    for value in (
        "controller/launch/other.py", "controller/launch/**", "controller/**", "config/**",
        "controller\\launch\\cli", "./controller/launch/cli",
    ):
        mutant = json.loads(json.dumps(prospective)); mutant["owner_production_paths"][-3] = value
        r14_mutants.append(mutant)
    for version in (0, 3, True, 1.0, 2.0):
        mutant = json.loads(json.dumps(prospective)); mutant["schema_version"] = version
        r14_mutants.append(mutant)
    mutant = json.loads(json.dumps(prospective)); mutant["owner_production_paths"].append(H036_OWNER_PATHS[0]); r14_mutants.append(mutant)
    mutant = json.loads(json.dumps(prospective)); mutant["owner_production_paths"][0] = "controller/h034-native/kernel.c"; r14_mutants.append(mutant)
    mutant = json.loads(json.dumps(prospective)); mutant["owner_production_paths"].append("verify/h036/neighbor"); r14_mutants.append(mutant)
    mutant = json.loads(json.dumps(prospective)); mutant["schema_version"] = 1; r14_mutants.append(mutant)
    check(all(not validate_registry(mutant)[0] for mutant in r14_mutants),
          "J_R14_REGISTRY_PARTIAL_MIXED_ARBITRARY_MISSING_SUBSTITUTED_BROADER_DUPLICATE_ALIAS_REJECT")


def path_selftests() -> None:
    bad = ["", "/x", "C:/x", "./x", "x//y", "x/../y", "x/./y", "x/", "x/*", "x/**/y", "../x"]
    check(all(_bad_path(x) for x in bad), "J_PATH_REJECT_FAMILY")
    check(parse_path(r"a\b\c") == ("a/b/c", False), "J_PATH_BACKSLASH_NORMALIZED")
    check(overlap("controller/**", "controller/h034-native/kernel.c"), "J_PATH_PARENT")
    check(overlap("controller/h034-native/**", "controller/h034-native/kernel.c"), "J_PATH_CHILD")
    check(not overlap("safe/**", "controller/h034-native/**"), "J_PATH_SIBLING")
    # Predicted outcome: each superficial implementation is rejected by real acceptance below.
    for mutant, guard in (
        ("HARDCODE_PROBE_NAMES", "A_OWNER_ROUTE"),
        ("PERMISSIVE_REGISTRY_CONSUMER", "N_REGISTRY_RUNTIME"),
        ("DOCS_IMPACT_ESCALATION", "N_DOCS_IMPACT"),
        ("RESTART_LAUNCHES_BUILDER", "A_OWNER_RESTART"),
        ("REVIEW_AUTO_PUBLISH", "N_REVIEW_PUBLICATION"),
        ("AUTOPILOT_OLD_MATCHER", "N_PATH_CONSISTENCY"),
    ):
        print(f"MUTANT={mutant} PREDICTED=REJECT GUARD={guard}")


def _bad_path(value: str) -> bool:
    try: parse_path(value); return False
    except ValueError: return True


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")


def git(cwd: Path, *args: str) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd=cwd)


def r15_git(cwd: Path, *args: str) -> subprocess.CompletedProcess:
    """Raw R15 observation boundary: absolute Git, no replacements or ambient authority."""
    env = {
        "HOME":"/private/var/empty", "XDG_CONFIG_HOME":"/private/var/empty",
        "PATH":"/usr/bin:/bin", "LANG":"C", "LC_ALL":"C",
        "GIT_CONFIG_NOSYSTEM":"1", "GIT_CONFIG_GLOBAL":"/dev/null",
        "GIT_CONFIG_SYSTEM":"/dev/null", "GIT_ATTR_NOSYSTEM":"1",
        "GIT_TERMINAL_PROMPT":"0", "GIT_PAGER":"cat",
        "GIT_OPTIONAL_LOCKS":"0", "GIT_NO_LAZY_FETCH":"1", "TMPDIR":r15_private_tmpdir(),
        "DARWIN_USER_TEMP_DIR":r15_private_tmpdir(),
    }
    return subprocess.run(
        ["/usr/bin/git", "--no-replace-objects",
         "-c", "core.attributesFile=/dev/null", "-c", "core.hooksPath=/dev/null",
         "-c", "diff.external=", "-c", "pager.diff=false", "-C", str(cwd), *args],
        cwd=cwd, env=env, text=True, capture_output=True, shell=False,
        check=False, timeout=45,
    )


def r15_git_bytes(cwd: Path, *args: str,
                  stdin: bytes | None = None) -> subprocess.CompletedProcess:
    env = {
        "HOME":"/private/var/empty", "XDG_CONFIG_HOME":"/private/var/empty",
        "PATH":"/usr/bin:/bin", "LANG":"C", "LC_ALL":"C",
        "GIT_CONFIG_NOSYSTEM":"1", "GIT_CONFIG_GLOBAL":"/dev/null",
        "GIT_CONFIG_SYSTEM":"/dev/null", "GIT_ATTR_NOSYSTEM":"1",
        "GIT_TERMINAL_PROMPT":"0", "GIT_PAGER":"cat",
        "GIT_OPTIONAL_LOCKS":"0", "GIT_NO_LAZY_FETCH":"1", "TMPDIR":r15_private_tmpdir(),
        "DARWIN_USER_TEMP_DIR":r15_private_tmpdir(),
    }
    return subprocess.run(
        ["/usr/bin/git", "--no-replace-objects",
         "-c", "core.attributesFile=/dev/null", "-c", "core.hooksPath=/dev/null",
         "-c", "diff.external=", "-c", "pager.diff=false", "-C", str(cwd), *args],
        cwd=cwd, env=env, input=stdin, capture_output=True, shell=False,
        check=False, timeout=45,
    )


def r15_git_object_bytes(repo: Path, sha: str, path: str) -> bytes | None:
    result = r15_git_bytes(repo, "cat-file", "blob", f"{sha}:{path}")
    return result.stdout if result.returncode == 0 else None


def r15_private_tmpdir() -> str:
    path=R15_INITIAL_TMPDIR
    if not path.is_absolute() or Path(os.path.normpath(str(path)))!=path:
        raise Rig("R15 private TMPDIR path")
    cursor=Path(path.anchor)
    for part in path.parts[1:]:
        cursor/=part;info=os.lstat(cursor)
        if stat.S_ISLNK(info.st_mode):raise Rig("R15 private TMPDIR symlink")
    info=os.lstat(path)
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid!=os.getuid()
            or stat.S_IMODE(info.st_mode)!=0o700):
        raise Rig("R15 private TMPDIR identity")
    return str(path)


def r15_nofollow_components(path: Path, *, leaf_directory: bool | None = None) -> tuple[bool, str]:
    """Reject every symlink component and optionally bind the leaf type."""
    if not path.is_absolute(): return False, "path is not absolute"
    cursor=Path(path.anchor)
    try:
        for part in path.parts[1:]:
            cursor=cursor/part
            info=os.lstat(cursor)
            if stat.S_ISLNK(info.st_mode): return False, f"symlink component {cursor}"
        if leaf_directory is not None:
            info=os.lstat(path)
            if leaf_directory != stat.S_ISDIR(info.st_mode):
                return False, "leaf type"
    except OSError as exc:
        return False, f"component inspection: {exc}"
    return True, "nofollow components"


def r15_stable_regular_bytes(path: Path, *, max_bytes: int = 65536,
                             modes: tuple[int,...] = (0o600,0o644),
                             current_uid: bool = True) -> tuple[bytes,os.stat_result]:
    """Retained-dirfd, nofollow, bounded regular-file authority read."""
    if (not path.is_absolute() or Path(os.path.normpath(str(path))) != path
            or str(path).startswith("//")):
        raise Rig("artifact path is not exact canonical absolute authority")
    directory_flags=(os.O_RDONLY|getattr(os,"O_CLOEXEC",0)
                     |getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_DIRECTORY",0))
    file_flags=(os.O_RDONLY|getattr(os,"O_CLOEXEC",0)
                |getattr(os,"O_NOFOLLOW",0)|getattr(os,"O_NONBLOCK",0))
    descriptors=[]; links=[]; descriptor=-1
    try:
        parent_fd=os.open(path.anchor,directory_flags); descriptors.append(parent_fd)
        for component in path.parts[1:-1]:
            before_component=os.stat(
                component,dir_fd=parent_fd,follow_symlinks=False)
            child_fd=os.open(component,directory_flags,dir_fd=parent_fd)
            opened_component=os.fstat(child_fd)
            if (not stat.S_ISDIR(opened_component.st_mode)
                    or (before_component.st_dev,before_component.st_ino,
                        before_component.st_mode)
                    != (opened_component.st_dev,opened_component.st_ino,
                        opened_component.st_mode)):
                os.close(child_fd); raise Rig("artifact ancestor changed before open")
            links.append((parent_fd,component,child_fd,opened_component))
            descriptors.append(child_fd);parent_fd=child_fd
        leaf=path.name
        before=os.stat(leaf,dir_fd=parent_fd,follow_symlinks=False)
        if (not stat.S_ISREG(before.st_mode)
                or (current_uid and before.st_uid != os.getuid())
                or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) not in modes
                or before.st_size > max_bytes):
            raise Rig("unsafe artifact leaf")
        descriptor=os.open(leaf,file_flags,dir_fd=parent_fd)
        opened=os.fstat(descriptor)
        if tuple(getattr(opened,key) for key in (
                "st_dev","st_ino","st_mode","st_uid","st_nlink","st_size",
                "st_mtime_ns","st_ctime_ns")) != tuple(getattr(before,key) for key in (
                "st_dev","st_ino","st_mode","st_uid","st_nlink","st_size",
                "st_mtime_ns","st_ctime_ns")):
            raise Rig("artifact changed before open")
        chunks=[]; total=0
        while True:
            chunk=os.read(descriptor,min(65536,max_bytes+1-total))
            if not chunk: break
            chunks.append(chunk); total += len(chunk)
            if total > max_bytes: raise Rig("artifact exceeds bound")
        final_fd=os.fstat(descriptor)
        final_leaf=os.stat(leaf,dir_fd=parent_fd,follow_symlinks=False)
        final_path=os.lstat(path)
        fields=("st_dev","st_ino","st_mode","st_uid","st_nlink","st_size",
                "st_mtime_ns","st_ctime_ns")
        if (tuple(getattr(final_fd,key) for key in fields)
                != tuple(getattr(opened,key) for key in fields)
                or tuple(getattr(final_leaf,key) for key in fields)
                != tuple(getattr(opened,key) for key in fields)
                or tuple(getattr(final_path,key) for key in fields)
                != tuple(getattr(opened,key) for key in fields)):
            raise Rig("artifact changed during read")
        for retained_parent,component,child_fd,initial in links:
            linked=os.stat(component,dir_fd=retained_parent,follow_symlinks=False)
            final_child=os.fstat(child_fd)
            expected=(initial.st_dev,initial.st_ino,initial.st_mode)
            if ((linked.st_dev,linked.st_ino,linked.st_mode)!=expected
                    or (final_child.st_dev,final_child.st_ino,final_child.st_mode)!=expected):
                raise Rig("artifact ancestor changed during read")
    finally:
        if descriptor >= 0: os.close(descriptor)
        for retained in reversed(descriptors): os.close(retained)
    raw=b"".join(chunks)
    return raw,opened


def r15_safe_artifact(path: Path, *, max_bytes: int = 65536) -> tuple[object, bytes, str]:
    """Stable bounded JSON artifact read used by identity and fixture oracles."""
    raw,_identity=r15_stable_regular_bytes(path,max_bytes=max_bytes)
    value=strict_json_bytes(raw)
    return value,raw,hashlib.sha256(raw).hexdigest()


def r15_admin_paths(repo: Path) -> tuple[Path,Path,Path]:
    dot=repo/".git";info=os.lstat(dot)
    if stat.S_ISDIR(info.st_mode):
        git_dir=dot
    elif stat.S_ISREG(info.st_mode):
        raw,_=r15_stable_regular_bytes(dot,max_bytes=4096)
        try:text=raw.decode("utf-8",errors="strict")
        except UnicodeError as exc: raise Rig("Git admin file UTF-8") from exc
        if not text.startswith("gitdir: ") or text.count("\n")!=1 or not text.endswith("\n"):
            raise Rig("Git admin file shape")
        git_dir=Path(text[8:-1])
        if not git_dir.is_absolute():git_dir=repo/git_dir
    else: raise Rig(".git authority type")
    git_dir=git_dir.resolve(strict=True)
    ok,why=r15_nofollow_components(git_dir,leaf_directory=True)
    if not ok:raise Rig("Git admin directory "+why)
    commondir=git_dir/"commondir"
    try:os.lstat(commondir)
    except FileNotFoundError:common=git_dir
    else:
        raw,_=r15_stable_regular_bytes(commondir,max_bytes=4096)
        try:text=raw.decode("utf-8",errors="strict")
        except UnicodeError as exc:raise Rig("Git common-dir UTF-8") from exc
        if not text.endswith("\n") or text.count("\n")!=1 or not text[:-1]:
            raise Rig("Git common-dir file shape")
        common=Path(text[:-1]);common=(common if common.is_absolute() else git_dir/common)
        common=common.resolve(strict=True)
    ok,why=r15_nofollow_components(common,leaf_directory=True)
    if not ok:raise Rig("Git common directory "+why)
    return git_dir,common,common/"config"


def r15_local_config_snapshot(repo: Path) -> tuple[Path,bytes,os.stat_result,str]:
    git_dir,common,config_path=r15_admin_paths(repo)
    for worktree_config in {git_dir/"config.worktree",common/"config.worktree"}:
        try:os.lstat(worktree_config)
        except FileNotFoundError:pass
        except OSError as exc:raise Rig("active worktree config observation") from exc
        else:raise Rig("active config.worktree forbidden")
    raw,identity=r15_stable_regular_bytes(config_path,max_bytes=1024*1024)
    env={"HOME":"/private/var/empty","XDG_CONFIG_HOME":"/private/var/empty",
         "PATH":"/usr/bin:/bin","LANG":"C","LC_ALL":"C",
         "GIT_CONFIG_NOSYSTEM":"1","GIT_CONFIG_GLOBAL":"/dev/null",
         "GIT_CONFIG_SYSTEM":"/dev/null","GIT_ATTR_NOSYSTEM":"1",
         "GIT_TERMINAL_PROMPT":"0","GIT_PAGER":"cat","GIT_OPTIONAL_LOCKS":"0"}
    parsed=subprocess.run(
        ["/usr/bin/git","config","--no-includes","--file","-","--null","--list"],
        cwd=Path("/private/var/empty"),env=env,input=raw,capture_output=True,
        shell=False,check=False,timeout=45)
    if parsed.returncode:raise Rig("cannot parse stable local config")
    try:entries=parsed.stdout.decode("utf-8",errors="strict").split("\0")
    except UnicodeError as exc:raise Rig("local config output UTF-8") from exc
    values: dict[str,list[str]]={};forbidden=[]
    allowed={"core.repositoryformatversion","core.filemode","core.bare",
             "core.logallrefupdates","core.ignorecase","core.precomposeunicode",
             "user.name","user.email","remote.origin.url","remote.origin.fetch"}
    for entry in entries:
        if not entry:continue
        key,separator,value=entry.partition("\n");key=key.lower()
        if not separator:raise Rig("local config entry shape")
        values.setdefault(key,[]).append(value)
        branch=re.fullmatch(r"branch\.([^.]+)\.(remote|merge|vscode-merge-base)",key)
        if key not in allowed and branch is None:
            forbidden.append(key)
    if forbidden:raise Rig(f"unsafe local config {forbidden}")
    if values.get("core.repositoryformatversion") != ["0"]:
        raise Rig("repository format must be exact version zero")
    if values.get("remote.origin.fetch") != ["+refs/heads/*:refs/remotes/origin/*"]:
        raise Rig("origin fetch refspec")
    if any(len(rows)!=1 for key,rows in values.items()
           if key in allowed and key!="remote.origin.url"):
        raise Rig("local config singleton")
    for key,rows in values.items():
        branch=re.fullmatch(r"branch\.([^.]+)\.(remote|merge|vscode-merge-base)",key)
        if branch is None:continue
        if (len(rows)!=1 or (branch.group(2)=="remote" and rows[0]!="origin")
                or (branch.group(2)=="merge" and not re.fullmatch(r"refs/heads/[^\s]+",rows[0]))
                or (branch.group(2)=="vscode-merge-base" and rows[0]!="origin/main")):
            raise Rig("branch config grammar")
    urls=values.get("remote.origin.url",[])
    if len(urls)!=1 or not urls[0] or "\x00" in urls[0]:raise Rig("origin URL cardinality")
    after,after_identity=r15_stable_regular_bytes(config_path,max_bytes=1024*1024)
    fields=("st_dev","st_ino","st_mode","st_uid","st_nlink","st_size",
            "st_mtime_ns","st_ctime_ns")
    if (after!=raw or tuple(getattr(after_identity,key) for key in fields)
            != tuple(getattr(identity,key) for key in fields)):
        raise Rig("local Git config changed during derivation")
    return config_path,raw,identity,urls[0]


def r15_local_config_safe(repo: Path) -> tuple[bool, str]:
    try:_path,_raw,_identity,origin=r15_local_config_snapshot(repo)
    except (OSError,ValueError,Rig) as exc:return False,str(exc)
    return True,origin


def r15_retained_known_hosts(path: Path) -> dict[str,object]:
    if (not path.is_absolute() or Path(os.path.normpath(str(path)))!=path
            or str(path).startswith("//")):
        raise Rig("known-hosts path authority")
    flags=os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC
    fds=[];links=[];copy_root_fds=[];copy_root_links=[]
    leaf_fd=-1;copy_root_fd=-1;copy_dir_fd=-1;copy_fd=-1
    copy_dir_name=None;copy_dir_created=False
    try:
        parent=os.open(path.anchor,flags);fds.append(parent)
        for part in path.parts[1:-1]:
            before=os.stat(part,dir_fd=parent,follow_symlinks=False)
            child=os.open(part,flags,dir_fd=parent);opened=os.fstat(child)
            if (not stat.S_ISDIR(opened.st_mode)
                    or (before.st_dev,before.st_ino,before.st_mode)
                    != (opened.st_dev,opened.st_ino,opened.st_mode)):
                raise Rig("known-hosts ancestor race")
            links.append((parent,part,child,(opened.st_dev,opened.st_ino,opened.st_mode)))
            fds.append(child);parent=child
        name=path.name;before=os.stat(name,dir_fd=parent,follow_symlinks=False)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid!=os.getuid()
                or before.st_nlink!=1 or stat.S_IMODE(before.st_mode) not in (0o600,0o644)
                or before.st_size>1024*1024):
            raise Rig("unsafe SSH known-host authority")
        leaf_fd=os.open(name,os.O_RDONLY|os.O_NONBLOCK|os.O_NOFOLLOW|os.O_CLOEXEC,
                        dir_fd=parent)
        opened=os.fstat(leaf_fd)
        before_identity=(before.st_dev,before.st_ino,before.st_mode,before.st_uid,
                         before.st_nlink,before.st_size,before.st_mtime_ns,before.st_ctime_ns)
        opened_identity=(opened.st_dev,opened.st_ino,opened.st_mode,opened.st_uid,
                         opened.st_nlink,opened.st_size,opened.st_mtime_ns,opened.st_ctime_ns)
        if before_identity!=opened_identity:raise Rig("known-hosts open race")
        raw=b""
        while len(raw)<opened.st_size:
            part=os.pread(leaf_fd,min(65536,opened.st_size-len(raw)),len(raw))
            if not part:raise Rig("known-hosts short read")
            raw+=part
        after_read=os.fstat(leaf_fd)
        after_named=os.stat(name,dir_fd=parent,follow_symlinks=False)
        if (len(raw)!=opened.st_size
                or (after_read.st_dev,after_read.st_ino,after_read.st_mode,after_read.st_uid,
                    after_read.st_nlink,after_read.st_size,after_read.st_mtime_ns,
                    after_read.st_ctime_ns)!=opened_identity
                or (after_named.st_dev,after_named.st_ino,after_named.st_mode,
                    after_named.st_uid,after_named.st_nlink,after_named.st_size,
                    after_named.st_mtime_ns,after_named.st_ctime_ns)!=opened_identity):
            raise Rig("known-hosts changed during exact read")
        source_digest=hashlib.sha256(raw).hexdigest()
        copy_root_path=r15_private_tmpdir()
        if (not re.fullmatch(r"/[A-Za-z0-9._/-]+",copy_root_path)
                or Path(os.path.normpath(copy_root_path))!=Path(copy_root_path)):
            raise Rig("known-hosts copy root grammar")
        copy_root=Path(copy_root_path)
        copy_parent=os.open(copy_root.anchor,flags);copy_root_fds.append(copy_parent)
        for part in copy_root.parts[1:]:
            root_before=os.stat(part,dir_fd=copy_parent,follow_symlinks=False)
            root_child=os.open(part,flags,dir_fd=copy_parent);root_opened=os.fstat(root_child)
            if (not stat.S_ISDIR(root_opened.st_mode)
                    or (root_before.st_dev,root_before.st_ino,root_before.st_mode)
                    !=(root_opened.st_dev,root_opened.st_ino,root_opened.st_mode)):
                raise Rig("known-hosts copy root ancestor race")
            copy_root_links.append((copy_parent,part,root_child,
                                    (root_opened.st_dev,root_opened.st_ino,root_opened.st_mode)))
            copy_root_fds.append(root_child);copy_parent=root_child
        copy_root_fd=copy_parent;copy_root_named=os.lstat(copy_root_path)
        copy_root_open=os.fstat(copy_root_fd)
        copy_root_identity=(copy_root_open.st_dev,copy_root_open.st_ino,
                            copy_root_open.st_mode,copy_root_open.st_uid)
        if ((copy_root_named.st_dev,copy_root_named.st_ino,copy_root_named.st_mode,
             copy_root_named.st_uid)!=copy_root_identity
                or not stat.S_ISDIR(copy_root_open.st_mode)
                or copy_root_open.st_uid!=os.getuid()
                or stat.S_IMODE(copy_root_open.st_mode)!=0o700):
            raise Rig("known-hosts copy root authority")
        copy_dir_name="r15-known-hosts-"+secrets.token_hex(16)
        os.mkdir(copy_dir_name,0o700,dir_fd=copy_root_fd);copy_dir_created=True
        copy_dir_path=os.path.join(copy_root_path,copy_dir_name)
        copy_dir_fd=os.open(copy_dir_name,flags,dir_fd=copy_root_fd)
        copy_name="known_hosts";copy_path=os.path.join(copy_dir_path,copy_name)
        if (not re.fullmatch(r"/[A-Za-z0-9._/-]+",copy_path)
                or Path(os.path.normpath(copy_path))!=Path(copy_path)):
            raise Rig("known-hosts copy path grammar")
        copy_fd=os.open(copy_name,os.O_RDWR|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW
                        |os.O_CLOEXEC,0o600,dir_fd=copy_dir_fd)
        offset=0
        while offset<len(raw):
            written=os.write(copy_fd,raw[offset:])
            if written<=0:raise Rig("known-hosts copy short write")
            offset+=written
        os.fsync(copy_fd)
        copy_open=os.fstat(copy_fd)
        copy_named=os.stat(copy_name,dir_fd=copy_dir_fd,follow_symlinks=False)
        copy_absolute=os.lstat(copy_path)
        copy_identity=(copy_open.st_dev,copy_open.st_ino,copy_open.st_mode,
                       copy_open.st_uid,copy_open.st_nlink,copy_open.st_size,
                       copy_open.st_mtime_ns,copy_open.st_ctime_ns)
        if ((copy_named.st_dev,copy_named.st_ino,copy_named.st_mode,copy_named.st_uid,
             copy_named.st_nlink,copy_named.st_size,copy_named.st_mtime_ns,
             copy_named.st_ctime_ns)!=copy_identity
                or (copy_absolute.st_dev,copy_absolute.st_ino,copy_absolute.st_mode,
                    copy_absolute.st_uid,copy_absolute.st_nlink,copy_absolute.st_size,
                    copy_absolute.st_mtime_ns,copy_absolute.st_ctime_ns)!=copy_identity
                or not stat.S_ISREG(copy_open.st_mode) or copy_open.st_uid!=os.getuid()
                or copy_open.st_nlink!=1 or stat.S_IMODE(copy_open.st_mode)!=0o600
                or copy_open.st_size!=len(raw)
                or hashlib.sha256(os.pread(copy_fd,1024*1024+1,0)).hexdigest()!=source_digest):
            raise Rig("known-hosts copy authority")
        copy_dir_named=os.stat(copy_dir_name,dir_fd=copy_root_fd,follow_symlinks=False)
        copy_dir_open=os.fstat(copy_dir_fd);copy_dir_absolute=os.lstat(copy_dir_path)
        copy_dir_identity=(copy_dir_open.st_dev,copy_dir_open.st_ino,
                           copy_dir_open.st_mode,copy_dir_open.st_uid,copy_dir_open.st_nlink)
        if ((copy_dir_named.st_dev,copy_dir_named.st_ino,copy_dir_named.st_mode,
             copy_dir_named.st_uid,copy_dir_named.st_nlink)!=copy_dir_identity
                or (copy_dir_absolute.st_dev,copy_dir_absolute.st_ino,
                    copy_dir_absolute.st_mode,copy_dir_absolute.st_uid,
                    copy_dir_absolute.st_nlink)!=copy_dir_identity
                or not stat.S_ISDIR(copy_dir_open.st_mode)
                or copy_dir_open.st_uid!=os.getuid()
                or stat.S_IMODE(copy_dir_open.st_mode)!=0o700
                or os.listdir(copy_dir_fd)!=[copy_name]):
            raise Rig("known-hosts copy directory authority")
        return {"path":path,"fd":leaf_fd,"parents":fds,"links":links,
                "identity":opened_identity,"sha256":source_digest,
                "copy_root_path":copy_root_path,"copy_root_fd":copy_root_fd,
                "copy_root_fds":copy_root_fds,"copy_root_links":copy_root_links,
                "copy_root_identity":copy_root_identity,"copy_dir_name":copy_dir_name,
                "copy_dir_path":copy_dir_path,"copy_dir_fd":copy_dir_fd,
                "copy_dir_identity":copy_dir_identity,"copy_name":copy_name,
                "copy_path":copy_path,"copy_fd":copy_fd,"copy_identity":copy_identity}
    except Exception:
        if copy_fd>=0:os.close(copy_fd)
        if copy_dir_fd>=0:
            try:os.unlink("known_hosts",dir_fd=copy_dir_fd)
            except OSError:pass
            os.close(copy_dir_fd)
        if copy_dir_created and copy_root_fd>=0 and isinstance(copy_dir_name,str):
            try:os.rmdir(copy_dir_name,dir_fd=copy_root_fd)
            except OSError:pass
        for descriptor in reversed(copy_root_fds):os.close(descriptor)
        if leaf_fd>=0:os.close(leaf_fd)
        for descriptor in reversed(fds):os.close(descriptor)
        raise


def r15_validate_retained_known_hosts(handle: dict[str,object]) -> None:
    path=handle["path"];leaf_fd=handle["fd"];links=handle["links"]
    if not isinstance(path,Path) or not isinstance(leaf_fd,int) or not isinstance(links,list):
        raise Rig("known-hosts retained handle")
    final=os.fstat(leaf_fd);final_path=os.lstat(path)
    if ((final.st_dev,final.st_ino,final.st_mode,final.st_uid,final.st_nlink,
         final.st_size,final.st_mtime_ns,final.st_ctime_ns)!=handle["identity"]
            or (final_path.st_dev,final_path.st_ino,final_path.st_mode,final_path.st_uid,
                final_path.st_nlink,final_path.st_size,final_path.st_mtime_ns,
                final_path.st_ctime_ns)!=handle["identity"]
            ):
        raise Rig("known-hosts identity changed")
    source_raw=b""
    while len(source_raw)<final.st_size:
        part=os.pread(leaf_fd,min(65536,final.st_size-len(source_raw)),len(source_raw))
        if not part:raise Rig("known-hosts validation short read")
        source_raw+=part
    source_after=os.fstat(leaf_fd);source_path_after=os.lstat(path)
    if (len(source_raw)!=final.st_size
            or (source_after.st_dev,source_after.st_ino,source_after.st_mode,
                source_after.st_uid,source_after.st_nlink,source_after.st_size,
                source_after.st_mtime_ns,source_after.st_ctime_ns)!=handle["identity"]
            or (source_path_after.st_dev,source_path_after.st_ino,source_path_after.st_mode,
                source_path_after.st_uid,source_path_after.st_nlink,source_path_after.st_size,
                source_path_after.st_mtime_ns,source_path_after.st_ctime_ns)!=handle["identity"]
            or hashlib.sha256(source_raw).hexdigest()!=handle["sha256"]):
        raise Rig("known-hosts exact bytes changed")
    for parent,part,child,want in links:
        linked=os.stat(part,dir_fd=parent,follow_symlinks=False);opened=os.fstat(child)
        if ((linked.st_dev,linked.st_ino,linked.st_mode)!=want
                or (opened.st_dev,opened.st_ino,opened.st_mode)!=want):
            raise Rig("known-hosts ancestor changed")
    copy_root_path=handle["copy_root_path"];copy_root_fd=handle["copy_root_fd"]
    copy_root_fds=handle["copy_root_fds"];copy_root_links=handle["copy_root_links"]
    copy_dir_name=handle["copy_dir_name"];copy_dir_path=handle["copy_dir_path"]
    copy_dir_fd=handle["copy_dir_fd"];copy_name=handle["copy_name"]
    copy_path=handle["copy_path"];copy_fd=handle["copy_fd"]
    if (not isinstance(copy_root_path,str) or not isinstance(copy_root_fd,int)
            or not isinstance(copy_root_fds,list) or not isinstance(copy_root_links,list)
            or not isinstance(copy_dir_name,str) or not isinstance(copy_dir_path,str)
            or not isinstance(copy_dir_fd,int) or copy_name!="known_hosts"
            or not isinstance(copy_path,str) or not isinstance(copy_fd,int)
            or not re.fullmatch(r"/[A-Za-z0-9._/-]+",copy_path)
            or Path(os.path.normpath(copy_path))!=Path(copy_path)
            or copy_path!=os.path.join(copy_dir_path,copy_name)
            or copy_dir_path!=os.path.join(copy_root_path,copy_dir_name)):
        raise Rig("known-hosts copy handle")
    copy_root_named=os.lstat(copy_root_path);copy_root_open=os.fstat(copy_root_fd)
    if ((copy_root_named.st_dev,copy_root_named.st_ino,copy_root_named.st_mode,
         copy_root_named.st_uid)!=handle["copy_root_identity"]
            or (copy_root_open.st_dev,copy_root_open.st_ino,copy_root_open.st_mode,
                copy_root_open.st_uid)!=handle["copy_root_identity"]
            or not stat.S_ISDIR(copy_root_open.st_mode)
            or copy_root_open.st_uid!=os.getuid()
            or stat.S_IMODE(copy_root_open.st_mode)!=0o700):
        raise Rig("known-hosts copy root changed")
    for parent,part,child,want in copy_root_links:
        linked=os.stat(part,dir_fd=parent,follow_symlinks=False);opened=os.fstat(child)
        if ((linked.st_dev,linked.st_ino,linked.st_mode)!=want
                or (opened.st_dev,opened.st_ino,opened.st_mode)!=want):
            raise Rig("known-hosts copy root ancestor changed")
    copy_dir_named=os.stat(copy_dir_name,dir_fd=copy_root_fd,follow_symlinks=False)
    copy_dir_open=os.fstat(copy_dir_fd);copy_dir_absolute=os.lstat(copy_dir_path)
    if ((copy_dir_named.st_dev,copy_dir_named.st_ino,copy_dir_named.st_mode,
         copy_dir_named.st_uid,copy_dir_named.st_nlink)!=handle["copy_dir_identity"]
            or (copy_dir_open.st_dev,copy_dir_open.st_ino,copy_dir_open.st_mode,
                copy_dir_open.st_uid,copy_dir_open.st_nlink)!=handle["copy_dir_identity"]
            or (copy_dir_absolute.st_dev,copy_dir_absolute.st_ino,
                copy_dir_absolute.st_mode,copy_dir_absolute.st_uid,
                copy_dir_absolute.st_nlink)!=handle["copy_dir_identity"]
            or not stat.S_ISDIR(copy_dir_open.st_mode)
            or copy_dir_open.st_uid!=os.getuid()
            or stat.S_IMODE(copy_dir_open.st_mode)!=0o700
            or os.listdir(copy_dir_fd)!=[copy_name]):
        raise Rig("known-hosts copy directory changed")
    copy_named=os.stat(copy_name,dir_fd=copy_dir_fd,follow_symlinks=False)
    copy_absolute=os.lstat(copy_path);copy_open=os.fstat(copy_fd)
    if ((copy_named.st_dev,copy_named.st_ino,copy_named.st_mode,copy_named.st_uid,
         copy_named.st_nlink,copy_named.st_size,copy_named.st_mtime_ns,
         copy_named.st_ctime_ns)!=handle["copy_identity"]
            or (copy_absolute.st_dev,copy_absolute.st_ino,copy_absolute.st_mode,
                copy_absolute.st_uid,copy_absolute.st_nlink,copy_absolute.st_size,
                copy_absolute.st_mtime_ns,copy_absolute.st_ctime_ns)!=handle["copy_identity"]
            or (copy_open.st_dev,copy_open.st_ino,copy_open.st_mode,copy_open.st_uid,
                copy_open.st_nlink,copy_open.st_size,copy_open.st_mtime_ns,
                copy_open.st_ctime_ns)!=handle["copy_identity"]
            or not stat.S_ISREG(copy_open.st_mode) or copy_open.st_uid!=os.getuid()
            or stat.S_IMODE(copy_open.st_mode)!=0o600 or copy_open.st_nlink!=1
            or hashlib.sha256(os.pread(copy_fd,1024*1024+1,0)).hexdigest()!=handle["sha256"]):
        raise Rig("known-hosts copy changed")


def r15_close_retained_known_hosts(handle: dict[str,object] | None) -> None:
    if handle is None:return
    errors=[];copy_name=handle.get("copy_name");copy_dir_fd=handle.get("copy_dir_fd")
    copy_fd=handle.get("copy_fd");copy_dir_name=handle.get("copy_dir_name")
    copy_root_fd=handle.get("copy_root_fd");copy_root_fds=handle.get("copy_root_fds",[])
    copy_path=handle.get("copy_path")
    copy_dir_path=handle.get("copy_dir_path")
    if isinstance(copy_name,str) and isinstance(copy_dir_fd,int):
        try:
            copy_open=os.fstat(copy_fd) if isinstance(copy_fd,int) else None
            try:copy_named=os.stat(copy_name,dir_fd=copy_dir_fd,follow_symlinks=False)
            except FileNotFoundError:
                if copy_open is None or copy_open.st_nlink!=0:errors.append("copy missing while linked")
            else:
                if (copy_open is None
                        or (copy_named.st_dev,copy_named.st_ino)
                            !=(copy_open.st_dev,copy_open.st_ino)):
                    errors.append("copy cleanup identity")
                else:
                    os.unlink(copy_name,dir_fd=copy_dir_fd);os.fsync(copy_dir_fd)
                    if os.fstat(copy_fd).st_nlink!=0:errors.append("copy retained links")
        except OSError as exc:errors.append("copy unlink:"+str(exc))
    else:errors.append("copy unlink handle")
    if isinstance(copy_fd,int):
        try:os.close(copy_fd)
        except OSError as exc:errors.append("copy fd close:"+str(exc))
    else:errors.append("copy fd handle")
    if isinstance(copy_dir_name,str) and isinstance(copy_root_fd,int):
        try:
            copy_dir_open=os.fstat(copy_dir_fd) if isinstance(copy_dir_fd,int) else None
            copy_dir_named=os.stat(copy_dir_name,dir_fd=copy_root_fd,follow_symlinks=False)
            if (copy_dir_open is None
                    or (copy_dir_named.st_dev,copy_dir_named.st_ino)
                        !=(copy_dir_open.st_dev,copy_dir_open.st_ino)):
                errors.append("copy dir cleanup identity")
            elif os.listdir(copy_dir_fd):errors.append("copy dir cleanup entries")
            else:os.rmdir(copy_dir_name,dir_fd=copy_root_fd)
        except OSError as exc:errors.append("copy dir remove:"+str(exc))
    else:errors.append("copy dir handle")
    if isinstance(copy_dir_fd,int):
        try:os.close(copy_dir_fd)
        except OSError as exc:errors.append("copy dir fd close:"+str(exc))
    if isinstance(copy_root_fds,list):
        for parent in reversed(copy_root_fds):
            if isinstance(parent,int):
                try:os.close(parent)
                except OSError as exc:errors.append("copy root fd close:"+str(exc))
    if isinstance(copy_path,str) and os.path.lexists(copy_path):errors.append("copy residue")
    if isinstance(copy_dir_path,str) and os.path.lexists(copy_dir_path):errors.append("copy dir residue")
    descriptor=handle.get("fd");parents=handle.get("parents",[])
    if isinstance(descriptor,int):
        try:os.close(descriptor)
        except OSError as exc:errors.append("source fd close:"+str(exc))
    if isinstance(parents,list):
        for parent in reversed(parents):
            if isinstance(parent,int):
                try:os.close(parent)
                except OSError as exc:errors.append("source ancestor close:"+str(exc))
    if errors:raise Rig("known-hosts cleanup failure: "+" | ".join(errors))


def r15_remote_setup(origin: str) -> tuple[dict[str,str],list[str],dict[str,object] | None,tuple[object,...] | None]:
    """Closed remote observation with a retained-identity plain host-key copy."""
    env={
        "HOME":"/private/var/empty","XDG_CONFIG_HOME":"/private/var/empty",
        "PATH":"/usr/bin:/bin","LANG":"C","LC_ALL":"C",
        "GIT_CONFIG_NOSYSTEM":"1","GIT_CONFIG_GLOBAL":"/dev/null",
        "GIT_CONFIG_SYSTEM":"/dev/null","GIT_ATTR_NOSYSTEM":"1",
        "GIT_TERMINAL_PROMPT":"0","GIT_PAGER":"cat","GIT_OPTIONAL_LOCKS":"0",
    }
    arguments: list[str]=[];known_handle=None;agent_identity=None
    if origin == "git@github.com:Nortropic/nortropic-system.git":
        agent=R15_INITIAL_SSH_AUTH_SOCK
        if os.environ.get("SSH_AUTH_SOCK","")!=agent:
            raise Rig("SSH_AUTH_SOCK changed after process authority capture")
        if not agent or not os.path.isabs(agent): raise Rig("validated SSH_AUTH_SOCK unavailable")
        agent_path=Path(agent); ok,why=r15_nofollow_components(agent_path)
        if not ok: raise Rig(why)
        info=os.lstat(agent_path)
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            raise Rig("SSH_AUTH_SOCK is not the existing current-uid UNIX socket")
        parent=os.lstat(agent_path.parent)
        if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=os.getuid()
                or stat.S_IMODE(parent.st_mode)!=0o700):
            raise Rig("SSH_AUTH_SOCK immediate parent is not private current-uid authority")
        agent_identity=(str(agent_path),info.st_dev,info.st_ino,info.st_mode,
                        info.st_uid,info.st_nlink,parent.st_dev,parent.st_ino,parent.st_mode)
        home=Path(pwd.getpwuid(os.getuid()).pw_dir)
        known_hosts=home/".ssh/known_hosts";known_handle=r15_retained_known_hosts(known_hosts)
        env["SSH_AUTH_SOCK"]=str(agent_path)
        command=("/usr/bin/ssh -F /dev/null -oBatchMode=yes -oStrictHostKeyChecking=yes "
                 "-oProxyCommand=none -oProxyJump=none -oCanonicalizeHostname=no "
                 "-oIdentitiesOnly=no -oIdentityFile=none "
                 "-oUserKnownHostsFile="+str(known_handle["copy_path"])+
                 " -oGlobalKnownHostsFile=/dev/null -oPasswordAuthentication=no "
                 "-oKbdInteractiveAuthentication=no")
        arguments=["-c",f"core.sshCommand={command}"]
    else:
        local=Path(origin)
        if not local.is_absolute(): raise Rig("remote origin is neither exact production SSH nor absolute local bare")
        ok,why=r15_nofollow_components(local,leaf_directory=True)
        if not ok: raise Rig(why)
        try:
            head=local/"HEAD"; objects=local/"objects"; config=local/"config"
            head_ok,_=r15_nofollow_components(head,leaf_directory=False)
            objects_ok,_=r15_nofollow_components(objects,leaf_directory=True)
            config_ok,_=r15_nofollow_components(config,leaf_directory=False)
            head_info=os.lstat(head); config_info=os.lstat(config)
            if (local.resolve(strict=True) != local or not head_ok or not objects_ok
                    or not config_ok or not stat.S_ISREG(head_info.st_mode)
                    or not stat.S_ISREG(config_info.st_mode)
                    or head_info.st_uid!=os.getuid() or config_info.st_uid!=os.getuid()
                    or head_info.st_nlink!=1 or config_info.st_nlink!=1
                    or (objects/"info/alternates").exists()
                    or (objects/"info/alternates").is_symlink()
                    or (objects/"info/http-alternates").exists()
                    or (objects/"info/http-alternates").is_symlink()):
                raise Rig("local fixture origin is not exact canonical bare Git")
            for parent_path,dirs,files in os.walk(local,followlinks=False):
                for name in (*dirs,*files):
                    if stat.S_ISLNK(os.lstat(Path(parent_path)/name).st_mode):
                        raise Rig("local fixture bare tree contains symlink authority")
            bare=r15_git(local,"rev-parse","--is-bare-repository")
        except OSError as exc:
            raise Rig(f"local fixture origin: {exc}") from exc
        if bare.returncode or bare.stdout.strip()!="true": raise Rig("local fixture origin is not bare")
    return env,arguments,known_handle,agent_identity


def r15_remote_environment(origin: str) -> tuple[dict[str,str], list[str]]:
    env,arguments,handle,_agent=r15_remote_setup(origin)
    r15_close_retained_known_hosts(handle)
    return env,arguments


def r15_observed_remote_main(repo: Path) -> tuple[str, str]:
    config_path,config_raw,config_info,origin=r15_local_config_snapshot(repo)
    config_before=((config_info.st_dev,config_info.st_ino,config_info.st_mode,
                    config_info.st_uid,config_info.st_nlink,config_info.st_size,
                    config_info.st_mtime_ns,config_info.st_ctime_ns),
                   hashlib.sha256(config_raw).hexdigest())
    env,remote_args,known_handle,agent_identity=r15_remote_setup(origin)
    try:
        if known_handle is not None:r15_validate_retained_known_hosts(known_handle)
        try:
            result=subprocess.run(
                ["/usr/bin/git","--no-replace-objects",*remote_args,
                 "-c","core.hooksPath=/dev/null",
                 "ls-remote","--refs",origin,"refs/heads/main"],
                cwd=Path("/private/var/empty"),env=env,text=True,capture_output=True,
                shell=False,check=False,timeout=45,pass_fds=(),close_fds=True)
        finally:
            if known_handle is not None:r15_validate_retained_known_hosts(known_handle)
    finally:r15_close_retained_known_hosts(known_handle)
    config_after_raw,config_info=r15_stable_regular_bytes(config_path,max_bytes=1024*1024)
    config_after=((config_info.st_dev,config_info.st_ino,config_info.st_mode,
                   config_info.st_uid,config_info.st_nlink,config_info.st_size,
                   config_info.st_mtime_ns,config_info.st_ctime_ns),
                  hashlib.sha256(config_after_raw).hexdigest())
    if config_after!=config_before: raise Rig("local Git config changed during remote observation")
    if agent_identity is not None:
        agent=Path(str(agent_identity[0]));socket_info=os.lstat(agent);parent=os.lstat(agent.parent)
        agent_after=(str(agent),socket_info.st_dev,socket_info.st_ino,socket_info.st_mode,
                     socket_info.st_uid,socket_info.st_nlink,parent.st_dev,parent.st_ino,parent.st_mode)
        if agent_after!=agent_identity:raise Rig("SSH agent authority changed")
    rows=result.stdout.splitlines()
    if result.returncode or len(rows) != 1:
        raise Rig("cannot observe exact remote main: "+result.stderr[-300:])
    fields=rows[0].split("\t")
    if len(fields)!=2 or fields[1]!="refs/heads/main" or not r15_lower_hex(fields[0],40):
        raise Rig("malformed remote main observation")
    return origin,fields[0]


