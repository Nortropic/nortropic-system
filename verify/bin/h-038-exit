last_frame_raw=[b""]
def recv_frame(sock):
 lead=b""
 while len(lead)<4:
  part=sock.recv(4-len(lead))
  if not part:return None
  lead+=part
 size=struct.unpack(">I",lead)[0]
 if size>1048576:raise ValueError("oversized")
 body=b""
 while len(body)<size:
  part=sock.recv(size-len(body))
  if not part:return None
  body+=part
 last_frame_raw[0]=body
 return json.loads(body.decode())
