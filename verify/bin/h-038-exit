if sink_before!="ORIGINAL-P1": raise SystemExit(92)
def regular_identity(path):
 try:s=os.lstat(path)
 except OSError:return None
 return {"dev":s.st_dev,"ino":s.st_ino,"mode":s.st_mode&0o777,"nlink":s.st_nlink,"uid":s.st_uid,"regular":stat.S_ISREG(s.st_mode),"symlink":stat.S_ISLNK(s.st_mode)}
