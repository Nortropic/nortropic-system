passed = 0
failed = 0
failed_labels: list[tuple[str, str]] = []


class Rig(Exception):
    pass


class Undecidable(Exception):
    pass


def sha(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def path_sha(path: Path) -> str:
    return sha(path.read_bytes())


def canonical_sha(value: Any) -> str:
    return sha(json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
    ).encode("utf-8"))


def strict_json(raw: bytes) -> Any:
    def pairs(items):
        out: dict[str, Any] = {}
        for key, value in items:
            if key in out:
                raise Rig(f"duplicate JSON key {key}")
            out[key] = value
        return out
    try:
        return json.loads(
            raw.decode("utf-8"), object_pairs_hook=pairs,
            parse_constant=lambda value: (_ for _ in ()).throw(
                Rig(f"non-finite JSON value {value}")),
        )
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise Rig(f"invalid strict JSON: {exc}") from exc


def check(ok: bool, label: str, detail: Any = "") -> None:
    global passed, failed
    rendered = detail if isinstance(detail, str) else json.dumps(
        detail, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
    )
    if ok:
        passed += 1
        print(f"PASS {label}")
    else:
        failed += 1
        failed_labels.append((label, rendered))
        print(f"FAIL {label}" + (f" — {rendered}" if rendered else ""))


def load_frozen_helpers() -> tuple[dict[str, Any], dict[str, Any]]:
    if path_sha(H036_GATE) != PINNED_UNCHANGED["verify/bin/h-036-exit"]:
        raise Rig("H036 helper gate identity drift")
    if path_sha(H037_GATE) != PINNED_UNCHANGED["verify/bin/h-037-exit"]:
        raise Rig("H037 identity helper gate drift")
    return (
        runpy.run_path(str(H036_GATE), run_name="h038_frozen_h036"),
        runpy.run_path(str(H037_GATE), run_name="h038_frozen_h037"),
    )


def task_rows(spec: dict[str, Any], task_id: str) -> list[dict[str, Any]]:
    tasks = spec.get("tasks")
    if not isinstance(tasks, list):
        raise Rig("tasks is not a list")
    return [row for row in tasks if isinstance(row, dict) and row.get("id") == task_id]


def expected_config(old: dict[str, Any], launcher_sha: str, helper_sha: str) -> dict[str, Any]:
    value = copy.deepcopy(old)
    value["products"]["launcher"]["sha256"] = launcher_sha
    value["products"]["runtime_snapshot"]["sha256"] = helper_sha
    value["authority"]["attempt_root_override_allowed"] = False
    value["protocol"]["managed_attempt_root"] = {
        "environment_key": "NORTROPIC_ATTEMPT_ROOT",
        "source": "controller-bound-top-level-state-only",
        "state_transport": "private-bootstrap-path-and-stable-dev-ino",
        "workspace_parameter": "CURRENT_WORKSPACE",
        "target_environment_visible": False,
        "request_override_allowed": False,
        "nested_override_allowed": False,
        "required_with": ["NORTROPIC_STAGING_ROOT", "NORTROPIC_RESULT_SINK"],
        "neutral_attempt_proof_directory": {
            "name_pattern": ".nortropic-h038-proof-{controller_nonce_64_lowerhex}",
            "parent": "ATTEMPT_ROOT_DIRECT_CHILD",
            "nonce_source": "server-secrets-token-hex-32-not-request-or-caller",
            "mode": "0700",
            "uid": "current-euid",
            "nofollow": True,
            "disjoint_from": [
                "CURRENT_WORKSPACE", "TRUST_ROOT", "STAGING_ROOT", "RESULT_SINK",
                "LIVE_ROOT", "LIVE_GIT", "RUNTIME_ROOT",
            ],
            "source_members": [
                "write-source", "rename-source", "unlink-source", "hardlink-source",
            ],
            "source_state": "regular-current-euid-mode0600-nlink1-distinct-bound-dev-ino-original-bytes",
            "collision": "nofollow-o_excl-reject-before-any-mutation-preserve-foreign",
            "cleanup": "exact-created-dev-ino-only-every-outcome-no-glob-chmod-follow-or-foreign-delete",
        },
        "canonical_requirements": [
            "absolute", "preexisting", "nofollow-directory", "canonical-path",
            "current-euid", "mode-0700", "stable-dev-ino-through-profile-install",
        ],
        "topology_requirements": [
            "exact-current-workspace-managed-descendant",
            "trust-explicit-managed-descendant-or-default-live-root-disjoint",
            "exact-staging-sink-managed-descendants",
            "workspace-trust-staging-mutually-disjoint",
            "attempt-root-live-and-common-git-bidirectionally-disjoint",
            "runtime-root-and-private-tmp-not-enclosed",
            "no-canonical-dev-ino-alias-or-ancestor-substitution",
        ],
    }
    value["protocol"]["proof_effect_keys_by_profile_sha256"][
        PROFILE_MANAGED_SHA256
    ] = MANAGED_EFFECT_KEYS
    seatbelt = value["seatbelt"]
    seatbelt["profile_encoding"] = "utf8-exact-deterministic-three-member-family-v2"
    seatbelt["profile_id"] = "H038_MONOTONIC_ATTEMPT_WORKSPACE_SUBSET_V1"
    seatbelt["profile_with_attempt_and_staging_sha256"] = PROFILE_MANAGED_SHA256
    seatbelt["profile_selection_by_controller_state"] = {
        "attempt_absent_staging_absent_sink_absent": PROFILE_BASE_SHA256,
        "attempt_absent_staging_present_sink_present": PROFILE_STAGING_SHA256,
        "attempt_present_staging_present_sink_present": PROFILE_MANAGED_SHA256,
        "all_other_presence_states": "reject-before-runtime-root-supervisor-or-target",
    }
    seatbelt["parameter_order_by_profile_sha256"][
        PROFILE_MANAGED_SHA256
    ] = MANAGED_PARAM_ORDER
    strip_exact = value["target_environment"]["strip_exact"]
    insertion = strip_exact.index("NORTROPIC_STAGING_ROOT")
    strip_exact.insert(insertion, "NORTROPIC_ATTEMPT_ROOT")
    return value


def config_oracle(document: Any, old: dict[str, Any], launcher_sha: str,
                  helper_sha: str) -> tuple[bool, str]:
    if not isinstance(document, dict):
        return False, "config is not object"
    expected = expected_config(old, launcher_sha, helper_sha)
    return document == expected, "exact" if document == expected else "config mismatch"


def config_selftests(old: dict[str, Any]) -> bool:
    good = expected_config(old, "11" * 32, "22" * 32)
    ok, _ = config_oracle(good, old, "11" * 32, "22" * 32)
    mutants: list[dict[str, Any]] = []
    for mutate in (
        lambda d: d["authority"].update(attempt_root_override_allowed=True),
        lambda d: d["seatbelt"].pop("profile_with_attempt_and_staging_sha256"),
        lambda d: d["seatbelt"].update(profile_id="H036_MONOTONIC_WORKSPACE_SUBSET_V1"),
        lambda d: d["seatbelt"]["profile_selection_by_controller_state"].update(
            all_other_presence_states=PROFILE_BASE_SHA256),
        lambda d: d["seatbelt"].update(profile_without_staging_sha256="33" * 32),
        lambda d: d["seatbelt"].update(profile_sha256="44" * 32),
        lambda d: d["seatbelt"]["parameter_order_by_profile_sha256"]
            [PROFILE_MANAGED_SHA256].remove("ATTEMPT_ROOT"),
        lambda d: d["protocol"]["proof_effect_keys_by_profile_sha256"]
            [PROFILE_MANAGED_SHA256].remove("attempt_create"),
        lambda d: d["protocol"]["managed_attempt_root"].update(
            request_override_allowed=True),
        lambda d: d["protocol"]["managed_attempt_root"]
            ["neutral_attempt_proof_directory"].update(
                nonce_source="caller-request-nonce"),
        lambda d: d["protocol"]["managed_attempt_root"]
            ["neutral_attempt_proof_directory"].update(
                cleanup="prefix-glob-delete"),
        lambda d: d["protocol"]["managed_attempt_root"]
            ["neutral_attempt_proof_directory"].update(
                collision="delete-and-recreate"),
        lambda d: d["protocol"]["managed_attempt_root"]
            ["neutral_attempt_proof_directory"].update(
                parent="CURRENT_WORKSPACE"),
        lambda d: d["protocol"]["managed_attempt_root"]
            ["neutral_attempt_proof_directory"]["source_members"].append(
                "arbitrary-source"),
        lambda d: d["protocol"]["managed_attempt_root"]["canonical_requirements"]
            .remove("stable-dev-ino-through-profile-install"),
        lambda d: d["protocol"]["managed_attempt_root"]["topology_requirements"]
            .remove("trust-explicit-managed-descendant-or-default-live-root-disjoint"),
        lambda d: d["protocol"]["header_keys"].append("attempt_root"),
        lambda d: d["target_environment"]["strip_exact"].remove(
            "NORTROPIC_ATTEMPT_ROOT"),
        lambda d: d.update(unexpected="authority"),
    ):
        candidate = copy.deepcopy(good)
        mutate(candidate)
        mutants.append(candidate)
    return ok and all(
        not config_oracle(value, old, "11" * 32, "22" * 32)[0]
        for value in mutants
    )


def identity_oracle(*, parents: list[str], changes: list[tuple[str, str, str]],
                    added: int, base_pins: bool, contract_equal: bool,
                    checkout_equal: bool, contract_publication: bool,
                    remote_publication_state: bool) -> bool:
    expected = [("M", path, PRODUCT_MODES[path]) for path in PRODUCT_PATHS]
    return (
        len(parents) == 1
        and len(changes) == len(expected)
        and set(changes) == set(expected)
        and 0 <= added <= MAX_ADDED_LINES
        and base_pins and contract_equal and checkout_equal
        and contract_publication and remote_publication_state
    )


def identity_selftests() -> bool:
    parent = ["11" * 20]
    changes = [("M", path, PRODUCT_MODES[path]) for path in PRODUCT_PATHS]
    good = dict(parents=parent, changes=changes, added=MAX_ADDED_LINES,
                base_pins=True, contract_equal=True, checkout_equal=True,
                contract_publication=True, remote_publication_state=True)
    reordered = copy.deepcopy(good)
    reordered["changes"] = list(reversed(changes))
    if not identity_oracle(**good) or not identity_oracle(**reordered):
        return False
    mutants = []
    for key, value in (
        ("parents", []), ("parents", parent + ["22" * 20]),
        ("changes", changes[:-1]),
        ("changes", changes + [("M", "controller/launch/neighbor.py", "100644")]),
        ("changes", [("M", PRODUCT_PATHS[0], "100644"), *changes[1:]]),
        ("added", MAX_ADDED_LINES + 1), ("base_pins", False),
        ("contract_equal", False), ("checkout_equal", False),
        ("contract_publication", False), ("remote_publication_state", False),
    ):
        candidate = copy.deepcopy(good)
        candidate[key] = value
        mutants.append(candidate)
    return all(not identity_oracle(**value) for value in mutants)


def historical_config(h37: dict[str, Any], binding: Any) -> dict[str, Any]:
    raw = h37["git_blob"](
        binding, PUBLISHED_H036_PRODUCT,
        "config/python-runtime-authority-v2.json",
    )
    value = strict_json(raw)
    if not isinstance(value, dict) or sha(raw) != OLD_PRODUCT_SHA256[
        "config/python-runtime-authority-v2.json"
    ]:
        raise Rig("published H036 config identity mismatch")
    return value


def static_contract_checks(h37: dict[str, Any]) -> tuple[Any, dict[str, Any]]:
    check(
        all((ROOT / path).is_file() and not (ROOT / path).is_symlink()
            and path_sha(ROOT / path) == digest
            for path, digest in PINNED_UNCHANGED.items()),
        "F_H038_H035_H036_H037_REGISTRY_DELEGATION_CONSTITUTION_PRESERVED",
    )
    check(
        DELEGATION_DOCUMENT_SHA256 == path_sha(DELEGATION)
        and DELEGATION_SOURCE_SHA256 in DELEGATION.read_text(encoding="utf-8"),
        "F_H038_CANONICAL_DELEGATION_DOCUMENT_AND_EMBEDDED_SOURCE_IDENTITIES",
    )
    try:
        binding = h37["canonical_git_binding"](ROOT)
    except Exception as exc:
        raise Rig(f"canonical Git binding failed: {exc}") from exc
    product_record = h37["strict_commit_record"](binding, PUBLISHED_H036_PRODUCT)
    merge_record = h37["strict_commit_record"](binding, PUBLISHED_H036_MERGE)
    authority_record = h37["strict_commit_record"](binding, CONTRACT_AUTHORITY_BASE)
    product_tree = h37["identity_git"](
        binding, "rev-parse", f"{PUBLISHED_H036_PRODUCT}^{{tree}}",
    )
    published_ok = (
        product_tree.returncode == 0
        and product_tree.stdout.strip() == PUBLISHED_H036_PRODUCT_TREE
        and authority_record.tree == CONTRACT_AUTHORITY_TREE
        and merge_record.parents == PUBLISHED_H036_MERGE_PARENTS
        and all(
            sha(h37["git_blob"](binding, PUBLISHED_H036_PRODUCT, path)) == digest
            for path, digest in OLD_PRODUCT_SHA256.items()
        )
    )
    check(published_ok, "F_H038_EXACT_PUBLISHED_H036_PRODUCT_MERGE_AND_THREE_BYTES")

    spec = strict_json(SPEC.read_bytes())
    if not isinstance(spec, dict):
        raise Rig("task spec is not object")
    rows = {task_id: task_rows(spec, task_id) for task_id in
            ("h-035", "h-036", "h-037", "h-038")}
    if any(len(value) != 1 for value in rows.values()):
        raise Rig("H035-H038 task cardinality drift")
    task = rows["h-038"][0]
    contract = task.get("h038_managed_attempt_root_confinement")
    bp = contract.get("bp01_bp14_bindings") if isinstance(contract, dict) else None
    contract_base = contract.get("contract_authority_base", {}) \
        if isinstance(contract, dict) else {}
    attempt_authority = contract.get("attempt_root_authority", {}) \
        if isinstance(contract, dict) else {}
    check(
        task.get("authority_class") == "owner_authority"
        and task.get("allowed_write") == []
        and task.get("owner_author_allowed_write") == PRODUCT_PATHS
        and task.get("docs_impact") == []
        and task.get("depends_on") == ["h-036"]
        and task.get("exit_test") == "verify/bin/h-038-exit"
        and task.get("max_changed_files") == 3
        and task.get("max_added_lines") == MAX_ADDED_LINES
        and isinstance(contract, dict)
        and contract.get("test_author_surface") == TEST_AUTHOR_SURFACE
        and contract_base.get("commit") == CONTRACT_AUTHORITY_BASE
        and contract_base.get("tree") == CONTRACT_AUTHORITY_TREE
        and contract_base.get("test_author_candidate_relation")
            == "DIRECT_SINGLE_CHILD_WITH_EXACT_FIVE_FILE_SURFACE"
        and contract_base.get("guarded_publication_merge", {}).get("ordered_parents")
            == ["CONTRACT_AUTHORITY_BASE", "EXACT_REVIEWED_TEST_AUTHOR_CANDIDATE"]
        and contract_base.get("guarded_publication_merge", {}).get("tree")
            == "EXACT_TEST_AUTHOR_CANDIDATE_TREE"
        and contract_base.get("guarded_publication_merge", {})
            .get("origin_main_must_equal_merge_before_product_review") is True
        and contract.get("product_identity", {}).get("candidate_relation")
            == "DIRECT_SINGLE_CHILD_OF_EXACT_PUBLISHED_H038_CONTRACT_BASE"
        and contract.get("product_identity", {}).get("remote_origin_main_states")
            == [
                "PREPUBLICATION_EXACT_H038_CONTRACT_BASE",
                "POSTPUBLICATION_EXACT_TWO_PARENT_PRODUCT_MERGE_WITH_CANDIDATE_TREE",
            ]
        and attempt_authority.get("canonical_state")
            == "ABSOLUTE_PREEXISTING_NOFOLLOW_DIRECTORY_CURRENT_UID_MODE0700_STABLE_DEV_INO"
        and attempt_authority.get("trust_states") == [
            "EXPLICIT_TRUST_STRICT_MANAGED_DESCENDANT_OF_ATTEMPT_ROOT",
            "DEFAULT_TRUST_EQUALS_LIVE_ROOT_AND_ATTEMPT_ROOT_IS_BIDIRECTIONALLY_DISJOINT",
        ]
        and attempt_authority.get("neutral_attempt_proof_directory", {}).get(
            "nonce_source"
        ) == "SERVER_CSPRNG_SECRETS_TOKEN_HEX_32_NEVER_REQUEST_OR_CALLER"
        and attempt_authority.get("neutral_attempt_proof_directory", {}).get(
            "cleanup"
        ) == "EXACT_CREATED_DEV_INO_ONLY_EVERY_OUTCOME_NO_PREFIX_GLOB_CHMOD_FOLLOW_OR_FOREIGN_DELETE"
        and attempt_authority.get("neutral_attempt_proof_directory", {}).get(
            "post_barrier_replacement_test"
        ) == "DYNAMIC_PRODUCT_EFFECT_REQUIRED"
        and contract.get("future_dependency_transition", {})
            .get("h032_later_depends_exactly_on") == ["h-038"]
        and [item.get("id") for item in bp] == [f"BP{index:02d}" for index in range(1, 15)]
        and contract.get("standing_delegation", {})
            .get("delegation_document_sha256") == DELEGATION_DOCUMENT_SHA256
        and contract.get("standing_delegation", {})
            .get("source_sha256") == DELEGATION_SOURCE_SHA256,
        "F_H038_EXACT_OWNER_TASK_DEPENDENCY_SURFACE_BUDGET_BP01_BP14",
    )
    observed = {task_id: canonical_sha(value[0]) for task_id, value in rows.items()}
    check(
        observed == {
            "h-035": H035_TASK_SHA256, "h-036": H036_TASK_SHA256,
            "h-037": H037_TASK_SHA256, "h-038": TASK_SHA256,
        },
        "F_H038_EXACT_FROZEN_TASK_AND_HISTORICAL_TASK_IDENTITIES",
        observed,
    )
    check(
        sha(PROFILE_BASE.encode()) == PROFILE_BASE_SHA256
        and sha(PROFILE_STAGING.encode()) == PROFILE_STAGING_SHA256
        and sha(PROFILE_MANAGED.encode()) == PROFILE_MANAGED_SHA256
        and contract.get("profile_family", {}).get("attempt_deny_suffix_utf8")
            == ATTEMPT_DENY_SUFFIX
        and contract.get("profile_family", {}).get("profile_id")
            == "H038_MONOTONIC_ATTEMPT_WORKSPACE_SUBSET_V1"
        and contract.get("profile_family", {})
            .get("managed_attempt_with_staging_sha256") == PROFILE_MANAGED_SHA256,
        "F_H038_EXACT_CLOSED_THREE_PROFILE_FAMILY_AND_SUFFIX_ORDER",
    )
    old = historical_config(h37, binding)
    check(config_selftests(old) and identity_selftests(),
          "J_H038_STRICT_CONFIG_AND_PRODUCT_IDENTITY_ONE_DEFECT_MUTANTS")
    owner = OWNER_WORKFLOW.read_text(encoding="utf-8")
    decision = DECISION_LOG.read_text(encoding="utf-8")
    drift = DRIFT.read_text(encoding="utf-8")
    check(
        owner.count("<!-- H038_MANAGED_ATTEMPT_ROOT_CONFINEMENT_CONTRACT_V1 -->") == 1
        and decision.count("H-038 managed attempt-root confinement contract") == 1
        and drift.count("## 2026-08-29 — H-038 managed attempt-root confinement contract") == 1,
        "F_H038_MINIMAL_OWNER_WORKFLOW_DECISION_AND_DRIFT_RECORDS",
    )
    return binding, old


def product_phase(old: dict[str, Any]) -> str:
    try:
        current = {path: path_sha(ROOT / path) for path in PRODUCT_PATHS}
    except OSError as exc:
        raise Rig(f"product path unavailable: {exc}") from exc
    if current == OLD_PRODUCT_SHA256:
        return "preproduct"
    document = strict_json(CONFIG.read_bytes())
    ok, detail = config_oracle(document, old, current[PRODUCT_PATHS[0]],
                               current[PRODUCT_PATHS[1]])
    if ok:
        return "product"
    raise Rig(f"partial or unauthorized H038 product state: {detail}")


def commit_changes(h37: dict[str, Any], binding: Any, before: str,
                   after: str) -> list[tuple[str, str, str]]:
    changed_run = h37["identity_git"](
        binding, "diff-tree", "--no-commit-id", "--name-status", "-r", "-z",
        "--no-renames", "--no-ext-diff", before, after, text=False,
    )
    if changed_run.returncode:
        raise Rig("Git changed-path observation failed")
    fields = [value for value in changed_run.stdout.split(b"\0") if value]
    if len(fields) % 2:
        raise Rig("malformed changed paths")
    changes: list[tuple[str, str, str]] = []
    for index in range(0, len(fields), 2):
        status_text = fields[index].decode("ascii")
        path = fields[index + 1].decode("utf-8")
        if status_text not in {"A", "M"}:
            raise Rig(f"unexpected changed-path status {status_text}")
        mode_run = h37["identity_git"](
            binding, "ls-tree", after, "--", path,
        )
        match = re.fullmatch(r"([0-9]{6}) blob [0-9a-f]{40}\t(.+)\n",
                             mode_run.stdout)
        if mode_run.returncode or match is None or match.group(2) != path:
            raise Rig("candidate mode observation failed")
        changes.append((status_text, path, match.group(1)))
    return changes


def product_identity(h37: dict[str, Any], binding: Any, old: dict[str, Any],
                     base: str, candidate: str) -> tuple[bool, dict[str, Any]]:
    detail: dict[str, Any] = {"base": base, "candidate": candidate}
    try:
        if re.fullmatch(r"[0-9a-f]{40}", base) is None \
                or re.fullmatch(r"[0-9a-f]{40}", candidate) is None:
            return False, {**detail, "reason": "noncanonical commit"}
        base_record = h37["strict_commit_record"](binding, base)
        candidate_record = h37["strict_commit_record"](binding, candidate)
        head = h37["identity_git"](binding, "rev-parse", "--verify", "HEAD")
        published_base = h37["identity_git"](
            binding, "rev-parse", "--verify", "refs/remotes/origin/main",
        )
        if head.returncode or published_base.returncode:
            return False, {**detail, "reason": "Git observation failed"}
        remote_oid = published_base.stdout.strip()
        remote_publication_state = remote_oid == base
        if not remote_publication_state \
                and re.fullmatch(r"[0-9a-f]{40}", remote_oid) is not None:
            remote_record = h37["strict_commit_record"](binding, remote_oid)
            remote_publication_state = (
                remote_record.parents == [base, candidate]
                and remote_record.tree == candidate_record.tree
            )
        changes = commit_changes(h37, binding, base, candidate)
        contract_publication = False
        contract_candidate = ""
        contract_changes: list[tuple[str, str, str]] = []
        if len(base_record.parents) == 2 \
                and base_record.parents[0] == CONTRACT_AUTHORITY_BASE:
            contract_candidate = base_record.parents[1]
            contract_record = h37["strict_commit_record"](
                binding, contract_candidate,
            )
            contract_changes = commit_changes(
                h37, binding, CONTRACT_AUTHORITY_BASE, contract_candidate,
            )
            expected_contract_changes = {
                ("M", "specs/tasks.spec.json", "100644"),
                ("A", "verify/bin/h-038-exit", "100755"),
                ("M", "docs/loop/owner-author-workflow-v1.md", "100644"),
                ("M", "docs/05-beslutslogg.md", "100644"),
                ("M", "docs/loop/drift.md", "100644"),
            }
            contract_bytes_equal = all(
                h37["git_blob"](binding, contract_candidate, path)
                    == h37["git_blob"](binding, base, path)
                    == (ROOT / path).read_bytes()
                for path in TEST_AUTHOR_SURFACE
            )
            contract_publication = (
                contract_record.parents == [CONTRACT_AUTHORITY_BASE]
                and contract_record.tree == base_record.tree
                and len(contract_changes) == len(expected_contract_changes)
                and set(contract_changes) == expected_contract_changes
                and contract_bytes_equal
            )
        numstat = h37["identity_git"](
            binding, "diff", "--numstat", "--no-renames", "--no-ext-diff",
            base, candidate, "--", *PRODUCT_PATHS,
        )
        added = 0
        if numstat.returncode:
            return False, {**detail, "reason": "numstat failed"}
        for line in numstat.stdout.splitlines():
            left, _right, _path = line.split("\t", 2)
            if not left.isdecimal():
                return False, {**detail, "reason": "binary product delta"}
            added += int(left)
        base_pins = all(
            sha(h37["git_blob"](binding, base, path)) == digest
            for path, digest in OLD_PRODUCT_SHA256.items()
        ) and all(
            h37["git_blob"](binding, base, path)
                == h37["git_blob"](binding, candidate, path)
            and sha(h37["git_blob"](binding, base, path)) == digest
            for path, digest in PINNED_UNCHANGED.items()
        )
        contract_equal = all(
            h37["git_blob"](binding, base, path)
                == h37["git_blob"](binding, candidate, path)
                == (ROOT / path).read_bytes()
            for path in TEST_AUTHOR_SURFACE
        )
        checkout_equal, checkout_detail = h37["physical_checkout_identity"](
            binding, candidate,
        )
        checkout_equal = checkout_equal and head.stdout.strip() == candidate
        relation = identity_oracle(
            parents=candidate_record.parents, changes=changes, added=added,
            base_pins=base_pins, contract_equal=contract_equal,
            checkout_equal=checkout_equal,
            contract_publication=contract_publication,
            remote_publication_state=remote_publication_state,
        ) and candidate_record.parents == [base]
        document = strict_json(h37["git_blob"](
            binding, candidate, "config/python-runtime-authority-v2.json",
        ))
        candidate_config, config_detail = config_oracle(
            document, old,
            sha(h37["git_blob"](binding, candidate, PRODUCT_PATHS[0])),
            sha(h37["git_blob"](binding, candidate, PRODUCT_PATHS[1])),
        )
        detail.update({
            "parents": candidate_record.parents,
            "base_parents": base_record.parents,
            "contract_candidate": contract_candidate,
            "contract_changes": contract_changes,
            "contract_publication": contract_publication,
            "remote_origin_main": remote_oid,
            "remote_publication_state": remote_publication_state,
            "changes": changes,
            "added_lines": added,
            "base_pins": base_pins,
            "contract_equal": contract_equal,
            "physical_checkout": checkout_detail,
            "config": config_detail,
        })
        return relation and candidate_config, detail
    except Exception as exc:
        return False, {**detail, "reason": f"identity exception: {type(exc).__name__}: {exc}"}


def ensure_directory(path: Path, mode: int = 0o700) -> Path:
    path.mkdir(parents=True, mode=mode, exist_ok=False)
    path.chmod(mode)
    return path


def write_file(path: Path, raw: bytes, mode: int) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        view = memoryview(raw)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
    finally:
        os.close(fd)
    path.chmod(mode)


def exact_tree_snapshot(root: Path) -> dict[str, tuple[Any, ...]]:
    result: dict[str, tuple[Any, ...]] = {}
    total = 0

    def visit(path: Path, relative: str) -> None:
        nonlocal total
        if len(result) >= 8192:
            raise Rig("attempt snapshot member budget exceeded")
        observed = path.lstat()
        common = (
            stat.S_IMODE(observed.st_mode), observed.st_dev, observed.st_ino,
            observed.st_nlink,
        )
        if stat.S_ISDIR(observed.st_mode):
            result[relative] = ("directory", *common)
            with os.scandir(path) as iterator:
                names = sorted(entry.name for entry in iterator)
            for name in names:
                visit(path / name, name if relative == "." else f"{relative}/{name}")
        elif stat.S_ISREG(observed.st_mode):
            if observed.st_size > 64 * 1024 * 1024:
                raise Rig("attempt snapshot file budget exceeded")
            total += observed.st_size
            if total > 128 * 1024 * 1024:
                raise Rig("attempt snapshot total budget exceeded")
            result[relative] = (
                "regular", *common, observed.st_size, path_sha(path),
            )
        elif stat.S_ISLNK(observed.st_mode):
            result[relative] = ("symlink", *common, os.readlink(path))
        else:
            result[relative] = ("other", *common)

    visit(root, ".")
    return result


def profile_proof_residue(root: Path) -> list[str]:
    return sorted(
        relative for relative in exact_tree_snapshot(root)
        if any(
            re.fullmatch(
                r"\.nortropic-h0(?:36|38)-proof-[0-9a-f]{64}(?:[.-].*)?",
                component,
            ) is not None
            for component in relative.split("/")
        )
    )


def h038_neutral_proof_residue(root: Path) -> list[str]:
    return sorted(
        relative for relative in exact_tree_snapshot(root)
        if any(
            re.fullmatch(r"\.nortropic-h038-proof-[0-9a-f]{64}", component)
                is not None
            for component in relative.split("/")
        )
    )


LEGACY_RESIDUE_NAME = re.compile(
    r"\.nortropic-h036-proof-(?P<nonce>[0-9a-f]{64})-"
    r"(?P<family>staging|ancestor)-(?P<leaf>"
    r"(?:write|rename|unlink|hardlink)-source|"
    r"created|hardlink-target|new-dir|rename-target)"
)


def legacy_proof_residue_exact(
    root: Path,
    relatives: list[str],
    expected_parent_families: dict[str, str],
) -> bool:
    """Admit only the two exact frozen-H036 terminal source shapes.

    A matching component is not authority: every residue must itself be one
    expected leaf at one fixture-owned parent and have the exact type, bytes,
    mode, link and inode relations produced by frozen H036.
    """
    groups: dict[tuple[str, str, str], dict[str, Path]] = {}
    for relative in relatives:
        candidate = Path(relative)
        parent = candidate.parent.as_posix()
        match = LEGACY_RESIDUE_NAME.fullmatch(candidate.name)
        if match is None or expected_parent_families.get(parent) != match["family"]:
            return False
        key = (parent, match["nonce"], match["family"])
        if match["leaf"] in groups.setdefault(key, {}):
            return False
        groups[key][match["leaf"]] = root / candidate
    if {key[0] for key in groups} != set(expected_parent_families):
        return False

    def regular(path: Path, mode: int, nlink: int, raw: bytes) -> os.stat_result | None:
        try:
            observed = path.lstat()
            value = path.read_bytes()
        except OSError:
            return None
        return observed if (
            stat.S_ISREG(observed.st_mode) and not path.is_symlink()
            and observed.st_uid == os.geteuid()
            and stat.S_IMODE(observed.st_mode) == mode
            and observed.st_nlink == nlink and value == raw
        ) else None

    untouched = {
        "write-source", "rename-source", "unlink-source", "hardlink-source",
    }
    exercised = {
        "created", "hardlink-source", "hardlink-target", "new-dir",
        "rename-target", "write-source",
    }
    for (_parent, _nonce, family), leaves in groups.items():
        if family == "staging" or set(leaves) == untouched:
            if set(leaves) != untouched:
                return False
            states = [regular(leaves[name], 0o600, 1, b"ORIGINAL")
                      for name in sorted(untouched)]
            if any(value is None for value in states) or len({
                (value.st_dev, value.st_ino) for value in states if value is not None
            }) != 4:
                return False
            continue
        if set(leaves) != exercised:
            return False
        created = regular(leaves["created"], 0o600, 1, b"")
        hard_source = regular(
            leaves["hardlink-source"], 0o600, 2, b"ORIGINAL",
        )
        hard_target = regular(
            leaves["hardlink-target"], 0o600, 2, b"ORIGINAL",
        )
        renamed = regular(leaves["rename-target"], 0o600, 1, b"ORIGINAL")
        written = regular(leaves["write-source"], 0o644, 1, b"")
        try:
            directory = leaves["new-dir"].lstat()
            with os.scandir(leaves["new-dir"]) as iterator:
                directory_empty = next(iterator, None) is None
        except OSError:
            return False
        if (
            any(value is None for value in
                (created, hard_source, hard_target, renamed, written))
            or not stat.S_ISDIR(directory.st_mode)
            or leaves["new-dir"].is_symlink()
            or directory.st_uid != os.geteuid()
            or directory.st_nlink < 2
            or stat.S_IMODE(directory.st_mode) not in {0o700, 0o755}
            or not directory_empty
            or (hard_source.st_dev, hard_source.st_ino)
                != (hard_target.st_dev, hard_target.st_ino)
        ):
            return False
    return True


def wait_for(path: Path, token: str, seconds: float = 8.0) -> str:
    deadline = time.monotonic() + seconds
    raw = ""
    while time.monotonic() < deadline:
        try:
            raw = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            raw = ""
        if token in raw:
            return raw
        time.sleep(0.02)
    return raw


PROCESS_IDENTITY_KEYS = ("pid", "pgid", "sid", "euid", "start", "command")


def bound_process(h36: dict[str, Any], identity: dict[str, Any] | None,
                  *, live: bool) -> bool:
    if not isinstance(identity, dict) or type(identity.get("pid")) is not int:
        return False
    current = h36["process_start_record"](identity["pid"])
    return (
        isinstance(current, dict)
        and all(current.get(key) == identity.get(key) for key in PROCESS_IDENTITY_KEYS)
        and (not live or not str(current.get("state", "")).startswith("Z"))
    )


