try:
    held.require_ready()
    if run(directory, "begin-authority", b).returncode != 0:
        raise RuntimeError("write/BEGIN conflicting BEGIN failed")
    held.continue_one()
    rc, _stdout, _stderr = held.wait()
finally:
    held.close()
if rc == 0 or run(directory, "read", late_task, "--authority", a).returncode == 0:
    raise SystemExit("held stale authority write survived newer BEGIN")
b_task, b_sha = "write-begin-current", sha(6011)
if run(directory, "write", b_task, b_sha, "--authority", b).returncode != 0:
