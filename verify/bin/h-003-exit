def expect_no_ready(label, *args):
    held = HeldMutation(*args)
    try:
        readable, _writable, _exceptional = select.select([held.ready_r], [], [], 3)
        rc, _stdout, _stderr = held.wait(timeout=3)
        data = os.read(held.ready_r, 2) if readable else b""
    finally:
        held.close()
    if rc == 0 or data:
        raise RuntimeError(f"{label} emitted READY or succeeded")

