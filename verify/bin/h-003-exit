        raise RuntimeError("write/finalize conflicting finalize failed")
    held.continue_one()
    rc, _stdout, _stderr = held.wait()
finally:
    held.close()
if rc == 0 or run(directory, "read", "wf-late", "--authority", a).returncode == 0:
    raise SystemExit("held write reopened finalized generation")
if not exact(directory, "wf-seed", sha(6040), "--require-valid"):
    raise SystemExit("held write damaged finalized seed")

def finalize_begin():
    directory = root / "finalize-begin"
    a, b = "held-finalize-A", "held-finalize-B"
    setup_authority(directory, a, "fb-seed", sha(6050))
    held = HeldFinalize(directory, a, "begin")
    try:
        held.require_ready()
        if run(directory, "begin-authority", b).returncode != 0:
            raise RuntimeError("held finalize blocked/completed-over newer BEGIN")
        held.release()
        rc, _stdout, _stderr = held.wait()
    finally:
        held.close()
    if rc == 0 or run(directory, "read", "fb-seed", "--require-valid").returncode == 0:
        raise RuntimeError("held finalize published after newer BEGIN")
    if run(directory, "write", "fb-current", sha(6051), "--authority", b).returncode != 0:
        raise RuntimeError("held finalize resurrected A over B")

def finalize_invalidate():
    directory = root / "finalize-invalidate"
    a = "held-finalize-invalidate"
    x, y = "fi-x", "fi-y"
    x_sha, y_sha = sha(6060), sha(6061)
    setup_authority(directory, a, x, x_sha)
    if run(directory, "write", y, y_sha, "--authority", a).returncode != 0:
        raise RuntimeError("finalize/invalidate second seed failed")
    held = HeldFinalize(directory, a, "invalidate")
    try:
        held.require_ready()
        if run(directory, "invalidate", x_sha).returncode != 0:
            raise RuntimeError("held finalize blocked conflicting invalidate")
        held.release()
        rc, _stdout, _stderr = held.wait()
    finally:
        held.close()
    if rc == 0 or any(run(directory, "read", task, "--require-valid").returncode == 0 for task in (x, y)):
        raise RuntimeError("held finalize published invalidated/partial batch")
    if not pending(directory, x):
        raise RuntimeError("held finalize lost invalidate debt")

def finalize_late_write():
    directory = root / "finalize-late-write"
    a = "held-finalize-late"
    seed_task, late_task = "fl-seed", "fl-late"
    seed_sha, late_sha = sha(6070), sha(6071)
    setup_authority(directory, a, seed_task, seed_sha)
    held = HeldFinalize(directory, a, "late-write")
    try:
        held.require_ready()
        if run(directory, "write", late_task, late_sha, "--authority", a).returncode != 0:
            raise RuntimeError("held finalize blocked current late write")
        held.release()
        rc, _stdout, _stderr = held.wait()
    finally:
        held.close()
    if rc != 0:
        if any(run(directory, "read", task, "--require-valid").returncode == 0 for task in (seed_task, late_task)):
            raise RuntimeError("failed held finalize left partial/global validity")
        if not exact(directory, late_task, late_sha, "--authority", a):
            raise RuntimeError("failed held finalize lost completed late write")
        if run(directory, "finalize-authority", a).returncode != 0:
            raise RuntimeError("safe-failed held finalize could not retry")
    if not all(
        exact(directory, task, candidate, "--require-valid")
        for task, candidate in ((seed_task, seed_sha), (late_task, late_sha))
    ):
        raise RuntimeError("held finalize omitted completed late write")

def finalize_legacy_write():
    directory = root / "finalize-legacy-write"
    a = "held-finalize-legacy"
    seed_task, legacy_task = "fg-seed", "fg-legacy"
    seed_sha, legacy_sha = sha(6080), sha(6081)
    setup_authority(directory, a, seed_task, seed_sha)
    held = HeldFinalize(directory, a, "legacy-write")
    try:
        held.require_ready()
        if run(directory, "write", legacy_task, legacy_sha).returncode != 0:
            raise RuntimeError("held finalize blocked independent legacy write")
        if not exact(directory, legacy_task, legacy_sha, "--require-valid"):
            raise RuntimeError("legacy effect absent before finalize RELEASE")
        held.release()
        rc, _stdout, _stderr = held.wait()
    finally:
        held.close()
    if not exact(directory, legacy_task, legacy_sha, "--require-valid"):
        raise RuntimeError("held finalize lost completed legacy write")
    if rc != 0:
        if run(directory, "read", seed_task, "--require-valid").returncode == 0:
            raise RuntimeError("failed held finalize reported partial validity")
        if run(directory, "finalize-authority", a).returncode != 0:
            raise RuntimeError("held finalize safe-failure could not retry")
    if not exact(directory, seed_task, seed_sha, "--require-valid"):
        raise RuntimeError("held finalize seed missing")

