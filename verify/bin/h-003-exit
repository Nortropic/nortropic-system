if run(directory, "read", victim, "--require-valid").returncode == 0 or not pending(directory, victim):
    raise SystemExit("held BEGIN resurrected completed invalidate")
if rc != 0 and run(directory, "begin-authority", "held-begin-B").returncode != 0:
    raise SystemExit("held BEGIN safe-failure could not retry")
if run(directory, "write", "held-begin-current", sha(6031), "--authority", "held-begin-B").returncode != 0:
