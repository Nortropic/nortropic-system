    held.require_ready()
    if run(directory, "invalidate", victim_sha).returncode != 0:
        raise RuntimeError("held BEGIN conflicting invalidate failed")
    if run(directory, "read", victim, "--require-valid").returncode == 0 or not pending(directory, victim):
        raise RuntimeError("held BEGIN invalidate absent before CONTINUE")
    held.continue_one()
    rc, _stdout, _stderr = held.wait()
finally:
