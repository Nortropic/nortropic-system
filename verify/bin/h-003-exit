    sha(6099),
    "--authority",
    "stale-B",
).returncode != 0:
    raise SystemExit("stale no-READY control damaged current authority")

print("forced post-read overlaps preserved; barrier controls passed")
PYMUTATIONBARRIER

mutation19=$(python3 "$WORK/h003-mutation-barrier.py" "$CLI" "$WORK/mutation-barrier" 2>&1); mutation19_rc=$?
if [ "$mutation19_rc" -eq 0 ]; then
  ok "K19 forced contradictory/unorderable ordering: varje completed effect motsvarar legal total order"
else
  no "K19 forced ordering" "${mutation19:-mutation-barrier harness exit $mutation19_rc}"
fi

summera
