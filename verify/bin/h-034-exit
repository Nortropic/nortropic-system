  for key in probe_strings:reject("ALLOWLIST_ESCAPED_"+label+"_"+key.upper(),er,rr,escaped_string(ar,a["probes"][0][key],escape),e)
 # Isolate parser rejection from cross-document mismatch: each C0 value is bound
