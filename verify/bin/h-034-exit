 reject("ALLOWLIST_WRONG_TOP_LEVEL",er,rr,canon([]),e)
 oversize_receipt=rr+b" "*(1024*1024);oversize_e=dict(e);oversize_e["effect_sha256"]=sha(oversize_receipt);reject("RECEIPT_OVERSIZE",canon(oversize_e),oversize_receipt,ar,oversize_e)
