def main():
 try:judge_controls();toolchain_anchor();production_contract()
 except (OSError,ValueError,subprocess.SubprocessError,Rig) as e:print("RIG_ERROR:",e,file=sys.stderr);return 2
 print("MATERIAL_PROPERTIES_JUDGE_ONLY=NONE")
 print(f"H034_GATE_SUMMARY={passed} PASS {failed} FAIL")
 print("H034_GATE_RESULT="+("EXPECTED_RED" if failed else "PASS"))
 return 1 if failed else 0
