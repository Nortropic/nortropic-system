 check(uq.returncode==0 and uq.stdout==uexpected,"K_LEGITIMATE_UNICODE_BOUND_STRINGS")
 wrong_digest=dict(e);right=e["effect_sha256"];wrong_digest["effect_sha256"]=("0" if right[0]!="0" else "1")+right[1:]
