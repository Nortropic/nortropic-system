  check(compile_ok,"K_PRODUCTION_RECIPE_EXECUTES",p1.stderr+p2.stderr)
  unsigned_ok=compile_ok and sha(one.read_bytes())==sha(two.read_bytes());check(unsigned_ok,"K_DETERMINISTIC_UNSIGNED_REBUILD")
  s1=sign_rebuild(recipe,one) if compile_ok else p1;s2=sign_rebuild(recipe,two) if compile_ok else p2
  rebuilt=[macho_observation(one),macho_observation(two)] if s1.returncode==s2.returncode==0 else []
  stable=("architecture","file_type","code_signature","dylinker","uuid","dependencies","macho_build_version")
  stable_ok=len(rebuilt)==2 and all(rebuilt[0][k]==rebuilt[1][k]==observed[k] for k in stable)
  check(stable_ok,"K_SIGNED_REBUILD_STABLE_IDENTITY",(s1.stderr+s2.stderr)[-500:])
  x1=run([str(one)],timeout=2,rig_timeout=False)[0] if rebuilt else s1;x2=run([str(two)],timeout=2,rig_timeout=False)[0] if rebuilt else s2
  check(rebuilt and x1.returncode==x2.returncode==1,"K_SIGNED_REBUILDS_LOADABLE",(x1.returncode,x2.returncode))
 semantic_contract()

def kernel_call(e_raw:bytes,r_raw:bytes,a_raw:bytes,e:dict,extra=(),result=None,kernel=None,replace=False,seek=False,nonregular=None,omit=(),argv_values=None,duplicate=()):
 with tempfile.TemporaryDirectory(prefix="h034-semantic-") as d:
  w=Path(d);paths=[];fds=[];owned=[]
  for name,raw in (("evidence",e_raw),("receipt",r_raw),("allowlist",a_raw)):
   p=w/name;p.write_bytes(raw);paths.append(p);fds.append(os.open(p,os.O_RDONLY))
  if nonregular:
   index={"evidence":0,"receipt":1,"allowlist":2}[nonregular[0]];os.close(fds[index]);kind=nonregular[1]
   if kind=="directory":fds[index]=os.open(w,os.O_RDONLY)
   elif kind=="pipe":
    rfd,wfd=os.pipe();os.write(wfd,(e_raw,r_raw,a_raw)[index]);os.close(wfd);fds[index]=rfd
   elif kind=="socket":
    left,right=socket.socketpair();right.sendall((e_raw,r_raw,a_raw)[index]);right.shutdown(socket.SHUT_WR);fds[index]=left.fileno();owned.extend((left,right))
  if replace:
   for p in paths:p.unlink();p.write_bytes(b"hostile pathname replacement\n")
  if seek:
   for fd in fds:
    try:os.lseek(fd,7,os.SEEK_SET)
    except OSError:pass
  values={"evidence-fd":str(fds[0]),"receipt-fd":str(fds[1]),"allowlist-fd":str(fds[2]),"task":"h-033","candidate":e["candidate_sha"],"task-spec-sha256":e["task_spec_sha256"],"gate-sha256":e["gate_sha256"],"probe":e["probe_identity"],"request-id":e["request_id"],"require-result":result or e["result"]}
  values.update(argv_values or {});argv=[str(kernel or KERNEL),"h033-verify"]
  for key,value in values.items():
   if key not in omit:argv.extend(("--"+key,value))
  for key in duplicate:argv.extend(("--"+key,values[key]))
  argv.extend(extra)
  try:q=run(argv,pass_fds=tuple(fds),timeout=3,rig_timeout=False)[0]
  finally:
   for obj in owned:obj.close()
   for fd in fds:
    try:os.close(fd)
    except OSError:pass
  return q

def reject(name,e_raw,r_raw,a_raw,bindings):
 q=kernel_call(e_raw,r_raw,a_raw,bindings);check(q.returncode==1 and q.stdout=="","K_REJECT_"+name,(q.returncode,q.stdout,q.stderr))

def escaped_string(raw:bytes,value:str,escape:bytes)->bytes:
 token=json.dumps(value,ensure_ascii=False,separators=(",",":")).encode()
 replacement=b'"'+value.encode("utf-8")+escape+b'evil"'
 if raw.count(token)!=1:raise Rig("escaped-string target is not unique")
 return raw.replace(token,replacement,1)

def coordinated_escaped_control_documents(codepoint:int,field:str):
 e,r,a=documents();suffix=chr(codepoint)+"evil"
 if field=="probe_identity":
  probe=e["probe_identity"]+suffix
  e["probe_identity"]=r["probe_identity"]=a["probes"][0]["probe_identity"]=probe
 elif field=="probe_path":
  path=r["probe_path"]+suffix
  r["probe_path"]=a["probes"][0]["probe_path"]=path
 elif field=="effect_marker":
  marker=r["effect_marker"]+suffix
  r["effect_marker"]=a["probes"][0]["effect_marker"]=marker
 else:raise Rig("unknown coordinated control field")
 rr=canon(r);e["effect_sha256"]=sha(rr)
 return canon(e),rr,canon(a),e

def semantic_contract():
 for result in ("PASS","FAIL","ODÖMBART"):
  e,r,a=documents(result=result);q=kernel_call(canon(e),canon(r),canon(a),e)
  expected=f"VERIFIED_RESULT={result}\nREQUEST_ID={e['request_id']}\nEFFECT_SHA256={e['effect_sha256']}\n"
  check(q.returncode==0 and q.stdout==expected,"K_FRESH_TRISTATE_"+result,(q.returncode,q.stdout,q.stderr))
  wrong="FAIL" if result=="PASS" else "PASS";q=kernel_call(canon(e),canon(r),canon(a),e,result=wrong)
  check(q.returncode==1 and q.stdout=="","K_CROSS_RESULT_REJECT_"+result)
 e,r,a=documents();er,rr,ar=canon(e),canon(r),canon(a)
