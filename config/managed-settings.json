{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(//Users/elinhaggstrom/nortropic-repos/nortropic-system/verify/**)",
      "Edit(//Users/elinhaggstrom/nortropic-repos/nortropic-system/specs/**)",
      "Edit(//Users/elinhaggstrom/nortropic-repos/nortropic-system/controller/verify/register.json)",
      "Edit(//Users/elinhaggstrom/nortropic-repos/nortropic-system/scripts/check-invariants.mjs)",
      "Edit(//Users/elinhaggstrom/nortropic-repos/nortropic-system/.gitignore)",
      "Edit(//Users/elinhaggstrom/nortropic-repos/nortropic-system/CLAUDE.md)",
      "Read(//Users/elinhaggstrom/.ssh/**)",
      "Read(//Users/elinhaggstrom/.aws/**)",
      "Read(//Users/elinhaggstrom/.config/gh/**)",
      "Read(//Users/elinhaggstrom/.claude/sessions/**)",
      "Read(//Users/elinhaggstrom/.claude/session-env/**)",
      "Read(//Users/elinhaggstrom/.claude/backups/**)",
      "Read(//Users/elinhaggstrom/.claude/debug/**)",
      "Read(//Users/elinhaggstrom/.claude/projects/**)",
      "Read(//Users/elinhaggstrom/.claude.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(dscl:*)",
      "Bash(visudo:*)",
      "Bash(launchctl:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "allowManagedReadPathsOnly": true,
    "filesystem": {
      "denyWrite": [
        "/Users/elinhaggstrom/nortropic-repos/nortropic-system/verify",
        "/Users/elinhaggstrom/nortropic-repos/nortropic-system/specs",
        "/Users/elinhaggstrom/nortropic-repos/nortropic-system/controller/verify/register.json",
        "/Users/elinhaggstrom/nortropic-repos/nortropic-system/scripts/check-invariants.mjs",
        "/Users/elinhaggstrom/nortropic-repos/nortropic-system/.gitignore",
        "/Users/elinhaggstrom/nortropic-repos/nortropic-system/CLAUDE.md"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        }
      ]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com"
      ],
      "strictAllowlist": true,
      "allowManagedDomainsOnly": true
    }
  },
  "requiredMinimumVersion": "2.1.224",
  "requiredMaximumVersion": "2.1.224",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
