class Riggfel(ValueError):
    """Verifierarens urvals-/startvägran, skild från taskens 0/1/2."""


class Integritetsfel(Riggfel):
    """Drift eller trasig authority som aldrig får bli ett vanligt urvalsutfall."""


class Avbruten(BaseException):
    """Signal som ska städa taskdomsvyn och behålla 128+signal som exitkod."""

    def __init__(self, signum: int):
        super().__init__(signum)
        self.signum = signum


def vagra(text: str, kod: int = VAGRAN) -> int:
    print(text, file=sys.stderr)
    return kod


def utan_dubbla_nycklar(par: list[tuple[str, object]]) -> dict:
    d = {}
    for nyckel, varde in par:
        if nyckel in d:
            raise Riggfel(f"JSON-nyckeln {nyckel!r} förekommer mer än en gång")
        d[nyckel] = varde
    return d


def parse_json(raw: bytes, namn: str) -> object:
    try:
        return json.loads(raw.decode("utf-8"), object_pairs_hook=utan_dubbla_nycklar)
    except Riggfel:
        raise
    except (ValueError, UnicodeError) as e:
        raise Riggfel(f"{namn} är inte giltig UTF-8-JSON: {e}") from e


def las_json(fil: Path, namn: str) -> object:
    try:
        raw = fil.read_bytes()
    except OSError as e:
        raise Riggfel(f"{namn} kunde inte läsas ({fil}): {e}") from e
    return parse_json(raw, namn)


def saker_relpath(text: object) -> PurePosixPath | None:
    """En normaliserad, repo-relativ path utan shelltecken eller traversal."""
    if not isinstance(text, str) or not text or PATH_FORM.fullmatch(text) is None:
        return None
    p = PurePosixPath(text)
    if p.is_absolute() or p.as_posix() != text or any(del_ in ("", ".", "..") for del_ in p.parts):
        return None
    return p


def saker_registerfil(text: object, root: Path = ROT) -> Path | None:
    """Vanlig fil under root, utan symlänk i någon sökvägskomponent."""
    rel = saker_relpath(text)
    if rel is None:
        return None
    p = root
    for nr, del_ in enumerate(rel.parts):
        p = p / del_
        try:
            lage = p.lstat().st_mode
        except OSError:
            return None
        if stat.S_ISLNK(lage):
            return None
        if nr < len(rel.parts) - 1 and not stat.S_ISDIR(lage):
            return None
    try:
        return p if stat.S_ISREG(p.lstat().st_mode) else None
    except OSError:
        return None


def las_regelbundna_bytes(p: Path) -> bytes:
    """Läs en redan lstat-prövad fil utan att följa en sistasekundssymlänk."""
    flaggor = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(p, flaggor)
    except OSError as e:
        raise Integritetsfel(f"fil kunde inte öppnas säkert: {p}: {e}") from e
    try:
        lage = os.fstat(fd).st_mode
        if not stat.S_ISREG(lage):
            raise Integritetsfel(f"filen är inte längre reguljär: {p}")
        with os.fdopen(fd, "rb", closefd=False) as f:
            return f.read()
    finally:
        os.close(fd)


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def las_register_fran(registerfil: Path) -> tuple[dict[str, dict], str]:
    try:
        lage = registerfil.lstat().st_mode
    except OSError as e:
        raise Integritetsfel(f"registret kunde inte läsas ({registerfil}): {e}") from e
    if stat.S_ISLNK(lage) or not stat.S_ISREG(lage):
        raise Integritetsfel(f"registret är inte en vanlig, icke-symlänkad fil: {registerfil}")
    raw = las_regelbundna_bytes(registerfil)
    try:
        data = parse_json(raw, "registret")
    except Riggfel as e:
        raise Integritetsfel(f"registerstruktur: {e}") from e
    if not isinstance(data, dict) or not isinstance(data.get("verifiers"), dict):
        raise Integritetsfel("registerstruktur: toppnivån måste bära dict-fältet verifiers")

    register = data["verifiers"]
    for vid, post in register.items():
        if not isinstance(vid, str) or not vid:
            raise Integritetsfel("registerstruktur: varje verifier-id måste vara en icke-tom sträng")
        if not isinstance(post, dict):
            raise Integritetsfel(f"registerstruktur: posten för {vid} är ingen dict")
        path = post.get("path")
        if not isinstance(path, str) or not path:
            raise Integritetsfel(f"registerstruktur: path för {vid} måste vara en icke-tom sträng")
        registrerad_sha = post.get("sha256")
        if not isinstance(registrerad_sha, str) or SHA256_FORM.fullmatch(registrerad_sha) is None:
            raise Integritetsfel(f"registerstruktur: ogiltig sha256 för {vid}")
        if not isinstance(post.get("startbar"), bool):
            raise Integritetsfel(f"registerstruktur: startbar för {vid} måste vara bool")
        runner = post.get("runner")
        if runner is not None and (not isinstance(runner, str) or not runner):
            raise Integritetsfel(f"registerstruktur: runner för {vid} måste vara sträng eller null")
        if post["startbar"] and runner is None:
            raise Integritetsfel(f"registerstruktur: startbar post {vid} saknar runner")
    return register, sha256_bytes(raw)


def las_register() -> tuple[dict[str, dict], str]:
    return las_register_fran(REGISTER)


def filidentitet(root: Path, vid: str, post: dict) -> tuple[Path, bytes, str]:
    fil = saker_registerfil(post["path"], root)
    if fil is None:
        raise Integritetsfel(f"osäker eller saknad registerfil för {vid}: {post['path']}")
    raw = las_regelbundna_bytes(fil)
    faktisk_sha = sha256_bytes(raw)
    if faktisk_sha != post["sha256"]:
        raise Integritetsfel(
            f"hash_mismatch: {post['path']}\n"
            f"  registrerad: {post['sha256']}\n"
            f"  på disk:     {faktisk_sha}"
        )
    return fil, raw, faktisk_sha


def validera_hela_register(register: dict[str, dict], root: Path = ROT) -> None:
    """Unik path, repo-regularitet och hash för VARJE post."""
    paths: dict[str, str] = {}
    for vid, post in register.items():
        path = post["path"]
        if path in paths:
            raise Integritetsfel(
                f"dubblerad registerpath: {path} används av både {paths[path]} och {vid}"
            )
        paths[path] = vid
        filidentitet(root, vid, post)


def startbar_post(
    register: dict[str, dict], vid: str, root: Path = ROT
) -> tuple[dict, Path, str, bytes]:
    if vid not in register:
        raise Riggfel(f"okänt verifier-id: {vid} — verifierare körs bara ur registret")
    post = register[vid]
    fil, raw, _faktisk_sha = filidentitet(root, vid, post)
    if not post["startbar"]:
        raise Riggfel(f"ej startbar: {vid} — {post.get('skal_ej_startbar', 'ingen subprocess-ingång')}")
    runner = RUNNERS.get(post.get("runner"))
    if runner is None:
        raise Riggfel(f"okänd runner för {vid}: {post.get('runner')}")
    return post, fil, runner, raw


def krav_registerdigest(faktisk: str, vantad: str) -> None:
    if SHA256_FORM.fullmatch(vantad) is None:
        raise Integritetsfel(f"ogiltig förväntad register-sha256: {vantad!r}")
    if faktisk != vantad:
        raise Integritetsfel(
            f"registerdrift: preflight band {vantad}, aktuella bytes är {faktisk}"
        )


def kmd_list(register: dict[str, dict]) -> int:
    for vid, post in register.items():
        lage = "startbar" if post["startbar"] else "EJ STARTBAR"
