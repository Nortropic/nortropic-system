def kmd_check(register: dict[str, dict], vid: str) -> int:
    if vid not in register:
        raise Riggfel(f"okänt verifier-id: {vid}")
    post = register[vid]
    _fil, _raw, faktisk_sha = filidentitet(ROT, vid, post)
    # En ensam 64-hex-token binder den faktiska hash som loopen bokför.
    print(f"ok: {vid} {post['path']} {faktisk_sha}")
    return PASS


def las_task(spec_fil: Path, task_id: str) -> dict:
    data = las_json(spec_fil, "specen")
    if not isinstance(data, dict) or not isinstance(data.get("tasks"), list):
        raise Riggfel("specstruktur: toppnivån måste bära listan tasks")
    traffar = []
    for nr, task in enumerate(data["tasks"], start=1):
        if not isinstance(task, dict) or not isinstance(task.get("id"), str) or not task["id"]:
            raise Riggfel(f"specstruktur: task {nr} saknar id som icke-tom sträng")
        if task["id"] == task_id:
            traffar.append(task)
    if len(traffar) != 1:
        raise Riggfel(f"specstruktur: task-id {task_id} gav {len(traffar)} träffar, väntat exakt en")
    return traffar[0]


def kmd_task(
    register: dict[str, dict], register_sha: str, spec_fil: Path, task_id: str,
    vantat_register: str | None = None,
) -> int:
    if vantat_register is not None:
        krav_registerdigest(register_sha, vantat_register)
    task = las_task(spec_fil, task_id)
    path = task.get("exit_test")
    if saker_relpath(path) is None:
        raise Riggfel(f"osäker exit_test för {task_id}: {path!r}")
    traffar = [(vid, post) for vid, post in register.items() if post["path"] == path]
    if not traffar:
        svar = {"status": "ogrindad"}
        if vantat_register is not None:
            svar["register_sha256"] = register_sha
        print(json.dumps(svar, sort_keys=True))
        return PASS
    if len(traffar) != 1:
        raise Integritetsfel(f"exit_test {path} gav {len(traffar)} exakta registerträffar")
    vid, post = traffar[0]
    # Startbarhet och faktiska bytes prövas först när posten valts för tasken.
    startbar_post(register, vid)
    svar = {
        "status": "grindad",
        "grind_id": vid,
        "grind_sha256": post["sha256"],
    }
    if vantat_register is not None:
        svar["register_sha256"] = register_sha
    print(json.dumps(svar, sort_keys=True))
    return PASS


def _doda_gruppen(p: subprocess.Popen, sig: int) -> None:
    try:
        os.killpg(os.getpgid(p.pid), sig)
    except (ProcessLookupError, PermissionError):
        try:
            (p.terminate if sig == signal.SIGTERM else p.kill)()
        except ProcessLookupError:
            pass


def _grupp_lever(pid: int) -> bool:
    try:
        os.killpg(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _doda_barnet() -> None:
    p = _barn
    if p is None:
        return
    if _grupp_lever(p.pid):
        _doda_gruppen(p, signal.SIGTERM)
    if p.poll() is None:
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            _doda_gruppen(p, signal.SIGKILL)
            p.wait()
    if _grupp_lever(p.pid):
        _doda_gruppen(p, signal.SIGKILL)


def _vanta_grupp_borta(pid: int, sekunder: float) -> bool:
    slut = time.monotonic() + sekunder
    while _grupp_lever(pid) and time.monotonic() < slut:
        time.sleep(0.02)
    return not _grupp_lever(pid)


def _avbryt(signum: int, _frame) -> None:
    # Ett andra TERM får inte avbryta finally-städningen halvvägs.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    _doda_barnet()
    raise Avbruten(signum)


def sanerad_env(extra: dict[str, str] | None = None) -> dict[str, str]:
    env = os.environ.copy()
    for nyckel in list(env):
        if nyckel in {
            "BASH_ENV", "ENV", "PYTHONPATH", "NODE_OPTIONS", "GIT_DIR",
            "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM",
        } or nyckel == "GIT_CONFIG_COUNT" or nyckel.startswith("GIT_CONFIG_KEY_") \
                or nyckel.startswith("GIT_CONFIG_VALUE_"):
            env.pop(nyckel, None)
    delar = [d for d in env.get("PATH", "").split(os.pathsep) if d and os.path.isabs(d)]
    env["PATH"] = os.pathsep.join(delar) or "/usr/bin:/bin:/usr/sbin:/sbin"
    if extra:
        env.update(extra)
    return env


def kor_grind(runner: str, fil: Path, raw: bytes, mal: Path, env: dict[str, str] | None = None) -> int:
    """Kör godkända bytes; bash läser exakt den redan hashade byteföljden."""
    global _barn
    if runner == "bash":
        # Den statiska -c-strängen gör $0 till snapshotpathen (så _lib.sh
        # laddas bredvid grinden), men gatebytesen kommer från stdin och kan
        # inte bytas mellan hash och bash open(). Fri text blir aldrig argv.
        argv = [runner, "-c", ". /dev/stdin", str(fil)]
        stdin = subprocess.PIPE
    else:
        argv = [runner, str(fil)]
        stdin = None
    try:
        p = subprocess.Popen(
            argv,
            cwd=mal,
            stdin=stdin,
            shell=False,
            start_new_session=True,
            env=env,
        )
    except OSError as e:
        raise Riggfel(f"runnern kunde inte startas: {e}") from e
    _barn = p
    try:
        if runner == "bash":
            p.communicate(input=raw)
        else:
            p.wait()
        kod = p.returncode
        # En grindledare får inte lämna en processgrupp som fortsätter skriva
        # efter domen. Rensa resten, men vägra själva domen.
        if _grupp_lever(p.pid):
            _doda_gruppen(p, signal.SIGTERM)
            if not _vanta_grupp_borta(p.pid, 1):
                _doda_gruppen(p, signal.SIGKILL)
                _vanta_grupp_borta(p.pid, 1)
            raise Integritetsfel("grinden lämnade processer efter sitt verdict")
    finally:
        _barn = None
    if kod not in (PASS, FAIL, ODOMBART):
        raise Riggfel(f"grinden gav okänd verdictkod {kod}, väntat 0, 1 eller 2")
    return kod


def los_malkatalog(mal: Path) -> Path:
    try:
        verklig = mal.resolve(strict=True)
    except OSError as e:
        raise Riggfel(f"målkatalog kunde inte lösas: {mal}: {e}") from e
    if not verklig.is_dir():
        raise Riggfel(f"målkatalog saknas eller är ingen katalog: {verklig}")
    return verklig


def kmd_run(register: dict[str, dict], vid: str, mal: Path = ROT) -> int:
    _post, fil, runner, raw = startbar_post(register, vid)
    return kor_grind(runner, fil, raw, los_malkatalog(mal), sanerad_env())


def git(*argv: object) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(KODROT), *(str(a) for a in argv)],
        capture_output=True,
        text=True,
        shell=False,
        env=sanerad_env(),
    )


def git_avbrytbar(*argv: object) -> subprocess.CompletedProcess:
    global _barn
    p = subprocess.Popen(
        ["git", "-C", str(KODROT), *(str(a) for a in argv)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        shell=False,
        start_new_session=True,
        env=sanerad_env(),
    )
    _barn = p
    try:
        ut, err = p.communicate()
    finally:
        _barn = None
    return subprocess.CompletedProcess(p.args, p.returncode, ut, err)


def commit_sha(sha: str) -> str:
    if COMMIT_FORM.fullmatch(sha) is None:
        raise Integritetsfel(f"kandidatidentiteten är inte en full commit-SHA: {sha!r}")
    r = git("rev-parse", "--verify", "--quiet", f"{sha}^{{commit}}")
    faktisk = r.stdout.strip()
    if r.returncode != 0 or faktisk != sha:
        raise Integritetsfel(f"kandidat-SHA finns inte som exakt commit i repot: {sha}")
    return sha


def worktree_registrerat(vy: Path) -> bool:
    r = git("worktree", "list", "--porcelain")
    return r.returncode == 0 and any(rad == f"worktree {vy}" for rad in r.stdout.splitlines())


def stada_kandidatvy(temp_rot: Path, vy: Path) -> str:
    for _forsok in range(3):
        git("worktree", "remove", "--force", str(vy))
        shutil.rmtree(temp_rot, ignore_errors=True)
        git("worktree", "prune")
        if not temp_rot.exists() and not worktree_registrerat(vy):
            return ""
    return "taskdomsvyn eller dess worktree-registrering blev kvar"


def kor_i_kandidatvy(sha: str, handling) -> int:
    sha = commit_sha(sha)
    temp_rot = Path(tempfile.mkdtemp(prefix="nortropic-taskdom-"))
    vy = temp_rot / "candidate"
    resultat = VAGRAN
    undantag: BaseException | None = None
    try:
        r = git_avbrytbar("worktree", "add", "--detach", str(vy), sha)
        if r.returncode != 0:
            raise Integritetsfel(f"taskdomsvyn kunde inte skapas: {r.stderr.strip()}")
        resultat = handling(vy)
    except BaseException as e:
        undantag = e
    cleanupfel = stada_kandidatvy(temp_rot, vy)
    if cleanupfel:
        raise Integritetsfel(f"taskdomsvyn kunde inte städas: {cleanupfel}")
    if undantag is not None:
        raise undantag
    return resultat


def kopiera_fil(src: Path, dst: Path) -> None:
    raw = las_regelbundna_bytes(src)
    lage = stat.S_IMODE(src.lstat().st_mode)
    dst.parent.mkdir(parents=True, exist_ok=True)
    try:
        with dst.open("xb") as f:
            f.write(raw)
        dst.chmod(lage)
    except OSError as e:
        raise Integritetsfel(f"snapshotfil kunde inte skrivas: {dst}: {e}") from e


def kopiera_trad(src: Path, dst: Path, *, uteslut_git: bool = False) -> None:
    try:
        lage = src.lstat().st_mode
    except OSError as e:
        raise Integritetsfel(f"snapshotkälla saknas: {src}: {e}") from e
    if stat.S_ISLNK(lage):
        # Authority-snapshoten följer aldrig en länk. En oregistrerad länk i
        # repots produktdata (h-017 har en sådan negativ fixtur) utelämnas;
        # en registrerad eller projicerad länk vägras separat av respektive
        # pathkontroll och kan därför aldrig bli körbar authority.
        return
    if stat.S_ISREG(lage):
        kopiera_fil(src, dst)
        return
    if not stat.S_ISDIR(lage):
        raise Integritetsfel(f"snapshotkälla är specialfil: {src}")
    dst.mkdir(mode=stat.S_IMODE(lage), parents=True, exist_ok=False)
    for barn in sorted(src.iterdir(), key=lambda p: p.name):
        if uteslut_git and src == KODROT and barn.name == ".git":
            continue
        kopiera_trad(barn, dst / barn.name, uteslut_git=uteslut_git)
    dst.chmod(stat.S_IMODE(lage))


def trad_manifest(root: Path) -> str:
    poster: list[list[str]] = []

    def ga(p: Path, rel: PurePosixPath) -> None:
        try:
            lage = p.lstat().st_mode
        except OSError as e:
            raise Integritetsfel(f"snapshotmanifest kunde inte läsa {p}: {e}") from e
        mode = f"{stat.S_IMODE(lage):04o}"
        if stat.S_ISLNK(lage):
            raise Integritetsfel(f"snapshotmanifest vägrar symlänk: {rel}")
        if stat.S_ISDIR(lage):
            poster.append(["d", rel.as_posix(), mode])
            for barn in sorted(p.iterdir(), key=lambda q: q.name):
                ga(barn, rel / barn.name)
            return
        if stat.S_ISREG(lage):
            poster.append(["f", rel.as_posix(), mode, sha256_bytes(las_regelbundna_bytes(p))])
            return
        raise Integritetsfel(f"snapshotmanifest vägrar specialfil: {rel}")

    ga(root, PurePosixPath("."))
    raw = json.dumps(poster, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    return sha256_bytes(raw)


def projektionspaths(register: dict[str, dict]) -> list[PurePosixPath]:
    paths = [PurePosixPath(p) for p in PRETASK_PATHS]
    paths.extend(PurePosixPath(post["path"]) for post in register.values())
    unika: list[PurePosixPath] = []
    for rel in sorted(set(paths), key=lambda p: (len(p.parts), p.as_posix())):
        if any(rel == rot or rot in rel.parents for rot in unika):
            continue
        unika.append(rel)
    return unika


def snapshot_roots(register: dict[str, dict]) -> list[PurePosixPath]:
    """Minsta authority-subträd som bär kontrollplanet och gateberoenden."""
    paths = [
        PurePosixPath("controller"),
        PurePosixPath("verify"),
        PurePosixPath("specs"),
        PurePosixPath("scripts"),
        PurePosixPath("config/managed-settings.json"),
        PurePosixPath("docs/loop/regler.md"),
    ]
    for post in register.values():
        gate = PurePosixPath(post["path"])
        paths.append(gate.parent if gate.parent != PurePosixPath(".") else gate)

    rotter: list[PurePosixPath] = []
    katalogrotter: list[PurePosixPath] = []
    for rel in sorted(set(paths), key=lambda p: (len(p.parts), p.as_posix())):
        if any(rel == rot or rot in rel.parents for rot in katalogrotter):
            continue
        rotter.append(rel)
        src = KODROT.joinpath(*rel.parts)
        try:
            if stat.S_ISDIR(src.lstat().st_mode) and not stat.S_ISLNK(src.lstat().st_mode):
                katalogrotter.append(rel)
        except OSError as e:
            raise Integritetsfel(f"authority-root saknas: {rel}: {e}") from e
    return rotter


def snapshot_katalog(text: str, *, maste_finnas: bool) -> Path:
    p = Path(text)
    if not p.is_absolute() or p.name in ("", ".", ".."):
        raise Integritetsfel(f"snapshotpath måste vara en explicit absolut katalog: {text!r}")
    try:
        parent = p.parent.resolve(strict=True)
    except OSError as e:
        raise Integritetsfel(f"snapshotparent kunde inte lösas: {p.parent}: {e}") from e
    p = parent / p.name
    if maste_finnas:
        try:
            lage = p.lstat().st_mode
        except OSError as e:
            raise Integritetsfel(f"snapshot saknas: {p}: {e}") from e
        if stat.S_ISLNK(lage) or not stat.S_ISDIR(lage):
            raise Integritetsfel(f"snapshot är inte en vanlig katalog: {p}")
    elif p.exists() or p.is_symlink():
        raise Integritetsfel(f"snapshotmålet finns redan: {p}")
    return p


def kmd_prepare(
    register: dict[str, dict], register_sha: str, vantat_register: str, snapshot_text: str
) -> int:
    krav_registerdigest(register_sha, vantat_register)
    validera_hela_register(register)
    snapshot = snapshot_katalog(snapshot_text, maste_finnas=False)
    skapad = False
    try:
        # Authorityn fångas före första claim/session. Gateentrypoints och
        # deras $0-relativa parentträd kommer ur samma privata ögonblick.
        snapshot.mkdir(mode=0o700)
        skapad = True
        for rel in snapshot_roots(register):
            kopiera_trad(KODROT.joinpath(*rel.parts), snapshot.joinpath(*rel.parts))
        snap_register, snap_sha = las_register_fran(snapshot.joinpath(*REGISTER_REL.parts))
        krav_registerdigest(snap_sha, vantat_register)
        validera_hela_register(snap_register, snapshot)
        snapshot_sha = trad_manifest(snapshot)
    except BaseException:
        if skapad or snapshot.exists():
            shutil.rmtree(snapshot, ignore_errors=True)
        raise
    print(json.dumps({"status": "ok", "snapshot_sha256": snapshot_sha}, sort_keys=True))
    return PASS


def las_snapshot(
    snapshot_text: str, vantad_snapshot_sha: str, vantat_register: str
) -> tuple[Path, dict[str, dict], list[PurePosixPath]]:
    if SHA256_FORM.fullmatch(vantad_snapshot_sha) is None:
        raise Integritetsfel(f"ogiltig snapshot-sha256: {vantad_snapshot_sha!r}")
    snapshot = snapshot_katalog(snapshot_text, maste_finnas=True)
    faktisk_snapshot_sha = trad_manifest(snapshot)
    if faktisk_snapshot_sha != vantad_snapshot_sha:
        raise Integritetsfel(
            f"authority-snapshot drev: väntad {vantad_snapshot_sha}, nu {faktisk_snapshot_sha}"
        )
    register, register_sha = las_register_fran(snapshot.joinpath(*REGISTER_REL.parts))
    krav_registerdigest(register_sha, vantat_register)
    validera_hela_register(register, snapshot)
    return snapshot, register, projektionspaths(register)


def saker_ta_bort(vy: Path, rel: PurePosixPath) -> Path:
    """Ta bort destination utan att följa en kandidatägd symlänkancestor."""
    p = vy
    for del_ in rel.parts[:-1]:
        p = p / del_
        try:
            lage = p.lstat().st_mode
        except FileNotFoundError:
            p.mkdir()
            continue
        except OSError as e:
            raise Integritetsfel(f"projektionsparent kunde inte läsas: {p}: {e}") from e
        if stat.S_ISLNK(lage) or not stat.S_ISDIR(lage):
            raise Integritetsfel(f"kandidatens projektionsparent är inte säker katalog: {p}")
    mal = vy.joinpath(*rel.parts)
    try:
        lage = mal.lstat().st_mode
    except FileNotFoundError:
        return mal
    except OSError as e:
        raise Integritetsfel(f"projektionsmål kunde inte läsas: {mal}: {e}") from e
    if stat.S_ISDIR(lage) and not stat.S_ISLNK(lage):
        shutil.rmtree(mal)
    else:
        mal.unlink()
    return mal


def projicera(snapshot: Path, vy: Path, paths: list[PurePosixPath]) -> None:
    for rel in paths:
        src = snapshot.joinpath(*rel.parts)
        mal = saker_ta_bort(vy, rel)
        try:
            src.lstat()
        except FileNotFoundError:
            # Frånvaro i pre-task-authority maskar också en kandidat som
            # försöker skapa samma control-plane-path.
            continue
        kopiera_trad(src, mal)


def projektionsmanifest(root: Path, paths: list[PurePosixPath]) -> str:
    poster: list[list[str]] = []
    for rel in paths:
        p = root.joinpath(*rel.parts)
        try:
            lage = p.lstat().st_mode
        except FileNotFoundError:
            poster.append(["m", rel.as_posix()])
            continue
        if stat.S_ISLNK(lage):
            raise Integritetsfel(f"projektionen innehåller symlänk: {rel}")
        if stat.S_ISDIR(lage):
            poster.append(["r", rel.as_posix(), trad_manifest(p)])
        elif stat.S_ISREG(lage):
            poster.append([
                "f", rel.as_posix(), f"{stat.S_IMODE(lage):04o}",
                sha256_bytes(las_regelbundna_bytes(p)),
            ])
        else:
            raise Integritetsfel(f"projektionen innehåller specialfil: {rel}")
    return sha256_bytes(json.dumps(poster, separators=(",", ":")).encode("utf-8"))


def live_lib_snapshotlik(snapshot: Path) -> None:
    """Den frysta G20-gaten har en absolut live-_lib-referens; bind dess bytes."""
    rel = PurePosixPath("verify/bin/_lib.sh")
    live = saker_registerfil(rel.as_posix(), KODROT)
    snap = saker_registerfil(rel.as_posix(), snapshot)
    if live is None or snap is None:
        raise Integritetsfel("verify/bin/_lib.sh saknas eller är osäker i live/snapshot")
    if las_regelbundna_bytes(live) != las_regelbundna_bytes(snap):
        raise Integritetsfel("verify/bin/_lib.sh drev sedan pre-task-snapshoten")


def kmd_run_commit(
    live_register: dict[str, dict], live_register_sha: str, vantat_register: str,
    vid: str, kandidat_sha: str, vantad_snapshot_sha: str, snapshot_text: str,
) -> int:
    krav_registerdigest(live_register_sha, vantat_register)
    # Bind även use-punkten till livefilens aktuella bytes. Snapshoten väljer
    # vad som körs, men drift får inte döljas genom att bara använda kopian.
    startbar_post(live_register, vid)
    snapshot, register, _paths = las_snapshot(
        snapshot_text, vantad_snapshot_sha, vantat_register
    )
    _post, fil, runner, raw = startbar_post(register, vid, snapshot)

    def kor(vy: Path) -> int:
        return kor_grind(runner, fil, raw, vy, sanerad_env())

    kod = kor_i_kandidatvy(kandidat_sha, kor)
    if trad_manifest(snapshot) != vantad_snapshot_sha:
        raise Integritetsfel("authority-snapshoten ändrades under global verifiering")
    return kod


def kmd_task_run(
    live_register: dict[str, dict], live_register_sha: str, vantat_register: str,
    vid: str, vantad_grind_sha: str, kandidat_sha: str,
    vantad_snapshot_sha: str, snapshot_text: str,
) -> int:
    krav_registerdigest(live_register_sha, vantat_register)
    live_post, _live_fil, _live_runner, _live_raw = startbar_post(live_register, vid)
    if live_post["sha256"] != vantad_grind_sha:
        raise Integritetsfel(
            f"taskgrindens live-identitet drev: väntad {vantad_grind_sha}, "
            f"nu {live_post['sha256']}"
        )
    snapshot, register, paths = las_snapshot(
        snapshot_text, vantad_snapshot_sha, vantat_register
    )
    post, fil, runner, raw = startbar_post(register, vid, snapshot)
    if post["sha256"] != vantad_grind_sha:
        raise Integritetsfel(
            f"taskgrindens identitet drev: väntad {vantad_grind_sha}, nu {post['sha256']}"
        )
    authority_projection = projektionsmanifest(snapshot, paths)
    live_lib_snapshotlik(snapshot)

    def kor(vy: Path) -> int:
        projicera(snapshot, vy, paths)
        if projektionsmanifest(vy, paths) != authority_projection:
            raise Integritetsfel("kandidatens control-plane-projektion matchar inte authorityn")
        env = sanerad_env({"NORTROPIC_VERIFY_AUTHORITY_ROOT": str(snapshot)})
        domkod = kor_grind(runner, fil, raw, vy, env)
        if projektionsmanifest(vy, paths) != authority_projection:
            raise Integritetsfel("taskgrinden ändrade sin pre-task control plane")
        return domkod

    kod = kor_i_kandidatvy(kandidat_sha, kor)
    live_lib_snapshotlik(snapshot)
    if trad_manifest(snapshot) != vantad_snapshot_sha:
        raise Integritetsfel("authority-snapshoten ändrades under taskdomen")
    return kod


class PlatformRefusal(ValueError):
    pass


def platform_file(root: Path, rel: str, missing: str, shape: str) -> tuple[bytes, int]:
    path = root
    parts = PurePosixPath(rel).parts
    expected_mode = 0o755 if rel in ("controller/policy/cli", "controller/verify/cli") else 0o644
    try:
        for index, part in enumerate(parts):
            path = path / part
            mode = path.lstat().st_mode
            if stat.S_ISLNK(mode) or (index < len(parts) - 1 and not stat.S_ISDIR(mode)):
                raise PlatformRefusal(shape)
        if not stat.S_ISREG(mode) or stat.S_IMODE(mode) != expected_mode:
            raise PlatformRefusal(shape)
        raw = las_regelbundna_bytes(path)
    except FileNotFoundError as exc:
        raise PlatformRefusal(missing) from exc
    except (OSError, Integritetsfel) as exc:
        raise PlatformRefusal(shape) from exc
    return raw, expected_mode


def platform_source(spec_sha: str, task: str, register_sha: str) -> dict[str, tuple[bytes, int]]:
    if task != "h-035":
        raise PlatformRefusal("TASK_ID")
    if spec_sha != PLATFORM_SPEC:
        raise PlatformRefusal("SPEC_IDENTITY")
    if register_sha != PLATFORM_REGISTER:
        raise PlatformRefusal("REGISTER_IDENTITY")
    source = {}
    for rel, expected, reason in (
        ("specs/tasks.spec.json", PLATFORM_SPEC, "SPEC_IDENTITY"),
        ("controller/verify/register.json", PLATFORM_REGISTER, "REGISTER_IDENTITY"),
    ):
        entry = platform_file(KODROT, rel, reason, "SOURCE_TYPE_OR_MODE")
        if sha256_bytes(entry[0]) != expected:
            raise PlatformRefusal(reason)
        source[rel] = entry
    # Exact complete spec bytes above bind the local amendment as well as every
    # preexisting field. The unchanged registry parser checks structure only;
    # platform qualification does not execute or require registered web files.
    try:
        spec = parse_json(source["specs/tasks.spec.json"][0], "platform spec")
        rows = [row for row in spec["tasks"] if row["id"] == "h-035"]
        if len(rows) != 1 or rows[0]["local_document_authority_v1"]["status"] != "LOCAL_ONLY_QUALIFICATION_EXPERIMENT":
            raise PlatformRefusal("SPEC_IDENTITY")
        las_register_fran(KODROT / "controller/verify/register.json")
    except (Riggfel, KeyError, TypeError) as exc:
        raise PlatformRefusal("SPEC_IDENTITY") from exc
    for rel, digest in PLATFORM_DOCUMENTS.items():
        entry = platform_file(KODROT, rel, "DOCUMENT_GENERATION", "SOURCE_TYPE_OR_MODE")
        if sha256_bytes(entry[0]) != digest:
            raise PlatformRefusal("DOCUMENT_GENERATION")
        source[rel] = entry
    for rel in PLATFORM_CONTROL:
        if rel not in source:
            source[rel] = platform_file(KODROT, rel, "SNAPSHOT_AUTHORITY", "SOURCE_TYPE_OR_MODE")
    return source


def platform_snapshot(snapshot: Path, source: dict[str, tuple[bytes, int]], digest: str) -> None:
    if SHA256_FORM.fullmatch(digest) is None:
        raise PlatformRefusal("SNAPSHOT_AUTHORITY")
    # Check generation independently of the caller's self-consistent digest.
    for rel, expected in PLATFORM_DOCUMENTS.items():
        raw, _mode = platform_file(snapshot, rel, "DOCUMENT_GENERATION", "SNAPSHOT_AUTHORITY")
        if sha256_bytes(raw) != expected:
            raise PlatformRefusal("DOCUMENT_GENERATION")
    expected_dirs = {"."}
    for rel in source:
        expected_dirs.update(p.as_posix() for p in PurePosixPath(rel).parents)
    files, dirs = set(), {"."}
    for path in snapshot.rglob("*"):
        rel = path.relative_to(snapshot).as_posix()
        mode = path.lstat().st_mode
        if stat.S_ISDIR(mode):
            dirs.add(rel)
        elif stat.S_ISREG(mode):
            files.add(rel)
        else:
            raise PlatformRefusal("SNAPSHOT_AUTHORITY")
    if files != set(source) or dirs != expected_dirs:
        raise PlatformRefusal("SNAPSHOT_AUTHORITY")
    for rel, entry in source.items():
        if platform_file(snapshot, rel, "SNAPSHOT_AUTHORITY", "SNAPSHOT_AUTHORITY") != entry:
            raise PlatformRefusal("SNAPSHOT_AUTHORITY")
    if trad_manifest(snapshot) != digest:
        raise PlatformRefusal("SNAPSHOT_AUTHORITY")


def platform_command(argv: list[str]) -> int:
    try:
        prepare = argv[1] == "platform-prepare"
        if len(argv) != (6 if prepare else 7):
            raise PlatformRefusal("SNAPSHOT_AUTHORITY")
        source = platform_source(argv[2], argv[3], argv[4])
        try:
            snapshot = snapshot_katalog(argv[-1], maste_finnas=not prepare)
        except Integritetsfel as exc:
            raise PlatformRefusal("SNAPSHOT_AUTHORITY") from exc
        if prepare:
            # Authenticate all inputs before the sole exclusive creation. Never
            # remove an existing destination or clean up partially made evidence.
            snapshot.mkdir(mode=0o700)
            for rel, (raw, mode) in source.items():
                target = snapshot / rel
                target.parent.mkdir(parents=True, exist_ok=True)
                with target.open("xb") as stream:
                    stream.write(raw)
                target.chmod(mode)
            digest = trad_manifest(snapshot)
        else:
            digest = argv[5]
        platform_snapshot(snapshot, source, digest)
        if platform_source(argv[2], argv[3], argv[4]) != source:
            raise PlatformRefusal("SNAPSHOT_AUTHORITY")
        print(json.dumps({"status": "ok", "snapshot_sha256": digest}, sort_keys=True))
        return PASS
    except PlatformRefusal as exc:
        print(json.dumps({"status": "refused", "reason": str(exc)}, sort_keys=True))
        return INTEGRITET
    except (OSError, Integritetsfel):
        print(json.dumps({"status": "refused", "reason": "SNAPSHOT_AUTHORITY"}, sort_keys=True))
        return INTEGRITET


def main(argv: list[str]) -> int:
    if len(argv) >= 2 and argv[1] in ("platform-prepare", "platform-check"):
        return platform_command(argv)
    if len(argv) < 2:
        return vagra("användning: cli list | preflight | check | task | prepare | run | run-commit | task-run")
    signal.signal(signal.SIGINT, _avbryt)
    signal.signal(signal.SIGTERM, _avbryt)
    try:
        register, register_sha = las_register()
        kommando = argv[1]
        if kommando == "list" and len(argv) == 2:
            return kmd_list(register)
        if kommando == "preflight" and len(argv) == 2:
            return kmd_preflight(register, register_sha)
        if kommando == "check" and len(argv) == 3:
            return kmd_check(register, argv[2])
        if kommando == "task" and len(argv) == 4:
            return kmd_task(register, register_sha, Path(argv[2]), argv[3])
        if kommando == "task" and len(argv) == 5:
            return kmd_task(register, register_sha, Path(argv[3]), argv[4], argv[2])
        if kommando == "prepare" and len(argv) == 4:
            return kmd_prepare(register, register_sha, argv[2], argv[3])
        if kommando == "run" and len(argv) in (3, 4):
            return kmd_run(register, argv[2], Path(argv[3]) if len(argv) == 4 else ROT)
        if kommando == "run-commit" and len(argv) == 7:
            return kmd_run_commit(
                register, register_sha, argv[2], argv[3], argv[4], argv[5], argv[6]
            )
        if kommando == "task-run" and len(argv) == 8:
            return kmd_task_run(
                register, register_sha, argv[2], argv[3], argv[4], argv[5], argv[6], argv[7]
            )
        raise Riggfel(f"okänt kommando eller fel argument: {kommando}")
    except Avbruten as e:
        return 128 + e.signum
    except Integritetsfel as e:
        return vagra(str(e), INTEGRITET)
    except Riggfel as e:
        return vagra(str(e), VAGRAN)
    except BrokenPipeError:
        return VAGRAN
    except BaseException as e:
        return vagra(f"internt verifierarfel: {type(e).__name__}: {e}", INTEGRITET)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
