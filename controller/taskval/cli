VALBARA_STATUS = (None, "pending")
OWNER_ACTION_REQUIRED = "OWNER_ACTION_REQUIRED"


class Avbryt(Exception):
    """Fel som blir exit 1 med orsak — aldrig ett tyst tomt val."""


def fel(text: str) -> int:
    print(text, file=sys.stderr)
    return 1


def kor(argv: list[str]) -> subprocess.CompletedProcess:
    """Systerkomponenterna anropas som argv utan skal (v4.1 §2 invariant 3)."""
    try:
        return subprocess.run(argv, capture_output=True, text=True, shell=False)
    except OSError as e:
        raise Avbryt(f"{argv[0]} kunde inte startas — {e}") from e


def orsak(svar: subprocess.CompletedProcess) -> str:
    """Sista raden ur ett systerkommandos stderr.

    Kraschar ett systerkommando är dess stackspår dess eget; att klistra in
    hela i vårt fel gör vår utdata till någon annans. Sista raden bär
    undantaget — det är den som säger något."""
    rader = [r for r in svar.stderr.splitlines() if r.strip()]
    return rader[-1].strip()[:200] if rader else f"inget meddelande (exit {svar.returncode})"


def las_spec(spec: Path) -> list[tuple[str, list[str], str]]:
    """Backloggen som (id, depends_on, authority_class)."""
    try:
        data = json.loads(spec.read_text(encoding="utf-8"))
    except OSError as e:
        raise Avbryt(f"spec: {spec} kunde inte läsas — {e}") from e
    except (json.JSONDecodeError, UnicodeDecodeError) as e:
        raise Avbryt(f"spec: {spec} är inte giltig JSON — {e}") from e
    if not isinstance(data, dict) or not isinstance(data.get("tasks"), list):
        raise Avbryt(f"spec: {spec} saknar listan tasks")

    version = data.get("spec_version")
    tasks: list[tuple[str, list[str], str]] = []
    sedda: set[str] = set()
    for nr, post in enumerate(data["tasks"], start=1):
        if not isinstance(post, dict) or not isinstance(post.get("id"), str) or not post["id"]:
            raise Avbryt(f"spec: task {nr} saknar id som icke-tom sträng")
        tid = post["id"]
        if tid in sedda:
            # Två rader med samma id är två sanningar om samma task — vilken
            # depends_on gäller? Hellre vägran än ett tyst val mellan dem.
            raise Avbryt(f"spec: id {tid} förekommer mer än en gång")
        sedda.add(tid)
        dep = post.get("depends_on", [])
        if not isinstance(dep, list) or not all(isinstance(d, str) and d for d in dep):
            raise Avbryt(f"spec: depends_on för {tid} är ingen lista av id")
        if version == "2.0.0":
            authority = post.get("authority_class")
            if authority not in ("ordinary", "owner_authority"):
                raise Avbryt(f"spec: authority_class för {tid} är ogiltig")
            ordinary = post.get("allowed_write", [])
            owner = post.get("owner_author_allowed_write", [])
            if not isinstance(ordinary, list) or not isinstance(owner, list):
                raise Avbryt(f"spec: skrivytan för {tid} är ogiltig")
            docs = post.get("docs_impact", [])
            if not isinstance(docs, list):
                raise Avbryt(f"spec: docs_impact för {tid} är ogiltig")
            try:
                ordinary = [canonical_path(path) for path in ordinary]
                owner = [canonical_path(path) for path in owner]
                [canonical_path(path) for path in docs]
            except AuthorityError as e:
                raise Avbryt(f"spec: skrivytan för {tid} är ogiltig — {e}") from e
            if authority == "ordinary" and (not ordinary or owner):
                raise Avbryt(f"spec: ordinary-skrivytan för {tid} är ogiltig")
            if authority == "owner_authority" and (ordinary or not owner):
                raise Avbryt(f"spec: owner-skrivytan för {tid} är ogiltig")
        else:
            # Historical/non-v2 inputs remain ordinary.  They can never infer
            # owner authority from a field, role string, or environment value.
            if "authority_class" in post or "owner_author_allowed_write" in post:
                raise Avbryt(f"spec: endast schema v2 får uttrycka owner authority för {tid}")
            ordinary = post.get("allowed_write", [])
            docs = post.get("docs_impact", [])
            if not isinstance(ordinary, list) or not isinstance(docs, list):
                raise Avbryt(f"spec: ordinary-skrivytan för {tid} är ogiltig")
            try:
                [canonical_path(path) for path in ordinary]
                [canonical_path(path) for path in docs]
            except AuthorityError as e:
                raise Avbryt(f"spec: skrivytan för {tid} är ogiltig — {e}") from e
            authority = "ordinary"
        tasks.append((tid, dep, authority))
    return tasks


def attesterad_giltig(attkat: Path, task: str) -> bool:
    """Frågar skiva 3. Stale-semantiken bor där, aldrig i en kopia här."""
    svar = kor([str(ATT), str(attkat), "read", task, "--require-valid"])
    if svar.returncode == 0:
        return True
    # Exit 1 betyder BÅDE "ingen attestation / stale" och "attest kraschade".
    # Att låta dem bli samma utfall vore fail-open: en oläsbar attestbutik
    # hade gjort varje beroendelös task behörig igen och köat om klart arbete.
    # Skiva 3:s två negativa svar inleds båda med "read: "; allt annat är fel.
    if svar.returncode == 1 and svar.stderr.startswith("read: "):
        return False
    raise Avbryt(
        f"attest svarade oväntat för {task} (exit {svar.returncode}): {orsak(svar)}"
    )


def status_ur_state(stkat: Path) -> dict[str, str]:
    """Läser LOGGEN via rebuild, inte projektionen via dump — loggen är sanningen (skiva 1)."""
    svar = kor([str(ST), "rebuild", str(stkat)])
    if svar.returncode != 0:
        raise Avbryt(f"state: {stkat} kunde inte rekonstrueras — {orsak(svar)}")
    try:
        tabell = json.loads(svar.stdout)
    except json.JSONDecodeError as e:
        raise Avbryt(f"state: rebuild gav ingen läsbar tabell — {e}") from e
    return {rad["task"]: rad["status"] for rad in tabell}


def valj(tasks: list[tuple[str, list[str], str]], attkat: Path,
         stkat: Path) -> tuple[str, str] | None:
    status = status_ur_state(stkat)
    besked: dict[str, bool] = {}

    def attesterad(tid: str) -> bool:
        if tid not in besked:
            besked[tid] = attesterad_giltig(attkat, tid)
        return besked[tid]

    behoriga = [
        (tid, authority)
        for tid, dep, authority in tasks
        if status.get(tid) in VALBARA_STATUS
        and not attesterad(tid)
        and all(attesterad(d) for d in dep)
    ]
    # min() på str är kodpunktsordning och lokaloberoende — samma semantik
    # som skiva 1:s sorted() i den kanoniska tabellen.
    return min(behoriga, key=lambda item: item[0]) if behoriga else None


def kmd_claim(tasks: list[tuple[str, list[str], str]], attkat: Path, stkat: Path) -> int:
    val = valj(tasks, attkat, stkat)
    if val is None:
        return 0  # Tomt claim rör aldrig loggen.
    tid, authority = val
    status = OWNER_ACTION_REQUIRED if authority == "owner_authority" else "claimed"
    # Eventet skrivs FÖRE svaret: ett claim som rapporterats men inte
    # registrerats hade gjort två controllers till ägare av samma task.
    kvitto = kor(
        [str(ST), "append", str(stkat), json.dumps({"task": tid, "status": status}, ensure_ascii=False)]
    )
    if kvitto.returncode != 0:
        raise Avbryt(f"claim: eventet för {tid} kunde inte skrivas — {orsak(kvitto)}")
    # Owner production never enters the ordinary BUILDER/provider route.
    # The persisted state is the handoff; an empty stdout ends this drain.
    if authority == "ordinary":
        print(tid)
    return 0


def main(argv: list[str]) -> int:
    if len(argv) != 5 or argv[1] not in ("select", "claim"):
        return fel("användning: cli select|claim <spec.json> <attest-dir> <state-dir>")
    kommando, spec, attkat, stkat = argv[1], Path(argv[2]), Path(argv[3]), Path(argv[4])
    try:
        tasks = las_spec(spec)
        if kommando == "claim":
            return kmd_claim(tasks, attkat, stkat)
        val = valj(tasks, attkat, stkat)
        if val is not None:
            print(val[0])
        return 0
    except Avbryt as e:
        return fel(str(e))


