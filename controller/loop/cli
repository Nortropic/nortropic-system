#!/usr/bin/env python3.12
"""controller/loop/cli — skiva 9: huvudloopen, kedjan. Skiva 14: inkopplad.

    run <config.json>
        0   körningen slutförd (drain, även noll varv)
        1   fel, inklusive upptagen lease FÖRE första varvet
        3   rent stopp: brytaren är öppen, drainet avslutades före nästa claim

Varvet är v4.1 §13, och varje led är en systerkomponent:

    verify   registerpreflight →  lease → privat pre-task authority-snapshot
    taskval  select/claim      →  taskgrindens path/identitet återkontrolleras
                              →  workspace på aktuell base
    envelope kuvert            →  brytare  försöket, med budget och fingerprints
                                  (som i sin tur kör utforare, som kör launch)
    worker   strikt parse      →  policy  diffpolicy mot samma spec
    verify   global registrerad grind mot exakt kandidat-SHA
                              →  trusted taskgrind mot samma SHA
    attest   attestation först när båda domarna är gröna

Kedjan bygger ingenting själv. Den beordrar, läser utfall och binder varven —
all logik som redan bor i en syster hämtas därifrån, aldrig i en kopia här.
Att duplicera en systers regel hade gett två sanningar som driftar isär,
vilket är samma defektklass som INV-006 finns till för att fånga. Brytaren
bokför budgeten och fingerprintarna; kedjan för ingen egen räkning.

**Försöket går genom brytaren, aldrig genom launch direkt** (skiva 14). Fram
till dess var skiva 10 och 11 byggda men verkningslösa: sessionen fick själv
staga och committa, och attempt-budgeten hade ingen anropare. Nu föds
kandidat-SHA:t i controllerledet, och kandidatvägen är byte-identisk med
utförarens rapport — h-006, h-007, h-002 och h-003 står orörda.

**Omförsöket sker INUTI claimet.** Ett fallet försök görs om utan nytt claim
och utan nytt event; tasken är redan claimad, och claimed är inte valbart
(skiva 8). Utan omförsök vore per-task-budgeten död kod: en fallen task
förblir ovalbar resten av körningen, så varje task hade fått exakt ett
försök av en slump (LOOP-ÄGARHAND-36, ägarbeslut 2026-08-09). Varje försök
får ett EGET workspace på OFÖRÄNDRAD base — bara attesterade kandidater
flyttar basen.

**Brytarkatalogen är en per task, `<brytare_rot>/<task-id>`.** Fingerprinten
bär ingen task-identitet (skiva 11), så katalogsökvägen är det enda som gör
räkningen per task, och h-015:s bevarade failure-historik förutsätter den.
Katalogen skapas av brytaren, aldrig här: förskapade kedjan den, skulle
brytarens egna anropsfel döljas bakom kedjans.

**Integration är kedjande base.** Nästa varv byggs på förra ATTESTERADE
kandidat-SHA:t, aldrig på en kandidat som inte tog sig igenom. Ett varv som
faller lämnar därför basen orörd, och nästa task bygger på det som faktiskt
höll.

**Failure attesterar aldrig.** Är budgeten slut förblir tasken claimed och är
ovalbar resten av körningen.

**Varje avbrott namnger STEGET och bär systerns egen klass ordagrant.** En
kedja som sväljer `timeout` eller `unparseable_output` tvingar den som
diagnostiserar att köra om för att få veta vad som brast — mätt som verklig
kostnad på ägarhandens referenskedja (LOOP-ÄGARHAND-26).

**Kedjan skriver inga egna event.** v4.1 §23:s vokabulär (run_started,
lease_acquired, run_completed …) kräver ett eventschema som skiva 1 inte har:
dess event är {task, status} och rymmer ingen körningshändelse. Att uppfinna
ett andra schema här vore en ny komponent på ett fel. Enda eventet i ett varv
är därför skiva 8:s claim — ett per claim, inte ett per försök.

Config är INDATA i sin helhet. Komponenten har ingen inbyggd sökväg, ingen
inbyggd backlog och antar aldrig ett namnschema.
"""

import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

if sys.version_info < (3, 12):
    sys.exit(f"controller/loop/cli kräver Python 3.12+, kördes på {sys.version.split()[0]}")

ROT = Path(__file__).resolve().parents[2]
TASKVAL = ROT / "controller/taskval/cli"
WORKSPACE = ROT / "controller/workspace/cli"
ENVELOPE = ROT / "controller/envelope/cli"
BRYTARE = ROT / "controller/brytare/cli"
WORKER = ROT / "controller/worker/cli"
POLICY = ROT / "controller/policy/cli"
VERIFY = ROT / "controller/verify/cli"
ATTEST = ROT / "controller/attest/cli"
LEASE = ROT / "controller/lease/cli"

# h-004:s produktionsdefault. Testkörningar får snävare positiva värden via
# config, men heartbeat måste alltid vara strikt kortare än TTL.
LEASE_TTL_DEFAULT = 180
LEASE_HEARTBEAT_DEFAULT = 30

# Körningens exitkoder. 3 är RENT STOPP och hålls skilt från både slutförd
# drain (0) och fel (1): driftformen är kör tills kvoten tar slut, börja om,
# och en cron måste kunna skilja stoppet från en färdig drain utan att parsa
# prosa. 2 används aldrig — verify/bin/_lib.sh binder den till ODÖMBART.
RENT_STOPP = 3

# Verify-gränsens fyra domäner. 0/1/2 ägs av grinden; 3 är verifierarens
# urvalsvägran och 4 dess integritetsfel. Taskgrindens 2/3/4 stoppar hela
# körningen. För den äldre GLOBALA configverifieraren måste okänt id (3)
# däremot behålla h-011:s icke-retrybara varvslut/exit 0.
VER_PASS, VER_FAIL, VER_ODOMBART, VER_VAGRAN, VER_INTEGRITET = 0, 1, 2, 3, 4
SHA256_FORM = re.compile(r"^[0-9a-f]{64}$")

# Brytarens exitkoder, skiva 11:s kontrakt. Läses här, dupliceras inte:
# klassningen görs av brytaren, kedjan väljer bara väg på utfallet.
BR_KANDIDAT, BR_ANROPSFEL, BR_OPPEN, BR_BUDGET_SLUT = 0, 1, 9, 10
# 3–7, INTE 3–8. Ett omförsök får bara göras på ett utfall brytaren har
# BOKFÖRT, annars närmar sig taket aldrig och varvet snurrar utan slut.
# Brytarens 8 har tre ursprung som bokför OLIKA: utföraren gav en kod utanför
# kontraktet (bokför), och brytarens eget kraschskydd (bokför inte — skrivningen
# av tillståndet hann aldrig ske). Utsidan kan inte skilja dem åt, så koden
# behandlas som obokförd. Mätt 2026-08-09 med 3–8: en tillståndsskrivning som
# faller EFTER att kommandot startats gav 75 VERKLIGA sessionsstarter på 30 s,
# forbrukat 0, och körningen returnerade aldrig — i drift är varje start en
# modellsession. Samma premiss som anropsfelet nedan, nu samma behandling.
# Att kraschskyddet delar exitkod med ett bokfört utfall är roten, och den bor
# i controller/brytare/** — utanför denna tasks skrivyta. Registrerad som öppen
# post mot h-013; här snävas bara omförsöket in.
BR_FAILURE = range(3, 8)
# Brytarens kontrakt skriver som mest TVÅ egna rader efter systerns text —
# `fingerprint: <fp>` respektive `kvot_slut: …`, och vid öppning `brytare
# öppen: <orsak>`. De hålls utanför klippningen; se enrad().
BR_SVANS = 2

TEXTFALT = ("spec", "attest_dir", "state_dir", "lease_dir", "lease_resurs",
            "workspace_rot", "base_sha", "verifier_id", "run_id", "brytare_rot")
HELTALSFALT = ("budget", "troskel")

# Varvets utfall. Att de är strängar och inte koder är avsiktligt: de läses
# bara här, och en kod till hade blandats ihop med systrarnas.
ATTESTERAD, FALLET, VARV_SLUT, STOPP = "attesterad", "fallet", "varv_slut", "stopp"


class Avbryt(Exception):
    """Fel som gör hela körningen till exit 1 — aldrig ett tyst drain."""


def fel(text: str) -> int:
    print(text, file=sys.stderr)
    return 1


def kor(argv: list, text: bool = True,
        env: dict[str, str] | None = None) -> subprocess.CompletedProcess:
    """Systerkomponenterna anropas som argv utan skal (v4.1 §2 invariant 3)."""
    argv = [str(a) for a in argv]
    try:
        return subprocess.run(
            argv, capture_output=True, text=text, shell=False, env=env
        )
    except OSError as e:
        raise Avbryt(f"{argv[0]} kunde inte startas — {e}") from e


class LeaseVakt:
    """Håll en lease-generation levande och publicera första förlusten.

    Samma lokala mutex serialiserar heartbeatens observation med den sista
    tokenbundna kontrollen och attest-starten. Därmed kan en redan observerad
    leaseförlust aldrig passera vidare till ATTEST.
    """

    def __init__(self, kat: str, task: str, lease_id: str, intervall: float):
        self.kat = kat
        self.task = task
        self.lease_id = lease_id
        self.intervall = intervall
        self._stopp = threading.Event()
        self._forlorad = threading.Event()
        self._operation = threading.Lock()
        self._orsak = ""
        self._attesterade: list[tuple[str, str]] = []
        self._trad = threading.Thread(
            target=self._heartbeat,
            name=f"lease-heartbeat-{task}",
            daemon=True,
        )

    def start(self) -> None:
        self._trad.start()

    def _markera_forlust(self, orsak: str) -> None:
        if not self._forlorad.is_set():
            self._orsak = orsak
            self._forlorad.set()
            felaktiga = []
            for attest_dir, sha in self._attesterade:
                try:
                    r = kor([ATTEST, attest_dir, "invalidate", sha])
                except Avbryt as e:
                    felaktiga.append(str(e))
                    continue
                if r.returncode != 0:
                    felaktiga.append(sista(r.stderr or r.stdout))
            if felaktiga:
                self._orsak += f"; attestation kunde inte invalideras: {felaktiga[0]}"

    def _fornya_lasd(self) -> bool:
        try:
            r = kor([LEASE, self.kat, "renew", self.task, self.lease_id])
        except Avbryt as e:
            self._markera_forlust(str(e))
            return False
        if r.returncode != 0:
            self._markera_forlust(sista(r.stderr or r.stdout))
            return False
        return True

    def _heartbeat(self) -> None:
        try:
            while not self._stopp.wait(self.intervall):
                with self._operation:
                    if self._stopp.is_set() or not self._fornya_lasd():
                        return
        except Exception as e:
            # Varje accepterat positivt tal, även ett som hostens wait-API inte
            # kan representera, måste bli fail-closed och aldrig en tyst död
            # heartbeattråd.
            with self._operation:
                self._markera_forlust(
                    f"heartbeat kraschade — {type(e).__name__}: {e}"
                )

    def krav(self, fornya: bool = False) -> None:
        with self._operation:
            if self._forlorad.is_set():
                raise Avbryt(f"lease förlorad: {self._orsak}")
            if fornya and not self._fornya_lasd():
                raise Avbryt(f"lease förlorad: {self._orsak}")

    def attestera(self, argv: list, attest_dir: str, sha: str) -> subprocess.CompletedProcess:
        """Bind attesteringen mellan två synkrona generationskontroller.

        Om generationen ersätts medan ATTEST arbetar fäller efterkontrollen
        runnet och gör den nyss skrivna posten stale innan något senare led
        kan läsa den som giltig. Tidigare poster från samma run invalideras
        likaså om heartbeat observerar en senare leaseförlust.
        """
        with self._operation:
            if self._forlorad.is_set():
                raise Avbryt(f"lease förlorad: {self._orsak}")
            if not self._fornya_lasd():
                raise Avbryt(f"lease förlorad: {self._orsak}")
            r = kor(argv)
            if r.returncode == 0:
                self._attesterade.append((attest_dir, sha))
            if not self._fornya_lasd():
                raise Avbryt(f"lease förlorad: {self._orsak}")
            return r

    def stoppa(self) -> None:
        self._stopp.set()
        self._trad.join()

    def forlustorsak(self) -> str | None:
        with self._operation:
            return self._orsak if self._forlorad.is_set() else None

    def markera_forlust(self, orsak: str) -> None:
        with self._operation:
            self._markera_forlust(orsak)


def enrad(text: str, tecken: int = 300, svansrader: int = 0) -> str:
    """Systerns utfall som EN rad, ordagrant så långt den får plats.

    `svansrader` håller de N SISTA raderna HELT utanför klippningen. Systrarna
    lägger sin fria text först — utförarens kod 6 bär hela sessionens stdout —
    och sitt strukturerade efterled sist: brytarens `fingerprint: <fp>`, och
    vid öppning dessutom `brytare öppen: <orsak>`. Kriteriet kräver att det
    efterledet bärs ORDAGRANT, och ett klipp i slutet tar just det.

    Mätt 2026-08-09 mot en session som skriver en normal sammanfattning och
    inte ändrar någon fil: avbrottsraden blev 334 tecken och nådde aldrig
    fingerprint-raden, vars nyckel var 414 tecken — längre än hela fönstret.
    Ett klipp i mitten hade alltså inte heller räckt; svansen måste bäras hel.
    Klassen står först i den fria texten och överlever därför klippningen.
    """
    rader = [r.strip() for r in text.strip().splitlines() if r.strip()]
    if not rader:
        return ""
    n = min(svansrader, len(rader))
    huvud, svans = rader[:len(rader) - n], rader[len(rader) - n:]
    return " · ".join(([" · ".join(huvud)[:tecken]] if huvud else []) + svans)


def sista(text: str) -> str:
    rader = [r for r in text.splitlines() if r.strip()]
    return rader[-1].strip()[:300] if rader else "inget meddelande"


def las_config(fil: Path) -> dict:
    """Config prövas i sin helhet före leasen. Ett fält som saknas ska fälla
    körningen innan den rör en lease, en logg, ett workspace eller en
    brytarkatalog."""
    try:
        k = json.loads(fil.read_text(encoding="utf-8"))
    except OSError as e:
        raise Avbryt(f"config: {fil} kunde inte läsas — {e}") from e
    except ValueError as e:
        raise Avbryt(f"config: {fil} är inte giltig JSON — {e}") from e
    if not isinstance(k, dict):
        raise Avbryt(f"config: {fil} är ingen JSON-dict")

    for f in TEXTFALT:
        if not isinstance(k.get(f), str) or not k[f]:
            raise Avbryt(f"config: {f} saknas eller är ingen icke-tom sträng")

    for f in HELTALSFALT:
        v = k.get(f)
        # bool är en int i Python; True som budget vore ett tal av misstag.
        # Värdeområdet prövas av brytaren, som äger budgeten — en andra regel
        # om samma tal hade blivit den andra sanningen.
        if isinstance(v, bool) or not isinstance(v, int):
            raise Avbryt(f"config: {f} måste vara ett heltal, fick {v!r}")

    kommando = k.get("worker_cmd")
    if not isinstance(kommando, list) or not kommando or not all(
        isinstance(d, str) and d for d in kommando
    ):
        # En sträng hade blivit ett skalkommando hos den som exekverar den.
        # argv-listan är invariantens form, inte en bekvämlighet.
        raise Avbryt("config: worker_cmd måste vara en icke-tom lista av argv-strängar")

    t = k.get("timeout_s")
    if isinstance(t, bool) or not isinstance(t, (int, float)) or t <= 0:
        raise Avbryt(f"config: timeout_s måste vara ett positivt tal, fick {t!r}")

    for f, standard in (
        ("lease_ttl_s", LEASE_TTL_DEFAULT),
        ("lease_heartbeat_s", LEASE_HEARTBEAT_DEFAULT),
    ):
        v = k.get(f, standard)
        if (
            isinstance(v, bool)
            or not isinstance(v, (int, float))
            or not math.isfinite(v)
            or v <= 0
        ):
            raise Avbryt(f"config: {f} måste vara ett positivt ändligt tal, fick {v!r}")
        k[f] = v
    if k["lease_heartbeat_s"] >= k["lease_ttl_s"]:
        raise Avbryt(
            "config: lease_heartbeat_s måste vara strikt mindre än lease_ttl_s"
        )
    return k


def utsaga(nr: int, task: str, steg: str, text: str, svansrader: int = 0) -> None:
    """Varvets utsaga vid avbrott. Systerns klass bärs vidare ordagrant."""
    print(f"varv {nr} {task}: avbrutet i {steg} — {enrad(text, svansrader=svansrader)}")
    return None


def forsok(k: dict, task: str, base: str, tmpkat: Path, nr: int, f: int,
           taskdom: tuple[str, str] | None,
           leasevakt: LeaseVakt) -> tuple[str, str | None]:
    """Ett försök inuti claimet. Kandidatens SHA vid attestation, annars None.

    Eget workspace, eget kuvert, ett anrop till brytaren. Basen är densamma
    för varje försök: ett fallet försök flyttar ingenting.
    """
    attempt = f"{k['run_id']}-{task}-{f}"
    ws = None
    try:
        leasevakt.krav()
        # attempt-id:ts form prövas av skiva 5, inte här: en andra regel om
        # samma sträng hade blivit den andra sanningen.
        r = kor([WORKSPACE, k["workspace_rot"], "create", attempt, base])
        leasevakt.krav()
        if r.returncode != 0:
            utsaga(nr, task, "workspace", r.stderr or r.stdout)
            return VARV_SLUT, None
        ws = r.stdout.strip()

        r = kor([ENVELOPE, "build", k["run_id"], task, base, k["spec"]])
        leasevakt.krav()
        if r.returncode != 0:
            utsaga(nr, task, "kuvert", r.stdout)
            return VARV_SLUT, None
        # Kuvertet läggs ALDRIG i workspacet: utföraren kör `git add -A` där,
        # och kuvertet hade följt med in i kandidaten (skiva 6c, samma skäl).
        kuvertfil = tmpkat / f"{attempt}.kuvert.json"
        kuvertfil.write_text(r.stdout, encoding="utf-8")

        # Samma valda post prövas en andra gång precis före brytaren kan
        # starta sessionen. Den första kontrollen låg före workspace/kuvert;
        # den här stänger fönstret som de två förberedelsestegen annars öppnar.
        aktuell_taskdom = hamta_taskdom(k, task)
        if aktuell_taskdom != taskdom:
            raise Avbryt(
                f"taskgrind: identiteten ändrades före session — "
                f"{taskdom!r} → {aktuell_taskdom!r}"
            )

        worker_env = os.environ.copy()
        # Hela controller-runroten är trusted runtime: pre-task-snapshot,
        # kuvert, rapporter och verifierarens senare kandidatvyer. Workern får
        # läsa kuvertet men aldrig förskapa eller byta controllerfilerna.
        worker_env["NORTROPIC_TRUST_ROOT"] = str(tmpkat)
        r = kor([BRYTARE, "kor", Path(k["brytare_rot"]) / task, task,
                 k["budget"], k["troskel"], ws, kuvertfil, k["timeout_s"],
                 "--", *k["worker_cmd"]], text=False, env=worker_env)
        leasevakt.krav()
        # Rapporten hålls i BYTES hela vägen. Skiva 6 dömer själv om den är
        # läsbar UTF-8; en avkodning här hade gjort en oparsbar rapport
        # parsbar. Avkodningen nedan är bara till utsagorna.
        kod, rapport = r.returncode, r.stdout
        ut = rapport.decode("utf-8", "replace")

        if kod == BR_ANROPSFEL:
            # Brytaren startade inget kommando och förbrukade ingen budget.
            # Ett omförsök hade snurrat för evigt; ett tyst drain hade dolt
            # att försöket aldrig ens gjordes.
            raise Avbryt(f"brytare: {enrad(ut, svansrader=BR_SVANS)}")
        if kod == BR_BUDGET_SLUT:
            print(f"varv {nr} {task}: {enrad(ut, svansrader=BR_SVANS)}")
            return VARV_SLUT, None
        if kod == BR_OPPEN:
            utsaga(nr, task, "forsok", ut, svansrader=BR_SVANS)
            return STOPP, None
        if kod in BR_FAILURE:
            utsaga(nr, task, "forsok", ut, svansrader=BR_SVANS)
            return FALLET, None
        if kod != BR_KANDIDAT:
            # Hit hamnar också brytarens 8: obokförd eller obokförbar, och
            # därmed ingenting att göra om. Se BR_FAILURE ovan.
            raise Avbryt(f"brytare: exitkod {kod} bär inget bokfört försök att göra om "
                         f"— {enrad(ut, svansrader=BR_SVANS)}")

        rapportfil = tmpkat / f"{attempt}.rapport"
        rapportfil.write_bytes(rapport)

        r = kor([WORKER, "parse", rapportfil])
        leasevakt.krav()
        if r.returncode != 0:
            utsaga(nr, task, "parse", r.stdout)
            return FALLET, None
        sha = r.stdout.strip()

        r = kor([POLICY, "check", task, base, sha, k["spec"]])
        leasevakt.krav()
        if r.returncode != 0:
            utsaga(nr, task, "policy", r.stdout)
            return FALLET, None

        # Ingen kandidatträdskontroll. Utföraren gör "HEAD är kandidaten" och
        # "rent träd" sanna i samma andetag, så en kontroll här kunde per
        # konstruktion aldrig fälla — precis det oombedda skyddslager regel 9
        # talar om (LOOP-ÄGARHAND-36, avgörande 5).
        dom_env = os.environ.copy()
        dom_env["TMPDIR"] = str(tmpkat)
        r = kor([
            VERIFY, "run-commit", k["_register_sha256"], k["verifier_id"], sha,
            k["_snapshot_sha256"], k["_snapshot_dir"],
        ], env=dom_env)
        leasevakt.krav()
        if r.returncode == VER_FAIL:
            utsaga(nr, task, "verifierare", r.stdout or r.stderr)
            return FALLET, None
        if r.returncode == VER_ODOMBART:
            raise Avbryt(f"verifierare: ODÖMBART — {enrad(r.stdout or r.stderr)}")
        if r.returncode == VER_VAGRAN:
            # h-011 binder okänt globalt id till avslutat varv/exit 0, men det
            # får inte längre bli ett retrybart FAIL som bränner hela budgeten.
            utsaga(nr, task, "verifierare", r.stdout or r.stderr)
            return VARV_SLUT, None
        if r.returncode != VER_PASS:
            raise Avbryt(
                f"verifierare: integritetsfel/vägran (exit {r.returncode}) — "
                f"{enrad(r.stdout or r.stderr)}"
            )

        if taskdom is not None:
            grind_id, grind_sha256 = taskdom
            r = kor([
                VERIFY, "task-run", k["_register_sha256"], grind_id,
                grind_sha256, sha, k["_snapshot_sha256"], k["_snapshot_dir"],
            ], env=dom_env)
            leasevakt.krav()
            if r.returncode == VER_FAIL:
                utsaga(nr, task, "taskgrind", f"{grind_id}: {r.stdout or r.stderr}")
                return FALLET, None
            if r.returncode == VER_ODOMBART:
                raise Avbryt(
                    f"taskgrind {grind_id}: ODÖMBART — {enrad(r.stdout or r.stderr)}"
                )
            if r.returncode != VER_PASS:
                raise Avbryt(
                    f"taskgrind {grind_id}: verifierarvägran (exit {r.returncode}) — "
                    f"{enrad(r.stdout or r.stderr)}"
                )

        attest_argv = [ATTEST, k["attest_dir"], "write", task, sha]
        if taskdom is not None:
            attest_argv.extend(taskdom)
        # Den sista synkrona renewen och ATTEST-starten ordnas mot heartbeatens
        # förlustobservation. En redan observerad förlust når aldrig hit.
        r = leasevakt.attestera(attest_argv, k["attest_dir"], sha)
        if r.returncode != 0:
            utsaga(nr, task, "attest", r.stderr or r.stdout)
            return FALLET, None

        print(f"varv {nr} {task}: attesterad {sha}")
        return ATTESTERAD, sha
    finally:
        # Workspacet rivs efter försöket — kandidatens commit är beviset, inte
        # katalogen. En städning som inte städade får aldrig passera tyst:
        # skiva 5 rapporterar utfallet, och den rapporten bärs vidare.
        if ws is not None:
            r = kor([WORKSPACE, k["workspace_rot"], "destroy", attempt])
            if r.returncode != 0:
                raise Avbryt(f"workspace: {attempt} kunde inte rivas — {sista(r.stderr)}")


def hamta_taskdom(k: dict, task: str) -> tuple[str, str] | None:
    """Verifierarsystern äger task-id → exit_test → exakt registerpath.

    Anropet ligger efter claim-eventet men före workspace och session. Därmed
    omkontrolleras den valda posten överst i varje taskvarv utan att loopen
    själv läser eller tolkar specens tasklista.
    """
    r = kor([VERIFY, "task", k["_register_sha256"], k["spec"], task])
    if r.returncode != 0:
        raise Avbryt(f"taskgrind: {sista(r.stderr or r.stdout)}")
    try:
        svar = json.loads(r.stdout)
    except (TypeError, ValueError) as e:
        raise Avbryt(f"taskgrind: verifieraren gav oläsbart uppslag — {e}") from e
    if svar == {
        "status": "ogrindad",
        "register_sha256": k["_register_sha256"],
    }:
        return None
    if (
        not isinstance(svar, dict)
        or svar.get("status") != "grindad"
        or not isinstance(svar.get("grind_id"), str)
        or not svar["grind_id"]
        or not isinstance(svar.get("grind_sha256"), str)
        or SHA256_FORM.fullmatch(svar["grind_sha256"]) is None
        or svar.get("register_sha256") != k["_register_sha256"]
        or set(svar) != {"status", "register_sha256", "grind_id", "grind_sha256"}
    ):
        raise Avbryt(f"taskgrind: verifieraren gav ogiltigt uppslag — {r.stdout.strip()[:300]}")
    return svar["grind_id"], svar["grind_sha256"]


def varv(k: dict, task: str, base: str, tmpkat: Path, nr: int,
         leasevakt: LeaseVakt) -> tuple[str, str | None]:
    """Ett varv = ETT claim och ett eller flera försök.

    Loopen tar slut därför att den bara gör om BOKFÖRDA utfall: brytarens
    3–7, som alla ökar forbrukat, så taket nås. Varje annat utfall lämnar
    loopen direkt — budget slut, öppen brytare, anropsfel, obokförd 8, och
    kedjefel före brytaren. Formuleringen *brytaren räknar varje startat
    försök* höll inte som terminationsargument: mätt 2026-08-09 startade en
    obokförd 8 sessionen 75 gånger på 30 s utan att taket rörde sig.
    """
    bunden_taskdom: tuple[str, str] | None | object = object()
    f = 0
    while True:
        leasevakt.krav()
        taskdom = hamta_taskdom(k, task)
        leasevakt.krav()
        if f == 0:
            bunden_taskdom = taskdom
        elif taskdom != bunden_taskdom:
            raise Avbryt(
                f"taskgrind: identiteten ändrades mellan försök — "
                f"{bunden_taskdom!r} → {taskdom!r}"
            )
        f += 1
        utfall, sha = forsok(k, task, base, tmpkat, nr, f, taskdom, leasevakt)
        if utfall is not FALLET:
            return utfall, sha


def drain(k: dict, tmpkat: Path, leasevakt: LeaseVakt) -> int:
    base, nr, attesterade = k["base_sha"], 0, 0
    sedda: set[str] = set()
    while True:
        leasevakt.krav()
        r = kor([TASKVAL, "claim", k["spec"], k["attest_dir"], k["state_dir"]])
        leasevakt.krav()
        if r.returncode != 0:
            raise Avbryt(f"taskval: {sista(r.stderr)}")
        task = r.stdout.strip()
        if not task:
            break
        if task in sedda:
            # Claim skriver status claimed, och claimed är inte valbart. Väljs
            # samma task två gånger har den invarianten brustit hos systern —
            # utan den här raden hade drainet snurrat för evigt i stället för
            # att säga vad som var fel.
            raise Avbryt(f"taskval: {task} valdes två gånger — claimet tog inte")
        sedda.add(task)
        nr += 1
        utfall, sha = varv(k, task, base, tmpkat, nr, leasevakt)
        if utfall is ATTESTERAD:
            base, attesterade = sha, attesterade + 1
        elif utfall is STOPP:
            # FÖRE nästa claim: nästa task ska vara helt orörd när körningen
            # tas om, annars kostar stoppet en task per omstart.
            print(f"drain stoppat: brytaren öppen på {task} — "
                  f"{nr} varv, {attesterade} attesterade, base {base}")
            return RENT_STOPP
    print(f"drain klar: {nr} varv, {attesterade} attesterade, base {base}")
    return 0


def gor_run(configfil: Path) -> int:
    k = las_config(configfil)

    # Hela verifierarregistret prövas medan vägran fortfarande är gratis:
    # före lease, claim-event, workspace, brytarkatalog och modellsession.
    r = kor([VERIFY, "preflight"])
    if r.returncode != 0:
        raise Avbryt(f"verifierarregister: {sista(r.stderr or r.stdout)}")
    try:
        preflight = json.loads(r.stdout)
    except (TypeError, ValueError) as e:
        raise Avbryt(f"verifierarregister: oläsbart preflightsvar — {e}") from e
    if (
        not isinstance(preflight, dict)
        or preflight.get("status") != "ok"
        or not isinstance(preflight.get("register_sha256"), str)
        or SHA256_FORM.fullmatch(preflight["register_sha256"]) is None
        or set(preflight) != {"status", "register_sha256"}
    ):
        raise Avbryt(f"verifierarregister: ogiltigt preflightsvar — {r.stdout.strip()[:300]}")
    k["_register_sha256"] = preflight["register_sha256"]

    # Leasen tas FÖRE allt annat och före varje skrivning. En körning som
    # inte äger resursen får inte lämna ett spår efter sig.
    r = kor([
        LEASE, k["lease_dir"], "acquire", k["lease_resurs"],
        "--ttl", k["lease_ttl_s"], "--holder-pid", os.getpid(),
    ])
    if r.returncode != 0:
        return fel(f"lease: {sista(r.stderr)}")
    lease_id = r.stdout.strip()
    if (
        not 8 <= len(lease_id) <= 256
        or any(c.isspace() or ord(c) < 33 for c in lease_id)
    ):
        # En holder-bunden lease får aldrig städas med legacy bare release.
        # Detta är ett systerintegritetsfel; den bundna PID:n dör med loopen
        # och TTL:n gör generationen återtagbar utan att vi gissar token.
        return fel("lease: acquire gav ingen giltig lease_id")

    leasevakt = LeaseVakt(
        k["lease_dir"], k["lease_resurs"], lease_id, k["lease_heartbeat_s"]
    )
    tmpkat = None
    heartbeat_startad = False
    try:
        leasevakt.start()
        heartbeat_startad = True
        tmpkat = Path(tempfile.mkdtemp(prefix="nortropic-loop-"))
        # Snapshoten skapas efter vunnen lease men före första claim/event,
        # workspace eller session. Den lever hela runnet och är den enda
        # control-plane-authority som taskgrindarna senare får projicera.
        snapshot = tmpkat / "pre-task-authority"
        r = kor([VERIFY, "prepare", k["_register_sha256"], snapshot])
        leasevakt.krav()
        if r.returncode != 0:
            raise Avbryt(f"pre-task authority: {sista(r.stderr or r.stdout)}")
        try:
            svar = json.loads(r.stdout)
        except (TypeError, ValueError) as e:
            raise Avbryt(f"pre-task authority: oläsbart snapshotsvar — {e}") from e
        if (
            not isinstance(svar, dict)
            or svar.get("status") != "ok"
            or not isinstance(svar.get("snapshot_sha256"), str)
            or SHA256_FORM.fullmatch(svar["snapshot_sha256"]) is None
            or set(svar) != {"status", "snapshot_sha256"}
        ):
            raise Avbryt(f"pre-task authority: ogiltigt snapshotsvar — {r.stdout.strip()[:300]}")
        k["_snapshot_dir"] = str(snapshot)
        k["_snapshot_sha256"] = svar["snapshot_sha256"]
        utfall = drain(k, tmpkat, leasevakt)
        # Även ett tomt drain måste fortfarande äga generationen när det
        # deklarerar sitt utfall.
        leasevakt.krav(fornya=True)
        return utfall
    finally:
        if tmpkat is not None:
            try:
                shutil.rmtree(tmpkat)
            except OSError as e:
                print(f"VARNING: temp-katalogen {tmpkat} blev kvar — {e}", file=sys.stderr)
        if heartbeat_startad:
            leasevakt.stoppa()
        release = kor([
            LEASE, k["lease_dir"], "release", k["lease_resurs"], lease_id,
        ])
        if release.returncode != 0 and leasevakt.forlustorsak() is None:
            leasevakt.markera_forlust(
                f"tokenbunden release vägrades — {sista(release.stderr or release.stdout)}"
            )
        forlust = leasevakt.forlustorsak()
        if forlust is not None:
            raise Avbryt(f"lease förlorad: {forlust}")


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[0] != "run":
        return fel("användning: cli run <config.json>")
    try:
        return gor_run(Path(argv[1]))
    except Avbryt as e:
        return fel(str(e))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
