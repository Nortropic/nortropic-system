def gor_run(ws_arg: str, kuvert_arg: str, timeout_arg: str, kommando: list[str]) -> int:
    ws = Path(ws_arg).expanduser()
    if not ws.is_dir():
        return svar(f"anropsfel: workspace {ws_arg} är ingen katalog", ANROP)
    ws = ws.resolve()

    kuvertfil = Path(kuvert_arg).expanduser()
    try:
        envelope = kuvertfil.read_bytes()
        json.loads(envelope)
    except OSError as exc:
        return svar(f"anropsfel: kan inte läsa kuvertet {kuvert_arg}: {exc.strerror or exc}", ANROP)
    except ValueError as exc:
        return svar(f"anropsfel: kuvertet {kuvert_arg} är inte giltig JSON: {exc}", ANROP)

    try:
        sekunder = float(timeout_arg)
    except ValueError:
        return svar(f"anropsfel: timeout {timeout_arg!r} är inget tal", ANROP)
    if sekunder <= 0:
        return svar(f"anropsfel: timeout måste vara större än noll, fick {timeout_arg}", ANROP)
    timeout_ms = max(1, min(86400000, round(sekunder * 1000)))

    if not command_exists(kommando[0], ws):
        return svar(f"launch_failed: kommandot finns inte eller är inte körbart: {kommando[0]}", LAUNCH)

    if any(os.environ.get(key) for key in EPHEMERAL_KEYS):
        return nested_launch(ws, envelope, timeout_ms, kommando, timeout_arg)

    if not authorized_interpreter():
        return svar("launch_failed: launchern kör inte den auktoriserade Python-runtimen", LAUNCH)
    python_bytes = app_binary_bytes()
    if python_bytes is None:
        return svar("launch_failed: den auktoriserade app-binären kunde inte öppnas", LAUNCH)
    return top_level_launch(ws, envelope, timeout_ms, kommando, timeout_arg, python_bytes)


def command_exists(name: str, ws: Path) -> bool:
    if os.sep not in name:
        for directory in ("/usr/bin", "/bin"):
            candidate = Path(directory) / name
            if candidate.is_file() and os.access(candidate, os.X_OK):
                return True
        return False
    path = Path(name)
    if not path.is_absolute():
        path = ws / path
    return path.is_file() and os.access(path, os.X_OK)


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[0] != "run":
        return svar("anropsfel: run <workspace> <kuvertfil> <timeout-s> -- <kommando...>", ANROP)
    if "--" not in argv:
        return svar("anropsfel: kommandot måste stå efter --", ANROP)
    delare = argv.index("--")
    fore, kommando = argv[1:delare], argv[delare + 1:]
    if len(fore) != 3:
        return svar("anropsfel: run <workspace> <kuvertfil> <timeout-s> -- <kommando...>", ANROP)
    if not kommando:
        return svar("anropsfel: inget kommando efter --", ANROP)
    return gor_run(fore[0], fore[1], fore[2], kommando)


if __name__ == "__main__":
    try:
        kod = main(sys.argv[1:])
    except BrokenPipeError:
        kod = INTERNT
    except SystemExit:
        raise
    except BaseException as exc:
        try:
            kod = svar(f"internt fel: {type(exc).__name__}: {exc}", INTERNT)
        except BrokenPipeError:
            kod = INTERNT
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        kod = INTERNT
    sys.exit(kod)
