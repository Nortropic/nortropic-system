#!/usr/bin/env python3.12
"""controller/launch/cli — skiva 6c: worker-launch, processtart med timeout.

    run <workspace> <kuvertfil> <timeout-s> -- <kommando...>
        0   processens stdout OFÖRÄNDRAD
        ≠0  failure-klass på stdout

Kommandot är KONFIGURATION, aldrig hårdkodat. Komponenten startar vad den
får efter `--`; att just Claude Code startar rätt är en konfigurationsfråga
som prövas av människa. Det som är logik — workspace, kuvert, timeout,
processgrupp och rest — prövas mekaniskt.

**Processgruppen är hela poängen.** `subprocess.run(timeout=)` dödar barnet,
inte gruppen. h-005 mätte samma klass av fel: `worktree add` startar en egen
utcheckningsprocess, och att döda bara git lämnade barnbarnet skrivande i
katalogen. Här startar workern lika gärna bakgrundsjobb. Därför
`start_new_session` — barnet blir gruppledare — och `killpg` på HELA gruppen
vid timeout: SIGTERM, nådetid, sedan SIGKILL.

**Komponenten hänger aldrig.** Varje väntan har en frist. Går gruppen inte
att skörda inom fristen lämnas rören och timeout-klassen rapporteras ändå —
ett svar som dröjer för evigt är värre än ett svar som medger att det inte
kunde städa.

**Kuvertet når processen på två vägar**, ingen av dem via workspacet: miljö-
variabeln `NORTROPIC_KUVERT` med absolut sökväg, och innehållet på stdin.
Att lägga kuvertet i workspacet vore fel — workern kör `git add -A` där, och
kuvertet hade följt med in i kandidaten.

Failure-klasserna hålls isär för att controllern klassar och räknar fel
(v4.1 §13 `classify`, §16 breaker). `timeout` och `nonzero_exit` är SKILDA:
"processen dog" och "processen misslyckades" är olika utfall och kräver
olika åtgärd.

Exitkoden bär klassen: 0 rapport · 1 anropsfel · 3 launch_failed ·
4 nonzero_exit · 5 timeout · 8 internt fel. **2 används aldrig** —
`verify/bin/_lib.sh` rad 2 binder det till ODÖMBART.
"""

import json
import os
import shutil
import signal
import subprocess
import sys
from pathlib import Path

if sys.version_info < (3, 12):
    sys.exit(f"controller/launch/cli kräver Python 3.12+, kördes på {sys.version.split()[0]}")

ANROP, LAUNCH, NONZERO, TIMEOUT, INTERNT = 1, 3, 4, 5, 8
ROT = Path(__file__).resolve().parents[2]
SANDBOX_EXEC = Path("/usr/bin/sandbox-exec")
TRUST_ROOT_ENV = "NORTROPIC_TRUST_ROOT"
# R116: optional provider result-staging confinement.  When both are present the
# launcher denies every write under the staging root except a data write to the
# exact pre-created sink.  Absent (direct h-009 calls) the profile is unchanged.
STAGING_ROOT_ENV = "NORTROPIC_STAGING_ROOT"
RESULT_SINK_ENV = "NORTROPIC_RESULT_SINK"

# LOOP-ÄGARHAND-44: buildern får skriva kandidatdata och neutral scratch, men
# aldrig live control plane eller controllerns pre-task-authority. `allow
# default` bevarar launchs kommandoagnostiska kontrakt. Git-exceptionen är
# uppmätt mot h-016: en detached självcommit behöver common objects och sitt
# EGET worktree-admin, men inte config, hooks, refs eller andra worktrees.
# Parametrar håller sökvägar ur Scheme-källan så filnamn aldrig blir syntax.
SEATBELT_PROFIL = """(version 1)
(allow default)
(deny file-write*
  (require-all
    (subpath (param "LIVE_ROOT"))
    (require-not (subpath (param "LIVE_GIT")))))
(deny file-write*
  (require-all
    (subpath (param "LIVE_GIT"))
    (require-not
      (require-any
        (subpath (param "GIT_OBJECTS"))
        (subpath (param "WORKTREE_GITDIR"))))))
(deny file-write* (subpath (param "GIT_OBJECTS_INFO")))
(deny file-write* (subpath (param "WORKTREE_COMMDIR")))
(deny file-write* (subpath (param "WORKTREE_GITFILE")))
(deny file-write* (subpath (param "WORKTREE_CONFIG")))
(deny file-write* (literal (param "WORKSPACE")))
(deny file-write* (literal (param "WORKSPACE_DOTGIT")))
(deny file-write* (subpath (param "TRUST_ROOT")))
"""

# Nådetid mellan SIGTERM och SIGKILL, och frist för att skörda gruppen.
NADETID = 2.0
SKORDEFRIST = 5.0

# v4.1 §10: worker-env får aldrig bära GH_*, GITHUB_* eller SLACK_*.
# Exakt de tre prefixen, inget bredare: paragrafens vidare formulering om
# deploy- och cloudcredentials kräver en allowlist som hör till sandbox-skivan,
# och ett bredare filter här hade kunnat strypa workerns egna referenser.
KANSLIGA_PREFIX = ("GH_", "GITHUB_", "SLACK_")


def svar(text: str, kod: int) -> int:
    print(text)
    return kod


def worker_miljo(kuvertfil: Path) -> dict[str, str]:
    # R116: the staging-confinement handoff vars are consumed by the launcher
    # for its own Seatbelt profile and must never reach the worker environment.
    miljo = {n: v for n, v in os.environ.items()
             if not n.startswith(KANSLIGA_PREFIX)
             and n not in (STAGING_ROOT_ENV, RESULT_SINK_ENV)}
    miljo["NORTROPIC_KUVERT"] = str(kuvertfil)
    return miljo


def gitdir(root: Path) -> Path | None:
    """Löser en vanlig .git-katalog/-pekare utan att köra Git."""
    punktgit = root / ".git"
    if punktgit.is_symlink():
        return None
    if punktgit.is_dir():
        return punktgit.resolve()
    if not punktgit.is_file():
        return None
    try:
        rader = punktgit.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return None
    if len(rader) != 1 or not rader[0].startswith("gitdir: "):
        return None
    text = rader[0][len("gitdir: "):]
    if not text:
        return None
    p = Path(text)
    if not p.is_absolute():
        p = root / p
    try:
        p = p.resolve(strict=True)
    except OSError:
        return None
    return p if p.is_dir() else None


def common_gitdir(worktree_gitdir: Path) -> Path:
    commondir = worktree_gitdir / "commondir"
    if not commondir.is_file() or commondir.is_symlink():
        return worktree_gitdir
    try:
        text = commondir.read_text(encoding="utf-8").strip()
        p = Path(text)
        if not p.is_absolute():
            p = worktree_gitdir / p
        p = p.resolve(strict=True)
    except (OSError, UnicodeError) as e:
        raise OSError(f"live Git common-dir kunde inte lösas: {e}") from e
    if not p.is_dir():
        raise OSError(f"live Git common-dir är ingen katalog: {p}")
    return p


def seatbelt_prefix(ws: Path) -> list[str]:
    """Bygger den bindande macOS-gränsen före workerstart.

    Loopkörningen anger sin controller-ägda run-root i miljön. Direkta
    h-009-anrop saknar den och skyddar ändå hela live-repot. Workspace och
    trust/live får aldrig överlappa: då kan kraven skrivbart respektive
    skrivskyddat inte båda vara sanna.
    """
    live_worktree_git = gitdir(ROT)
    if live_worktree_git is None:
        raise OSError(f"live control plane saknar säker .git-pekare: {ROT / '.git'}")
    live_git = common_gitdir(live_worktree_git)

    trust_angiven = TRUST_ROOT_ENV in os.environ
    if trust_angiven:
        trust_arg = os.environ[TRUST_ROOT_ENV]
        trust = Path(trust_arg)
        if not trust_arg or not trust.is_absolute():
            raise OSError(f"{TRUST_ROOT_ENV} måste vara en explicit absolut katalog")
        if not trust.is_dir():
            raise OSError(f"{TRUST_ROOT_ENV} är ingen katalog: {trust_arg}")
        trust = trust.resolve(strict=True)
    else:
        # Live-repot är redan nekat. Samma rot som trustparameter skapar ingen
        # bredare spärr och håller profilformen statisk för direkta h-009-anrop.
        trust = ROT

    for skyddad in (ROT, trust):
        if ws == skyddad or ws in skyddad.parents or skyddad in ws.parents:
            raise OSError(
                f"workspace {ws} överlappar skrivskyddad rot {skyddad}"
            )

    aktuell_git = gitdir(ws)
    if aktuell_git is None or aktuell_git == live_git or live_git not in aktuell_git.parents:
        # En icke-Git-workspace behöver ingen write-exception inne i live Git.
        aktuell_git = ws / ".nortropic-ingen-live-git-exception"

    parametrar = {
        "LIVE_ROOT": ROT,
        "LIVE_GIT": live_git,
        "GIT_OBJECTS": live_git / "objects",
        "GIT_OBJECTS_INFO": live_git / "objects/info",
        "WORKTREE_GITDIR": aktuell_git,
        "WORKTREE_COMMDIR": aktuell_git / "commondir",
        "WORKTREE_GITFILE": aktuell_git / "gitdir",
        "WORKTREE_CONFIG": aktuell_git / "config.worktree",
        "WORKSPACE": ws,
        "WORKSPACE_DOTGIT": ws / ".git",
        "TRUST_ROOT": trust,
    }

    # R116 provider staging confinement. When the caller hands an exact staging
    # root and pre-created sink, deny every write under the staging root except a
    # data write to the sink. Seatbelt matches the RESOLVED path (/var ->
    # /private/var), so both are canonicalized; the sink must sit directly in the
    # staging root and neither may overlap the read-only live/trust roots.
    staging_profil = ""
    if STAGING_ROOT_ENV in os.environ or RESULT_SINK_ENV in os.environ:
        staging_arg = os.environ.get(STAGING_ROOT_ENV, "")
        sink_arg = os.environ.get(RESULT_SINK_ENV, "")
        staging = Path(staging_arg)
        sink = Path(sink_arg)
        if (not staging_arg or not sink_arg
                or not staging.is_absolute() or not sink.is_absolute()):
            raise OSError(
                f"{STAGING_ROOT_ENV} och {RESULT_SINK_ENV} måste båda vara "
                "explicita absoluta sökvägar")
        if not staging.is_dir():
            raise OSError(f"{STAGING_ROOT_ENV} är ingen katalog: {staging_arg}")
        staging = staging.resolve(strict=True)
        sink = sink.resolve(strict=True)
        if sink.parent != staging:
            raise OSError(
                f"{RESULT_SINK_ENV} måste ligga direkt i {STAGING_ROOT_ENV}")
        for skyddad in (ROT, trust):
            if (staging == skyddad or staging in skyddad.parents
                    or skyddad in staging.parents):
                raise OSError(
                    f"staging-roten {staging} överlappar skyddad rot {skyddad}")
        parametrar["STAGING_ROOT"] = staging
        parametrar["RESULT_SINK"] = sink
        staging_profil = (
            '(deny file-write* (subpath (param "STAGING_ROOT")))\n'
            '(allow file-write-data (literal (param "RESULT_SINK")))\n')

    argv = [str(SANDBOX_EXEC)]
    for namn, path in parametrar.items():
        argv.extend(("-D", f"{namn}={path}"))
    argv.extend(("-p", SEATBELT_PROFIL + staging_profil))
    return argv


def kommando_finns(namn: str, ws: Path, miljo: dict[str, str]) -> bool:
    """Bevarar Popens launch_failed för både PATH- och pathkommandon."""
    if os.sep not in namn:
        return shutil.which(namn, path=miljo.get("PATH")) is not None
    p = Path(namn)
    if not p.is_absolute():
        p = ws / p
    return p.is_file() and os.access(p, os.X_OK)


def doda_gruppen(p: subprocess.Popen) -> str:
    """Dödar HELA processgruppen och skördar den. Returnerar hur det gick.

    Att döda p ensam räcker inte: bakgrundsjobb workern startat är egna
    processer i samma grupp och överlever sin förälder.
    """
    try:
        grupp = os.getpgid(p.pid)
    except ProcessLookupError:
        return "processen var redan borta"

    for sig, namn, frist in ((signal.SIGTERM, "SIGTERM", NADETID),
                             (signal.SIGKILL, "SIGKILL", SKORDEFRIST)):
        try:
            os.killpg(grupp, sig)
        except (ProcessLookupError, PermissionError):
            return f"gruppen var borta vid {namn}"
        try:
            p.communicate(timeout=frist)
            return f"gruppen dog på {namn}"
        except subprocess.TimeoutExpired:
            continue
    return "gruppen svarade inte ens på SIGKILL — rören lämnades"


def kort(text: bytes | None, tecken: int = 200) -> str:
    if not text:
        return ""
    rad = text.decode("utf-8", "replace").strip().replace("\n", " · ")
    return rad[:tecken]


def gor_run(ws_arg: str, kuvert_arg: str, timeout_arg: str, kommando: list[str]) -> int:
    ws = Path(ws_arg).expanduser()
    if not ws.is_dir():
        return svar(f"anropsfel: workspace {ws_arg} är ingen katalog", ANROP)
    ws = ws.resolve()

    kuvertfil = Path(kuvert_arg).expanduser()
    try:
        ra = kuvertfil.read_bytes()
        json.loads(ra)
    except OSError as e:
        return svar(f"anropsfel: kan inte läsa kuvertet {kuvert_arg}: {e.strerror or e}", ANROP)
    except ValueError as e:
        return svar(f"anropsfel: kuvertet {kuvert_arg} är inte giltig JSON: {e}", ANROP)
    kuvertfil = kuvertfil.resolve()

    try:
        sekunder = float(timeout_arg)
    except ValueError:
        return svar(f"anropsfel: timeout {timeout_arg!r} är inget tal", ANROP)
    if sekunder <= 0:
        return svar(f"anropsfel: timeout måste vara större än noll, fick {timeout_arg}", ANROP)

    miljo = worker_miljo(kuvertfil)
    try:
        if not kommando_finns(kommando[0], ws, miljo):
            raise OSError(f"kommandot finns inte eller är inte körbart: {kommando[0]}")
        prefix = seatbelt_prefix(ws)
        # Profilen kompileras och installeras FÖRE buildern. Ett saknat binär,
        # en ogiltig profil eller en värd som vägrar Seatbelt blir launch_failed
        # och ingen rå workerfallback finns.
        prov = subprocess.run(
            [*prefix, "/usr/bin/true"], cwd=str(ws), env=miljo,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=SKORDEFRIST, check=False,
        )
        if prov.returncode != 0:
            raise OSError(
                "controllerns Seatbelt-gräns kunde inte installeras"
                + (f" — {kort(prov.stderr)}" if prov.stderr else "")
            )
        p = subprocess.Popen(
            [*prefix, *kommando], cwd=str(ws), env=miljo,
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            start_new_session=True,          # barnet blir gruppledare — se doda_gruppen
        )
        # R116: gruppledarens pgid fångas medan barnet lever, så gruppen kan
        # dödas även på FRAMGÅNG (inte bara vid timeout) efter att barnet skördats.
        try:
            grupp_pgid = os.getpgid(p.pid)
        except ProcessLookupError:
            grupp_pgid = p.pid
    except (OSError, subprocess.TimeoutExpired) as e:
        orsak = getattr(e, "strerror", None) or e
        return svar(f"launch_failed: kunde inte starta {kommando[0]}: {orsak}", LAUNCH)

    try:
        ut, fel = p.communicate(input=ra, timeout=sekunder)
    except subprocess.TimeoutExpired:
        utfall = doda_gruppen(p)
        return svar(f"timeout: processen överskred {timeout_arg} s och dödades "
                    f"med hela sin processgrupp ({utfall})", TIMEOUT)
    except BrokenPipeError:
        # Processen läste aldrig kuvertet och dog innan vi skrivit klart.
        # Det är inte ett fel i sig — utfallet avgörs av dess exitkod.
        ut, fel = p.stdout.read() if p.stdout else b"", p.stderr.read() if p.stderr else b""
        p.wait(timeout=SKORDEFRIST)

    if p.returncode != 0:
        anm = kort(fel)
        return svar(f"nonzero_exit: processen avslutade med kod {p.returncode}"
                    + (f" — stderr: {anm}" if anm else ""), NONZERO)

    # R116: döda HELA processgruppen på FRAMGÅNG, inte bara vid timeout. Ett
    # efterlevande barn i samma grupp (t.ex. med stängd stdio som inte höll
    # röret) får aldrig överleva ett normalt exit och skriva efter att anroparen
    # städat sin staging. Ledaren är redan skördad; SIGKILL når kvarvarande barn.
    try:
        os.killpg(grupp_pgid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass

    # Rapporten går ut OFÖRÄNDRAD. Ingen rad läggs till, ingen tas bort:
    # h-006 parsar den mekaniskt och en enda extra byte gör den oparsbar.
    sys.stdout.buffer.write(ut)
    sys.stdout.buffer.flush()
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[0] != "run":
        return svar("anropsfel: run <workspace> <kuvertfil> <timeout-s> -- <kommando...>", ANROP)
    if "--" not in argv:
        return svar("anropsfel: kommandot måste stå efter --", ANROP)

    delare = argv.index("--")
    fore, kommando = argv[1:delare], argv[delare + 1:]
    if len(fore) != 3:
        return svar("anropsfel: run <workspace> <kuvertfil> <timeout-s> -- <kommando...>", ANROP)
    if not kommando:
        return svar("anropsfel: inget kommando efter --", ANROP)
    return gor_run(fore[0], fore[1], fore[2], kommando)


if __name__ == "__main__":
    # Kriteriet kräver klassning, inte krasch. Inget stackspår når stderr.
    try:
        kod = main(sys.argv[1:])
    except BrokenPipeError:
        kod = INTERNT
    except SystemExit:
        raise
    except BaseException as e:
        try:
            kod = svar(f"internt fel: {type(e).__name__}: {e}", INTERNT)
        except BrokenPipeError:
            kod = INTERNT
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        kod = INTERNT
    sys.exit(kod)
